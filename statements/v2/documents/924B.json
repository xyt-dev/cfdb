{"assets":["/statement-assets/bc7675834e896f54f3fefa29403da01e37558a838099ca73c95fd71717b64363.png","/statement-assets/8018f9382a2ae86cc0cb36d6087d0032035dd6c21a9d6dc88a4b4021ed423ab4.png","/statement-assets/ecf087bf765af3a82fb1a005a46df16e61369b806b822cb334c9ac8e7e8b1c27.png","/statement-assets/a06e63b41b05eca0cb8fc54956134c07feacaf23318c1b92b3cf0d5d1153e97f.png"],"contentKind":"statement","contestId":"924","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Three-level Laser"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An atom of element X can exist in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct states with energies "},{"kind":"math_inline","text":"E1 < E2 < ... < En"},{"kind":"text","text":". Arkady wants to build a laser on this element, using a three-level scheme. Here is a simplified description of the scheme. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Three distinct states "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" are selected, where "},{"kind":"math_inline","text":"i < j < k"},{"kind":"text","text":". After that the following process happens: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" initially the atom is in the state "},{"kind":"math_inline","text":"i"},{"kind":"text","text":","}],"kind":"list_item"},{"children":[{"kind":"text","text":" we spend "},{"kind":"math_inline","text":"Ek - Ei"},{"kind":"text","text":" energy to put the atom in the state "},{"kind":"math_inline","text":"k"},{"kind":"text","text":","}],"kind":"list_item"},{"children":[{"kind":"text","text":" the atom emits a photon with useful energy "},{"kind":"math_inline","text":"Ek - Ej"},{"kind":"text","text":" and changes its state to the state "},{"kind":"math_inline","text":"j"},{"kind":"text","text":","}],"kind":"list_item"},{"children":[{"kind":"text","text":" the atom spontaneously changes its state to the state "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", losing energy "},{"kind":"math_inline","text":"Ej - Ei"},{"kind":"text","text":","}],"kind":"list_item"},{"children":[{"kind":"text","text":" the process repeats from step 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's define the energy conversion efficiency as "},{"attrs":{"alt":"","src":"/statement-assets/bc7675834e896f54f3fefa29403da01e37558a838099ca73c95fd71717b64363.png"},"kind":"image"},{"kind":"text","text":", i. e. the ration between the useful energy of the photon and spent energy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Due to some limitations, Arkady can only choose such three states that "},{"kind":"math_inline","text":"Ek - Ei ≤ U"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Arkady to find such the maximum possible energy conversion efficiency within the above constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"U"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ U ≤ 109"},{"kind":"text","text":") — the number of states and the maximum possible difference between "},{"kind":"math_inline","text":"Ek"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Ei"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers "},{"kind":"math_inline","text":"E1, E2, ..., En"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ E1 < E2... < En ≤ 109"},{"kind":"text","text":"). It is guaranteed that all "},{"kind":"math_inline","text":"Ei"},{"kind":"text","text":" are given in increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is not possible to choose three states that satisfy all constraints, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print one real number "},{"kind":"math_inline","text":"η"},{"kind":"text","text":" — the maximum possible energy conversion efficiency. Your answer is considered correct its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, let your answer be "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the jury's answer be "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your answer is considered correct if "},{"attrs":{"alt":"","src":"/statement-assets/8018f9382a2ae86cc0cb36d6087d0032035dd6c21a9d6dc88a4b4021ed423ab4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"headi