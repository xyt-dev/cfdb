{"assets":[],"contentKind":"statement","contestId":"2003","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Turtle and Good Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Turtle gives you a string $$$s$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Turtle considers a pair of integers $$$(i, j)$$$ ($$$1 \\le i \\lt j \\le n$$$) to be a "},{"children":[{"kind":"text","text":"pleasant pair"}],"kind":"container"},{"kind":"text","text":" if and only if there exists an integer $$$k$$$ such that $$$i \\le k \\lt j$$$ and "},{"children":[{"kind":"text","text":"both"}],"kind":"container"},{"kind":"text","text":" of the following two conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s_k \\ne s_{k + 1}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_k \\ne s_i$$$ "},{"children":[{"kind":"text","text":"or"}],"kind":"container"},{"kind":"text","text":" $$$s_{k + 1} \\ne s_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Besides, Turtle considers a pair of integers $$$(i, j)$$$ ($$$1 \\le i \\lt j \\le n$$$) to be a "},{"children":[{"kind":"text","text":"good pair"}],"kind":"container"},{"kind":"text","text":" if and only if $$$s_i = s_j$$$ "},{"children":[{"kind":"text","text":"or"}],"kind":"container"},{"kind":"text","text":" $$$(i, j)$$$ is a pleasant pair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Turtle wants to reorder the string $$$s$$$ so that the number of good pairs is "},{"children":[{"kind":"text","text":"maximized"}],"kind":"container"},{"kind":"text","text":". Please help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the string $$$s$$$ after reordering so that the number of good pairs is maximized. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3\nabc\n5\nedddf\n6\nturtle\n8\npppppppp\n10\ncodeforces\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nacb\nddedf\nurtlet\npppppppp\ncodeforces\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$(1, 3)$$$ is a good pair in the reordered string. It can be seen that we can't reorder the string so that the number of good pairs is greater than $$$1$$$. "},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"cab"}],"kind":"container"},{"kind":"text","text":" can also be the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$(1, 2)$$$, $$$(1, 4)$$$, $$$(1, 5)$$$, $$$(2, 4)$$$, $$$(2, 5)$$$, $$$(3, 5)$$$ are good pairs in the reordered string. "},{"children":[{"kind":"text","text":"efddd"}],"kind":"container"},{"kind":"text","text":" can also be the answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2003C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2003/problem/C"}