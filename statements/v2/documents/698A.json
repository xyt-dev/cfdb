{"assets":[],"contentKind":"statement","contestId":"698","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vacations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days of vacations! So he decided to improve his IT skills and do sport. Vasya knows the following information about each of this "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days: whether that gym opened and whether a contest was carried out in the Internet on that day. For the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day there are four options:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" on this day the gym is closed and the contest is not carried out; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on this day the gym is closed and the contest is carried out; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on this day the gym is open and the contest is not carried out; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on this day the gym is open and the contest is carried out. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"On each of days Vasya can either have a rest or write the contest (if it is carried out on this day), or do sport (if the gym is open on this day)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum number of days on which Vasya will have a rest (it means, he will not do sport and write the contest at the same time). The only limitation that Vasya has — "},{"children":[{"kind":"text","text":"he does not want to do the same activity on two consecutive days: it means, he will not do sport on two consecutive days, and write the contest on two consecutive days"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of days of Vasya's vacations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 3"},{"kind":"text","text":") separated by space, where: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals 0, if on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day of vacations the gym is closed and the contest is not carried out; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals 1, if on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day of vacations the gym is closed, but the contest is carried out; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals 2, if on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day of vacations the gym is open and the contest is not carried out; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals 3, if on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day of vacations the gym is open and the contest is carried out."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible number of days on which Vasya will have a rest. Remember that Vasya refuses:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" to do sport on any two consecutive days, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to write the contest on any two consecutive days. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 3 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 3 3 2 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Vasya can write the contest on the day number 1 and do sport on the day number 3. Thus, he will have a rest for only 2 days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test Vasya should write contests on days number 1, 3, 5 and 7, in other days do sport. Thus, he will not have a rest for a single day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test Vasya can do sport either on a day number 1 or number 2. He can not do sport in two days, because it will be contrary to the his limitation. Thus, he will have a rest for only one day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"698A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/698/problem/A"}