{"assets":[],"contentKind":"statement","contestId":"2167","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Yet Another Array Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$n$$$ and an array $$$a$$$ of length $$$n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the "},{"children":[{"kind":"text","text":"smallest"}],"kind":"container"},{"kind":"text","text":" integer $$$x$$$ ($$$2 \\le x \\le 10^{18}$$$) such that there exists an index $$$i$$$ ($$$1 \\le i \\le n$$$) with "},{"children":[{"kind":"text","text":"$$$\\gcd$$$"}],"kind":"container"},{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$(a_i, x) = 1$$$. If no such $$$x$$$ exists within the range $$$[2,10^{18}]$$$, output $$$-1$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$\\gcd(x, y)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$x$$$ and $$$y$$$. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$t$$$ test cases consists of two lines:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^{5}$$$) — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ space-separated integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^{18}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the total sum of $$$n$$$ across all test cases does not exceed $$$10^{5}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer: the smallest $$$x$$$ ($$$2 \\le x \\le 10^{18}$$$) such that there exists an index $$$i$$$ with $$$\\gcd(a_i, x) = 1$$$. If there is no such $$$x$$$ in the range $$$[2,10^{18}]$$$, print $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n1\n4\n6 6 12 12\n3\n24 120 210\n4\n2 4 6 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n5\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$\\gcd(2,1)=1$$$, which is the smallest number satisfying the condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\gcd(2,6)=2$$$, $$$\\gcd(2,12)=2$$$, so $$$2$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(3,6)=3$$$, $$$\\gcd(3,12)=3$$$, so $$$3$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(4,6)=2$$$, $$$\\gcd(4,12)=4$$$, so $$$4$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(5,6)=1$$$, so the answer is $$$5$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\gcd(2,24)=2$$$, $$$\\gcd(2,120)=2$$$, $$$\\gcd(2,210)=2$$$, so $$$2$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(3,24)=3$$$, $$$\\gcd(3,120)=3$$$, $$$\\gcd(3,210)=3$$$, so $$$3$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(4,24)=4$$$, $$$\\gcd(4,120)=4$$$, $$$\\gcd(4,210)=2$$$, so $$$4$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(5,24)=1$$$, so the answer is $$$5$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fourth test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\gcd(2,2)=2$$$, $$$\\gcd(2,4)=2$$$, $$$\\gcd(2,6)=2$$$, $$$\\gcd(2,10)=2$$$, so $$$2$$$ cannot be the answer. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(3,2)=1$$$, so the answer is $$$3$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2167D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2167/problem/D"}