{"assets":[],"contentKind":"statement","contestId":"590","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Top Secret Task"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A top-secret military base under the command of Colonel Zuev is expecting an inspection from the Ministry of Defence. According to the charter, each top-secret military base must include a top-secret troop that should... well, we cannot tell you exactly what it should do, it is a top secret troop at the end. The problem is that Zuev's base is missing this top-secret troop for some reasons."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The colonel decided to deal with the problem immediately and ordered to line up in a single line all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" soldiers of the base entrusted to him. Zuev knows that the "},{"children":[{"kind":"text","text":"loquacity"}],"kind":"container"},{"kind":"text","text":" of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th soldier from the left is equal to "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":". Zuev wants to form the top-secret troop using "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" leftmost soldiers in the line, thus he wants their total loquacity to be as small as possible (as the troop should remain top-secret). To achieve this, he is going to choose a pair of "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" soldiers and swap them. He intends to do so no more than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" times. Note that any soldier can be a participant of such swaps for any number of times. The problem turned out to be unusual, and colonel Zuev asked you to help."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine, what is the minimum total loquacity of the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" soldiers in the line, that can be achieved by performing no more than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" swaps of two consecutive soldiers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 150"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s ≤ 109"},{"kind":"text","text":") — the number of soldiers in the line, the size of the top-secret troop to be formed and the maximum possible number of swap operations of the consecutive pair of soldiers, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ qi ≤ 1 000 000"},{"kind":"text","text":") — the values of loquacity of soldiers in order they follow in line from left to right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum possible total loquacity of the top-secret troop."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n2 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2\n10 1 6 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n3 1 4 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Colonel has to swap second and third soldiers, he doesn't really need the remaining swap. The resulting soldiers order is: ("},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"). Minimum possible summary loquacity of the secret troop is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". In the second sample Colonel will perform swaps in the following order:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" (10, 1, "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":" — "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":", 5) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (10, 1, 2, "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":" — "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":") "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The resulting soldiers order is (10, 1, 2, 5, 6). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Minimum possible summary loquacity is equal to "},{"kind":"math_inline","text":"18"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"590D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/590/problem/D"}