{"assets":["/statement-assets/43facaf411c775f32b5ab73e4bb3ca9a01662f7bdaa6efc23229857505b0c27b.png","/statement-assets/0013de2f61f703ec283bac8c3d043e8b07610b4708322292448b4a078aca8707.png","/statement-assets/3f5d6e91f8ffab0f5d65210b29db759edc171fdba7782f4241863dbb90c617cd.png"],"contentKind":"statement","contestId":"922","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Robot Vacuum Cleaner"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pushok the dog has been chasing Imp for a few hours already."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/43facaf411c775f32b5ab73e4bb3ca9a01662f7bdaa6efc23229857505b0c27b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Fortunately, Imp knows that Pushok is afraid of a robot vacuum cleaner. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While moving, the robot generates a string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" consisting of letters '"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"', that produces a lot of noise. We define "},{"children":[{"kind":"text","text":"noise"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" as the number of occurrences of string \""},{"children":[{"kind":"text","text":"sh"}],"kind":"container"},{"kind":"text","text":"\" as a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" in it, in other words, the number of such pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/0013de2f61f703ec283bac8c3d043e8b07610b4708322292448b4a078aca8707.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/3f5d6e91f8ffab0f5d65210b29db759edc171fdba7782f4241863dbb90c617cd.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The robot is off at the moment. Imp knows that it has a sequence of strings "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" in its memory, and he can arbitrary change their order. When the robot is started, it generates the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" as a concatenation of these strings in the given order. The noise of the resulting string equals the noise of this concatenation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Imp to find the maximum noise he can achieve by changing the order of the strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of strings in robot's memory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the strings "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":", one per line. It is guaranteed that the strings are non-empty, contain only English letters '"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"' and their total length does not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maxumum possible "},{"children":[{"kind":"text","text":"noise"}],"kind":"container"},{"kind":"text","text":" Imp can achieve by changing the order of the strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nssh\nhs\ns\nhhhs\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nh\ns\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The optimal concatenation in the first sample is "},{"kind":"math_inline","text":"ssshhshhhs"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"922D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/922/problem/D"}