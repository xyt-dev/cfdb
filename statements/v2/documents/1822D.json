{"assets":[],"contentKind":"statement","contestId":"1822","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Super-Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A permutation is a sequence $$$n$$$ integers, where each integer from $$$1$$$ to $$$n$$$ appears exactly once. For example, $$$[1]$$$, $$$[3,5,2,1,4]$$$, $$$[1,3,2]$$$ are permutations, while $$$[2,3,2]$$$, $$$[4,3,1]$$$, $$$[0]$$$ are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a permutation $$$a$$$, we construct an array $$$b$$$, where $$$b_i = (a_1 + a_2 +~\\dots~+ a_i) \\bmod n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A permutation of numbers $$$[a_1, a_2, \\dots, a_n]$$$ is called a "},{"children":[{"kind":"text","text":"super-permutation"}],"kind":"container"},{"kind":"text","text":" if $$$[b_1 + 1, b_2 + 1, \\dots, b_n + 1]$$$ is also a permutation of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Grisha became interested whether a "},{"children":[{"kind":"text","text":"super-permutation"}],"kind":"container"},{"kind":"text","text":" of length $$$n$$$ exists. Help him solve this non-trivial problem. Output any "},{"children":[{"kind":"text","text":"super-permutation"}],"kind":"container"},{"kind":"text","text":" of length $$$n$$$, if it exists. Otherwise, output $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of a single line containing one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the desired permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output in a separate line:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$n$$$ integers — a "},{"children":[{"kind":"text","text":"super-permutation"}],"kind":"container"},{"kind":"text","text":" of length $$$n$$$, if it exists. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$-1$$$, otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are several suitable permutations, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n2\n3\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2 1\n-1\n6 5 2 3 4 1"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1822D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1822/problem/D"}