{"assets":[],"contentKind":"statement","contestId":"690","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D3. The Wall (hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"15 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"So many wall designs to choose from! Even modulo "},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":", it's an enormous number. Given that recently Heidi acquired an unlimited supply of bricks, her choices are endless! She really needs to do something to narrow them down."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi is quick to come up with criteria for a "},{"children":[{"kind":"text","text":"useful"}],"kind":"container"},{"kind":"text","text":" wall:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In a useful wall, at least one segment is wider than "},{"kind":"math_inline","text":"W"},{"kind":"text","text":" bricks. This should give the zombies something to hit their heads against. Or, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in a useful wall, at least one column is higher than "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" bricks. This provides a lookout from which zombies can be spotted at a distance. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This should rule out a fair amount of possibilities, right? Help Heidi compute the number of "},{"children":[{"kind":"text","text":"useless"}],"kind":"container"},{"kind":"text","text":" walls that do not confirm to either of these criteria. In other words, a wall is useless if every segment has width at most "},{"kind":"math_inline","text":"W"},{"kind":"text","text":" and height at most "},{"kind":"math_inline","text":"H"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Parameter "},{"kind":"math_inline","text":"C"},{"kind":"text","text":", the total width of the wall, has the same meaning as in the easy version. However, note that the number of bricks is now unlimited."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output the number of useless walls modulo "},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and the only line of the input contains three space-separated integers "},{"kind":"math_inline","text":"C"},{"kind":"text","text":", "},{"kind":"math_inline","text":"W"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ C ≤ 108"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ W, H ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of different walls, modulo "},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":", which are useless according to Heidi's criteria."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kin