{"assets":[],"contentKind":"statement","contestId":"451","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sort the Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Being a programmer, you like arrays a lot. For your birthday, your friends have given you an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, the size of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is too small. You want a bigger array! Your friends agree to give you a bigger array, but only if you are able to answer the following question correctly: is it possible to sort the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" (in increasing order) by reversing "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" segment of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"? See definitions of segment and reversing in the notes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the size of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct space-separated integers: "},{"kind":"math_inline","text":"a[1], a[2], ..., a[n]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a[i] ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), depending on the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If your answer is \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", then also print two space-separated integers denoting start and end (start must not be greater than end) indices of the segment to be reversed. If there are multiple ways of selecting these indices, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"yes\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"yes\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n3 1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"no\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"yes\n1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sample 1. You can reverse the entire array to get "},{"kind":"math_inline","text":"[1, 2, 3]"},{"kind":"text","text":", which is sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sample 3. No segment can be reversed such that the array will be sorted."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Definitions"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the sequence "},{"kind":"math_inline","text":"a[l], a[l + 1], ..., a[r]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you have an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and you reverse its segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", the array will become:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"a[1], a[2], ..., a[l - 2], a[l - 1], a[r], a[r - 1], ..., a[l + 1], a[l], a[r + 1], a[r + 2], ..., a[n - 1], a[n]."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"451B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/451/problem/B"}