{"assets":[],"contentKind":"statement","contestId":"374","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Inna and Dima"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Inna and Dima bought a table of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" in the shop. Each cell of the table contains a single letter: \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Inna loves Dima, so she wants to go through his name as many times as possible as she moves through the table. For that, Inna acts as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" initially, Inna chooses some cell of the table where letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" is written; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then Inna can move to some side-adjacent table cell that contains letter \""},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"\"; then from this cell she can go to one of the side-adjacent table cells that contains the written letter \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\"; then she can go to a side-adjacent cell that contains letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\". Then Inna assumes that she has gone through her sweetheart's name; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Inna's next move can be going to one of the side-adjacent table cells that contains letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" and then walk on through name DIMA in the similar manner. Inna never skips a letter. So, from the letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" she always goes to the letter \""},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"\", from the letter \""},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"\" she always goes the to letter \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\", from the letter \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\" she always goes to the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", and from the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" she always goes to the letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Depending on the choice of the initial table cell, Inna can go through name DIMA either an infinite number of times or some positive finite number of times or she can't go through his name once. Help Inna find out what maximum number of times she can go through name DIMA."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 103)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines that describe Inna and Dima's table. Each line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. Each character is one of the following four characters: \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is not guaranteed that the table contains at least one letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Inna cannot go through name DIMA once, print on a single line \""},{"children":[{"kind":"text","text":"Poor Dima!"}],"kind":"container"},{"kind":"text","text":"\" without the quotes. If there is the infinite number of names DIMA Inna can go through, print \""},{"children":[{"kind":"text","text":"Poor Inna!"}],"kind":"container"},{"kind":"text","text":"\" without the quotes. Otherwise print a single integer — the maximum number of times Inna can go through name DIMA."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\nDI\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Poor Dima!\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\nMA\nID\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Poor Inna!\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\nDIMAD\nDIMAI\nDIMAM\nDDMAA\nAAMID\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Notes to the samples:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first test sample, Inna cannot go through name DIMA a single time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test sample, Inna can go through the infinite number of words DIMA. For that, she should move in the clockwise direction starting from the lower right corner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test sample the best strategy is to start from the cell in the upper left corner of the table. Starting from this cell, Inna can go through name DIMA four times. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"374C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/374/problem/C"}