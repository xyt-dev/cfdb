{"assets":[],"contentKind":"statement","contestId":"1912","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"L. LOL Lovers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ food items lying in a row on a long table. Each of these items is either a loaf of bread (denoted as a capital Latin letter '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' with ASCII code 76) or an onion (denoted as a capital Latin letter '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' with ASCII code 79). There is at least one loaf of bread and at least one onion on the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You and your friend want to divide the food on the table: you will take a prefix of this row (several leftmost items), and the friend will take the rest. However, there are several restrictions: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each person should have at least one item. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The number of your loaves should differ from the number of your friend's loaves. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The number of your onions should differ from the number of your friend's onions. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Find any correct division and print the number of items you take or report that there is no answer."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 200$$$) — the number of food items on the table. The second line contains a string of length $$$n$$$ consisting of letters '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"'. $$$i$$$-th symbol represents the type of the $$$i$$$-th food item on the table: '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' stands for a loaf of bread, and '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' stands for an onion. It is guaranteed that this string contains at least one letter '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' and at least one letter '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — a number $$$k$$$ such that, if you take $$$k$$$ leftmost items and your friend takes the remaining $$$n - k$$$ items, each of you and your friend get at least one item, your number of loaves is different from your friend's, and your number of onions is different from your friend's. If there are several possible answers, print any of them. If there are no possible answers, print the number $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nLOL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nLO\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nLLLO\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nOLOL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\nLLOOOOLLLO\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, in any division the left and the right part contain one loaf of bread."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the division is '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"', and in these two strings the number of loaves is different (1 and 0) and the number of onions is different (0 and 1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, any number 1, 2 or 3 is a correct answer."}],"kind":"paragraph"},{"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"L","problemCode":"1912L","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1912/problem/L"}