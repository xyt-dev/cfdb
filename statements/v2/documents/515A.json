{"assets":["/statement-assets/44be2522d6ecd54686fb69b528d12d2772ee936381e6eafcc40f0f692b88879a.png"],"contentKind":"statement","contestId":"515","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Drazil and Date"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Someday, Drazil wanted to go on date with Varda. Drazil and Varda live on Cartesian plane. Drazil's home is located in point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" and Varda's home is located in point "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":". In each step, he can move in a unit distance in horizontal or vertical direction. In other words, from position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" he can go to positions "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x - 1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Drazil doesn't have sense of direction. So he randomly chooses the direction he will go to in each step. He may accidentally return back to his house during his travel. Drazil may even not notice that he has arrived to "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" and continue travelling. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Luckily, Drazil arrived to the position "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" successfully. Drazil said to Varda: \"It took me exactly "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" steps to travel from my house to yours\". But Varda is confused about his words, she is not sure that it is possible to get from "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" in exactly "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" steps. Can you find out if it is possible for Varda?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"You are given three integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ a, b ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s ≤ 2·109"},{"kind":"text","text":") in a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If you think Drazil made a mistake and it is impossible to take exactly "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" steps and get from his home to Varda's home, print \"No\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \"Yes\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 15 25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In fourth sample case one possible route is: "},{"attrs":{"alt":"","src":"/statement-assets/44be2522d6ecd54686fb69b528d12d2772ee936381e6eafcc40f0f692b88879a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"515A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/515/problem/A"}