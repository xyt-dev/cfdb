square, so 10 is "},{"children":[{"kind":"text","text":"lovely"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample case, there are numbers 1, 2, 3, 4, 6 and 12 in the shop. 12 is divisible by "},{"kind":"math_inline","text":"4 = 22"},{"kind":"text","text":", so 12 is not "},{"children":[{"kind":"text","text":"lovely"}],"kind":"container"},{"kind":"text","text":", while 6 is indeed "},{"children":[{"kind":"text","text":"lovely"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"588B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/588/problem/B"}