$$, ..., $$$9$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of even substrings of $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1234\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2244\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the $$$[l, r]$$$ pairs corresponding to even substrings are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s[1 \\dots 2]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s[2 \\dots 2]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s[1 \\dots 4]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s[2 \\dots 4]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s[3 \\dots 4]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s[4 \\dots 4]$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, all $$$10$$$ substrings of $$$s$$$ are even substrings. Note, that while substrings $$$s[1 \\dots 1]$$$ and $$$s[2 \\dots 2]$$$ both define the substring \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\", they are still counted as different substrings."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1139A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1139/problem/A"}