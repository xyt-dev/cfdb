agraph"},{"children":[{"kind":"text","text":"You have to implement an operation which takes an array of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" qubits as an input and returns an integer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your code should have the following signature:"}],"kind":"paragraph"},{"kind":"code_block","text":"namespace Solution {\n    open Microsoft.Quantum.Primitive;\n    open Microsoft.Quantum.Canon;\n\n    operation Solve (qs : Qubit[]) : Int\n    {\n        body\n        {\n            // your code here\n        }\n    }\n}"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B1","problemCode":"1002B1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1002/problem/B1"}