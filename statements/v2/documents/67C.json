{"assets":[],"contentKind":"statement","contestId":"67","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sequence of Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence of balls "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" by your teacher, each labeled with a lowercase Latin letter 'a'-'z'. You don't like the given sequence. You want to change it into a new sequence, "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" that suits you better. So, you allow yourself four operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" You can insert any ball with any label into the sequence at any position. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can delete (remove) any ball from any position. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can replace any ball with any other ball. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can exchange (swap) two adjacent balls. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your teacher now places time constraints on each operation, meaning that an operation can only be performed in certain time. So, the first operation takes time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", the second one takes "},{"kind":"math_inline","text":"td"},{"kind":"text","text":", the third one takes "},{"kind":"math_inline","text":"tr"},{"kind":"text","text":" and the fourth one takes "},{"kind":"math_inline","text":"te"},{"kind":"text","text":". Also, it is given that "},{"kind":"math_inline","text":"2·te ≥ ti + td"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimal time to convert the sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to the sequence "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"ti, td, tr, te"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 < ti, td, tr, te ≤ 100"},{"kind":"text","text":"). The following two lines contain sequences "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" on separate lines. The length of each line is between 1 and 4000 characters inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer representing minimum time to convert "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 1\nyoushouldnot\nthoushaltnot\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 10 3\nab\nba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10 20 30\na\nza\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample, you could delete the ball labeled 'a' from the first position and then insert another 'a' at the new second position with total time 6. However exchanging the balls give total time 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"67C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/67/problem/C"}