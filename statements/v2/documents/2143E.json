{"assets":[],"contentKind":"statement","contestId":"2143","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Make Good"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a bracket string $$$s$$$ of length $$$n$$$. You can apply the following operations arbitrary number of times (possibly, zero) and in any order:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose an index $$$1 \\leq i \\lt |s|$$$ such that $$$s_i = s_{i+1} = \\texttt{(}$$$, and replace both $$$s_i$$$ and $$$s_{i+1}$$$ with $$$\\texttt{)}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose an index $$$1 \\leq i \\lt |s|$$$ such that $$$s_i = s_{i+1} = \\texttt{)}$$$, and replace both $$$s_i$$$ and $$$s_{i+1}$$$ with $$$\\texttt{(}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find a regular bracket sequence$$$^{\\text{∗}}$$$ $$$t$$$ which can be obtained from $$$s$$$ by applying the operations described above, or print $$$-1$$$ if there is no such $$$t$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"+\""}],"kind":"container"},{"kind":"text","text":" between the original characters of the sequence. For example: the bracket sequences "},{"children":[{"kind":"text","text":"\"()()\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"(())\""}],"kind":"container"},{"kind":"text","text":" are regular (the resulting expressions are: "},{"children":[{"kind":"text","text":"\"(1)+(1)\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"((1+1)+1)\")"}],"kind":"container"},{"kind":"text","text":"; the bracket sequences "},{"children":[{"kind":"text","text":"\")(\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"(\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\")\""}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$) — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single string $$$s$$$ — a sequence of the characters "},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":" of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output a regular bracket string $$$t$$$ which can be obtained from $$$s$$$ or print $$$-1$$$ if there is no such $$$t$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\n()()\n6\n((())(\n10\n))(())())(\n8\n))))))))\n1\n(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n()()\n-1\n-1\n(())(())\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, the string "},{"children":[{"kind":"text","text":"\"()()\""}],"kind":"container"},{"kind":"text","text":" is already a regular bracket sequence. No changes needed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and third testcases it's impossible to reach a regular bracket string from $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth testcase we can do the following:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"\"))))))))\""}],"kind":"container"},{"kind":"text","text":" $$$\\xrightarrow{i = 1}$$$ "},{"children":[{"kind":"text","text":"\"(())))))\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"\"(())))))\""}],"kind":"container"},{"kind":"text","text":" $$$\\xrightarrow{i = 5}$$$ "},{"children":[{"kind":"text","text":"\"(())(())\""}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2143E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2143/problem/E"}