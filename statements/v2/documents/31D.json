{"assets":[],"contentKind":"statement","contestId":"31","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Chocolate"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bob has a rectangular chocolate bar of the size "},{"kind":"math_inline","text":"W × H"},{"kind":"text","text":". He introduced a cartesian coordinate system so that the point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" corresponds to the lower-left corner of the bar, and the point "},{"kind":"math_inline","text":"(W, H)"},{"kind":"text","text":" corresponds to the upper-right corner. Bob decided to split the bar into pieces by breaking it. Each break is a segment parallel to one of the coordinate axes, which connects the edges of the bar. More formally, each break goes along the line "},{"kind":"math_inline","text":"x = xc"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"y = yc"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xc"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yc"},{"kind":"text","text":" are integers. It should divide one part of the bar into two non-empty parts. After Bob breaks some part into two parts, he breaks the resulting parts "},{"children":[{"kind":"text","text":"separately and independently from each other"}],"kind":"container"},{"kind":"text","text":". Also he doesn't move the parts of the bar. Bob made "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" breaks and wrote them down in his notebook in arbitrary order. At the end he got "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" parts. Now he wants to calculate their areas. Bob is lazy, so he asks you to do this task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains 3 integers "},{"kind":"math_inline","text":"W"},{"kind":"text","text":", "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ W, H, n ≤ 100"},{"kind":"text","text":") — width of the bar, height of the bar and amount of breaks. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains four integers "},{"kind":"math_inline","text":"xi, 1, yi, 1, xi, 2, yi, 2"},{"kind":"text","text":" — coordinates of the endpoints of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th break ("},{"kind":"math_inline","text":"0 ≤ xi, 1 ≤ xi, 2 ≤ W, 0 ≤ yi, 1 ≤ yi, 2 ≤ H"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"xi, 1 = xi, 2"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"yi, 1 = yi, 2"},{"kind":"text","text":"). Breaks are given in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the set of breaks is correct, i.e. there is some order of the given breaks that each next break divides exactly one part of the bar into two non-empty parts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" numbers — areas of the resulting parts in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n1 0 1 2\n0 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 3\n1 0 1 2\n0 1 1 1\n1 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 2\n0 1 2 1\n0 3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"31D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/31/problem/D"}