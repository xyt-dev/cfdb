{"assets":["/statement-assets/420e9d97857efab1f640a11e122bf06cf1eeb245f4affdc5a7f43954eea24158.png","/statement-assets/62d4184c9b1c38c822f9aa044e8d9e75e6b4116c2bcc98dd8aed19dc33b32dc1.png"],"contentKind":"statement","contestId":"696","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. ...Wait for it..."}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Barney is searching for his dream girl. He lives in NYC. NYC has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" junctions numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" roads connecting them. We will consider the NYC as a rooted tree with root being junction "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" girls live in NYC, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them lives along junction "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and her weight initially equals "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" pounds."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/420e9d97857efab1f640a11e122bf06cf1eeb245f4affdc5a7f43954eea24158.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Barney consider a girl "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to be "},{"children":[{"kind":"text","text":"better"}],"kind":"container"},{"kind":"text","text":" than a girl "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if and only if: girl "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" has weight strictly less than girl "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" or girl "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and girl "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" have equal weights and index of girl "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" living junction index is strictly less than girl "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" living junction index, i.e. "},{"kind":"math_inline","text":"cx < cy"},{"kind":"text","text":". Thus for any two girls one of them is always better than another one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" days, one event happens each day. There are two types of events:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". As a result he picks at most "},{"kind":"math_inline","text":"k"},{"children":[{"kind":"text","text":"best girls he still have not invited"}],"kind":"container"},{"kind":"text","text":" from junctions on his way and invites them to his house to test if one of them is his dream girl. If there are less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" not invited girls on his path, he invites all of them."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Girls living along junctions in subtree of junction "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" (including "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" itself) put on some weight. As result, their weights increase by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pounds. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is for each event of first type tell Barney the indices of girls he will invite to his home in this event."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, q ≤ 105"},{"kind":"text","text":") — the number of junctions in NYC, the number of girls living in NYC and the number of events respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describes the roads. Each line contains two integers "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n, v ≠ u"},{"kind":"text","text":") meaning that there is a road connecting junctions "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":") — the girl's living junctions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the events in chronological order. Each line starts with an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 2"},{"kind":"text","text":") — type of the event ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":" then the line describes event of first type three integers "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u, k ≤ n"},{"kind":"text","text":") follow — the endpoints of Barney's path and the number of girls that he will invite at most."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise the line describes event of second type and two integers "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n, 1 ≤ k ≤ 109"},{"kind":"text","text":") follow — the root of the subtree and value by which all the girls' weights in the subtree should increase."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each event of the first type, print number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and then "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"g1, g2, ..., gt"},{"kind":"text","text":" in one line, meaning that in this event Barney will invite "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" girls whose indices are "},{"kind":"math_inline","text":"g1, ..., gt"},{"children":[{"kind":"text","text":"in the order from the best to the worst"}],"kind":"container"},{"kind":"text","text":" according to Barney's considerations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7 11\n3 5\n2 3\n4 3\n1 4\n4 1 4 5 4 1 4\n2 4 3\n1 2 1 2\n1 4 2 1\n2 2 10\n2 1 10\n1 2 4 1\n1 2 3 4\n2 5 2\n2 4 9\n1 3 5 2\n1 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1 \n1 3 \n1 5 \n0 \n1 4 \n2 6 7 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/62d4184c9b1c38c822f9aa044e8d9e75e6b4116c2bcc98dd8aed19dc33b32dc1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Description of events:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Weights of girls in subtree of junction "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" increase by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". These girls have IDs: "},{"kind":"math_inline","text":"1, 3, 5, 4, 7"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Girls on his way have IDs "},{"kind":"math_inline","text":"1, 2, 3, 5, 6, 7"},{"kind":"text","text":" with weights "},{"kind":"math_inline","text":"4, 2, 6, 8, 6, 10"},{"kind":"text","text":" respectively. So, he invites girls "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Girls on his way has IDs "},{"kind":"math_inline","text":"3, 5, 7"},{"kind":"text","text":" with weights "},{"kind":"math_inline","text":"6, 8, 10"},{"kind":"text","text":" respectively. So he invites girl "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Weight of girls in subtree of junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" increase by "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". There are no not invited girls, so nothing happens. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Weight of girls in subtree of junction "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" increase by "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". These girls (all girls left) have IDs: "},{"kind":"math_inline","text":"4, 5, 6, 7"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". Girls on his way has IDs "},{"kind":"math_inline","text":"5, 7"},{"kind":"text","text":" with weights "},{"kind":"math_inline","text":"18, 20"},{"kind":"text","text":" respectively. So he invites girl "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". There is no girl on his way. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Weight of girls in subtree of junction "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" increase by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". The only girl there is girl with ID "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Weight of girls in subtree of junction "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" increase by "},{"kind":"math_inline","text":"9"},{"kind":"text","text":". These girls have IDs: "},{"kind":"math_inline","text":"4, 6, 7"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Only girl on his way is girl with ID "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Barney goes from junction "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Girls on his way has IDs "},{"kind":"math_inline","text":"6, 7"},{"kind":"text","text":" with weights "},{"kind":"math_inline","text":"16, 29"},{"kind":"text","text":" respectively. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"696E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/696/problem/E"}