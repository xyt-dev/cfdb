{"assets":["/statement-assets/6b8892ad89313f9220506f33d7f6b0091ba2bcd64a17b4d1aa8c78ff12f57df0.png"],"contentKind":"statement","contestId":"272","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Dima and Horses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima came to the horse land. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" horses living in the land. Each horse in the horse land has several enemies (enmity is a symmetric relationship). The horse land isn't very hostile, so the number of enemies of each horse is at most 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Right now the horse land is going through an election campaign. So the horses trusted Dima to split them into two parts. At that the horses want the following condition to hold: a horse shouldn't have more than one enemy in its party."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dima split the horses into parties. Note that one of the parties can turn out to be empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, m"},{"attrs":{"alt":"","src":"/statement-assets/6b8892ad89313f9220506f33d7f6b0091ba2bcd64a17b4d1aa8c78ff12f57df0.png"},"kind":"image"},{"kind":"text","text":" — the number of horses in the horse land and the number of enemy pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines define the enemy pairs. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":", which mean that horse "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the enemy of horse "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the horses indexed in some way from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It is guaranteed that each horse has at most three enemies. No pair of enemies occurs more than once in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a line, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the line must equal \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", if the horse number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" needs to go to the first party, otherwise this character should equal \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there isn't a way to divide the horses as required, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n3 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"00\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n1 2\n1 3\n1 4\n2 3\n2 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0110000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"272E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/272/problem/E"}