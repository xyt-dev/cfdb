{"assets":["/statement-assets/dbc9dc50e8186bf63ebd83ef3d8d4d422f24047eb86faa14f2643b426917a4da.png"],"contentKind":"statement","contestId":"1761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Centroid Guess"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This in an interactive problem"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is an unknown tree consisting of $$$n$$$ nodes, which has "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" centroid. You only know $$$n$$$ at first, and your task is to find the centroid of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can ask the distance between any two vertices for at most $$$2\\cdot10^5$$$ times. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the interactor is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" adaptive. That is, the tree is fixed in each test beforehand and does not depend on your queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A vertex is called a centroid if its removal splits the tree into subtrees with at most $$$\\lfloor\\frac{n}{2}\\rfloor$$$ vertices each."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains an integer $$$n$$$ ($$$3\\le n\\le 7.5\\cdot10^4$$$) — the number of nodes in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"Start interaction by reading $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To ask a query about the distance between two nodes $$$u, v$$$ ($$$1 \\le u, v \\le n$$$), output \""},{"children":[{"kind":"text","text":"? u v"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you determine that the centroid of the tree is $$$x$$$, use \""},{"children":[{"kind":"text","text":"! x"}],"kind":"container"},{"kind":"text","text":"\" to report."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing a query, do not forget to output the end of a line and flush the output. Otherwise, you will get "},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":". To do this, use:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" see documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacks are disabled in this problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It's guaranteed that there are at most $$$500$$$ tests in this problem."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n\n2\n\n1\n\n2\n\n3\n\n1\n\n1\n\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n\n? 1 2\n\n? 1 3\n\n? 1 4\n\n? 1 5\n\n? 2 3\n\n? 3 4\n\n? 4 5\n\n! 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is an image of the tree from the sample."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dbc9dc50e8186bf63ebd83ef3d8d4d422f24047eb86faa14f2643b426917a4da.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1761G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1761/problem/G"}