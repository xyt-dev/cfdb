{"assets":[],"contentKind":"statement","contestId":"794","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bank Robbery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A robber has attempted to rob a bank but failed to complete his task. However, he had managed to open all the safes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oleg the bank client loves money (who doesn't), and decides to take advantage of this failed robbery and steal some money from the safes. There are many safes arranged in a line, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th safe from the left is called safe "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" banknotes left in all the safes in total. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th banknote is in safe "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Oleg is now at safe "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". There are two security guards, one of which guards the safe "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"b < a"},{"kind":"text","text":", i.e. the first guard is to the left of Oleg. The other guard guards the safe "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" so that "},{"kind":"math_inline","text":"c > a"},{"kind":"text","text":", i.e. he is to the right of Oleg."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The two guards are very lazy, so they do not move. In every second, Oleg can either take all the banknotes from the current safe or move to any of the neighboring safes. However, he cannot visit any safe that is guarded by security guards at any time, becaues he might be charged for stealing. Determine the maximum amount of banknotes Oleg can gather."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three space-separated integers, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b < a < c ≤ 109"},{"kind":"text","text":"), denoting the positions of Oleg, the first security guard and the second security guard, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), denoting the number of banknotes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":"), denoting that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th banknote is located in the "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"-th safe. Note that "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" guaranteed to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer: the maximum number of banknotes Oleg can take."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 7\n8\n4 7 5 5 3 6 2 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5 7\n5\n1 5 7 92 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Oleg can take the banknotes in positions "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" (note that there are "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" banknotes at position "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"). Oleg can't take the banknotes in safes "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" because he can't run into the second security guard. Similarly, Oleg cannot take the banknotes at positions "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" because he can't run into the first security guard. Thus, he can take a maximum of "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" banknotes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, Oleg can't take any banknotes without bumping into any of the security guards."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"794A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/794/problem/A"}