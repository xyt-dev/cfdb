{"assets":["/statement-assets/803bb864d4337280cb2190e1164a97ae4d6e6ab49990077837591c300ea0186a.png","/statement-assets/a5610e5397a55931798b5259820a0902f38f740c042f80e422ed37d94a7b1bde.png"],"contentKind":"statement","contestId":"1394","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Boboniu Walks on Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Boboniu has a "},{"children":[{"kind":"text","text":"directed"}],"kind":"container"},{"kind":"text","text":" graph with $$$n$$$ vertices and $$$m$$$ edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The out-degree of each vertex is at most $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each edge has an integer weight between $$$1$$$ and $$$m$$$. No two edges have equal weights."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Boboniu likes to walk on the graph with some specific rules, which is represented by a tuple $$$(c_1,c_2,\\ldots,c_k)$$$. If he now stands on a vertex $$$u$$$ with out-degree $$$i$$$, then he will go to the next vertex by the edge with the $$$c_i$$$-th $$$(1\\le c_i\\le i)$$$ smallest weight among all edges outgoing from $$$u$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Boboniu asks you to calculate the number of tuples $$$(c_1,c_2,\\ldots,c_k)$$$ such that"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1\\le c_i\\le i$$$ for all $$$i$$$ ($$$1\\le i\\le k$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Starting from any vertex $$$u$$$, it is possible to go back to $$$u$$$ in finite time by walking on the graph under the described rules. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$ and $$$k$$$ ($$$2\\le n\\le 2\\cdot 10^5$$$, $$$2\\le m\\le \\min(2\\cdot 10^5,n(n-1) )$$$, $$$1\\le k\\le 9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains three integers $$$u$$$, $$$v$$$ and $$$w$$$ $$$(1\\le u,v\\le n,u\\ne v,1\\le w\\le m)$$$, denoting an edge from $$$u$$$ to $$$v$$$ with weight $$$w$$$. It is guaranteed that there are no self-loops or multiple edges and each vertex has at least one edge starting from itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the out-degree of each vertex is at most $$$k$$$ and no two edges have equal weight."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer: the number of tuples."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 6 3\n4 2 1\n1 2 2\n2 4 3\n4 1 4\n4 3 5\n3 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 5 1\n1 4 1\n5 1 2\n2 5 3\n4 3 4\n3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 13 4\n3 5 1\n2 5 2\n6 3 3\n1 4 4\n2 6 5\n5 3 6\n4 1 7\n4 3 8\n5 2 9\n4 2 10\n2 1 11\n6 1 12\n4 6 13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, there are two tuples: $$$(1,1,3)$$$ and $$$(1,2,3)$$$. The blue edges in the picture denote the $$$c_i$$$-th smallest edges for each vertex, which Boboniu chooses to go through."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/803bb864d4337280cb2190e1164a97ae4d6e6ab49990077837591c300ea0186a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the third example, there's only one tuple: $$$(1,2,2,2)$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a5610e5397a55931798b5259820a0902f38f740c042f80e422ed37d94a7b1bde.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"out-degree"}],"kind":"container"},{"kind":"text","text":" of vertex $$$u$$$ means the number of edges outgoing from $$$u$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1394B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1394/problem/B"}