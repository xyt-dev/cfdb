{"assets":[],"contentKind":"statement","contestId":"478","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Random Teams"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants of the competition were split into "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" teams in some manner so that each team has at least one participant. After the competition each pair of participants from the same team became friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to write a program that will find the minimum and the maximum number of pairs of friends that could have formed by the end of the competition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", separated by a single space ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 109"},{"kind":"text","text":") — the number of participants and the number of teams respectively. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the output should contain two integers "},{"kind":"math_inline","text":"kmin"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"kmax"},{"kind":"text","text":" — the minimum possible number of pairs of friends and the maximum possible number of pairs of friends respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample all the participants get into one team, so there will be exactly ten pairs of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample at any possible arrangement one team will always have two participants and the other team will always have one participant. Thus, the number of pairs of friends will always be equal to one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample minimum number of newly formed friendships can be achieved if participants were split on teams consisting of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" people, maximum number can be achieved if participants were split on teams of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" people."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"478B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/478/problem/B"}