{"assets":[],"contentKind":"statement","contestId":"774","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Lie or Truth"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has a sequence of cubes and exactly one integer is written on each cube. Vasya exhibited all his cubes in a row. So the sequence of numbers written on the cubes in the order from the left to the right equals to "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While Vasya was walking, his little brother Stepan played with Vasya's cubes and changed their order, so now the sequence of numbers written on the cubes became equal to "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Stepan said that he swapped only cubes which where on the positions between "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive, and did not remove or add any other cubes (i. e. he said that he reordered cubes between positions "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive, in some way)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if it is possible that Stepan said the truth, or it is guaranteed that Stepan deceived his brother."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") — the number of Vasya's cubes and the positions told by Stepan."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") — the sequence of integers written on cubes in the Vasya's order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains the sequence "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ n"},{"kind":"text","text":") — the sequence of integers written on cubes after Stepan rearranged their order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that Stepan did not remove or add other cubes, he only rearranged Vasya's cubes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"LIE"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if it is guaranteed that Stepan deceived his brother. In the other case, print \""},{"children":[{"kind":"text","text":"TRUTH"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 4\n3 4 2 3 1\n3 2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"TRUTH\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n1 2 3\n3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LIE\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 4\n1 1 1 1\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"TRUTH\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there is a situation when Stepan said the truth. Initially the sequence of integers on the cubes was equal to "},{"children":[{"kind":"text","text":"[3, 4, 2, 3, 1]"}],"kind":"container"},{"kind":"text","text":". Stepan could at first swap cubes on positions "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (after that the sequence of integers on cubes became equal to "},{"children":[{"kind":"text","text":"[3, 2, 4, 3, 1]"}],"kind":"container"},{"kind":"text","text":"), and then swap cubes in positions "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" (after that the sequence of integers on cubes became equal to "},{"children":[{"kind":"text","text":"[3, 2, 3, 4, 1]"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it is not possible that Stepan said truth because he said that he swapped cubes only between positions "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", but we can see that it is guaranteed that he changed the position of the cube which was on the position "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" at first. So it is guaranteed that Stepan deceived his brother."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example for any values "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" there is a situation when Stepan said the truth."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"774D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/774/problem/D"}