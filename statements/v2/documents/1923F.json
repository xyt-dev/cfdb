{"assets":[],"contentKind":"statement","contestId":"1923","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Shrink-Reverse"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ of length $$$n$$$ (a string consisting of $$$n$$$ characters, and each character is either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's look at $$$s$$$ as at a binary representation of some integer, and name that integer as the "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" of string $$$s$$$. For example, the value of "},{"children":[{"kind":"text","text":"000"}],"kind":"container"},{"kind":"text","text":" is $$$0$$$, the value of "},{"children":[{"kind":"text","text":"01101"}],"kind":"container"},{"kind":"text","text":" is $$$13$$$, \""},{"children":[{"kind":"text","text":"100000"}],"kind":"container"},{"kind":"text","text":"\" is $$$32$$$ and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform at most $$$k$$$ operations on $$$s$$$. Each operation should have one of the two following types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"SWAP"}],"kind":"container"},{"kind":"text","text":": choose two indices $$$i \\lt j$$$ in $$$s$$$ and swap $$$s_i$$$ with $$$s_j$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"SHRINK-REVERSE"}],"kind":"container"},{"kind":"text","text":": delete all leading zeroes from $$$s$$$ and reverse $$$s$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" For example, after you perform "},{"children":[{"kind":"text","text":"SHRINK-REVERSE"}],"kind":"container"},{"kind":"text","text":" on "},{"children":[{"kind":"text","text":"000101100"}],"kind":"container"},{"kind":"text","text":", you'll get "},{"children":[{"kind":"text","text":"001101"}],"kind":"container"},{"kind":"text","text":"."},{"children":[{"kind":"text","text":"What is the minimum value of $$$s$$$ you can achieve by performing at most $$$k$$$ operations on $$$s$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 5 \\cdot 10^5$$$; $$$1 \\le k \\le n$$$) — the length of the string $$$s$$$ and the maximum number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$ consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: $$$s$$$ contains "},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum value of $$$s$$$ you can achieve using no more than $$$k$$$ operations. Since the answer may be too large, print it modulo $$$10^{9} + 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you need to minimize the original value, not the remainder."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 2\n10010010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 2\n01101000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n30 30\n111111111111111111111111111111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n73741816\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14 1\n10110001111100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3197\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, one of the optimal strategies is the following: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"0010"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" $$$\\xrightarrow{\\texttt{SWAP}}$$$ "},{"children":[{"kind":"text","text":"00010110"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"000"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"011"},{"children":[{"kind":"text","text":"0"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\xrightarrow{\\texttt{SWAP}}$$$ "},{"children":[{"kind":"text","text":"00000111"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The value of "},{"children":[{"kind":"text","text":"00000111"}],"kind":"container"},{"kind":"text","text":" is $$$7$$$."},{"children":[{"kind":"text","text":"In the second example, one of the optimal strategies is the following: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"01101000"}],"kind":"container"},{"kind":"text","text":" $$$\\xrightarrow{\\texttt{SHRINK}}$$$ "},{"children":[{"kind":"text","text":"1101000"}],"kind":"container"},{"kind":"text","text":" $$$\\xrighta