{"assets":[],"contentKind":"statement","contestId":"812","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sagheer and Kindergarten"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sagheer is working at a kindergarten. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" children and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" different toys. These children use well-defined protocols for playing with the toys:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each child has a lovely set of toys that he loves to play with. He requests the toys one after another at distinct moments of time. A child starts playing if and only if he is granted all the toys in his lovely set."}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a child starts playing, then sooner or later he gives the toys back. No child keeps the toys forever."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Children request toys at distinct moments of time. No two children request a toy at the same time."}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a child is granted a toy, he never gives it back until he finishes playing with his lovely set."}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a child is not granted a toy, he waits until he is granted this toy. He can't request another toy while waiting."}],"kind":"list_item"},{"children":[{"kind":"text","text":" If two children are waiting for the same toy, then the child who requested it first will take the toy first."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Children don't like to play with each other. That's why they never share toys. When a child requests a toy, then granting the toy to this child depends on whether the toy is free or not. If the toy is free, Sagheer will give it to the child. Otherwise, the child has to wait for it and can't request another toy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Children are smart and can detect if they have to wait forever before they get the toys they want. In such case they start crying. In other words, a crying set is a set of children in which each child is waiting for a toy that is kept by another child in the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, we have reached a scenario where all the children made all the requests for their lovely sets, except for one child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that still has one last request for his lovely set. Some children are playing while others are waiting for a toy, but no child is crying, and no one has yet finished playing. If the child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is currently waiting for some toy, he makes his last request just after getting that toy. Otherwise, he makes the request right away. When child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" will make his last request, how many children will start crying?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will be given the scenario and "},{"kind":"math_inline","text":"q"},{"children":[{"kind":"text","text":"independent"}],"kind":"container"},{"kind":"text","text":" queries. Each query will be of the form "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" meaning that the last request of the child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is for the toy "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Your task is to help Sagheer find the size of the "},{"children":[{"kind":"text","text":"maximal"}],"kind":"container"},{"kind":"text","text":" crying set when child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" makes his last request."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k, q ≤ 105"},{"kind":"text","text":") — the number of children, toys, scenario requests and queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ b ≤ m"},{"kind":"text","text":") — a scenario request meaning child "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" requests toy "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The requests are given in the order they are made by children."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ y ≤ m"},{"kind":"text","text":") — the request to be added to the scenario meaning child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" will request toy "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" just after getting the toy he is waiting for (if any)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the scenario requests are consistent and no child is initially crying. All the scenario requests are distinct and no query coincides with a scenario request."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print on a single line the number of children who will start crying when child "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" makes his last request for toy "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Please answer all queries independent of each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 5 1\n1 1\n2 2\n3 3\n1 2\n2 3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 7 2\n1 1\n2 2\n2 1\n5 1\n3 3\n4 4\n4 1\n5 3\n5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, child "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is waiting for toy "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", which child "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" has, while child "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is waiting for top "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", which child "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" has. When child "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" makes his last request, the toy he requests is held by child "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Each of the three children is waiting for a toy held by another child and no one is playing, so all the three will start crying."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, at the beginning, child "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is holding toy "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"1 ≤ i ≤ 4"},{"kind":"text","text":". Children "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" have completed their lovely sets. After they finish playing, toy "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" will be free while toy "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" will be taken by child "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" who has just completed his lovely set. After he finishes, toys "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" will be free and child "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" will take toy "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Now:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In the first query, child "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" will take toy "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and after he finishes playing, child "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" can play."}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the second query, child "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" will request toy "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" which is held by child "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". At the same time, child "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is waiting for toy "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" which is now held by child "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". None of them can play and they will start crying. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"812D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/812/problem/D"}