{"assets":[],"contentKind":"statement","contestId":"732","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Tourist Reform"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland is a tourist country! At least, it can become such — the government of Berland is confident about this. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Berland, some pairs of which are connected by two-ways roads. Each road connects two different cities. In Berland there are no roads which connect the same pair of cities. It is possible to get from any city to any other city using given two-ways roads. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"According to the reform each road will become one-way. It will be oriented to one of two directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To maximize the tourist attraction of Berland, after the reform for each city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" the value "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" will be calculated. It will equal to the number of cities "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" for which there is an oriented path from the city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". In other words, "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" will equal the number of cities which can be reached from the city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" by roads. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The government is sure that tourist's attention will be focused on the minimum value of "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the government of Berland make the reform to maximize the minimum of "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 400 000, 1 ≤ m ≤ 400 000"},{"kind":"text","text":") — the number of cities and the number of roads. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe roads in Berland: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of them contains two integers "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ uj, vj ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"uj ≠ vj"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" are the numbers of cities which are connected by the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cities are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It is guaranteed that it is possible to get from any city to any other by following two-ways roads. In Berland there are no roads which connect the same pair of cities. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print single integer — the maximum possible value "},{"kind":"math_inline","text":"min1 ≤ i ≤ n{ri}"},{"kind":"text","text":" after the orientation of roads. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines must contain the description of roads after the orientation: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of them must contain two integers "},{"kind":"math_inline","text":"uj, vj"},{"kind":"text","text":", it means that the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th road will be directed from the city "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":". Print roads in the same order as they are given in the input data. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 9\n4 3\n2 6\n7 1\n4 1\n7 3\n3 5\n7 4\n6 5\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3\n6 2\n7 1\n1 4\n3 7\n5 3\n7 4\n5 6\n2 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"732F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/732/problem/F"}