{"assets":[],"contentKind":"statement","contestId":"226","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Naughty Stone Piles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles of stones of sizes "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" lying on the table in front of you."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During one move you can take one pile and add it to the other. As you add pile "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to pile "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", the size of pile "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" increases by the current size of pile "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and pile "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" stops existing. The cost of the adding operation equals the size of the added pile."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the minimum cost at which you can gather all stones in one pile. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To add some challenge, the stone piles built up conspiracy and decided that each pile will let you add to it not more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times (after that it can only be added to another pile). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, the piles decided to puzzle you completely and told you "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" variants (not necessarily distinct) of what "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" might equal. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum cost for each of "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" variants."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of stone piles. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":" — the initial sizes of the stone piles. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 105)"},{"kind":"text","text":" — the number of queries. The last line contains "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"k1, k2, ..., kq"},{"kind":"math_inline","text":"(1 ≤ ki ≤ 105)"},{"kind":"text","text":" — the values of number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" for distinct queries. Note that numbers "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" can repeat."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" whitespace-separated integers — the answers to the queries in the order, in which the queries are given in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in C++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 4 1 1\n2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9 8 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample one way to get the optimal answer goes like this: we add in turns the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th piles to the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd one; then we add the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st pile to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd one; we add the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd pile to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd one. The first two operations cost "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" each; the third one costs "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", the fourth one costs "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" (the size of the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd pile after the first two operations is not "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", it already is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you can add the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd pile to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd one (the operations costs "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"); then the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st one to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-th one (the cost is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"); then the "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th one to the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th one (the costs is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"); and at last, the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th one to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd one (the cost is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"226B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/226/problem/B"}