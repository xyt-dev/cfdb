{"assets":[],"contentKind":"statement","contestId":"118","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Fancy Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A car number in Berland consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits. A number is called beautiful if it has at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" equal digits. Vasya wants to change the digits in his car's number so that the number became beautiful. To replace one of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits Vasya has to pay the sum of money, equal to the absolute difference between the old digit and the new one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya: find the minimum sum of money he should pay to make the number of his car beautiful. You should also find the resulting beautiful number. If there are several such numbers, then print the lexicographically minimum one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 104, 2 ≤ k ≤ n"},{"kind":"text","text":") which represent how many digits the number has and how many equal digits a beautiful number should have. The second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits. It describes the old number of Vasya's car. It is guaranteed that the number contains no spaces and only contains digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print the minimum sum of money Vasya needs to change the number. On the second line print the car's new number. If there are several solutions, print the lexicographically minimum one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n898196\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n888188\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n533\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n533\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n0001112223\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n0000002223\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample replacing the second digit with an \""},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"\" costs "},{"kind":"math_inline","text":"|9 - 8| = 1"},{"kind":"text","text":". Replacing the fifth digit with an \""},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"\" costs the same. Replacing the sixth digit costs "},{"kind":"math_inline","text":"|6 - 8| = 2"},{"kind":"text","text":". As a result, Vasya will pay "},{"kind":"math_inline","text":"1 + 1 + 2 = 4"},{"kind":"text","text":" for a beautiful number \""},{"children":[{"kind":"text","text":"888188"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographical comparison of strings is performed by the < operator in modern programming languages. The string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is lexicographically smaller than the string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", if there exists such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"xi < yi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"xj = yj"},{"kind":"text","text":". The strings compared in this problem will always have the length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"118C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/118/problem/C"}