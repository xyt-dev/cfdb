{"assets":[],"contentKind":"statement","contestId":"404","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Minesweeper 1D"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Game \"Minesweeper 1D\" is played on a line of squares, the line's height is 1 square, the line's width is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" squares. Some of the squares contain bombs. If a square doesn't contain a bomb, then it contains a number from 0 to 2 — the total number of bombs in adjacent squares."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the correct field to play looks like that: "},{"children":[{"kind":"text","text":"001*2***101*"}],"kind":"container"},{"kind":"text","text":". The cells that are marked with \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" contain bombs. Note that on the correct field the numbers represent the number of bombs in adjacent cells. For example, field "},{"children":[{"kind":"text","text":"2*"}],"kind":"container"},{"kind":"text","text":" is not correct, because cell with value 2 must have two adjacent cells with bombs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera wants to make a correct field to play \"Minesweeper 1D\". He has already painted a squared field with width of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cells, put several bombs on the field and wrote numbers into some cells. Now he wonders how many ways to fill the remaining cells with bombs and numbers are there if we should get a correct field in the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains sequence of characters without spaces "},{"kind":"math_inline","text":"s1s2... sn"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106)"},{"kind":"text","text":", containing only characters \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" and digits \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\". If character "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" equals \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell of the field contains a bomb. If character "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" equals \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\", then Valera hasn't yet decided what to put in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell. Character "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", that is equal to a digit, represents the digit written in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of ways Valera can fill the empty cells and get a correct field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the answer can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"?01???\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"**12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample you can get the following correct fields: "},{"children":[{"kind":"text","text":"001**1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001***"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001*2*"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001*10"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"404D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/404/problem/D"}