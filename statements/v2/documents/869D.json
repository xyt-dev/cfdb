{"assets":["/statement-assets/fa2a5943e36c4433d1e7d14c60d5a6304896ac441bfd4f28e4d7458c8c64dd30.png"],"contentKind":"statement","contestId":"869","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The Overdosing Ubiquity"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"The fundamental prerequisite for justice is not to be correct, but to be strong. That's why justice is always the victor."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Cinderswarm Bee. Koyomi knows it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The bees, according to their nature, live in a tree. To be more specific, a "},{"children":[{"kind":"text","text":"complete binary tree"}],"kind":"container"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The node numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root, and the parent of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"2 ≤ i ≤ n"},{"kind":"text","text":") node is "},{"attrs":{"alt":"","src":"/statement-assets/fa2a5943e36c4433d1e7d14c60d5a6304896ac441bfd4f28e4d7458c8c64dd30.png"},"kind":"image"},{"kind":"text","text":". Note that, however, all edges in the tree are undirected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Koyomi adds "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" extra undirected edges to the tree, creating more complication to trick the bees. And you're here to count the number of "},{"children":[{"kind":"text","text":"simple paths"}],"kind":"container"},{"kind":"text","text":" in the resulting graph, modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". A "},{"children":[{"kind":"text","text":"simple path"}],"kind":"container"},{"kind":"text","text":" is an alternating sequence of adjacent nodes and undirected edges, which begins and ends with nodes and does not contain any node more than once. Do note that a single node is also considered a valid "},{"children":[{"kind":"text","text":"simple path"}],"kind":"container"},{"kind":"text","text":" under this definition. Please refer to the examples and notes below for instances."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 4"},{"kind":"text","text":") — the number of nodes in the tree and the number of extra edges respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines each contains two space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":") — describing an undirected extra edge whose endpoints are "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there may be multiple edges between nodes in the resulting graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the number of "},{"children":[{"kind":"text","text":"simple paths"}],"kind":"container"},{"kind":"text","text":" in the resulting graph, modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n1 2\n2 1\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the paths are: "},{"kind":"math_inline","text":"(1)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(2)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(3)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(3, 1, 2)"},{"kind":"text","text":". (For the sake of clarity, the edges between nodes are omitted since there are no multiple edges in this case.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the paths are: "},{"kind":"math_inline","text":"(1)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":"; and similarly for paths starting with "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". ("},{"kind":"math_inline","text":"5 × 3 = 15"},{"kind":"text","text":" paths in total.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the paths are: "},{"kind":"math_inline","text":"(1)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(2)"},{"kind":"text","text":"; any undirected edge connecting the two nodes travelled in either direction. ("},{"kind":"math_inline","text":"2 + 5 × 2 = 12"},{"kind":"text","text":" paths in total.)"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"869D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/869/problem/D"}