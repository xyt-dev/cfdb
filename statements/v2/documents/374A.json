{"assets":[],"contentKind":"statement","contestId":"374","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Inna and Pink Pony"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima and Inna are doing so great! At the moment, Inna is sitting on the magic lawn playing with a pink pony. Dima wanted to play too. He brought an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" chessboard, a very tasty candy and two numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima put the chessboard in front of Inna and placed the candy in position "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" on the board. The boy said he would give the candy if it reaches one of the corner cells of the board. He's got one more condition. There can only be actions of the following types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" move the candy from position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" on the board to position "},{"kind":"math_inline","text":"(x - a, y - b)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move the candy from position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" on the board to position "},{"kind":"math_inline","text":"(x + a, y - b)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move the candy from position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" on the board to position "},{"kind":"math_inline","text":"(x - a, y + b)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move the candy from position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" on the board to position "},{"kind":"math_inline","text":"(x + a, y + b)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Naturally, Dima doesn't allow to move the candy beyond the chessboard borders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Inna and the pony started shifting the candy around the board. They wonder what is the minimum number of allowed actions that they need to perform to move the candy from the initial position "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" to one of the chessboard corners. Help them cope with the task! "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains six integers "},{"kind":"math_inline","text":"n, m, i, j, a, b"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 106; 1 ≤ i ≤ n; 1 ≤ j ≤ m; 1 ≤ a, b ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can assume that the chessboard rows are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and the columns are numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. Position "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" in the statement is a chessboard cell on the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column. You can consider that the corners are: "},{"kind":"math_inline","text":"(1, m)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(n, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the minimum number of moves needed to get the candy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If Inna and the pony cannot get the candy playing by Dima's rules, print on a single line \""},{"children":[{"kind":"text","text":"Poor Inna and pony!"}],"kind":"container"},{"kind":"text","text":"\" without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7 1 3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 2 3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Poor Inna and pony!\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note to sample 1:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Inna and the pony can move the candy to position "},{"kind":"math_inline","text":"(1 + 2, 3 + 2) = (3, 5)"},{"kind":"text","text":", from there they can move it to positions "},{"kind":"math_inline","text":"(3 - 2, 5 + 2) = (1, 7)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3 + 2, 5 + 2) = (5, 7)"},{"kind":"text","text":". These positions correspond to the corner squares of the chess board. Thus, the answer to the test sample equals two."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"374A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/374/problem/A"}