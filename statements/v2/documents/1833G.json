{"assets":["/statement-assets/06cc54e1c32b57101f4de0e7f3ed7329d80858f851ee9e3060bfbca2c705ed31.png","/statement-assets/6e2f6eb40b6b79e0a54c0b68e030c7c53836250e638d473d46f6b37b57096f9e.png"],"contentKind":"statement","contestId":"1833","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Ksyusha and Chinchilla"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ksyusha has a pet chinchilla, a tree on $$$n$$$ vertices and huge scissors. A tree is a connected graph without cycles. During a boring physics lesson Ksyusha thought about how to entertain her pet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Chinchillas like to play with "},{"children":[{"kind":"text","text":"branches"}],"kind":"container"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"A branch"}],"kind":"container"},{"kind":"text","text":" is a tree of $$$3$$$ vertices."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/06cc54e1c32b57101f4de0e7f3ed7329d80858f851ee9e3060bfbca2c705ed31.png"},"kind":"image"},{"children":[{"children":[{"kind":"text","text":"The branch"}],"kind":"container"},{"kind":"text","text":" looks like this."}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"A cut"}],"kind":"container"},{"kind":"text","text":" is the removal of some (not yet "},{"children":[{"kind":"text","text":"cut"}],"kind":"container"},{"kind":"text","text":") edge in the tree. Ksyusha has plenty of free time, so she can afford to make enough "},{"children":[{"kind":"text","text":"cuts"}],"kind":"container"},{"kind":"text","text":" so that the tree splits into "},{"children":[{"kind":"text","text":"branches"}],"kind":"container"},{"kind":"text","text":". In other words, after several (possibly zero) "},{"children":[{"kind":"text","text":"cuts"}],"kind":"container"},{"kind":"text","text":", each vertex must belong to "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"children":[{"kind":"text","text":"branch"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ksyusha choose the edges to be "},{"children":[{"kind":"text","text":"cut"}],"kind":"container"},{"kind":"text","text":" or tell that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n - 1$$$ rows of each testcase contain integers $$$v_i$$$ and $$$u_i$$$ ($$$1 \\le v_i, u_i \\le n$$$) — the numbers of vertices that the $$$i$$$-th edge connects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that this set of edges forms a tree. It is also guaranteed that the sum of $$$n$$$ over all testcases "},{"children":[{"kind":"text","text":"does not exceed"}],"kind":"container"},{"kind":"text","text":" $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer for each testcase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the desired way to "},{"children":[{"kind":"text","text":"cut"}],"kind":"container"},{"kind":"text","text":" the tree does not exist, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print an integer $$$k$$$ — the number of edges to be "},{"children":[{"kind":"text","text":"cut"}],"kind":"container"},{"kind":"text","text":". In the next line, print $$$k$$$ different integers $$$e_i$$$ ($$$1 \\le e_i \\lt n$$$) — numbers of the edges to be "},{"children":[{"kind":"text","text":"cut"}],"kind":"container"},{"kind":"text","text":". If $$$k = 0$$$, print an empty string instead."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n9\n1 2\n4 3\n7 9\n5 4\n4 6\n3 2\n8 7\n1 7\n6\n1 2\n1 3\n4 3\n1 5\n6 1\n6\n1 2\n3 2\n3 4\n4 5\n6 5\n5\n1 3\n5 3\n5 2\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2 8 \n-1\n1\n3 \n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2\n1 2\n3\n1 2\n3 1\n6\n1 2\n3 1\n3 4\n3 5\n6 1\n9\n2 6\n6 9\n9 1\n9 7\n1 8\n7 3\n8 5\n4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n0\n\n1\n2 \n2\n4 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6e2f6eb40b6b79e0a54c0b68e030c7c53836250e638d473d46f6b37b57096f9e.png"},"kind":"image"},{"children":[{"kind":"text","text":"The first testcase in first test."}],"kind":"container"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1833G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1833/problem/G"}