{"assets":["/statement-assets/a4e4a6d76e3756d11373780edd177383056231afecca04cd758809a2a5eb5850.png","/statement-assets/30cad350392cdabee6797d059cc94437806a6a353698da161aa5e070c1cec034.png"],"contentKind":"statement","contestId":"1237","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Balanced Binary Search Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recall that a binary search tree is a rooted binary tree, whose nodes each store a key and each have at most two distinguished subtrees, left and right. The key in each node must be greater than any key stored in the left subtree, and less than any key stored in the right subtree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The depth of a vertex is the number of edges on the simple path from the vertex to the root. In particular, the depth of the root is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a binary search tree "},{"children":[{"kind":"text","text":"perfectly balanced"}],"kind":"container"},{"kind":"text","text":" if there doesn't exist a binary search tree with the same number of vertices that has a strictly smaller sum of depths of its vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a binary search tree with integer keys "},{"children":[{"kind":"text","text":"striped"}],"kind":"container"},{"kind":"text","text":" if both of the following conditions are satisfied for every vertex $$$v$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$v$$$ has a "},{"children":[{"kind":"text","text":"left"}],"kind":"container"},{"kind":"text","text":" subtree whose root is $$$u$$$, then the parity of the key of $$$v$$$ is "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" from the parity of the key of $$$u$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$v$$$ has a "},{"children":[{"kind":"text","text":"right"}],"kind":"container"},{"kind":"text","text":" subtree whose root is $$$w$$$, then the parity of the key of $$$v$$$ is the "},{"children":[{"kind":"text","text":"same"}],"kind":"container"},{"kind":"text","text":" as the parity of the key of $$$w$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a single integer $$$n$$$. Find the number of perfectly balanced striped binary search trees with $$$n$$$ vertices that have distinct integer keys between $$$1$$$ and $$$n$$$, inclusive. Output this number modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$), denoting the required number of vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of perfectly balanced striped binary search trees with $$$n$$$ vertices and distinct integer keys between $$$1$$$ and $$$n$$$, inclusive, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, this is the only tree that satisfies the conditions: "},{"attrs":{"alt":"","src":"/statement-assets/a4e4a6d76e3756d11373780edd177383056231afecca04cd758809a2a5eb5850.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, here are various trees that don't satisfy some condition: "},{"attrs":{"alt":"","src":"/statement-assets/30cad350392cdabee6797d059cc94437806a6a353698da161aa5e070c1cec034.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1237E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1237/problem/E"}