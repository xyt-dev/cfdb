{"assets":[],"contentKind":"statement","contestId":"909","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Generate Login"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The preferred way to generate user login in Polygon is to concatenate a prefix of the user's first name and a prefix of their last name, in that order. Each prefix must be non-empty, and any of the prefixes can be the full name. Typically there are multiple possible logins for each person."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the first and the last name of a user. Return the alphabetically earliest login they can get (regardless of other potential Polygon users)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a reminder, a prefix of a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is its substring which occurs at the beginning of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":": \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" etc. are prefixes of string \"{abcdef}\" but \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" and '"},{"children":[{"kind":"text","text":"bc"}],"kind":"container"},{"kind":"text","text":"\" are not. A string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is alphabetically earlier than a string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a prefix of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" coincide up to some position, and then "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" has a letter that is alphabetically earlier than the corresponding letter in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":": \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" are alphabetically earlier than \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\" but \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\" are alphabetically later than \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing two space-separated strings: the first and the last names. Each character of each string is a lowercase English letter. The length of each string is between 1 and 10, inclusive. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single string — alphabetically earliest possible login formed from these names. The output should be given in lowercase as well."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"harry potter\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"hap\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"tom riddle\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"tomr\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"909A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/909/problem/A"}