{"assets":[],"contentKind":"statement","contestId":"2199","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Strange Process"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three arrays:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" array $$$a$$$, initially consisting of $$$n$$$ ones; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" array $$$b$$$, initially consisting of $$$m$$$ zeros; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" array $$$c$$$, consisting of $$$m$$$ integers from $$$1$$$ to $$$50$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We perform the following process on these arrays. The process consists of $$$m$$$ stages. During the $$$i$$$-th stage, the following occurs:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" first, "},{"children":[{"kind":"text","text":"for each element of the array $$$a$$$"}],"kind":"container"},{"kind":"text","text":", one of three actions is "},{"children":[{"kind":"text","text":"independently"}],"kind":"container"},{"kind":"text","text":" chosen: it is multiplied by some prime number, divided by some prime number (it cannot be divided by a number that does not divide the element evenly), or remains unchanged. You don't have to choose the same action or prime number for each element of $$$a$$$; "}],"kind":"list_item"},{"children":[{"k