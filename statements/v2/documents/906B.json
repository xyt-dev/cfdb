{"assets":[],"contentKind":"statement","contestId":"906","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Seating of Students"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Students went into a class to write a test and sat in some way. The teacher thought: \"Probably they sat in this order to copy works of each other. I need to rearrange them in such a way that students that were neighbors are not neighbors in a new seating.\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The class can be represented as a matrix with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns with a student in each cell. Two students are neighbors if cells in which they sit have a common side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's enumerate students from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" in order of rows. So a student who initially sits in the cell in row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" has a number "},{"kind":"math_inline","text":"(i - 1)·m + j"},{"kind":"text","text":". You have to find a matrix with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns in which all numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" appear exactly once and adjacent numbers in the original matrix are not adjacent in it, or determine that there is no such matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"n·m ≤ 105"},{"kind":"text","text":") — the number of rows and the number of columns in the required matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no such matrix, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise in the first line output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), and in the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers which form the required matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n5 4 7 2 \n3 6 1 8 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case the matrix initially looks like this:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 2 3 4\n5 6 7 8\n"},{"children":[{"kind":"text","text":"It's easy to see that there are no two students that are adjacent in both matrices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case there are only two possible seatings and in both of them students with numbers 1 and 2 are neighbors."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"906B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/906/problem/B"}