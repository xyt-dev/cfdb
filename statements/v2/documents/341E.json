{"assets":[],"contentKind":"statement","contestId":"341","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Candies Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub is playing an uncommon game. Initially, he has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boxes, numbered 1, 2, 3, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each box has some number of candies in it, described by a sequence "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". The number "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":" represents the number of candies in box "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal of the game is to move all candies into "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" two boxes. The rest of "},{"kind":"math_inline","text":"n - 2"},{"kind":"text","text":" boxes must contain "},{"children":[{"kind":"text","text":"zero"}],"kind":"container"},{"kind":"text","text":" candies. Iahub is allowed to do several (possible zero) moves. At each move he chooses two different boxes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"ai ≤ aj"},{"kind":"text","text":". Then, Iahub moves from box "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" to box "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" candies. Obviously, when two boxes have equal number of candies, box number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" becomes empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to give him a set of moves such as Iahub to archive the goal of the game. If Iahub can't win the game for the given configuration of boxes, output -1. Please note that in case there exist a solution, you don't need to print the solution using minimal number of moves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 1000"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — sequence elements. It is guaranteed that sum of all numbers in sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is up to "},{"kind":"math_inline","text":"106"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In case there exists no solution, output -1. Otherwise, in the first line output integer "},{"kind":"math_inline","text":"c"},{"kind":"math_inline","text":"(0 ≤ c ≤ 106)"},{"kind":"text","text":", representing number of moves in your solution. Each of the next "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" lines should contain two integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ n, i ≠ j)"},{"kind":"text","text":": integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"th line mean that at the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th move you will move candies from the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th box to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 6 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 3\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, after the first move the boxes will contain 3, 12 and 3 candies. After the second move, the boxes will contain 6, 12 and 0 candies. Now all candies are in exactly 2 boxes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, you can observe that the given configuration is not valid, as all candies are in a single box and they should be in two boxes. Also, any move won't change the configuration, so there exists no solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third sample, all candies are already in 2 boxes. Hence, no move is needed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"341E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/341/problem/E"}