{"assets":[],"contentKind":"statement","contestId":"716","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Crazy Computer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder is coding on a crazy computer. If you don't type in a word for a "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" consecutive seconds, everything you typed disappear! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, if you typed a word at second "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and then the next word at second "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then if "},{"kind":"math_inline","text":"b - a ≤ c"},{"kind":"text","text":", just the new word is appended to other words on the screen. If "},{"kind":"math_inline","text":"b - a > c"},{"kind":"text","text":", then everything on the screen disappears and after that the word you have typed appears on the screen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if "},{"kind":"math_inline","text":"c = 5"},{"kind":"text","text":" and you typed words at seconds "},{"kind":"math_inline","text":"1, 3, 8, 14, 19, 20"},{"kind":"text","text":" then at the second "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" there will be "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" words on the screen. After that, everything disappears at the second "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" because nothing was typed. At the seconds "},{"kind":"math_inline","text":"14"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"19"},{"kind":"text","text":" another two words are typed, and finally, at the second "},{"kind":"math_inline","text":"20"},{"kind":"text","text":", one more word is typed, and a total of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" words remain on the screen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given the times when ZS the Coder typed the words. Determine how many words remain on the screen after he finished typing everything."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000, 1 ≤ c ≤ 109"},{"kind":"text","text":") — the number of words ZS the Coder typed and the crazy computer delay respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t1 < t2 < ... < tn ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" denotes the second when ZS the Coder typed the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single positive integer, the number of words that remain on the screen after all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" words was typed, in other words, at the second "},{"kind":"math_inline","text":"tn"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 3 8 14 19 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n1 3 5 7 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is already explained in the problem statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, after typing the first word at the second "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", it disappears because the next word is typed at the second "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3 - 1 > 1"},{"kind":"text","text":". Similarly, only "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" word will remain at the second "},{"kind":"math_inline","text":"9"},{"kind":"text","text":". Then, a word is typed at the second "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", so there will be two words on the screen, as the old word won't disappear because "},{"kind":"math_inline","text":"10 - 9 ≤ 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"716A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/716/problem/A"}