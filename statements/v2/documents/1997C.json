{"assets":[],"contentKind":"statement","contestId":"1997","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Even Positions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Monocarp had a regular bracket sequence $$$s$$$ of length $$$n$$$ ($$$n$$$ is even). He even came up with his own way to calculate its cost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He knows that in a regular bracket sequence (RBS), each opening bracket is paired up with the corresponding closing bracket. So he decided to calculate the "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of RBS as the sum of distances between pairs of corresponding bracket pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, let's look at RBS "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":". It has three pairs of brackets: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"(__)__"}],"kind":"container"},{"kind":"text","text":": the distance between brackets at position $$$1$$$ and at $$$4$$$ is $$$4 - 1 = 3$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"_()___"}],"kind":"container"},{"kind":"text","text":": the distance is $$$3 - 2 = 1$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"____()"}],"kind":"container"},{"kind":"text","text":": the distance is $$$6 - 5 = 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" So the cost of "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":" is $$$3 + 1 + 1 = 5$$$."},{"children":[{"kind":"text","text":"Unfortunately, due to data corruption, Monocarp lost all characters on odd positions $$$s_1, s_3, \\dots, s_{n-1}$$$. Only characters on even positions ($$$s_2, s_4, \\dots, s_{n}$$$) remain. For example, "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":" turned to "},{"children":[{"kind":"text","text":"_(_)_)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Monocarp wants to restore his RBS by placing brackets on the odd positions. But since the restored RBS may not be unique, he wants to choose one with "},{"children":[{"kind":"text","text":"minimum cost"}],"kind":"container"},{"kind":"text","text":". It's too hard to do for Monocarp alone, so can you help him?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Reminder: A "},{"children":[{"kind":"text","text":"regular bracket sequence"}],"kind":"container"},{"kind":"text","text":" is a string consisting of only brackets, such that this sequence, when inserted "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"-s and "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"-s, gives a valid mathematical expression. For example, "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"(()())()"}],"kind":"container"},{"kind":"text","text":" are RBS, while "},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"()("}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"())(()"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 5000$$$) — the number of test cases. Next $$$t$$$ cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$; $$$n$$$ is even) — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$, where all characters on the odd positions are '"},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"' and all characters on the even positions are either '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraints: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s$$$ can be restored to at least one regular bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the total sum of $$$n$$$ over all test cases doesn't exceed $$$2 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the minimum cost of the regular bracket sequence that can be obtained from $$$s$$$ by replacing '"},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"'-s with brackets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n6\n_(_)_)\n2\n_)\n8\n_)_)_)_)\n8\n_(_)_(_)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1\n4\n8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it's optimal to make $$$s$$$ equal to "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":". The cost of $$$s$$$ will be equal to $$$3 + 1 + 1 = 5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the only option is to make $$$s$$$ equal to "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":" with cost $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the only possible RBS is "},{"children":[{"kind":"text","text":"()()()()"}],"kind":"container"},{"kind":"text","text":" with cost $$$1 + 1 + 1 + 1 = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, it's optimal to make $$$s$$$ equal to "},{"children":[{"kind":"text","text":"(())(())"}],"kind":"container"},{"kind":"text","text":" with cost $$$3 + 1 + 3 + 1 = 8$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1997C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1997/problem/C"}