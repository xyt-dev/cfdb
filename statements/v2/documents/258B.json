{"assets":[],"contentKind":"statement","contestId":"258","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Little Elephant and Elections"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There have recently been elections in the zoo. Overall there were "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" main political parties: one of them is the Little Elephant Political Party, "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" other parties have less catchy names."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Political parties find their number in the ballot highly important. Overall there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" possible numbers: "},{"kind":"math_inline","text":"1, 2, ..., m"},{"kind":"text","text":". Each of these "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" parties is going to be assigned in some way to exactly one number, at that, two distinct parties cannot receive the same number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Little Elephant Political Party members believe in the lucky digits "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". They want to evaluate their chances in the elections. For that, they need to find out, how many correct assignments are there, such that the number of lucky digits in the Little Elephant Political Party ballot number is strictly larger than the total number of lucky digits in the ballot numbers of 6 other parties. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the Little Elephant Political Party, calculate this number. As the answer can be rather large, print the remainder from dividing it by "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains a single positive integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(7 ≤ m ≤ 109)"},{"kind":"text","text":" — the number of possible numbers in the ballot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1440\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"258B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/258/problem/B"}