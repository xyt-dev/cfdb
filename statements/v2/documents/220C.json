fference between the positions of the occurrences of some number in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". More formally, it's such minimum "},{"kind":"math_inline","text":"|i - j|"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"ai = bj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"cyclic shift"}],"kind":"container"},{"kind":"text","text":" number "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" of permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" consisting from "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements is a permutation "},{"kind":"math_inline","text":"bibi + 1... bnb1b2... bi - 1"},{"kind":"text","text":". Overall a permutation has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cyclic shifts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Little Elephant wonders, for all cyclic shifts of permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", what is the distance between the cyclic shift and permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the size of the permutations. The second line contains permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct numbers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. The numbers are separated with single spaces. The third line contains permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the same format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the answers for cyclic shifts. Print the answers to the shifts in the order of the shifts' numeration in permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", that is, first for the 1-st cyclic shift, then for the 2-nd, and so on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3 4\n3 4 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"220C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/220/problem/C"}