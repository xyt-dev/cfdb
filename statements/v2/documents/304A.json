{"assets":["/statement-assets/7a96436dfbc8e183a4d85a6785d5e0f9a6307745143e5506532b671b332c2d9a.png"],"contentKind":"statement","contestId":"304","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Pythagorean Theorem II"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In mathematics, the Pythagorean theorem — is a relation in Euclidean geometry among the three sides of a right-angled triangle. In terms of areas, it states:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":" In any right-angled triangle, the area of the square whose side is the hypotenuse (the side opposite the right angle) is equal to the sum of the areas of the squares whose sides are the two legs (the two sides that meet at a right angle). "}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The theorem can be written as an equation relating the lengths of the sides "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", often called the Pythagorean equation:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"a2 + b2 = c2"}],"kind":"container"},{"children":[{"kind":"text","text":"where "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" represents the length of the hypotenuse, and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" represent the lengths of the other two sides."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7a96436dfbc8e183a4d85a6785d5e0f9a6307745143e5506532b671b332c2d9a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", your task is to count how many right-angled triangles with side-lengths "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" that satisfied an inequality "},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ c ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains one integer "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 104)"},{"kind":"text","text":" as we mentioned above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_