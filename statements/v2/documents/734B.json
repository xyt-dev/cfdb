{"assets":[],"contentKind":"statement","contestId":"734","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Anton and Digits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Anton found a box with digits in his room. There are "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k5"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k6"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton's favorite integers are "},{"kind":"math_inline","text":"32"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"256"},{"kind":"text","text":". He decided to compose this integers from digits he has. He wants to make the sum of these integers as large as possible. Help him solve this task!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each digit can be used no more than once, i.e. the composed integers should contain no more than "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and so on. Of course, unused digits are not counted in the sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains four integers "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k6"},{"kind":"text","text":" — the number of digits "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" respectively ("},{"kind":"math_inline","text":"0 ≤ k2, k3, k5, k6 ≤ 5·106"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — maximum possible sum of Anton's favorite integers that can be composed using digits from the box."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"800\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[