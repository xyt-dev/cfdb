{"assets":["/statement-assets/5d3e68093a4ced26a41370da86599d8d9aebb1bf63fc0cfdc1bb4dababd32c39.png","/statement-assets/8e5203006e1f8c916ce7ecb9578c52d348f2f32a2994f50bd3978cfe840d9732.png"],"contentKind":"statement","contestId":"587","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Duff in the Army"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Duff has been a soldier in the army. Malek is her commander."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Their country, Andarz Gu has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities (numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads. Each road connects two different cities. There exist a unique path between any two cities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are also "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" people living in Andarz Gu (numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"). Each person has and ID number. ID number of "},{"kind":"math_inline","text":"i - th"},{"kind":"text","text":" person is "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and he/she lives in city number "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". Note that there may be more than one person in a city, also there may be no people living in the city."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5d3e68093a4ced26a41370da86599d8d9aebb1bf63fc0cfdc1bb4dababd32c39.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Malek loves to order. That's why he asks Duff to answer to "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. In each query, he gives her numbers "},{"kind":"math_inline","text":"v, u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To answer a query:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume there are "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" people living in the cities lying on the path from city "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". Assume these people's IDs are "},{"kind":"math_inline","text":"p1, p2, ..., px"},{"kind":"text","text":" in increasing order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"k = min(x, a)"},{"kind":"text","text":", then Duff should tell Malek numbers "},{"kind":"math_inline","text":"k, p1, p2, ..., pk"},{"kind":"text","text":" in this order. In the other words, Malek wants to know "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" minimums on that path (or less, if there are less than "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" people)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Duff is very busy at the moment, so she asked you to help her and answer the queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers, "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, q ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the roads. Each line contains two integers "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", endpoints of a road ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v ≠ u"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cm"},{"kind":"text","text":" separated by spaces ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the queries. Each of them contains three integers, "},{"kind":"math_inline","text":"v, u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ a ≤ 10"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print numbers "},{"kind":"math_inline","text":"k, p1, p2, ..., pk"},{"kind":"text","text":" separated by spaces in one line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 5\n1 3\n1 2\n1 4\n4 5\n2 1 4 3\n4 5 6\n1 5 2\n5 5 10\n2 3 3\n5 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n2 2 3\n0\n3 1 2 4\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Graph of Andarz Gu in the sample case is as follows (ID of people in each city are written next to them):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8e5203006e1f8c916ce7ecb9578c52d348f2f32a2994f50bd3978cfe840d9732.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"587C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/587/problem/C"}