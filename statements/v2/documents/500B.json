{"assets":["/statement-assets/4a8996e418b3aad09b7e867e9e76b5672fab93f41cab43bab0121f6302ec418d.png"],"contentKind":"statement","contestId":"500","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"User ainta has a permutation "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":". As the New Year is coming, he wants to make his permutation as pretty as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Permutation "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"prettier"}],"kind":"container"},{"kind":"text","text":" than permutation "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", if and only if there exists an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"a1 = b1, a2 = b2, ..., ak - 1 = bk - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ak < bk"},{"kind":"text","text":" all holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As known, permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is so sensitive that it could be only modified by swapping two distinct elements. But swapping two elements is harder than you think. Given an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" binary matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", user ainta can swap the values of "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":") if and only if "},{"kind":"math_inline","text":"Ai, j = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", user ainta wants to know the prettiest permutation that he can obtain."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300"},{"kind":"text","text":") — the size of the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" — the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" that user ainta has. Each integer between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs exactly once in the given permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line "},{"kind":"math_inline","text":"Ai, j"},{"kind":"text","text":" is the element on the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column of A. It is guaranteed that, for all integers "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"Ai, j = Aj, i"},{"kind":"text","text":" holds. Also, for all integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"Ai, i = 0"},{"kind":"text","text":" holds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and only line, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, describing the prettiest permutation that can be obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n5 2 4 3 6 7 1\n0001001\n0000000\n0000010\n1000001\n0000000\n0010000\n1001000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 4 3 6 7 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 2 1 5 3\n00100\n00011\n10010\n01101\n01010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 4 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the swap needed to obtain the prettiest permutation is: "},{"kind":"math_inline","text":"(p1, p7)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the swaps needed to obtain the prettiest permutation is "},{"kind":"math_inline","text":"(p1, p3), (p4, p5), (p3, p4)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4a8996e418b3aad09b7e867e9e76b5672fab93f41cab43bab0121f6302ec418d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a sequence of integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers, each of them doesn't exceed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is denoted as "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". The size of the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is denoted as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"500B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/500/problem/B"}