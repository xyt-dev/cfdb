{"assets":["/statement-assets/2a3c3a1427613f9faf3a304f8afbd92374885ab2605423a0f98fbf4e752bcb88.png","/statement-assets/b6840d259c7059afdfc536f3154e02f46a9fa6a632b84ca90736feb5749e4557.png"],"contentKind":"statement","contestId":"1099","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Postcard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrey received a postcard from Irina. It contained only the words \"Hello, Andrey!\", and a strange string consisting of lowercase Latin letters, snowflakes and candy canes. Andrey thought that this string is an encrypted message, and decided to decrypt it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrey noticed that snowflakes and candy canes always stand after the letters, so he supposed that the message was encrypted as follows. Candy cane means that the letter before it can be removed, or can be left. A snowflake means that the letter before it can be removed, left, or repeated several times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, consider the following string: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2a3c3a1427613f9faf3a304f8afbd92374885ab2605423a0f98fbf4e752bcb88.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"This string can encode the message «"},{"children":[{"kind":"text","text":"happynewyear"}],"kind":"container"},{"kind":"text","text":"». For this, candy canes and snowflakes should be used as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" candy cane 1: remove the letter "},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snowflake 1: repeat the letter "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":" twice, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" candy cane 2: leave the letter "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snowflake 2: remove the letter "},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snowflake 3: leave the letter "},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b6840d259c7059afdfc536f3154e02f46a9fa6a632b84ca90736feb5749e4557.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Please note that the same string can encode different messages. For example, the string above can encode «"},{"children":[{"kind":"text","text":"hayewyar"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"happpppynewwwwwyear"}],"kind":"container"},{"kind":"text","text":"», and other messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrey knows that messages from Irina usually have a length of $$$k$$$ letters. Help him to find out if a given string can encode a message of $$$k$$$ letters, and if so, give an example of such a message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the string received in the postcard. The string consists only of lowercase Latin letters, as well as the characters «"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"» and «"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"», meaning snowflake and candy cone, respectively. These characters can only appear immediately after the letter. The length of the string does not exceed $$$200$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer number $$$k$$$ ($$$1 \\leq k \\leq 200$$$), the required message length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print any message of length $$$k$$$ that the given string can encode, or «"},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"» if such a message does not exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nhw?ap*yn?eww*ye*ar\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nhappynewyear\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nab?a\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\naa"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nab?a\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\naba"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nababb\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nababb"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nab?a\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nImpossible"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1099C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1099/problem/C"}