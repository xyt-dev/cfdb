{"assets":[],"contentKind":"statement","contestId":"1783","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Double Sort II"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two permutations $$$a$$$ and $$$b$$$, both of size $$$n$$$. A permutation of size $$$n$$$ is an array of $$$n$$$ elements, where each integer from $$$1$$$ to $$$n$$$ appears exactly once. The elements in each permutation are indexed from $$$1$$$ to $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose an integer $$$i$$$ from $$$1$$$ to $$$n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" let $$$x$$$ be the integer such that $$$a_x = i$$$. Swap $$$a_i$$$ with $$$a_x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" let $$$y$$$ be the integer such that $$$b_y = i$$$. Swap $$$b_i$$$ with $$$b_y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your goal is to make both permutations "},{"children":[{"kind":"text","text":"sorted in ascending order"}],"kind":"container"},{"kind":"text","text":" (i. e. the conditions $$$a_1 \\lt a_2 \\lt \\dots \\lt a_n$$$ and $$$b_1 \\lt b_2 \\lt \\dots \\lt b_n$$$ must be satisfied) using "},{"children":[{"kind":"text","text":"minimum number of operations"}],"kind":"container"},{"kind":"text","text":". Note that both permutations must be sorted after you perform the sequence of operations you have chosen."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 3000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le n$$$; all $$$a_i$$$ are distinct)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n$$$ integers $$$b_1, b_2, \\dots, b_n$$$ ($$$1 \\le b_i \\le n$$$; all $$$b_i$$$ are distinct)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First, print one integer $$$k$$$ ($$$0 \\le k \\le 2n$$$) — the minimum number of operations required to sort both permutations. Note that it can be shown that $$$2n$$$ operations are always enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, print $$$k$$$ integers $$$op_1, op_2, \\dots, op_k$$$ ($$$1 \\le op_j \\le n$$$), where $$$op_j$$$ is the value of $$$i$$$ you choose during the $$$j$$$-th operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 3 2 4 5\n2 1 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 3 4 2\n4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n3 4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1783F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1783/problem/F"}