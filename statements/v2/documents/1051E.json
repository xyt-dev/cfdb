{"assets":[],"contentKind":"statement","contestId":"1051","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vasya and Big Integers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya owns three big integers — $$$a, l, r$$$. Let's define a partition of $$$x$$$ such a sequence of strings $$$s_1, s_2, \\dots, s_k$$$ that $$$s_1 + s_2 + \\dots + s_k = x$$$, where $$$+$$$ is a concatanation of strings. $$$s_i$$$ is the $$$i$$$-th element of the partition. For example, number $$$12345$$$ has the following partitions: [\""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":"\"], [\""},{"children":[{"kind":"text","text":"123"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":"\"], [\""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"2345"}],"kind":"container"},{"kind":"text","text":"\"], [\""},{"children":[{"kind":"text","text":"12345"}],"kind":"container"},{"kind":"text","text":"\"] and lots of others."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some partition of $$$a$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if each of its elements "},{"children":[{"kind":"text","text":"contains no leading zeros"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya want to know the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" partitions of number $$$a$$$, which has each of $$$s_i$$$ satisfy the condition $$$l \\le s_i \\le r$$$. Note that the comparison is the integer comparison, not the string one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya to count the amount of partitions of number $$$a$$$ such that they match all the given requirements. The result can be rather big, so print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$a~(1 \\le a \\le 10^{1000000})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer $$$l~(0 \\le l \\le 10^{1000000})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer $$$r~(0 \\le r \\le 10^{1000000})$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that $$$l \\le r$$$"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is also guaranteed that numbers $$$a, l, r$$$ "},{"children":[{"kind":"text","text":"contain no leading zeros"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the amount of partitions of number $$$a$$$ such that they match all the given requirements modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"135\n1\n15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10000\n0\n9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are two good partitions $$$13+5$$$ and $$$1+3+5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, there is one good partition $$$1+0+0+0+0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1051E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1051/problem/E"}