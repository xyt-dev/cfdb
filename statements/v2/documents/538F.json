{"assets":["/statement-assets/429984f22dcb1516a72e73201026356f3f831df190753f9d76bc56f37259825a.png","/statement-assets/267a4a0bb5d78e61888e8ca3c79f99a5b45a023476f577b22701b85c373388ea.png","/statement-assets/f0580027e1b2502cfae8386768fadf0704f4d8a68224e6f1d33c053ca9430f7f.png","/statement-assets/93276edabb87b3a4a4e08405e2d2c50f8c5bdf7be1607d982a0a7b965cfe56b0.png"],"contentKind":"statement","contestId":"538","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. A Heap of Heaps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrew skipped lessons on the subject 'Algorithms and Data Structures' for the entire term. When he came to the final test, the teacher decided to give him a difficult task as a punishment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher gave Andrew an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". After that he asked Andrew for each "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from 1 to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" to build a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ary heap on the array and count the number of elements for which the property of the minimum-rooted heap is violated, i.e. the value of an element is less than the value of its parent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrew looked up on the Wikipedia that a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ary heap is a rooted tree with vertices in elements of the array. If the elements of the array are indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", then the children of element "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are elements with indices "},{"kind":"math_inline","text":"k(v - 1) + 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"kv + 1"},{"kind":"text","text":" (if some of these elements lie outside the borders of the array, the corresponding children are absent). In any "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ary heap every element except for the first one has exactly one parent; for the element 1 the parent is absent (this element is the "},{"children":[{"kind":"text","text":"root"}],"kind":"container"},{"kind":"text","text":" of the heap). Denote "},{"kind":"math_inline","text":"p(v)"},{"kind":"text","text":" as the number of the parent of the element with the number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". Let's say that for a non-root element "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" the "},{"children":[{"kind":"text","text":"property of the heap is violated"}],"kind":"container"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"av < ap(v)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Andrew cope with the task!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"in a single line print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers, separate the consecutive numbers with a single space — the number of elements for which the property of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ary heap is violated, for "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 5 4 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 2 2 2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0 0 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pictures with the heaps for the first sample are given below; elements for which the property of the heap is violated are marked with red."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/429984f22dcb1516a72e73201026356f3f831df190753f9d76bc56f37259825a.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/267a4a0bb5d78e61888e8ca3c79f99a5b45a023476f577b22701b85c373388ea.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/f0580027e1b2502cfae8386768fadf0704f4d8a68224e6f1d33c053ca9430f7f.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/93276edabb87b3a4a4e08405e2d2c50f8c5bdf7be1607d982a0a7b965cfe56b0.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample all elements are equal, so the property holds for all pairs."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"538F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/538/problem/F"}