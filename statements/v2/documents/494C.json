{"assets":[],"contentKind":"statement","contestId":"494","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Helping People"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Malek is a rich man. He also is very generous. That's why he decided to split his money between poor people. A charity institute knows "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" poor people numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The institute gave Malek "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" recommendations. A recommendation is a segment of people like "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" which means the institute recommended that Malek gives one dollar to every person whose number is in this segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However this charity has very odd rules about the recommendations. Because of those rules the recommendations are given in such a way that for every two recommendation "},{"kind":"math_inline","text":"[a, b]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[c, d]"},{"kind":"text","text":" one of the following conditions holds: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The two segments are completely disjoint. More formally either "},{"kind":"math_inline","text":"a ≤ b < c ≤ d"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"c ≤ d < a ≤ b"}],"kind":"list_item"},{"children":[{"kind":"text","text":" One of the two segments are inside another. More formally either "},{"kind":"math_inline","text":"a ≤ c ≤ d ≤ b"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"c ≤ a ≤ b ≤ d"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"goodness"}],"kind":"container"},{"kind":"text","text":" of a charity is the value of maximum money a person has after Malek finishes giving his money. The institute knows for each recommendation what is the probability that Malek will accept it. They want to know the expected value of "},{"children":[{"kind":"text","text":"goodness"}],"kind":"container"},{"kind":"text","text":" of this charity. So they asked you for help."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have been given the list of recommendations and for each recommendation the probability of it being accepted by Malek. You have also been given how much money each person initially has. You must find the expected value of "},{"children":[{"kind":"text","text":"goodness"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line two space-separated integers "},{"kind":"math_inline","text":"n, q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 5000"},{"kind":"text","text":") are given."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") are given meaning that person number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" initially has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" dollars. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains three space-separated numbers "},{"kind":"math_inline","text":"li, ri, pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ p ≤ 1"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" are two integers describing the segment of recommendation and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is a real number given with exactly three digits after decimal point which is equal to probability of Malek accepting this recommendation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that a segment may appear several times in recommendations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the sought value. Your answer will be considered correct if its absolute or relative error is less than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 7 2 4 3\n1 3 0.500\n2 2 0.500\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8.000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n281 280 279 278 282\n1 4 1.000\n1 4 0.000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"282.000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n1 2 3\n1 3 0.500\n2 2 0.250\n1 2 0.800\n1 1 0.120\n2 2 0.900\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4.465000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"494C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/494/problem/C"}