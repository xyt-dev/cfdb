{"assets":[],"contentKind":"statement","contestId":"1108","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Nice Garland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a garland consisting of $$$n$$$ lamps. Each lamp is colored red, green or blue. The color of the $$$i$$$-th lamp is $$$s_i$$$ ('"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' — colors of lamps in the garland)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to recolor some lamps in this garland (recoloring a lamp means changing its initial color to another) in such a way that the obtained garland is "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A garland is called "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" if any two lamps of the same color have distance divisible by three between them. I.e. if the obtained garland is $$$t$$$, then for each $$$i, j$$$ such that $$$t_i = t_j$$$ should be satisfied $$$|i-j|~ mod~ 3 = 0$$$. The value $$$|x|$$$ means absolute value of $$$x$$$, the operation $$$x~ mod~ y$$$ means remainder of $$$x$$$ when divided by $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the following garlands are "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":": \""},{"children":[{"kind":"text","text":"RGBRGBRG"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"GB"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"GRBGRBG"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"BRGBRGB"}],"kind":"container"},{"kind":"text","text":"\". The following garlands are not "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":": \""},{"children":[{"kind":"text","text":"RR"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"RGBG"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Among all ways to recolor the initial garland to make it "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" you have to choose one with the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of recolored lamps. If there are multiple optimal solutions, print "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the number of lamps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the string $$$s$$$ consisting of $$$n$$$ characters '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' — colors of lamps in the garland."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the output print one integer $$$r$$$ — the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of recolors needed to obtain a "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" garland from the given one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line of the output print one string $$$t$$$ of length $$$n$$$ — a "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" garland obtained from the initial one with "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of recolors. If there are multiple optimal solutions, print "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nBRB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\nGRB\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nRGBGRBB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nRGBRGBR\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1108C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1108/problem/C"}