{"assets":[],"contentKind":"statement","contestId":"2254","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Evanescent"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let $$$f(s)$$$ be the compressed version of a string $$$s$$$, formed by replacing every maximal contiguous block of identical characters with a single copy of that character. For example, $$$f($$$\""},{"children":[{"kind":"text","text":"aabbcc"}],"kind":"container"},{"kind":"text","text":"\"$$$) \\ = \\ $$$\""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$|s|$$$ denote the length of a string $$$s$$$. Following this, $$$|f(s)|$$$ denotes the length of the compressed string. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$|f($$$\""},{"children":[{"kind":"text","text":"aabbcc"}],"kind":"container"},{"kind":"text","text":"\"$$$)| =$$$ $$$|$$$\""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\"$$$|$$$ $$$ = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the string is empty, its length is $$$0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Yousef has given you a string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters. You must delete "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one character $$$s_i$$$ ($$$2 \\le i \\le n - 1$$$) to form a new string $$$s'$$$, and then find the minimum possible value of $$$|f(s')|$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you "},{"children":[{"kind":"text","text":"cannot"}],"kind":"container"},{"kind":"text","text":" delete $$$s_1$$$ or $$$s_n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ ($$$|s| = n$$$), consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum possible length of the resulting compressed string after deleting one character."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n3\nabb\n3\naab\n3\nabc\n4\nabaa\n4\nabba\n5\neeeee\n6\nyyssee\n7\nabacaba\n18\ngoodluckandhavefun\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2\n2\n1\n3\n1\n3\n5\n16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can only delete the character $$$s_2 = $$$ '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', producing a string $$$s' = $$$ \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", with $$$|f(s')| = 2$$$. Therefore, $$$2$$$ is the minimum length achievable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, we can delete the character $$$s_2 = $$$ '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. The resulting string is $$$s' = $$$ \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" with $$$f(s') = $$$ \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", so $$$|f(s')| = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, deleting any valid character results in $$$f(s') = $$$ \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" and $$$|f(s')| = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the eighth test case, we can delete the character $$$s_4 = $$$ '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'. The resulting string is $$$s' = $$$ \""},{"children":[{"kind":"text","text":"abaaba"}],"kind":"container"},{"kind":"text","text":"\" with $$$f(s') = $$$ \""},{"children":[{"kind":"text","text":"ababa"}],"kind":"container"},{"kind":"text","text":"\" and $$$|f(s')| = 5$$$."}],"kind":"paragraph"}],"kind":"section"}],"k