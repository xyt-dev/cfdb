{"assets":[],"contentKind":"statement","contestId":"907","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Masha and Bears"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A family consisting of father bear, mother bear and son bear owns three cars. Father bear can climb into the largest car and he likes it. Also, mother bear can climb into the middle car and she likes it. Moreover, son bear can climb into the smallest car and he likes it. It's known that the largest car is strictly larger than the middle car, and the middle car is strictly larger than the smallest car. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Masha came to test these cars. She could climb into all cars, but she liked only the smallest car. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's known that a character with size "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can climb into some car with size "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"a ≤ b"},{"kind":"text","text":", he or she likes it if and only if he can climb into this car and "},{"kind":"math_inline","text":"2a ≥ b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given sizes of bears and Masha. Find out some possible integer non-negative sizes of cars."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"You are given four integers "},{"kind":"math_inline","text":"V1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"V2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"V3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"Vm"},{"kind":"text","text":"("},{"kind":"math_inline","text":"1 ≤ Vi ≤ 100"},{"kind":"text","text":") — sizes of father bear, mother bear, son bear and Masha, respectively. It's guaranteed that "},{"kind":"math_inline","text":"V1 > V2 > V3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output three integers — sizes of father bear's car, mother bear's car and son bear's car, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible solutions, print any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"50 30 10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"50\n30\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 50 10 21\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first test case all conditions for cars' sizes are satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second test case there is no answer, because Masha should be able to climb into smallest car (so size of smallest car in not less than 21), but son bear should like it, so maximum possible size of it is 20."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"907A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/907/problem/A"}