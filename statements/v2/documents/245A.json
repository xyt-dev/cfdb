{"assets":[],"contentKind":"statement","contestId":"245","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. System Administrator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus is a system administrator. There are two servers under his strict guidance — "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". To stay informed about the servers' performance, Polycarpus executes commands \""},{"children":[{"kind":"text","text":"ping a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ping b"}],"kind":"container"},{"kind":"text","text":"\". Each ping command sends exactly ten packets to the server specified in the argument of the command. Executing a program results in two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(x + y = 10; x, y ≥ 0)"},{"kind":"text","text":". These numbers mean that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" packets successfully reached the corresponding server through the network and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" packets were lost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today Polycarpus has performed overall "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ping commands during his workday. Now for each server Polycarpus wants to know whether the server is \"alive\" or not. Polycarpus thinks that the server is \"alive\", if at least half of the packets that we send to this server reached it successfully along the network."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarpus, determine for each server, whether it is \"alive\" or not by the given commands and their results."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 1000)"},{"kind":"text","text":" — the number of commands Polycarpus has fulfilled. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integers — the description of the commands. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains three space-separated integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ ti ≤ 2; xi, yi ≥ 0; xi + yi = 10)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th command is \""},{"children":[{"kind":"text","text":"ping a"}],"kind":"container"},{"kind":"text","text":"\", otherwise the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th command is \""},{"children":[{"kind":"text","text":"ping b"}],"kind":"container"},{"kind":"text","text":"\". Numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" represent the result of executing this command, that is, "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" packets reached the corresponding server successfully and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" packets were lost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input has at least one \""},{"children":[{"kind":"text","text":"ping a"}],"kind":"container"},{"kind":"text","text":"\" command and at least one \""},{"children":[{"kind":"text","text":"ping b"}],"kind":"container"},{"kind":"text","text":"\" command."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print string \""},{"children":[{"kind":"text","text":"LIVE"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if server "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is \"alive\", otherwise print \""},{"children":[{"kind":"text","text":"DEAD"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print the state of server "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the similar format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 5 5\n2 6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LIVE\nLIVE\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 10\n2 0 10\n1 10 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LIVE\nDEAD\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first test case. There 10 packets were sent to server "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", 5 of them reached it. Therefore, at least half of all packets sent to this server successfully reached it through the network. Overall there were 10 packets sent to server "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", 6 of them reached it. Therefore, at least half of all packets sent to this server successfully reached it through the network."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the second test case. There were overall 20 packages sent to server "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", 10 of them reached it. Therefore, at least half of all packets sent to this server successfully reached it through the network. Overall 10 packets were sent to server "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", 0 of them reached it. Therefore, less than half of all packets sent to this server successfully reached it through the network."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"245A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/245/problem/A"}