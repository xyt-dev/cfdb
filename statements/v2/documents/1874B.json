{"assets":[],"contentKind":"statement","contestId":"1874","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Jellyfish and Math"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jellyfish is given the non-negative integers $$$a$$$, $$$b$$$, $$$c$$$, $$$d$$$ and $$$m$$$. Initially $$$(x,y)=(a,b)$$$. Jellyfish wants to do several operations so that $$$(x,y)=(c,d)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each operation, she can do one of the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$x := x\\,\\&\\,y$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x := x\\,|\\,y$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$y := x \\oplus y$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$y := y \\oplus m$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$\\&$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#AND"},"children":[{"kind":"text","text":"bitwise AND operation"}],"kind":"link"},{"kind":"text","text":", $$$|$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#OR"},"children":[{"kind":"text","text":"bitwise OR operation"}],"kind":"link"},{"kind":"text","text":" and $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Jellyfish asks you for the minimum number of operations such that $$$(x,y)=(c,d)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\leq t \\leq 10^5$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains five integers, $$$a$$$, $$$b$$$, $$$c$$$, $$$d$$$ and $$$m$$$ ($$$0 \\leq a, b, c, d, m \\lt 2^{30}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations. If this cannot be achieved, output $$$-1$$$ instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n1 0 1 1 1\n3 3 1 2 1\n1 6 0 7 1\n2 4 4 9 8\n21 4 0 17 28\n50 50 0 0 39\n95 33 1 33 110\n138 202 174 64 108\n78 340 68 340 461\n457 291 491 566 766\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n-1\n2\n-1\n-1\n2\n1\n4\n1\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can do the operation $$$y = x \\oplus y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it is not possible to change $$$(x,y)=(1,2)$$$ using any sequence of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, we can do the operation $$$x = x\\,\\&\\,y$$$ followed by the operation $$$y = y \\oplus m$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1874B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1874/problem/B"}