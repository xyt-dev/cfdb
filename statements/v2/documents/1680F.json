"/statement-assets/f4651c93c4c3fc6439eba432d594b1a8c8f2e12dc19d67d6a5b63fa7a236d265.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1680F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1680/problem/F"}