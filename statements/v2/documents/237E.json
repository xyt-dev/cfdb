{"assets":[],"contentKind":"statement","contestId":"237","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Build String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You desperately need to build some string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". For that you've got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" more strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":". To build string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", you are allowed to perform exactly "},{"kind":"math_inline","text":"|t|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|t|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":") operations on these strings. Each operation looks like that:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" choose any non-empty string from strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose an arbitrary character from the chosen string and write it on a piece of paper; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" remove the chosen character from the chosen string. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that after you perform the described operation, the total number of characters in strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" decreases by 1. We are assumed to build string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", if the characters, written on the piece of paper, in the order of performed operations form string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are other limitations, though. For each string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" you know number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — the maximum number of characters you are allowed to delete from string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". You also know that each operation that results in deleting a character from string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", costs "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" rubles. That is, an operation on string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" is the cheapest (it costs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ruble), and the operation on string "},{"kind":"math_inline","text":"sn"},{"kind":"text","text":" is the most expensive one (it costs "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rubles)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the minimum amount of money (in rubles) you will need to build string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" by the given rules. Consider the cost of building string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" to be the sum of prices of the operations you use."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the string that you need to build."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the number of strings to which you are allowed to apply the described operation. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a string and an integer. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains space-separated string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and integer "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 100)"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" represents the maximum number of characters that can be deleted from string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All strings in the input only consist of lowercase English letters. All strings are non-empty. The lengths of all strings do not exceed "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum money (in rubles) you need in order to build string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". If there is no solution, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"bbaze\n3\nbzb 2\naeb 3\nba 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n4\naba 2\nbcc 1\ncaa 2\nbbb 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"xyz\n4\naxx 8\nza 1\nefg 4\nt 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Notes to the samples:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample from the first string you should take characters \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ruble, from the second string characters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" и \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" rubles. The price of the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in this case is "},{"kind":"math_inline","text":"2·1 + 3·2 = 8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample from the first string you should take two characters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ruble, from the second string character \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" rubles, from the third string two characters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" rubles, from the fourth string two characters \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" with price "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" rubles. The price of the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in this case is "},{"kind":"math_inline","text":"2·1 + 1·2 + 2·3 + 2·4 = 18"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the solution doesn't exist because there is no character \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\" in given strings."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"237E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/237/problem/E"}