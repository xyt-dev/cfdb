{"assets":[],"contentKind":"statement","contestId":"375","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tree and Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a rooted tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each vertex of the tree has some color. We will assume that the tree vertices are numbered by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Then we represent the color of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"cv"},{"kind":"text","text":". The tree root is a vertex with number 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you need to answer to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. Each query is described by two integers "},{"kind":"math_inline","text":"vj, kj"},{"kind":"text","text":". The answer to query "},{"kind":"math_inline","text":"vj, kj"},{"kind":"text","text":" is the number of such colors of vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", that the subtree of vertex "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" contains at least "},{"kind":"math_inline","text":"kj"},{"kind":"text","text":" vertices of color "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can find the definition of a rooted tree by the following link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105; 1 ≤ m ≤ 105)"},{"kind":"text","text":". The next line contains a sequence of integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"math_inline","text":"(1 ≤ ci ≤ 105)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the edges of the tree. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains the numbers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":" — the vertices connected by an edge of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the queries. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"vj, kj"},{"kind":"math_inline","text":"(1 ≤ vj ≤ n; 1 ≤ kj ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the answers to the queries in the order the queries appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5\n1 2 2 3 3 2 3 3\n1 2\n1 5\n2 3\n2 4\n5 6\n5 7\n5 8\n1 2\n1 3\n1 4\n2 3\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n1\n0\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n1 2 3 4\n1 2\n2 3\n3 4\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A subtree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in a rooted tree with root "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is a set of vertices "},{"kind":"math_inline","text":"{u : dist(r, v) + dist(v, u) = dist(r, u)}"},{"kind":"text","text":". Where "},{"kind":"math_inline","text":"dist(x, y)"},{"kind":"text","text":" is the length (in edges) of the shortest path between vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"375D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/375/problem/D"}