{"assets":[],"contentKind":"statement","contestId":"567","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Lineland Mail"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"All cities of Lineland are located on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" coordinate axis. Thus, each city is associated with its position "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" — a coordinate on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis. No two cities are located at a single point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lineland residents love to send letters to each other. A person may send a letter only if the recipient lives in another city (because if they live in the same city, then it is easier to drop in)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Strange but true, the cost of sending the letter is exactly equal to the distance between the sender's city and the recipient's city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each city calculate two values ​​"},{"kind":"math_inline","text":"mini"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"maxi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"mini"},{"kind":"text","text":" is the minimum cost of sending a letter from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city to some other city, and "},{"kind":"math_inline","text":"maxi"},{"kind":"text","text":" is the the maximum cost of sending a letter from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city to some other city"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of cities in Lineland. The second line contains the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinate of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city. All the "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"'s are distinct and follow in "},{"children":[{"kind":"text","text":"ascending"}],"kind":"container"},{"kind":"text","text":" order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must contain two integers "},{"kind":"math_inline","text":"mini, maxi"},{"kind":"text","text":", separated by a space, where "},{"kind":"math_inline","text":"mini"},{"kind":"text","text":" is the minimum cost of sending a letter from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city, and "},{"kind":"math_inline","text":"maxi"},{"kind":"text","text":" is the maximum cost of sending a letter from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-5 -2 2 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 12\n3 9\n4 7\n5 12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n-1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n2 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"567A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/567/problem/A"}