{"assets":[],"contentKind":"statement","contestId":"2066","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bitwise Slides"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a_1, a_2, \\ldots, a_n$$$. Also, you are given three variables $$$P,Q,R$$$, initially equal to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to process all the numbers $$$a_1, a_2, \\ldots, a_n$$$, "},{"children":[{"kind":"text","text":"in the order from $$$1$$$ to $$$n$$$"}],"kind":"container"},{"kind":"text","text":". When processing the next $$$a_i$$$, you must perform "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one of the three actions of your choice:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$P := P \\oplus a_i$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Q := Q \\oplus a_i$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R := R \\oplus a_i$$$"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"$$$\\oplus$$$ denotes the "},{"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When performing actions, you must follow the "},{"children":[{"kind":"text","text":"main rule"}],"kind":"container"},{"kind":"text","text":": it is necessary that after each action, all three numbers $$$P,Q,R$$$ are "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are a total of $$$3^n$$$ ways to perform all $$$n$$$ actions. How many of them do not violate the "},{"children":[{"kind":"text","text":"main rule"}],"kind":"container"},{"kind":"text","text":"? Since the answer can be quite large, find it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the values of $$$n$$$ for all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the number of ways to perform all $$$n$$$ actions without violating the "},{"children":[{"kind":"text","text":"main rule"}],"kind":"container"},{"kind":"text","text":", modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3\n1 7 9\n4\n179 1 1 179\n5\n1 2 3 3 2\n12\n8 2 5 3 9 1 8 12 9 9 9 4\n1\n1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n9\n39\n123\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are 3 valid sequences of operations: "},{"children":[{"children":[{"kind":"text","text":"PPP"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"QQQ"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"RRR"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, there are 9 valid sequences of operations: "},{"children":[{"children":[{"kind":"text","text":"PPPP"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"PPPQ"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"PPPR"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"QQQP"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"QQQQ"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"QQQR"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"RRRP"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"RRRQ"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"RRRR"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2066C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2066/problem/C"}