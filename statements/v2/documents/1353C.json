{"assets":[],"contentKind":"statement","contestId":"1353","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Board Moves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a board of size $$$n \\times n$$$, where $$$n$$$ is "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" (not divisible by $$$2$$$). Initially, each cell of the board contains one figure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move, you can select "},{"children":[{"kind":"text","text":"exactly one figure"}],"kind":"container"},{"kind":"text","text":" presented in some cell and move it to one of the cells "},{"children":[{"kind":"text","text":"sharing a side or a corner with the current cell"}],"kind":"container"},{"kind":"text","text":", i.e. from the cell $$$(i, j)$$$ you can move the figure to cells: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(i - 1, j - 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i - 1, j)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i - 1, j + 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i, j - 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i, j + 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i + 1, j - 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i + 1, j)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(i + 1, j + 1)$$$; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Of course, you "},{"children":[{"kind":"text","text":"can not"}],"kind":"container"},{"kind":"text","text":" move figures to cells out of the board. It is allowed that after a move there will be several figures in one cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of moves needed to get "},{"children":[{"kind":"text","text":"all the figures"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" cell (i.e. $$$n^2-1$$$ cells should contain $$$0$$$ figures and one cell should contain $$$n^2$$$ figures)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 200$$$) — the number of test cases. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of the test case contains one integer $$$n$$$ ($$$1 \\le n \\lt 5 \\cdot 10^5$$$) — the size of the board. It is guaranteed that $$$n$$$ is odd (not divisible by $$$2$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5 \\cdot 10^5$$$ ($$$\\sum n \\le 5 \\cdot 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print the answer — the minimum number of moves needed to get "},{"children":[{"kind":"text","text":"all the figures"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n5\n499993\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n40\n41664916690999888\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1353C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1353/problem/C"}