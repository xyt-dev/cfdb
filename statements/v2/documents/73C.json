{"assets":[],"contentKind":"statement","contestId":"73","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. LionAge II"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya plays the LionAge II. He was bored of playing with a stupid computer, so he installed this popular MMORPG, to fight with his friends. Vasya came up with the name of his character — non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of a lowercase Latin letters. However, in order not to put up a front of friends, Vasya has decided to change no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" letters of the character name so that the new name sounded as good as possible. Euphony of the line is defined as follows: for each pair of adjacent letters "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" immediately precedes "},{"kind":"math_inline","text":"y"},{"kind":"text","text":") the bonus "},{"kind":"math_inline","text":"c(x, y)"},{"kind":"text","text":" is added to the result. Your task is to determine what the greatest Euphony can be obtained by changing at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" letters in the name of the Vasya's character."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains character's name "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and an integer number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 100"},{"kind":"text","text":"). The length of the nonempty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"100"},{"kind":"text","text":". The second line contains an integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 676"},{"kind":"text","text":") — amount of pairs of letters, giving bonus to the euphony. The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain description of these pairs «"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"c"},{"kind":"text","text":"», which means that sequence "},{"kind":"math_inline","text":"xy"},{"kind":"text","text":" gives bonus "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":" — lowercase Latin letters, "},{"kind":"math_inline","text":" - 1000 ≤ c ≤ 1000)"},{"kind":"text","text":". It is guaranteed that no pair "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" mentioned twice in the input data."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the only number — maximum possible euphony оf the new character's name."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"winner 4\n4\ns e 7\no s 8\nl o 13\no o 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"36"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcdef 1\n5\na b -10\nb c 5\nc d 5\nd e 5\ne f 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the most euphony name will be "},{"kind":"math_inline","text":"looser"},{"kind":"text","text":". It is easy to calculate that its euphony is 36."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"73C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/73/problem/C"}