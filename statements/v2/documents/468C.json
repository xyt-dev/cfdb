{"assets":["/statement-assets/785adfdf089dce37a45799de9b4fd962e6d192cb7c41db534e1a4b50e31edc18.png","/statement-assets/1814fc98d59f08a54c1ebb44d0d5f04eb5d5a0eb155e761d51cd4886321dbbb5.png"],"contentKind":"statement","contestId":"468","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Hack it!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little X has met the following problem recently. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define "},{"kind":"math_inline","text":"f(x)"},{"kind":"text","text":" as the sum of digits in decimal representation of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (for example, "},{"kind":"math_inline","text":"f(1234) = 1 + 2 + 3 + 4"},{"kind":"text","text":"). You are to calculate "},{"attrs":{"alt":"","src":"/statement-assets/785adfdf089dce37a45799de9b4fd962e6d192cb7c41db534e1a4b50e31edc18.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course Little X has solved this problem quickly, has locked it, and then has tried to hack others. He has seen the following C++ code: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n    ans = solve(l, r) % a;\n    if (ans <= 0)\n      ans += a;\n\n"},{"kind":"text","text":" This code will fail only on the test with "},{"attrs":{"alt":"","src":"/statement-assets/1814fc98d59f08a54c1ebb44d0d5f04eb5d5a0eb155e761d51cd4886321dbbb5.png"},"kind":"image"},{"kind":"text","text":". You are given number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", help Little X to find a proper test for hack."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"a (1 ≤ a ≤ 1018)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers: "},{"kind":"math_inline","text":"l, r (1 ≤ l ≤ r < 10200)"},{"kind":"text","text":" — the required test data. Leading zeros aren't allowed. It's guaranteed that the solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"46\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"126444381000032\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2333333 2333333333333\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"468C","schema":2,"sourceKind":"html","sourceUrl":"htt