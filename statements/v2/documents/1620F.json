{"assets":[],"contentKind":"statement","contestId":"1620","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Bipartite Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation $$$p$$$ consisting of $$$n$$$ integers $$$1, 2, \\dots, n$$$ (a permutation is an array where each element from $$$1$$$ to $$$n$$$ occurs exactly once)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call an array $$$a$$$ "},{"children":[{"kind":"text","text":"bipartite"}],"kind":"container"},{"kind":"text","text":" if the following undirected graph is bipartite:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the graph consists of $$$n$$$ vertices; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" two vertices $$$i$$$ and $$$j$$$ are connected by an edge if $$$i \\lt j$$$ and $$$a_i \\gt a_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to find a "},{"children":[{"kind":"text","text":"bipartite"}],"kind":"container"},{"kind":"text","text":" array of integers $$$a$$$ of size $$$n$$$, such that $$$a_i = p_i$$$ or $$$a_i = -p_i$$$, or report that no such array exists. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^5$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$) — the size of the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$p_1, p_2, \\dots, p_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ over all test cases doesn't exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer in the following format. If such an array $$$a$$$ does not exist, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in a single line. Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line and $$$n$$$ integers — array $$$a$$$ in the second line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3\n1 2 3\n6\n1 3 2 6 5 4\n4\n4 1 3 2\n8\n3 2 1 6 7 8 5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n1 2 3\nNO\nYES\n-4 -1 -3 -2\nYES\n-3 -2 1 6 7 -8 -5 -4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1620F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1620/problem/F"}