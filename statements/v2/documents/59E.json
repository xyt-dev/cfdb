{"assets":[],"contentKind":"statement","contestId":"59","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Shortest Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Ancient Berland there were "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" two-way roads of equal length. The cities are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusively. According to an ancient superstition, if a traveller visits three cities "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" in row, without visiting other cities between them, a great disaster awaits him. Overall there are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such city triplets. Each triplet is ordered, which means that, for example, you are allowed to visit the cities in the following order: "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Vasya wants to get from the city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and not fulfil the superstition. Find out which minimal number of roads he should take. Also you are required to find one of his possible path routes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3000, 1 ≤ m ≤ 20000, 0 ≤ k ≤ 105"},{"kind":"text","text":") which are the number of cities, the number of roads and the number of the forbidden triplets correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines each containing two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":") which are the road descriptions. The road is described by the numbers of the cities it joins. No road joins a city with itself, there cannot be more than one road between a pair of cities. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines each containing three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi, ci ≤ n"},{"kind":"text","text":") which are the forbidden triplets. Each ordered triplet is listed mo more than one time. All three cities in each triplet are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"City "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" can be unreachable from city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" by roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are no path from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise on the first line print the number of roads "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" along the shortest path from the city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". On the second line print "},{"kind":"math_inline","text":"d + 1"},{"kind":"text","text":" numbers — any of the possible shortest paths for Vasya. The path should start in the city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and end in the city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 1\n1 2\n2 3\n3 4\n1 3\n1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":