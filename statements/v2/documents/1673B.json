{"assets":[],"contentKind":"statement","contestId":"1673","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A Perfectly Balanced String?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call a string $$$s$$$ perfectly balanced if for all possible triplets $$$(t,u,v)$$$ such that $$$t$$$ is a non-empty substring of $$$s$$$ and $$$u$$$ and $$$v$$$ are characters present in $$$s$$$, the difference between the frequencies of $$$u$$$ and $$$v$$$ in $$$t$$$ is not more than $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the strings \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" are perfectly balanced but \""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\" is not because for the triplet (\""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\",'"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"','"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'), the condition is not satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of lowercase English letters only. Your task is to determine whether $$$s$$$ is perfectly balanced or not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$b$$$ is called a substring of another string $$$a$$$ if $$$b$$$ can be obtained by deleting some characters (possibly $$$0$$$) from the start and some characters (possibly $$$0$$$) from the end of $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1\\leq t\\leq 2\\cdot 10^4$$$) denoting the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contain a single string $$$s$$$ ($$$1\\leq |s|\\leq 2\\cdot 10^5$$$), consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|s|$$$ over all testcases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if $$$s$$$ is a perfectly balanced string, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print each letter in any case (for example, "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"Yes\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"yes\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"yEs\""}],"kind":"container"},{"kind":"text","text":" will all be recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":