{"assets":[],"contentKind":"statement","contestId":"557","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Arthur and Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arthur has bought a beautiful big table into his new flat. When he came home, Arthur noticed that the new table is unstable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In total the table Arthur bought has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" legs, the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th leg is "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arthur decided to make the table stable and remove some legs. For each of them Arthur determined number "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — the amount of energy that he spends to remove the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th leg."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A table with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" legs is assumed to be stable if there are more than half legs of the maximum length. For example, to make a table with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" legs stable, you need to make sure it has at least three (out of these five) legs of the maximum length. Also, a table with one leg is always stable and a table with two legs is stable if and only if they have the same lengths."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Arthur and count the minimum number of energy units Arthur should spend on making the table stable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the initial number of legs in the table Arthur bought."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ 105"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" is equal to the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th leg of the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ 200"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is the number of energy units that Arthur spends on removing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th leg off the table."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of energy units that Arthur needs to spend in order to make the table stable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 5\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 4 4\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 2 1 1 3 3\n4 3 5 5 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"557C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/557/problem/C"}