{"assets":["/statement-assets/5b88db1ca9194bbc5859bcb811620cea1e8e8b194899f3490c6175b7cf90cd3e.png","/statement-assets/ad334b7e921cfe06b69340db7d1568930d82ec5473771465cc6992a550b91cdd.png"],"contentKind":"statement","contestId":"680","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bear and Finding Criminals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Bearland, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Cities are arranged in one long row. The distance between cities "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"|i - j|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a police officer. He lives in a city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". His job is to catch criminals. It's hard because he doesn't know in which cities criminals are. Though, he knows that there is "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" criminal in each city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is going to use a BCD (Bear Criminal Detector). The BCD will tell Limak how many criminals there are for every distance from a city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". After that, Limak can catch a criminal in each city for which he "},{"children":[{"kind":"text","text":"is sure"}],"kind":"container"},{"kind":"text","text":" that there must be a criminal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know in which cities criminals are. Count the number of criminals Limak will catch, after he uses the BCD."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ n ≤ 100"},{"kind":"text","text":") — the number of cities and the index of city where Limak lives."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ti ≤ 1"},{"kind":"text","text":"). There are "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" criminals in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of criminals Limak will catch."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n1 1 1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n0 0 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are six cities and Limak lives in the third one (blue arrow below). Criminals are in cities marked red."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5b88db1ca9194bbc5859bcb811620cea1e8e8b194899f3490c6175b7cf90cd3e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Using the BCD gives Limak the following information:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" There is one criminal at distance "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" from the third city — Limak is sure that this criminal is exactly in the third city. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is one criminal at distance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from the third city — Limak doesn't know if a criminal is in the second or fourth city. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are two criminals at distance "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from the third city — Limak is sure that there is one criminal in the first city and one in the fifth city. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are zero criminals for every greater distance. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, Limak will catch criminals in cities "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", that is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" criminals in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample (drawing below), the BCD gives Limak the information that there is one criminal at distance "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from Limak's city. There is only one city at distance "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" so Limak is sure where a criminal is."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ad334b7e921cfe06b69340db7d1568930d82ec5473771465cc6992a550b91cdd.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"680B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/680/problem/B"}