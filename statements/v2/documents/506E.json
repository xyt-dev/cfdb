{"assets":[],"contentKind":"statement","contestId":"506","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mr. Kitayuta's Gift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"768 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Kitayuta has kindly given you a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase English letters. You are asked to insert exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to make it a palindrome. (A "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" is a string that reads the same forward and backward. For example, \""},{"children":[{"kind":"text","text":"noon"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"testset"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" are all palindromes, while \""},{"children":[{"kind":"text","text":"test"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"kitayuta"}],"kind":"container"},{"kind":"text","text":"\" are not.) You can choose any "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters, and insert each of them to any position of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", possibly to the beginning or the end of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". You have to insert exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters even if it is possible to turn "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into a palindrome by inserting less than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of the palindromes that can be obtained in this way, modulo "},{"kind":"math_inline","text":"10007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 200"},{"kind":"text","text":"). Each character in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a lowercase English letter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of the palindromes that can be obtained, modulo "},{"kind":"math_inline","text":"10007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"re