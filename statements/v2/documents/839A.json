{"assets":[],"contentKind":"statement","contestId":"839","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Arya and Bran"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bran and his older sister Arya are from the same house. Bran like candies so much, so Arya is going to give him some Candies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At first, Arya and Bran have "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" Candies. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days, at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day, Arya finds "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" candies in a box, that is given by the Many-Faced God. Every day she can give Bran "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"math_inline","text":"8"},{"kind":"text","text":" of her candies. If she don't give him the candies at the same day, they are saved for her and she can give them to him later."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of days Arya needs to give Bran "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies "},{"children":[{"kind":"text","text":"before"}],"kind":"container"},{"kind":"text","text":" the end of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th day. Formally, you need to output the minimum day index to the end of which "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies will be given out (the days are indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if she can't give him "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies during "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" given days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 10000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, a3, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible for Arya to give Bran "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies within "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print a single integer — the minimum number of days Arya needs to give Bran "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies before the end of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 17\n10 10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 9\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Arya can give Bran "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" candies in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Arya can give Bran "},{"kind":"math_inline","text":"17"},{"kind":"text","text":" candies in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" days, because she can give him at most "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" candies per day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Arya can't give Bran "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" candies, because she can give him at most "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" candies per day and she must give him the candies within "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"839A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/839/problem/A"}