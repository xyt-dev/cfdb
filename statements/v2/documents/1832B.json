{"assets":[],"contentKind":"statement","contestId":"1832","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maximum Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a_1, a_2, \\dots, a_n$$$, where all elements are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to perform "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ operations with it. During each operation, you do "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of the following two actions (you choose which to do yourself):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" find "},{"children":[{"kind":"text","text":"two minimum elements"}],"kind":"container"},{"kind":"text","text":" in the array, and delete them; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" find "},{"children":[{"kind":"text","text":"the maximum element"}],"kind":"container"},{"kind":"text","text":" in the array, and delete it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to calculate the maximum possible sum of elements in the resulting array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains two integers $$$n$$$ and $$$k$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$; $$$1 \\le k \\le 99999$$$; $$$2k \\lt n$$$) — the number of elements and operations, respectively. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$; all $$$a_i$$$ are different) — the elements of the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of $$$n$$$ does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the maximum possible sum of elements in the resulting array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5 1\n2 5 1 10 6\n5 2\n2 5 1 10 6\n3 1\n1 2 3\n6 1\n15 22 12 10 13 11\n6 2\n15 22 12 10 13 11\n5 1\n999999996 999999999 999999997 999999998 999999995\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n11\n3\n62\n46\n3999999986\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, applying the first operation produces the following outcome: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" two minimums are $$$1$$$ and $$$2$$$; removing them leaves the array as $$$[5, 10, 6]$$$, with sum $$$21$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a maximum is $$$10$$$; removing it leaves the array as $$$[2, 5, 1, 6]$$$, with sum $$$14$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"$$$21$$$ is the best answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second testcase, it's optimal to first erase two minimums, then a maximum."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1832B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1832/problem/B"}