{"assets":["/statement-assets/f98162777a304b8c99d5d7bd89bfdf794dccd5e538d19401d9d1708ea3172d03.png"],"contentKind":"statement","contestId":"15","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Triangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Last summer Peter was at his granny's in the country, when a wolf attacked sheep in the nearby forest. Now he fears to walk through the forest, to walk round the forest, even to get out of the house. He explains this not by the fear of the wolf, but by a strange, in his opinion, pattern of the forest that has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" levels, where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an even number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the local council you were given an area map, where the granny's house is marked by point "},{"kind":"math_inline","text":"H"},{"kind":"text","text":", parts of dense forest are marked grey (see the picture to understand better)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After a long time at home Peter decided to yield to his granny's persuasions and step out for a breath of fresh air. Being prudent, Peter plans the route beforehand. The route, that Peter considers the most suitable, has the following characteristics: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" it starts and ends in the same place — the granny's house; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the route goes along the forest paths only (these are the segments marked black in the picture); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the route has positive length (to step out for a breath of fresh air Peter has to cover some distance anyway); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the route cannot cross itself; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there shouldn't be any part of dense forest within the part marked out by this route; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You should find the amount of such suitable oriented routes modulo 1000000009."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f98162777a304b8c99d5d7bd89bfdf794dccd5e538d19401d9d1708ea3172d03.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The example of the area map for "},{"kind":"math_inline","text":"n = 12"},{"kind":"text","text":" is given in the picture. Since the map has a regular structure, you can construct it for other "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by analogy using the example."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input data contain the only even integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the only number — the amount of Peter's routes modulo 1000000009."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"74\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"15E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/15/problem/E"}