{"assets":[],"contentKind":"statement","contestId":"1948","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Special Characters"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to build a string of uppercase Latin letters. There must be exactly $$$n$$$ special characters in this string. Let's call a character "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" if it is equal to exactly one of its neighbors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, there are $$$6$$$ special characters in the "},{"children":[{"kind":"text","text":"AAABAACC"}],"kind":"container"},{"kind":"text","text":" string (at positions: $$$1$$$, $$$3$$$, $$$5$$$, $$$6$$$, $$$7$$$ and $$$8$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print any suitable string or report that there is no such string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 50$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 50$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if there is no suitable string, print one line containing the string "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, print two lines. The first line should contain the string "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"; on the second line print a string of length "},{"children":[{"kind":"text","text":"at most $$$200$$$"}],"kind":"container"},{"kind":"text","text":" — the answer itself (it can be shown that if some answers exist, then there is an answer of length at most $$$200$$$). If there are several solutions, print any of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nAAABAACC\nNO\nYES\nMM"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1948A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1948/problem/A"}