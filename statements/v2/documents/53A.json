{"assets":[],"contentKind":"statement","contestId":"53","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Autocomplete"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Autocomplete is a program function that enables inputting the text (in editors, command line shells, browsers etc.) completing the text by its inputted part. Vasya is busy working on a new browser called 'BERowser'. He happens to be working on the autocomplete function in the address line at this very moment. A list consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" last visited by the user pages and the inputted part "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are known. Your task is to complete "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to make it an address of one of the pages from the list. You have to find the lexicographically smallest address having a prefix "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" line which is the inputted part. The second line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") which is the number of visited pages. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines which are the visited pages, one on each line. All the lines have lengths of from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" symbols inclusively and consist of lowercase Latin letters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is not the beginning of any of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" addresses of the visited pages, print "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Otherwise, print the lexicographically minimal address of one of the visited pages starting from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographical order is the order of words in a dictionary. The lexicographical comparison of lines is realized by the "},{"children":[{"kind":"text","text":"'<'"}],"kind":"container"},{"kind":"text","text":" operator in the modern programming languages."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"next\n2\nnextpermutation\nnextelement\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"nextelement\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"find\n4\nfind\nfindfirstof\nfindit\nfand\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"find\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"find\n4\nfondfind\nfondfirstof\nfondit\nfand\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"find\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"53A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/53/problem/A"}