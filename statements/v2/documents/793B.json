{"assets":["/statement-assets/139460d080dab556c081d4a8d063825e5f3ccdcf72c74ffc3c859b1499c07fce.png","/statement-assets/0793699a26e9145cf0a2f2cda59dc39afdfad1b2091832edc15611c4898b1a57.png"],"contentKind":"statement","contestId":"793","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Igor and his way to work"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Woken up by the alarm clock Igor the financial analyst hurried up to the work. He ate his breakfast and sat in his car. Sadly, when he opened his GPS navigator, he found that some of the roads in Bankopolis, the city where he lives, are closed due to road works. Moreover, Igor has some problems with the steering wheel, so he can make "},{"children":[{"kind":"text","text":"no more than two turns"}],"kind":"container"},{"kind":"text","text":" on his way to his office in bank."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bankopolis looks like a grid of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. Igor should find a way from his home to the bank that has no more than two turns and doesn't contain cells with road works, or determine that it is impossible and he should work from home. A turn is a change in movement direction. Igor's car can only move to the left, to the right, upwards and downwards. Initially Igor can choose any direction. Igor is still sleepy, so you should help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":") — the number of rows and the number of columns in the grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters denoting the corresponding row of the grid. The following characters can occur: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" — an empty cell; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" — a cell with road works; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"\" — the cell where Igor's home is located; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" — the cell where Igor's office is located. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that \""},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" appear exactly once each."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there is a path between Igor's home and Igor's office with no more than two turns, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n..S..\n****.\nT....\n****.\n.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\nS....\n****.\n.....\n.****\n..T..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is shown on the following picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/139460d080dab556c081d4a8d063825e5f3ccdcf72c74ffc3c859b1499c07fce.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample it is impossible to reach Igor's office using less that "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" turns, thus there exists no path using no more than "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" turns. The path using exactly "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" turns is shown on this picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0793699a26e9145cf0a2f2cda59dc39afdfad1b2091832edc15611c4898b1a57.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"793B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/793/problem/B"}