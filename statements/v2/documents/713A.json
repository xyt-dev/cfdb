{"assets":[],"contentKind":"statement","contestId":"713","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sonya and Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today Sonya learned about long integers and invited all her friends to share the fun. Sonya has an initially empty multiset with integers. Friends give her "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" queries, each of one of the following type:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":" + "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — add non-negative integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to the multiset. Note, that she has a multiset, thus there may be many occurrences of the same integer. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":" - "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — delete a single occurrence of non-negative integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" from the multiset. It's guaranteed, that there is at least one "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" in the multiset. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"?"},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — count the number of integers in the multiset (with repetitions) that match some pattern "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". In the pattern, "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" stands for the even digits, while "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stands for the odd. Integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" matches the pattern "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", if the parity of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from the right digit in decimal notation matches the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from the right digit of the pattern. If the pattern is shorter than this integer, it's supplemented with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"-s from the left. Similarly, if the integer is shorter than the pattern its decimal notation is supplemented with the "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"-s from the left. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if the pattern is "},{"kind":"math_inline","text":"s = 010"},{"kind":"text","text":", than integers "},{"kind":"math_inline","text":"92"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2212"},{"kind":"text","text":", "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"414"},{"kind":"text","text":" match the pattern, while integers "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"110"},{"kind":"text","text":", "},{"kind":"math_inline","text":"25"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1030"},{"kind":"text","text":" do not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 100 000"},{"kind":"text","text":") — the number of operation Sonya has to perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines provide the descriptions of the queries in order they appear in the input file. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row starts with a character "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" — the type of the corresponding operation. If "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is equal to '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' then it's followed by a space and an integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai < 1018"},{"kind":"text","text":") given without leading zeroes (unless it's "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" equals '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' then it's followed by a space and a sequence of zeroes and onse, giving the pattern of length no more than "},{"kind":"math_inline","text":"18"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that there will be at least one query of type '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that any time some integer is removed from the multiset, there will be at least one occurrence of this integer in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the third type print the number of integers matching the given pattern. Each integer is counted as many times, as it appears in the multiset at this moment of time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12\n+ 1\n+ 241\n? 1\n+ 361\n- 241\n? 0101\n+ 101\n? 101\n- 101\n? 101\n+ 4000\n? 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n2\n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n+ 200\n+ 200\n- 200\n? 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the integers matching the patterns from the queries of the third type. Queries are numbered in the order they appear in the input. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"241"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"361"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"101"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"361"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"361"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4000"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"713A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/713/problem/A"}