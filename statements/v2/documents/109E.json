{"assets":["/statement-assets/4d90ec05db7e36e53472bf417a0495b4dc20bc085f8799bc9d6bcb1868e68105.png"],"contentKind":"statement","contestId":"109","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Lucky Interval"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. We all know that lucky numbers are the positive integers whose decimal representations contain only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Petya came across an interval of numbers "},{"kind":"math_inline","text":"[a, a + l - 1]"},{"kind":"text","text":". Let "},{"kind":"math_inline","text":"F(x)"},{"kind":"text","text":" be the number of lucky digits of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Find the minimum "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(a < b)"},{"kind":"text","text":" such, that "},{"kind":"math_inline","text":"F(a)"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"F(b)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"F(a + 1)"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"F(b + 1)"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"F(a + l - 1)"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"F(b + l - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, l ≤ 109"},{"kind":"text","text":") — the interval's first number and the interval's length correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the single line print number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider that "},{"kind":"math_inline","text":"[a, b]"},{"kind":"text","text":" denotes an interval of integers; this interval "},{"children":[{"kind":"text","text":"includes"}],"kind":"container"},{"kind":"text","text":" the boundaries. That is, "},{"attrs":{"alt":"","src":"/statement-assets/4d90ec05db7e36e53472bf417a0495b4dc20bc085f8799bc9d6bcb1868e68105.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"109E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/109/problem/E"}