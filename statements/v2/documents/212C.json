{"assets":["/statement-assets/27ab7849be92161075d82f03ddbc81b4ddf6354ef363938f42037a77c3812839.png"],"contentKind":"statement","contestId":"212","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cowboys"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A very tense moment: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cowboys stand in a circle and each one points his colt at a neighbor. Each cowboy can point the colt to the person who follows or precedes him in clockwise direction. Human life is worthless, just like in any real western."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture changes each second! Every second the cowboys analyse the situation and, if a pair of cowboys realize that they aim at each other, they turn around. In a second all such pairs of neighboring cowboys aiming at each other turn around. All actions happen instantaneously and simultaneously in a second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll use character \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" to denote a cowboy who aims at his neighbour in the clockwise direction, and character \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" for a cowboy who aims at his neighbour in the counter clockwise direction. Then a string of letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" will denote the circle of cowboys, the record is made from the first of them in a clockwise direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, a circle that looks like \""},{"children":[{"kind":"text","text":"ABBBABBBA"}],"kind":"container"},{"kind":"text","text":"\" after a second transforms into \""},{"children":[{"kind":"text","text":"BABBBABBA"}],"kind":"container"},{"kind":"text","text":"\" and a circle that looks like \""},{"children":[{"kind":"text","text":"BABBA"}],"kind":"container"},{"kind":"text","text":"\" transforms into \""},{"children":[{"kind":"text","text":"ABABB"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/27ab7849be92161075d82f03ddbc81b4ddf6354ef363938f42037a77c3812839.png"},"kind":"image"},{"children":[{"kind":"text","text":" This picture illustrates how the circle \""},{"children":[{"kind":"text","text":"BABBA"}],"kind":"container"},{"kind":"text","text":"\" transforms into \""},{"children":[{"kind":"text","text":"ABABB"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"A second passed and now the cowboys' position is described by string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Your task is to determine the number of possible states that lead to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in a second. Two states are considered distinct if there is a cowboy who aims at his clockwise neighbor in one state and at his counter clockwise neighbor in the other state."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input data consists of a single string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Its length is from 3 to 100 characters, inclusive. Line "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sought number of states."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"BABBBABBA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABABB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABABAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the possible initial states are \""},{"children":[{"kind":"text","text":"ABBBABBAB"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ABBBABBBA"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the possible initial states are \""},{"children":[{"kind":"text","text":"AABBB"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"BABBA"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"212C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/212/problem/C"}