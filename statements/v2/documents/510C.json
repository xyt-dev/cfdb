{"assets":[],"contentKind":"statement","contestId":"510","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Fox And Names"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel is going to publish a paper on FOCS (Foxes Operated Computer Systems, pronounce: \"Fox\"). She heard a rumor: the authors list on the paper is always sorted in the "},{"children":[{"kind":"text","text":"lexicographical"}],"kind":"container"},{"kind":"text","text":" order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After checking some examples, she found out that sometimes it wasn't true. On some papers authors' names weren't sorted in "},{"children":[{"kind":"text","text":"lexicographical"}],"kind":"container"},{"kind":"text","text":" order in normal sense. But it was always true that after some modification of the order of letters in alphabet, the order of authors becomes "},{"children":[{"kind":"text","text":"lexicographical"}],"kind":"container"},{"kind":"text","text":"!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She wants to know, if there exists an order of letters in Latin alphabet such that the names on the paper she is submitting are following in the "},{"children":[{"kind":"text","text":"lexicographical"}],"kind":"container"},{"kind":"text","text":" order. If so, you should find out any such order."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lexicographical"}],"kind":"container"},{"kind":"text","text":" order is defined in following way. When we compare "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", first we find the leftmost position with differing characters: "},{"kind":"math_inline","text":"si ≠ ti"},{"kind":"text","text":". If there is no such position (i. e. "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a prefix of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" or vice versa) the shortest string is less. Otherwise, we compare characters "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" according to their order in alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"): number of names."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain one string "},{"kind":"math_inline","text":"namei"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |namei| ≤ 100"},{"kind":"text","text":"), the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th name. Each name contains only lowercase Latin letters. All names are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there exists such order of letters that the given names are sorted lexicographically, output any such order as a permutation of characters 'a'–'z' (i. e. first output the first letter of the modified alphabet, then the second, and so on)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise output a single word \"Impossible\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nrivest\nshamir\nadleman\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"bcdefghijklmnopqrsatuvwxyz\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\ntourist\npetr\nwjmzbmr\nyeputons\nvepifanov\nscottwu\noooooooooooooooo\nsubscriber\nrowdark\ntankengineer\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\npetr\negor\nendagorion\nfeferivan\nilovetanyaromanova\nkostka\ndmitriyh\nmaratsnowbear\nbredorjaguarturnik\ncgyforever\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aghjlnopefikdmbcqrstuvwxyz\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children"