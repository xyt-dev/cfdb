{"assets":[],"contentKind":"statement","contestId":"549","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Looksery Party"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Looksery company, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" staff members, is planning another big party. Every employee has his phone number and the phone numbers of his friends in the phone book. Everyone who comes to the party, sends messages to his contacts about how cool it is. At the same time everyone is trying to spend as much time on the fun as possible, so they send messages to everyone without special thinking, moreover, each person even sends a message "},{"children":[{"kind":"text","text":"to himself or herself"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Igor and Max, Looksery developers, started a dispute on how many messages each person gets. Igor indicates "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which indicates how many messages, in his view, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee is going to take. If Igor guesses correctly at least one of these numbers, he wins, otherwise Max wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You support Max in this debate, so you need, given the contact lists of the employees, to determine whether there is a situation where Igor loses. Specifically, you need to determine which employees should come to the party, and which should not, so after all the visitors send messages to their contacts, each employee received a number of messages that is different from what Igor stated."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of employees of company Looksery."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of the contact lists of the employees. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of digits zero and one, specifying the contact list of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee. If the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th string equals "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th employee is in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee's contact list, otherwise he isn't. It is guaranteed that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is always equal to "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ n"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" represents the number of messages that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee should get according to Igor."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of employees who should come to the party so that Igor loses the dispute."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers — the numbers of these employees in an arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If Igor wins the dispute in any case, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n101\n010\n001\n0 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1111\n0101\n1110\n0001\n1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Igor supposes that the first employee will receive "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" messages. Since he isn't contained in any other contact list he must come to the party in order to receive one message from himself. If he is the only who come to the party then he will receive "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" message, the second employee will receive "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" messages and the third will also receive "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" message. Thereby Igor won't guess any number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample if the single employee comes to the party he receives "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" message and Igor wins, so he shouldn't do it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the first employee will receive "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" messages, the second — "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", the third — "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", the fourth — "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"549B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/549/problem/B"}