{"assets":[],"contentKind":"statement","contestId":"1391","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. 505"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A binary matrix is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if every "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" length square sub-matrix has an "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" number of ones. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a binary matrix $$$a$$$ consisting of $$$n$$$ rows and $$$m$$$ columns, determine the minimum number of cells you need to change to make it good, or report that there is no way to make it good at all. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the terms above have their usual meanings — refer to the Notes section for their formal definitions. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n \\leq m \\leq 10^6$$$ and $$$n\\cdot m \\leq 10^6$$$)  — the number of rows and columns in $$$a$$$, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$n$$$ lines each contain $$$m$$$ characters, each of which is one of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". If the $$$j$$$-th character on the $$$i$$$-th line is "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", then $$$a_{i,j} = 1$$$. Similarly, if the $$$j$$$-th character on the $$$i$$$-th line is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", then $$$a_{i,j} = 0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum number of cells you need to change to make $$$a$$$ good, or output $$$-1$$$ if it's not possible at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n101\n001\n110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 15\n000100001010010\n100111010110001\n101101111100100\n010000111111010\n111010010100001\n000011001111101\n111111011010011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, changing $$$a_{1,1}$$$ to $$$0$$$ and $$$a_{2,2}$$$ to $$$1$$$ is enough. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can verify that there is no way to make the matrix in the second case good. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some definitions — "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A binary matrix is one in which every element is either $$$1$$$ or $$$0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A sub-matrix is described by $$$4$$$ parameters — $$$r_1$$$, $$$r_2$$$, $$$c_1$$$, and $$$c_2$$$; here, $$$1 \\leq r_1 \\leq r_2 \\leq n$$$ and $$$1 \\leq c_1 \\leq c_2 \\leq m$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" This sub-matrix contains all elements $$$a_{i,j}$$$ that satisfy both $$$r_1 \\leq i \\leq r_2$$$ and $$$c_1 \\leq j \\leq c_2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A sub-matrix is, further, called an even length square if $$$r_2-r_1 = c_2-c_1$$$ and $$$r_2-r_1+1$$$ is divisible by $$$2$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1391D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1391/problem/D"}