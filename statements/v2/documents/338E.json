{"assets":["/statement-assets/b273d7004bdee0777d1bcb94612d6610d0f278c508b31eb092393aaae62d2cf2.png"],"contentKind":"statement","contestId":"338","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Optimize!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Manao is solving a problem with the following statement:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b273d7004bdee0777d1bcb94612d6610d0f278c508b31eb092393aaae62d2cf2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He came up with a solution that produces the correct answers but is too slow. You are given the pseudocode of his solution, where the function getAnswer calculates the answer to the problem:"}],"kind":"paragraph"},{"kind":"code_block","text":"\ngetAnswer(a[1..n], b[1..len], h)\n  answer = 0\n  for i = 1 to n-len+1\n    answer = answer + f(a[i..i+len-1], b, h, 1)\n  return answer\n\nf(s[1..len], b[1..len], h, index)\n  if index = len+1 then\n    return 1\n  for i = 1 to len\n    if s[index] + b[i] >= h\n      mem = b[i]\n      b[i] = 0\n      res = f(s, b, h, index + 1)\n      b[i] = mem\n      if res > 0\n        return 1\n  return 0\n"},{"children":[{"kind":"text","text":"Your task is to help Manao optimize his algorithm."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ len ≤ n ≤ 150000; 1 ≤ h ≤ 109"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., blen"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 109"},{"kind":"text","text":"). The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer to Manao's problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 10\n5 3\n1 8 5 5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"338E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/338/problem/E"}