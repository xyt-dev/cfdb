{"assets":[],"contentKind":"statement","contestId":"1552","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Array Differentiation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence of $$$n$$$ integers $$$a_1, \\, a_2, \\, \\dots, \\, a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Does there exist a sequence of $$$n$$$ integers $$$b_1, \\, b_2, \\, \\dots, \\, b_n$$$ such that the following property holds?"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For each $$$1 \\le i \\le n$$$, there exist two (not necessarily distinct) indices $$$j$$$ and $$$k$$$ ($$$1 \\le j, \\, k \\le n$$$) such that $$$a_i = b_j - b_k$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 20$$$) — the number of test cases. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 10$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the $$$n$$$ integers $$$a_1, \\, \\dots, \\, a_n$$$ ($$$-10^5 \\le a_i \\le 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a line containing "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if a sequence $$$b_1, \\, \\dots, \\, b_n$$$ satisfying the required property exists, and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\n4 -7 -1 5 10\n1\n0\n3\n1 10 100\n4\n-3 2 10 2\n9\n25 -171 250 174 152 242 100 -205 -258\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first test case"}],"kind":"container"},{"kind":"text","text":", the sequence $$$b = [-9, \\, 2, \\, 1, \\, 3, \\, -2]$$$ satisfies the property. Indeed, the following holds: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1 = 4 = 2 - (-2) = b_2 - b_5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2 = -7 = -9 - (-2) = b_1 - b_5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_3 = -1 = 1 - 2 = b_3 - b_2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_4 = 5 = 3 - (-2) = b_4 - b_5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_5 = 10 = 1 - (-9) = b_3 - b_1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"second test case"}],"kind":"container"},{"kind":"text","text":", it is sufficient to choose $$$b = [0]$$$, since $$$a_1 = 0 = 0 - 0 = b_1 - b_1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"third test case"}],"kind":"container"},{"kind":"text","text":", it is possible to show that no sequence $$$b$$$ of length $$$3$$$ satisfies the property."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1552D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1552/problem/D"}