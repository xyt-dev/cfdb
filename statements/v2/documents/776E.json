{"assets":["/statement-assets/37ac3d3ca94edb0c9481521b67d4831a5b8cd3c9df1462e1c29698598032ecaf.png","/statement-assets/c3904c92df4506bcfdbe62dfad69ea2c17010376022f79acc938f5eee528343b.png"],"contentKind":"statement","contestId":"776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. The Holmes Children"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Holmes children are fighting over who amongst them is the cleverest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mycroft asked Sherlock and Eurus to find value of "},{"kind":"math_inline","text":"f(n)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"f(1) = 1"},{"kind":"text","text":" and for "},{"kind":"math_inline","text":"n ≥ 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(n)"},{"kind":"text","text":" is the number of distinct ordered positive integer pairs "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" that satisfy "},{"kind":"math_inline","text":"x + y = n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(x, y) = 1"},{"kind":"text","text":". The integer "},{"kind":"math_inline","text":"gcd(a, b)"},{"kind":"text","text":" is the greatest common divisor of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sherlock said that solving this was child's play and asked Mycroft to instead get the value of "},{"attrs":{"alt":"","src":"/statement-assets/37ac3d3ca94edb0c9481521b67d4831a5b8cd3c9df1462e1c29698598032ecaf.png"},"kind":"image"},{"kind":"text","text":". Summation is done over all positive integers "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" that divide "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Eurus was quietly observing all this and finally came up with her problem to astonish both Sherlock and Mycroft."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She defined a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-composite function "},{"kind":"math_inline","text":"Fk(n)"},{"kind":"text","text":" recursively as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c3904c92df4506bcfdbe62dfad69ea2c17010376022f79acc938f5eee528343b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"She wants them to tell the value of "},{"kind":"math_inline","text":"Fk(n)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line of input contains two space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1012"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1012"},{"kind":"text","text":") indicating that Eurus asks Sherlock and Mycroft to find the value of "},{"kind":"math_inline","text":"Fk(n)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the value of "},{"kind":"math_inline","text":"Fk(n)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, there are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" distinct ordered pairs "},{"kind":"math_inline","text":"(1, 6)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(5, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(6, 1)"},{"kind":"text","text":" satisfying "},{"kind":"math_inline","text":"x + y = 7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(x, y) = 1"},{"kind":"text","text":". Hence, "},{"kind":"math_inline","text":"f(7) = 6"},{"kind":"text","text":". So, "},{"kind":"math_inline","text":"F1(7) = f(g(7)) = f(f(7) + f(1)) = f(6 + 1) = f(7) = 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"776E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/776/problem/E"}