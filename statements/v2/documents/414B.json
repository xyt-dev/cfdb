{"assets":["/statement-assets/14511fcbfb38a0637916970b9e67ce6d6ded916cfab05c650d7e26e5a5381f03.png"],"contentKind":"statement","contestId":"414","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mashmokh and ACM"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Mashmokh's boss, Bimokh, didn't like Mashmokh. So he fired him. Mashmokh decided to go to university and participate in ACM instead of finding a new job. He wants to become a member of Bamokh's team. In order to join he was given some programming tasks and one week to solve them. Mashmokh is not a very experienced programmer. Actually he is not a programmer at all. So he wasn't able to solve them. That's why he asked you to help him with these tasks. One of these tasks is the following."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence of "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bl"},{"kind":"math_inline","text":"(1 ≤ b1 ≤ b2 ≤ ... ≤ bl ≤ n)"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if each number divides (without a remainder) by the next number in the sequence. More formally "},{"attrs":{"alt":"","src":"/statement-assets/14511fcbfb38a0637916970b9e67ce6d6ded916cfab05c650d7e26e5a5381f03.png"},"kind":"image"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ l - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" find the number of good sequences of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". As the answer can be rather large print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n, k (1 ≤ n, k ≤ 2000)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of good sequences of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"39\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the good sequences are: "},{"kind":"math_inline","text":"[1, 1], [2, 2], [3, 3], [1, 2], [1, 3]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"414B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/414/problem/B"}