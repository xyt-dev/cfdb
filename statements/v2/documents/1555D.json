{"assets":[],"contentKind":"statement","contestId":"1555","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Say No to Palindromes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call the string "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if it does not contain a substring of length at least $$$2$$$, which is a palindrome. Recall that a palindrome is a string that reads the same way from the first character to the last and from the last character to the first. For example, the strings "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bab"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"acca"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bcabcbacb"}],"kind":"container"},{"kind":"text","text":" are palindromes, but the strings "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"abbbaa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cccb"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of a string as the minimum number of operations so that the string becomes beautiful, if in one operation it is allowed to change any character of the string to one of the first $$$3$$$ letters of the Latin alphabet (in lowercase)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$, each character of the string is one of the first $$$3$$$ letters of the Latin alphabet (in lowercase)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$m$$$ queries — calculate the cost of the substring of the string $$$s$$$ from $$$l_i$$$-th to $$$r_i$$$-th position, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 2 \\cdot 10^5$$$) — the length of the string $$$s$$$ and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$, it consists of $$$n$$$ characters, each character one of the first $$$3$$$ Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$m$$$ lines contain two integers $$$l_i$$$ and $$$r_i$$$ ($$$1 \\le l_i \\le r_i \\le n$$$) — parameters of the $$$i$$$-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print a single integer — the cost of the substring of the string $$$s$$$ from $$$l_i$$$-th to $$$r_i$$$-th position, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 4\nbaacb\n1 3\n1 5\n4 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the queries of the example test."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in the first query, the substring is "},{"children":[{"kind":"text","text":"baa"}],"kind":"container"},{"kind":"text","text":", which can be changed to "},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":" in one operation; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the second query, the substring is "},{"children":[{"kind":"text","text":"baacb"}],"kind":"container"},{"kind":"text","text":", which can be changed to "},{"children":[{"kind":"text","text":"cbacb"}],"kind":"container"},{"kind":"text","text":" in two operations; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the third query, the substring is "},{"children":[{"kind":"text","text":"cb"}],"kind":"container"},{"kind":"text","text":", which can be left unchanged; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the fourth query, the substring is "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":", which can be changed to "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":" in one operation. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1555D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1555/problem/D"}