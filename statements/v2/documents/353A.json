{"assets":[],"contentKind":"statement","contestId":"353","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Domino"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera has got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" domino pieces in a row. Each piece consists of two halves — the upper one and the lower one. Each of the halves contains a number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". Valera loves even integers very much, so he wants the sum of the numbers on the upper halves and the sum of the numbers on the lower halves to be even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do that, Valera can rotate the dominoes by "},{"kind":"math_inline","text":"180"},{"kind":"text","text":" degrees. After the rotation the upper and the lower halves swap places. This action takes one second. Help Valera find out the minimum time he must spend rotating dominoes to make his wish come true."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":", denoting the number of dominoes Valera has. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two space-separated integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ 6)"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is initially written on the upper half of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino, "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" is initially written on the lower half."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum required number of seconds. If Valera can't do the task in any time, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 2\n6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 4\n2 3\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case the sum of the numbers on the upper halves equals "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" and the sum of the numbers on the lower halves equals "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". Both numbers are even, so Valera doesn't required to do anything."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Valera has only one piece of domino. It is written "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" on the one of its halves, therefore one of the sums will always be odd."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third case Valera can rotate the first piece, and after that the sum on the upper halves will be equal to "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", and the sum on the lower halves will be equal to "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"353A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/353/problem/A"}