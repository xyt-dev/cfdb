{"assets":["/statement-assets/98d633f3e4c4b219e2ecd183a937e9bd319a8f002852b56a02e519a888723c55.png","/statement-assets/8f9a7c94d810ac7d5a06a2d87b6424ef375c8d795ff9855325c37ba24e00e404.png"],"contentKind":"statement","contestId":"300","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Empire Strikes Back"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a far away galaxy there is war again. The treacherous Republic made "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" precision strikes of power "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" on the Empire possessions. To cope with the republican threat, the Supreme Council decided to deal a decisive blow to the enemy forces. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To successfully complete the conflict, the confrontation balance after the blow should be a positive integer. The balance of confrontation is a number that looks like "},{"attrs":{"alt":"","src":"/statement-assets/98d633f3e4c4b219e2ecd183a937e9bd319a8f002852b56a02e519a888723c55.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p = n!"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the power of the Imperial strike), "},{"attrs":{"alt":"","src":"/statement-assets/8f9a7c94d810ac7d5a06a2d87b6424ef375c8d795ff9855325c37ba24e00e404.png"},"kind":"image"},{"kind":"text","text":". After many years of war the Empire's resources are low. So to reduce the costs, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" should be a minimum positive integer that is approved by the commanders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the Empire, find the minimum positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where the described fraction is a positive integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 106)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 107)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", needed for the Empire to win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" to read or write 64-but integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1000 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2000"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"300E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/300/problem/E"}