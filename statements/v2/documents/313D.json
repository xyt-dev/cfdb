{"assets":[],"contentKind":"statement","contestId":"313","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ilya and Roads"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Everything is great about Ilya's city, except the roads. The thing is, the only ZooVille road is represented as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" holes in a row. We will consider the holes numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ilya is really keep on helping his city. So, he wants to fix at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" holes (perharps he can fix more) on a single ZooVille road. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The city has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" building companies, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th company needs "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" money units to fix a road segment containing holes with numbers of at least "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and at most "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". The companies in ZooVille are very greedy, so, if they fix a segment containing some already fixed holes, they do not decrease the price for fixing the segment. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum money Ilya will need to fix at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" holes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 300, 1 ≤ m ≤ 105, 1 ≤ k ≤ n)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the companies' description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three integers "},{"kind":"math_inline","text":"li, ri, ci"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n, 1 ≤ ci ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum money Ilya needs to fix at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" holes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to fix at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" holes, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4 6\n7 9 11\n6 9 13\n7 7 7\n3 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 7 1\n3 4 15\n8 9 8\n5 6 8\n9 10 6\n1 4 2\n1 4 10\n8 10 13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1 9\n5 10 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"313D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/313/problem/D"}