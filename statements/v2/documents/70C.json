{"assets":[],"contentKind":"statement","contestId":"70","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Lucky Tickets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Walrusland public transport tickets are characterized by two integers: by the number of the series and by the number of the ticket in the series. Let the series number be represented by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the ticket number — by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then a ticket is described by the ordered pair of numbers "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The walruses believe that a ticket is lucky if "},{"kind":"math_inline","text":"a * b = rev(a) * rev(b)"},{"kind":"text","text":". The function "},{"kind":"math_inline","text":"rev(x)"},{"kind":"text","text":" reverses a number written in the decimal system, at that the leading zeroes disappear. For example, "},{"kind":"math_inline","text":"rev(12343) = 34321"},{"kind":"text","text":", "},{"kind":"math_inline","text":"rev(1200) = 21"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Public Transport Management Committee wants to release "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" series, each containing "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" tickets, so that "},{"children":[{"kind":"text","text":"at"}],"kind":"container"},{"children":[{"kind":"text","text":"least"}],"kind":"container"},{"kind":"math_inline","text":"w"},{"kind":"text","text":" lucky tickets were released and the total number of released tickets ("},{"kind":"math_inline","text":"x * y"},{"kind":"text","text":") were minimum. The series are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" inclusive. The tickets in each series are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" inclusive. The Transport Committee cannot release more than "},{"kind":"math_inline","text":"maxx"},{"kind":"text","text":" series and more than "},{"kind":"math_inline","text":"maxy"},{"kind":"text","text":" tickets in one series."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"maxx"},{"kind":"text","text":", "},{"kind":"math_inline","text":"maxy"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ maxx, maxy ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w ≤ 107"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on a single line two space-separated numbers, the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". If there are several possible variants, print any of them. If such "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" do not exist, print a single number "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"132 10 35\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 18 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"48 132 235\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22 111"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"70C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/70/problem/C"}