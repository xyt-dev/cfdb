{"assets":[],"contentKind":"statement","contestId":"1682","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Palindromic Indices"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"},{"kind":"text","text":" string $$$s$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to count the number of indices $$$i$$$ $$$(1 \\le i \\le n)$$$ such that the string after removing $$$s_i$$$ from $$$s$$$ still remains a palindrome. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, consider $$$s$$$ = \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\""}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If we remove $$$s_1$$$ from $$$s$$$, the string becomes \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\" which is not a palindrome. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If we remove $$$s_2$$$ from $$$s$$$, the string becomes \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" which is a palindrome. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If we remove $$$s_3$$$ from $$$s$$$, the string becomes \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" which is not a palindrome. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A palindrome is a string that reads the same backward as forward. For example, \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"fef"}],"kind":"container"},{"kind":"text","text":"\" are palindromes whereas \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acd"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"xy"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line of the input contains a single integer $$$t$$$ $$$(1 \\leq t \\leq 10^3)$$$  — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains a single integer $$$n$$$ $$$(2 \\leq n \\leq 10^5)$$$  — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ consisting of lowercase English letters. "},{"children":[{"kind":"text","text":"It is guaranteed that $$$s$$$ is a palindrome"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer  — the number of indices $$$i$$$ $$$(1 \\le i \\le n)$$$ such that the string after removing $$$s_i$$$ from $$$s$$$ still remains a palindrome. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3\naba\n8\nacaaaaca\n2\ndd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the indices $$$i$$$ that result in palindrome after removing $$$s_i$$$ are $$$3, 4, 5, 6$$$. Hence the answer is $$$4$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, removal of any of the indices results in \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\" which is a palindrome. Hence the answer is $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1682A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1682/problem/A"}