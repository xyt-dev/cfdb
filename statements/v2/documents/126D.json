{"assets":["/statement-assets/aa89e5d04b3fe879cf6a596aeafc754a07a2c821850ac5116ed0431f3089f7d6.png"],"contentKind":"statement","contestId":"126","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Fibonacci Sums"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fibonacci numbers have the following form:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"F1 = 1, "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"F2 = 2, "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"Fi = Fi - 1 + Fi - 2, i > 2."}],"kind":"container"},{"children":[{"kind":"text","text":"Let's consider some non-empty set "},{"kind":"math_inline","text":"S = {s1, s2, ..., sk}"},{"kind":"text","text":", consisting of "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" Fibonacci numbers. Let's find the sum of values of this set's elements:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aa89e5d04b3fe879cf6a596aeafc754a07a2c821850ac5116ed0431f3089f7d6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's call the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" a number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"'s "},{"children":[{"kind":"text","text":"decomposition into Fibonacci sum"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to see that several numbers have several decompositions into Fibonacci sum. For example, for "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" we have "},{"kind":"math_inline","text":"13, 5 + 8, 2 + 3 + 8"},{"kind":"text","text":" — three decompositions, and for "},{"kind":"math_inline","text":"16"},{"kind":"text","text":": "},{"kind":"math_inline","text":"3 + 13, 1 + 2 + 13, 3 + 5 + 8, 1 + 2 + 5 + 8"},{"kind":"text","text":" — four decompositions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By the given number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" determine the number of its possible different decompositions into Fibonacci sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the number of tests ("},{"kind":"math_inline","text":"1 ≤ t ≤ 105"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains one test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test is an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each input data test print a single number on a single line — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n13\n16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Two decompositions are different if there exists a number that is contained in the first decomposition, but is not contained in the second one. Decompositions that differ only in the order of summands are considered equal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"126D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/126/problem/D"}