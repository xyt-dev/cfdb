{"assets":[],"contentKind":"statement","contestId":"196","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The Next Good String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In problems on strings one often has to find a string with some particular properties. The problem authors were reluctant to waste time on thinking of a name for some string so they called it "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":". A string is good if it doesn't have palindrome substrings longer than or equal to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting only of lowercase English letters. Find a good string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" with length "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":", consisting of lowercase English letters, which is lexicographically larger than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Of all such strings string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" must be lexicographically minimum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will call a non-empty string "},{"kind":"math_inline","text":"s[a ... b] = sasa + 1... sb"},{"kind":"math_inline","text":"(1 ≤ a ≤ b ≤ |s|)"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s = s1s2... s|s|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A non-empty string "},{"kind":"math_inline","text":"s = s1s2... sn"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"a palindrome"}],"kind":"container"},{"kind":"text","text":" if for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the following fulfills: "},{"kind":"math_inline","text":"si = sn - i + 1"},{"kind":"text","text":". In other words, palindrome read the same in both directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"x = x1x2... x|x|"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"lexicographically larger"}],"kind":"container"},{"kind":"text","text":" than string "},{"kind":"math_inline","text":"y = y1y2... y|y|"},{"kind":"text","text":", if either "},{"kind":"math_inline","text":"|x| > |y|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , x|y| = y|y|"},{"kind":"text","text":", or there exists such number "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(r < |x|, r < |y|)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xr = yr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xr + 1 > yr + 1"},{"kind":"text","text":". Characters in such strings are compared like their ASCII codes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d ≤ |s|"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", its length is no more than "},{"kind":"math_inline","text":"4·105"},{"kind":"text","text":" characters. The string consists of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the good string that lexicographically follows "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", has the same length and consists of only lowercase English letters. If such string does not exist, print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\naaaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aabbcaa\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nzzyzzzz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":