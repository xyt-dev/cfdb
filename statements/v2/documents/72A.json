{"assets":["/statement-assets/3edde272a7f0e915c405b09e0dfa461ddb4f4bae3857095b012edda28b6d8251.png"],"contentKind":"statement","contestId":"72","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Goshtasp, Vishtasp and Eidi"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Goshtasp was known to be a good programmer in his school. One day Vishtasp, Goshtasp's friend, asked him to solve this task:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Given a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", you should determine whether "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is rich."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is rich, if there exists some set of distinct numbers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/3edde272a7f0e915c405b09e0dfa461ddb4f4bae3857095b012edda28b6d8251.png"},"kind":"image"},{"kind":"text","text":". In addition: every "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" should be either a prime number, or equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vishtasp said that he would share his Eidi "},{"kind":"math_inline","text":"50 / 50"},{"kind":"text","text":" with Goshtasp, if he could solve the task. Eidi is money given to children for Noruz by their parents and/or relatives."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Goshtasp needs to solve this problem to get money, you need to solve it to get score!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input contains a single positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the number is not rich print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Otherwise print the numbers "},{"kind":"math_inline","text":"a1, ..., am"},{"kind":"text","text":". If several solutions exist print the lexicographically "},{"children":[{"kind":"text","text":"latest"}],"kind":"container"},{"kind":"text","text":" solution. Answers are compared as sequences of numbers, not as strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For comparing two sequences "},{"kind":"math_inline","text":"a1, ..., am"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, ..., bn"},{"kind":"text","text":" we first find the first index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"ai < bi"},{"kind":"text","text":" then "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically earlier and if "},{"kind":"math_inline","text":"bi < ai"},{"kind":"text","text":" then "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is lexicographically earlier. If "},{"kind":"math_inline","text":"m ≠ n"},{"kind":"text","text":" we add zeroes at the end of the smaller sequence (only for the moment of comparison) and then perform the comparison."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You do not need to minimize the number of elements in sequence (i.e. "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"). You just need to print the lexicographically "},{"children":[{"kind":"text","text":"latest"}],"kind":"container"},{"kind":"text","text":" solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See samples to find out how to print the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11=11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"545\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"541+3+1=545\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"72A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/72/problem/A"}