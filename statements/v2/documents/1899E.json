{"assets":[],"contentKind":"statement","contestId":"1899","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Queue Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vlad found an array $$$a$$$ of $$$n$$$ integers and decided to sort it in non-decreasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do this, Vlad can apply the following operation any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Extract the first element of the array and insert it at the end; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap "},{"children":[{"kind":"text","text":"that"}],"kind":"container"},{"kind":"text","text":" element with the previous one until it becomes the first or until it becomes "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" greater than the previous one. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that both actions are part of the operation, and for one operation, you "},{"children":[{"kind":"text","text":"must"}],"kind":"container"},{"kind":"text","text":" apply both actions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if you apply the operation to the array [$$$4, 3, 1, 2, 6, 4$$$], it will change as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" [$$$\\color{red}{4}, 3, 1, 2, 6, 4$$$];"}],"kind":"list_item"},{"children":[{"kind":"text","text":" [$$$3, 1, 2, 6, 4, \\color{red}{4}$$$];"}],"kind":"list_item"},{"children":[{"kind":"text","text":" [$$$3, 1, 2, 6, \\color{red}{4}, 4$$$];"}],"kind":"list_item"},{"children":[{"kind":"text","text":" [$$$3, 1, 2, \\color{red}{4}, 6, 4$$$]."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Vlad doesn't have time to perform all the operations, so he asks you to determine the minimum number of operations required to sort the array or report that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, a_3, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all testcases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations needed to sort the array. If it is impossible to do so, output $$$-1$$$ as the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\n6 4 1 2 5\n7\n4 5 3 7 8 6 2\n6\n4 3 1 2 6 4\n4\n5 2 4 2\n3\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n6\n-1\n-1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1899E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1899/problem/E"}