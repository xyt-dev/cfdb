{"assets":[],"contentKind":"statement","contestId":"534","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Polycarpus' Dice"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" dice "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th dice shows numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". Polycarp rolled all the dice and the sum of numbers they showed is "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Agrippina didn't see which dice showed what number, she knows only the sum "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and the values "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":". However, she finds it enough to make a series of statements of the following type: dice "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" couldn't show number "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". For example, if Polycarp had two six-faced dice and the total sum is "},{"kind":"math_inline","text":"A = 11"},{"kind":"text","text":", then Agrippina can state that each of the two dice couldn't show a value less than five (otherwise, the remaining dice must have a value of at least seven, which is impossible)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each dice find the number of values for which it can be guaranteed that the dice couldn't show these values if the sum of the shown values is "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, A"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105, n ≤ A ≤ s"},{"kind":"text","text":") — the number of dice and the sum of shown values where "},{"kind":"math_inline","text":"s = d1 + d2 + ... + dn"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ 106"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is the maximum value that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th dice can show."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the number of values for which it is guaranteed that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th dice couldn't show them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 8\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample from the statement "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" equal to 8 could be obtained in the only case when both the first and the second dice show 4. Correspondingly, both dice couldn't show values 1, 2 or 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample from the statement "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" equal to 3 could be obtained when the single dice shows 3. Correspondingly, it couldn't show 1, 2, 4 or 5."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample from the statement "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" equal to 3 could be obtained when one dice shows 1 and the other dice shows 2. That's why the first dice doesn't have any values it couldn't show and the second dice couldn't show 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"534C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/534/problem/C"}