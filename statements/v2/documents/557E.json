":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abbbaa"}],"kind":"container"},{"kind":"text","text":"\" are half-palindromes and strings \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"aaabaa"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ann knows that on the exam she will get string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting only of letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", and number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". To get an excellent mark she has to find the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th in the lexicographical order string among all substrings of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that are half-palyndromes. Note that each substring in this order is considered as many times as many times it occurs in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teachers guarantees that the given number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" doesn't exceed the number of substrings of the given string that are half-palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you cope with this problem?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"at