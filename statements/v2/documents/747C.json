{"assets":[],"contentKind":"statement","contestId":"747","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Servers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" servers in a laboratory, each of them can perform tasks. Each server has a unique id — integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that during the day "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" tasks will come, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is characterized with three integers: "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the moment in seconds in which the task will come, "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" — the number of servers needed to perform it, and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — the time needed to perform this task in seconds. All "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To perform the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task you need "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" servers which are unoccupied in the second "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". After the servers begin to perform the task, each of them will be busy over the next "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" seconds. Thus, they will be busy in seconds "},{"kind":"math_inline","text":"ti, ti + 1, ..., ti + di - 1"},{"kind":"text","text":". For performing the task, "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" servers with the smallest ids will be chosen from all the unoccupied servers. If in the second "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" there are not enough unoccupied servers, the task is ignored."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write the program that determines which tasks will be performed and which will be ignored."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — the number of servers and the number of tasks. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains three integers each, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ki ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ di ≤ 1000"},{"kind":"text","text":") — the moment in seconds in which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task will come, the number of servers needed to perform it, and the time needed to perform this task in seconds. The tasks are given in a chronological order and they will come in distinct seconds. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task will be performed by the servers, print in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line the sum of servers' ids on which this task will be performed. Otherwise, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 3 2\n2 2 1\n3 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n-1\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n3 2 3\n5 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6\n1 3 20\n4 2 1\n6 5 5\n10 1 1\n15 3 6\n21 8 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n9\n30\n-1\n15\n36\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example in the second "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" the first task will come, it will be performed on the servers with ids "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (the sum of the ids equals "},{"kind":"math_inline","text":"6"},{"kind":"text","text":") during two seconds. In the second "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" the second task will come, it will be ignored, because only the server "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" will be unoccupied at that second. In the second "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" the third task will come. By this time, servers with the ids "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" will be unoccupied again, so the third task will be done on all the servers with the ids "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" (the sum of the ids is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example in the second "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" the first task will come, it will be performed on the servers with ids "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" (the sum of the ids is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":") during three seconds. In the second "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" the second task will come, it will be performed on the server "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", because the first two servers will be busy performing the first task."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"747C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/747/problem/C"}