{"assets":[],"contentKind":"statement","contestId":"1684","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Hard Cut"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$. You have to cut it into any number of non-intersecting substrings, so that the sum of binary integers denoted by these substrings is a power of 2. Each element of $$$s$$$ should be in exactly one substring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^5$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains a binary string $$$s$$$ ($$$1 \\le |s| \\le 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|s|$$$ over all test cases does not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output the answer to the problem as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the answer does not exist, output $$$-1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the answer exists, firstly output an integer $$$k$$$ — the number of substrings in the answer. After that output $$$k$$$ non-intersecting substrings, for $$$i$$$-th substring output two integers $$$l_i, r_i$$$ ($$$1 \\le l_i, r_i \\le |s|$$$) — the description of $$$i$$$-th substring. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple valid solutions, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n00000\n01101\n0111011001011\n000111100111110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n\n3\n1 3\n4 4\n5 5\n\n8\n1 2\n3 3\n4 4\n5 6\n7 7\n8 10\n11 12\n13 13\n\n5\n1 5\n6 7\n8 11\n12 14\n15 15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case it is impossible to cut the string into substrings, so that the sum is a power of 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case such cut is valid: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$011_2 = 3_{10}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0_2 = 0_{10}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1_2 = 1_{10}$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" $$$3 + 0 + 1 = 4$$$, $$$4$$$ is a power of 2."}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1684H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1684/problem/H"}