{"assets":["/statement-assets/0c4e85ea5431365e33ee690b00223ff912ea80883234cf76cd183b6ec60bbe02.png"],"contentKind":"statement","contestId":"788","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Functions again"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Something happened in Uzhlyandia again... There are riots on the streets... Famous Uzhlyandian superheroes Shean the Sheep and Stas the Giraffe were called in order to save the situation. Upon the arriving, they found that citizens are worried about maximum values of the Main Uzhlyandian Function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":", which is defined as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0c4e85ea5431365e33ee690b00223ff912ea80883234cf76cd183b6ec60bbe02.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the above formula, "},{"kind":"math_inline","text":"1 ≤ l < r ≤ n"},{"kind":"text","text":" must hold, where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the size of the Main Uzhlyandian Array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":" means absolute value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". But the heroes skipped their math lessons in school, so they asked you for help. Help them calculate the maximum value of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" among all possible values of "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" for the given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the size of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" (-"},{"kind":"math_inline","text":"109 ≤ ai ≤ 109"},{"kind":"text","text":") — the array elements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the maximum value of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 4 2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 5 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, the optimal value of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is reached on intervals "},{"kind":"math_inline","text":"[1, 2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[2, 5]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case maximal value of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is reachable only on the whole array."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"788A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/788/problem/A"}