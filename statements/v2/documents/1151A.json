{"assets":[],"contentKind":"statement","contestId":"1151","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Maxim and Biology"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today in the scientific lyceum of the Kingdom of Kremland, there was a biology lesson. The topic of the lesson was the "},{"children":[{"kind":"text","text":"genomes"}],"kind":"container"},{"kind":"text","text":". Let's call the "},{"children":[{"kind":"text","text":"genome"}],"kind":"container"},{"kind":"text","text":" the string \""},{"children":[{"kind":"text","text":"ACTG"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maxim was very boring to sit in class, so the teacher came up with a task for him: on a given string $$$s$$$ consisting of uppercase letters and length of at least $$$4$$$, you need to find the minimum number of "},{"children":[{"kind":"text","text":"operations"}],"kind":"container"},{"kind":"text","text":" that you need to apply, so that the "},{"children":[{"kind":"text","text":"genome"}],"kind":"container"},{"kind":"text","text":" appears in it as a substring. For one "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"text","text":", you can replace any letter in the string $$$s$$$ with the next or previous in the alphabet. For example, for the letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" the previous one will be \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\", and the next — \""},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"\". In this problem, we assume that for the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", the previous one will be the letter \""},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"\", and the next one will be \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", and for the letter \""},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"\", the previous one is the letter \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\", and the next one is the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Maxim solve the problem that the teacher gave him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a substring of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$4 \\leq n \\leq 50$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$, consisting of exactly $$$n$$$ uppercase letters of the Latin alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum number of "},{"children":[{"kind":"text","text":"operations"}],"kind":"container"},{"kind":"text","text":" that need to be applied to the string $$$s$$$ so that the "},{"children":[{"kind":"text","text":"genome"}],"kind":"container"},{"kind":"text","text":" appears as a substring in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nZCTH\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nZDATG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nAFBAKC\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n16"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you should replace the letter \""},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"\" with \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" for one "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"text","text":", the letter \""},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"\" — with the letter \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" for one "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"text","text":". You will get the string \""},{"children":[{"kind":"text","text":"ACTG"}],"kind":"container"},{"kind":"text","text":"\", in which the "},{"children":[{"kind":"text","text":"genome"}],"kind":"container"},{"kind":"text","text":" is present as a substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, we replace the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" with \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\" for two "},{"children":[{"kind":"text","text":"operations"}],"kind":"container"},{"kind":"text","text":", the letter \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" — with the letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" for three "},{"children":[{"kind":"text","text":"operations"}],"kind":"container"},{"kind":"text","text":". You will get the string \""},{"children":[{"kind":"text","text":"ZACTG"}],"kind":"container"},{"kind":"text","text":"\", in which there is a "},{"children":[{"kind":"text","text":"genome"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1151A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1151/problem/A"}