{"assets":[],"contentKind":"statement","contestId":"862","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mahmoud and Ehab and the MEX"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dr. Evil kidnapped Mahmoud and Ehab in the evil land because of their performance in the Evil Olympiad in Informatics (EOI). He decided to give them some problems to let them go."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Evil is interested in sets, He has a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. Dr. Evil calls a set of integers "},{"children":[{"kind":"text","text":"evil"}],"kind":"container"},{"kind":"text","text":" if the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of it is exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of a set of integers is the minimum non-negative integer that doesn't exist in it. For example, the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of the set "},{"kind":"math_inline","text":"{0, 2, 4}"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of the set "},{"kind":"math_inline","text":"{1, 2, 3}"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Evil is going to make his set "},{"children":[{"kind":"text","text":"evil"}],"kind":"container"},{"kind":"text","text":". To do this he can perform some operations. During each operation he can add some non-negative integer to his set or erase some element from it. What is the minimal number of operations Dr. Evil has to perform to make his set "},{"children":[{"kind":"text","text":"evil"}],"kind":"container"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x ≤ 100"},{"kind":"text","text":") — the size of the set Dr. Evil owns, and the desired "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct non-negative integers not exceeding "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" that represent the set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line should contain one integer — the minimal number of operations Dr. Evil should perform."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n0 4 5 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case Dr. Evil should add "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to the set performing "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case Dr. Evil should erase "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" from the set. After that, the set becomes empty, so the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of it is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case the set is already "},{"children":[{"kind":"text","text":"evil"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"862A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/862/problem/A"}