{"assets":[],"contentKind":"statement","contestId":"585","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Lizard Era: Beginning"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the game Lizard Era: Beginning the protagonist will travel with three companions: Lynn, Meliana and Worrigan. Overall the game has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mandatory quests. To perform each of them, you need to take "},{"children":[{"kind":"text","text":"exactly two"}],"kind":"container"},{"kind":"text","text":" companions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The attitude of each of the companions to the hero is an integer. Initially, the attitude of each of them to the hero of neutral and equal to 0. As the hero completes quests, he makes actions that change the attitude of the companions, whom he took to perform this task, in positive or negative direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tell us what companions the hero needs to choose to make their attitude equal after completing all the quests. If this can be done in several ways, choose the one in which the value of resulting attitude is greatest possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 25"},{"kind":"text","text":") — the number of important tasks. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the tasks — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three integers "},{"kind":"math_inline","text":"li, mi, wi"},{"kind":"text","text":" — the values by which the attitude of Lynn, Meliana and Worrigan respectively will change towards the hero if the hero takes them on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task. All the numbers in the input are integers and do not exceed "},{"kind":"math_inline","text":"107"},{"kind":"text","text":" in absolute value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution, print in the first line \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, two characters is each line — in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the first letters of the companions' names that hero should take to complete the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task ('"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' for Lynn, '"},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"' for Meliana, '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' for Worrigan). Print the letters in any order, if there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 0\n0 1 0\n0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LM\nMW\nMW\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n0 8 9\n5 9 -2\n6 -8 -7\n9 4 5\n-4 -9 9\n-4 5 2\n-6 8 -7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LM\nMW\nLM\nLW\nMW\nLM\nLW\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 0 0\n1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"585D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/585/problem/D"}