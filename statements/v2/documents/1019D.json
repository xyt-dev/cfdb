{"assets":[],"contentKind":"statement","contestId":"1019","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Large Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"There is a strange peculiarity: if you connect the cities of Rostov, Taganrog and Shakhty, peculiarly, you get a triangle"}],"kind":"container"},{"children":[{"kind":"text","text":"«Unbelievable But True»"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Students from many different parts of Russia and abroad come to Summer Informatics School. You marked the hometowns of the SIS participants on a map."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you decided to prepare an interesting infographic based on this map. The first thing you chose to do is to find three cities on this map, such that they form a triangle with area $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$ and $$$S$$$ ($$$3 \\le n \\le 2000$$$, $$$1 \\le S \\le 2 \\cdot 10^{18}$$$) — the number of cities on the map and the area of the triangle to be found."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain descriptions of the cities, one per line. Each city is described by its integer coordinates $$$x_i$$$, $$$y_i$$$ ($$$-10^9 \\le x_i, y_i \\le 10^9$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all cities are located at distinct points. It is also guaranteed that no three cities lie on the same line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the solution doesn't exist — print «"},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print «"},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"», followed by three pairs of coordinates $$$(x, y)$$$ — the locations of the three cities, which form the triangle of area $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7\n0 0\n3 0\n0 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n0 0\n2 0\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n0 0\n1 3\n2 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1019D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1019/problem/D"}