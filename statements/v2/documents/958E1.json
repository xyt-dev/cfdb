{"assets":[],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Guard Duty (easy)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Rebel fleet is afraid that the Empire might want to strike back again. Princess Heidi needs to know if it is possible to assign "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" Rebel spaceships to guard "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" bases so that every base has exactly one guardian and each spaceship has exactly one assigned base (in other words, the assignment is a perfect matching). Since she knows how reckless her pilots are, she wants to be sure that any two (straight) paths – from a base to its assigned spaceship – do not intersect in the galaxy plane (that is, in 2D), and so there is no risk of collision."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"R, B(1 ≤ R, B ≤ 10)"},{"kind":"text","text":". For "},{"kind":"math_inline","text":"1 ≤ i ≤ R"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xi|, |yi| ≤ 10000"},{"kind":"text","text":") denoting the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Rebel spaceship. The following "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" lines have the same format, denoting the position of bases. It is guaranteed that no two points coincide and that no three points are on the same line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to connect Rebel spaceships and bases so as satisfy the constraint, output "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":", otherwise output "},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":" (without quote)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n0 0\n2 0\n3 1\n-2 1\n0 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 0\n2 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, one possible way is to connect the Rebels and bases in order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second example, there is no perfect matching between Rebels and bases."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"958E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/958/problem/E1"}