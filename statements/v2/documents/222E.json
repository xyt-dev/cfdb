{"assets":[],"contentKind":"statement","contestId":"222","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Decoding Genome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently a top secret mission to Mars has taken place. As a result, scientists managed to obtain some information about the Martian DNA. Now we know that any Martian DNA contains at most "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" different nucleotides, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Special characteristics of the Martian DNA prevent some nucleotide pairs from following consecutively in this chain. For example, if the nucleotide 1 and nucleotide 2 can not follow consecutively in the Martian DNA, then the chain of nucleotides [1, 2] is not a valid chain of Martian DNA, but the chain of nucleotides [2, 1] can be a valid chain (if there is no corresponding restriction). The number of nucleotide pairs that can't follow in the DNA chain consecutively, is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The needs of gene research required information about the quantity of correct "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-long chains of the Martian DNA. Your task is to write a program that will calculate this value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1015"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 52"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ m2"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain two characters each, without a space between them, representing a forbidden nucleotide pair. The first character represents the first nucleotide in the forbidden pair, the second character represents the second nucleotide."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The nucleotides with assigned numbers from 1 to 26 are represented by English alphabet letters from \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" to \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\" (1 is an \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", 2 is a \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", 26 is a \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\"). Nucleotides with assigned numbers from 27 to 52 are represented by English alphabet letters from \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" to \""},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"\" (27 is an \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", 28 is a \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", 52 is a \""},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that each forbidden pair occurs at most once in the input. It is guaranteed that nucleotide's numbers in all forbidden pairs cannot be more than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Note that order is important in nucleotide pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the sought number modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\nab\nba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second test case all possible three-nucleotide DNAs are permitted. Each nucleotide can take one of three values, thus in total there are 27 distinct three nucleotide DNAs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test sample we cannot make any DNA of two nucleotides — the only possible nucleotide \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" cannot occur two times consecutively."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"222E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/222/problem/E"}