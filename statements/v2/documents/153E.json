{"assets":[],"contentKind":"statement","contestId":"153","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Euclidean Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a multiset of points on the plane with integer coordinates. Find the maximum distance between two points from this multiset."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the number of points "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 50"},{"kind":"text","text":"). Next, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of lines follow, each describing a single point: the first line contains "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinate, the second one — the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinate ("},{"kind":"math_inline","text":" - 50 ≤ x, y ≤ 50"},{"kind":"text","text":"). Some of the points can have identical coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum distance between two points from this multiset. The answer is considered to be correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0\n1\n2\n3\n4\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.656854249\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n10\n12\n-5\n8\n10\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15.5241747\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case the maximum distance is between points "},{"kind":"math_inline","text":"(0, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":". In the second case two of the points are the same, so the maximum distance is between one of them and the third point."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"153E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/153/problem/E"}