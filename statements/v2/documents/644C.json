{"assets":[],"contentKind":"statement","contestId":"644","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Hostname Aliases"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are some websites that are accessible through several different addresses. For example, for a long time Codeforces was accessible with two hostnames "},{"children":[{"kind":"text","text":"codeforces.com"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"codeforces.ru"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a list of page addresses being queried. For simplicity we consider all addresses to have the form "},{"children":[{"kind":"text","text":"http://<hostname>[/<path>]"}],"kind":"container"},{"kind":"text","text":", where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" — server name (consists of words and maybe some dots separating them), "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"/<path>"}],"kind":"container"},{"kind":"text","text":" — optional part, where <path> consists of words separated by slashes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We consider two "},{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" to correspond to one website if for each query to the first "},{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" there will be exactly the same query to the second one and vice versa — for each query to the second "},{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" there will be the same query to the first one. Take a look at the samples for further clarifications."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to determine the groups of server names that correspond to one website. Ignore groups consisting of the only server name."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note, that according to the above definition queries "},{"children":[{"kind":"text","text":"http://<hostname>"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"http://<hostname>/"}],"kind":"container"},{"kind":"text","text":" are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of page queries. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing exactly one address. Each address is of the form "},{"children":[{"kind":"text","text":"http://<hostname>[/<path>]"}],"kind":"container"},{"kind":"text","text":", where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" consists of lowercase English letters and dots, there are no two consecutive dots, "},{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" doesn't start or finish with a dot. The length of "},{"children":[{"kind":"text","text":"<hostname>"}],"kind":"container"},{"kind":"text","text":" is positive and doesn't exceed "},{"kind":"math_inline","text":"20"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"<path>"}],"kind":"container"},{"kind":"text","text":" consists of lowercase English letters, dots and slashes. There are no two consecutive slashes, "},{"children":[{"kind":"text","text":"<path>"}],"kind":"container"},{"kind":"text","text":" doesn't start with a slash and its length doesn't exceed "},{"kind":"math_inline","text":"20"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Addresses are not guaranteed to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of groups of server names that correspond to one website. You should count only groups of size greater than one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines should contain the description of groups, one group per line. For each group print all server names separated by a single space. You are allowed to print both groups and names inside any group in arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\nhttp://abacaba.ru/test\nhttp://abacaba.ru/\nhttp://abacaba.com\nhttp://abacaba.com/test\nhttp://abacaba.de/\nhttp://abacaba.ru/test\nhttp://abacaba.de/test\nhttp://abacaba.com/\nhttp://abacaba.com/t\nhttp://abacaba.com/test\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\nhttp://abacaba.de http://abacaba.ru \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"14\nhttp://c\nhttp://ccc.bbbb/aba..b\nhttp://cba.com\nhttp://a.c/aba..b/a\nhttp://abc/\nhttp://a.c/\nhttp://ccc.bbbb\nhttp://ab.ac.bc.aa/\nhttp://a.a.a/\nhttp://ccc.bbbb/\nhttp://cba.com/\nhttp://cba.com/aba..b\nhttp://a.a.a/aba..b/a\nhttp://abc/aba..b/a\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nhttp://cba.com http://ccc.bbbb \nhttp://a.a.a http://a.c http://abc \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"644C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/644/problem/C"}