{"assets":["/statement-assets/fe98b689bf77655d8cce9947bbb5ba8da832d17e3dfdc62122a5114ad5388e6f.png","/statement-assets/52365c3d3ef94951eb3e52b836f6778a4bff40b18fc367bf06581b504679d400.png","/statement-assets/55aa0b2351a12b604f24dca505271e1afd5ef94f54677e518192c5cdfba02ea1.png","/statement-assets/af1bfb0240a890a17ee7006c0806b050322846ae1f85b5b9efd879645ddefd86.png","/statement-assets/b4ff129c5fe3bf019f441d0e486105bfe7204eba8cef24d5391fb87a971ec42c.png","/statement-assets/fd36d70d94e6449c0edfafbc3379b53214717346cfa7bbc356bf3e70c010783d.png","/statement-assets/502d06dc5ed3cd802f0d2c9da79e86a9649187c366bb84aeca8ed2d93cde3489.png","/statement-assets/ec0be87507d5ed8bb2073404782a0e19cd25f9c30c71f95eae17e0df912fc6be.png"],"contentKind":"statement","contestId":"983","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Elevator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You work in a big office. It is a "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" floor building with an elevator that can accommodate up to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" people. It is your responsibility to manage this elevator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today you are late, so there are queues on some floors already. For each person you know the floor where he currently is and the floor he wants to reach. Also, you know the order in which people came to the elevator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"According to the company's rules, if an employee comes to the elevator earlier than another one, he has to enter the elevator earlier too (even if these employees stay on different floors). Note that the employees are allowed to leave the elevator in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The elevator has two commands: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Go up or down one floor. The movement takes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Open the doors on the current floor. During this operation all the employees who have reached their destination get out of the elevator. Then all the employees on the floor get in the elevator in the order they are queued up while it doesn't contradict the company's rules and there is enough space in the elevator. Each employee spends "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second to get inside and outside the elevator. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially the elevator is empty and is located on the floor "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are interested what is the minimum possible time you need to spend to deliver all the employees to their destination. It is not necessary to return the elevator to the floor "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":") — the number of employees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 9"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — the floor on which an employee initially is, and the floor he wants to reach."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The employees are given in the order they came to the elevator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimal possible time in seconds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 5\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 3\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":" Explaination for the first sample "},{"attrs":{"alt":"","src":"/statement-assets/fe98b689bf77655d8cce9947bbb5ba8da832d17e3dfdc62122a5114ad5388e6f.png"},"kind":"image"},{"kind":"math_inline","text":"t = 0"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/52365c3d3ef94951eb3e52b836f6778a4bff40b18fc367bf06581b504679d400.png"},"kind":"image"},{"kind":"math_inline","text":"t = 2"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/55aa0b2351a12b604f24dca505271e1afd5ef94f54677e518192c5cdfba02ea1.png"},"kind":"image"},{"kind":"math_inline","text":"t = 3"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/af1bfb0240a890a17ee7006c0806b050322846ae1f85b5b9efd879645ddefd86.png"},"kind":"image"},{"kind":"math_inline","text":"t = 5"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b4ff129c5fe3bf019f441d0e486105bfe7204eba8cef24d5391fb87a971ec42c.png"},"kind":"image"},{"kind":"math_inline","text":"t = 6"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fd36d70d94e6449c0edfafbc3379b53214717346cfa7bbc356bf3e70c010783d.png"},"kind":"image"},{"kind":"math_inline","text":"t = 7"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/502d06dc5ed3cd802f0d2c9da79e86a9649187c366bb84aeca8ed2d93cde3489.png"},"kind":"image"},{"kind":"math_inline","text":"t = 9"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ec0be87507d5ed8bb2073404782a0e19cd25f9c30c71f95eae17e0df912fc6be.png"},"kind":"image"},{"kind":"math_inline","text":"t = 10"}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"983C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/983/problem/C"}