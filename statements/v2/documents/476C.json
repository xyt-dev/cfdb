{"assets":["/statement-assets/37e938db62eabb224141656950cbaec9febbfdf5277e23ccd15431c30c9ce0fb.png","/statement-assets/51890962369abff57446313c3fb628263fc42ad03131c89258f26cb24ee9d9cc.png","/statement-assets/3baa8fb6d492d980ef71f4d88b62dfa69026667bfd9dac9a366b7cba78fdc799.png","/statement-assets/df4bc8dc0b5d5bdea56a0bbeda8d5de16f0571e3acb21a6c94f7102254ec46d0.png","/statement-assets/d077da8f434102e99cf39304146347fc78203c2fefccad7933d779e0e3808152.png"],"contentKind":"statement","contestId":"476","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dreamoon and Sums"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dreamoon loves summing up something for no reason. One day he obtains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" occasionally. He wants to calculate the sum of all "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" integers. Positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" if "},{"attrs":{"alt":"","src":"/statement-assets/37e938db62eabb224141656950cbaec9febbfdf5277e23ccd15431c30c9ce0fb.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/51890962369abff57446313c3fb628263fc42ad03131c89258f26cb24ee9d9cc.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is some "},{"children":[{"kind":"text","text":"integer"}],"kind":"container"},{"kind":"text","text":" number in range "},{"kind":"math_inline","text":"[1, a]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By "},{"attrs":{"alt":"","src":"/statement-assets/3baa8fb6d492d980ef71f4d88b62dfa69026667bfd9dac9a366b7cba78fdc799.png"},"kind":"image"},{"kind":"text","text":" we denote the "},{"children":[{"kind":"text","text":"quotient"}],"kind":"container"},{"kind":"text","text":" of integer division of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". By "},{"attrs":{"alt":"","src":"/statement-assets/df4bc8dc0b5d5bdea56a0bbeda8d5de16f0571e3acb21a6c94f7102254ec46d0.png"},"kind":"image"},{"kind":"text","text":" we denote the "},{"children":[{"kind":"text","text":"remainder"}],"kind":"container"},{"kind":"text","text":" of integer division of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". You can read more about these operations here: "},{"children":[{"kind":"text","text":"http://goo.gl/AcsXhT"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer may be large, so please print its remainder modulo "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). Can you compute it faster than Dreamoon?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 107"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer representing the answer modulo "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, there are no nice integers because "},{"attrs":{"alt":"","src":"/statement-assets/d077da8f434102e99cf39304146347fc78203c2fefccad7933d779e0e3808152.png"},"kind":"image"},{"kind":"text","text":" is always zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, the set of nice integers is "},{"kind":"math_inline","text":"{3, 5}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"476C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/476/problem/C"}