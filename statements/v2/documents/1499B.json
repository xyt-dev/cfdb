{"assets":[],"contentKind":"statement","contestId":"1499","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Binary Removals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting only of characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'. Let $$$|s|$$$ be the length of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked to choose some integer $$$k$$$ ($$$k \\gt 0$$$) and find a sequence $$$a$$$ of length $$$k$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le a_1 \\lt a_2 \\lt \\dots \\lt a_k \\le |s|$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_{i-1} + 1 \\lt a_i$$$ for all $$$i$$$ from $$$2$$$ to $$$k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The characters at positions $$$a_1, a_2, \\dots, a_k$$$ are removed, the remaining characters are concatenated without changing the order. So, in other words, the positions in the sequence $$$a$$$ should not be adjacent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the resulting string be $$$s'$$$. $$$s'$$$ is called sorted if for all $$$i$$$ from $$$2$$$ to $$$|s'|$$$ $$$s'_{i-1} \\le s'_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Does there exist such a sequence $$$a$$$ that the resulting string $$$s'$$$ is sorted?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the descriptions of $$$t$$$ testcases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each testcase contains a string $$$s$$$ ($$$2 \\le |s| \\le 100$$$). Each character is either '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there exists a sequence $$$a$$$ such that removing the characters at positions $$$a_1, a_2, \\dots, a_k$$$ and concatenating the parts without changing the order produces a sorted string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print every letter in any case you want (so, for example, the strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" are all recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n10101011011\n0000\n11111\n110\n1100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase you can choose a sequence $$$a=[1,3,6,9]$$$. Removing the underlined letters from \""},{"children":[{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"11"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\" will produce a string \""},{"children":[{"kind":"text","text":"0011111"}],"kind":"container"},{"kind":"text","text":"\", which is sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and the third testcases the sequences are already sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth testcase you can choose a sequence $$$a=[3]$$$. $$$s'=$$$ \""},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\", which is sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth testcase there is no way to choose a sequence $$$a$$$ such that $$$s'$$$ is sorted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1499B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1499/problem/B"}