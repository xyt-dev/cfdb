{"assets":["/statement-assets/6db1f8e13078c9aef5465bf34d29097e59dba21b9d829eb4117bada70e246e77.png","/statement-assets/bd2c16b06439159871218495442e8474a6e45249677d7c9484039a51e29b2925.png"],"contentKind":"statement","contestId":"546","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Soldier and Cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two bored soldiers are playing card war. Their card deck consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"all values are different"}],"kind":"container"},{"kind":"text","text":". They divide cards between them in some manner, it's possible that they have different number of cards. Then they play a \"war\"-like card game. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rules are following. On each turn a "},{"children":[{"kind":"text","text":"fight"}],"kind":"container"},{"kind":"text","text":" happens. Each of them picks card from the top of his stack and puts on the table. The one whose card value is bigger wins this "},{"children":[{"kind":"text","text":"fight"}],"kind":"container"},{"kind":"text","text":" and takes both cards from the table to the bottom of his stack. More precisely, he first takes his opponent's card and puts to the bottom of his stack, and then he puts his card to the bottom of his stack. If after some turn one of the player's stack becomes empty, he loses and the other one wins. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate how many "},{"children":[{"kind":"text","text":"fights"}],"kind":"container"},{"kind":"text","text":" will happen and who will win the game, or state that game won't end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 10"},{"kind":"text","text":"), the number of cards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains integer "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k1 ≤ n - 1"},{"kind":"text","text":"), the number of the first soldier's cards. Then follow "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":" integers that are the values on the first soldier's cards, from top to bottom of his stack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Third line contains integer "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k1 + k2 = n"},{"kind":"text","text":"), the number of the second soldier's cards. Then follow "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" integers that are the values on the second soldier's cards, from top to bottom of his stack."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"All card values are different."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If somebody wins in this game, print "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" integers where the first one stands for the number of "},{"children":[{"kind":"text","text":"fights"}],"kind":"container"},{"kind":"text","text":" before end of game and the second one is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" showing which player has won."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the game won't end and will continue forever output "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3\n2 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"First sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6db1f8e13078c9aef5465bf34d29097e59dba21b9d829eb4117bada70e246e77.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Second sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bd2c16b06439159871218495442e8474a6e45249677d7c9484039a51e29b2925.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"546C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/546/problem/C"}