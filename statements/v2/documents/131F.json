{"assets":[],"contentKind":"statement","contestId":"131","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Present to Mom"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"How many stars are there in the sky? A young programmer Polycarpus can't get this question out of his head! He took a photo of the starry sky using his digital camera and now he analyzes the resulting monochrome digital picture. The picture is represented by a rectangular matrix consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. A character equals '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', if the corresponding photo pixel is white and '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', if it is black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus thinks that he has found a star on the photo if he finds a white pixel surrounded by four side-neighboring pixels that are also white: "}],"kind":"paragraph"},{"children":[{"kind":"code_block","text":"\n 1 \n111\n 1 \n"},{"children":[{"kind":"text","text":"a star on the photo"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Polycarpus whats to cut out a rectangular area from the photo and give his mom as a present. This area should contain no less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" stars. The stars can intersect, have shared white pixels on the photo. The boy will cut out the rectangular area so that its borders will be parallel to the sides of the photo and the cuts will go straight between the pixel borders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Polycarpus keeps wondering how many ways there are to cut an area out of the photo so that it met the conditions given above. Help Polycarpus find this number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input data contains three integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500;1 ≤ k ≤ nm"},{"kind":"text","text":"). Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, containing the description of the given photo as a sequence of lines. Each line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number of areas on the given photo."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6 2\n111000\n111100\n011011\n000111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 4\n11111\n11111\n11111\n11111\n11111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"We'll number the rows and columns below starting from 1, the coordinates "},{"kind":"math_inline","text":"(p, q)"},{"kind":"text","text":" will denote a cell in row "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", column "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample Polycarpus should cut out any area containing a rectangle whose opposite corners lie in cells "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and ("},{"kind":"math_inline","text":"3, 4"},{"kind":"text","text":"). Only rectangles with opposite corners in "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x ≥ 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y ≥ 4"},{"kind":"text","text":" fit the conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample any rectangle whose each side is no less than four, will do. The possible rectangle sizes are "},{"kind":"math_inline","text":"4 × 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4 × 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5 × 4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5 × 5"},{"kind":"text","text":". Such figures can be cut in 4 ways, 2 ways, 2 ways and 1 way correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the %lld specificator to read or write 64-bit integers in C++. It is preferred to use cin, cout streams or the %I64d specificator."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"131F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/131/problem/F"}