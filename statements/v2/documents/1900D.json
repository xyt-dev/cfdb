{"assets":[],"contentKind":"statement","contestId":"1900","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Small GCD"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let $$$a$$$, $$$b$$$, and $$$c$$$ be integers. We define function $$$f(a, b, c)$$$ as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Order the numbers $$$a$$$, $$$b$$$, $$$c$$$ in such a way that $$$a \\le b \\le c$$$. Then return $$$\\gcd(a, b)$$$, where $$$\\gcd(a, b)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So basically, we take the $$$\\gcd$$$ of the $$$2$$$ smaller values and ignore the biggest one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of $$$n$$$ elements. Compute the sum of $$$f(a_i, a_j, a_k)$$$ for each $$$i$$$, $$$j$$$, $$$k$$$, such that $$$1 \\le i \\lt j \\lt k \\le n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, compute $$$$$$\\sum_{i = 1}^n \\sum_{j = i+1}^n \\sum_{k =j +1}^n f(a_i, a_j, a_k).$$$$$$ "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$3 \\le n \\le 8 \\cdot 10^4$$$) — length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers, $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^5$$$) — elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$8 \\cdot 10^4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number — the sum from the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n2 3 6 12 17\n8\n6 12 8 10 15 12 18 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n24\n203\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the values of $$$f$$$ are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=2$$$, $$$k=3$$$, $$$f(a_i,a_j,a_k)=f(2,3,6)=\\gcd(2,3)=1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=2$$$, $$$k=4$$$, $$$f(a_i,a_j,a_k)=f(2,3,12)=\\gcd(2,3)=1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=2$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(2,3,17)=\\gcd(2,3)=1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=3$$$, $$$k=4$$$, $$$f(a_i,a_j,a_k)=f(2,6,12)=\\gcd(2,6)=2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=3$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(2,6,17)=\\gcd(2,6)=2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=1$$$, $$$j=4$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(2,12,17)=\\gcd(2,12)=2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=2$$$, $$$j=3$$$, $$$k=4$$$, $$$f(a_i,a_j,a_k)=f(3,6,12)=\\gcd(3,6)=3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=2$$$, $$$j=3$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(3,6,17)=\\gcd(3,6)=3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=2$$$, $$$j=4$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(3,12,17)=\\gcd(3,12)=3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i=3$$$, $$$j=4$$$, $$$k=5$$$, $$$f(a_i,a_j,a_k)=f(6,12,17)=\\gcd(6,12)=6$$$."}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The sum over all triples is $$$1+1+1+2+2+2+3+3+3+6=24$$$."},{"children":[{"kind":"text","text":"In the second test case, there are $$$56$$$ ways to choose values of $$$i$$$, $$$j$$$, $$$k$$$. The sum over all $$$f(a_i,a_j,a_k)$$$ is $$$203$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1900D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1900/problem/D"}