{"assets":["/statement-assets/9f2bfc58a4ee016bde7d4f7feb039a2f6dd8a5b1524fb4e73a7cb964f6bff05b.png","/statement-assets/2eab582f9ef46870181ee2031120e2188ab567b48a19778b1daf5d62a484ce19.png"],"contentKind":"statement","contestId":"1772","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Matrix Rotation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a matrix $$$2 \\times 2$$$ filled with "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers. You want your matrix to become beautiful. The matrix is beautiful if the following two conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in each row, the first element is smaller than the second element; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in each column, the first element is smaller than the second element. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9f2bfc58a4ee016bde7d4f7feb039a2f6dd8a5b1524fb4e73a7cb964f6bff05b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You can perform the following operation on the matrix any number of times: rotate it clockwise by $$$90$$$ degrees, so the top left element shifts to the top right cell, the top right element shifts to the bottom right cell, and so on:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2eab582f9ef46870181ee2031120e2188ab567b48a19778b1daf5d62a484ce19.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Determine if it is possible to make the matrix beautiful by applying zero or more operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. Each of those lines contains two integers — the elements of the corresponding row of the matrix. In each matrix, all four elements are distinct integers from $$$1$$$ to $$$100$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the matrix can become beautiful, or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise. You may print each letter in any case ("},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" will all be recognized as positive answer, "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"nO"}],"kind":"container"},{"kind":"text","text":" will all be recognized as negative answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 3\n5 7\n8 10\n3 4\n8 10\n4 3\n6 1\n9 2\n7 5\n4 2\n1 2\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1772B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1772/problem/B"}