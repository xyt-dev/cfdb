{"assets":[],"contentKind":"statement","contestId":"466","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Information Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees working in company \"X\" (let's number them from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" for convenience). Initially the employees didn't have any relationships among each other. On each of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" next days one of the following events took place:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either employee "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" became the boss of employee "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (at that, employee "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" didn't have a boss before); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or employee "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" gets a packet of documents and signs them; then he gives the packet to his boss. The boss signs the documents and gives them to his boss and so on (the last person to sign the documents sends them to the archive); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or comes a request of type \"determine whether employee "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" signs certain documents\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to write a program that will, given the events, answer the queries of the described type. At that, it is guaranteed that throughout the whole working time the company didn't have cyclic dependencies."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of employees and the number of events. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains the description of one event (the events are given in the chronological order). The first number of the line determines the type of event "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ t ≤ 3)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":", then next follow two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(1 ≤ x, y ≤ n)"},{"kind":"text","text":" — numbers of the company employees. It is guaranteed that employee "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" doesn't have the boss currently. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"t = 2"},{"kind":"text","text":", then next follow integer "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x ≤ n)"},{"kind":"text","text":" — the number of the employee who got a document packet. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"t = 3"},{"kind":"text","text":", then next follow two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ x ≤ n; 1 ≤ i ≤ "},{"kind":"text","text":"[number of packets that have already been given]"},{"kind":"math_inline","text":")"},{"kind":"text","text":" — the employee and the number of the document packet for which you need to find out information. The document packets are numbered started from 1 in the chronological order. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that the input has at least one query of the third type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the third type print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the employee signed the document package and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise. Print all the words without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 9\n1 4 3\n2 4\n3 3 1\n1 2 3\n2 2\n3 1 2\n1 3 1\n2 2\n3 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"466E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/466/problem/E"}