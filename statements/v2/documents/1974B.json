{"assets":["/statement-assets/d496e1a3412467994ef0285cf01ac03dcbe68b787c2288ff8f51de737f80539b.png"],"contentKind":"statement","contestId":"1974","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Symmetric Encoding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has a string $$$s$$$, which consists of lowercase Latin letters. He encodes this string using the following algorithm:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" first, he constructs a new auxiliary string $$$r$$$, which consists of all distinct letters of the string $$$s$$$, written in alphabetical order; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then the encoding happens as follows: each character in the string $$$s$$$ is replaced by its symmetric character from the string $$$r$$$ (the first character of the string $$$r$$$ will be replaced by the last, the second by the second from the end, and so on). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, encoding the string $$$s$$$=\""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" happens as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the string $$$r$$$ is obtained as \""},{"children":[{"kind":"text","text":"cdefors"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the first character $$$s_1$$$='"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second character $$$s_2$$$='"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third character $$$s_3$$$='"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the last character $$$s_{10}$$$='"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d496e1a3412467994ef0285cf01ac03dcbe68b787c2288ff8f51de737f80539b.png"},"kind":"image"},{"children":[{"kind":"text","text":"The string $$$r$$$ and replacements for $$$s$$$=\""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Thus, the result of encoding the string $$$s$$$=\""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" is the string \""},{"children":[{"kind":"text","text":"serofedsoc"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that performs decoding — that is, restores the original string $$$s$$$ from the encoding result."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$b$$$ of length $$$n$$$, consisting of lowercase Latin letters — the result of encoding the original string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the values of $$$n$$$ over all test cases in the test does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the string $$$s$$$ from which the encoding result $$$b$$$ was obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n10\nserofedsoc\n3\nttf\n9\ntlrhgmaoi\n1\nw\n15\nhnndledmnhlttin\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\ncodeforces\nfft\nalgorithm\nw\nmeetinthemiddle\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1974B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1974/problem/B"}