{"assets":[],"contentKind":"statement","contestId":"961","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Chessboard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Magnus decided to play a classic chess game. Though what he saw in his locker shocked him! His favourite chessboard got broken into "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" pieces, each of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"always odd"}],"kind":"container"},{"kind":"text","text":". And what's even worse, some squares were of wrong color. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th square of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th piece of the board has color "},{"kind":"math_inline","text":"ak, i, j"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" being black and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" being white. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Magnus wants to change color of some squares in such a way that he recolors minimum number of squares and obtained pieces form a valid chessboard. Every square has its color different to each of the neightbouring by side squares in a valid board. Its size should be "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":". You are allowed to move pieces but "},{"children":[{"kind":"text","text":"not allowed to rotate or flip them"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the size of all pieces of the board. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" segments follow, each describes one piece of the board. Each consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters; "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th one of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is equal to "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" if the square is black initially and "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" otherwise. Segments are separated by an empty line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number — minimum number of squares Magnus should recolor to be able to obtain a valid chessboard."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n\n0\n\n1\n\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n101\n010\n101\n\n101\n000\n101\n\n010\n101\n011\n\n010\n101\n010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"961C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/961/problem/C"}