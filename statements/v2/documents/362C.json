{"assets":[],"contentKind":"statement","contestId":"362","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Insertion Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya is a beginner programmer. He has already mastered the basics of the C++ language and moved on to learning algorithms. The first algorithm he encountered was insertion sort. Petya has already written the code that implements this algorithm and sorts the given integer zero-indexed array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the non-decreasing order. "}],"kind":"paragraph"},{"kind":"code_block","text":"for (int i = 1; i < n; i = i + 1)\n{\n   int j = i; \n   while (j > 0 && a[j] < a[j - 1])\n   {\n      swap(a[j], a[j - 1]); // swap elements a[j] and a[j - 1]\n      j = j - 1;\n   }\n}\n"},{"children":[{"kind":"text","text":"Petya uses this algorithm only for sorting of arrays that are permutations of numbers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". He has already chosen the permutation he wants to sort but he first decided to swap some two of its elements. Petya wants to choose these elements in such a way that the number of times the sorting executes function "},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":", was minimum. Help Petya find out the number of ways in which he can make the swap and fulfill this requirement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that it's always possible to swap two elements of the input permutation in such a way that the number of "},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":" function calls decreases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000"},{"kind":"text","text":") — the length of the permutation. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", inclusive — the actual permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers: the minimum number of times the "},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":" function is executed and the number of such pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" that swapping the elements of the input permutation with indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" leads to the minimum number of the executions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 0 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the appropriate pairs are "},{"kind":"math_inline","text":"(0, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(0, 4)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the appropriate pairs are "},{"kind":"math_inline","text":"(0, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"362C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/362/problem/C"}