{"assets":[],"contentKind":"statement","contestId":"452","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. 4-point polyline"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rectangular grid of lattice points from "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":" inclusive. You have to choose exactly 4 different points to build a polyline possibly with self-intersections and self-touching. This polyline should be as long as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A polyline defined by points "},{"kind":"math_inline","text":"p1, p2, p3, p4"},{"kind":"text","text":" consists of the line segments "},{"kind":"math_inline","text":"p1 p2, p2 p3, p3 p4"},{"kind":"text","text":", and its length is the sum of the lengths of the individual line segments."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(0 ≤ n, m ≤ 1000)"},{"kind":"text","text":". It is guaranteed that grid contains at least 4 different points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print 4 lines with two integers per line separated by space — coordinates of points "},{"kind":"math_inline","text":"p1, p2, p3, p4"},{"kind":"text","text":" in order which represent the longest possible polyline."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Judge program compares your answer and jury's answer with "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":" precision."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n0 0\n1 0\n0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n0 10\n0 0\n0 9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"452B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/452/problem/B"}