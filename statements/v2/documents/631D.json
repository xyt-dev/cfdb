{"assets":["/statement-assets/d96b2368479ff749aac5183683d05cfde2d1f8a6a6de2576708e9f6a9bb67328.png","/statement-assets/5d5547da8d9fef98ad5048863758a1ae9836fc3e0288a9f00d6033e28b0638e0.png","/statement-assets/61fad2e40f92f29ed79ac7f0d4c5dabf3b319fb51ac3e6d301d924472dd86792.png","/statement-assets/2ffb4bd34381b78f7179b37e728f9ca52b52fe35f2402fbcbbfead8142fec711.png"],"contentKind":"statement","contestId":"631","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Messenger"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Each employee of the \"Blake Techologies\" company uses a special messaging app \"Blake Messenger\". All the stuff likes this app and uses it constantly. However, some important futures are missing. For example, many users want to be able to search through the message history. It was already announced that the new feature will appear in the nearest update, when developers faced some troubles that only you may help them to solve."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the messages are represented as a strings consisting of only lowercase English letters. In order to reduce the network load strings are represented in the special compressed form. Compression algorithm works as follows: string is represented as a concatenation of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" blocks, each block containing only equal characters. One block may be described as a pair "},{"kind":"math_inline","text":"(li, ci)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" is the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the corresponding letter. Thus, the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" may be written as the sequence of pairs "},{"attrs":{"alt":"","src":"/statement-assets/d96b2368479ff749aac5183683d05cfde2d1f8a6a6de2576708e9f6a9bb67328.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to write the program, that given two compressed string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" finds all occurrences of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Developers know that there may be many such occurrences, so they only ask you to find the "},{"children":[{"kind":"text","text":"number"}],"kind":"container"},{"kind":"text","text":" of them. Note that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the starting position of some occurrence of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"tptp + 1...tp + |s| - 1 = s"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the way to represent the string in compressed form may not be unique. For example string \""},{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"},{"kind":"text","text":"\" may be given as "},{"attrs":{"alt":"","src":"/statement-assets/5d5547da8d9fef98ad5048863758a1ae9836fc3e0288a9f00d6033e28b0638e0.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/61fad2e40f92f29ed79ac7f0d4c5dabf3b319fb51ac3e6d301d924472dd86792.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/2ffb4bd34381b78f7179b37e728f9ca52b52fe35f2402fbcbbfead8142fec711.png"},"kind":"image"},{"kind":"text","text":"..."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 200 000"},{"kind":"text","text":") — the number of blocks in the strings "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the descriptions of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the format \""},{"kind":"math_inline","text":"li"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ li ≤ 1 000 000"},{"kind":"text","text":") — the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part and the corresponding lowercase English letter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the descriptions of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" parts of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in the format \""},{"kind":"math_inline","text":"li"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ li ≤ 1 000 000"},{"kind":"text","text":") — the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part and the corresponding lowercase English letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of occurrences of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n3-a 2-b 4-c 3-a 2-c\n2-a 2-b 1-c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n3-a 6-b 7-a 4-c 8-e 2-a\n3-a\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1-h 1-e 1-l 1-l 1-o\n1-w 1-o 1-r 1-l 1-d\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"aaabbccccaaacc"}],"kind":"container"},{"kind":"text","text":"\", and string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"aabbc"}],"kind":"container"},{"kind":"text","text":"\". The only occurrence of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" starts at position "},{"kind":"math_inline","text":"p = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"aaabbbbbbaaaaaaacccceeeeeeeeaa"}],"kind":"container"},{"kind":"text","text":"\", and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\". The occurrences of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" start at positions "},{"kind":"math_inline","text":"p = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p = 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p = 11"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p = 12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p = 13"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p = 14"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"631D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/631/problem/D"}