{"assets":[],"contentKind":"statement","contestId":"219","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. k-String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-string if it can be represented as "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" concatenated copies of some string. For example, the string \""},{"children":[{"kind":"text","text":"aabaabaabaab"}],"kind":"container"},{"kind":"text","text":"\" is at the same time a 1-string, a 2-string and a 4-string, but it is not a 3-string, a 5-string, or a 6-string and so on. Obviously any string is a 1-string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase English letters and a positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Your task is to reorder the letters in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in such a way that the resulting string is a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", all characters in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are lowercase English letters. The string length "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" satisfies the inequality "},{"kind":"math_inline","text":"1 ≤ |s| ≤ 1000"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Rearrange the letters in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in such a way that the result is a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-string. Print the result on a single output line. If there are multiple solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the solution doesn't exist, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\naazz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"azaz\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children"