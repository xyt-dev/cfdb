{"assets":["/statement-assets/20fef869cd6b26bcc8ade580b2577d144d6769ed3a3da49631b5dde83374c8c7.png"],"contentKind":"statement","contestId":"431","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. k-Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Quite recently a creative student Lesha had a lecture on trees. After the lecture Lesha was inspired and came up with the tree of his own which he called a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tree is an infinite rooted tree where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each vertex has exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" children; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each edge has some weight; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we look at the edges that goes from some vertex to its children (exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" edges), then their weights will equal "},{"kind":"math_inline","text":"1, 2, 3, ..., k"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The picture below shows a part of a 3-tree."}],"kind":"paragraph"},{"kind":"paragraph"},{"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/20fef869cd6b26bcc8ade580b2577d144d6769ed3a3da49631b5dde83374c8c7.png"},"kind":"image"}],"kind":"paragraph"},{"kind":"paragraph"}],"kind":"container"},{"kind":"text","text":" As soon as Dima, a good friend of Lesha, found out about the tree, he immediately wondered: \"How many paths of total weight "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (the sum of all weights of the edges in the path) are there, starting from the root of a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tree and also containing at least one edge of weight at least "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"?\"."},{"children":[{"kind":"text","text":"Help Dima find an answer to his question. As the number of ways can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains three space-separated integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 100;"},{"kind":"math_inline","text":"1 ≤ d ≤ k"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"431C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/431/problem/C"}