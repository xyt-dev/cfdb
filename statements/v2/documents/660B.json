{"assets":["/statement-assets/a8523ab7efadd310893457c69b5e36c361d2f22aaea18c9f17333aef793a5453.png"],"contentKind":"statement","contestId":"660","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Seating On Bus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" rows of the seats in a bus. "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of the seats on the left and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of the seats on the right. Each row can be filled by two people. So the total capacity of the bus is "},{"kind":"math_inline","text":"4n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"m ≤ 4n"},{"kind":"text","text":") people occupy the seats in the bus. The passengers entering the bus are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" (in the order of their entering the bus). The pattern of the seat occupation is as below:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row left window seat, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row right window seat, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd row left window seat, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd row right window seat, ... , "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row left window seat, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row right window seat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After occupying all the window seats (for "},{"kind":"math_inline","text":"m > 2n"},{"kind":"text","text":") the non-window seats are occupied:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row left non-window seat, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row right non-window seat, ... , "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row left non-window seat, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row right non-window seat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the passengers go to a single final destination. In the final destination, the passengers get off in the given order."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row left non-window seat, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row left window seat, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row right non-window seat, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row right window seat, ... , "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row left non-window seat, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row left window seat, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row right non-window seat, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row right window seat."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a8523ab7efadd310893457c69b5e36c361d2f22aaea18c9f17333aef793a5453.png"},"kind":"image"},{"children":[{"kind":"text","text":"The seating for "},{"kind":"math_inline","text":"n = 9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m = 36"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given the values "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", the order in which the passengers will get off the bus."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 1 ≤ m ≤ 4n"},{"kind":"text","text":") — the number of pairs of rows and the number of passengers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the order in which the passengers will get off the bus."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"k