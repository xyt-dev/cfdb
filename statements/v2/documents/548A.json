{"assets":["/statement-assets/5343acec31610c1fcab4f87ebcee21b6300daeed307b2363d25c2ca88d562e38.png"],"contentKind":"statement","contestId":"548","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mike and Fax"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While Mike was walking in the subway, all the stuff in his back-bag dropped on the ground. There were several fax messages among them. He concatenated these strings in some order and now he has string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5343acec31610c1fcab4f87ebcee21b6300daeed307b2363d25c2ca88d562e38.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He is not sure if this is his own back-bag or someone else's. He remembered that there were exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" messages in his own bag, each was a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" string and all those strings had the same length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He asked you to help him and tell him if he has worn his own back-bag. Check if the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a concatenation of "},{"kind":"math_inline","text":"k"},{"children":[{"kind":"text","text":"palindromes"}],"kind":"container"},{"kind":"text","text":" of the same length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" containing lowercase English letters ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \"YES\"(without quotes) if he has worn his own back-bag or \"NO\"(without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"saba\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"saddastavvat\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Palindrome"}],"kind":"container"},{"kind":"text","text":" is a string reading the same forward and backward."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the faxes in his back-bag can be \"saddas\" and \"tavvat\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"548A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/548/problem/A"}