{"assets":[],"contentKind":"statement","contestId":"915","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Browser"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Luba is surfing the Internet. She currently has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" opened tabs in her browser, indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. The mouse cursor is currently located at the "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":"-th tab. Luba needs to use the tabs with indices from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (inclusive) for her studies, and she wants to close all the tabs that don't belong to this segment as fast as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each second Luba can either try moving the cursor to the left or to the right (if the cursor is currently at the tab "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", then she can move it to the tab "},{"kind":"math_inline","text":"max(i - 1, a)"},{"kind":"text","text":" or to the tab "},{"kind":"math_inline","text":"min(i + 1, b)"},{"kind":"text","text":") or try closing all the tabs to the left or to the right of the cursor (if the cursor is currently at the tab "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", she can close all the tabs with indices from segment "},{"kind":"math_inline","text":"[a, i - 1]"},{"kind":"text","text":" or from segment "},{"kind":"math_inline","text":"[i + 1, b]"},{"kind":"text","text":"). In the aforementioned expressions "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" denote the minimum and maximum index of an unclosed tab, respectively. For example, if there were "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" tabs initially and tabs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" are closed, then "},{"kind":"math_inline","text":"a = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b = 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of seconds Luba has to spend in order to leave "},{"children":[{"kind":"text","text":"only the tabs with initial indices from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive"}],"kind":"container"},{"kind":"text","text":" opened?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains four integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ pos ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") — the number of the tabs, the cursor position and the segment which Luba needs to leave opened."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer equal to the minimum number of seconds required to close all the tabs outside the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Luba can do the following operations: shift the mouse cursor to the tab "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", close all the tabs to the left of it, shift the mouse cursor to the tab "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", then to the tab "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", and then close all the tabs to the right of it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test she only needs to close all the tabs to the right of the current position of the cursor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test Luba doesn't need to do anything."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"915B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/915/problem/B"}