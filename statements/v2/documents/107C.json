{"assets":[],"contentKind":"statement","contestId":"107","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Arrangement"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the year 2500 the annual graduation ceremony in the German University in Cairo (GUC) has run smoothly for almost 500 years so far."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The most important part of the ceremony is related to the arrangement of the professors in the ceremonial hall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Traditionally GUC has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" professors. Each professor has his seniority level. All seniorities are different. Let's enumerate the professors from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" being the most senior professor and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" being the most junior professor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The ceremonial hall has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" seats, one seat for each professor. Some places in this hall are meant for more senior professors than the others. More specifically, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of seats are in \"senior-junior\" relation, and the tradition requires that for all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of seats "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" the professor seated in \"senior\" position "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" should be more senior than the professor seated in \"junior\" position "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GUC is very strict about its traditions, which have been carefully observed starting from year 2001. The tradition requires that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The seating of the professors changes every year. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Year 2001 ceremony was using lexicographically first arrangement of professors in the ceremonial hall. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each consecutive year lexicographically next arrangement of the professors is used. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The arrangement of the professors is the list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, where the first integer is the seniority of the professor seated in position number one, the second integer is the seniority of the professor seated in position number two, etc."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the number of professors, "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", the current year and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of restrictions, output the arrangement of the professors for this year."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 16, 2001 ≤ y ≤ 1018, 0 ≤ m ≤ 100"},{"kind":"text","text":") — the number of professors, the year for which the arrangement should be computed, and the number of pairs of seats for which the seniority relation should be kept, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain one pair of integers each, \""},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"\", indicating that professor on the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"-th seat is more senior than professor on the "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"-th seat ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":"). Some pair may be listed more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":" stream (you may also use the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the order in which the professors should be seated in the requested year."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If by this year the GUC would have ran out of arrangements, or the given \"senior-junior\" relation are contradictory, print \""},{"children":[{"kind":"text","text":"The times have changed"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2001 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2020 6\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 7 4 6 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3630801 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"The times have changed\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2001 3\n1 2\n2 3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"The times have changed\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the lexicographically first order of seating is 1 2 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the GUC will run out of arrangements after the year 3630800."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example there are no valid arrangements for the seating."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographical comparison of arrangements is performed by the < operator in modern programming languages. The arrangement "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically less that the arrangement "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if there exists such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"ai < bi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"aj = bj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"107C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/107/problem/C"}