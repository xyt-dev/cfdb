{"assets":["/statement-assets/d4cdd26da0e2c9cd54f974b068981ebe25ccaa2594665d303675187815d9dded.png","/statement-assets/c4218ce3b5b9ac2a9f8f5c133a1235debe35ac2bcb58e535a89f95e27fecb7e3.png","/statement-assets/50fc1e2a5ed19190c39d3576e61adc83cc0bc525353116a7900bebe5fa3f55e9.png","/statement-assets/a8e3a38b4f7be9841297de9af31b68346843cced2de2f303e8257f85da53d6ab.png","/statement-assets/d58303444514180282d51d6d9f0f72b9fc0cf2729df2843c94ddadb606ae124e.png","/statement-assets/1ac5dafcfc392c721761ac0a2f8ab8672ddd3a692d46c59ab866d52b967d982b.png"],"contentKind":"statement","contestId":"2029","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cool Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph with $$$n$$$ vertices and $$$m$$$ edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation at most $$$2\\cdot \\max(n,m)$$$ times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose three distinct vertices $$$a$$$, $$$b$$$, and $$$c$$$, then for each of the edges $$$(a,b)$$$, $$$(b,c)$$$, and $$$(c,a)$$$, do the following: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the edge does not exist, add it. On the contrary, if it exists, remove it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A graph is called "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" if and only if one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The graph has no edges, or "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The graph is a tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to make the graph "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" by performing the above operations. Note that you can use at most $$$2\\cdot \\max(n,m)$$$ operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that there always exists at least one solution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line of input contains a single integer $$$t$$$ ($$$1\\le t\\le 10^4$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$3\\le n\\le 10^5$$$, $$$0\\le m\\le \\min\\left(\\frac{n(n-1)}{2},2\\cdot 10^5\\right)$$$) — the number of vertices and the number of edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$m$$$ lines follow, the $$$i$$$-th line contains two integers $$$u_i$$$ and $$$v_i$$$ ($$$1\\le u_i,v_i\\le n$$$) — the two nodes that the $$$i$$$-th edge connects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$, and the sum of $$$m$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there are no self-loops or multiple-edges in the given graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, in the first line output an integer $$$k$$$ ($$$0\\le k\\le 2\\cdot \\max(n, m)$$$) — the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then output $$$k$$$ lines, the $$$i$$$-th line containing three distinct integers $$$a$$$, $$$b$$$, and $$$c$$$ ($$$1\\le a,b,c\\le n$$$) — the three integers you choose in the $$$i$$$-th operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 0\n3 1\n1 2\n3 2\n1 2\n2 3\n3 3\n1 2\n2 3\n3 1\n6 6\n1 2\n1 6\n4 5\n3 4\n4 6\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n1\n1 2 3\n0\n1\n1 2 3\n3\n1 3 6\n2 4 5\n3 4 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the graph is already "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" because there are no edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, after performing the only operation, the graph becomes a tree, so it is "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the graph is already "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" because it is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, after performing the only operation, the graph has no edges, so it is "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"Operation"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"Graph before the operation"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"Graph after the operation"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/d4cdd26da0e2c9cd54f974b068981ebe25ccaa2594665d303675187815d9dded.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/c4218ce3b5b9ac2a9f8f5c133a1235debe35ac2bcb58e535a89f95e27fecb7e3.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$2$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/50fc1e2a5ed19190c39d3576e61adc83cc0bc525353116a7900bebe5fa3f55e9.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/a8e3a38b4f7be9841297de9af31b68346843cced2de2f303e8257f85da53d6ab.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/d58303444514180282d51d6d9f0f72b9fc0cf2729df2843c94ddadb606ae124e.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/1ac5dafcfc392c721761ac0a2f8ab8672ddd3a692d46c59ab866d52b967d982b.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"Note that after the first operation, the graph has already become "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":", and there are two extra operations. As the graph is still "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" after the two extra operations, this is a valid answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2029D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2029/problem/D"}