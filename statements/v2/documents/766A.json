{"assets":[],"contentKind":"statement","contestId":"766","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mahmoud and Longest Uncommon Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While Mahmoud and Ehab were practicing for IOI, they found a problem which name was Longest common subsequence. They solved it, and then Ehab challenged Mahmoud with another problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given two strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", find the length of their longest uncommon subsequence, which is the longest string that is a subsequence of one of them and not a subsequence of the other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subsequence of some string is a sequence of characters that appears in the same order in the string, The appearances don't have to be consecutive, for example, strings \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" are subsequences of string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" while strings \""},{"children":[{"kind":"text","text":"abbc"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":"\" are not. The empty string is a subsequence of any string. Any string is a subsequence of itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the second line — string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Both of these strings are non-empty and consist of lowercase letters of English alphabet. The length of each string is not bigger than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there's no uncommon subsequence, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\". Otherwise print the length of the longest uncommon subsequence of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcd\ndefgh\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"a\na\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example: you can choose \""},{"children":[{"kind":"text","text":"defgh"}],"kind":"container"},{"kind":"text","text":"\" from string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" as it is the longest subsequence of string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that doesn't appear as a subsequence of string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"766A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/766/problem/A"}