{"assets":[],"contentKind":"statement","contestId":"283","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cows and Cool Sequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bessie and the cows have recently been playing with \"cool\" sequences and are trying to construct some. Unfortunately they are bad at arithmetic, so they need your help!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pair "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" of positive integers is \"cool\" if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" can be expressed as the sum of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" consecutive integers (not necessarily positive). A sequence "},{"kind":"math_inline","text":"(a1, a2, ..., an)"},{"kind":"text","text":" is \"cool\" if the pairs "},{"kind":"math_inline","text":"(a1, a2), (a2, a3), ..., (an - 1, an)"},{"kind":"text","text":" are all cool. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cows have a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers, "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". In one move, they may replace some "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" with any other positive integer (there are no other limits on the new value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"). Determine the smallest number of moves needed to make the resulting sequence cool."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1015"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer, the minimum number of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" that must be changed to make the sequence cool."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n6 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n20 6 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the sequence is already cool, so we don't need to change any elements. In the second sample, we can change "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" to 5 and "},{"kind":"math_inline","text":"a3"},{"kind":"text","text":" to 10 to make (20, 5, 10, 4) which is cool. This changes 2 elements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"283D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/283/problem/D"}