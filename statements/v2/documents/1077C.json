{"assets":[],"contentKind":"statement","contestId":"1077","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Good Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call an array "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if there is an element in the array that equals to the sum of all other elements. For example, the array $$$a=[1, 3, 3, 7]$$$ is good because there is the element $$$a_4=7$$$ which equals to the sum $$$1 + 3 + 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ integers. Your task is to print all indices $$$j$$$ of this array such that after removing the $$$j$$$-th element from the array it will be "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" (let's call such indices "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$a=[8, 3, 5, 2]$$$, the "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" indices are $$$1$$$ and $$$4$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if you remove $$$a_1$$$, the array will look like $$$[3, 5, 2]$$$ and it is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you remove $$$a_4$$$, the array will look like $$$[8, 3, 5]$$$ and it is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to consider all removals "},{"children":[{"kind":"text","text":"independently"}],"kind":"container"},{"kind":"text","text":", i. e. remove the element, check if the resulting array is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", and return the element into the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the number of elements in the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^6$$$) — elements of the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer $$$k$$$ — the number of indices $$$j$$$ of the array $$$a$$$ such that after removing the $$$j$$$-th element from the array it will be "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" (i.e. print the number of the "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" indices)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print $$$k$$$ distinct integers $$$j_1, j_2, \\dots, j_k$$$ in "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" order — "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" indices of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no such indices in the array $$$a$$$, just print $$$0$$$ in the first line and leave the second line empty or do not print it at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2 5 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4 1 5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n8 3 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2 1 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can remove any element with the value $$$2$$$ so the array will look like $$$[5, 1, 2, 2]$$$. The sum of this array is $$$10$$$ and there is an element equals to the sum of remaining elements ($$$5 = 1 + 2 + 2$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can remove $$$8$$$ so the array will look like $$$[3, 5, 2]$$$. The sum of this array is $$$10$$$ and there is an element equals to the sum of remaining elements ($$$5 = 3 + 2$$$). You can also remove $$$2$$$ so the array will look like $$$[8, 3, 5]$$$. The sum of this array is $$$16$$$ and there is an element equals to the sum of remaining elements ($$$8 = 3 + 5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you cannot make the given array "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" by removing exactly one element."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1077C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1077/problem/C"}