{"assets":["/statement-assets/19d9adc6a2124ddbd13e543e0a06f2813959a1d2544293f8b983c7bc8ce2fa73.png"],"contentKind":"statement","contestId":"1881","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Minimum Maximum Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a tree with $$$n$$$ vertices, some of which are marked. A tree is a connected undirected graph without cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f_i$$$ denote the maximum distance from vertex $$$i$$$ to any of the marked vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum value of $$$f_i$$$ among all vertices."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/19d9adc6a2124ddbd13e543e0a06f2813959a1d2544293f8b983c7bc8ce2fa73.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For example, in the tree shown in the example, vertices $$$2$$$, $$$6$$$, and $$$7$$$ are marked. Then the array $$$f(i) = [2, 3, 2, 4, 4, 3, 3]$$$. The minimum $$$f_i$$$ is for vertices $$$1$$$ and $$$3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 2 \\cdot 10^5$$$) — the number of vertices in the tree and the number of marked vertices, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$k$$$ integers $$$a_i$$$ ($$$1 \\le a_i \\le n, a_{i-1} \\lt a_i$$$) — the indices of the marked vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n - 1$$$ lines contain two integers $$$u_i$$$ and $$$v_i$$$ — the indices of vertices connected by the $$$i$$$-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum value of $$$f_i$$$ among all vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n7 3\n2 6 7\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7\n4 4\n1 2 3 4\n1 2\n2 3\n3 4\n5 1\n1\n1 2\n1 3\n1 4\n1 5\n5 2\n4 5\n1 2\n2 3\n1 4\n4 5\n10 8\n1 2 3 4 5 8 9 10\n2 10\n10 5\n5 3\n3 1\n1 7\n7 4\n4 9\n8 9\n6 1\n10 9\n1 2 4 5 6 7 8 9 10\n1 3\n3 9\n9 4\n4 10\n10 6\n6 7\n7 2\n2 5\n5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2\n0\n1\n4\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6 1\n3\n1 2\n1 3\n3 4\n3 5\n2 6\n5 3\n1 2 5\n1 2\n1 3\n2 4\n3 5\n7 1\n2\n3 2\n2 6\n6 1\n5 6\n7 6\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1881F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1881/problem/F"}