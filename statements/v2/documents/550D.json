{"assets":[],"contentKind":"statement","contestId":"550","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Regular Bridge"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An undirected graph is called "},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":"-regular"}],"kind":"container"},{"kind":"text","text":", if the degrees of all its vertices are equal "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". An edge of a connected graph is called a "},{"children":[{"kind":"text","text":"bridge"}],"kind":"container"},{"kind":"text","text":", if after removing it the graph is being split into two connected components."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Build a connected undirected "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-regular graph containing at least one bridge, or else state that such graph doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":") — the required degree of the vertices of the regular graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if such graph doesn't exist. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line and the description of any suitable graph in the next lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of the made graph must start with numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of vertices and edges respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines must contain two integers, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":"), that mean that there is an edge connecting the vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". A graph shouldn't contain multiple edges and edges that lead from a vertex to itself. A graph must be connected, the degrees of all vertices of the graph must be equal "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". At least one edge of the graph must be a bridge. You can print the edges of the graph in any order. You can print the ends of each edge in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The constructed graph must contain at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" edges (it is guaranteed that if at least one graph that meets the requirements exists, then there also exists the graph with at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" vertices and at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" edges). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n2 1\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample from the statement there is a suitable graph consisting of two vertices, connected by a single edge."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"550D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/550/problem/D"}