{"assets":[],"contentKind":"statement","contestId":"613","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Skills"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Lesha plays the recently published new version of the legendary game hacknet. In this version character skill mechanism was introduced. Now, each player character has exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" skills. Each skill is represented by a non-negative integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — the current skill level. All skills have the same maximum level "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Along with the skills, global ranking of all players was added. Players are ranked according to the so-called Force. The "},{"children":[{"kind":"text","text":"Force"}],"kind":"container"},{"kind":"text","text":" of a player is the sum of the following values:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The number of skills that a character has perfected (i.e., such that "},{"kind":"math_inline","text":"ai = A"},{"kind":"text","text":"), multiplied by coefficient "},{"kind":"math_inline","text":"cf"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The minimum skill level among all skills ("},{"kind":"math_inline","text":"min ai"},{"kind":"text","text":"), multiplied by coefficient "},{"kind":"math_inline","text":"cm"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Lesha has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" hacknetian currency units, which he is willing to spend. Each currency unit can increase the current level of any skill by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (if it's not equal to "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" yet). Help him spend his money in order to achieve the maximum possible value of the Force."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains five space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cf"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cm"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ A ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ cf, cm ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 1015"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ A"},{"kind":"text","text":"), separated by spaces, — the current levels of skills."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print the maximum value of the Force that the character can achieve using no more than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" currency units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a'i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ai ≤ a'i ≤ A"},{"kind":"text","text":"), skill levels which one must achieve in order to reach the specified value of the Force, while using no more than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" currency units. Numbers should be separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 10 1 5\n1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n2 5 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 10 1 339\n1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"35\n5 5 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test the optimal strategy is to increase the second skill to its maximum, and increase the two others by "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test one should increase all skills to maximum."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"613B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/613/problem/B"}