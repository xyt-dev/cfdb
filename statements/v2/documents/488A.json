{"assets":[],"contentKind":"statement","contestId":"488","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Giga Tower"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Giga Tower is the tallest and deepest building in Cyberland. There are "},{"kind":"math_inline","text":"17 777 777 777"},{"kind":"text","text":" floors, numbered from "},{"kind":"math_inline","text":" - 8 888 888 888"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"8 888 888 888"},{"kind":"text","text":". In particular, there is floor "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" between floor "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" and floor "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Every day, thousands of tourists come to this place to enjoy the wonderful view. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In Cyberland, it is believed that the number \"8\" is a lucky number (that's why Giga Tower has "},{"kind":"math_inline","text":"8 888 888 888"},{"kind":"text","text":" floors above the ground), and, an integer is "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":", if and only if its decimal notation contains at least one digit \"8\". For example, "},{"kind":"math_inline","text":"8,  - 180, 808"},{"kind":"text","text":" are all "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" while "},{"kind":"math_inline","text":"42,  - 10"},{"kind":"text","text":" are not. In the Giga Tower, if you write code at a floor with lucky floor number, good luck will always be with you (Well, this round is #278, also lucky, huh?)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tourist Henry goes to the tower to seek good luck. Now he is at the floor numbered "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". He wants to find the minimum "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", such that, if he walks "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" floors higher, he will arrive at a floor with a "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" number. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains an integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ a ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in a line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"179\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, he has to arrive at the floor numbered "},{"kind":"math_inline","text":"180"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, he will arrive at "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" should be positive, so the answer for the third sample is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", not "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"488A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/488/problem/A"}