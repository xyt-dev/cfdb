{"assets":[],"contentKind":"statement","contestId":"316","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G2. Good Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Smart Beaver recently got interested in a new word game. The point is as follows: count the number of distinct good substrings of some string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". To determine if a string is good or not the game uses rules. Overall there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rules. Each rule is described by a group of three "},{"kind":"math_inline","text":"(p, l, r)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a string and "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(l ≤ r)"},{"kind":"text","text":" are integers. We’ll say that string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" complies with rule "},{"kind":"math_inline","text":"(p, l, r)"},{"kind":"text","text":", if the number of occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" lies between "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive. For example, string \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", complies with rules (\""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":") and (\""},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"), but does not comply with rules (\""},{"children":[{"kind":"text","text":"cd"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":") and (\""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"math_inline","text":"s[l... r]"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ |s|)"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s = s1s2... s|s|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is a length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":") is string "},{"kind":"math_inline","text":"slsl + 1... sr"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider a "},{"children":[{"kind":"text","text":"number of occurrences "}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as a number of pairs of integers "},{"kind":"math_inline","text":"l, r"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ |p|)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p[l... r] = t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We’ll say that string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is good if it complies with all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rules. Smart Beaver asks you to help him to write a program that can calculate the number of distinct good substrings of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Two substrings "},{"kind":"math_inline","text":"s[x... y]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s[z... w]"},{"kind":"text","text":" are cosidered to be distinct iff "},{"kind":"math_inline","text":"s[x... y] ≠ s[z... w]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The second line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the rules, one per line. Each of these lines contains a string and two integers "},{"kind":"math_inline","text":"pi, li, ri"},{"kind":"text","text":", separated by single spaces ("},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ |pi|"},{"kind":"text","text":"). It is guaranteed that all the given strings are non-empty and only contain lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The input limits for scoring 30 points are (subproblem G1): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"0 ≤ n ≤ 10"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The length of string "},{"kind":"math_inline","t