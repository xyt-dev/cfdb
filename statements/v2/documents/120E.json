{"assets":[],"contentKind":"statement","contestId":"120","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Put Knight!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya and Gena play a very interesting game \"Put a Knight!\" on a chessboard "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" in size. In this game they take turns to put chess pieces called \"knights\" on the board so that no two knights could threat each other. A knight located in square "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" can threat squares "},{"kind":"math_inline","text":"(r - 1, c + 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r - 1, c - 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r + 1, c + 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r + 1, c - 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r - 2, c + 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r - 2, c - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(r + 2, c + 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(r + 2, c - 1)"},{"kind":"text","text":" (some of the squares may be located outside the chessboard). The player who can't put a new knight during his move loses. Determine which player wins considering that both players play optimally well and Petya starts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ T ≤ 100"},{"kind":"text","text":") — the number of boards, for which you should determine the winning player. Next "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ni ≤ 10000"},{"kind":"text","text":") — the sizes of the chessboards."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each "},{"kind":"math_inline","text":"ni × ni"},{"kind":"text","text":" board print on a single line \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" if Petya wins considering both players play optimally well. Otherwise, print \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"120E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/120/problem/E"}