{"assets":[],"contentKind":"statement","contestId":"1417","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Copy-paste"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":" — Hey folks, how do you like this problem?"},{"children":[{"kind":"text","text":"— That'll do it. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"BThero"}],"kind":"container"},{"kind":"text","text":" is a powerful magician. He has got $$$n$$$ piles of candies, the $$$i$$$-th pile initially contains $$$a_i$$$ candies. "},{"children":[{"kind":"text","text":"BThero"}],"kind":"container"},{"kind":"text","text":" can cast a "},{"children":[{"kind":"text","text":"copy-paste"}],"kind":"container"},{"kind":"text","text":" spell as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" He chooses two piles $$$(i, j)$$$ such that $$$1 \\le i, j \\le n$$$ and $$$i \\ne j$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All candies from pile $$$i$$$ are copied into pile $$$j$$$. Formally, the operation $$$a_j := a_j + a_i$$$ is performed. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"BThero"}],"kind":"container"},{"kind":"text","text":" can cast this spell any number of times he wants to — but unfortunately, if some pile contains strictly more than $$$k$$$ candies, he loses his magic power. What is the maximum number of times "},{"children":[{"kind":"text","text":"BThero"}],"kind":"container"},{"kind":"text","text":" can cast the spell without losing his power?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$T$$$ ($$$1 \\le T \\le 500$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 1000$$$, $$$2 \\le k \\le 10^4$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains $$$n$$$ integers $$$a_1$$$, $$$a_2$$$, ..., $$$a_n$$$ ($$$1 \\le a_i \\le k$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$1000$$$, and the sum of $$$k$$$ over all test cases does not exceed $$$10^4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the maximum number of times "},{"children":[{"kind":"text","text":"BThero"}],"kind":"container"},{"kind":"text","text":" can cast the spell without losing his magic power."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2\n1 1\n3 5\n1 2 3\n3 7\n3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n5\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case we get either $$$a = [1, 2]$$$ or $$$a = [2, 1]$$$ after casting the spell for the first time, and it is impossible to cast it again."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1417A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1417/problem/A"}