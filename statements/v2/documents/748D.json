{"assets":[],"contentKind":"statement","contestId":"748","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Santa Claus and a Palindrome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Santa Claus likes palindromes very much. There was his birthday recently. "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of his friends came to him to congratulate him, and each of them presented to him a string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" having the same length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We denote the beauty of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th string by "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". It can happen that "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is negative — that means that Santa doesn't find this string beautiful at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Santa Claus is crazy about palindromes. He is thinking about the following question: what is the maximum possible total beauty of a palindrome which can be obtained by concatenating some (possibly all) of the strings he has? Each present can be used at most once. Note that all strings have "},{"children":[{"kind":"text","text":"the same length"}],"kind":"container"},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that a palindrome is a string that doesn't change after one reverses it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the empty string is a palindrome too, the answer can't be negative. Even if all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s are negative, Santa can obtain the empty string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" divided by space and denoting the number of Santa friends and the length of every string they've presented, respectively ("},{"kind":"math_inline","text":"1 ≤ k, n ≤ 100 000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"n·k  ≤ 100 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains the string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and its beauty "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 10 000 ≤ ai ≤ 10 000"},{"kind":"text","text":"). The string consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters, and its beauty is integer. Some of strings may coincide. Also, equal strings can have different beauties."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the required maximum possible beauty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\nabb 2\naaa -3\nbba -1\nzyz -4\nabb 5\naaa 7\nxyx 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\na 1\na 2\na 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\nabcde 10000\nabcde 10000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Santa can obtain "},{"children":[{"kind":"text","text":"abbaaaxyxaaabba"}],"kind":"container"},{"kind":"text","text":" by concatenating strings "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (in this order)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"748D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/748/problem/D"}