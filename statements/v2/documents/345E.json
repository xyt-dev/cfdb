{"assets":[],"contentKind":"statement","contestId":"345","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Black Cat Rush"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today you go out of your house and immediately notice that something is weird. Around your door there is a swarm of black cats — all tense paws and twitching tails. As you do your first step, they all dart off and start running towards you. It looks like they want to thwart you!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are moving in a straight line from point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"(a, 0)"},{"kind":"text","text":" with velocity "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" black cats around you who want to cross your paths. A cat can move in any direction with velocity at most "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". A cat assumes it has crossed your path if it managed to get to at least one point of your path earlier or at the same time as you got there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given four integers: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", as well as cats' coordinates "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". What is the greatest number of cats who manage to cross your path?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ a ≤ 10000; 1 ≤ v, u ≤ 100; 1 ≤ n ≤ 1000)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"( - 100 ≤ xi, yi ≤ 100)"},{"kind":"text","text":" — location of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all cats are located in distinct points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — what is the greatest number of cats who manage to cross your path?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 5 4\n0 3\n4 -4\n7 0\n-2 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 3 4\n7 5\n5 2\n10 -7\n15 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"345E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/345/problem/E"}