{"assets":[],"contentKind":"statement","contestId":"2042","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Two Subarrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integer arrays $$$a$$$ and $$$b$$$, both of size $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the cost of the subarray $$$[l, r]$$$ as $$$a_l + a_{l + 1} + \\cdots + a_{r - 1} + a_r + b_l + b_r$$$. If $$$l=r$$$, then the cost of the subarray is $$$a_l + 2 \\cdot b_l$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to perform queries of three types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$p$$$ $$$x$$$\" — assign $$$a_{p} := x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$p$$$ $$$x$$$\" — assign $$$b_{p} := x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$3$$$ $$$l$$$ $$$r$$$\" — find "},{"children":[{"kind":"text","text":"two non-empty non-overlapping subarrays"}],"kind":"container"},{"kind":"text","text":" within the segment $$$[l, r]$$$ with the maximum total cost and print their total cost. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$-10^9 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n$$$ integers $$$b_1, b_2, \\dots, b_n$$$ ($$$-10^9 \\le b_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains a single integer $$$q$$$ ($$$1 \\le q \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines contain the queries: one per line. Each query is of one of three types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$p$$$ $$$x$$$\" ($$$1 \\le p \\le n$$$; $$$-10^9 \\le x \\le 10^9$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$p$$$ $$$x$$$\" ($$$1 \\le p \\le n$$$; $$$-10^9 \\le x \\le 10^9$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$3$$$ $$$l$$$ $$$r$$$\" ($$$1 \\le l \\lt r \\le n$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one query of the third type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the third type, print the maximum possible total cost of two non-empty non-overlapping subarrays within the segment $$$[l, r]$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n3 -1 4 -3 2 4 0\n0 6 1 0 -