{"assets":[],"contentKind":"statement","contestId":"345","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Expecting Trouble"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It is Friday the 13th today, and even though you're a modern well-educated person, you can't help feeling a bit nervous about it. You decide to look for evidence against this superstition (or for it). As a first step, you recall all Fridays the 13th in your life and calculate how many of them were unusually bad — like that time when you decided to play a game on ZX Spectrum and ended up breaking your TV set. The problem is, you can't remember some Fridays, and you're not sure why — were they really that bad?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have assembled a sequence of your recollections. Character \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" stands for a normal day, \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" — for a nasty one, and \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" means you have no idea what kind of day that was. Being a programmer, you decide to approximate these unknown days with independent random variables, which take value "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"(1 - p)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a string of your memories and the value of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", calculate out the expected value of average badness of your Fridays the 13th."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" which represents your Fridays; "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" will contain between 1 and 50 characters, inclusive. Each character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" will be \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains a double "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(0 ≤ p ≤ 1)"},{"kind":"text","text":". Double "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is given with at most 2 digits after the decimal point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the expected value of average badness of your Fridays with exactly 5 decimal places. Please, use standard mathematical rules when you are rounding an answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"?111?1??1\n1.0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.00000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"01?10??10000\n0.5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.37500\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, you're doomed. DOOMED! Sorry, just had to say that."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"345A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/345/problem/A"}