{"assets":[],"contentKind":"statement","contestId":"135","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Weak Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya very much likes strings. Recently he has received a voucher to purchase a string as a gift from his mother. The string can be bought in the local shop. One can consider that the shop has all sorts of strings over the alphabet of fixed size. The size of the alphabet is equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". However, the voucher has a string type limitation: specifically, the voucher can be used to purchase string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" if the length of string's longest substring that is also its weak subsequence (see the definition given below) equals "},{"kind":"math_inline","text":"w"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with the length of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is considered the weak subsequence of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with the length of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", if there exists such a set of indexes "},{"kind":"math_inline","text":"1 ≤ i1 < i2 < ... < in ≤ m"},{"kind":"text","text":", that has the following two properties: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ak = sik"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there exists at least one such "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k < n"},{"kind":"text","text":"), for which "},{"kind":"math_inline","text":"ik + 1 – ik > 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Petya got interested how many different strings are available for him to purchase in the shop. As the number of strings can be very large, please find it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). If there are infinitely many such strings, print \"-1\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 106"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ w ≤ 109"},{"kind":"text","text":") — the alphabet size and the required length of the maximum substring that also is the weak subsequence, correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of strings Petya can buy using the voucher, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). If there are infinitely many such strings, print \"-1\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1593\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 139\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"717248223\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Petya can buy the following strings: aaa, aab, abab, abb, abba, baa, baab, baba, bba, bbb."}],"kind":"paragraph"}],"kind":"section"}]