{"assets":[],"contentKind":"statement","contestId":"107","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Darts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The night after the graduation ceremony graduate students of German University in Cairo (GUC) are playing darts. As there's no real dart board available, the photographs of members of the GUC upper management are being used."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rectangular photos are placed on the wall. They can overlap arbitrary and even coincide. The photos are not necessarily placed horizontally or vertically, they could also be rotated before being pinned to the wall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The score of one dart throw is simply the number of photos the dart went through."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fatma has made a throw but her score was not recorded. She only remembers that she did make it into at least one photo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assuming that the probability distribution of the throw is equal across the whole wall, what would be the expectation of Fatma's score?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":") — the number of photos on the wall. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describing the photos, each containing "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" single-space-separated integers (coordinates of "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" vertices): "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y4"},{"kind":"text","text":". Each photo is a rectangle with a nonzero area. The coordinates are integers, not exceeding "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" by absolute value. The coordinates of the rectangle are given in either clockwise or counterclockwise order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the expected score of the throw. The answer will be accepted if it has absolute or relative error not exceeding "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n0 0 0 2 2 2 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n-1 0 0 1 1 0 0 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 0 1 3 1 3 0\n0 0 0 3 1 3 1 0\n3 3 2 3 2 0 3 0\n3 3 3 2 0 2 0 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.5000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n-1 0 0 1 1 0 0 -1\n0 0 1 1 2 0 1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.1428571429\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"107E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/107/problem/E"}