{"assets":[],"contentKind":"statement","contestId":"988","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Substrings Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ strings. Each string consists of lowercase English letters. Rearrange (reorder) the given strings in such a way that for every string, all strings that are placed before it are its "},{"children":[{"kind":"text","text":"substrings"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$a$$$ is a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of string $$$b$$$ if it is possible to choose several "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" letters in $$$b$$$ in such a way that they form $$$a$$$. For example, string \""},{"children":[{"kind":"text","text":"for"}],"kind":"container"},{"kind":"text","text":"\" is contained as a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" in strings \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"for"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"therefore"}],"kind":"container"},{"kind":"text","text":"\", but is not contained as a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" in strings \""},{"children":[{"kind":"text","text":"four"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"fofo"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"rof"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the number of strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain the given strings. The number of letters in each string is from $$$1$$$ to $$$100$$$, inclusive. Each string consists of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some strings might be equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to reorder $$$n$$$ given strings in required order, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) and $$$n$$$ given strings in required order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\na\naba\nabacaba\nba\naba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\na\nba\naba\naba\nabacaba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\na\nabacaba\nba\naba\nabab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nqwerty\nqwerty\nqwerty\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nqwerty\nqwerty\nqwerty\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example you cannot reorder the strings because the string \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" is not a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of the string \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"988B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/988/problem/B"}