{"assets":["/statement-assets/c689d4655666234e710ba18907191edd4f5bbff4a26a5710d5e4df63aa104d23.png"],"contentKind":"statement","contestId":"510","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fox And Two Dots"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel is playing a mobile puzzle game called \"Two Dots\". The basic levels are played on a board of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells, like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c689d4655666234e710ba18907191edd4f5bbff4a26a5710d5e4df63aa104d23.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Each cell contains a dot that has some color. We will use different uppercase Latin characters to express different colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The key of this game is to find a cycle that contain dots of same color. Consider 4 blue dots on the picture forming a circle as an example. Formally, we call a sequence of dots "},{"kind":"math_inline","text":"d1, d2, ..., dk"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"cycle"}],"kind":"container"},{"kind":"text","text":" if and only if it meets the following condition:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" These "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" dots are different: if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":" then "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is different from "},{"kind":"math_inline","text":"dj"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":" is at least 4. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All dots belong to the same color. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all "},{"kind":"math_inline","text":"1 ≤ i ≤ k - 1"},{"kind":"text","text":": "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di + 1"},{"kind":"text","text":" are adjacent. Also, "},{"kind":"math_inline","text":"dk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d1"},{"kind":"text","text":" should also be adjacent. Cells "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are called adjacent if they share an edge. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine if there exists a "},{"children":[{"kind":"text","text":"cycle"}],"kind":"container"},{"kind":"text","text":" on the field."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 50"},{"kind":"text","text":"): the number of rows and columns of the board."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each line contains a string consisting of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters, expressing colors of dots in each line. Each character is an uppercase Latin letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if there exists a "},{"children":[{"kind":"text","text":"cycle"}],"kind":"container"},{"kind":"text","text":", and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\nAAAA\nABCA\nAAAA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\nAAAA\nABCA\nAADA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\nYYYR\nBYBY\nBBBY\nBBBY\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text