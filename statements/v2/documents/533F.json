{"assets":[],"contentKind":"statement","contestId":"533","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Encoding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp invented a new way to encode strings. Let's assume that we have string "},{"kind":"math_inline","text":"T"},{"kind":"text","text":", consisting of lowercase English letters. Let's choose several pairs of letters of the English alphabet in such a way that each letter occurs in at most one pair. Then let's replace each letter in "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" with its pair letter if there is a pair letter for it. For example, if you chose pairs ("},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"q"}],"kind":"container"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"), then word \""},{"children":[{"kind":"text","text":"parallelogram"}],"kind":"container"},{"kind":"text","text":"\" according to the given encoding principle transforms to word \""},{"children":[{"kind":"text","text":"qolorreraglom"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus already has two strings, "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":". He suspects that string "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" was obtained after applying the given encoding method from some substring of string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". Find all positions "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ mi ≤ |S| - |T| + 1"},{"kind":"text","text":"), such that "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" can be obtained fro substring "},{"kind":"math_inline","text":"SmiSmi + 1... Smi + |T| - 1"},{"kind":"text","text":" by applying the described encoding operation by using some set of pairs of English alphabet letters"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, "},{"kind":"math_inline","text":"|S|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|T|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |T| ≤ |S| ≤ 2·105"},{"kind":"text","text":") — the lengths of string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and string "},{"kind":"math_inline","text":"T"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second and third line of the input contain strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":", respectively. Both strings consist only of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of suitable positions in string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"m1, m2, ..., mk"},{"kind":"text","text":" — the numbers of the suitable positions in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 5\nabacabadaba\nacaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"21 13\nparaparallelogramgram\nqolorreraglom\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"533F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/533/problem/F"}