{"assets":[],"contentKind":"statement","contestId":"838","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Binary Blocks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an image, that can be represented with a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-d "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" grid of pixels. Each pixel of the image is either on or off, denoted by the characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", respectively. You would like to compress this image. You want to choose an integer "},{"kind":"math_inline","text":"k > 1"},{"kind":"text","text":" and split the image into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" blocks. If "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" are not divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the image is padded with only zeros on the right and bottom so that they are divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Each pixel in each individual block must have the same value. The given image may not be compressible in its current state. Find the minimum number of pixels you need to toggle (after padding) in order for the image to be compressible for some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". More specifically, the steps are to first choose "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", then the image is padded with zeros, then, we can toggle the pixels so it is compressible for this "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". The image must be compressible in that state."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 2 500"},{"kind":"text","text":"), the dimensions of the image."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of input will contain a binary string with exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters, representing the image."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the minimum number of pixels needed to toggle to make the image compressible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n00100\n10110\n11001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"We first choose "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The image is padded as follows: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n001000\n101100\n110010\n000000\n"},{"children":[{"kind":"text","text":"We can toggle the image to look as follows: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n001100\n001100\n000000\n000000\n"},{"children":[{"kind":"text","text":"We can see that this image is compressible for "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"838A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/838/problem/A"}