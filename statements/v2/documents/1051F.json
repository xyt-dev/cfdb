{"assets":[],"contentKind":"statement","contestId":"1051","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. The Shortest Statement"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a weighed undirected "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":" graph, consisting of $$$n$$$ vertices and $$$m$$$ edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should answer $$$q$$$ queries, the $$$i$$$-th query is to find the shortest distance between vertices $$$u_i$$$ and $$$v_i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m~(1 \\le n, m \\le 10^5, m - n \\le 20)$$$ — the number of vertices and edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$m$$$ lines contain the edges: the $$$i$$$-th edge is a triple of integers $$$v_i, u_i, d_i~(1 \\le u_i, v_i \\le n, 1 \\le d_i \\le 10^9, u_i \\neq v_i)$$$. This triple means that there is an edge between vertices $$$u_i$$$ and $$$v_i$$$ of weight $$$d_i$$$. It is guaranteed that graph contains no self-loops and multiple edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer $$$q~(1 \\le q \\le 10^5)$$$ — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines contains two integers $$$u_i$$$ and $$$v_i~(1 \\le u_i, v_i \\le n)$$$ — descriptions of the queries."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Pay attention to the restriction $$$m - n ~ \\le ~ 20$$$."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$q$$$ lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th line should contain the answer to the $$$i$$$-th query — the shortest distance between vertices $$$u_i$$$ and $$$v_i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n2 3 1\n3 1 5\n3\n1 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 13\n1 2 4\n2 3 6\n3 4 1\n4 5 12\n5 6 3\n6 7 8\n7 8 7\n1 4 1\n1 8 3\n2 6 9\n2 7 1\n4 6 3\n6 8 2\n8\n1 5\n1 7\n2 3\n2 8\n3 7\n3 4\n6 8\n7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n5\n6\n7\n7\n1\n2\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"s