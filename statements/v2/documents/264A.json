{"assets":["/statement-assets/86429e2205b6680772599fbc5ad039ede7be8f449a28c0c006d9261907b2e192.png"],"contentKind":"statement","contestId":"264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Escape from Stones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Squirrel Liss lived in a forest peacefully, but unexpected trouble happens. Stones fall from a mountain. Initially Squirrel Liss occupies an interval "},{"kind":"math_inline","text":"[0, 1]"},{"kind":"text","text":". Next, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stones will fall and Liss will escape from the stones. The stones are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The stones always fall to the center of Liss's interval. When Liss occupies the interval "},{"kind":"math_inline","text":"[k - d, k + d]"},{"kind":"text","text":" and a stone falls to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", she will escape to the left or to the right. If she escapes to the left, her new interval will be "},{"kind":"math_inline","text":"[k - d, k]"},{"kind":"text","text":". If she escapes to the right, her new interval will be "},{"kind":"math_inline","text":"[k, k + d]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is \""},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\", when the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone falls Liss will escape to the left or to the right, respectively. Find the sequence of stones' numbers from left to right after all the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stones falls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of only one line. The only line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 106"},{"kind":"text","text":"). Each character in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" will be either \""},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines — on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line you should print the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone's number from the left."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"llrlr\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n5\n4\n2\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"rrlll\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n5\n4\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"lrlrr\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4\n5\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the positions of stones 1, 2, 3, 4, 5 will be "},{"attrs":{"alt":"","src":"/statement-assets/86429e2205b6680772599fbc5ad039ede7be8f449a28c0c006d9261907b2e192.png"},"kind":"image"},{"kind":"text","text":", respectively. So you should print the sequence: 3, 5, 4, 2, 1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"264A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/264/problem/A"}