{"assets":["/statement-assets/4997d1d73bc6e4a34e6b578283cb45caeb418af193b2788b2298c3ab70f6a906.png"],"contentKind":"statement","contestId":"295","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Yaroslav and Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yaroslav has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points that lie on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis. The coordinate of the first point is "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", the coordinate of the second point is "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", ..., the coordinate of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th point is — "},{"kind":"math_inline","text":"xn"},{"kind":"text","text":". Now Yaroslav wants to execute "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, each of them is of one of the two following types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Move the "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":"-th point from position "},{"kind":"math_inline","text":"xpj"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"xpj + dj"},{"kind":"text","text":". At that, it is guaranteed that after executing such query all coordinates of the points will be distinct. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Count the sum of distances between all pairs of points that lie on the segment "},{"kind":"math_inline","text":"[lj, rj]"},{"kind":"math_inline","text":"(lj ≤ rj)"},{"kind":"text","text":". In other words, you should count the sum of: "},{"attrs":{"alt":"","src":"/statement-assets/4997d1d73bc6e4a34e6b578283cb45caeb418af193b2788b2298c3ab70f6a906.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Yaroslav."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of points "},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":". The second line contains distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" — the coordinates of points "},{"kind":"math_inline","text":"(|xi| ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of queries "},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the queries. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line first contains integer "},{"kind":"math_inline","text":"tj"},{"kind":"math_inline","text":"(1 ≤ tj ≤ 2)"},{"kind":"text","text":" — the query type. If "},{"kind":"math_inline","text":"tj = 1"},{"kind":"text","text":", then it is followed by two integers "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dj"},{"kind":"math_inline","text":"(1 ≤ pj ≤ n, |dj| ≤ 1000)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"tj = 2"},{"kind":"text","text":", then it is followed by two integers "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"rj"},{"kind":"math_inline","text":"( - 109 ≤ lj ≤ rj ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that at any moment all the points have distinct coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each type 2 query print the answer on a single line. Print the answers in the order, in which the queries follow in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":". It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams of the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n36 50 28 -75 40 -60 -95 -48\n20\n2 -61 29\n1 5 -53\n1 1 429\n1 5 130\n2 -101 -71\n2 -69 53\n1 1 404\n1 5 518\n2 -101 53\n2 50 872\n1 1 -207\n2 -99 -40\n1 7 -389\n1 6 -171\n1 2 464\n1 7 -707\n1 1 -730\n1 1 560\n2 635 644\n1 7 -677\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children"