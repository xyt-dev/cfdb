{"assets":["/statement-assets/124f09ade376fd2be8976ddbf7ec27ea9aff666dad388bfe94e22eed58b2d541.png","/statement-assets/d7016a60a55a3a1cb24d94d8a4906c39b86d36926ad5055949b6ae1f329c6e69.png","/statement-assets/70ca10f96ab2d5c4153a4cb7a76575eae7c18c859753b7991b0ef0f421f36053.png"],"contentKind":"statement","contestId":"748","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Santa Claus and Robot"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Santa Claus has Robot which lives on the infinite grid and can move "},{"children":[{"kind":"text","text":"along its lines"}],"kind":"container"},{"kind":"text","text":". He can also, having a sequence of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" points "},{"kind":"math_inline","text":"p1, p2, ..., pm"},{"kind":"text","text":" with integer coordinates, do the following: denote its initial location by "},{"kind":"math_inline","text":"p0"},{"kind":"text","text":". First, the robot will move from "},{"kind":"math_inline","text":"p0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" along one of the shortest paths between them (please notice that since the robot moves only along the grid lines, there can be several shortest paths). Then, after it reaches "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", it'll move to "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", again, choosing one of the shortest ways, then to "},{"kind":"math_inline","text":"p3"},{"kind":"text","text":", and so on, until he has visited all points in the given order. Some of the points in the sequence may coincide, in that case Robot will visit that point several times according to the sequence order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While Santa was away, someone gave a sequence of points to Robot. This sequence is now lost, but Robot saved the protocol of its unit movements. Please, find the minimum possible length of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the only positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") which equals the number of unit segments the robot traveled. The second line contains the movements protocol, which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters, each being equal either "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":". "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th letter stands for the direction which Robot traveled the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th unit segment in: "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" means that it moved to the left, "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" — to the right, "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" — to the top and "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" — to the bottom. Have a look at the illustrations for better explanation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input should contain the minimum possible length of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nRURD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nRRULDD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"26\nRRRULURURUULULLLDLDDRDRDLD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nRLL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nLRLR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The illustrations to the first three tests are given below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/124f09ade376fd2be8976ddbf7ec27ea9aff666dad388bfe94e22eed58b2d541.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/d7016a60a55a3a1cb24d94d8a4906c39b86d36926ad5055949b6ae1f329c6e69.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/70ca10f96ab2d5c4153a4cb7a76575eae7c18c859753b7991b0ef0f421f36053.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last example illustrates that each point in the sequence should be counted as many times as it is presented in the sequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"748C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/748/problem/C"}