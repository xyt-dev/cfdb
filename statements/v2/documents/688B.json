{"assets":[],"contentKind":"statement","contestId":"688","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lovely Palindromes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pari has a friend who loves palindrome numbers. A palindrome number is a number that reads the same forward or backward. For example "},{"kind":"math_inline","text":"12321"},{"kind":"text","text":", "},{"kind":"math_inline","text":"100001"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are palindrome numbers, while "},{"kind":"math_inline","text":"112"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1021"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pari is trying to love them too, but only very special and gifted people can understand the beauty behind palindrome numbers. Pari loves integers with even length (i.e. the numbers with even number of digits), so she tries to see a lot of big palindrome numbers with even length (like a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-digit "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"-digit "},{"kind":"math_inline","text":"122221"},{"kind":"text","text":"), so maybe she could see something in them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Pari asks you to write a program that gets a huge integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the input and tells what is the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th even-length positive palindrome number?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10100 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th even-length palindrome number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1001\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" even-length palindrome numbers are "},{"kind":"math_inline","text":"11, 22, 33, ... , 88, 99"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1001"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"688B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/688/problem/B"}