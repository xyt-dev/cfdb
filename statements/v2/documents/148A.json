{"assets":[],"contentKind":"statement","contestId":"148","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Insomnia cure"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"«One dragon. Two dragon. Three dragon», — the princess was counting. She had trouble falling asleep, and she got bored of counting lambs when she was nine."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, just counting dragons was boring as well, so she entertained herself at best she could. Tonight she imagined that all dragons were here to steal her, and she was fighting them off. Every "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th dragon got punched in the face with a frying pan. Every "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th dragon got his tail shut into the balcony door. Every "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th dragon got his paws trampled with sharp heels. Finally, she threatened every "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th dragon to call her mom, and he withdrew in panic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many imaginary dragons suffered moral or physical damage tonight, if the princess counted a total of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" dragons?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input data contains integer numbers "},{"kind":"math_inline","text":"k, l, m, n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", each number in a separate line ("},{"kind":"math_inline","text":"1 ≤ k, l, m, n ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ d ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of damaged dragons."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n3\n4\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n4\n5\n24\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case every first dragon got punched with a frying pan. Some of the dragons suffered from other reasons as well, but the pan alone would be enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case dragons 1, 7, 11, 13, 17, 19 and 23 escaped unharmed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"148A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/148/problem/A"}