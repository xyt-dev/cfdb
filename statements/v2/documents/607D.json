{"assets":["/statement-assets/0776fddcb2b8b77e40ad3be32bc962622a16c4555b3b02827e518c67e60a3811.png"],"contentKind":"statement","contestId":"607","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Power Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Genos and Saitama went shopping for Christmas trees. However, a different type of tree caught their attention, the exalted Power Tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A Power Tree starts out as a single root vertex indexed "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". A Power Tree grows through a magical phenomenon known as an update. In an "},{"children":[{"kind":"text","text":"update"}],"kind":"container"},{"kind":"text","text":", a single vertex is added to the tree as a child of some other vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every vertex in the tree (the root and all the added vertices) has some value "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" associated with it. The "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of a vertex is defined as the strength of the multiset composed of the value associated with this vertex ("},{"kind":"math_inline","text":"vi"},{"kind":"text","text":") and the "},{"children":[{"kind":"text","text":"powers"}],"kind":"container"},{"kind":"text","text":" of its direct children. The "},{"children":[{"kind":"text","text":"strength"}],"kind":"container"},{"kind":"text","text":" of a multiset is defined as the sum of all elements in the "},{"children":[{"kind":"text","text":"multiset"}],"kind":"container"},{"kind":"text","text":" multiplied by the number of elements in it. Or in other words for some "},{"children":[{"kind":"text","text":"multiset"}],"kind":"container"},{"kind":"math_inline","text":"S"},{"kind":"text","text":": "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0776fddcb2b8b77e40ad3be32bc962622a16c4555b3b02827e518c67e60a3811.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Saitama knows the "},{"children":[{"kind":"text","text":"updates"}],"kind":"container"},{"kind":"text","text":" that will be performed on the tree, so he decided to test Genos by asking him queries about the tree during its growth cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An update is of the form "},{"kind":"math_inline","text":"1 p v"},{"kind":"text","text":", and adds a new vertex with value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" as a child of vertex "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A query is of the form "},{"kind":"math_inline","text":"2 u"},{"kind":"text","text":", and asks for the power of vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Genos respond to these queries modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space separated integers "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v1 < 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 200 000"},{"kind":"text","text":") — the value of vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and the total number of updates and queries respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the updates and queries. Each of them has one of the following forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 pi vi"},{"kind":"text","text":", if these line describes an update. The index of the added vertex is equal to the smallest positive integer not yet used as an index in the tree. It is guaranteed that "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is some already existing vertex and "},{"kind":"math_inline","text":"1 ≤ vi < 109"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 ui"},{"kind":"text","text":", if these line describes a query. It is guaranteed "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" will exist in the tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that the input will contain at least one query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print out the power of the given vertex modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n1 1 3\n1 2 5\n1 3 7\n1 4 11\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"344\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1 1 4\n1 2 3\n2 2\n1 2 7\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n94\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample case, after all the updates the graph will have vertices labelled in the following manner: 1 — 2 — 3 — 4 — 5"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"These vertices will have corresponding values: 2 — 3 — 5 — 7 — 11"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And corresponding powers: 344 — 170 — 82 — 36 — 11"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"607D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/607/problem/D"}