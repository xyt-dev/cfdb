{"assets":[],"contentKind":"statement","contestId":"701","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":") in the deck. Each card has a positive integer written on it. "},{"kind":"math_inline","text":"n / 2"},{"kind":"text","text":" people will play new card game. At the beginning of the game each player gets two cards, each card is given to exactly one player. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the way to distribute cards such that the sum of values written of the cards will be equal for each player. It is guaranteed that it is always possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the number of cards in the deck. It is guaranteed that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is equal to the number written on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n / 2"},{"kind":"text","text":" pairs of integers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair denote the cards that should be given to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player. Each card should be given to exactly one player. Cards are numbered in the order they appear in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that solution exists. If there are several correct answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5 7 4 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n6 2\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_bloc