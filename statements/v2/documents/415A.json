{"assets":[],"contentKind":"statement","contestId":"415","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mashmokh and Lights"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mashmokh works in a factory. At the end of each day he must turn off all of the lights. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lights on the factory are indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" buttons in Mashmokh's room indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" as well. If Mashmokh pushes button with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", then each light with index not less than "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" that is still turned on turns off."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mashmokh is not very clever. So instead of pushing the first button he pushes some of the buttons randomly each night. He pushed "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct buttons "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" (the buttons were pushed consecutively in the given order) this night. Now he wants to know for each light the index of the button that turned this light off. Please note that the index of button "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is actually "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", not "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, help Mashmokh, print these indices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 100)"},{"kind":"text","text":", the number of the factory lights and the pushed buttons respectively. The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bm (1 ≤ bi ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all lights will be turned off after pushing all buttons."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is index of the button that turns the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th light off."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n4 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 3 4 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n5 4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 4 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, after pressing button number 4, lights 4 and 5 are turned off and lights 1, 2 and 3 are still on. Then after pressing button number 3, light number 3 is turned off as well. Pressing button number 1 turns off lights number 1 and 2 as well so pressing button number 2 in the end has no effect. Thus button number 4 turned lights 4 and 5 off, button number 3 turned light 3 off and button number 1 turned light 1 and 2 off."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"415A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/415/problem/A"}