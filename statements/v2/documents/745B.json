{"assets":[],"contentKind":"statement","contestId":"745","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Hongcow Solves A Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hongcow likes solving puzzles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day, Hongcow finds two identical puzzle pieces, with the instructions \"make a rectangle\" next to them. The pieces can be described by an "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" grid of characters, where the character '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' denotes a part of the puzzle and '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' denotes an empty part of the grid. It is guaranteed that the puzzle pieces are one 4-connected piece. See the input format and samples for the exact details on how a jigsaw piece will be specified."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The puzzle pieces are very heavy, so Hongcow "},{"children":[{"kind":"text","text":"cannot rotate or flip"}],"kind":"container"},{"kind":"text","text":" the puzzle pieces. However, he is allowed to move them in any directions. The puzzle pieces also "},{"children":[{"kind":"text","text":"cannot overlap"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given as input the description of one of the pieces. Determine if it is possible to make a rectangle from two identical copies of the given input. The rectangle should be solid, i.e. there should be no empty holes inside it or on its border. Keep in mind that Hongcow is not allowed to flip or rotate pieces and they cannot overlap, i.e. no two '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' from different pieces can share the same position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":"), the dimensions of the puzzle piece."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will describe the jigsaw piece. Each line will have length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and will consist of characters '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' only. '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' corresponds to a part of the puzzle piece, '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' is an empty space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed there is at least one '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' character in the input and that the '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' characters form a 4-connected region."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible for Hongcow to make a rectangle. Output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\nXXX\nXXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n.X\nXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n.....\n..X..\n.....\n.....\n.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"k