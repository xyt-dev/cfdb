{"assets":[],"contentKind":"statement","contestId":"383","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Volcanoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub got lost in a very big desert. The desert can be represented as a "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" square matrix, where each cell is a zone of the desert. The cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" represents the cell at row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ n)"},{"kind":"text","text":". Iahub can go from one cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" only down or right, that is to cells "},{"kind":"math_inline","text":"(i + 1, j)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(i, j + 1)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cells that are occupied by volcanoes, which Iahub cannot enter. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub is initially at cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and he needs to travel to cell "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":". Knowing that Iahub needs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second to travel from one cell to another, find the minimum time in which he can arrive in cell "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 109)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of integers, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(1 ≤ x, y ≤ n)"},{"kind":"text","text":", representing the coordinates of the volcanoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider matrix rows are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom, and matrix columns are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. There is no volcano in cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". No two volcanoes occupy the same location. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer, the minimum time in which Iahub can arrive at cell "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":". If no solution exists (there is no path to the final cell), print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 8\n1 6\n2 6\n3 5\n3 6\n4 3\n5 1\n5 2\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. A possible road is: "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(4, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"383B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/383/problem/B"}