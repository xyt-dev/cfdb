{"assets":["/statement-assets/bab24e6cca5fbcae87fa6aa578dba12c51d9ee95403df5491cb126fe014d0e0a.png","/statement-assets/4bf97429d05b61353b58be16f93f000f61835fb03fb31f79ec5a09fa4136983d.png"],"contentKind":"statement","contestId":"920","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Connected Components?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"attrs":{"alt":"","src":"/statement-assets/bab24e6cca5fbcae87fa6aa578dba12c51d9ee95403df5491cb126fe014d0e0a.png"},"kind":"image"},{"kind":"text","text":" edges. Instead of giving you the edges that exist in the graph, we give you "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" unordered pairs ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":") such that there is no edge between "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", and if some pair of vertices is not listed in the input, then there is an edge between these vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find the number of connected components in the graph and the size of each component. A connected component is a set of vertices "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" such that for every two vertices from this set there exists at least one path in the graph connecting these vertices, but adding any other vertex to "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" violates this rule."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200000"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/4bf97429d05b61353b58be16f93f000f61835fb03fb31f79ec5a09fa4136983d.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each containing a pair of integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":") denoting that "},{"children":[{"kind":"text","text":"there is no edge"}],"kind":"container"},{"kind":"text","text":" between "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Each pair is listed at most once; ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":") and ("},{"kind":"math_inline","text":"y, x"},{"kind":"text","text":") are considered the same (so they are never listed in the same test). If some pair of vertices is not listed in the input, then there "},{"children":[{"kind":"text","text":"exists"}],"kind":"container"},{"kind":"text","text":" an edge between those vertices. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Firstly print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of connected components in this graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers — the sizes of components. You should output these integers in non-descending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1 2\n3 4\n3 2\n4 2\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"920E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/920/problem/E"}