{"assets":[],"contentKind":"statement","contestId":"189","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Counting Rhombi"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have two positive integers "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". Your task is to count the number of rhombi which have the following properties: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Have positive area. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" With vertices at integer points. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All vertices of the rhombi are located inside or on the border of the rectangle with vertices at points "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(w, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(w, h)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, h)"},{"kind":"text","text":". In other words, for all vertices "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" of the rhombus the following conditions should fulfill: "},{"kind":"math_inline","text":"0 ≤ xi ≤ w"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"0 ≤ yi ≤ h"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Its diagonals are parallel to the axis. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Count the number of such rhombi."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that a "},{"children":[{"kind":"text","text":"rhombus"}],"kind":"container"},{"kind":"text","text":" is a quadrilateral whose four sides all have the same length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"math_inline","text":"(1 ≤ w, h ≤ 4000)"},{"kind":"text","text":" — the rectangle's sizes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of sought rhombi."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs