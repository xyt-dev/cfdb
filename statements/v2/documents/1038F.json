{"assets":[],"contentKind":"statement","contestId":"1038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Wrap Around"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of distinct "},{"children":[{"kind":"text","text":"cyclical"}],"kind":"container"},{"kind":"text","text":" binary strings of length $$$n$$$ which contain $$$s$$$ as a substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cyclical string $$$t$$$ contains $$$s$$$ as a substring if there is some cyclical shift of string $$$t$$$, such that $$$s$$$ is a substring of this cyclical shift of $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the cyclical string \""},{"children":[{"kind":"text","text":"000111"}],"kind":"container"},{"kind":"text","text":"\" contains substrings \""},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"01110"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":"\", but doesn't contain \""},{"children":[{"kind":"text","text":"0110"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"10110"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two cyclical strings are called different if they differ from each other as strings. For example, two different strings, which differ from each other by a cyclical shift, are still considered "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" cyclical strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 40$$$) — the length of the target string $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains the string $$$s$$$ ($$$1 \\le |s| \\le n$$$) — the string which must be a substring of cyclical string $$$t$$$. String $$$s$$$ contains only characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the number of distinct cyclical binary strings $$$t$$$, which contain $$$s$$$ as a substring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20\n10101010101010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"962"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are three cyclical strings, which contain \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" — \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there are only two such strings — \""},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1038F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1038/problem/F"}