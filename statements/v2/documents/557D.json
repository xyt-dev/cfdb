{"assets":["/statement-assets/fcab441012272fe44deded5933b4b184860c42c4c6af0ebc52b7677af23be326.png"],"contentKind":"statement","contestId":"557","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vitaly and Cycle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After Vitaly was expelled from the university, he became interested in the graph theory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vitaly especially liked the cycles of an odd length in which each vertex occurs at most once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vitaly was wondering how to solve the following problem. You are given an undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges, not necessarily connected, without parallel edges and loops. You need to find "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the minimum number of edges that must be added to the given graph in order to form a simple cycle of an odd length, consisting of more than one vertex. Moreover, he must find "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the number of ways to add "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" edges in order to form a cycle of an odd length (consisting of more than one vertex). It is prohibited to add loops or parallel edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two ways to add edges to the graph are considered equal if they have the same sets of added edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since Vitaly does not study at the university, he asked you to help him with this task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/fcab441012272fe44deded5933b4b184860c42c4c6af0ebc52b7677af23be326.png"},"kind":"image"},{"kind":"text","text":" — the number of vertices in the graph and the number of edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the edges of the graph, one edge per line. Each edge is given by a pair of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":") — the vertices that are connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. All numbers in the lines are separated by a single space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph doesn't contain any loops and parallel edges. The graph isn't necessarily connected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in the first line of the output two space-separated integers "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the minimum number of edges that should be added to the graph to form a simple cycle of an odd length consisting of more than one vertex where each vertex occurs at most once, and the number of ways to do this."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2\n1 3\n4 2\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The simple cycle is a cycle that doesn't contain any vertex twice."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"557D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/557/problem/D"}