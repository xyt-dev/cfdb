{"assets":[],"contentKind":"statement","contestId":"117","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Very Interesting Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a very ancient country the following game was popular. Two people play the game. Initially first player writes a string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", consisting of exactly nine digits and representing a number that does not exceed "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". After that second player looks at "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and writes a string "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", consisting of exactly nine digits and representing a number that does not exceed "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Here "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are some given constants, "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" are chosen by the players. The strings are allowed to contain leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If a number obtained by the concatenation (joining together) of strings "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":", then the second player wins. Otherwise the first player wins. You are given numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":". Your task is to determine who wins if both players play in the optimal manner. If the first player wins, you are also required to find the lexicographically minimum winning move."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a, b ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ mod ≤ 107"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the first player wins, print \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and the lexicographically minimum string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" he has to write to win. If the second player wins, print the single number \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 000000001\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The lexical comparison of strings is performed by the < operator in modern programming languages. String "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is lexicographically less than string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if exists such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ 9"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"xi < yi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"xj = yj"},{"kind":"text","text":". These strings always have length 9."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"117B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/117/problem/B"}