{"assets":["/statement-assets/e02d76184c8baf030531f04128a1cdba791441454e1b11e54b111f411c3c64d6.png"],"contentKind":"statement","contestId":"86","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Powerful array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An array of positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is given. Let us consider its arbitrary subarray "},{"kind":"math_inline","text":"al, al + 1..., ar"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":". For every positive integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" denote by "},{"kind":"math_inline","text":"Ks"},{"kind":"text","text":" the number of occurrences of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into the subarray. We call the "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the subarray the sum of products "},{"kind":"math_inline","text":"Ks·Ks·s"},{"kind":"text","text":" for every positive integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The sum contains only finite number of nonzero summands as the number of different values in the array is indeed finite."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should calculate the power of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" given subarrays."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, t ≤ 200000"},{"kind":"text","text":") — the array length and the number of queries correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") — the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contain two positive integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") each — the indices of the left and the right ends of the corresponding subarray."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the output should contain single positive integer — the power of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query subarray."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preferred to use "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" stream (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2 1\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 3\n1 1 2 2 1 3 1 1\n2 7\n1 6\n2 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n20\n20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the following array (see the second sample) and its [2, 7] subarray (elements of the subarray are colored): "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e02d76184c8baf030531f04128a1cdba791441454e1b11e54b111f411c3c64d6.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Then "},{"kind":"math_inline","text":"K1 = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"K2 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"K3 = 1"},{"kind":"text","text":", so the power is equal to "},{"kind":"math_inline","text":"32·1 + 22·2 + 12·3 = 20"},{"kind":"text","text":"."}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"86D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/86/problem/D"}