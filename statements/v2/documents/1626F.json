{"assets":[],"contentKind":"statement","contestId":"1626","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. A Random Code Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer array $$$a_0, a_1, \\dots, a_{n - 1}$$$, and an integer $$$k$$$. You perform the following code with it:"}],"kind":"paragraph"},{"kind":"code_block","text":"long long ans = 0; // create a 64-bit signed variable which is initially equal to 0\nfor(int i = 1; i <= k; i++)\n{\n  int idx = rnd.next(0, n - 1); // generate a random integer between 0 and n - 1, both inclusive\n                                // each integer from 0 to n - 1 has the same probability of being chosen\n  ans += a[idx];\n  a[idx] -= (a[idx] % i);\n}\n"},{"children":[{"kind":"text","text":"Your task is to calculate the expected value of the variable "},{"children":[{"kind":"text","text":"ans"}],"kind":"container"},{"kind":"text","text":" after performing this code."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the input is generated according to special rules (see the input format section)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains six integers $$$n$$$, $$$a_0$$$, $$$x$$$, $$$y$$$, $$$k$$$ and $$$M$$$ ($$$1 \\le n \\le 10^7$$$; $$$1 \\le a_0, x, y \\lt M \\le 998244353$$$; $$$1 \\le k \\le 17$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The array $$$a$$$ in the input is constructed as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_0$$$ is given in the input; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for every $$$i$$$ from $$$1$$$ to $$$n - 1$$$, the value of $$$a_i$$$ can be calculated as $$$a_i = (a_{i - 1} \\cdot x + y) \\bmod M$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let the expected value of the variable "},{"children":[{"kind":"text","text":"ans"}],"kind":"container"},{"kind":"text","text":" after performing the code be $$$E$$$. It can be shown that $$$E \\cdot n^k$$$ is an integer. You have to output this integer modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 10 3 5 13 88\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n382842030\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 15363 270880 34698 17 2357023\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n319392398\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The array in the first example test is $$$[10, 35, 22]$$$. In the second example, it is $$$[15363, 1418543]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1626F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1626/problem/F"}