{"assets":[],"contentKind":"statement","contestId":"1665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. GCD vs LCM"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. You have to find $$$4$$$ "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a, b, c, d$$$ such that"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a + b + c + d = n$$$, and"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(a, b) = \\operatorname{lcm}(c, d)$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are several possible answers you can output any of them. It is possible to show that the answer always exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem $$$\\gcd(a, b)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor"}],"kind":"link"},{"kind":"text","text":" of $$$a$$$ and $$$b$$$, and $$$\\operatorname{lcm}(c, d)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Least_common_multiple"},"children":[{"kind":"text","text":"least common multiple"}],"kind":"link"},{"kind":"text","text":" of $$$c$$$ and $$$d$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains a single line with integer $$$n$$$ ($$$4 \\le n \\le 10^9$$$) — the sum of $$$a$$$, $$$b$$$, $$$c$$$, and $$$d$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output $$$4$$$ "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a$$$, $$$b$$$, $$$c$$$, $$$d$$$ such that $$$a + b + c + d = n$$$ and $$$\\gcd(a, b) = \\operatorname{lcm}(c, d)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\n7\n8\n9\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 1 1 1\n2 2 2 1\n2 2 2 2\n2 4 2 1\n3 5 1 1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case $$$\\gcd(1, 1) = \\operatorname{lcm}(1, 1) = 1$$$, $$$1 + 1 + 1 + 1 = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case $$$\\gcd(2, 2) = \\operatorname{lcm}(2, 1) = 2$$$, $$$2 + 2 + 2 + 1 = 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case $$$\\gcd(2, 2) = \\operatorname{lcm}(2, 2) = 2$$$, $$$2 + 2 + 2 + 2 = 8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case $$$\\gcd(2, 4) = \\operatorname{lcm}(2, 1) = 2$$$, $$$2 + 4 + 2 + 1 = 9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case $$$\\gcd(3, 5) = \\operatorname{lcm}(1, 1) = 1$$$, $$$3 + 5 + 1 + 1 = 10$$$. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1665A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1665/problem/A"}