{"assets":[],"contentKind":"statement","contestId":"2161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Left is Always Right"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a binary string of length $$$n$$$ and an odd number $$$k$$$. We will call the binary string "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if for each substring of length $$$k$$$, the leftmost character of the substring occurs more than the other. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$k = 3$$$, "},{"children":[{"kind":"text","text":"000101"}],"kind":"container"},{"kind":"text","text":" is a good string, because for all substrings of length 3 ("},{"children":[{"kind":"text","text":"000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":") the first character of the substring occurs more than the other character. On the other hand, "},{"children":[{"kind":"text","text":"1011"}],"kind":"container"},{"kind":"text","text":" is not good, because the property is false for "},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a pattern of length $$$n$$$ consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":", find the number of ways to replace question marks with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", such that the resulting binary string is good. Since the answer may be large, find it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^3$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$3 \\le k \\le n \\le 10^5$$$, $$$k$$$ is odd). The second line contains $$$n$$$ characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" — the pattern."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the number of ways to replace "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" such that the resulting string is good, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5 3\n0??0?\n7 7\n1??1??1\n9 5\n?????????\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n15\n46\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, three valid ways to make the pattern good are "},{"children":[{"kind":"text","text":"00000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"00001"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"00101"}],"kind":"container"},{"kind":"text","text":". In the second example, the only invalid way (out of 16 total ways) is "},{"children":[{"kind":"text","text":"1001001"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2161E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2161/problem/E"}