{"assets":[],"contentKind":"statement","contestId":"66","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Petya and Java"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya has recently started attending a programming club. Naturally he is facing the problem of choosing a programming language. After long considerations he realized that Java is the best choice. The main argument in favor of choosing Java was that it has a very large integer data type, called BigInteger."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But having attended several classes of the club, Petya realized that not all tasks require using the BigInteger type. It turned out that in some tasks it is much easier to use small data types. That's why a question arises: \"Which integer type to use if one wants to store a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"?\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya knows only 5 integer types:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) "},{"children":[{"kind":"text","text":"byte"}],"kind":"container"},{"kind":"text","text":" occupies 1 byte and allows you to store numbers from "},{"kind":"math_inline","text":" - 128"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"127"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) "},{"children":[{"kind":"text","text":"short"}],"kind":"container"},{"kind":"text","text":" occupies 2 bytes and allows you to store numbers from "},{"kind":"math_inline","text":" - 32768"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"32767"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) "},{"children":[{"kind":"text","text":"int"}],"kind":"container"},{"kind":"text","text":" occupies 4 bytes and allows you to store numbers from "},{"kind":"math_inline","text":" - 2147483648"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2147483647"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"4) "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" occupies 8 bytes and allows you to store numbers from "},{"kind":"math_inline","text":" - 9223372036854775808"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9223372036854775807"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"5) "},{"children":[{"kind":"text","text":"BigInteger"}],"kind":"container"},{"kind":"text","text":" can store any integer number, but at that it is not a primitive type, and operations with it are much slower."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all the types given above the boundary values are included in the value range."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From this list, Petya wants to choose the smallest type that can store a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Since BigInteger works much slower, Peter regards it last. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It consists of no more than "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" digits and doesn't contain any leading zeros. The number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" can't be represented as an empty string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preffered to use "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the first type from the list \""},{"children":[{"kind":"text","text":"byte"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"short"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"int"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"BigInteger"}],"kind":"container"},{"kind":"text","text":"\", that can store the natural number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", in accordance with the data given above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"127\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"byte\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"130\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"short\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123456789101112131415161718192021222324\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"BigInteger\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"66A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/66/problem/A"}