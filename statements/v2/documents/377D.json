{"assets":[],"contentKind":"statement","contestId":"377","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Developing Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pavel is going to make a game of his dream. However, he knows that he can't make it on his own so he founded a development company and hired "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" workers of staff. Now he wants to pick "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" workers from the staff who will be directly responsible for developing a game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each worker has a certain skill level "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". Besides, each worker doesn't want to work with the one whose skill is very different. In other words, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th worker won't work with those whose skill is less than "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", and with those whose skill is more than "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pavel understands that the game of his dream isn't too hard to develop, so the worker with any skill will be equally useful. That's why he wants to pick a team of the maximum possible size. Help him pick such team."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of workers Pavel hired."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ vi ≤ ri ≤ 3·105"},{"kind":"text","text":") — the minimum skill value of the workers that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th worker can work with, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th worker's skill and the maximum skill value of the workers that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th worker can work with."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of workers Pavel must pick for developing the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers — the numbers of the workers in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 8 9\n1 4 7\n3 6 8\n5 8 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3 5 16\n1 6 11\n4 8 12\n7 9 16\n2 10 14\n8 13 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"377D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/377/problem/D"}