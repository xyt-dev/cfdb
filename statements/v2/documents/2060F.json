{"assets":[],"contentKind":"statement","contestId":"2060","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Multiplicative Arrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You're given integers $$$k$$$ and $$$n$$$. For each integer $$$x$$$ from $$$1$$$ to $$$k$$$, count the number of integer arrays $$$a$$$ such that all of the following are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\leq |a| \\leq n$$$ where $$$|a|$$$ represents the length of $$$a$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1 \\leq a_i \\leq k$$$ for all $$$1 \\leq i \\leq |a|$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1 \\times a_2 \\times \\dots \\times a_{|a|}=x$$$ (i.e., the product of all elements is $$$x$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that two arrays $$$b$$$ and $$$c$$$ are different if either their lengths are different, or if there exists an index $$$1 \\leq i \\leq |b|$$$ such that $$$b_i\\neq c_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t\\leq 10^3$$$) — the number of independent test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$k$$$ and $$$n$$$ ($$$1 \\leq k \\leq 10^5, 1\\leq n \\leq 9\\cdot 10^8$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$k$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$k$$$ space-separated integers on a new line: the number of arrays for $$$x=1,2,\\ldots,k$$$, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2\n4 3\n10 6969420\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 3\n3 6 6 10\n6969420 124188773 124188773 729965558 124188773 337497990 124188773 50981194 729965558 337497990\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are $$$2$$$ arrays $$$a$$$ with $$$|a|\\leq 2$$$ and the product of elements equal to $$$1$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1,1]$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There are $$$3$$$ arrays $$$a$$$ with $$$|a|\\leq 2$$$ and the product of elements equal to $$$2$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[2]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1,2]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2,1]$$$ "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2060F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2060/problem/F"}