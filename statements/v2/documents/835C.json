{"assets":[],"contentKind":"statement","contestId":"835","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Star sky"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Cartesian coordinate system is set in the sky. There you can see "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stars, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th has coordinates ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"), a maximum brightness "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", equal for all stars, and an initial brightness "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ si ≤ c"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Over time the stars twinkle. At moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th star has brightness "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". Let at moment "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" some star has brightness "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Then at moment "},{"kind":"math_inline","text":"(t + 1)"},{"kind":"text","text":" this star will have brightness "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"x + 1 ≤ c"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to look at the sky "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" times. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th time you will look at the moment "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and you will see a rectangle with sides parallel to the coordinate axes, the lower left corner has coordinates ("},{"kind":"math_inline","text":"x1i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1i"},{"kind":"text","text":") and the upper right — ("},{"kind":"math_inline","text":"x2i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2i"},{"kind":"text","text":"). For each view, you want to know the total brightness of the stars lying in the viewed rectangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A star lies in a rectangle if it lies on its border or lies strictly inside it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ c ≤ 10"},{"kind":"text","text":") — the number of the stars, the number of the views and the maximum brightness of the stars."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the stars description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from these lines contains three integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ si ≤ c ≤ 10"},{"kind":"text","text":") — the coordinates of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th star and its initial brightness."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the views description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from these lines contains five integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ti ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x1i < x2i ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1i < y2i ≤ 100"},{"kind":"text","text":") — the moment of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th view and the coordinates of the viewed rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each view print the total brightness of the viewed stars."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"t