}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are $$$11$$$ different arrays of sets possible, which are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[\\{\\}, \\{\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{\\}, \\{1\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{\\}, \\{1, 2\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{\\}, \\{2\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{1\\}, \\{\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{1\\}, \\{1, 2\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{1\\}, \\{2\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{1, 2\\}, \\{\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{1, 2\\}, \\{1\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{2\\}, \\{\\}]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[\\{2\\}, \\{1\\}]$$$ "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1866H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1866/problem/H"}