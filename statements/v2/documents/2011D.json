{"assets":[],"contentKind":"statement","contestId":"2011","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Among Wolves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a game you started playing recently, there is a field that can be represented as a rectangular grid. The field has $$$2$$$ rows and $$$n$$$ columns — $$$2n$$$ cells in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some cells are empty, but some are occupied by wolves. In the beginning of the game, you have one sheep in some cell, and you'd like to save it from wolves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Wolves will attack you at night, so you still have some time for preparation. You have two ways to deal with wolves: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" You pay $$$h$$$ coins to hunters and choose a cell occupied by a wolf. Hunters will clear the cell, eradicating the wolf in it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You pay $$$b$$$ coins to builders and choose an empty cell. Builders will dig a trench in the chosen cell that wolves can't cross. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" You can use both methods mentioned above any number of times and in any order."},{"children":[{"kind":"text","text":"Let's say that a wolf can reach the sheep if there is a path that starts at the wolf's cell and finishes at the sheep's cell. This path shouldn't contain any cells with trenches, and each two consecutive cells in the path should be neighbors (share a side)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum total amount of money you should pay to ensure that none of the wolves can reach the sheep?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1200$$$) — the number of test cases. Next, $$$t$$$ independent cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers $$$n$$$, $$$h$$$, and $$$b$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$; $$$1 \\le h, b \\le 10^9$$$) — the size of the grid and corresponding costs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next two lines contain a description of the grid. The $$$j$$$-th character in the $$$i$$$-th line is either '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"': "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' means that the cell is empty; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"' means that the cell is occupied by the sheep; there is exactly one such cell on the grid; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' means that the cell is occupied by a wolf. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraints: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"there are no wolves in cells neighboring the sheep cell"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of $$$n$$$ over all test cases doesn't exceed $$$2 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the minimum total amount of money you should pay to save your sheep."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 3 7\nS.\n..\n2 3 7\nS.\n.W\n2 7 3\nS.\n.W\n4 999999999 1000000000\nW.S.\nW..W\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n3\n6\n2999999997\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n6 6 7\nW....W\nW.S..W\n6 6 7\nW...WW\n..S..W\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One of the optimal strategies in the first test case of the second test can be shown like this: "}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"W....W"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\Rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"W.#..W"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"W.S..W"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"W#S#.W"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"kind":"text","text":" Analogically, one of the answers for the second case is the following: "},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"W...WW"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\Rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"..#WW"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"..S..W"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"..S#.W"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"kind":"text","text":" Here, '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' means a trench and '"},{"children":[{"children":[{"kind":"text","text":"W"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"' means an eradicated wolf."}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2011D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2011/problem/D"}