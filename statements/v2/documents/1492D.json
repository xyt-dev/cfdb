{"assets":[],"contentKind":"statement","contestId":"1492","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Genius's Gambit"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three integers $$$a$$$, $$$b$$$, $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find two "},{"children":[{"kind":"text","text":"binary"}],"kind":"container"},{"kind":"text","text":" integers $$$x$$$ and $$$y$$$ ($$$x \\ge y$$$) such that "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" both $$$x$$$ and $$$y$$$ consist of $$$a$$$ zeroes and $$$b$$$ ones; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x - y$$$ (also written in binary form) has exactly $$$k$$$ ones. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" You are "},{"children":[{"kind":"text","text":"not allowed to use leading zeros for $$$x$$$ and $$$y$$$"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers $$$a$$$, $$$b$$$, and $$$k$$$ ($$$0 \\leq a$$$; $$$1 \\leq b$$$; $$$0 \\leq k \\leq a + b \\leq 2 \\cdot 10^5$$$) — the number of zeroes, ones, and the number of ones in the result."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's possible to find two suitable integers, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" followed by $$$x$$$ and $$$y$$$ in base-2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n101000\n100001\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n10100\n10010\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, $$$x = 101000_2 = 2^5 + 2^3 = 40_{10}$$$, $$$y = 100001_2 = 2^5 + 2^0 = 33_{10}$$$, $$$40_{10} - 33_{10} = 7_{10} = 2^2 + 2^1 + 2^0 = 111_{2}$$$. Hence $$$x-y$$$ has $$$3$$$ ones in base-2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, $$$x = 10100_2 = 2^4 + 2^2 = 20_{10}$$$, $$$y = 10010_2 = 2^4 + 2^1 = 18$$$, $$$x - y = 20 - 18 = 2_{10} = 10_{2}$$$. This is precisely one 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, one may show, that it's impossible to find an answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1492D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1492/problem/D"}