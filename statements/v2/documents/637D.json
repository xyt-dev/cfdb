{"assets":[],"contentKind":"statement","contestId":"637","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Running with Obstacles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sportsman starts from point "},{"kind":"math_inline","text":"xstart = 0"},{"kind":"text","text":" and runs to point with coordinate "},{"kind":"math_inline","text":"xfinish = m"},{"kind":"text","text":" (on a straight line). Also, the sportsman can jump — to jump, he should first take a run of length of not less than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" meters (in this case for these "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" meters his path should have no obstacles), and after that he can jump over a length of not more than "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" meters. Running and jumping is permitted only in the direction from left to right. He can "},{"children":[{"kind":"text","text":"start"}],"kind":"container"},{"kind":"text","text":" and"},{"children":[{"kind":"text","text":"finish"}],"kind":"container"},{"kind":"text","text":" a jump only at the points with integer coordinates in which there are "},{"children":[{"kind":"text","text":"no obstacles"}],"kind":"container"},{"kind":"text","text":". To overcome some obstacle, it is necessary to land at a point which is strictly to the right of this obstacle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the way of an athlete are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" obstacles at coordinates "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". He cannot go over the obstacles, he can only jump over them. Your task is to determine whether the athlete will be able to get to the finish point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input containsd four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ m ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s, d ≤ 109"},{"kind":"text","text":") — the number of obstacles on the runner's way, the coordinate of the finishing point, the length of running before the jump and the maximum length of the jump, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ m - 1"},{"kind":"text","text":") — the coordinates of the obstacles. It is guaranteed that the starting and finishing point have no obstacles, also no point can have more than one obstacle, The coordinates of the obstacles are given in an arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the runner cannot reach the finishing point, print in the first line of the output \""},{"children":[{"kind":"text","text":"IMPOSSIBLE"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the athlete can get from start to finish, print any way to do this in the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" print a line of form \""},{"children":[{"kind":"text","text":"RUN X"}],"kind":"container"},{"kind":"text","text":">\" (where \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" should be a positive integer), if the athlete should run for \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" more meters; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" print a line of form \""},{"children":[{"kind":"text","text":"JUMP Y"}],"kind":"container"},{"kind":"text","text":"\" (where \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\" should be a positive integer), if the sportsman starts a jump and should remain in air for \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\" more meters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All commands \""},{"children":[{"kind":"text","text":"RUN"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"JUMP"}],"kind":"container"},{"kind":"text","text":"\" should strictly alternate, starting with \""},{"children":[{"kind":"text","text":"RUN"}],"kind":"container"},{"kind":"text","text":"\", besides, they should be printed chronologically. It is not allowed to jump over the finishing point but it is allowed to land there after a jump. The athlete should stop as soon as he reaches finish."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 1 3\n3 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"RUN 2\nJUMP 3\nRUN 1\nJUMP 2\nRUN 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 9 2 3\n6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"IMPOSSIBLE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"637D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/637/problem/D"}