{"assets":["/statement-assets/14c8ba43bfcdd7c2c6d569466460d28369a0e85e85a2318e8ac9db8fdb504a3a.png"],"contentKind":"statement","contestId":"311","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. The Closest Pair"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Currently Tiny is learning Computational Geometry. When trying to solve a problem called \"The Closest Pair Of Points In The Plane\", he found that a code which gave a wrong time complexity got Accepted instead of Time Limit Exceeded."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem is the follows. Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points in the plane, find a pair of points between which the distance is minimized. Distance between "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/statement-assets/14c8ba43bfcdd7c2c6d569466460d28369a0e85e85a2318e8ac9db8fdb504a3a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pseudo code of the unexpected code is as follows:"}],"kind":"paragraph"},{"kind":"code_block","text":"\ninput n\nfor i from 1 to n\n    input the i-th point's coordinates into p[i]\nsort array p[] by increasing of x coordinate first and increasing of y coordinate second\nd=INF        //here INF is a number big enough\ntot=0\nfor i from 1 to n\n    for j from (i+1) to n\n        ++tot\n        if (p[j].x-p[i].x>=d) then break    //notice that \"break\" is only to be\n                                            //out of the loop \"for j\"\n        d=min(d,distance(p[i],p[j]))\noutput d\n"},{"children":[{"kind":"text","text":"Here, "},{"kind":"math_inline","text":"tot"},{"kind":"text","text":" can be regarded as the running time of the code. Due to the fact that a computer can only run a limited number of operations per second, "},{"kind":"math_inline","text":"tot"},{"kind":"text","text":" should not be more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in order not to get Time Limit Exceeded."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are a great hacker. Would you please help Tiny generate a test data and let the code get Time Limit Exceeded?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line which contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there doesn't exist such a data which let the given code get TLE, print \""},{"children":[{"kind":"text","text":"no solution"}],"kind":"container"},{"kind":"text","text":"\" (without quotes); else print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"math_inline","text":"(|xi|, |yi| ≤ 109)"},{"kind":"text","text":" representing the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The conditions below must be held:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All the points must be distinct. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"|xi|, |yi| ≤ 109"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After running the given code, the value of "},{"kind":"math_inline","text":"tot"},{"kind":"text","text":" should be larger than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n0 1\n1 0\n1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"no solution\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"311A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/311/problem/A"}