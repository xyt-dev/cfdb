{"assets":["/statement-assets/10a2ad30e5a4aad77194b1435c848ac56bd9a3a8ac1b89aa6ac2e61889864abf.png","/statement-assets/bc5188c5cb6a2bca1ea04391447d8c0df9d88e0a3c6f3497de24cb16f47fbbf0.png"],"contentKind":"statement","contestId":"1819","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. The Fox and the Complete Tree Traversal"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The fox Yae climbed the "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" of the Sacred Sakura. A tree is a connected undirected graph that does not contain cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fox uses her magical powers to move around the tree. Yae can jump from vertex $$$v$$$ to another vertex $$$u$$$ if and only if the distance between these vertices does not exceed $$$2$$$. In other words, in one jump Yae can jump from vertex $$$v$$$ to vertex $$$u$$$ if vertices $$$v$$$ and $$$u$$$ are connected by an edge, or if there exists such vertex $$$w$$$ that vertices $$$v$$$ and $$$w$$$ are connected by an edge, and also vertices $$$u$$$ and $$$w$$$ are connected by an edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After Yae was able to get the sakura petal, she wondered if there was a "},{"children":[{"kind":"text","text":"cyclic"}],"kind":"container"},{"kind":"text","text":" route in the tree $$$v_1, v_2, \\ldots, v_n$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the fox can jump from vertex $$$v_i$$$ to vertex $$$v_{i + 1}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the fox can jump from vertex $$$v_n$$$ to vertex $$$v_1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all $$$v_i$$$ are pairwise distinct. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help the fox determine if the required traversal exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) —the number of vertices of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$n - 1$$$ lines contains two integers $$$u$$$ and $$$v$$$ ($$$1 \\le u, v \\le n$$$, $$$u \\ne v$$$) — vertices connected by an edge. It is guaranteed that these edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the required route of the tree exists, or \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required tree traversal exists, on the second line print $$$n$$$ integers of different integers $$$v_1, v_2, \\ldots, v_n$$$ ($$$1 \\le v_i \\le n$$$) — the vertices of the tree in traversal order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several correct traversals, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n1 3\n3 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n4 5 1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n15\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7\n4 8\n4 9\n5 10\n5 11\n6 12\n6 13\n7 14\n7 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree from the first example is shown below. The bold arrows indicate the fox's route."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/10a2ad30e5a4aad77194b1435c848ac56bd9a3a8ac1b89aa6ac2e61889864abf.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, any sequence of three different vertices is a correct route, because the fox can jump from any vertex to any vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tree from the third example is shown below. It can be shown that there is no required route for it."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bc5188c5cb6a2bca1ea04391447d8c0df9d88e0a3c6f3497de24cb16f47fbbf0.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1819C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1819/problem/C"}