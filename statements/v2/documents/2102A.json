{"assets":[],"contentKind":"statement","contestId":"2102","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Dinner Time"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given four integers $$$n$$$, $$$m$$$, $$$p$$$, and $$$q$$$, determine whether there exists an integer array $$$a_1, a_2, \\ldots, a_n$$$ (elements may be negative) satisfying the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The sum of all elements in the array is equal to $$$m$$$: $$$$$$a_1 + a_2 + \\ldots + a_n = m$$$$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The sum of every $$$p$$$ consecutive elements is equal to $$$q$$$: $$$$$$a_i + a_{i + 1} + \\ldots + a_{i + p - 1} = q,\\qquad\\text{ for all }1\\le i\\le n-p+1$$$$$$ "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains four integers $$$n$$$, $$$m$$$, $$$p$$$, and $$$q$$$ ($$$1 \\le p \\le n \\le 100$$$, $$$1 \\le q, m \\le 100$$$) — the length of the array, the sum of elements, the length of a segment, and the sum of a segment, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there exists an array satisfying the above conditions, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in any case (for example, strings \""},{"children":[{"kind":"text","text":"yES"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" will all be recognized as valid responses)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 2 2 1\n1 1 1 1\n5 4 2 3\n10 7 5 2\n4 4 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, an example of an array satisfying the condition is $$$[1, 0, 1]$$$. This is because:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1+a_2+a_3 = 1+0+1 = 2 = m$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1+a_2=1+0=1=q$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2+a_3=0+1=1=q$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, the only array satisfying the condition is $$$[1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, an example of an array satisfying the condition is $$$[-2, 5, -2, 5, -2]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, it can be proven that there is no array satisfying the condition."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2102A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2102/problem/A"}