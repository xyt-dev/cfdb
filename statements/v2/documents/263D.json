{"assets":[],"contentKind":"statement","contestId":"263","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cycle in Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a undirected graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. We will consider the nodes of the graph indexed by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We know that each node of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" is connected by edges with at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" other nodes of this graph. Your task is to find in the given graph a simple cycle of length of at least "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"simple cycle"}],"kind":"container"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"d"},{"kind":"math_inline","text":"(d > 1)"},{"kind":"text","text":" in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" is a sequence of distinct graph nodes "},{"kind":"math_inline","text":"v1, v2, ..., vd"},{"kind":"text","text":" such, that nodes "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vd"},{"kind":"text","text":" are connected by an edge of the graph, also for any integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < d)"},{"kind":"text","text":" nodes "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":" are connected by an edge of the graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(3 ≤ n, m ≤ 105; 2 ≤ k ≤ n - 1)"},{"kind":"text","text":" — the number of the nodes of the graph, the number of the graph's edges and the lower limit on the degree of the graph node. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":" — the indexes of the graph nodes that are connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph doesn't contain any multiple edges or self-loops. It is guaranteed that each node of the graph is connected by the edges with at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" other nodes of the graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(r ≥ k + 1)"},{"kind":"text","text":" — the length of the found cycle. In the next line print "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"v1, v2, ..., vr"},{"kind":"math_inline","text":"(1 ≤ vi ≤ n)"},{"kind":"text","text":" — the found simple cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the answer exists. If there are multiple correct answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\n1 2\n2 3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6 3\n4 3\n1 2\n1 3\n1 4\n2 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3 4 1 2 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"263D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/263/problem/D"}