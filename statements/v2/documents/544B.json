{"assets":[],"contentKind":"statement","contestId":"544","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sea and Islands"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A map of some object is a rectangular field consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns. Each cell is initially occupied by the sea but you can cover some some cells of the map with sand so that exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" islands appear on the map. We will call a set of sand cells to be "},{"children":[{"kind":"text","text":"island"}],"kind":"container"},{"kind":"text","text":" if it is possible to get from each of them to each of them by moving only through sand cells and by moving from a cell only to a side-adjacent cell. The cells are called to be side-adjacent if they share a vertical or horizontal side. It is easy to see that islands do not share cells (otherwise they together form a bigger island)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a way to cover some cells with sand so that exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" islands appear on the "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" map, or determine that no such way exists. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n2"},{"kind":"text","text":") — the size of the map and the number of islands you should form."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the answer doesn't exist, print \"NO\" (without the quotes) in a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \"YES\" in the first line. In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the description of the map. Each of the lines of the description must consist only of characters "},{"children":[{"kind":"text","text":"'S'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'L'"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"'S'"}],"kind":"container"},{"kind":"text","text":" is a cell that is occupied by the sea and "},{"children":[{"kind":"text","text":"'L'"}],"kind":"container"},{"kind":"text","text":" is the cell covered with sand. The length of each line of the description must equal "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you may print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You "},{"children":[{"kind":"text","text":"should not"}],"kind":"container"},{"kind":"text","text":" maximize the sizes of islands."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nSSSSS\nLLLLL\nSSSSS\nLLLLL\nSSSSS\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"544B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/544/problem/B"}