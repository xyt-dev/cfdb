{"assets":[],"contentKind":"statement","contestId":"2033","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Kousuke's Assignment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After a trip with Sakurako, Kousuke was very scared because he forgot about his programming assignment. In this assignment, the teacher gave him an array $$$a$$$ of $$$n$$$ integers and asked him to calculate the number of "},{"children":[{"kind":"text","text":"non-overlapping"}],"kind":"container"},{"kind":"text","text":" segments of the array $$$a$$$, such that each segment is considered "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A segment $$$[l,r]$$$ is considered "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if $$$a_l + a_{l+1} + \\dots + a_{r-1} + a_r=0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a fixed array $$$a$$$, your task is to compute the maximum number of non-overlapping "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" segments."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the number $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Each test case consists of $$$2$$$ lines. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the length of the array."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second line contains $$$n$$$ integers $$$a_i$$$ ($$$-10^5 \\le a_i \\le 10^5$$$) — the elements of the array $$$a$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$3\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer: the maximum number of non-overlapping "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" segments."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n2 1 -3 2 1\n7\n12 -4 4 43 -3 -5 8\n6\n0 -4 0 3 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2033D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2033/problem/D"}