{"assets":[],"contentKind":"statement","contestId":"630","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Moore's Law"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The city administration of IT City decided to fix up a symbol of scientific and technical progress in the city's main square, namely an indicator board that shows the effect of Moore's law in real time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moore's law is the observation that the number of transistors in a dense integrated circuit doubles approximately every "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" months. The implication of Moore's law is that computer performance as function of time increases exponentially as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to prepare information that will change every second to display on the indicator board. Let's assume that every second the number of transistors increases exactly "},{"kind":"math_inline","text":"1.000000011"},{"kind":"text","text":" times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a pair of integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1000 ≤ n ≤ 10 000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ t ≤ 2 000 000 000"},{"kind":"text","text":") — the number of transistors in the initial time and the number of seconds passed since the initial time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — the estimate of the number of transistors in a dence integrated circuit in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds since the initial time. The relative error of your answer should not be greater than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000 1000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1011.060722383550382782399454922040\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"630B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/630/problem/B"}