","text":"x"},{"kind":"text","text":" coordinate and decrease "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinate by one three times."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"620A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/620/problem/A"}