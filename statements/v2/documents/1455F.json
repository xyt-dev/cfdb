{"assets":[],"contentKind":"statement","contestId":"1455","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. String and Operations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of $$$n$$$ characters. These characters are among the first $$$k$$$ lowercase letters of the Latin alphabet. You have to perform $$$n$$$ operations with the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the $$$i$$$-th operation, you take the character that "},{"children":[{"kind":"text","text":"initially occupied"}],"kind":"container"},{"kind":"text","text":" the $$$i$$$-th position, and perform "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" of the following actions with it:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" swap it with the previous character in the string (if it exists). This operation is represented as "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" swap it with the next character in the string (if it exists). This operation is represented as "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" cyclically change it to the previous character in the alphabet ("},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", and so on; "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" becomes the $$$k$$$-th letter of the Latin alphabet). This operation is represented as "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" cyclically change it to the next character in the alphabet ("},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":", and so on; the $$$k$$$-th letter of the Latin alphabet becomes "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"). This operation is represented as "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" do nothing. This operation is represented as "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, suppose the initial string is "},{"children":[{"kind":"text","text":"test"}],"kind":"container"},{"kind":"text","text":", $$$k = 20$$$, and the sequence of operations is "},{"children":[{"kind":"text","text":"URLD"}],"kind":"container"},{"kind":"text","text":". Then the string is transformed as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the first operation is "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", so we change the underlined letter in "},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"est"}],"kind":"container"},{"kind":"text","text":" to the next one in the first $$$20$$$ Latin letters, which is "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":". The string is now "},{"children":[{"kind":"text","text":"aest"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second operation is "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", so we swap the underlined letter with the next one in the string "},{"children":[{"kind":"text","text":"a"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"st"}],"kind":"container"},{"kind":"text","text":". The string is now "},{"children":[{"kind":"text","text":"aset"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third operation is "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", so we swap the underlined letter with the previous one in the string "},{"children":[{"kind":"text","text":"a"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"et"}],"kind":"container"},{"kind":"text","text":" (note that this is now the $$$2$$$-nd character of the string, but it was initially the $$$3$$$-rd one, so the $$$3$$$-rd operation is performed to it). The resulting string is "},{"children":[{"kind":"text","text":"saet"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the fourth operation is "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", so we change the underlined letter in "},{"children":[{"kind":"text","text":"sae"},{"children":[{"kind":"text","text":"t"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" to the previous one in the first $$$20$$$ Latin letters, which is "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":". The string is now "},{"children":[{"kind":"text","text":"saes"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The result of performing the sequence of operations is "},{"children":[{"kind":"text","text":"saes"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the string $$$s$$$ and the value of $$$k$$$, find the lexicographically smallest string that can be obtained after applying a sequence of operations to $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 500$$$; $$$2 \\le k \\le 26$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ consisting of $$$n$$$ characters. Each character is one of the $$$k$$$ first letters of the Latin alphabet (in lower case)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one line containing the lexicographically smallest string that can be obtained from $$$s$$$ using one sequence of operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n4 2\nbbab\n7 5\ncceddda\n6 5\necdaed\n7 4\ndcdbdaa\n8 3\nccabbaca\n5 7\neabba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\naaaa\nbaccacd\naabdac\naabacad\naaaaaaaa\nabadb\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1455F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1455/problem/F"}