:"text","text":"Your task is to generate a state which is an equal superposition of the given basis states:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/06d90dbcdd9ac624e8ae3ba1b79718aa5acd832aa2db4fd4eeae6e75636a21c7.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You have to implement an operation which takes the following inputs:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" an array of qubits "},{"kind":"math_inline","text":"qs"},{"kind":"text","text":","}],"kind":"list_item"},{"children":[{"kind":"text","text":" two arrays of Boolean values "},{"kind":"math_inline","text":"bits0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bits1"},{"kind":"text","text":" representing the basis states "},{"attrs":{"alt":"","src":"/statement-assets/93cb516e0a1514d18f2576ec015d7f2a651aa71365a010c693dcd6590774d6d3.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/1b873ce885f9758e2888fca106533df8c229479ac814ebf713ebaee9805c54dd.png"},"kind":"image"},{"kind":"text","text":". These arrays will have the same length as the array of qubits. "},{"kind":"math_inline","text":"bits0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bits1"},{"kind":"text","text":" will differ in at least one position."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The operation doesn't have an output; its \"output\" is the state in which it leaves the qubits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your code should have the following signature:"}],"kind":"paragraph"},{"kind":"code_block","text":"namespace Solution {\n    open Microsoft.Quantum.Primitive;\n    open Microsoft.Quantum.Canon;\n\n    operation Solve (qs : Qubit[], bits0 : Bool[], bits1 : Bool[]) : ()\n    {\n        body\n        {\n            // your code here\n        }\n    }\n}"}],"kind":"section"}],"kind":"document"},"index":"A3","problemCode":"1002A3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1002/problem/A3"}