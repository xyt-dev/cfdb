{"assets":[],"contentKind":"statement","contestId":"740","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Alyona and flowers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Alyona is celebrating Happy Birthday! Her mother has an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" flowers. Each flower has some mood, the mood of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th flower is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The mood can be positive, zero or negative."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a subarray as a segment of consecutive flowers. The mother suggested some set of subarrays. Alyona wants to choose several of the subarrays suggested by her mother. After that, each of the flowers will add to the girl's happiness its mood multiplied by the number of chosen subarrays the flower is in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, consider the case when the mother has "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" flowers, and their moods are equal to "},{"kind":"math_inline","text":"1,  - 2, 1, 3,  - 4"},{"kind":"text","text":". Suppose the mother suggested subarrays "},{"kind":"math_inline","text":"(1,  - 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3,  - 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1,  - 2, 1, 3)"},{"kind":"text","text":". Then if the girl chooses the third and the fourth subarrays then: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first flower adds "},{"kind":"math_inline","text":"1·1 = 1"},{"kind":"text","text":" to the girl's happiness, because he is in one of chosen subarrays, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second flower adds "},{"kind":"math_inline","text":"( - 2)·1 =  - 2"},{"kind":"text","text":", because he is in one of chosen subarrays, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third flower adds "},{"kind":"math_inline","text":"1·2 = 2"},{"kind":"text","text":", because he is in two of chosen subarrays, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the fourth flower adds "},{"kind":"math_inline","text":"3·2 = 6"},{"kind":"text","text":", because he is in two of chosen subarrays, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the fifth flower adds "},{"kind":"math_inline","text":"( - 4)·0 = 0"},{"kind":"text","text":", because he is in no chosen subarrays. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, in total "},{"kind":"math_inline","text":"1 + ( - 2) + 2 + 6 + 0 = 7"},{"kind":"text","text":" is added to the girl's happiness. Alyona wants to choose such subarrays from those suggested by the mother that the value added to her happiness would be as large as possible. Help her do this!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alyona can choose any number of the subarrays, even "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or all suggested by her mother."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":") — the number of flowers and the number of subarrays suggested by the mother."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the flowers moods — "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 100 ≤ ai ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the subarrays suggested by the mother. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contain two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") denoting the subarray "},{"kind":"math_inline","text":"a[li], a[li + 1], ..., a[ri]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each subarray can encounter more than once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the maximum possible value added to the Alyona's happiness."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 -2 1 3 -4\n1 2\n4 5\n3 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 2 3 4\n1 3\n2 4\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n-1 -2\n1 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is the situation described in the statements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Alyona should choose all subarrays."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third example has answer "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" because Alyona can choose none of the subarrays."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"740B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/740/problem/B"}