{"assets":["/statement-assets/a2e52240fa03648ab62f1c2bc4230b8b074e69bffdd3c654c8b80dbbb76a1bcd.png","/statement-assets/8a328a8b4d70f3520a09b5005feaac6bd5e466ec527467f4e002c7b01659c54e.png","/statement-assets/8d854cbc40475f7d53be9bfbaae8d4e1388f9951c46f265df673813cd1883bd9.png","/statement-assets/8ed55a642f292fb8139af8f83f2096e3f604ba0dcab587b20a9d00a33c3ac2e0.png","/statement-assets/993816bfaff4694eeb42933a5caf2d4045cefdba49f93be3311d545227506f9b.png","/statement-assets/dcdccfd0d1e5334973d6386930a216554b7c0b347cb99126f2cf54fee2f7ab36.png","/statement-assets/b703f5c244c7716273f974ccdf63817fa69c7164c70ff8f5c0a0adce4a48f830.png"],"contentKind":"statement","contestId":"444","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. DZY Loves Physics"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"DZY loves Physics, and he enjoys calculating density."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Almost everything has density, even a graph. We define the density of a non-directed graph (nodes and edges of the graph have some values) as follows: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a2e52240fa03648ab62f1c2bc4230b8b074e69bffdd3c654c8b80dbbb76a1bcd.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is the sum of the values of the nodes, "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" is the sum of the values of the edges."},{"children":[{"kind":"text","text":"Once DZY got a graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", now he wants to find a connected induced subgraph "},{"kind":"math_inline","text":"G'"},{"kind":"text","text":" of the graph, such that the density of "},{"kind":"math_inline","text":"G'"},{"kind":"text","text":" is as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An induced subgraph "},{"kind":"math_inline","text":"G'(V', E')"},{"kind":"text","text":" of a graph "},{"kind":"math_inline","text":"G(V, E)"},{"kind":"text","text":" is a graph that satisfies:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/8a328a8b4d70f3520a09b5005feaac6bd5e466ec527467f4e002c7b01659c54e.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" edge "},{"attrs":{"alt":"","src":"/statement-assets/8d854cbc40475f7d53be9bfbaae8d4e1388f9951c46f265df673813cd1883bd9.png"},"kind":"image"},{"kind":"text","text":" if and only if "},{"attrs":{"alt":"","src":"/statement-assets/8ed55a642f292fb8139af8f83f2096e3f604ba0dcab587b20a9d00a33c3ac2e0.png"},"kind":"image"},{"kind":"text","text":", and edge "},{"attrs":{"alt":"","src":"/statement-assets/993816bfaff4694eeb42933a5caf2d4045cefdba49f93be3311d545227506f9b.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the value of an edge in "},{"kind":"math_inline","text":"G'"},{"kind":"text","text":" is the same as the value of the corresponding edge in "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", so as the value of a node. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help DZY to find the induced subgraph with maximum density. Note that the induced subgraph you choose must be connected."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dcdccfd0d1e5334973d6386930a216554b7c0b347cb99126f2cf54fee2f7ab36.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 500)"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/b703f5c244c7716273f974ccdf63817fa69c7164c70ff8f5c0a0adce4a48f830.png"},"kind":"image"},{"kind":"text","text":". Integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" represents the number of nodes of the graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" represents the number of edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"xi (1 ≤ xi ≤ 106)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" represents the value of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th node. Consider the graph nodes are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three space-separated integers "},{"kind":"math_inline","text":"ai, bi, ci (1 ≤ ai < bi ≤ n; 1 ≤ ci ≤ 103)"},{"kind":"text","text":", denoting an edge between node "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" with value "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". The graph won't contain multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a real number denoting the answer, with an absolute or relative error of at most "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 2\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n13 56 73 98 17\n1 2 56\n1 3 29\n1 4 42\n2 3 95\n2 4 88\n3 4 63\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.965517241379311\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, you can only choose an empty subgraph, or the subgraph containing only node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, choosing the whole graph is optimal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"444A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/444/problem/A"}