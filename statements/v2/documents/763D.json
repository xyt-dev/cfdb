{"assets":[],"contentKind":"statement","contestId":"763","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Timofey and a flat tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Timofey has a big tree — an undirected connected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and no simple cycles. He likes to walk along it. His tree is flat so when he walks along it he sees it entirely. Quite naturally, when he stands on a vertex, he sees the tree as a rooted tree with the root in this vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Timofey assumes that the "},{"children":[{"kind":"text","text":"more"}],"kind":"container"},{"kind":"text","text":" non-isomorphic subtrees are there in the tree, the more beautiful the tree is. A subtree of a vertex is a subgraph containing this vertex and all its descendants. You should tell Timofey the vertex in which he should stand to see the most beautiful rooted tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Subtrees of vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are isomorphic if the number of children of "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" equals the number of children of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and their children can be arranged in such a way that the subtree of the first son of "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is isomorphic to the subtree of the first son of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", the subtree of the second son of "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is isomorphic to the subtree of the second son of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and so on. In particular, subtrees consisting of single vertex are isomorphic to each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":"), denoting the vertices the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge connects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the index of the vertex in which Timofey should stand. If there are many answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n4 2\n2 3\n5 6\n6 7\n3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n1 7\n1 8\n9 4\n5 1\n9 2\n3 5\n10 6\n10 9\n5 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example we can stand in the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or in the vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" so that every subtree is non-isomorphic. If we stand in the vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then subtrees of vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are isomorphic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, if we stand in the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then only subtrees of vertices "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" are isomorphic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, if we stand in the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then subtrees of vertices "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" are isomorphic. If we stand in the vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", than only subtrees of vertices "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" are isomorphic. If we stand in the vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", then subtrees of vertices "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" are isomorphic, and subtrees of vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" are isomorphic as well: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n  1     9\n /\\    /\\\n7  8  4  2\n"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"763D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/763/problem/D"}