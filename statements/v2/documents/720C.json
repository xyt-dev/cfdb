{"assets":[],"contentKind":"statement","contestId":"720","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Homework"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today Peter has got an additional homework for tomorrow. The teacher has given three integers to him: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", and asked him to mark one or more squares on a square grid of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The marked squares must form a connected figure, and there must be exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" triples of marked squares that form an L-shaped tromino — all three squares are inside a "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The set of squares forms a connected figure if it is possible to get from any square to any other one if you are allowed to move from a square to any adjacent by a common side square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Peter cannot fulfill the task, so he asks you for help. Help him to create such figure."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input data contains one or more test cases. The first line contains the number of test cases "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" test cases is described by a line that contains three integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n, m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n × m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of values of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" for all tests in one input data doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is possible to create such figure, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each, use asterisk '*' to denote the marked square, and dot '.' to denote the unmarked one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print empty line between test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 3 4\n3 3 5\n3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":".*.\n***\n.*.\n\n**.\n**.\n*..\n\n.*.\n***\n*..\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"720C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/720/problem/C"}