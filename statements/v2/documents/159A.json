{"assets":[],"contentKind":"statement","contestId":"159","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Friends or Not"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has a hobby — he develops an unusual social network. His work is almost completed, and there is only one more module to implement — the module which determines friends. Oh yes, in this social network one won't have to add friends manually! Pairs of friends are deduced in the following way. Let's assume that user "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" sent user "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" a message at time "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":", and user "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" sent user "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" a message at time "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"0 < t2 - t1 ≤ d"},{"kind":"text","text":", then user "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"'s message was "},{"children":[{"kind":"text","text":"an answer"}],"kind":"container"},{"kind":"text","text":" to user "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"'s one. Users "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" are considered to be friends if "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" answered at least one "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"'s message or "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" answered at least one "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"'s message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the log of messages in chronological order and a number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Find all pairs of users who will be considered to be friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, d ≤ 1000"},{"kind":"text","text":"). The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the messages log. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains one line of the log formatted as \""},{"kind":"math_inline","text":"Ai"},{"kind":"math_inline","text":"Bi"},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"\" (without the quotes), which means that user "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" sent a message to user "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" are non-empty strings at most "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" characters long, consisting of lowercase letters ('"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' ... '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"'), and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is an integer ("},{"kind":"math_inline","text":"0 ≤ ti ≤ 10000"},{"kind":"text","text":"). It is guaranteed that the lines are given in non-decreasing order of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"'s and that no user sent a message to himself. The elements in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of pairs of friends. In the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print pairs of friends as \""},{"kind":"math_inline","text":"Ai"},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":"\" (without the quotes). You can print users in pairs and the pairs themselves in any order. Each pair must be printed exactly once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\nvasya petya 1\npetya vasya 2\nanya ivan 2\nivan anya 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\npetya vasya\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1000\na b 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test case Vasya and Petya are friends because their messages' sending times are one second apart. Anya and Ivan are not, because their messages' sending times differ by more than one second."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"159A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/159/problem/A"}