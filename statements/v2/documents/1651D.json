{"assets":[],"contentKind":"statement","contestId":"1651","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Nearest Excluded Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ distinct points on a plane. The coordinates of the $$$i$$$-th point are $$$(x_i, y_i)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each point $$$i$$$, find the nearest (in terms of Manhattan distance) point with "},{"children":[{"kind":"text","text":"integer coordinates"}],"kind":"container"},{"kind":"text","text":" that is not among the given $$$n$$$ points. If there are multiple such points — you can choose any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Manhattan distance between two points $$$(x_1, y_1)$$$ and $$$(x_2, y_2)$$$ is $$$|x_1 - x_2| + |y_1 - y_2|$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the number of points in the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines describe points. The $$$i$$$-th of them contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$1 \\le x_i, y_i \\le 2 \\cdot 10^5$$$) — coordinates of the $$$i$$$-th point."}],"kind":"paragraph"},{"children":[{"kind":"text","tex