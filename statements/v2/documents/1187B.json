{"assets":[],"contentKind":"statement","contestId":"1187","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Letters Shop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The letters shop showcase is a string $$$s$$$, consisting of $$$n$$$ lowercase Latin letters. As the name tells, letters are sold in the shop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Letters are sold one by one from the leftmost to the rightmost. Any customer can only buy some prefix of letters from the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$m$$$ friends, the $$$i$$$-th of them is named $$$t_i$$$. Each of them is planning to estimate the following value: how many letters (the length of the shortest prefix) would s/he need to buy if s/he wanted to construct her/his name of bought letters. The name can be constructed if each letter is presented in the equal or greater amount."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For example, for $$$s$$$=\""},{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"},{"kind":"text","text":"\" and $$$t_i$$$=\""},{"children":[{"kind":"text","text":"arya"}],"kind":"container"},{"kind":"text","text":"\" $$$5$$$ letters have to be bought (\""},{"children":[{"children":[{"kind":"text","text":"array"}],"kind":"container"},{"kind":"text","text":"head"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For example, for $$$s$$$=\""},{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"},{"kind":"text","text":"\" and $$$t_i$$$=\""},{"children":[{"kind":"text","text":"harry"}],"kind":"container"},{"kind":"text","text":"\" $$$6$$$ letters have to be bought (\""},{"children":[{"children":[{"kind":"text","text":"arrayh"}],"kind":"container"},{"kind":"text","text":"ead"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For example, for $$$s$$$=\""},{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"},{"kind":"text","text":"\" and $$$t_i$$$=\""},{"children":[{"kind":"text","text":"ray"}],"kind":"container"},{"kind":"text","text":"\" $$$5$$$ letters have to be bought (\""},{"children":[{"children":[{"kind":"text","text":"array"}],"kind":"container"},{"kind":"text","text":"head"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For example, for $$$s$$$=\""},{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"},{"kind":"text","text":"\" and $$$t_i$$$=\""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\" $$$2$$$ letters have to be bought (\""},{"children":[{"children":[{"kind":"text","text":"ar"}],"kind":"container"},{"kind":"text","text":"rayhead"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For example, for $$$s$$$=\""},{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"},{"kind":"text","text":"\" and $$$t_i$$$=\""},{"children":[{"kind":"text","text":"areahydra"}],"kind":"container"},{"kind":"text","text":"\" all $$$9$$$ letters have to be bought (\""},{"children":[{"children":[{"kind":"text","text":"arrayhead"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that every friend can construct her/his name using the letters from the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the values for friends are independent, friends are only estimating them but not actually buying the letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of showcase string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string $$$s$$$, consisting of exactly $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains one integer $$$m$$$ ($$$1 \\le m \\le 5 \\cdot 10^4$$$) — the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$m$$$ lines contains $$$t_i$$$ ($$$1 \\le |t_i| \\le 2 \\cdot 10^5$$$) — the name of the $$$i$$$-th friend."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$\\sum \\limits_{i=1}^m |t_i| \\le 2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each friend print the length of the shortest prefix of letters from $$$s$$$ s/he would need to buy to be able to construct her/his name of them. The name can be constructed if each letter is presented in the equal or greater amount."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that every friend can construct her/his name using the letters from the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"}