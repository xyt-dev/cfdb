{"assets":["/statement-assets/ef90f8e61dd9f2fae78221944001e25cbc118f8af8920540386534abcfe744fa.png"],"contentKind":"statement","contestId":"653","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bear and Forgotten Tree 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree is a connected undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n  -  1"},{"kind":"text","text":" edges. Vertices are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear. He once had a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices but he lost it. He still remembers something about the lost tree though."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of vertices "},{"kind":"math_inline","text":"(a1, b1), (a2, b2), ..., (am, bm)"},{"kind":"text","text":". Limak remembers that for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there was "},{"children":[{"kind":"text","text":"no edge"}],"kind":"container"},{"kind":"text","text":" between "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". He also remembers that vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" was incident to exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" edges (its degree was equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Is it possible that Limak remembers everything correctly? Check whether there exists a tree satisfying the given conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/ef90f8e61dd9f2fae78221944001e25cbc118f8af8920540386534abcfe744fa.png"},"kind":"image"},{"kind":"text","text":") — the number of vertices in Limak's tree, the number of forbidden pairs of vertices, and the degree of vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two distinct integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair that is "},{"children":[{"kind":"text","text":"forbidden"}],"kind":"container"},{"kind":"text","text":". It's guaranteed that each pair of vertices will appear at most once in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"possible"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there exists at least one tree satisfying the given conditions. Otherwise, print \""},{"children":[{"kind":"text","text":"impossible"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2\n1 2\n2 3\n4 2\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"possible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5 3\n1 2\n1 3\n1 4\n1 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"impossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are "},{"kind":"math_inline","text":"n = 5"},{"kind":"text","text":" vertices. The degree of vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" should be "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":". All conditions are satisfied for a tree with edges "},{"kind":"math_inline","text":"1 - 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5 - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Limak remembers that none of the following edges existed: "},{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 - 6"},{"kind":"text","text":". Hence, vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" couldn't be connected to any other vertex and it implies that there is no suitable tree."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"653E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/653/problem/E"}