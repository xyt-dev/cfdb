{"assets":[],"contentKind":"statement","contestId":"119","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. String Transformation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" be a string whose length equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Its characters are numbered from 0 to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" are integers, "},{"kind":"math_inline","text":"0 ≤ i < j < n"},{"kind":"text","text":". Let's define function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" as follows:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"f(s, i, j) = s[i + 1... j - 1] + r(s[j... n - 1]) + r(s[0... i])"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"s[p... q]"},{"kind":"text","text":" is a substring of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", that starts in position "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and ends in position "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" (inclusive); \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" is the string concatenation operator; "},{"kind":"math_inline","text":"r(x)"},{"kind":"text","text":" is a string resulting from writing the characters of the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" string in the reverse order. If "},{"kind":"math_inline","text":"j = i + 1"},{"kind":"text","text":", then the substring "},{"kind":"math_inline","text":"s[i + 1... j - 1]"},{"kind":"text","text":" is considered empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Find such values of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"f(a, i, j) = b"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should be maximally possible. If for this "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there exists several valid values of "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", choose the minimal "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first two input lines are non-empty strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" correspondingly. Each string's length does not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" characters. The strings can contain any characters with ASCII codes from 32 to 126 inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" — the answer to the problem. If no solution exists, print \""},{"children":[{"kind":"text","text":"-1 -1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"Die Polizei untersucht eine Straftat im IT-Bereich.\nuntersucht eine Straftat.hciereB-TI mi  ieziloP eiD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11 36\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"cbaaaa\naaaabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123342\n3324212\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1 -1"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"119D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces