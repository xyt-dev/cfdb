{"assets":[],"contentKind":"statement","contestId":"460","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Little Dima and Equation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Dima misbehaved during a math lesson a lot and the nasty teacher Mr. Pickles gave him the following problem as a punishment. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find all integer solutions "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(0 < x < 109)"},{"kind":"text","text":" of the equation:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"x = b·s(x)a + c, "}],"kind":"container"},{"children":[{"kind":"text","text":"where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are some predetermined constant values and function "},{"kind":"math_inline","text":"s(x)"},{"kind":"text","text":" determines the sum of all digits in the decimal representation of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher gives this problem to Dima for each lesson. He changes only the parameters of the equation: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". Dima got sick of getting bad marks and he asks you to help him solve this challenging problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers: "},{"kind":"math_inline","text":"a, b, c"},{"kind":"math_inline","text":"(1 ≤ a ≤ 5; 1 ≤ b ≤ 10000;  - 10000 ≤ c ≤ 10000)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of the solutions that you've found. Next print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers in the increasing order — the solutions of the given equation. Print only integer solutions that are larger than zero and strictly less than "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n10 2008 13726 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 -18\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"child