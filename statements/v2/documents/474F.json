{"assets":[],"contentKind":"statement","contestId":"474","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ant colony"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mole is hungry again. He found one ant colony, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ants, ordered in a row. Each ant "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") has a strength "},{"kind":"math_inline","text":"si"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to make his dinner more interesting, Mole organizes a version of «Hunger Games» for the ants. He chooses two numbers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") and each pair of ants with indices between "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (inclusively) will fight. When two ants "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" fight, ant "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" gets one battle point only if "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" divides "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" (also, ant "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" gets one battle point only if "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" divides "},{"kind":"math_inline","text":"si"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After all fights have been finished, Mole makes the ranking. An ant "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", with "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" battle points obtained, is going to be freed only if "},{"kind":"math_inline","text":"vi = r - l"},{"kind":"text","text":", or in other words only if it took a point in every fight it participated. After that, Mole eats the rest of the ants. Note that there can be many ants freed or even none."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to choose the best sequence, Mole gives you "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" segments "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" and asks for each of them how many ants is he going to eat if those ants fight."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the size of the ant colony. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 109"},{"kind":"text","text":"), the strengths of the ants. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains one integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 105"},{"kind":"text","text":"), the number of test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":"), describing one query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print to the standard output "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains number of ants that Mole eats from the segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 2 4 2\n4\n1 5\n2 5\n3 5\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n4\n1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test battle points for each ant are "},{"kind":"math_inline","text":"v = [4, 0, 2, 0, 2]"},{"kind":"text","text":", so ant number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is freed. Mole eats the ants "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case battle points are "},{"kind":"math_inline","text":"v = [0, 2, 0, 2]"},{"kind":"text","text":", so no ant is freed and all of them are eaten by Mole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case battle points are "},{"kind":"math_inline","text":"v = [2, 0, 2]"},{"kind":"text","text":", so ants number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" are freed. Mole eats "},{"children":[{"kind":"text","text":"only the ant "},{"kind":"math_inline","text":"4"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case battle points are "},{"kind":"math_inline","text":"v = [0, 1]"},{"kind":"text","text":", so ant number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is freed. Mole eats the ant "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"474F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/474/problem/F"}