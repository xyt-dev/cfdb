{"assets":[],"contentKind":"statement","contestId":"847","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"M. Weather Tomorrow"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya came up with his own weather forecasting method. He knows the information about the average air temperature for each of the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. Assume that the average air temperature for each day is integral."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya believes that if the average temperatures over the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days form an arithmetic progression, where the first term equals to the average temperature on the first day, the second term equals to the average temperature on the second day and so on, then the average temperature of the next "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":"-th day will be equal to the next term of the arithmetic progression. Otherwise, according to Vasya's method, the temperature of the "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":"-th day will be equal to the temperature of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Vasya predict the average temperature for tomorrow, i. e. for the "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the number of days for which the average air temperature is known."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"math_inline","text":"( - 1000 ≤ ti ≤ 1000)"},{"kind":"text","text":" — where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the average temperature in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the average air temperature in the "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":"-th day, which Vasya predicts according to his method. Note that the absolute value of the predicted temperature can exceed "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10 5 0 -5 -10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 1 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n900 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1100\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the sequence of the average temperatures is an arithmetic progression where the first term is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" and each following terms decreases by "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". So the predicted average temperature for the sixth day is "},{"kind":"math_inline","text":" - 10 - 5 =  - 15"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the sequence of the average temperatures is an arithmetic progression where the first term is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and each following terms equals to the previous one. So the predicted average temperature in the fifth day is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the average temperatures do not form an arithmetic progression, so the average temperature of the fourth day equals to the temperature of the third day and equals to "},{"kind":"math_inline","text":" - 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example the sequence of the average temperatures is an arithmetic progression where the first term is "},{"kind":"math_inline","text":"900"},{"kind":"text","text":" and each the following terms increase by "},{"kind":"math_inline","text":"100"},{"kind":"text","text":". So predicted average temperature in the third day is "},{"kind":"math_inline","text":"1000 + 100 = 1100"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"M","problemCode":"847M","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/847/problem/M"}