{"assets":["/statement-assets/89e2393a0dde6399d53b9a771773991b1c8b46099c0e4f418a182977864c1771.png","/statement-assets/d82e44bfe850a42612d7539fdf42869b6bb4eb70b6f08cd0ba10ff657113ace3.png"],"contentKind":"statement","contestId":"227","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Where do I Turn?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Trouble came from the overseas lands: a three-headed dragon Gorynych arrived. The dragon settled at point "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" and began to terrorize the residents of the surrounding villages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A brave hero decided to put an end to the dragon. He moved from point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to fight with Gorynych. The hero rode from point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" along a straight road and met point "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" on his way. The hero knows that in this land for every pair of roads it is true that they are either parallel to each other, or lie on a straight line, or are perpendicular to each other. He also knows well that points "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" are connected by a road. So the hero must either turn 90 degrees to the left or continue riding straight ahead or turn 90 degrees to the right. But he forgot where the point "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" is located."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fortunately, a Brave Falcon flew right by. It can see all three points from the sky. The hero asked him what way to go to get to the dragon's lair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you have not got it, you are the falcon. Help the hero and tell him how to get him to point "},{"kind":"math_inline","text":"C"},{"kind":"text","text":": turn left, go straight or turn right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At this moment the hero is believed to stand at point "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", turning his back to point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two space-separated integers "},{"kind":"math_inline","text":"xa, ya"},{"kind":"math_inline","text":"(|xa|, |ya| ≤ 109)"},{"kind":"text","text":" — the coordinates of point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". The second line contains the coordinates of point "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" in the same form, the third line contains the coordinates of point "},{"kind":"math_inline","text":"C"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all points are pairwise different. It is also guaranteed that either point "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" lies on segment "},{"kind":"math_inline","text":"AC"},{"kind":"text","text":", or angle "},{"kind":"math_inline","text":"ABC"},{"kind":"text","text":" is right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line. If a hero must turn left, print \"LEFT\" (without the quotes); If he must go straight ahead, print \"TOWARDS\" (without the quotes); if he should turn right, print \"RIGHT\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n0 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"RIGHT\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-1 -1\n-3 -3\n-4 -4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"TOWARDS\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-4 -6\n-3 -7\n-2 -6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"LEFT\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture to the first sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/89e2393a0dde6399d53b9a771773991b1c8b46099c0e4f418a182977864c1771.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The red color shows points A, B and C. The blue arrow shows the hero's direction. The green color shows the hero's trajectory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture to the second sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d82e44bfe850a42612d7539fdf42869b6bb4eb70b6f08cd0ba10ff657113ace3.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"227A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/227/problem/A"}