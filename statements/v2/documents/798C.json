{"assets":["/statement-assets/b16230db75a6109cbeb78e0d741221b432fd19be5be3e0b6cd8c1336e8ce3e90.png","/statement-assets/7770ecd21d844a3432a396c438cd97506d202617cbd4ac4214102782087a38fd.png","/statement-assets/1f18eb9ca37abfd9f22a5db081e702f9015c77d41eb13df9435209625b129b50.png"],"contentKind":"statement","contestId":"798","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mike and gcd problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike has a sequence "},{"kind":"math_inline","text":"A = [a1, a2, ..., an]"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". He considers the sequence "},{"kind":"math_inline","text":"B = [b1, b2, ..., bn]"},{"kind":"text","text":" beautiful if the "},{"kind":"math_inline","text":"gcd"},{"kind":"text","text":" of all its elements is bigger than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", i.e. "},{"attrs":{"alt":"","src":"/statement-assets/b16230db75a6109cbeb78e0d741221b432fd19be5be3e0b6cd8c1336e8ce3e90.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike wants to change his sequence in order to make it beautiful. In one move he can choose an index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":"), delete numbers "},{"kind":"math_inline","text":"ai, ai + 1"},{"kind":"text","text":" and put numbers "},{"kind":"math_inline","text":"ai - ai + 1, ai + ai + 1"},{"kind":"text","text":" in their place instead, in this order. He wants perform as few operations as possible. Find the minimal number of operations to make sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" beautiful if it's possible, or tell him that it is impossible to do so."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7770ecd21d844a3432a396c438cd97506d202617cbd4ac4214102782087a38fd.png"},"kind":"image"},{"kind":"text","text":" is the biggest non-negative number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" divides "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — length of sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — elements of sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output on the first line \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if it is possible to make sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" beautiful by performing operations described above, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer was \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", output the minimal number of moves needed to make sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" beautiful."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n6 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can simply make one move to obtain sequence "},{"kind":"math_inline","text":"[0, 2]"},{"kind":"text","text":" with "},{"attrs":{"alt":"","src":"/statement-assets/1f18eb9ca37abfd9f22a5db081e702f9015c77d41eb13df9435209625b129b50.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the "},{"kind":"math_inline","text":"gcd"},{"kind":"text","text":" of the sequence is already greater than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"798C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/798/problem/C"}