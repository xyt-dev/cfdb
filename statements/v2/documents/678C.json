{"assets":[],"contentKind":"statement","contestId":"678","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Joty and Chocolate"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Joty has got a task to do. She has a line of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" tiles indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". She has to paint them in a strange pattern."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An unpainted tile should be painted Red if it's index is divisible by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and an unpainted tile should be painted Blue if it's index is divisible by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". So the tile with the number divisible by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" can be either painted Red or Blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After her painting is done, she will get "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" chocolates for each tile that is painted Red and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" chocolates for each tile that is painted Blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that she can paint tiles in any order she wants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the required information, find the maximum number of chocolates Joty can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains five integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, a, b, p, q ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — the maximum number of chocolates Joty can get."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer can be too large, so you should use "},{"kind":"math_inline","text":"64"},{"kind":"text","text":"-bit integer type to store it. In "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" you can use the "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" integer type and in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" you can use "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" integer type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"at