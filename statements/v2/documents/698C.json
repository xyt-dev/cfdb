{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"],"contentKind":"statement","contestId":"698","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. LRU"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While creating high loaded systems one should pay a special attention to caching. This problem will be about one of the most popular caching algorithms called LRU (Least Recently Used)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose the cache may store no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" objects. At the beginning of the workflow the cache is empty. When some object is queried we check if it is present in the cache and move it here if it's not. If there are more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" objects in the cache after this, the least recently used one should be removed. In other words, we remove the object that has the smallest time of the last query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" videos being stored on the server, all of the same size. Cache can store no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" videos and caching algorithm described above is applied. We know that any time a user enters the server he pick the video "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". The choice of the video is independent to any events before."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal of this problem is to count for each of the videos the probability it will be present in the cache after "},{"kind":"math_inline","text":"10100"},{"kind":"text","text":" queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 20"},{"kind":"text","text":") — the number of videos and the size of the cache respectively. Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" real numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 1"},{"kind":"text","text":"), each of them is given with no more than two digits after decimal point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of all "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" real numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to the probability that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th video will be present in the cache after "},{"kind":"math_inline","text":"10100"},{"kind":"text","text":" queries. You answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n0.3 0.2 0.5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.3 0.2 0.5 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n0.0 1.0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.0 1.0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n0.3 0.2 0.5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.675 0.4857142857142857 0.8392857142857143 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n0.2 0.3 0.5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0 1.0 1.0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"698C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/698/problem/C"}