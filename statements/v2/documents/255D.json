{"assets":["/statement-assets/47ecc8876699fe758f3a6943358567c67b18af912c6b33cfd6daad9a44e0b6fb.png"],"contentKind":"statement","contestId":"255","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mr. Bender and Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Bender has a digital table of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":", each cell can be switched on or off. He wants the field to have at least "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" switched on squares. When this condition is fulfilled, Mr Bender will be happy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll consider the table rows numbered from top to bottom from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the columns — numbered from left to right from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Initially there is exactly one switched on cell with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the row number, "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the column number), and all other cells are switched off. Then each second we switch on the cells that are off but have the side-adjacent cells that are on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a cell with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" the side-adjacent cells are cells with coordinates "},{"kind":"math_inline","text":"(x - 1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In how many seconds will Mr. Bender get happy?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"n, x, y, c"},{"kind":"math_inline","text":"(1 ≤ n, c ≤ 109; 1 ≤ x, y ≤ n; c ≤ n2)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 3 8 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Initially the first test has one painted cell, so the answer is 0. In the second test all events will go as is shown on the figure. "},{"attrs":{"alt":"","src":"/statement-assets/47ecc8876699fe758f3a6943358567c67b18af912c6b33cfd6daad9a44e0b6fb.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"255D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/255/problem/D"}