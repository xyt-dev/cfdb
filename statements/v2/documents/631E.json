{"assets":["/statement-assets/2f0d68f397854ec5341ad62bd6f173f3bf6f0125134b113d4f26e2d899c9b25d.png","/statement-assets/961df42792fea179a10c9a1b04fc7094e309b9478a122f799d4ad5c922f6cd25.png"],"contentKind":"statement","contestId":"631","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Product Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Blake is the boss of Kris, however, this doesn't spoil their friendship. They often gather at the bar to talk about intriguing problems about maximising some values. This time the problem is really special."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"characteristic"}],"kind":"container"},{"kind":"text","text":" of this array is the value "},{"attrs":{"alt":"","src":"/statement-assets/2f0d68f397854ec5341ad62bd6f173f3bf6f0125134b113d4f26e2d899c9b25d.png"},"kind":"image"},{"kind":"text","text":" — the sum of the products of the values "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". One may perform the following operation "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":": pick some element of the array and move to any position. In particular, it's allowed to move the element to the beginning or to the end of the array. Also, it's allowed to put it back to the initial position. The goal is to get the array with the maximum possible value of characteristic."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/961df42792fea179a10c9a1b04fc7094e309b9478a122f799d4ad5c922f6cd25.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":") — the size of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|ai| ≤ 1 000 000"},{"kind":"text","text":") — the elements of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible value of characteristic of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" that can be obtained by performing no more than one move."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"39"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 2 7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"49"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, one may pick the first element and place it before the third (before "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"). Thus, the answer will be "},{"kind":"math_inline","text":"3·1 + 2·2 + 4·3 + 5·4 = 39"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, one may pick the fifth element of the array and place it before the third. The answer will be "},{"kind":"math_inline","text":"1·1 + 1·2 + 1·3 + 2·4 + 7·5 = 49"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"631E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/631/problem/E"}