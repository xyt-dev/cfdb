{"assets":[],"contentKind":"statement","contestId":"2204","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sum of Digits (and Again)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For a positive (strictly greater than $$$0$$$) integer $$$x$$$, the string $$$S(x)$$$ is formed through the following process:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" initially, this string is empty; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then, the decimal representation of the number $$$x$$$ without leading zeros is appended to it on the right; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" after that, if $$$x \\le 9$$$, the process ends. Otherwise, $$$x$$$ is replaced by the sum of the digits of $$$x$$$, and the process returns to step $$$2$$$; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$S(75)$$$ is "},{"children":[{"kind":"text","text":"75123"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$S(30)$$$ is "},{"children":[{"kind":"text","text":"303"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$S(9)$$$ is "},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of digits. Your task is to rearrange the characters in this string so that it forms the string $$$S(x)$$$ for some number $$$x$$$. Removing characters and/or adding new characters is not allowed. If the given string $$$s$$$ is already the string $$$S(x)$$$ for some number $$$x$$$, you may leave it unchanged."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one string containing $$$s$$$ ($$$1 \\le |s| \\le 10^5$$$) — a sequence of digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraints on the input:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sum of lengths of $$$s$$$ over all test cases does not exceed $$$10^5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" it is possible to rearrange the digits in $$$s$$$ to obtain $$$S(x)$$$ for some positive integer $$$x$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one string — $$$s$$$ after rearranging the characters. If there are multiple valid answers, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_b