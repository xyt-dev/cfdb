{"assets":[],"contentKind":"statement","contestId":"1789","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Serval and Brain Power"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Serval loves Brain Power and his brain power problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Serval defines that a string $$$T$$$ is "},{"children":[{"kind":"text","text":"powerful"}],"kind":"container"},{"kind":"text","text":" iff $$$T$$$ can be obtained by concatenating some string $$$T'$$$ multiple times. Formally speaking, $$$T$$$ is powerful iff there exist a string $$$T'$$$ and an integer $$$k\\geq 2$$$ such that $$$$$$T=\\underbrace{T'+T'+\\dots+T'}_{k\\text{ times}}$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"children":[{"kind":"text","text":"gogogo"}],"kind":"container"},{"kind":"text","text":" is powerful because it can be obtained by concatenating "},{"children":[{"kind":"text","text":"go"}],"kind":"container"},{"kind":"text","text":" three times, but "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" is not powerful."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Serval has a string $$$S$$$ consists of lowercase English letters. He is curious about the longest powerful subsequence of $$$S$$$, and he only needs you to find out the length of it. If all the non-empty subsequences of $$$S$$$ is not powerful, the answer is considered to be $$$0$$$."}],"ki