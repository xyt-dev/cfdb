{"assets":["/statement-assets/02591e134c929f7f77adf63beb89dd6ca46d487269cec125d7b1b6f86d255008.png"],"contentKind":"statement","contestId":"358","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Dima and Continuous Line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima and Seryozha live in an ordinary dormitory room for two. One day Dima had a date with his girl and he asked Seryozha to leave the room. As a compensation, Seryozha made Dima do his homework."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher gave Seryozha the coordinates of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct points on the abscissa axis and asked to consecutively connect them by semi-circus in a certain order: first connect the first point with the second one, then connect the second point with the third one, then the third one with the fourth one and so on to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th point. Two points with coordinates "},{"kind":"math_inline","text":"(x1, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, 0)"},{"kind":"text","text":" should be connected by a semi-circle that passes above the abscissa axis with the diameter that coincides with the segment between points. Seryozha needs to find out if the line on the picture intersects itself. For clarifications, see the picture Seryozha showed to Dima (the left picture has self-intersections, the right picture doesn't have any)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/02591e134c929f7f77adf63beb89dd6ca46d487269cec125d7b1b6f86d255008.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Seryozha is not a small boy, so the coordinates of the points can be rather large. Help Dima cope with the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 103)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"math_inline","text":"( - 106 ≤ xi ≤ 106)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point has coordinates "},{"kind":"math_inline","text":"(xi, 0)"},{"kind":"text","text":". The points are not necessarily sorted by their "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" coordinate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the line has self-intersections. Otherwise, print \""},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 10 5 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 15 5 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"no\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test from the statement is on the picture to the left, the second test is on the picture to the right."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"358A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/358/problem/A"}