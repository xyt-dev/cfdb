{"assets":[],"contentKind":"statement","contestId":"1327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Count The Blocks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You wrote down all integers from $$$0$$$ to $$$10^n - 1$$$, padding them with leading zeroes so their lengths are exactly $$$n$$$. For example, if $$$n = 3$$$ then you wrote out "},{"children":[{"kind":"text","text":"000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"998"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"999"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A block in an integer $$$x$$$ is a consecutive segment of equal digits that cannot be extended to the left or to the right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, in the integer $$$00027734000$$$ there are three blocks of length $$$1$$$, one block of length $$$2$$$ and two blocks of length $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all integers $$$i$$$ from $$$1$$$ to $$$n$$$ count the number of blocks of length $$$i$$$ among the written down integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since these integers may be too large, print them modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"