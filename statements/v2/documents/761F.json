{"assets":["/statement-assets/6a54492b73926c56e78143a40595ec4a49a06084bdcc3dbbe72d89a9ebfa4dbd.png"],"contentKind":"statement","contestId":"761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Dasha and Photos"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dasha decided to have a rest after solving the problem "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" and began to look photos from previous competitions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call photos as the matrix with the size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":", which consists of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" photos especially interested her, because they can be received from photo-template by painting a rectangular area in a certain color. Let's call such photos special. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6a54492b73926c56e78143a40595ec4a49a06084bdcc3dbbe72d89a9ebfa4dbd.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"More formally the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th special photo is received from the photo-template by replacing all characters on some rectangle with upper left corner of the cell with coordinates "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" and lower right corner in the cell with coordinates "},{"kind":"math_inline","text":"(ci, di)"},{"kind":"text","text":" to the symbol "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dasha asks you to find the special photo so that the total distance from it to all other special photos is minimum. And calculate this distance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the distance between two photos as the sum of distances between all corresponding letters. The distance between two letters is the difference module of their positions in the alphabet. For example, the distance between letters '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":"' equals "},{"kind":"math_inline","text":"|8 - 13| = 5"},{"kind":"text","text":", because the letter '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"' is the 8-th in the alphabet, the letter '"},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":"' is the 13-th."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 103, 1 ≤ k ≤ 3·105)"},{"kind":"text","text":" — the number of strings in the photo-template, the number of columns and the number of special photos which are interesting for Dasha. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the string with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" length which consists of little Latin characters — the description of the photo-template."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains the description of the special photo in the following format, \""},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"di"},{"kind":"math_inline","text":"ei"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(1 ≤ ai ≤ ci ≤ n, 1 ≤ bi ≤ di ≤ m)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" — is the coordinate of the upper left corner of the rectangle, "},{"kind":"math_inline","text":"(ci, di)"},{"kind":"text","text":" — is the description of the lower right corner, and "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":" — is the little Latin letter which replaces the photo-template in the described rectangle. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the minimum total distance from the found special photo to all other special photos."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\naaa\naaa\naaa\n1 1 2 2 b\n2 2 3 3 c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 3\nabcde\neabcd\ndeabc\ncdeab\nbcdea\n1 1 3 4 f\n1 2 3 3 e\n1 3 3 4 i\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"59\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the photos are following: "}],"kind":"paragraph"},{"kind":"code_block","text":"\nbba    aaa\nbba    acc\naaa    acc\n"},{"children":[{"kind":"text","text":"The distance between them is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"761F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/761/problem/F"}