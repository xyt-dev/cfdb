{"assets":["/statement-assets/9942deddb33e755fcd1aa370582dce2aa0f04077ea0daeaa9aca6a77b33fe6ca.png","/statement-assets/3253b1c59dad949d37916331b58a7080e5ed40bfbaa35871c571adc4b06dca3f.png"],"contentKind":"statement","contestId":"687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. NP-Hard Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently, Pari and Arya did some research about NP-Hard problems and they found the "},{"children":[{"kind":"text","text":"minimum vertex cover"}],"kind":"container"},{"kind":"text","text":" problem very interesting."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose the graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" is given. Subset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" of its vertices is called a "},{"children":[{"kind":"text","text":"vertex cover"}],"kind":"container"},{"kind":"text","text":" of this graph, if for each edge "},{"kind":"math_inline","text":"uv"},{"kind":"text","text":" there is at least one endpoint of it in this set, i.e. "},{"attrs":{"alt":"","src":"/statement-assets/9942deddb33e755fcd1aa370582dce2aa0f04077ea0daeaa9aca6a77b33fe6ca.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/statement-assets/3253b1c59dad949d37916331b58a7080e5ed40bfbaa35871c571adc4b06dca3f.png"},"kind":"image"},{"kind":"text","text":" (or both)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pari and Arya have won a great undirected graph as an award in a team contest. Now they have to split it in two parts, but both of them want their parts of the graph to be a vertex cover."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They have agreed to give you their graph and you need to find two "},{"children":[{"kind":"text","text":"disjoint"}],"kind":"container"},{"kind":"text","text":" subsets of its vertices "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", such that both "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" are vertex cover or claim it's impossible. Each vertex should be given to no more than one of the friends (or you can even keep it for yourself)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 100 000"},{"kind":"text","text":") — the number of vertices and the number of edges in the prize graph, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  ui,  vi  ≤  n"},{"kind":"text","text":"), denoting an undirected edge between "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". It's guaranteed the graph won't contain any self-loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to split the graph between Pari and Arya as they expect, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are two disjoint sets of vertices, such that both sets are vertex cover, print their descriptions. Each description must contain two lines. The first line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" denoting the number of vertices in that vertex cover, and the second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers — the indices of vertices. Note that because of "},{"kind":"math_inline","text":"m ≥ 1"},{"kind":"text","text":", vertex cover cannot be empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 \n2\n1 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, you can give the vertex number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to Arya and vertices numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to Pari and keep vertex number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" for yourself (or give it someone, if you wish)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there is no way to satisfy both Pari and Arya."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"687A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/687/problem/A"}