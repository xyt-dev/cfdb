{"assets":["/statement-assets/6a42896e878139e1a567b91bcff3b1a44ff2510226a92e54f6f73d463b81c307.png","/statement-assets/a105994d99fc5197928f20423d4ad6cfec5a17a4416e215fee62136f56421145.png","/statement-assets/b47c5fb654042b208b71b1436bc515ed294bbb704360c24708a0c391806c04f4.png"],"contentKind":"statement","contestId":"852","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Property"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bill is a famous mathematician in BubbleLand. Thanks to his revolutionary math discoveries he was able to make enough money to build a beautiful house. Unfortunately, for not paying property tax on time, court decided to punish Bill by making him lose a part of his property."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bill’s property can be observed as a convex regular "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":"-sided polygon "},{"kind":"math_inline","text":"A0 A1... A2n - 1 A2n,  A2n =  A0"},{"kind":"text","text":", with sides of the exactly 1 meter in length. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Court rules for removing part of his property are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Split every edge "},{"kind":"math_inline","text":"Ak Ak + 1,  k = 0... 2n - 1"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" equal parts of size "},{"kind":"math_inline","text":"1 / n"},{"kind":"text","text":" with points "},{"kind":"math_inline","text":"P0, P1, ..., Pn - 1"}],"kind":"list_item"},{"children":[{"kind":"text","text":" On every edge "},{"kind":"math_inline","text":"A2k A2k + 1,  k = 0... n - 1"},{"kind":"text","text":" court will choose one point "},{"kind":"math_inline","text":"B2k =  Pi"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"i = 0, ...,  n - 1"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/6a42896e878139e1a567b91bcff3b1a44ff2510226a92e54f6f73d463b81c307.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"kind":"text","text":" On every edge "},{"kind":"math_inline","text":"A2k + 1A2k + 2,  k = 0...n - 1"},{"kind":"text","text":" Bill will choose one point "},{"kind":"math_inline","text":"B2k + 1 =  Pi"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"i = 0, ...,  n - 1"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/a105994d99fc5197928f20423d4ad6cfec5a17a4416e215fee62136f56421145.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Bill gets to keep property inside of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":"-sided polygon "},{"kind":"math_inline","text":"B0 B1... B2n - 1"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Luckily, Bill found out which "},{"kind":"math_inline","text":"B2k"},{"kind":"text","text":" points the court chose. Even though he is a great mathematician, his house is very big and he has a hard time calculating. Therefore, he is asking you to help him choose points so he maximizes area of property he can keep."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n (2 ≤ n ≤ 50000)"},{"kind":"text","text":", representing number of edges of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":"-sided polygon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integer numbers "},{"kind":"math_inline","text":"B2k (0 ≤ B2k ≤ n - 1,  k = 0... n - 1)"},{"kind":"text","text":" separated by a single space, representing points the court chose. If "},{"kind":"math_inline","text":"B2k = i"},{"kind":"text","text":", the court chose point "},{"kind":"math_inline","text":"Pi"},{"kind":"text","text":" on side "},{"kind":"math_inline","text":"A2k A2k + 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers separated by a single space representing points "},{"kind":"math_inline","text":"B1, B3, ..., B2n - 1"},{"kind":"text","text":" Bill should choose in order to maximize the property area. If there are multiple solutions that maximize the area, return any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"To maximize area Bill should choose points: "},{"kind":"math_inline","text":"B1 = P0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B3 = P2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B5 = P1"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b47c5fb654042b208b71b1436bc515ed294bbb704360c24708a0c391806c04f4.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"852C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/852/problem/C"}