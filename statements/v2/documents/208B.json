{"assets":[],"contentKind":"statement","contestId":"208","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Solitaire"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A boy named Vasya wants to play an old Russian solitaire called \"Accordion\". In this solitaire, the player must observe the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A deck of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards is carefully shuffled, then all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards are put on the table in a line from left to right; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Before each move the table has several piles of cards lying in a line (initially there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles, each pile has one card). Let's number the piles from left to right, from 1 to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". During one move, a player can take the whole pile with the maximum number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (that is the rightmost of remaining) and put it on the top of pile "},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":" (if it exists) or on the top of pile "},{"kind":"math_inline","text":"x - 3"},{"kind":"text","text":" (if it exists). The player can put one pile on top of another one only if the piles' top cards have the same suits or values. Please note that if pile "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" goes on top of pile "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", then the top card of pile "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" becomes the top card of the resulting pile. Also note that each move decreases the total number of piles by 1; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The solitaire is considered completed if all cards are in the same pile. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Vasya has already shuffled the cards and put them on the table, help him understand whether completing this solitaire is possible or not. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 52)"},{"kind":"text","text":" — the number of cards in Vasya's deck. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated strings "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":", where string "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card on the table. Each string "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" consists of exactly two characters, the first one represents the card's value, the second one represents its suit. Cards on the table are numbered from left to right. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A card's value is specified by one of these characters: \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"J"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Q"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\". A card's suit is specified by one of these characters: \""},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is not guaranteed that the deck has all possible cards. Also, the cards in Vasya's deck can repeat."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print the answer to the problem: string \"YES\" (without the quotes) if completing the solitaire is possible, string \"NO\" (without the quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2S 2S 2C 2C\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3S 2C\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can act like that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" put the 4-th pile on the 1-st one; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" put the 3-rd pile on the 2-nd one; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" put the 2-nd pile on the 1-st one. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample there is no way to complete the solitaire."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"208B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/208/problem/B"}