{"assets":["/statement-assets/e6135f75822c8d2bdde7c8e2826ec1ba7967c4d7c73588d3f7d463d29848c77b.png","/statement-assets/da0e156fadb3a256ab7d2d176ce7226bdf3003873be626b7f9a24dfc67907889.png","/statement-assets/804d1e696d01b07244e1b4cbfb4f2b4983bbc5a4350474304bb13ac9a99d5ec8.png","/statement-assets/ae0f5938e091c709011d37d7e4e7045a8a5476b6db767dbf8aba07451d674262.png"],"contentKind":"statement","contestId":"1364","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ehab's Last Corollary"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a connected undirected graph with $$$n$$$ vertices and an integer $$$k$$$, you have to either:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either find an independent set that has "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$\\lceil\\frac{k}{2}\\rceil$$$ vertices."}],"kind":"list_item"},{"children":[{"kind":"text","text":" or find a "},{"children":[{"kind":"text","text":"simple"}],"kind":"container"},{"kind":"text","text":" cycle of length "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"An independent set is a set of vertices such that no two of them are connected by an edge. A simple cycle is a cycle that doesn't contain any vertex twice. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"I have a proof that for any input you can always solve at least one of these problems, but it's left as an exercise for the reader."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$, and $$$k$$$ ($$$3 \\le k \\le n \\le 10^5$$$, $$$n-1 \\le m \\le 2 \\cdot 10^5$$$) — the number of vertices and edges in the graph, and the parameter $$$k$$$ from the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains two integers $$$u$$$ and $$$v$$$ ($$$1 \\le u,v \\le n$$$) that mean there's an edge between vertices $$$u$$$ and $$$v$$$. It's guaranteed that the graph is connected and doesn't contain any self-loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If you choose to solve the first problem, then on the first line print $$$1$$$, followed by a line containing $$$\\lceil\\frac{k}{2}\\rceil$$$ distinct integers not exceeding $$$n$$$, the vertices in the desired independent set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you, however, choose to solve the second problem, then on the first line print $$$2$$$, followed by a line containing one integer, $$$c$$$, representing the length of the found cycle, followed by a line containing $$$c$$$ distinct integers not exceeding $$$n$$$, the vertices in the desired cycle, "},{"children":[{"kind":"text","text":"in the order they appear in the cycle"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 4 3\n1 2\n2 3\n3 4\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 5 3\n1 2\n2 3\n3 4\n4 1\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n3\n2 3 4 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 6 3\n1 2\n2 3\n3 4\n4 1\n1 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n3\n1 2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 4 5\n1 2\n1 3\n2 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 4 5 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e6135f75822c8d2bdde7c8e2826ec1ba7967c4d7c73588d3f7d463d29848c77b.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice that printing the independent set $$$\\{2,4\\}$$$ is also OK, but printing the cycle $$$1-2-3-4$$$ isn't, because its length must be at most $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/da0e156fadb3a256ab7d2d176ce7226bdf3003873be626b7f9a24dfc67907889.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice that printing the independent set $$$\\{1,3\\}$$$ or printing the cycle $$$2-1-4$$$ is also OK."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/804d1e696d01b07244e1b4cbfb4f2b4983bbc5a4350474304bb13ac9a99d5ec8.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ae0f5938e091c709011d37d7e4e7045a8a5476b6db767dbf8aba07451d674262.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1364D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1364/problem/D"}