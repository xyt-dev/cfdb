{"assets":[],"contentKind":"statement","contestId":"855","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Harry Vs Voldemort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After destroying all of Voldemort's Horcruxes, Harry and Voldemort are up for the final battle. They each cast spells from their wands and the spells collide."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The battle scene is Hogwarts, which can be represented in the form of a tree. There are, in total, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" places in Hogwarts joined using "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" undirected roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ron, who was viewing this battle between Harry and Voldemort, wondered how many triplets of places "},{"kind":"math_inline","text":"(u, v, w)"},{"kind":"text","text":" are there such that if Harry is standing at place "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and Voldemort is standing at place "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", their spells collide at a place "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". This is possible for a triplet only when "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" are distinct, and there exist paths from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" which do not pass through the same roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, due to the battle havoc, new paths are being added all the time. You have to tell Ron the answer after each addition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, you are given a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges. "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" new edges are being added between the nodes of the tree. After each addition you need to tell the number of triplets "},{"kind":"math_inline","text":"(u, v, w)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" are distinct and there exist two paths, one between "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", another between "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" such that these paths do not have an edge in common."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the number of places in Hogwarts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two space separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":") indicating a road between places "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It is guaranteed that the given roads form a connected tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":"), the number of new edges being added."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two space separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":") representing the new road being added."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is possible that a newly added road connects places that were connected by a road before. Also, a newly added road may connect a place to itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the value for the number of triplets before any changes occurred."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, a single integer "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" in each line containing the value for the number of triplets after "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge addition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n2 4\n2\n1 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n18\n24\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 3\n3 4\n4 5\n1\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n60\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, for the initial tree, we have "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 1, 2)"},{"kind":"text","text":" as the only possible triplets "},{"kind":"math_inline","text":"(u, v, w)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After addition of edge from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", we have "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":" as the possible triplets."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"855G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/855/problem/G"}