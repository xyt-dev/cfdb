{"assets":["/statement-assets/095fd9caf333a3f006ac518433cb7b882194db6c6049fa3c2df27ab435750883.png"],"contentKind":"statement","contestId":"1610","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Mashtali vs AtCoder"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After many unsuccessful tries, Mashtali decided to "},{"children":[{"kind":"text","text":"copy"}],"kind":"container"},{"kind":"text","text":" modify "},{"attrs":{"href":"https://atcoder.jp/contests/agc017/tasks/agc017_d"},"children":[{"kind":"text","text":"an AtCoder problem"}],"kind":"link"},{"kind":"text","text":". So here is his "},{"children":[{"kind":"text","text":"copied"}],"kind":"container"},{"kind":"text","text":" new problem:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a tree with $$$n$$$ vertices and some non-empty set of the vertices are pinned to the ground."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two players play a game against each other on the tree. They alternately perform the following action:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Remove an edge from the tree, then remove every connected component that has no pinned vertex."},{"children":[{"kind":"text","text":"The player who cannot move loses(every edge has been deleted already). "}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given the tree, but not the set of the pinned vertices. Your task is to determine, for each $$$k$$$, the winner of the game, if only the vertices $$$1, 2, 3, \\ldots, k$$$ are pinned and both players play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer $$$n$$$ — the number of vertices ($$$1 \\le n \\le 3 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the following $$$n-1$$$ lines contains two integers $$$u_i, v_i$$$ ($$$1 \\le u_i, v_i \\le n$$$, $$$u_i \\ne v_i$$$) — the endpoints of the $$$i$$$-th edge. It's guaranteed that these edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string of length $$$n$$$. The $$$i$$$-th character should be '1' if the first player wins the $$$i$$$-th scenario, and '2' otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n2 3\n2 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n11122\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n2 3\n1 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21122\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2\n2 4\n5 1\n6 3\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n111111\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 2\n3 7\n4 6\n2 3\n2 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2212222\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below you can see the tree in the first sample :"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/095fd9caf333a3f006ac518433cb7b882194db6c6049fa3c2df27ab435750883.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"If $$$k = 1$$$ then the first player can cut the edge $$$(1, 2)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If $$$k = 2$$$ or $$$k = 3$$$, the first player can cut the edge $$$(2, 4)$$$, after that only the edges $$$(1, 2)$$$ and $$$(2, 3)$$$ remain. After the second players move, there will be a single edge left for the first player to cut. So first player wins."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"1610I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1610/problem/I"}