{"assets":["/statement-assets/2f166163967d010bc3f4806fd1259885d4828d192fdfab59440afb5e6fe191d7.png"],"contentKind":"statement","contestId":"535","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Tavas and SaDDas"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Once again Tavas started eating coffee mix without water! Keione told him that it smells awful, but he didn't stop doing that. That's why Keione told his smart friend, SaDDas to punish him! SaDDas took Tavas' headphones and told him: \"If you solve the following problem, I'll return it to you.\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2f166163967d010bc3f4806fd1259885d4828d192fdfab59440afb5e6fe191d7.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The problem is: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"lucky number"}],"kind":"container"},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Lucky numbers"}],"kind":"container"},{"kind":"text","text":" are the positive integers whose decimal representations contain only the lucky digits 4 and 7. For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we sort all lucky numbers in increasing order, what's the 1-based index of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tavas is not as smart as SaDDas, so he asked you to do him a favor and solve this problem so he can have his headphones back."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains a lucky number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the index of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" among all lucky numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","tex