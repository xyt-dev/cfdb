{"assets":["/statement-assets/1b8e391180c89f540a114d5c97f3d0efc4bb5f7d060e7f6838af1805c88b36b0.png","/statement-assets/61101c05c486df9bc9800dc20176d8fea3db3963150b02e3153dbee71e02047c.png"],"contentKind":"statement","contestId":"698","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fix a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree is an undirected connected graph without cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider a rooted undirected tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". There are many ways to represent such a tree. One way is to create an array with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" denotes a parent of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (here, for convenience a root is considered its own parent)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1b8e391180c89f540a114d5c97f3d0efc4bb5f7d060e7f6838af1805c88b36b0.png"},"kind":"image"},{"children":[{"kind":"text","text":"For this rooted tree the array "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"[2, 3, 3, 2]"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Given a sequence "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":", one is able to restore a tree:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" There must be exactly one index "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"pr = r"},{"kind":"text","text":". A vertex "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is a root of the tree. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all other "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" vertices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", there is an edge between vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A sequence "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" is called valid if the described procedure generates some (any) rooted tree. For example, for "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":" sequences "},{"children":[{"kind":"text","text":"(1,2,2)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(2,3,1)"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"(2,1,3)"}],"kind":"container"},{"children":[{"kind":"text","text":"are not"}],"kind":"container"},{"kind":"text","text":" valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", not necessarily valid. Your task is to change the minimum number of elements, in order to get a valid sequence. Print the minimum number of changes and an example of a valid sequence after that number of changes. If there are many valid sequences achievable in the minimum number of changes, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum number of elements to change, in order to get a valid sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print any valid sequence possible to get from "},{"kind":"math_inline","text":"(a1, a2, ..., an)"},{"kind":"text","text":" in the minimum number of changes. If there are many such sequences, any of them will be accepted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 3 4 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 2 2 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n3 2 2 5 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n2 3 5 4 1 6 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 3 7 8 1 6 6 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, it's enough to change one element. In the provided output, a sequence represents a tree rooted in a vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" (because "},{"kind":"math_inline","text":"p4 = 4"},{"kind":"text","text":"), which you can see on the left drawing below. One of other correct solutions would be a sequence "},{"children":[{"kind":"text","text":"2 3 3 2"}],"kind":"container"},{"kind":"text","text":", representing a tree rooted in vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (right drawing below). On both drawings, roots are painted red."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/61101c05c486df9bc9800dc20176d8fea3db3963150b02e3153dbee71e02047c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, the given sequence is already valid."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"698B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/698/problem/B"}