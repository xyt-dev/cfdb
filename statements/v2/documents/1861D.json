{"assets":[],"contentKind":"statement","contestId":"1861","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sorting By Multiplication"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$n$$$, consisting of "},{"children":[{"kind":"text","text":"positive integers"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation on this array any number of times (possibly zero): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose three integers $$$l$$$, $$$r$$$ and $$$x$$$ such that $$$1 \\le l \\le r \\le n$$$, and multiply every $$$a_i$$$ such that $$$l \\le i \\le r$$$ by $$$x$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that you can choose "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" integer as $$$x$$$, it doesn't have to be positive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate the minimum number of operations to make the array $$$a$$$ sorted in "},{"children":[{"kind":"text","text":"strictly ascending"}],"kind":"container"},{"kind":"text","text":" order (i. e. the condition $$$a_1 \\lt a_2 \\lt \\dots \\lt a_n$$$ must be satisfied)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$)  — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the minimum number of operations required to make $$$a$$$ sorted in strictly ascending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n1 1 2 2 2\n6\n5 4 3 2 5 1\n3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can perform the operations as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$l = 2$$$, $$$r = 4$$$, $$$x = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 4$$$, $$$r = 4$$$, $$$x = 2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 5$$$, $$$r = 5$$$, $$$x = 10$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" After these operations, the array $$$a$$$ becomes $$$[1, 3, 6, 12, 20]$$$."},{"children":[{"kind":"text","text":"In the second test case, we can perform one operation as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$l = 1$$$, $$$r = 4$$$, $$$x = -2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 6$$$, $$$r = 6$$$, $$$x = 1337$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" After these operations, the array $$$a$$$ becomes $$$[-10, -8, -6, -4, 5, 1337]$$$."},{"children":[{"kind":"text","text":"In the third test case, the array $$$a$$$ is already sorted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1861D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1861/problem/D"}