{"assets":["/statement-assets/c030d77cd82b45664537456ad2b59756b45ee8234fa14648ec437704e42150b6.png","/statement-assets/5f7d766d5822f394b08e0255c408557cde578ee8d12cab5ec952f3f833ca018f.png"],"contentKind":"statement","contestId":"273","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Dima and Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima and Anya love playing different games. Now Dima has imagined a new game that he wants to play with Anya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima writes "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of integers on a piece of paper "},{"kind":"math_inline","text":"(li, ri)"},{"kind":"math_inline","text":"(1 ≤ li < ri ≤ p)"},{"kind":"text","text":". Then players take turns. On his turn the player can do the following actions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" choose the number of the pair "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"ri - li > 2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" replace pair number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" by pair "},{"attrs":{"alt":"","src":"/statement-assets/c030d77cd82b45664537456ad2b59756b45ee8234fa14648ec437704e42150b6.png"},"kind":"image"},{"kind":"text","text":" or by pair "},{"attrs":{"alt":"","src":"/statement-assets/5f7d766d5822f394b08e0255c408557cde578ee8d12cab5ec952f3f833ca018f.png"},"kind":"image"},{"kind":"text","text":". Notation "},{"kind":"math_inline","text":"⌊x⌋"},{"kind":"text","text":" means rounding down to the closest integer. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The player who can't make a move loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, Dima wants Anya, who will move first, to win. That's why Dima should write out such "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of integers "},{"kind":"math_inline","text":"(li, ri)"},{"kind":"math_inline","text":"(1 ≤ li < ri ≤ p)"},{"kind":"text","text":", that if both players play optimally well, the first one wins. Count the number of ways in which Dima can do it. Print the remainder after dividing the answer by number "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two ways are considered distinct, if the "},{"children":[{"kind":"text","text":"ordered"}],"kind":"container"},{"kind":"text","text":" sequences of the written pairs are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1000, 1 ≤ p ≤ 109)"},{"kind":"text","text":". The numbers are separated by a single space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the remainder after dividing the answer to the problem by number "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"520\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"269568947\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"273E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/273/problem/E"}