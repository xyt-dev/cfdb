string and "},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":" from the second string have LCS equal to "},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The result is $$$S(abb, abab) = (4 \\cdot |abb|$$$) - $$$|abb|$$$ - $$$|abab|$$$ = $$$4 \\cdot 3 - 3 - 4 = 5$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1446B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1446/problem/B"}