{"assets":[],"contentKind":"statement","contestId":"620","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Pearls in a Row"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pearls in a row. Let's enumerate them with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right. The pearl number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has the type "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a sequence of consecutive pearls a "},{"children":[{"kind":"text","text":"segment"}],"kind":"container"},{"kind":"text","text":". Let's call a segment "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it contains two pearls of the same type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Split the row of the pearls to the maximal number of good segments. Note that each pearl should appear in exactly one segment of the partition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As input/output can reach huge size it is recommended to use fast input/output methods: for example, prefer to use "},{"children":[{"kind":"text","text":"scanf/printf"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"cin/cout"}],"kind":"container"},{"kind":"text","text":" in C++, prefer to use "},{"children":[{"kind":"text","text":"BufferedReader/PrintWriter"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"Scanner/System.out"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") — the number of pearls in a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") – the type of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pearl."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the maximal number of segments in a partition of the row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines should contain two integers "},{"kind":"math_inline","text":"lj, rj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ lj ≤ rj ≤ n"},{"kind":"text","text":") — the number of the leftmost and the rightmost pearls in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note you should print the correct partition of the row of the pearls, so each pearl should be in exactly one segment and all segments should contain two pearls of the same type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several optimal solutions print any of them. You can print the segments in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no correct partitions of the row print the number \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2 1 3 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 3\n4 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"620C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/620/problem/C"}