{"assets":[],"contentKind":"statement","contestId":"865","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Buy Low Sell High"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You can perfectly predict the price of a certain stock for the next "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days. You would like to profit on this knowledge, but only want to transact one share of stock per day. That is, each day you will either buy one share, sell one share, or do nothing. Initially you own zero shares, and you cannot sell shares when you don't own any. At the end of the "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days you would like to again own zero shares, but want to have as much money as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input begins with an integer "},{"kind":"math_inline","text":"N"},{"kind":"math_inline","text":"(2 ≤ N ≤ 3·105)"},{"kind":"text","text":", the number of days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Following this is a line with exactly "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pN"},{"kind":"math_inline","text":"(1 ≤ pi ≤ 106)"},{"kind":"text","text":". The price of one share of stock on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day is given by "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum amount of money you can end up with at the end of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n10 5 4 7 9 12 6 2 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20\n3 1 4 1 5 9 2 6 5 3 5 8 9 7 9 3 2 3 8 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"41\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, buy a share at "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", buy another at "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", sell one at "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and another at "},{"kind":"math_inline","text":"12"},{"kind":"text","text":". Then buy at "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and sell at "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". The total profit is "},{"kind":"math_inline","text":" - 5 - 4 + 9 + 12 - 2 + 10 = 20"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"865D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/865/problem/D"}