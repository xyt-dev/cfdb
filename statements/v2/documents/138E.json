{"assets":[],"contentKind":"statement","contestId":"138","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hellish Constraints"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Katya recently started to invent programming tasks and prepare her own contests. What she does not like is boring and simple constraints. Katya is fed up with all those \""},{"kind":"math_inline","text":"N"},{"kind":"text","text":" does not exceed a thousand\" and \"the sum of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" does not exceed a million\" and she decided to come up with something a little more complicated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last problem written by Katya deals with strings. The input is a string of small Latin letters. To make the statement longer and strike terror into the people who will solve the contest, Katya came up with the following set of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" restrictions of the same type (characters in restrictions can be repeated and some restrictions may contradict each other): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The number of characters "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" in a string is not less than "},{"kind":"math_inline","text":"l1"},{"kind":"text","text":" and not more than "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The number of characters "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" in a string is not less than "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and not more than "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The number of characters "},{"kind":"math_inline","text":"ck"},{"kind":"text","text":" in a string is not less than "},{"kind":"math_inline","text":"lk"},{"kind":"text","text":" and not more than "},{"kind":"math_inline","text":"rk"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, having decided that it is too simple and obvious, Katya added the following condition: a string meets no less than "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" and not more than "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" constraints from the above given list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Katya does not like to compose difficult and mean tests, so she just took a big string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and wants to add to the tests all its substrings that meet the constraints. However, Katya got lost in her conditions and asked you to count the number of substrings of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that meet the conditions (each occurrence of the substring is counted separately)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of small Latin letters. The length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three space-separated integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ L ≤ R ≤ k ≤ 500"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain Katya's constrictions in the following form \""},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"li"},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"\". All letters "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are small Latin letters, "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" are integers ("},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ |s|"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"). Letters "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are not necessarily different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of substrings that meet the constrictions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" stream or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"codeforces\n2 0 0\no 1 2\ne 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"codeforces\n2 1 1\no 1 2\no 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test we should count the number of strings that do not contain characters \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\". All such strings are as follows (in the order of occurrence in the initial string from the left to the right): \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\"', \""},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"rc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test we cannot achieve fulfilling exactly one of the two identical constrictions, so the answer is 0."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"138E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/138/problem/E"}