{"assets":["/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png"],"contentKind":"statement","contestId":"400","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Inna and Binary Logic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Inna is fed up with jokes about female logic. So she started using binary logic instead."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Inna has an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements "},{"kind":"math_inline","text":"a1[1], a1[2], ..., a1[n]"},{"kind":"text","text":". Girl likes to train in her binary logic, so she does an exercise consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stages: on the first stage Inna writes out all numbers from array "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th "},{"kind":"math_inline","text":"(i ≥ 2)"},{"kind":"text","text":" stage girl writes all elements of array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", which consists of "},{"kind":"math_inline","text":"n - i + 1"},{"kind":"text","text":" integers; the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th integer of array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is defined as follows: "},{"kind":"math_inline","text":"ai[k] = ai - 1[k] AND ai - 1[k + 1]"},{"kind":"text","text":". Here AND is bit-wise binary logical operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima decided to check Inna's skill. He asks Inna to change array, perform the exercise and say the sum of all "},{"attrs":{"alt":"","src":"/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png"},"kind":"image"},{"kind":"text","text":" elements she wrote out during the current exercise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Inna to answer the questions!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":" — size of array "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and number of Dima's questions. Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1[1], a1[2], ..., a1[n]"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 105)"},{"kind":"text","text":" — initial array elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers — Dima's question description. Each question consists of two integers "},{"kind":"math_inline","text":"pi, vi"},{"kind":"math_inline","text":"(1 ≤ pi ≤ n; 0 ≤ vi ≤ 105)"},{"kind":"text","text":". For this question Inna should make "},{"kind":"math_inline","text":"a1[pi]"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", and then perform the exercise. Please, note that changes are saved from question to question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each question print Inna's answer on a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 1 1\n1 1\n2 2\n3 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n4\n7\n12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"400E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/400/problem/E"}