{"assets":[],"contentKind":"statement","contestId":"274","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. k-Multiple Free Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-multiple free set is a set of integers where there is no pair of integers where one is equal to another integer multiplied by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". That is, there are no two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(x < y)"},{"kind":"text","text":" from the set, such that "},{"kind":"math_inline","text":"y = x·k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers. Your task is to find the size of it's largest "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-multiple free subset."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 1 ≤ k ≤ 109"},{"kind":"text","text":"). The next line contains a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the only line of the output print the size of the largest "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-multiple free subset of "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n2 3 6 5 4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample input one of the possible maximum 2-multiple free subsets is {4, 5, 6}."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"274A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/274/problem/A"}