{"assets":[],"contentKind":"statement","contestId":"612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Simba on the Circle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a circular array with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements. The elements are numbered from some element with values from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in clockwise order. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell contains the value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The robot Simba is in cell "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each moment of time the robot is in some of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cells (at the begin he is in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"). In one turn the robot can write out the number written in current cell or move to the adjacent cell in clockwise or counterclockwise direction. To write out the number from the cell Simba doesn't spend any time, but to move to adjacent cell Simba spends one unit of time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simba wants to write the number from each cell one time, so the numbers will be written in a non decreasing order. Find the least number of time units to write out all numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s ≤ n ≤ 2000"},{"kind":"text","text":") — the number of cells in the circular array and the starting position of Simba."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the number written in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell. The numbers are given for cells in order from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Some of numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" can be equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the least number of time units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should contain the direction of robot movement and the number of cells to move in that direction. After that movement the robot writes out the number from the cell in which it turns out. The direction and the number of cells should be printed in the form of "},{"children":[{"kind":"text","text":"+x"}],"kind":"container"},{"kind":"text","text":" in case of clockwise movement and "},{"children":[{"kind":"text","text":"-x"}],"kind":"container"},{"kind":"text","text":" in case of counterclockwise movement to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" cells ("},{"kind":"math_inline","text":"0 ≤ x ≤ n - 1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the sum of absolute values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" should be equal to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 1\n0 1 2 2 2 1 0 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n+0\n-3\n-1\n+2\n+1\n+2\n+1\n+1\n+1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 1\n0 1 0 1 0 1 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n+0\n+2\n+2\n+2\n-1\n+2\n+2\n+2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 1\n1 2 3 4 5 6 7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n+0\n+1\n+1\n+1\n+1\n+1\n+1\n+1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 1\n0 0 0 0 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n+0\n+1\n+1\n+1\n+1\n+1\n+1\n+1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"612F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/612/problem/F"}