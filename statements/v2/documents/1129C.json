{"assets":[],"contentKind":"statement","contestId":"1129","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Morse Code"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Morse code, an letter of English alphabet is represented as a string of some length from $$$1$$$ to $$$4$$$. Moreover, each Morse code representation of an English letter contains only dots and dashes. In this task, we will represent a dot with a \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and a dash with a \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because there are $$$2^1+2^2+2^3+2^4 = 30$$$ strings with length $$$1$$$ to $$$4$$$ containing only \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", not all of them correspond to one of the $$$26$$$ English letters. In particular, each string of \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" of length "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$4$$$ translates into a distinct English letter, except the following four strings that do not correspond to any English alphabet: \""},{"children":[{"kind":"text","text":"0011"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"1110"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"1111"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will work with a string $$$S$$$, which is initially empty. For $$$m$$$ times, either a dot or a dash will be appended to $$$S$$$, one at a time. Your task is to find and report, after each of these modifications to string $$$S$$$, the number of non-empty sequences of English letters that are represented with some substring of $$$S$$$ in Morse code."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answers can be incredibly tremendous, print them modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$m$$$ ($$$1 \\leq m \\leq 3\\,000$$$) — the number of modifications to $$$S$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains either a \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" (representing a dot) or a \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" (representing a dash), specifying which character should be appended to $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$m$$$ lines, the $$$i$$$-th of which being the answer after the $$$i$$$-th modification to $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1\n0\n1\n0\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n10\n22\n43\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n1\n1\n0\n0\n0\n1\n1\n0\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n10\n24\n51\n109\n213\n421\n833\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let us consider the first sample after all characters have been appended to $$$S$$$, so S is \""},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As you can see, \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":"\" all correspond to some distinct English letter. In fact, they are translated into a '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"', an '"},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"', and an '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"', respectively. All non-empty sequences of English letters that are represented with some substring of $$$S$$$ in Morse code, therefore, are as follows."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" (translates into \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\") "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"\" (translates into \""},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\") "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"\" (translates into \""},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":"\") "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"TT"}],"kind":"container"},{"kind":"text","text":"\" (translates into \""},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\") "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","tex