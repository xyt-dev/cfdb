{"assets":[],"contentKind":"statement","contestId":"92","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chips"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" walruses sitting in a circle. All of them are numbered in the clockwise order: the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" sits to the left of the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the walrus number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" sits to the left of the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", ..., the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" sits to the left of the walrus number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The presenter has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" chips. The presenter stands in the middle of the circle and starts giving the chips to the walruses starting from walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and moving clockwise. The walrus number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" gets "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" chips. If the presenter can't give the current walrus the required number of chips, then the presenter takes the remaining chips and the process ends. Determine by the given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" how many chips the presenter will get in the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 104"},{"kind":"text","text":") — the number of walruses and the number of chips correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of chips the presenter ended up with."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"17 107\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the presenter gives one chip to the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", two chips to the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", three chips to the walrus number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", four chips to the walrus number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", then again one chip to the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". After that the presenter runs out of chips. He can't give anything to the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and the process finishes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the presenter gives one chip to the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", two chips to the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", three chips to the walrus number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", then again one chip to the walrus number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The presenter has one chip left and he can't give two chips to the walrus number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", that's why the presenter takes the last chip."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"92A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/92/problem/A"}