{"assets":[],"contentKind":"statement","contestId":"5","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chat Server's Outgoing Traffic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is working on a new project called \"Polychat\". Following modern tendencies in IT, he decided, that this project should contain chat as well. To achieve this goal, Polycarp has spent several hours in front of his laptop and implemented a chat server that can process three types of commands:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Include a person to the chat ("},{"children":[{"kind":"text","text":"'Add'"}],"kind":"container"},{"kind":"text","text":" command). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove a person from the chat ("},{"children":[{"kind":"text","text":"'Remove'"}],"kind":"container"},{"kind":"text","text":" command). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Send a message from a person to all people, who are currently in the chat, including the one, who sends the message ("},{"children":[{"kind":"text","text":"'Send'"}],"kind":"container"},{"kind":"text","text":" command). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Polycarp wants to find out the amount of outgoing traffic that the server will produce while processing a particular set of commands."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp knows that chat server sends no traffic for 'Add' and 'Remove' commands. When 'Send' command is processed, server sends "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" bytes to each participant of the chat, where "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" is the length of the message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As Polycarp has no time, he is asking for your help in solving this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input file will contain not more than 100 commands, each in its own line. No line will exceed 100 characters. Formats of the commands will be the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"+<name>"}],"kind":"container"},{"kind":"text","text":" for "},{"children":[{"kind":"text","text":"'Add'"}],"kind":"container"},{"kind":"text","text":" command. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"-<name>"}],"kind":"container"},{"kind":"text","text":" for "},{"children":[{"kind":"text","text":"'Remove'"}],"kind":"container"},{"kind":"text","text":" command. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"<sender_name>:<message_text>"}],"kind":"container"},{"kind":"text","text":" for "},{"children":[{"kind":"text","text":"'Send'"}],"kind":"container"},{"kind":"text","text":" command. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"<name>"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"<sender_name>"}],"kind":"container"},{"kind":"text","text":" is a non-empty sequence of Latin letters and digits. "},{"children":[{"kind":"text","text":"<message_text>"}],"kind":"container"},{"kind":"text","text":" can contain letters, digits and spaces, but can't start or end with a space. "},{"children":[{"kind":"text","text":"<message_text>"}],"kind":"container"},{"kind":"text","text":" can be an empty line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that input data are correct, i.e. there will be no "},{"children":[{"kind":"text","text":"'Add'"}],"kind":"container"},{"kind":"text","text":" command if person with such a name is already in the chat, there will be no "},{"children":[{"kind":"text","text":"'Remove'"}],"kind":"container"},{"kind":"text","text":" command if there is no person with such a name in the chat etc."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All names are case-sensitive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"+Mike\nMike:hello\n+Kate\n+Dmitry\n-Dmitry\nKate:hi\n-Kate\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"+Mike\n-Mike\n+Mike\nMike:Hi   I am here\n-Mike\n+Kate\n-Kate\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"5A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/5/problem/A"}