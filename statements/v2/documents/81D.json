{"assets":[],"contentKind":"statement","contestId":"81","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Polycarp's Picture Gallery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp loves not only to take pictures, but also to show his photos to friends. On his personal website he has recently installed a widget that can display "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos with the scroll option. At each moment of time the widget displays exactly one photograph with the option showing the previous/next one. From the first photo, you can switch to the second one or to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th one, from the second photo you can switch to the third one or to the first one, etc. Thus, navigation is performed in a cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp's collection consists of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" photo albums, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th album contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" photos. Polycarp wants to choose "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos and put them on a new widget. To make watching the photos interesting to the visitors, he is going to post pictures so that no two photos from one album were neighboring (each photo will have exactly two neighbors, the first photo's neighbors are the second and the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th one)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp compile a photo gallery. Select "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos from his collection and put them in such order that no two photos from one album went one after the other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 40"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of photos on the widget, and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of albums. The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of photos in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th album."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if there is no solution. Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" represents the number of the album of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th picture in the widget. The albums are numbered from 1 in the order of their appearance in the input. If there are several solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\n5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 2 1 2 1 2 1 2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n1 10 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"81D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/81/problem/D"}