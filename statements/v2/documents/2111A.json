{"assets":[],"contentKind":"statement","contestId":"2111","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Energy Crystals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are three energy crystals numbered $$$1$$$, $$$2$$$, and $$$3$$$; let's denote the energy level of the $$$i$$$-th crystal as $$$a_i$$$. Initially, all of them are discharged, meaning their energy levels are equal to $$$0$$$. Each crystal needs to be charged to level $$$x$$$ "},{"children":[{"kind":"text","text":"(exactly $$$x$$$, not greater)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one action, you can increase the energy level of any one crystal by any positive amount; however, the energy crystals are synchronized with each other, so an action can only be performed if the following condition is met afterward:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each pair of crystals $$$i$$$, $$$j$$$, it must hold that $$$a_{i} \\ge \\lfloor\\frac{a_{j}}{2}\\rfloor$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the minimum number of actions required to charge all the crystals?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of several test cases. The first line contains a single integer $