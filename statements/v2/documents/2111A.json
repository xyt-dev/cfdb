[3, \\color{red}{5}, 2] \\to [\\color{red}{5}, 5, 2] \\to [5, 5, \\color{red}{5}]$$$$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2111A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2111/problem/A"}