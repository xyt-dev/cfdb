{"assets":[],"contentKind":"statement","contestId":"705","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Hulk"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dr. Bruce Banner hates his enemies (like others don't). As we all know, he can barely talk when he turns into the incredible Hulk. That's why he asked you to help him to express his feelings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hulk likes the Inception so much, and like that his feelings are complicated. They have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" layers. The first layer is hate, second one is love, third one is hate and so on..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example if "},{"kind":"math_inline","text":"n = 1"},{"kind":"text","text":", then his feeling is \""},{"children":[{"kind":"text","text":"I hate it"}],"kind":"container"},{"kind":"text","text":"\" or if "},{"kind":"math_inline","text":"n = 2"},{"kind":"text","text":" it's \""},{"children":[{"kind":"text","text":"I hate that I love it"}],"kind":"container"},{"kind":"text","text":"\", and if "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":" it's \""},{"children":[{"kind":"text","text":"I hate that I love that I hate it"}],"kind":"container"},{"kind":"text","text":"\" and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Dr. Banner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"c