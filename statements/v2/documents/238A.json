{"assets":["/statement-assets/cbeb24eec35ca35e9a231a97beba823b287a30be7e103d09ee6d2dc926df8f24.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"238","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Not Wool Sequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"wool sequence"}],"kind":"container"},{"kind":"text","text":" if and only if there exists two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ n)"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/cbeb24eec35ca35e9a231a97beba823b287a30be7e103d09ee6d2dc926df8f24.png"},"kind":"image"},{"kind":"text","text":". In other words each wool sequence contains a subsequence of consecutive elements with xor equal to 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying the operation of a bitwise xor to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages, for example, in languages "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it is marked as \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — as \""},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you are asked to compute the number of sequences made of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers from 0 to "},{"kind":"math_inline","text":"2m - 1"},{"kind":"text","text":" that are not a wool sequence. You should print this number modulo "},{"kind":"math_inline","text":"1000000009"},{"kind":"math_inline","text":"(109 + 9)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number of sequences modulo "},{"kind":"math_inline","text":"1000000009"},{"kind":"math_inline","text":"(109 + 9)"},{"kind":"text","text":" on the only line of output."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sequences of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" made of integers 0, 1, 2 and 3 that are not a wool sequence are "},{"children":[{"kind":"text","text":"(1, 3, 1)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(1, 2, 1)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(2, 1, 2)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(2, 3, 2)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(3, 1, 3)"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"(3, 2, 3)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"238A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/238/problem/A"}