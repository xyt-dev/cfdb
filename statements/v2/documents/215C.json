{"assets":["/statement-assets/24c998207acdb5cbb89ea8e0a8f57177816be9b8edc60189c2a7d6505413f7e8.png"],"contentKind":"statement","contestId":"215","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Crosses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a board with a grid consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns, the rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from top to bottom and the columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from left to right. In this grid we will denote the cell that lies on row number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A group of six numbers "},{"kind":"math_inline","text":"(a, b, c, d, x0, y0)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"0 ≤ a, b, c, d"},{"kind":"text","text":", is a "},{"children":[{"kind":"text","text":"cross"}],"kind":"container"},{"kind":"text","text":", and there is a set of cells that are assigned to it. Cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" belongs to this set if "},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"kind":"text","text":" of two conditions are fulfilled:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"|x0 - x| ≤ a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|y0 - y| ≤ b"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"|x0 - x| ≤ c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|y0 - y| ≤ d"}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/24c998207acdb5cbb89ea8e0a8f57177816be9b8edc60189c2a7d6505413f7e8.png"},"kind":"image"},{"children":[{"kind":"text","text":" The picture shows the cross "},{"kind":"math_inline","text":"(0, 1, 1, 0, 2, 3)"},{"kind":"text","text":" on the grid "},{"kind":"math_inline","text":"3 × 4"},{"kind":"text","text":". "}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Your task is to find the number of different groups of six numbers, "},{"kind":"math_inline","text":"(a, b, c, d, x0, y0)"},{"kind":"text","text":" that determine the crosses of an area equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", which are placed entirely on the grid. The cross is placed entirely on the grid, if any of its cells is in the range of the grid (that is for each cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" of the cross "},{"kind":"math_inline","text":"1 ≤ x ≤ n; 1 ≤ y ≤ m"},{"kind":"text","text":" holds). The area of the cross is the number of cells it has."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that two crosses are considered distinct if the ordered groups of six numbers that denote them are distinct, even if these crosses coincide as sets of points."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s ≤ n·m"},{"kind":"text","text":"). The integers are separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of distinct groups of six integers that denote crosses with area "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and that are fully placed on the "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the cin, cout streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the sought groups of six numbers are: "},{"kind":"math_inline","text":"(0, 0, 0, 0, 1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 0, 0, 0, 1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 0, 0, 0, 2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 0, 0, 0, 2, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the sought groups of six numbers are: "},{"kind":"math_inline","text":"(0, 1, 1, 0, 2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 1, 1, 0, 2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 0, 0, 1, 2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 0, 0, 1, 2, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"215C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/215/problem/C"}