{"assets":["/statement-assets/e0d1024d3c0179efca16a4e3a30f2dbfea192de7c5b219b4c7502ce816c86a78.png","/statement-assets/06407946bf8a2f366e34195621c7f73054494ba8e59cdc44193dab678a6c5c13.png","/statement-assets/12bd7f9f26850d7cff76e535c36525938a6b9767067051e48a6f3f45df119255.png"],"contentKind":"statement","contestId":"599","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sandy and Nuts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Rooted tree"}],"kind":"container"},{"kind":"text","text":" is a connected graph without any simple cycles with one vertex selected as a root. In this problem the vertex number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" will always serve as a root."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lowest common ancestor"}],"kind":"container"},{"kind":"text","text":" of two vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is the farthest from the root vertex that lies on both the path from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to the root and on path from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to the root. We will denote it as "},{"kind":"math_inline","text":"LCA(u, v)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sandy had a rooted tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices that she used to store her nuts. Unfortunately, the underwater storm broke her tree and she doesn't remember all it's edges. She only managed to restore "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges of the initial tree and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" triples "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", for which she supposes "},{"kind":"math_inline","text":"LCA(ai, bi) = ci"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Sandy count the number of trees of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" with vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" as a root, that match all the information she remembered. If she made a mess and there are no such trees then print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Two rooted trees are considered to be distinct if there exists an edge that occur in one of them and doesn't occur in the other one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 13, 0 ≤ m < n, 0 ≤ q ≤ 100"},{"kind":"text","text":") — the number of vertices, the number of edges and "},{"kind":"math_inline","text":"LCA"},{"kind":"text","text":" triples remembered by Sandy respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n, ui ≠ vi"},{"kind":"text","text":") — the numbers of vertices connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. It's guaranteed that this set of edges is a subset of edges of some tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the triplets of numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi, ci ≤ n)"},{"kind":"text","text":". Each of these triples define "},{"kind":"math_inline","text":"LCA(ai, bi) = ci"},{"kind":"text","text":". It's "},{"children":[{"kind":"text","text":"not guaranteed"}],"kind":"container"},{"kind":"text","text":" that there exists a tree that satisfy all the given "},{"kind":"math_inline","text":"LCA"},{"kind":"text","text":" conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of trees of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that satisfy all the conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0 1\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 0\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0 2\n2 3 2\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2\n1 2\n2 2 2\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample correct answer looks like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e0d1024d3c0179efca16a4e3a30f2dbfea192de7c5b219b4c7502ce816c86a78.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the third sample there are two possible trees:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/06407946bf8a2f366e34195621c7f73054494ba8e59cdc44193dab678a6c5c13.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/12bd7f9f26850d7cff76e535c36525938a6b9767067051e48a6f3f45df119255.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth sample the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" because the information about "},{"kind":"math_inline","text":"LCA"},{"kind":"text","text":" is inconsistent."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"599E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/599/problem/E"}