{"assets":["/statement-assets/eaedbffe75606d83cf5128a597711810a4903fc8df5b9ac6b85a856eab8c3b19.png","/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png","/statement-assets/1c21f0a4c41a3993d832b7fff72ae9a84cb122ed54cd0aa9b00647d079ad63a6.png","/statement-assets/e4448f668a78f787e3880f9df7fb5f8f3f012bc39ed803cc6079ad5d3050b961.png","/statement-assets/f313731c2145580082b04b0b7f1bfed33c3aa7e4a0292ea5a1a16df22443708f.png","/statement-assets/70853e756b7151174bdba1fee8679dadb4d77cda661f5b2da46273442e4d0819.png","/statement-assets/15ec6450a3dc4d4768223f97f8e40d0bd3a6318c4864122ce0e2cace49f33bc4.png","/statement-assets/39e6ea849e58bde6bb2974908d80deff02786d38627f9629dd174510049684a8.png","/statement-assets/b9fa5bd974c02d27614cf22618e7529a137c91a6178c4f4a3efed62c0701bb2e.png"],"contentKind":"statement","contestId":"722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Research Rover"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Unfortunately, the formal description of the task turned out to be too long, so here is the legend."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Research rover finally reached the surface of Mars and is ready to complete its mission. Unfortunately, due to the mistake in the navigation system design, the rover is located in the wrong place."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rover will operate on the grid consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. We will define as "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" the cell located in the row "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". From each cell the rover is able to move to any cell that share a side with the current one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rover is currently located at cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and has to move to the cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". It will randomly follow some "},{"children":[{"kind":"text","text":"shortest path"}],"kind":"container"},{"kind":"text","text":" between these two cells. Each possible way is chosen equiprobably."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cargo section of the rover contains the battery required to conduct the research. Initially, the battery charge is equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" units of energy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some of the cells contain anomaly. Each time the rover gets to the cell with anomaly, the battery looses half of its charge rounded down. Formally, if the charge was equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" before the rover gets to the cell with anomaly, the charge will change to "},{"attrs":{"alt":"","src":"/statement-assets/eaedbffe75606d83cf5128a597711810a4903fc8df5b9ac6b85a856eab8c3b19.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While the rover picks a random shortest path to proceed, compute the expected value of the battery charge after it reaches cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". If the cells "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":" contain anomaly, they also affect the charge of the battery."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s ≤ 1 000 000"},{"kind":"text","text":") — the number of rows and columns of the field, the number of cells with anomaly and the initial charge of the battery respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The follow "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines containing two integers "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ m"},{"kind":"text","text":") — coordinates of the cells, containing anomaly. It's guaranteed that each cell appears in this list no more than once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer can always be represented as an irreducible fraction "},{"attrs":{"alt":"","src":"/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png"},"kind":"image"},{"kind":"text","text":". Print the only integer "},{"kind":"math_inline","text":"P·Q - 1"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2 11\n2 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"333333342\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 3 17\n1 2\n3 3\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"514285727\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 6 2 15\n1 1\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the rover picks one of the following six routes:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/1c21f0a4c41a3993d832b7fff72ae9a84cb122ed54cd0aa9b00647d079ad63a6.png"},"kind":"image"},{"kind":"text","text":", after passing cell "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" charge is equal to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e4448f668a78f787e3880f9df7fb5f8f3f012bc39ed803cc6079ad5d3050b961.png"},"kind":"image"},{"kind":"text","text":", after passing cell "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" charge is equal to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f313731c2145580082b04b0b7f1bfed33c3aa7e4a0292ea5a1a16df22443708f.png"},"kind":"image"},{"kind":"text","text":", charge remains unchanged and equals "},{"kind":"math_inline","text":"11"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/70853e756b7151174bdba1fee8679dadb4d77cda661f5b2da46273442e4d0819.png"},"kind":"image"},{"kind":"text","text":", after passing cells "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" charge equals "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and then "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/15ec6450a3dc4d4768223f97f8e40d0bd3a6318c4864122ce0e2cace49f33bc4.png"},"kind":"image"},{"kind":"text","text":", after passing cell "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" charge is equal to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/39e6ea849e58bde6bb2974908d80deff02786d38627f9629dd174510049684a8.png"},"kind":"image"},{"kind":"text","text":", after passing cell "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" charge is equal to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Expected value of the battery charge is calculated by the following formula:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b9fa5bd974c02d27614cf22618e7529a137c91a6178c4f4a3efed62c0701bb2e.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus "},{"kind":"math_inline","text":"P = 19"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"Q = 3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"3 - 1"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"333333336"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"19·333333336 = 333333342 (mod 109 + 7)"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"722E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/722/problem/E"}