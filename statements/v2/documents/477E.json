{"assets":[],"contentKind":"statement","contestId":"477","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Dreamoon and Notepad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dreamoon has just created a document of hard problems using notepad.exe. The document consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of text, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line. He now wants to know what is the fastest way to move the cursor around because the document is really long."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" be a current cursor position, where "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is row number and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is position of cursor in the row. We have "},{"kind":"math_inline","text":"1 ≤ r ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"0 ≤ c ≤ ar"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can use following six operations in notepad.exe to move our cursor assuming the current cursor position is at "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" up key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (max(r - 1, 1), min(anr, c))"}],"kind":"list_item"},{"children":[{"kind":"text","text":" down key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (min(r + 1, n), min(anr, c))"}],"kind":"list_item"},{"children":[{"kind":"text","text":" left key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (r, max(0, c - 1))"}],"kind":"list_item"},{"children":[{"kind":"text","text":" right key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (r, min(anr, c + 1))"}],"kind":"list_item"},{"children":[{"kind":"text","text":" HOME key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (r, 0)"}],"kind":"list_item"},{"children":[{"kind":"text","text":" END key: the new cursor position "},{"kind":"math_inline","text":"(nr, nc) = (r, ar)"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You're given the document description ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries from Dreamoon. Each query asks what minimal number of key presses is needed to move the cursor from "},{"kind":"math_inline","text":"(r1, c1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(r2, c2)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n(1 ≤ n ≤ 400, 000)"},{"kind":"text","text":" — the number of lines of text. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an(1 ≤ ai ≤ 108)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"q(1 ≤ q ≤ 400, 000)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains four integers "},{"kind":"math_inline","text":"r1, c1, r2, c2"},{"kind":"text","text":" representing a query ("},{"kind":"math_inline","text":"1 ≤ r1, r2 ≤ n, 0 ≤ c1 ≤ ar1, 0 ≤ c2 ≤ ar2"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print the result of the query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n1 3 5 3 1 3 5 3 1\n4\n3 5 3 1\n3 3 7 3\n1 0 3 3\n6 0 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n5\n3\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n10 5\n1\n1 0 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2}