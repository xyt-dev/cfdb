{"assets":["/statement-assets/8158e966298cc892c16e3931ef22adb4037ca170550a5c2091bfc69fe453f055.png","/statement-assets/1996b366ce28eb7a1d6312d8ec7cca0d0f141a8bb2e67f89e44a2743cc75bcd3.png"],"contentKind":"statement","contestId":"536","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tavas on the Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tavas lives in Tavaspolis. Tavaspolis has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" connected by "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads. There exists a path between any two cities. Also each road has a length."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8158e966298cc892c16e3931ef22adb4037ca170550a5c2091bfc69fe453f055.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Tavas' favorite strings are binary strings (they contain only 0 and 1). For any binary string like "},{"kind":"math_inline","text":"s = s1s2... sk"},{"kind":"text","text":", "},{"kind":"math_inline","text":"T(s)"},{"kind":"text","text":" is its "},{"kind":"math_inline","text":"Goodness"},{"kind":"text","text":". "},{"kind":"math_inline","text":"T(s)"},{"kind":"text","text":" can be calculated as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider there are exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" blocks of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"s in this string (a block of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"s in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a maximal consecutive substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that only contains "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") with lengths "},{"kind":"math_inline","text":"x1, x2, ..., xm"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define "},{"attrs":{"alt":"","src":"/statement-assets/1996b366ce28eb7a1d6312d8ec7cca0d0f141a8bb2e67f89e44a2743cc75bcd3.png"},"kind":"image"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is a given sequence (if "},{"kind":"math_inline","text":"m = 0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"T(s) = 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tavas loves queries. He asks you to answer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. In each query he gives you numbers "},{"kind":"math_inline","text":"v, u, l"},{"kind":"text","text":" and you should print following number:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the roads on the path from city "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"u"},{"kind":"text","text":": "},{"kind":"math_inline","text":"e1, e2, ..., ex"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Build the binary string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that: "},{"kind":"math_inline","text":"bi = 1"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"l ≤ w(ei)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"w(e)"},{"kind":"text","text":" is the length of road "},{"kind":"math_inline","text":"e"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should print "},{"kind":"math_inline","text":"T(b)"},{"kind":"text","text":" for this query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" space separated integers "},{"kind":"math_inline","text":"f1, f2, ..., fn - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|fi| ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the details of the roads. Each line contains integers "},{"kind":"math_inline","text":"v, u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and it means that there's a road between cities "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ w ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the details of the queries. Each line contains integers "},{"kind":"math_inline","text":"v, u, l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v ≠ u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ l ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer of each query in a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n10\n1 2 3\n1 2 2\n1 2 3\n1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n10\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n-5 0 0 2 10\n1 2 1\n2 3 2\n3 4 5\n4 5 1\n5 6 5\n1 6 1\n1 6 2\n1 6 5\n3 6 5\n4 6 4\n1 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n-5\n-10\n-10\n-5\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"536E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/536/problem/E"}