{"assets":[],"contentKind":"statement","contestId":"2161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Cycle Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integer arrays $$$a_0, \\ldots, a_{n - 1}$$$ and $$$b_0, \\ldots, b_{m - 1}$$$. Each integer among $$$1, \\ldots, n + m$$$ is present exactly once among $$$a_0, \\ldots, a_{n - 1}, b_0, \\ldots, b_{m - 1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We perform $$$k$$$ operations on the arrays. Namely, for each integer $$$i$$$ from $$$0$$$ to $$$k - 1$$$ in this order "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$a_{i \\bmod n} \\gt b_{i \\bmod m}$$$, we swap $$$a_{i \\bmod n}$$$ and $$$b_{i \\bmod m}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, we do nothing "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine the final state of both arrays after all $$$k$$$ operations are completed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers $$$n, m, k$$$ ($$$1 \\leq n, m \\leq 2 \\cdot 10^5$$$, $$$0 \\leq k \\leq 10^{18}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_0, \\ldots, a_{n - 1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$m$$$ integers $$$b_0, \\ldots, b_{m - 1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the joint sequence $$$a_0, \\ldots, a_{n - 1}, b_0, \\ldots, b_{m - 1}$$$ is a permutation of integers from $$$1$$$ to $$$n + m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n + m$$$ over all testcases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print two lines — the states of the arrays $$$a_0, \\ldots, a_{n - 1}$$$ and $$$b_0, \\ldots, b_{m - 1}$$$ after the $$$k$$$ operations are performed as described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 3 5\n3 4\n1 5 2\n1 5 4\n6\n5 4 3 2 1\n3 3 0\n4 5 6\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 \n4 5 2 \n2 \n6 5 4 3 1 \n4 5 6 \n1 2 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The action sequence for the fir