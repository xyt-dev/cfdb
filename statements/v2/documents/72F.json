{"assets":[],"contentKind":"statement","contestId":"72","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Oil"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After the nationalization of the oil industry, Dr. Mosaddegh wants to dig some oil wells to extract all the oil in Persian Gulf. But Persian Gulf is huge and has an infinite amount of oil. So Dr. Mosaddegh works only on a rectangular plane of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" of the Persian Gulf. Each of the cells in this rectangle either contains an infinite amount of oil or nothing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two cells are considered adjacent if and only if they have a common edge, a path is a sequence "},{"kind":"math_inline","text":"c1, c2, ..., cx"},{"kind":"text","text":" of cells so that all of them contain oil and for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is adjacent to "},{"kind":"math_inline","text":"ci - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci + 1"},{"kind":"text","text":" (if they exist). Two cells are considered "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":" to each other if and only if there exists a path between them. If we dig a well in a certain cell, we can extract oil from all the cells that are "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":" to it by oil paths. It is not allowed to dig wells on empty cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Mosaddegh also knows that in Persian Gulf, the empty cells form rows and columns. I. e. if some cell is empty, then it's column is completely empty or it's row is completely empty, or both."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dr. Mosaddegh find out how many wells he has to dig to access all the oil in that region."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line there are two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line there is an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ t ≤ n"},{"kind":"text","text":"), the number of empty rows. "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" distinct positive integers follow, these are the numbers of empty rows and are in range "},{"kind":"math_inline","text":"[1, n]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line there is an integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ s ≤ m"},{"kind":"text","text":") that shows the number of columns not having any oil. "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" distinct positive integers follow, these are the numbers of empty columns and are in range of "},{"kind":"math_inline","text":"[1, m]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (from top to bottom) and columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" (from left to right)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer, the minimum number of wells that Dr. Mossadegh has to dig."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is actually finding how many regions are made by removing the given rows and columns."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n2 2 3\n3 2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"72F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/72/problem/F"}