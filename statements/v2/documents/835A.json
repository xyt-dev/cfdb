{"assets":[],"contentKind":"statement","contestId":"835","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Key races"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two boys decided to compete in text typing on the site \"Key races\". During the competition, they have to type a text consisting of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" characters. The first participant types one character in "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" milliseconds and has ping "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":" milliseconds. The second participant types one character in "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" milliseconds and has ping "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":" milliseconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If connection ping (delay) is "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" milliseconds, the competition passes for a participant as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Exactly after "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" milliseconds after the start of the competition the participant receives the text to be entered. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Right after that he starts to type it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" milliseconds after he ends typing all the text, the site receives information about it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The winner is the participant whose information on the success comes earlier. If the information comes from both participants at the same time, it is considered that there is a draw."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the length of the text and the information about participants, determine the result of the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains five integers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s, v1, v2, t1, t2 ≤ 1000"},{"kind":"text","text":") — the number of characters in the text, the time of typing one character for the first participant, the time of typing one character for the the second participant, the ping of the first participant and the ping of the second participant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the first participant wins, print \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\". If the second participant wins, print \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\". In case of a draw print \""},{"children":[{"kind":"text","text":"Friendship"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Second\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 3 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Friendship\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, information on the success of the first participant comes in "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" milliseconds, of the second participant — in "},{"kind":"math_inline","text":"14"},{"kind":"text","text":" milliseconds. So, the first wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, information on the success of the first participant comes in "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" milliseconds, of the second participant — in "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" milliseconds. So, the second wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, information on the success of the first participant comes in "},{"kind":"math_inline","text":"22"},{"kind":"text","text":" milliseconds, of the second participant — in "},{"kind":"math_inline","text":"22"},{"kind":"text","text":" milliseconds. So, it is be a draw."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"835A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/835/problem/A"}