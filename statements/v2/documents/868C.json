{"assets":[],"contentKind":"statement","contestId":"868","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Qualification Rounds"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Snark and Philip are preparing the problemset for the upcoming pre-qualification round for semi-quarter-finals. They have a bank of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" problems, and they want to select any non-empty subset of it as a problemset."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":" experienced teams are participating in the contest. Some of these teams already know some of the problems. To make the contest interesting for them, each of the teams should know at most half of the selected problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if Snark and Philip can make an interesting problemset!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 4"},{"kind":"text","text":") — the number of problems and the number of experienced teams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers, each equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th team knows "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th problem and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity), if it is possible to make an interesting problemset, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each character either upper- or lowercase (\""},{"children":[{"kind":"text","text":"YeS"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" are valid when the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"