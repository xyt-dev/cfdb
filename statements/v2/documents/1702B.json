{"assets":[],"contentKind":"statement","contestId":"1702","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Polycarp Writes a String from Memory"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has a poor memory. Each day he can remember no more than $$$3$$$ of different letters. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp wants to write a non-empty string of $$$s$$$ consisting of lowercase Latin letters, taking "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of days. In how many days will he be able to do it?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp initially has an empty string and can only add characters to the end of that string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if Polycarp wants to write the string "},{"children":[{"kind":"text","text":"lollipops"}],"kind":"container"},{"kind":"text","text":", he will do it in $$$2$$$ days: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" on the first day Polycarp will memorize the letters "},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":" and write "},{"children":[{"kind":"text","text":"lolli"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the second day Polycarp will remember the letters "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", add "},{"children":[{"kind":"text","text":"pops"}],"kind":"container"},{"kind":"text","text":" to the resulting line and get the line "},{"children":[{"kind":"text","text":"lollipops"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If Polycarp wants to write the string "},{"children":[{"kind":"text","text":"stringology"}],"kind":"container"},{"kind":"text","text":", he will do it in $$$4$$$ days: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in the first day will be written part "},{"children":[{"kind":"text","text":"str"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on day two will be written part "},{"children":[{"kind":"text","text":"ing"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on the third day, part of "},{"children":[{"kind":"text","text":"olog"}],"kind":"container"},{"kind":"text","text":" will be written; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" on the fourth day, part of "},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":" will be written. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For a given string $$$s$$$, print the minimum number of days it will take Polycarp to write it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of a non-empty string $$$s$$$ consisting of lowercase Latin letters (the length of the string $$$s$$$ does not exceed $$$2 \\cdot 10^5$$$) — the string Polycarp wants to construct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of string lengths $$$s$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single number — "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of days it will take Polycarp to write the string $$$s$$$ from memory."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nlollipops\nstringology\nabracadabra\ncodeforces\ntest\nf\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n4\n3\n4\n1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1702B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1702/problem/B"}