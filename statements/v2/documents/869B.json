{"assets":["/statement-assets/ed99ce905b6d1c37d29b3ca380cb3687c901a8142ce3ddee5eaea0f6a06cddde.png","/statement-assets/0ca87728df6c7f539fd458ef1b4cc9a88f601dc7db8a9ed2167a15b3d00aa731.png","/statement-assets/0b02cac797a057f8a1ebd5804bc2810630e1c1f5d3a54ec4bacfef63faf794f3.png","/statement-assets/68d3b810ff49eda2d4c2a3136fe4e5a49a7028374b896c304a34a118e5ce3a27.png"],"contentKind":"statement","contestId":"869","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The Eternal Immortality"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Even if the world is full of counterfeits, I still regard it as wonderful."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pile up herbs and incense, and arise again from the flames and ashes of its predecessor — as is known to many, the phoenix does it like this."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The phoenix has a rather long lifespan, and reincarnates itself once every "},{"kind":"math_inline","text":"a!"},{"kind":"text","text":" years. Here "},{"kind":"math_inline","text":"a!"},{"kind":"text","text":" denotes the factorial of integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", that is, "},{"kind":"math_inline","text":"a! = 1 × 2 × ... × a"},{"kind":"text","text":". Specifically, "},{"kind":"math_inline","text":"0! = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Koyomi doesn't care much about this, but before he gets into another mess with oddities, he is interested in the number of times the phoenix will reincarnate in a timespan of "},{"kind":"math_inline","text":"b!"},{"kind":"text","text":" years, that is, "},{"attrs":{"alt":"","src":"/statement-assets/ed99ce905b6d1c37d29b3ca380cb3687c901a8142ce3ddee5eaea0f6a06cddde.png"},"kind":"image"},{"kind":"text","text":". Note that when "},{"kind":"math_inline","text":"b ≥ a"},{"kind":"text","text":" this value is always integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the answer can be quite large, it would be enough for Koyomi just to know "},{"children":[{"kind":"text","text":"the last digit of the answer in decimal representation"}],"kind":"container"},{"kind":"text","text":". And you're here to provide Koyomi with this knowledge."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains two space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a ≤ b ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one line containing a single decimal digit — the last digit of the value that interests Koyomi."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"107 109\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the last digit of "},{"attrs":{"alt":"","src":"/statement-assets/0ca87728df6c7f539fd458ef1b4cc9a88f601dc7db8a9ed2167a15b3d00aa731.png"},"kind":"image"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":";"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the last digit of "},{"attrs":{"alt":"","src":"/statement-assets/0b02cac797a057f8a1ebd5804bc2810630e1c1f5d3a54ec4bacfef63faf794f3.png"},"kind":"image"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":";"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the last digit of "},{"attrs":{"alt":"","src":"/statement-assets/68d3b810ff49eda2d4c2a3136fe4e5a49a7028374b896c304a34a118e5ce3a27.png"},"kind":"image"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"869B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/869/problem/B"}