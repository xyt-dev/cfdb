{"assets":[],"contentKind":"statement","contestId":"2195","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sieve of Erato67henes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a_1,a_2,\\ldots,a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please determine if it is possible to select any number of elements in $$$a$$$, so that their product is $$$67$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you may not select zero elements, as the product of zero elements is not defined in this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ positive integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\le a_i \\le 67$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to select elements so that their product is $$$67$$$, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" on one line. Otherwise, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" on one line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case. For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" will also be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n1 7 6 7 67\n5\n1 3 5 7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you can select $$$a_1$$$ and $$$a_5$$$ to get $$$a_1\\cdot a_5 = 1 \\cdot 67 = 67$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it is impossible to select any number of elements so that their product is $$$67$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A"