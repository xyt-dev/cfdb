{"assets":[],"contentKind":"statement","contestId":"735","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Taxes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Funt now lives in a country with a very specific tax laws. The total income of mr. Funt during this year is equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n ≥ 2"},{"kind":"text","text":") burles and the amount of tax he has to pay is calculated as the maximum divisor of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (not equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", of course). For example, if "},{"kind":"math_inline","text":"n = 6"},{"kind":"text","text":" then Funt has to pay "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" burles, while for "},{"kind":"math_inline","text":"n = 25"},{"kind":"text","text":" he needs to pay "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and if "},{"kind":"math_inline","text":"n = 2"},{"kind":"text","text":" he pays only "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" burle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As mr. Funt is a very opportunistic person he wants to cheat a bit. In particular, he wants to split the initial "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in several parts "},{"kind":"math_inline","text":"n1 + n2 + ... + nk = n"},{"kind":"text","text":" (here "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is arbitrary, even "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":" is allowed) and pay the taxes for each part separately. He can't make some part equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" because it will reveal him. So, the condition "},{"kind":"math_inline","text":"ni ≥ 2"},{"kind":"text","text":" should hold for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ostap Bender wonders, how many money Funt has to pay (i.e. minimal) if he chooses and optimal way to split "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in parts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·109"},{"kind":"text","text":") — the total year income of mr. Funt."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — minimum possible number of burles that mr. Funt has to pay as a tax."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"27\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"735D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/735/problem/D"}