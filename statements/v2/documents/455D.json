{"assets":[],"contentKind":"statement","contestId":"455","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Serega and Fun"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Serega loves fun. However, everyone has fun in the unique manner. Serega has fun by solving query problems. One day Fedor came up with such a problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers and queries to it. The queries can be of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Make a unit cyclic shift to the right on the segment from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (both borders inclusive). That is rearrange elements of the array in the following manner:"},{"children":[{"kind":"math_inline","text":"a[l], a[l + 1], ..., a[r - 1], a[r] → a[r], a[l], a[l + 1], ..., a[r - 1]."}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Count how many numbers equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" are on the segment from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (both borders inclusive). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Fedor hurried to see Serega enjoy the problem and Serega solved it really quickly. Let's see, can you solve it?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of elements of the array. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a[1], a[2], ..., a[n]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a[i] ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — the number of queries. The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As you need to respond to the queries online, the queries will be "},{"children":[{"kind":"text","text":"encoded"}],"kind":"container"},{"kind":"text","text":". A query of the first type will be given in format: "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"l'i"},{"kind":"math_inline","text":"r'i"},{"kind":"text","text":". A query of the second type will be given in format: "},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"l'i"},{"kind":"math_inline","text":"r'i"},{"kind":"math_inline","text":"k'i"},{"kind":"text","text":". All the number in input are integer. They satisfy the constraints: "},{"kind":"math_inline","text":"1 ≤ l'i, r'i, k'i ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To decode the queries from the data given in input, you need to perform the following transformations:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"li = ((l'i + lastans - 1) mod n) + 1; ri = ((r'i + lastans - 1) mod n) + 1; ki = ((k'i + lastans - 1) mod n) + 1."}],"kind":"container"},{"children":[{"kind":"text","text":"Where "},{"kind":"math_inline","text":"lastans"},{"kind":"text","text":" is the last reply to the query of the 2-nd type (initially, "},{"kind":"math_inline","text":"lastans = 0"},{"kind":"text","text":"). If after transformation "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" is greater than "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", you must swap these values."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the 2-nd type print the answer on a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n6 6 2 7 4 2 5\n7\n1 3 6\n2 2 4 2\n2 2 4 7\n2 2 2 5\n1 2 6\n1 1 4\n2 1 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n0\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n8 4 2 2 7 7 8 8\n8\n1 8 8\n2 8 1 7\n1 8 1\n1 7 3\n2 8 8 3\n1 1 4\n1 2 7\n1 