{"assets":[],"contentKind":"statement","contestId":"347","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fixed Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A permutation of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an integer sequence such that each integer from 0 to "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" appears exactly once in it. For example, sequence "},{"kind":"math_inline","text":"[0, 2, 1]"},{"kind":"text","text":" is a permutation of length 3 while both "},{"kind":"math_inline","text":"[0, 2, 2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[1, 2, 3]"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A fixed point of a function is a point that is mapped to itself by the function. A permutation can be regarded as a bijective function. We'll get a definition of a fixed point in a permutation. An integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is a fixed point of permutation "},{"kind":"math_inline","text":"a0, a1, ..., an - 1"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"ai = i"},{"kind":"text","text":". For example, permutation "},{"kind":"math_inline","text":"[0, 2, 1]"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" fixed point and permutation "},{"kind":"math_inline","text":"[0, 1, 2]"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" fixed points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". You are allowed to swap two elements of the permutation at most once. Your task is to maximize the number of fixed points in the resulting permutation. Note that you are allowed to make at most one swap operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a0, a1, ..., an - 1"},{"kind":"text","text":" — the given permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible number of fixed points in the permutation after at most one swap operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1 3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"347B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/347/problem/B"}