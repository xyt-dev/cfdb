{"assets":[],"contentKind":"statement","contestId":"758","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Blown Garland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nothing is eternal in the world, Kostya understood it on the 7-th of January when he saw partially dead four-color garland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he has a goal to replace dead light bulbs, however he doesn't know how many light bulbs for each color are required. It is guaranteed that for each of four colors at least one light is working."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the garland contains light bulbs of four colors: red, blue, yellow and green. The garland is made as follows: if you take any four consecutive light bulbs then there will not be light bulbs with the same color among them. For example, the garland can look like \""},{"children":[{"kind":"text","text":"RYBGRYBGRY"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"YBGRYBGRYBG"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"BGRYB"}],"kind":"container"},{"kind":"text","text":"\", but can not look like \""},{"children":[{"kind":"text","text":"BGRYG"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"YBGRYBYGR"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"BGYBGY"}],"kind":"container"},{"kind":"text","text":"\". Letters denote colors: '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' — red, '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' — blue, '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"' — yellow, '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' — green."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using the information that for each color at least one light bulb still works count the number of dead light bulbs of each four colors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and the only line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ |s| ≤ 100"},{"kind":"text","text":"), which describes the garland, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol of which describes the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th light bulb in the order from the beginning of garland: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' — the light bulb is red, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' — the light bulb is blue, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"' — the light bulb is yellow, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' — the light bulb is green, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"!"}],"kind":"container"},{"kind":"text","text":"' — the light bulb is dead. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" can not contain other symbols except those five which were described. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that in the given string at least once there is each of four letters '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is correct garland with some blown light bulbs, it means that for example the line \""},{"children":[{"kind":"text","text":"GRBY!!!B"}],"kind":"container"},{"kind":"text","text":"\" can not be in the input data. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print four integers "},{"kind":"math_inline","text":"kr, kb, ky, kg"},{"kind":"text","text":" — the number of dead light bulbs of red, blue, yellow and green colors accordingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"RYBGRYBGR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0 0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"!RGYB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0 0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"!!!!YGRB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"!GB!RG!Y!\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1 0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are no dead light bulbs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it is obvious that one blue bulb is blown, because it could not be light bulbs of other colors on its place according to the statements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"758B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/758/problem/B"}