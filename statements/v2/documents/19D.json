{"assets":[],"contentKind":"statement","contestId":"19","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pete and Bob invented a new interesting game. Bob takes a sheet of paper and locates a Cartesian coordinate system on it as follows: point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" is located in the bottom-left corner, "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis is directed right, "},{"kind":"math_inline","text":"Oy"},{"kind":"text","text":" axis is directed up. Pete gives Bob requests of three types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"add x y"}],"kind":"container"},{"kind":"text","text":" — on the sheet of paper Bob marks a point with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". For each request of this type it's guaranteed that point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is not yet marked on Bob's sheet at the time of the request. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"remove x y"}],"kind":"container"},{"kind":"text","text":" — on the sheet of paper Bob erases the previously marked point with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". For each request of this type it's guaranteed that point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is already marked on Bob's sheet at the time of the request. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"find x y"}],"kind":"container"},{"kind":"text","text":" — on the sheet of paper Bob finds all the marked points, lying strictly above and strictly to the right of point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Among these points Bob chooses the leftmost one, if it is not unique, he chooses the bottommost one, and gives its coordinates to Pete. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Bob managed to answer the requests, when they were 10, 100 or 1000, but when their amount grew up to "},{"kind":"math_inline","text":"2·105"},{"kind":"text","text":", Bob failed to cope. Now he needs a program that will answer all Pete's requests. Help Bob, please!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — amount of requests. Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines — descriptions of the requests. "},{"children":[{"kind":"text","text":"add x y"}],"kind":"container"},{"kind":"text","text":" describes the request to add a point, "},{"children":[{"kind":"text","text":"remove x y"}],"kind":"container"},{"kind":"text","text":" — the request to erase a point, "},{"children":[{"kind":"text","text":"find x y"}],"kind":"container"},{"kind":"text","text":" — the request to find the bottom-left point. All the coordinates in the input file are non-negative and don't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each request of type "},{"children":[{"kind":"text","text":"find x y"}],"kind":"container"},{"kind":"text","text":" output in a separate line the answer to it — coordinates of the bottommost among the leftmost marked points, lying strictly above and to the right of point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". If there are no points strictly above and to the right of point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\nadd 1 1\nadd 3 4\nfind 0 0\nremove 1 1\nfind 0 0\nadd 1 1\nfind 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n3 4\n1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\nadd 5 5\nadd 5 6\nadd 5 7\nadd 6 5\nadd 6 6\nadd 6 7\nadd 7 5\nadd 7 6\nadd 7 7\nfind 6 6\nremove 7 7\nfind 6 6\nfind 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 7\n-1\n5 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"19D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/19/problem/D"}