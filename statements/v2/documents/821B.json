{"assets":["/statement-assets/aafa43e7b52d5c9f471646d3338b29775cb16be88de96116d1cfe21259d72584.png","/statement-assets/f3fd436a395f7683f0fee000c320f8b2414c13b844d85894f58a8683fd253e72.png"],"contentKind":"statement","contestId":"821","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Okabe and Banana Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Okabe needs bananas for one of his experiments for some strange reason. So he decides to go to the forest and cut banana trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" in the 2D plane such that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are integers and "},{"kind":"math_inline","text":"0 ≤ x, y"},{"kind":"text","text":". There is a tree in such a point, and it has "},{"kind":"math_inline","text":"x + y"},{"kind":"text","text":" bananas. There are no trees nor bananas in other points. Now, Okabe draws a line with equation "},{"attrs":{"alt":"","src":"/statement-assets/aafa43e7b52d5c9f471646d3338b29775cb16be88de96116d1cfe21259d72584.png"},"kind":"image"},{"kind":"text","text":". Okabe can select a single rectangle with axis aligned sides with all points on or under the line and cut all the trees in all points that are inside or on the border of this rectangle and take their bananas. Okabe's rectangle can be degenerate; that is, it can be a line segment or even a point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Okabe and find the maximum number of bananas he can get if he chooses the rectangle wisely."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Okabe is sure that the answer does not exceed "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":". You can trust him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ b ≤ 10000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum number of bananas Okabe can get from the trees he cuts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f3fd436a395f7683f0fee000c320f8b2414c13b844d85894f58a8683fd253e72.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The graph above corresponds to sample test 1. The optimal rectangle is shown in red and has "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" bananas."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"821B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/821/problem/B"}