{"assets":["/statement-assets/141e902f03d3d193b8909d6d92e286ada0775f51c20078277c52049494db15d1.png","/statement-assets/ec6130bdeb6c70bad6e5510efea535f4a3a9644c8764beb6c54a860d842abfdc.png"],"contentKind":"statement","contestId":"200","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Drinks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Vasya loves orange juice very much. That's why any food and drink in his kitchen necessarily contains orange juice. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" drinks in his fridge, the volume fraction of orange juice in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th drink equals "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" percent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Vasya decided to make himself an orange cocktail. He took equal proportions of each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" drinks and mixed them. Then he wondered, how much orange juice the cocktail has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the volume fraction of orange juice in the final drink."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of orange-containing drinks in Vasya's fridge. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 100"},{"kind":"text","text":") — the volume fraction of orange juice in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th drink, in percent. The numbers are separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the volume fraction in percent of orange juice in Vasya's cocktail. The answer will be considered correct if the absolute or relative error does not exceed "},{"kind":"math_inline","text":"10  - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n50 50 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"66.666666666667\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 25 50 75\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"37.500000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note to the first sample: let's assume that Vasya takes "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" milliliters of each drink from the fridge. Then the volume of pure juice in the cocktail will equal "},{"attrs":{"alt":"","src":"/statement-assets/141e902f03d3d193b8909d6d92e286ada0775f51c20078277c52049494db15d1.png"},"kind":"image"},{"kind":"text","text":" milliliters. The total cocktail's volume equals "},{"kind":"math_inline","text":"3·x"},{"kind":"text","text":" milliliters, so the volume fraction of the juice in the cocktail equals "},{"attrs":{"alt":"","src":"/statement-assets/ec6130bdeb6c70bad6e5510efea535f4a3a9644c8764beb6c54a860d842abfdc.png"},"kind":"image"},{"kind":"text","text":", that is, "},{"kind":"math_inline","text":"66.(6)"},{"kind":"text","text":" percent."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"200B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/200/problem/B"}