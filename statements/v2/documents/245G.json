{"assets":[],"contentKind":"statement","contestId":"245","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Suggested Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus works as a programmer in a start-up social network. His boss gave his a task to develop a mechanism for determining suggested friends. Polycarpus thought much about the task and came to the folowing conclusion. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say that all friendship relationships in a social network are given as "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" username pairs "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(ai ≠ bi)"},{"kind":"text","text":". Each pair "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" means that users "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are friends. Friendship is symmetric, that is, if "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is friends with "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is also friends with "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". User "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"suggested friend"}],"kind":"container"},{"kind":"text","text":" for user "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", if the following conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" aren't friends; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" among all network users who meet the first two conditions, user "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" has most of all common friends with user "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". User "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" is a common friend of user "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and user "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(z ≠ x, z ≠ y)"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" are friends, and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" are also friends. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to help Polycarpus to implement a mechanism for determining suggested friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 5000)"},{"kind":"text","text":" — the number of pairs of friends in the social network. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of names of the users who are friends with each other. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated names "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(ai ≠ bi)"},{"kind":"text","text":". The users' names are non-empty and consist of at most 20 uppercase and lowercase English letters. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that each pair of friends occurs only once in the input. For example, the input can't contain "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" at the same time. It is guaranteed that distinct users have distinct names. It is guaranteed that each social network user has at least one friend. The last thing guarantees that each username occurs at least once in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of network users. In next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the number of suggested friends for each user. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the name of the user "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and the number of his suggested friends "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" after a space. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print information about the users in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nMike Gerald\nKate Mike\nKate Tank\nGerald Tank\nGerald David\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\nMike 1\nGerald 1\nKate 1\nTank 1\nDavid 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nvalera vanya\nvalera edik\npasha valera\nigor valera\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\nvalera 0\nvanya 3\nedik 3\npasha 3\nigor 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case consider user David. Users Mike and Tank have one common friend (Gerald) with David. User Kate has no common friends with David. That's why David's suggested friends are users Mike and Tank."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"245G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/245/problem/G"}