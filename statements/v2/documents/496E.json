{"assets":[],"contentKind":"statement","contestId":"496","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Distributing Parts "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are an assistant director in a new musical play. The play consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" musical parts, each part must be performed by exactly one actor. After the casting the director chose "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" actors who can take part in the play. Your task is to assign the parts to actors. However, there are several limitations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, each actor has a certain voice range and there are some parts that he cannot sing. Formally, there are two integers for each actor, "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ci ≤ di"},{"kind":"text","text":") — the pitch of the lowest and the highest note that the actor can sing. There also are two integers for each part — "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"aj ≤ bj"},{"kind":"text","text":") — the pitch of the lowest and the highest notes that are present in the part. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th actor can perform the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th part if and only if "},{"kind":"math_inline","text":"ci ≤ aj ≤ bj ≤ di"},{"kind":"text","text":", i.e. each note of the part is in the actor's voice range."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"According to the contract, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th actor can perform at most "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" parts. Besides, you are allowed not to give any part to some actors (then they take part in crowd scenes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rehearsal starts in two hours and you need to do the assignment quickly!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of parts in the play ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two space-separated integers each, "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" — the range of notes for the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th part ("},{"kind":"math_inline","text":"1 ≤ aj ≤ bj ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of actors ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain three space-separated integers each, "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" — the range of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th actor and the number of parts that he can perform ("},{"kind":"math_inline","text":"1 ≤ ci ≤ di ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ki ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is an assignment that meets all the criteria aboce, print a single word \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) in the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer should be the number of the actor who should perform the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part. If there are multiple correct assignments, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no correct assignment, print a single word \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n2 4\n3 5\n2\n1 4 2\n2 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n2 4\n3 5\n2\n1 3 2\n2 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"496E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/496/problem/E"}