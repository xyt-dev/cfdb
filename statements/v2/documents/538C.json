{"assets":[],"contentKind":"statement","contestId":"538","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tourist's Notes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tourist hiked along the mountain range. The hike lasted for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days, during each day the tourist noted height above the sea level. On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day height was equal to some integer "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". The tourist pick smooth enough route for his hike, meaning that the between any two consecutive days height changes by at most 1, i.e. for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"'s from 1 to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" the inequality "},{"kind":"math_inline","text":"|hi - hi + 1| ≤ 1"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the end of the route the tourist rafted down a mountain river and some notes in the journal were washed away. Moreover, the numbers in the notes could have been distorted. Now the tourist wonders what could be the maximum height during his hike. Help him restore the maximum possible value of the maximum height throughout the hike or determine that the notes were so much distorted that they do not represent any possible height values that meet limits "},{"kind":"math_inline","text":"|hi - hi + 1| ≤ 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated numbers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 108"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of days of the hike and the number of notes left in the journal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain two space-separated integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hdi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ hdi ≤ 108"},{"kind":"text","text":") — the number of the day when the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th note was made and height on the "},{"kind":"math_inline","text":"di"},{"kind":"text","text":"-th day. It is guaranteed that the notes are given in the chronological order, i.e. for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from 1 to "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":" the following condition holds: "},{"kind":"math_inline","text":"di < di + 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the notes aren't contradictory, print a single integer — the maximum possible height value throughout the whole route."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the notes do not correspond to any set of heights, print a single word '"},{"children":[{"kind":"text","text":"IMPOSSIBLE"}],"kind":"container"},{"kind":"text","text":"' (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 2\n2 0\n7 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 3\n2 0\n7 0\n8 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"IMPOSSIBLE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, an example of a correct height sequence with a maximum of 2: "},{"kind":"math_inline","text":"(0, 0, 1, 2, 1, 1, 0, 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the inequality between "},{"kind":"math_inline","text":"h7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h8"},{"kind":"text","text":" does not hold, thus the information is inconsistent."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"538C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/538/problem/C"}