{"assets":[],"contentKind":"statement","contestId":"16","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Fish"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" fish, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", live in a lake. Every day right one pair of fish meet, and the probability of each other pair meeting is the same. If two fish with indexes i and j meet, the first will eat up the second with the probability "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":", and the second will eat up the first with the probability "},{"kind":"math_inline","text":"aji = 1 - aij"},{"kind":"text","text":". The described process goes on until there are at least two fish in the lake. For each fish find out the probability that it will survive to be the last in the lake."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 18"},{"kind":"text","text":") — the amount of fish in the lake. Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" real numbers each — matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ aij ≤ 1"},{"kind":"text","text":") — the probability that fish with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" eats up fish with index "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". It's guaranteed that the main diagonal contains zeros only, and for other elements the following is true: "},{"kind":"math_inline","text":"aij = 1 - aji"},{"kind":"text","text":". All real numbers are given with not more than 6 characters after the decimal point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated real numbers accurate to not less than 6 decimal places. Number with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should be equal to the probability that fish with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will survive to be the last in the lake."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 0.5\n0.5 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.500000 0.500000 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1 1 1 1\n0 0 0.5 0.5 0.5\n0 0.5 0 0.5 0.5\n0 0.5 0.5 0 0.5\n0 0.5 0.5 0.5 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.000000 0.000000 0.000000 0.000000 0.000000 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"16E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/16/problem/E"}