{"assets":[],"contentKind":"statement","contestId":"901","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Weighting a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a connected undirected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. The vertices are enumerated from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":", each of them is between "},{"kind":"math_inline","text":" - n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. It is also guaranteed that the parity of "},{"kind":"math_inline","text":"cv"},{"kind":"text","text":" equals the parity of degree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". The degree of a vertex is the number of edges connected to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to write a weight between "},{"kind":"math_inline","text":" - 2·n2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2·n2"},{"kind":"text","text":" (inclusive) on each edge in such a way, that for each vertex "},{"kind"