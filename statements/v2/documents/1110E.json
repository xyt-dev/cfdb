{"assets":[],"contentKind":"statement","contestId":"1110","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Magic Stones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Grigory has $$$n$$$ magic stones, conveniently numbered from $$$1$$$ to $$$n$$$. The "},{"children":[{"kind":"text","text":"charge"}],"kind":"container"},{"kind":"text","text":" of the $$$i$$$-th stone is equal to $$$c_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sometimes Grigory gets bored and selects some "},{"children":[{"kind":"text","text":"inner"}],"kind":"container"},{"kind":"text","text":" stone (that is, some stone with index $$$i$$$, where $$$2 \\le i \\le n - 1$$$), and after that "},{"children":[{"kind":"text","text":"synchronizes"}],"kind":"container"},{"kind":"text","text":" it with neighboring stones. After that, the chosen stone loses its own charge, but acquires the charges from neighboring stones. In other words, its charge $$$c_i$$$ changes to $$$c_i' = c_{i + 1} + c_{i - 1} - c_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrew, Grigory's friend, also has $$$n$$$ stones with charges $$$t_i$$$. Grigory is curious, whether there exists a sequence of zero or more "},{"children":[{"kind":"text","text":"synchronization"}],"kind":"container"},{"kind":"text","text":" operations, which transforms charges of Grigory's stones into charges of corresponding Andrew's stones, that is, changes $$$c_i$$$ into $$$t_i$$$ for all $$$i$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 10^5$$$) — the number of magic stones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integers $$$c_1, c_2, \\ldots, c_n$$$ ($$$0 \\le c_i \\le 2 \\cdot 10^9$$$) — the charges of Grigory's stones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integers $$$t_1, t_2, \\ldots, t_n$$$ ($$$0 \\le t_i \\le 2 \\cdot 10^9$$$) — the charges of Andrew's stones."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there exists a (possibly empty) sequence of "},{"children":[{"kind":"text","text":"synchronization"}],"kind":"container"},{"kind":"text","text":" operations, which changes all charges to the required ones, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n7 2 4 12\n7 15 10 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4 4 4\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we can perform the following "},{"children":[{"kind":"text","text":"synchronizations"}],"kind":"container"},{"kind":"text","text":" ($$$1$$$-indexed):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" First, "},{"children":[{"kind":"text","text":"synchronize"}],"kind":"container"},{"kind":"text","text":" the third stone $$$[7, 2, \\mathbf{4}, 12] \\rightarrow [7, 2, \\mathbf{10}, 12]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then "},{"children":[{"kind":"text","text":"synchronize"}],"kind":"container"},{"kind":"text","text":" the second stone: $$$[7, \\mathbf{2}, 10, 12] \\rightarrow [7, \\mathbf{15}, 10, 12]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, any operation with the second stone will not change its charge."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1110E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1110/problem/E"}