{"assets":[],"contentKind":"statement","contestId":"632","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Longest Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements and the number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Consider some subsequence of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the value of least common multiple (LCM) of its elements. Denote LCM as "},{"kind":"math_inline","text":"l"},{"kind":"text","text":". Find any longest subsequence of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with the value "},{"kind":"math_inline","text":"l ≤ m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subsequence of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is an array we can get by erasing some elements of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". It is allowed to erase zero or all elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The LCM of an empty array equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":