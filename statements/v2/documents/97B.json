{"assets":[],"contentKind":"statement","contestId":"97","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Superset"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A set of points on a plane is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if for any two points at least one of the three conditions is true:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" those two points lie on same horizontal line; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" those two points lie on same vertical line; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the rectangle, with corners in these two points, contains inside or on its borders at least one point of the set, other than these two. We mean here a rectangle with sides parallel to coordinates' axes, the so-called bounding box of the two points."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a set consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on a plane. Find any good superset of the given set whose size would not exceed "},{"kind":"math_inline","text":"2·105"},{"kind":"text","text":" points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":") — the number of points in the initial set. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the set's points. Each line contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":") — a corresponding point's coordinates. It is guaranteed that all the points are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on the first line the number of points "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n ≤ m ≤ 2·105"},{"kind":"text","text":") in a good superset, print on next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines the points. The absolute value of the points' coordinates should not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". Note that you should not minimize "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", it is enough to find any good superset of the given set, whose size does not exceed "},{"kind":"math_inline","text":"2·105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All points in the superset should have integer coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 2\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"97B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/97/problem/B"}