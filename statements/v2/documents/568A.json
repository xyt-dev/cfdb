{"assets":["/statement-assets/eefa8dc22699eb8475838cbf44db8fae95792969212639cb031186675df76dce.png","/statement-assets/a65998add2b031057ab5a5dc381bc407a07081f55d8bdb375a23ed38d4bd9cb1.png"],"contentKind":"statement","contestId":"568","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Primes or Palindromes?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Rikhail Mubinchik believes that the current definition of prime numbers is obsolete as they are too complex and unpredictable. A palindromic number is another matter. It is aesthetically pleasing, and it has a number of remarkable properties. Help Rikhail to convince the scientific community in this!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that a number is called "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":" if it is integer larger than one, and is not divisible by any positive integer other than itself and one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Rikhail calls a number a "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"},{"kind":"text","text":" if it is integer, positive, and its decimal representation without leading zeros is a palindrome, i.e. reads the same from left to right and right to left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One problem with prime numbers is that there are too many of them. Let's introduce the following notation: "},{"kind":"math_inline","text":"π(n)"},{"kind":"text","text":" — the number of primes no larger than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"rub(n)"},{"kind":"text","text":" — the number of palindromic numbers no larger than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Rikhail wants to prove that there are a lot more primes than palindromic ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He asked you to solve the following problem: for a given value of the coefficient "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" find the maximum "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"π(n) ≤ A·rub(n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two positive integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", the numerator and denominator of the fraction that is the value of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/eefa8dc22699eb8475838cbf44db8fae95792969212639cb031186675df76dce.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/a65998add2b031057ab5a5dc381bc407a07081f55d8bdb375a23ed38d4bd9cb1.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If such maximum number exists, then print it. Otherwise, print "},{"children":[{"kind":"text","text":"\"Palindromic tree is better than splay tree\""}],"kind":"container"},{"kind":"text","text":" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"40\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 42\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"172\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"568A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/568/problem/A"}