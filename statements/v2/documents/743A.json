{"assets":[],"contentKind":"statement","contestId":"743","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vladik and flights"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vladik is a competitive programmer. This year he is going to win the International Olympiad in Informatics. But it is not as easy as it sounds: the question Vladik face now is to find the cheapest way to get to the olympiad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vladik knows "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" airports. All the airports are located on a straight line. Each airport has unique id from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", Vladik's house is situated next to the airport with id "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the place of the olympiad is situated next to the airport with id "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". It is possible that Vladik's house and the place of the olympiad are located near the same airport. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To get to the olympiad, Vladik can fly between any pair of airports any number of times, but he has to start his route at the airport "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and finish it at the airport "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each airport belongs to one of two companies. The cost of flight from the airport "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to the airport "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is zero if both airports belong to the same company, and "},{"kind":"math_inline","text":"|i - j|"},{"kind":"text","text":" if they belong to different companies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the minimum cost Vladik has to pay to get to the olympiad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":") — the number of airports, the id of the airport from which Vladik starts his route and the id of the airport which he has to reach. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string with length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", which consists only of characters "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character in this string is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th airport belongs to first company, otherwise it belongs to the second."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the minimum cost Vladik has to pay to get to the olympiad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 4\n1010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 2\n10110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vladik can fly to the airport "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" at first and pay "},{"kind":"math_inline","text":"|1 - 2| = 1"},{"kind":"text","text":" (because the airports belong to different companies), and then fly from the airport "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to the airport "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" for free (because the airports belong to the same company). So the cost of the whole flight is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". It's impossible to get to the olympiad for free, so the answer is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Vladik can fly directly from the airport "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to the airport "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", because they belong to the same company."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"743A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/743/problem/A"}