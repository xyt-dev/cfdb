{"assets":[],"contentKind":"statement","contestId":"1878","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Iva & Pav"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Iva and Pav are a famous Serbian competitive programming couple. In Serbia, they call Pav \"papuca\" and that's why he will make all of Iva's wishes come true."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iva gave Pav an array $$$a$$$ of $$$n$$$ elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define $$$f(l, r) = a_l \\ \\& \\ a_{l+1} \\ \\& \\dots \\& \\ a_r$$$ (here $$$\\&$$$ denotes the "},{"attrs":{"href":"http://tiny.cc/bitwise_and"},"children":[{"kind":"text","text":"bitwise AND operation"}],"kind":"link"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that"}],"kind":"container"},{"kind":"text","text":" $$$f(l, r)$$$ "},{"children":[{"kind":"text","text":"is not defined when"}],"kind":"container"},{"kind":"text","text":" $$$l \\gt r$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iva also gave Pav $$$q$$$ queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each query consists of 2 numbers, $$$k$$$ and $$$l$$$, and she wants Pav to find the largest index $$$r$$$ ($$$l \\le r \\le n$$$), such that $$$f(l, r) \\ge k$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pav wants to solve this problem fast because he doesn't want to upset Iva. He needs your help."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of each test case contains a single integer $$$q$$$ ($$$1 \\le q \\le 10^5$$$) — the number of queries Iva gave Pav."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines of each test case contains two numbers, $$$l$$$ and $$$k$$$ ($$$1 \\le l \\le n$$$, $$$1 \\le k \\le 10^9$$$) — the left bound for the subsegment, and the integer $$$k$$$ described in statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. Also, it is guaranteed that the sum of $$$q$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query output maximal index $$$r$$$ ($$$l \\le r \\le n$$$) such that $$$a_l \\ \\& \\ a_{l+1} \\ \\& \\dots \\& \\ a_r \\ \\ge \\ k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If such $$$r$$$ doesn't exist, output $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n15 14 17 42 34\n3\n1 7\n2 15\n4 5\n5\n7 5 3 1 7\n4\n1 7\n5 7\n2 3\n2 2\n7\n19 20 15 12 21 7 11\n4\n1 15\n4 4\n7 12\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 -1 5 \n1 5 2 2 \n2 6 -1 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first test case"}],"kind":"container"},{"kind":"text","text":" $$$n=5$$$, and the array $$$a = [15, 14, 17, 42, 34]$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first query asks for the biggest index $$$r$$$ such that the $$$f(1, r) \\ge 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(1,1) = 15, \\ f(1, 2) = 14, \\ f(1,3)=0 \\ f(1, 4)=0 \\ f(1, 5)=0$$$, so $$$r=2$$$ is the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second query asks for $$$f(2, r) \\ge 15$$$. Since such $$$r$$$ doesn't exist, the answer is $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third query asks for $$$f(4, r) \\ge 5$$$. $$$f(4, 4) = 42, \\ f(4, 5) = 34$$$, so $$$r=5$$$ is the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"second test case"}],"kind":"container"},{"kind":"text","text":" $$$n=5$$$, and the array $$$a= [7, 5, 3, 1, 7]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first query, $$$f(1, r) \\ge 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(1, 1)=7, \\ f(1, 2)=5, \\ f(1, 3) = 1, \\ f(1,4) = 1, \\ f(1, 5)=1$$$, so the answer to this query is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second query, $$$f(5, r) \\ge 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(5, 5) = 7$$$, so the answer is $$$5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third query, $$$f(2, r) \\ge 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(2, 2) = 5, \\ f(2, 3) = 1, \\ f(2, 4) = 1, \\ f(2, 5) = 1$$$, so the answer is $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1878E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1878/problem/E"}