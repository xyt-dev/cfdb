{"assets":[],"contentKind":"statement","contestId":"1326","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. Prefix-Suffix Palindrome (Easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of the problem. The difference is the constraint on the sum of lengths of strings and the number of test cases. You can make hacks only if you solve all versions of this task."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting of lowercase English letters. Find the longest string, $$$t$$$, which satisfies the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The length of $$$t$$$ does not exceed the length of $$$s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$t$$$ is a palindrome. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists two strings $$$a$$$ and $$$b$$$ (possibly empty), such that $$$t = a + b$$$ ( \""},{"children":[{"kind":"text","text":"$$$+$$$"}],"kind":"container"},{"kind":"text","text":"\" represents concatenation), and $$$a$$$ is prefix of $$$s$$$ while $$$b$$$ is suffix of $$$s$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$), the number of test cases. The next $$$t$$$ lines each describe a test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is a non-empty string $$$s$$$, consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of lengths of strings over all test cases does not exceed $$$5000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the longest string which satisfies the conditions described above. If there exists multiple possible solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\na\nabcdfdcecba\nabbaxyzyx\ncodeforces\nacbba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\na\nabcdfdcba\nxyzyx\nc\nabba\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, the string $$$s = $$$\""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" satisfies all conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test, the string \""},{"children":[{"kind":"text","text":"abcdfdcba"}],"kind":"container"},{"kind":"text","text":"\" satisfies all conditions, because:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Its length is $$$9$$$, which does not exceed the length of the string $$$s$$$, which equals $$$11$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" It is a palindrome. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abcdfdcba"}],"kind":"container"},{"kind":"text","text":"\" $$$=$$$ \""},{"children":[{"kind":"text","text":"abcdfdc"}],"kind":"container"},{"kind":"text","text":"\" $$$+$$$ \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"abcdfdc"}],"kind":"container"},{"kind":"text","text":"\" is a prefix of $$$s$$$ while \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\" is a suffix of $$$s$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven that there does not exist a longer string which satisfies the conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test, the string \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" is correct, because \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" $$$=$$$ \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" $$$+$$$ \""},{"kind":"container"},{"kind":"text","text":"\" and $$$a$$$ or $$$b$$$ can be empty. The other possible solution for this test is \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D1","problemCode":"1326D1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1326/problem/D1"}