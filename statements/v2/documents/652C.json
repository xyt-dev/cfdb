{"assets":[],"contentKind":"statement","contestId":"652","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Foe Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Also you are given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" foe pairs "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of different intervals "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ y ≤ n"},{"kind":"text","text":") that do not contain any foe pairs. So you shouldn't count intervals "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" that contain at least one foe pair in it (the positions and order of the values from the foe pair are not important)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider some example: "},{"kind":"math_inline","text":"p = [1, 3, 2, 4]"},{"kind":"text","text":" and foe pairs are "},{"kind":"math_inline","text":"{(3, 2), (4, 2)}"},{"kind":"text","text":". The interval "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":" is incorrect because it contains a foe pair "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":". The interval "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":" is also incorrect because it contains two foe pairs "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 2)"},{"kind":"text","text":". But the interval "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":" is correct because it doesn't contain any foe pair."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 3·105"},{"kind":"text","text":") — the length of the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the number of foe pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the elements of the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th foe pair. Note a foe pair can appear multiple times in the given list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" — the number of different intervals "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" that does not contain any foe pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer can be too large, so you should use "},{"kind":"math_inline","text":"64"},{"kind":"text","text":"-bit integer type to store it. In "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" you can use the "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" integer type and in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" you can use "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" integer type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 3 2 4\n3 2\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 5\n9 7 2 3 1 4 6 5 8\n1 6\n4 5\n2 7\n7 2\n2 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the intervals from the answer are "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"652C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/652/problem/C"}