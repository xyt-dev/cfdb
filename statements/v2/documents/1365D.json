{"assets":[],"contentKind":"statement","contestId":"1365","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Solve The Maze"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vivek has encountered a problem. He has a maze that can be represented as an $$$n \\times m$$$ grid. Each of the grid cells may represent the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Empty — '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Wall — '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Good person  — '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Bad person — '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The only escape from the maze is at cell $$$(n, m)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A person can move to a cell only if it shares a side with their current cell and does not contain a wall. Vivek wants to block some of the empty cells by replacing them with walls in such a way, that all the good people are able to escape, while none of the bad people are able to. A cell that initially contains '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' "},{"children":[{"kind":"text","text":"cannot be blocked"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"can be travelled through"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help him determine if there exists a way to replace some (zero or more) empty cells with walls to satisfy the above conditions."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that the cell $$$(n,m)$$$ is empty."}],"kind":"container"},{"kind":"text","text":" Vivek can also block this cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ $$$(1 \\le t \\le 100)$$$ — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$, $$$m$$$ $$$(1 \\le n, m \\le 50)$$$ — the number of rows and columns in the maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contain $$$m$$$ characters. They describe the layout of the maze. If a character on a line equals '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', the corresponding cell is empty. If it equals '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"', the cell has a wall. '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' corresponds to a good person and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' corresponds to a bad person."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if there exists a way to replace some empty cells with walls to satisfy the given conditions. Otherwise print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print every letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1\n.\n1 2\nG.\n2 2\n#B\nG.\n2 3\nG.#\nB#.\n3 3\n#B.\n#..\nGG.\n2 2\n#B\nB.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\nYes\nNo\nNo\nYes\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first and second test cases, all conditions are already satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, there is only one empty cell $$$(2,2)$$$, and if it is replaced with a wall then the good person at $$$(1,2)$$$ will not be able to escape."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the fourth test case, the good person at $$$(1,1)$$$ cannot escape."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the fifth test case, Vivek can block the cells $$$(2,3)$$$ and $$$(2,2)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the last test case, Vivek can block the destination cell $$$(2, 2)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1365D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1365/problem/D"}