{"assets":[],"contentKind":"statement","contestId":"911","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Tree Destruction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an unweighted tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" following operations are applied to the tree. A single operation consists of the following steps: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" choose two leaves; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" add the length of the simple path between them to the answer; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" remove one of the chosen leaves from the tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initial answer (before applying operations) is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Obviously after "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" such operations the tree will consist of a single vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the maximal possible answer you can achieve, and construct a sequence of operations that allows you to achieve this answer!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of vertices in the tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe the edges of the tree in form "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"). It is guaranteed that given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer number — maximal possible answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines print the operations in order of their applying in format "},{"kind":"math_inline","text":"ai, bi, ci"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" — pair of the leaves that are chosen in the current operation ("},{"kind":"math_inline","text":"1 ≤ ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi ≤ n"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci = ai"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"ci = bi"},{"kind":"text","text":") — choosen leaf that is removed from the tree in the current operation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See the examples for better understanding."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 3\n2 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n1 3\n2 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n3 5 5\n4 3 3\n4 1 1\n4 2 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"911F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/911/problem/F"}