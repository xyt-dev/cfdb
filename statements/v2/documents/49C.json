{"assets":[],"contentKind":"statement","contestId":"49","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Disposition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya bought the collected works of a well-known Berland poet Petya in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" volumes. The volumes are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". He thinks that it does not do to arrange the book simply according to their order. Vasya wants to minimize the number of the disposition’s "},{"children":[{"kind":"text","text":"divisors"}],"kind":"container"},{"kind":"text","text":" — the positive integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that for at least one "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") is true both: "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"mod"},{"kind":"math_inline","text":"i = 0"},{"kind":"text","text":" and at the same time "},{"kind":"math_inline","text":"p(j)"},{"kind":"math_inline","text":"mod"},{"kind":"math_inline","text":"i = 0"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p(j)"},{"kind":"text","text":" is the number of the tome that stands on the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th place and "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":" is the operation of taking the division remainder. Naturally, one volume can occupy exactly one place and in one place can stand exactly one volume."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya — find the volume disposition with the minimum number of divisors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":") which represents the number of volumes and free places."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers — the sought disposition with the minimum divisor number. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") should be equal to "},{"kind":"math_inline","text":"p(j)"},{"kind":"text","text":" — the number of tome that stands on the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th place. If there are several solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind"