{"assets":[],"contentKind":"statement","contestId":"1599","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Shortest path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$N$$$ points on an infinite plane with the Cartesian coordinate system on it. $$$N-1$$$ points lay on one line, and one point isn't on that line. You are on point $$$K$$$ at the start, and the goal is to visit every point. You can move between any two points in a straight line, and you can revisit points. What is the minimum length of the path? "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers: $$$N$$$ ($$$3 \\leq N \\leq 2*10^5$$$) - the number of points, and $$$K$$$ ($$$1 \\leq K \\leq N$$$) - the index of the starting point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$N$$$ lines contain two integers, $$$A_i$$$, $$$B_i$$$ ($$$-10^6 \\leq A_i, B_i \\leq 10^6$$$) - coordinates of the $$$i-th$$$ point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output contains one number - the shortest path to visit all given points starting from point $$$K$$$. The absolute difference between your solution and the main solution shouldn't exceed $$$10^-6$$$;"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2\n0 0\n-1 1\n2 -2\n0 1\n-2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7.478709"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The shortest path consists of these moves: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2 -> 5 "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"5 -> 4 "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"4 -> 1 "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1 -> 3 "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There isn't any shorter path possible."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1599G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1599/problem/G"}