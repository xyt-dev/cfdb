{"assets":[],"contentKind":"statement","contestId":"36","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Two Paths"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Once archaeologists found "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" mysterious papers, each of which had a pair of integers written on them. Ancient people were known to like writing down the indexes of the roads they walked along, as «"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":"» or «"},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"a"},{"kind":"text","text":"», where "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" are the indexes of two different cities joint by the road . It is also known that the mysterious papers are pages of two travel journals (those days a new journal was written for every new journey)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During one journey the traveler could walk along one and the same road several times in one or several directions but in that case he wrote a new entry for each time in his journal. Besides, the archaeologists think that the direction the traveler took on a road had no effect upon the entry: the entry that looks like «"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":"» could refer to the road from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" as well as to the road from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The archaeologists want to put the pages in the right order and reconstruct the two travel paths but unfortunately, they are bad at programming. That’s where you come in. Go help them!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 10000"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describes one paper. Each description consists of two integers "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 10000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output the number "},{"kind":"math_inline","text":"L1"},{"kind":"text","text":". That is the length of the first path, i.e. the amount of papers in its description. In the following line output "},{"kind":"math_inline","text":"L1"},{"kind":"text","text":" space-separated numbers — the indexes of the papers that describe the first path. In the third and fourth lines output similarly the length of the second path "},{"kind":"math_inline","text":"L2"},{"kind":"text","text":" and the path itself. Both paths must contain at least one road, i.e. condition "},{"kind":"math_inline","text":"L1 > 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"L2 > 0"},{"kind":"text","text":" must be met. The papers are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" according to the order of their appearance in the input file. The numbers should be output in the order in which the traveler passed the corresponding roads. If the answer is not unique, output any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it’s impossible to find such two paths, output «"},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Don’t forget that each paper should be used exactly once, i.e "},{"kind":"math_inline","text":"L1 + L2 = m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 5\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 \n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"36E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/36/problem/E"}