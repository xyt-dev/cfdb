"},{"kind":"math_inline","text":"6"},{"kind":"text","text":" possible situations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"p = 1, q = 2, f(p, q) = 10"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"p = 2, q = 3, f(p, q) = 20"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"p = 1, q = 3, f(p, q) = 10"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Another "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" cases are symmetrical to the above. The average is "},{"attrs":{"alt":"","src":"/statement-assets/53104cbf21fc334f9c9277d597048a2449ce35f7f5e08d409048da3a5fde0556.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"437D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/437/problem/D"}