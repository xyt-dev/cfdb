{"assets":["/statement-assets/c0c17715afd2a05f660a2d93cbadaa1289009ea326e082b3a13b43478a67af2f.png"],"contentKind":"statement","contestId":"915","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Imbalance Value of a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. A number is written on each vertex; the number written on vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Let's denote the function "},{"kind":"math_inline","text":"I(x, y)"},{"kind":"text","text":" as the difference between maximum and minimum value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" on a simple path connecting vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate "},{"attrs":{"alt":"","src":"/statement-assets/c0c17715afd2a05f660a2d93cbadaa1289009ea326e082b3a13b43478a67af2f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") — the numbers written on the vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow. Each line contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" denoting an edge connecting vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":"). It is guaranteed that these edges denote a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number equal to "},{"attrs":{"alt":"","src":"/statement-assets/c0c17715afd2a05f660a2d93cbadaa1289009ea326e082b3a13b43478a67af2f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3}