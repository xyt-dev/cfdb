{"assets":[],"contentKind":"statement","contestId":"758","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Broken Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree that has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, which are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where the vertex number one is the root. Each edge has weight "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and strength "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Botanist Innokentiy, who is the only member of the jury of the Olympiad in Informatics, doesn't like broken trees. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tree is broken if there is such an edge the strength of which is less than the sum of weight of subtree's edges to which it leads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is allowed to reduce weight of any edge by arbitrary integer value, but then the strength of its edge is reduced by the same value. It means if the weight of the edge is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", and the strength is "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", then by the reducing the weight by "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" its weight will equal "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and the strength will equal "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is not allowed to increase the weight of the edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to get the tree, which is not broken, by reducing the weight of edges of the given tree, and also all edged should have the positive weight, moreover, the total weight of all edges should be as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is obvious that the strength of edges can not be negative, however it can equal zero if the weight of the subtree equals zero. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of vertices in the tree. The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains the description of edges. Each line contains four integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n, 1 ≤ w ≤ 109, 0 ≤ p ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — vertices which connect the edge (the vertex number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the parent of the vertex number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" are the weight and the strength of the edge, accordingly. It is guaranteed that the edges describe the tree with the root in the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to get unbroken tree from the given tree, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in the only line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, the output data should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line print the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of vertices on the tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines print the description of edges of the resulting tree. Each line should contain four integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n, 1 ≤ w ≤ 109, 0 ≤ p ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — vertices, which the edge connects (the vertex number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the parent of the vertex number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" are the new weight and the strength of the edge, accordingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print edges in the same order as they are given in input data: the first two integers of each line should not be changed. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 5 7\n3 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 5 7\n3 2 4 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 3 2 3\n3 4 5 1\n3 2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 2 4\n2 4 1 9\n4 5 5 6\n4 3 4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 2 4\n2 4 1 9\n4 5 1 2\n4 3 2 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2 5 2\n2 3 4 3\n1 4 3 7\n4 5 4 1\n4 6 3 2\n6 7 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2 5 2\n2 3 2 1\n1 4 3 7\n4 5 3 0\n4 6 3 2\n6 7 1 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"758E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/758/problem/E"}