{"assets":["/statement-assets/6e782b90d2e127e6af210088a45d9162bb664052426438994d3547f0564b0fc3.png","/statement-assets/15b616dfd16ccd163e1c1ef39f18abf944e990e11ea77885fecf9c1d07978bd1.png","/statement-assets/483633bf69293b82c0edfbf92c1fd5f5da481fded63f9f6ecab9717b2e860795.png","/statement-assets/6f94d9e78f5d5d6622c404962119be6a2327855bafea97cbeb79e3663e9990b8.png","/statement-assets/1583708f02d6a06a428ba5cabc65131b4f3f7e54a626963e4011cbacaf240606.png","/statement-assets/785713d99c9b25ccb73f68da610eee687f44f3d96da53d665f227a6488fbf027.png","/statement-assets/20a6b7bdeedd3a9f755ee5e62c59da8126b39f1793ce19e35a931527f180cee4.png","/statement-assets/24a2a396fddcc1f6186d80edb8bb83956a96517a089166e9e26f7ffd5c83d8d5.png"],"contentKind":"statement","contestId":"601","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. A Museum Robbery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There's a famous museum in the city where Kleofáš lives. In the museum, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exhibits (numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") had been displayed for a long time; the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of those exhibits has value "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and mass "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, the museum was bought by a large financial group and started to vary the exhibits. At about the same time, Kleofáš... gained interest in the museum, so to say."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should process "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" events of three types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" — the museum displays an exhibit with value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and mass "},{"kind":"math_inline","text":"w"},{"kind":"text","text":"; the exhibit displayed in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th event of this type is numbered "},{"kind":"math_inline","text":"n + i"},{"kind":"text","text":" (see sample explanation for more details)"}],"kind":"list_item"},{"children":[{"kind":"text","text":" type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" — the museum removes the exhibit with number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and stores it safely in its vault"}],"kind":"list_item"},{"children":[{"kind":"text","text":" type "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" — Kleofáš visits the museum and wonders (for no important reason at all, of course): if there was a robbery and exhibits with total mass at most "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" were stolen, what would their maximum possible total value be?"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each event of type 3, let "},{"kind":"math_inline","text":"s(m)"},{"kind":"text","text":" be the maximum possible total value of stolen exhibits with total mass "},{"kind":"math_inline","text":" ≤ m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, let "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" be the set of numbers of all exhibits that are currently displayed (so initially "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" = {1, ..., n}). Let "},{"kind":"math_inline","text":"P(D)"},{"kind":"text","text":" be the set of all subsets of "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" and let "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6e782b90d2e127e6af210088a45d9162bb664052426438994d3547f0564b0fc3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"s(m)"},{"kind":"text","text":" is defined as "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/15b616dfd16ccd163e1c1ef39f18abf944e990e11ea77885fecf9c1d07978bd1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Compute "},{"kind":"math_inline","text":"s(m)"},{"kind":"text","text":" for each "},{"attrs":{"alt":"","src":"/statement-assets/483633bf69293b82c0edfbf92c1fd5f5da481fded63f9f6ecab9717b2e860795.png"},"kind":"image"},{"kind":"text","text":". Note that the output follows a special format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":") — the initial number of exhibits in the museum and the maximum interesting mass of stolen exhibits. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains two space-separated positive integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi ≤ 1 000 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ wi ≤ 1000"},{"kind":"text","text":") — the value and mass of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th exhibit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 30 000"},{"kind":"text","text":") — the number of events."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains the description of one event in the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 v w"},{"kind":"text","text":" — an event of type 1, a new exhibit with value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and mass "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" has been added ("},{"kind":"math_inline","text":"1 ≤ v ≤ 1 000 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w ≤ 1000"},{"kind":"text","text":")"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 x"},{"kind":"text","text":" — an event of type 2, the exhibit with number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" has been removed; it's guaranteed that the removed exhibit had been displayed at that time"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3"},{"kind":"text","text":" — an event of type 3, Kleofáš visits the museum and asks his question"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There will be at most "},{"kind":"math_inline","text":"10 000"},{"kind":"text","text":" events of type 1 and at least one event of type 3."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"As the number of values "},{"kind":"math_inline","text":"s(m)"},{"kind":"text","text":" can get large, output the answers to events of type 3 in a special format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each event of type 3, consider the values "},{"kind":"math_inline","text":"s(m)"},{"kind":"text","text":" computed for the question that Kleofáš asked in this event; print one line containing a single number "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6f94d9e78f5d5d6622c404962119be6a2327855bafea97cbeb79e3663e9990b8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"where "},{"kind":"math_inline","text":"p = 107 + 19"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q = 109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the answers to events of type 3 in the order in which they appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10\n30 4\n60 6\n5 1\n9\n3\n1 42 5\n1 20 3\n3\n2 2\n2 4\n3\n1 40 6\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"556674384\n168191145\n947033915\n181541912\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1000\n100 42\n100 47\n400 15\n4\n2 2\n2 1\n2 3\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the numbers of displayed exhibits and values "},{"kind":"math_inline","text":"s(1), ..., s(10)"},{"kind":"text","text":" for individual events of type 3 are, in order: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1583708f02d6a06a428ba5cabc65131b4f3f7e54a626963e4011cbacaf240606.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/785713d99c9b25ccb73f68da610eee687f44f3d96da53d665f227a6488fbf027.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/20a6b7bdeedd3a9f755ee5e62c59da8126b39f1793ce19e35a931527f180cee4.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/24a2a396fddcc1f6186d80edb8bb83956a96517a089166e9e26f7ffd5c83d8d5.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The values of individual exhibits are "},{"kind":"math_inline","text":"v1 = 30, v2 = 60, v3 = 5, v4 = 42, v5 = 20, v6 = 40"},{"kind":"text","text":" and their masses are "},{"kind":"math_inline","text":"w1 = 4, w2 = 6, w3 = 1, w4 = 5, w5 = 3, w6 = 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the only question is asked after removing all exhibits, so "},{"kind":"math_inline","text":"s(m) = 0"},{"kind":"text","text":" for any "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"601E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/601/problem/E"}