{"assets":[],"contentKind":"statement","contestId":"361","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Levko and Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Levko loves permutations very much. A permutation of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a sequence of distinct positive integers, each is at most "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s assume that value "},{"kind":"math_inline","text":"gcd(a, b)"},{"kind":"text","text":" shows the greatest common divisor of numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Levko assumes that element "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" of permutation "},{"kind":"math_inline","text":"p1, p2, ... , pn"},{"kind":"text","text":" is good if "},{"kind":"math_inline","text":"gcd(i, pi) > 1"},{"kind":"text","text":". Levko considers a permutation "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", if it has exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" good elements. Unfortunately, he doesn’t know any beautiful permutation. Your task is to help him to find at least one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print either any beautiful permutation or -1, if such permutation doesn’t exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple suitable permutations, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 4 3 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample elements "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are good because "},{"kind":"math_inline","text":"gcd(2, 4) = 2 > 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(3, 3) = 3 > 1"},{"kind":"text","text":". Elements "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are not good because "},{"kind":"math_inline","text":"gcd(1, 2) = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(4, 1) = 1"},{"kind":"text","text":". As there are exactly 2 good elements, the permutation is beautiful."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample has no beautiful permutations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"361B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/361/problem/B"}