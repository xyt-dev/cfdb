{"assets":["/statement-assets/84daee73e93f07073e241eeeea568c0f2f93a4d38f736c75d8a937b472799e28.png","/statement-assets/aba6bce9af5c6dc7993ca2302eb655ea9e04b8f426ed9a60a15fb6e3d727276e.png","/statement-assets/717f1de91723d1f7d8a37576ee57166b9fdd8de75a1bc55d9331c944188843aa.png","/statement-assets/5840e29a0142109642e58585660cefc9fc05e7d4aa2048bb5d8ff9762350e926.png"],"contentKind":"statement","contestId":"641","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Little Artem and 2-SAT"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Artem is a very smart programmer. He knows many different difficult algorithms. Recently he has mastered in "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In computer science, 2-satisfiability (abbreviated as "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":") is the special case of the problem of determining whether a conjunction (logical "},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":") of disjunctions (logical "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":") have a solution, in which all disjunctions consist of no more than two arguments (variables). For the purpose of this problem we consider only "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" formulas where each disjunction consists of exactly two arguments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the following "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" problem as an example: "},{"attrs":{"alt":"","src":"/statement-assets/84daee73e93f07073e241eeeea568c0f2f93a4d38f736c75d8a937b472799e28.png"},"kind":"image"},{"kind":"text","text":". Note that there might be negations in "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" formula (like for "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" and for "},{"kind":"math_inline","text":"x4"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Artem now tries to solve as many problems with "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" as possible. He found a very interesting one, which he can not solve yet. Of course, he asks you to help him. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem is: given two "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" formulas "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g"},{"kind":"text","text":", determine whether their sets of possible solutions are the same. Otherwise, find any variables assignment "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"f(x) ≠ g(x)"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m1, m2 ≤ n2"},{"kind":"text","text":") — the number of variables, the number of disjunctions in the first formula and the number of disjunctions in the second formula, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m1"},{"kind":"text","text":" lines contains the description of "},{"children":[{"kind":"text","text":"2-SAT"}],"kind":"container"},{"kind":"text","text":" formula "},{"kind":"math_inline","text":"f"},{"kind":"text","text":". The description consists of exactly "},{"kind":"math_inline","text":"m1"},{"kind":"text","text":" pairs of integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - n ≤ xi ≤ n, xi ≠ 0"},{"kind":"text","text":") each on separate line, where "},{"kind":"math_inline","text":"xi > 0"},{"kind":"text","text":" corresponds to the variable without negation, while "},{"kind":"math_inline","text":"xi < 0"},{"kind":"text","text":" corresponds to the variable with negation. Each pair gives a single disjunction. Next "},{"kind":"math_inline","text":"m2"},{"kind":"text","text":" lines contains formula "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" in the similar format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If both formulas share the same set of solutions, output a single word \""},{"children":[{"kind":"text","text":"SIMILAR"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise output exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/aba6bce9af5c6dc7993ca2302eb655ea9e04b8f426ed9a60a15fb6e3d727276e.png"},"kind":"image"},{"kind":"text","text":") — any set of values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"f(x) ≠ g(x)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"SIMILAR\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n1 2\n1 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"First sample has two equal formulas, so they are similar by definition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample if we compute first function with "},{"kind":"math_inline","text":"x1 = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x2 = 0"},{"kind":"text","text":" we get the result "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", because "},{"attrs":{"alt":"","src":"/statement-assets/717f1de91723d1f7d8a37576ee57166b9fdd8de75a1bc55d9331c944188843aa.png"},"kind":"image"},{"kind":"text","text":". But the second formula is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", because "},{"attrs":{"alt":"","src":"/statement-assets/5840e29a0142109642e58585660cefc9fc05e7d4aa2048bb5d8ff9762350e926.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"641F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/641/problem/F"}