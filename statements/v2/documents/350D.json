{"assets":["/statement-assets/50667da225033cf0dad63ab9958ae750ae293711d2c7baf5758baa2c9d495b1c.png"],"contentKind":"statement","contestId":"350","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Looking for Owls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Emperor Palpatine loves owls very much. The emperor has some blueprints with the new Death Star, the blueprints contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct segments and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct circles. We will consider the segments indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some way and the circles — indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in some way. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Palpatine defines an owl as a set of a pair of distinct circles "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":") and one segment "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" circles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" are symmetrical relatively to the straight line containing segment "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" circles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" don't have any common points; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" circles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" have the same radius; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" segment "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" intersects the segment that connects the centers of circles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Palpatine, count the number of distinct owls on the picture. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers — "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ m ≤ 1500"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain four integers each, "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" — the coordinates of the two endpoints of the segment. It's guaranteed that each segment has positive length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain three integers each, "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" — the coordinates of the center and the radius of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th circle. All coordinates are integers of at most "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" in their absolute value. The radius is a positive integer of at most "},{"kind":"math_inline","text":"104"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all segments and all circles are dictinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer to the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to output 64-bit integers is С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" stream or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n3 2 3 -2\n0 0 2\n6 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n0 0 0 1\n0 -1 0 1\n0 -1 0 0\n2 0 1\n-2 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n-1 0 1 0\n-100 0 1\n100 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here's an owl from the first sample. The owl is sitting and waiting for you to count it. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/50667da225033cf0dad63ab9958ae750ae293711d2c7baf5758baa2c9d495b1c.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"350D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/350/problem/D"}