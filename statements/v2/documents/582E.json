{"assets":[],"contentKind":"statement","contestId":"582","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Boolean Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem we consider Boolean functions of four variables "},{"kind":"math_inline","text":"A, B, C, D"},{"kind":"text","text":". Variables "},{"kind":"math_inline","text":"A, B, C"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" are logical and can take values 0 or 1. We will define a function using the following grammar:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"<expression> ::= <variable> | (<expression>) <operator> (<expression>)"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"<variable> ::= 'A' | 'B' | 'C' | 'D' | 'a' | 'b' | 'c' | 'd'"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"<operator> ::= '&' | '|'"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here large letters "},{"kind":"math_inline","text":"A, B, C, D"},{"kind":"text","text":" represent variables, and small letters represent their negations. For example, if "},{"kind":"math_inline","text":"A = 1"},{"kind":"text","text":", then character "},{"children":[{"kind":"text","text":"'A'"}],"kind":"container"},{"kind":"text","text":" corresponds to value 1, and value character "},{"children":[{"kind":"text","text":"'a'"}],"kind":"container"},{"kind":"text","text":" corresponds to value 0. Here character '&' corresponds to the operation of logical AND, character '|' corresponds to the operation of logical OR."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given expression "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", defining function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":", where some operations and variables are missing. Also you know the values of the function "},{"kind":"math_inline","text":"f(A, B, C, D)"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct sets of variable values. Count the number of ways to restore the elements that are missing in the expression so that the resulting expression corresponded to the given information about function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" in the given variable sets. As the value of the result can be rather large, print its remainder modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains expression "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 500"},{"kind":"text","text":"), where some characters of the operators and/or variables are replaced by character '?'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 24"},{"kind":"text","text":") — the number of integers sets for which we know the value of function "},{"kind":"math_inline","text":"f(A, B, C, D)"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the sets: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains five integers "},{"kind":"math_inline","text":"ai, bi, ci, di, ei"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai, bi, ci, di, ei ≤ 1"},{"kind":"text","text":"), separated by spaces and meaning that "},{"kind":"math_inline","text":"f(ai, bi, ci, di) = ei"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all the tuples ("},{"kind":"math_inline","text":"ai, bi, ci, di"},{"kind":"text","text":") are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"?\n2\n1 0 1 0 1\n0 1 1 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"(A)?(?)\n1\n1 1 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"((?)&(?))|((?)&(?))\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4096"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"b\n1\n1 0 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the two valid expressions are 'C' and 'd'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the expressions look as follows: '(A)&(a)', '(A)&(b)', '(A)&(C)', '(A)&(D)'."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"582E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/582/problem/E"}