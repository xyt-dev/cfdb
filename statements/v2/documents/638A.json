{"assets":["/statement-assets/3e69ce7663f0817e318e13e7f408a280407dbd88c6989efe141043f808065b17.png"],"contentKind":"statement","contestId":"638","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Home Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The main street of Berland is a straight line with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses built along it ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an even number). The houses are located at both sides of the street. The houses with odd numbers are at one side of the street and are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" in the order from the beginning of the street to the end (in the picture: from left to right). The houses with even numbers are at the other side of the street and are numbered from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order from the end of the street to its beginning (in the picture: from right to left). The corresponding houses with even and odd numbers are strictly opposite each other, that is, house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is opposite house "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", house "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is opposite house "},{"kind":"math_inline","text":"n - 2"},{"kind":"text","text":", house "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is opposite house "},{"kind":"math_inline","text":"n - 4"},{"kind":"text","text":" and so on."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3e69ce7663f0817e318e13e7f408a280407dbd88c6989efe141043f808065b17.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Vasya needs to get to house number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" as quickly as possible. He starts driving from the beginning of the street and drives his car to house "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". To get from the beginning of the street to houses number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", he spends exactly "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second. He also spends exactly one second to drive the distance between two neighbouring houses. Vasya can park at any side of the road, so the distance between the beginning of the street at the houses that stand opposite one another should be considered the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is: find the minimum time Vasya needs to reach house "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of houses on the street and the number of the house that Vasya needs to reach, correspondingly. It is guaranteed that number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum time Vasya needs to get from the beginning of the street to house "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are only four houses on the street, two houses at each side. House "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" will be the last at Vasya's right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample corresponds to picture with "},{"kind":"math_inline","text":"n = 8"},{"kind":"text","text":". House "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is the one before last at Vasya's left."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"638A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/638/problem/A"}