{"assets":[],"contentKind":"statement","contestId":"379","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. New Year Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are a programmer and you have a New Year Tree (not the traditional fur tree, though) — a tree of four vertices: one vertex of degree three (has number 1), connected with three leaves (their numbers are from 2 to 4)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the New Year, programmers usually have fun. You decided to have fun as well by adding vertices to the tree. One adding operation looks as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" First we choose some leaf of the tree with number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's mark the number of vertices on the tree at this moment by variable "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", then two vertexes are added to the tree, their numbers are "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n + 2"},{"kind":"text","text":", also you get new edges, one between vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" and one between vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n + 2"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is not just to model the process of adding vertices to the tree, but after each adding operation print the diameter of the current tree. Come on, let's solve the New Year problem!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 5·105)"},{"kind":"text","text":" — the number of operations. Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains integer "},{"kind":"math_inline","text":"vi"},{"kind":"math_inline","text":"(1 ≤ vi ≤ n)"},{"kind":"text","text":" — the operation of adding leaves to vertex "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". Variable "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" represents the number of vertices in the current tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all given operations are correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers — the diameter of the current tree after each operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2\n3\n4\n8\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4\n4\n5\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"379F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/379/problem/F"}