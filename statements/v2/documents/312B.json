{"assets":["/statement-assets/01a25c5b17e0bb44513cb526cd863ff7cc7bfcbfe2f688057fc260236a1ad773.png","/statement-assets/713176424b33ddf59aa9a3c11f05912a762bf6e4d1611828c96754f586102fcb.png","/statement-assets/65959ebcaedaae67436bdfac36120634e6555d6e84f77283fc3663e0ac362619.png"],"contentKind":"statement","contestId":"312","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Archer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"SmallR is an archer. SmallR is taking a match of archer with Zanoes. They try to shoot in the target in turns, and SmallR shoots first. The probability of shooting the target each time is "},{"attrs":{"alt":"","src":"/statement-assets/01a25c5b17e0bb44513cb526cd863ff7cc7bfcbfe2f688057fc260236a1ad773.png"},"kind":"image"},{"kind":"text","text":" for SmallR while "},{"attrs":{"alt":"","src":"/statement-assets/713176424b33ddf59aa9a3c11f05912a762bf6e4d1611828c96754f586102fcb.png"},"kind":"image"},{"kind":"text","text":" for Zanoes. The one who shoots in the target first should be the winner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output the probability that SmallR will win the match."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains four integers "},{"attrs":{"alt":"","src":"/statement-assets/65959ebcaedaae67436bdfac36120634e6555d6e84f77283fc3663e0ac362619.png"},"kind":"image"},{"kin