{"assets":["/statement-assets/f36e554de536b52a32c674885fd83f1f31efe1b8cb98539bd53e86cdbc968391.png","/statement-assets/21ba24ca1b44362e205ad1a8eab545e3ad13a0f136728f86aa88bcefa81457c5.png"],"contentKind":"statement","contestId":"896","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Willem, Chtholly and Seniorious"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"— Willem..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— What's the matter?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— It seems that there's something wrong with Seniorious..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— I'll have a look..."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/f36e554de536b52a32c674885fd83f1f31efe1b8cb98539bd53e86cdbc968391.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"Seniorious is made by linking special talismans in particular order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After over 500 years, the carillon is now in bad condition, so Willem decides to examine it thoroughly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Seniorious has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces of talisman. Willem puts them in a line, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which is an integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to maintain it, Willem needs to perform "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are four types of operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 l r x"},{"kind":"text","text":": For each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":", assign "},{"kind":"math_inline","text":"ai + x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 l r x"},{"kind":"text","text":": For each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":", assign "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3 l r x"},{"kind":"text","text":": Print the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th smallest number in the index range "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", i.e. the element at the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th position if all the elements "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":" are taken and sorted into an array of non-decreasing integers. It's guaranteed that "},{"kind":"math_inline","text":"1 ≤ x ≤ r - l + 1"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 l r x y"},{"kind":"text","text":": Print the sum of the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th power of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":", modulo "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", i.e. "},{"attrs":{"alt":"","src":"/statement-assets/21ba24ca1b44362e205ad1a8eab545e3ad13a0f136728f86aa88bcefa81457c5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains four integers "},{"kind":"math_inline","text":"n, m, seed, vmax"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105, 0 ≤ seed < 109 + 7, 1 ≤ vmax ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The initial values and operations are generated using following pseudo code:"}],"kind":"paragraph"},{"kind":"code_block","text":"\ndef rnd():\n\n    ret = seed\n    seed = (seed * 7 + 13) mod 1000000007\n    return ret\n\nfor i = 1 to n:\n\n    a[i] = (rnd() mod vmax) + 1\n\nfor i = 1 to m:\n\n    op = (rnd() mod 4) + 1\n    l = (rnd() mod n) + 1\n    r = (rnd() mod n) + 1\n\n    if (l > r): \n         swap(l, r)\n\n    if (op == 3):\n        x = (rnd() mod (r - l + 1)) + 1\n    else:\n        x = (rnd() mod vmax) + 1\n\n    if (op == 4):\n        y = (rnd() mod vmax) + 1\n\n"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"op"},{"kind":"text","text":" is the type of the operation mentioned in the legend."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each operation of types "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", output a line containing the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10 7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n0\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10 9 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n3\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the initial array is "},{"kind":"math_inline","text":"{8, 9, 7, 2, 3, 1, 5, 6, 4, 8}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The operations are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"2 6 7 9"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 3 10 8"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 4 6 2 4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 4 5 8"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 1 7 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 7 9 4 4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 2 7 9"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 5 8 1 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 5 7 5"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 3 10 8 5"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"896C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/896/problem/C"}