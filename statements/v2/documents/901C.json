{"assets":["/statement-assets/ba85acaa648e8c8a1e9843313e5e32317f03123f52c54424a2f6ec334c9ad3af.png","/statement-assets/7addf0fb0ea00425bcc8675523544618345d465290e362318af8f8211dc3c34f.png"],"contentKind":"statement","contestId":"901","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bipartite Segments"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. There are no edge-simple cycles with the even length in it. In other words, there are no cycles of even length that pass each edge at most once. Let's enumerate vertices from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. Each query is described by a segment of vertices "},{"kind":"math_inline","text":"[l; r]"},{"kind":"text","text":", and you have to count the number of its subsegments "},{"kind":"math_inline","text":"[x; y]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ x ≤ y ≤ r"},{"kind":"text","text":"), such that if we delete all vertices except the segment of vertices "},{"kind":"math_inline","text":"[x; y]"},{"kind":"text","text":" (including "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":") and edges between them, the resulting graph is bipartite."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of vertices and the number of edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe edges in the graph. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), denoting an edge between vertices "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". It is guaranteed that this graph does not contain edge-simple cycles of even length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 3·105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") — the query parameters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" numbers, each in new line: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be the number of subsegments "},{"kind":"math_inline","text":"[x; y]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"li ≤ x ≤ y ≤ ri"},{"kind":"text","text":"), such that the graph that only includes vertices from segment "},{"kind":"math_inline","text":"[x; y]"},{"kind":"text","text":" and edges between them is bipartite."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n1 2\n2 3\n3 1\n4 5\n5 6\n6 4\n3\n1 3\n4 6\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n5\n14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 9\n1 2\n2 3\n3 1\n4 5\n5 6\n6 7\n7 8\n8 4\n7 2\n3\n1 8\n1 4\n3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27\n8\n19\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is shown on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ba85acaa648e8c8a1e9843313e5e32317f03123f52c54424a2f6ec334c9ad3af.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first query, all subsegments of "},{"kind":"math_inline","text":"[1; 3]"},{"kind":"text","text":", except this segment itself, are suitable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first query, all subsegments of "},{"kind":"math_inline","text":"[4; 6]"},{"kind":"text","text":", except this segment itself, are suitable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third query, all subsegments of "},{"kind":"math_inline","text":"[1; 6]"},{"kind":"text","text":" are suitable, except "},{"kind":"math_inline","text":"[1; 3]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[1; 4]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[1; 5]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[1; 6]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[2; 6]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[3; 6]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[4; 6]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second example is shown on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7addf0fb0ea00425bcc8675523544618345d465290e362318af8f8211dc3c34f.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"901C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/901/problem/C"}