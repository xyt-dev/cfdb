{"assets":[],"contentKind":"statement","contestId":"898","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Alarm Clock"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Every evening Vitalya sets "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" alarm clocks to wake up tomorrow. Every alarm clock rings during exactly one minute and is characterized by one integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — number of minute after midnight in which it rings. Every alarm clock begins ringing at the beginning of the minute and rings during whole minute. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vitalya will definitely wake up if during some "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" consecutive minutes at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" alarm clocks will begin ringing. Pay attention that Vitalya considers only alarm clocks which begin ringing during given period of time. He doesn't consider alarm clocks which started ringing before given period of time and continues ringing during given period of time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vitalya is so tired that he wants to sleep all day long and not to wake up. Find out minimal number of alarm clocks Vitalya should turn off to sleep all next day. Now all alarm clocks are turned on. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"at