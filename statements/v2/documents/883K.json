{"assets":["/statement-assets/49ad760bd4b11852af18418192e9b51ab9d88c68d1fd2e68d2084f23c69e7c7d.png"],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Road Widening"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mayor of city S just hates trees and lawns. They take so much space and there could be a road on the place they occupy!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Mayor thinks that one of the main city streets could be considerably widened on account of lawn nobody needs anyway. Moreover, that might help reduce the car jams which happen from time to time on the street."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The street is split into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" equal length parts from left to right, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part is characterized by two integers: width of road "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and width of lawn "},{"kind":"math_inline","text":"gi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/49ad760bd4b11852af18418192e9b51ab9d88c68d1fd2e68d2084f23c69e7c7d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts the Mayor should decide the size of lawn to demolish. For the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part he can reduce lawn width by integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ gi"},{"kind":"text","text":"). After it new road width of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part will be equal to "},{"kind":"math_inline","text":"s'i = si + xi"},{"kind":"text","text":" and new lawn width will be equal to "},{"kind":"math_inline","text":"g'i = gi - xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the one hand, the Mayor wants to demolish as much lawn as possible (and replace it with road). On the other hand, he does not want to create a rapid widening or narrowing of the road, which would lead to car accidents. To avoid that, the Mayor decided that width of the road for consecutive parts should differ by at most "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", i.e. for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":") the inequation "},{"kind":"math_inline","text":"|s'i + 1 - s'i| ≤ 1"},{"kind":"text","text":" should hold. Initially this condition might not be true."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find the the total width of lawns the Mayor will destroy according to his plan."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — number of parts of the street."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"si, gi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ gi ≤ 106"},{"kind":"text","text":") — current width of road and width of the lawn on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part of the street."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the total width of lawns which will be removed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"s'1, s'2, ..., s'n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"si ≤ s'i ≤ si + gi"},{"kind":"text","text":") — new widths of the road starting from the first part and to the last."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print the only integer "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in the first line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 5\n4 5\n4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n9 9 10 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 100\n100 1\n1 100\n100 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"202\n101 101 101 101 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n100 100\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"883K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/883/problem/K"}