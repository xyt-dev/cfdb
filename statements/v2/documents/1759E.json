{"assets":[],"contentKind":"statement","contestId":"1759","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. The Humanoid"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ astronauts working on some space station. An astronaut with the number $$$i$$$ ($$$1 \\le i \\le n$$$) has "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" $$$a_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An evil humanoid has made his way to this space station. "},{"children":[{"kind":"text","text":"The power"}],"kind":"container"},{"kind":"text","text":" of this humanoid is equal to $$$h$$$. Also, the humanoid took with him "},{"children":[{"kind":"text","text":"two"}],"kind":"container"},{"children":[{"kind":"text","text":"green"}],"kind":"container"},{"kind":"text","text":" serums and "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" serum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one second , a humanoid can do any of three actions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" to absorb an astronaut with "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"children":[{"kind":"text","text":"strictly less"}],"kind":"container"},{"children":[{"kind":"text","text":"humanoid power"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to use "},{"children":[{"kind":"text","text":"green"}],"kind":"container"},{"kind":"text","text":" serum, if there is still one left; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to use "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" serum, if there is still one left. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"When an astronaut with "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" $$$a_i$$$ is absorbed, this astronaut disappears, and "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the humanoid increases by $$$\\lfloor \\frac{a_i}{2} \\rfloor$$$, that is, an integer part of $$$\\frac{a_i}{2}$$$. For example, if a humanoid absorbs an astronaut with "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" $$$4$$$, its "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" increases by $$$2$$$, and if a humanoid absorbs an astronaut with "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" $$$7$$$, its "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" increases by $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After using the "},{"children":[{"kind":"text","text":"green"}],"kind":"container"},{"kind":"text","text":" serum, this serum disappears, and the "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the humanoid doubles, so it increases by $$$2$$$ times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After using the "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" serum, this serum disappears, and the "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the humanoid triples, so it increases by $$$3$$$ times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The humanoid is wondering what the maximum number of astronauts he will be able to absorb if he acts optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of each test contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains integers $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — number of astronauts and $$$h$$$ ($$$1 \\le h \\le 10^6$$$) — the initial "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the humanoid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_i$$$ ($$$1 \\le a_i \\le 10^8$$$) — "},{"children":[{"kind":"text","text":"powers"}],"kind":"container"},{"kind":"text","text":" of astronauts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ for all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, in a separate line, print the maximum number of astronauts that a humanoid can absorb."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n4 