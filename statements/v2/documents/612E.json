{"assets":[],"contentKind":"statement","contestId":"612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Square Root of Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an array containing each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exactly once. For example, "},{"kind":"math_inline","text":"q = [4, 5, 1, 2, 3]"},{"kind":"text","text":" is a permutation. For the permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" the square of permutation is the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"p[i] = q[q[i]]"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i = 1... n"},{"kind":"text","text":". For example, the square of "},{"kind":"math_inline","text":"q = [4, 5, 1, 2, 3]"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"p = q2 = [2, 3, 4, 5, 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This problem is about the inverse operation: given the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" you task is to find such permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"q2 = p"},{"kind":"text","text":". If there are several such "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" find any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the number of elements in permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the elements of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"q2 = p"},{"kind":"text","text":" print the number \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer exists print it. The only line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different integers "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ qi ≤ n"},{"kind":"text","text":") — the elements of the permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". If there are several solutions print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4 2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 4 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 5 1 2 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"612E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/612/problem/E"}