{"assets":[],"contentKind":"statement","contestId":"1771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Hossam and Range Minimum Query"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hossam gives you a sequence of integers $$$a_1, \\, a_2, \\, \\dots, \\, a_n$$$ of length $$$n$$$. Moreover, he will give you $$$q$$$ queries of type $$$(l, \\, r)$$$. For each query, consider the elements $$$a_l, \\, a_{l + 1}, \\, \\dots, \\, a_r$$$. Hossam wants to know the "},{"children":[{"kind":"text","text":"smallest"}],"kind":"container"},{"kind":"text","text":" number in this sequence, such that it occurs in this sequence an "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to compute the answer for each query before process the next query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$), the length of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, \\, a_2, \\, \\dots, \\, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains one integer $$$q$$$ ($$$1 \\le q \\le 2 \\cdot 10^5$$$), the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines contains two integers $$$a$$$ and $$$b$$$ ($$$0 \\le a, \\, b \\le 2 \\cdot 10^9$$$), the numbers used to encode the queries. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$\\mathrm{ans}_i$$$ be the answer on the $$$i$$$-th query, and $$$\\mathrm{ans}_0$$$ be zero. Then $$$$$$l_i = a_i \\oplus \\mathrm{ans}_{i - 1},$$$$$$ $$$$$$r_i = b_i \\oplus \\mathrm{ans}_{i - 1},$$$$$$ where $$$l_i, \\, r_i$$$ are parameters of the $$$i$$$-th query and $$$\\oplus$$$ means the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise exclusive or"}],"kind":"link"},{"kind":"text","text":" operation. It is guaranteed that $$$1 \\le l \\le r \\le n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print the smallest number that occurs an odd number of times on the given segment of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no such number, print $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2 1 2 2\n6\n1 2\n0 2\n0 6\n0 5\n2 2\n3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n1\n0\n2\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n51 43 69 48 23 52 48 76 19 55\n10\n1 1\n57 57\n54 62\n20 27\n56 56\n79 69\n16 21\n18 30\n25 25\n62 61\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n51\n55\n19\n48\n76\n19\n23\n19\n55\n19\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the example,"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$l_1 = 1, \\, r_1 = 2,$$$$$$ $$$$$$l_2 = 1, \\, r_2 = 3,$$$$$$ $$$$$$l_3 = 2, \\, r_3 = 4,$$$$$$ $$$$$$l_4 = 1, \\, r_4 = 4,$$$$$$ $$$$$$l_5 = 2, \\, r_5 = 2,$$$$$$ $$$$$$l_6 = 1, \\, r_6 = 5.$$$$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1771F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1771/problem/F"}