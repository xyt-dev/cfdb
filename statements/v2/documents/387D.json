{"assets":[],"contentKind":"statement","contestId":"387","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. George and Interesting Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"George loves graphs. Most of all, he loves interesting graphs. We will assume that a directed graph is "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":", if it meets the following criteria: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The graph doesn't contain any multiple arcs; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" (we'll call her the "},{"children":[{"kind":"text","text":"center"}],"kind":"container"},{"kind":"text","text":"), such that for any vertex of graph "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", the graph contains arcs "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":". Please note that the graph also contains loop "},{"kind":"math_inline","text":"(v, v)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The outdegree of all vertexes except for the "},{"children":[{"kind":"text","text":"center"}],"kind":"container"},{"kind":"text","text":" equals two and the indegree of all vertexes except for the "},{"children":[{"kind":"text","text":"center"}],"kind":"container"},{"kind":"text","text":" equals two. The outdegree of vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is the number of arcs that go out of "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", the indegree of vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is the number of arcs that go in "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". Please note that the graph can contain loops. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, not everything's that simple. George got a directed graph of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" arcs as a present. The graph didn't have any multiple arcs. As George loves interesting graphs, he wants to slightly alter the presented graph and transform it into an interesting one. In one alteration he can either remove an arbitrary existing arc from the graph or add an arbitrary arc to the graph. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"George wonders: what is the minimum number of changes that he needs to obtain an interesting graph from the graph he's got as a present? Help George and find the answer to the question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 500, 1 ≤ m ≤ 1000"},{"kind":"text","text":") — the number of vertices and arcs in the presented graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":") — the descriptions of the graph's arcs. Pair "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" means that the graph contains an arc from vertex number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to vertex number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". It is guaranteed that the presented graph doesn't contain multiple arcs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that the grah vertices are numbered 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to George's question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7\n1 1\n2 2\n3 1\n1 3\n3 2\n2 3\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n1 1\n2 2\n3 1\n3 2\n2 3\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For more information about directed graphs, please visit: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Directed_graph"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample the graph already is interesting, its center is vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"387D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/387/problem/D"}