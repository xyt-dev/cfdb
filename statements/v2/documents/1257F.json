{"assets":[],"contentKind":"statement","contestId":"1257","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Make Them Similar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call two numbers "},{"children":[{"kind":"text","text":"similar"}],"kind":"container"},{"kind":"text","text":" if their binary representations contain the same number of digits equal to $$$1$$$. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$2$$$ and $$$4$$$ are similar (binary representations are $$$10$$$ and $$$100$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1337$$$ and $$$4213$$$ are similar (binary representations are $$$10100111001$$$ and $$$1000001110101$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$3$$$ and $$$2$$$ are not similar (binary representations are $$$11$$$ and $$$10$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$42$$$ and $$$13$$$ are similar (binary representations are $$$101010$$$ and $$$1101$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an array of $$$n$$$ integers $$$a_1$$$, $$$a_2$$$, ..., $$$a_n$$$. You may choose a non-negative integer $$$x$$$, and then get another array of $$$n$$$ integers $$$b_1$$$, $$$b_2$$$, ..., $$$b_n$$$, where $$$b_i = a_i \\oplus x$$$ ($$$\\oplus$$$ denotes bitwise XOR)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Is it po