{"assets":[],"contentKind":"statement","contestId":"830","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Office Keys"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" keys on a straight line. Every person wants to get to the office which is located on the line as well. To do that, he needs to reach some point with a key, take the key and then go to the office. Once a key is taken by somebody, it couldn't be taken by anybody else."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to determine the minimum time needed for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people to get to the office with keys. Assume that people move a unit distance per "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second. If two people reach a key at the same time, only one of them can take the key. A person can pass through a point with a key without taking it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n ≤ k ≤ 2 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ p ≤ 109"},{"kind":"text","text":") — the number of people, the number of keys and the office location."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — positions in which people are located initially. The positions are given in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bj ≤ 109"},{"kind":"text","text":") — positions of the keys. The positions are given in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there can't be more than one person or more than one key in the same point. A person and a key can be located in the same point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum time (in seconds) needed for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" to reach the office with keys."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 50\n20 100\n60 10 40 80\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"50\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 10\n11\n15 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the person located at point "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" should take the key located at point "},{"kind":"math_inline","text":"40"},{"kind":"text","text":" and go with it to the office located at point "},{"kind":"math_inline","text":"50"},{"kind":"text","text":". He spends "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" seconds. The person located at point "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" can take the key located at point "},{"kind":"math_inline","text":"80"},{"kind":"text","text":" and go to the office with it. He spends "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" seconds. Thus, after "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" seconds everybody is in office with keys."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"830A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/830/problem/A"}