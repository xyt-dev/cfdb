{"assets":[],"contentKind":"statement","contestId":"1853","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Desorting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Call an array $$$a$$$ of length $$$n$$$ "},{"children":[{"kind":"text","text":"sorted"}],"kind":"container"},{"kind":"text","text":" if $$$a_1 \\leq a_2 \\leq \\ldots \\leq a_{n-1} \\leq a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ntarsis has an array $$$a$$$ of length $$$n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He is allowed to perform one type of operation on it (zero or more times): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose an index $$$i$$$ ($$$1 \\leq i \\leq n-1$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Add $$$1$$$ to $$$a_1, a_2, \\ldots, a_i$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subtract $$$1$$$ from $$$a_{i+1}, a_{i+2}, \\ldots, a_n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The values of $$$a$$$ can be negative after an operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum operations needed to make $$$a$$$ "},{"children":[{"kind":"text","text":"not sorted"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 100$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\leq n \\leq 500$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\leq a_i \\leq 10^9$$$) — the values of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$500$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum number of operations needed to make the array "},{"children":[{"kind":"text","text":"not sorted"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2\n1 1\n4\n1 8 10 13\n3\n1 3 2\n3\n1 9 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n0\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, we can perform $$$1$$$ operation to make the array not sorted: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pick $$$i = 1$$$. The array $$$a$$$ then becomes $$$[2, 0]$$$, which is not sorted. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second case, we can perform $$$2$$$ operations to make the array not sorted: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pick $$$i = 3$$$. The array $$$a$$$ then becomes $$$[2, 9, 11, 12]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pick $$$i = 3$$$. The array $$$a$$$ then becomes $$$[3, 10, 12, 11]$$$, which is not sorted. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven that $$$1$$$ and $$$2$$$ operations are the minimal numbers of operations in the first and second test cases, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third case, the array is "},{"children":[{"children":[{"kind":"text","text":"already"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" not sorted, so we perform $$$0$$$ operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1853A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1853/problem/A"}