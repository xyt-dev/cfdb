{"assets":[],"contentKind":"statement","contestId":"525","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ilya and Sticks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the evening, after the contest Ilya was bored, and he really felt like maximizing. He remembered that he had a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sticks and an instrument. Each stick is characterized by its length "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ilya decided to make a rectangle from the sticks. And due to his whim, he decided to make rectangles in such a way that maximizes their total area. Each stick is used in making at most one rectangle, it is possible that some of sticks remain unused. Bending sticks is not allowed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sticks with lengths "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a4"},{"kind":"text","text":" can make a rectangle if the following properties are observed:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"a1 ≤ a2 ≤ a3 ≤ a4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a1 = a2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a3 = a4"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A rectangle can be made of sticks with lengths of, for example, "},{"kind":"math_inline","text":"3 3 3 3"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"2 2 4 4"},{"kind":"text","text":". A rectangle cannot be made of, for example, sticks "},{"kind":"math_inline","text":"5 5 5 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ilya also has an instrument which can reduce the length of the sticks. The sticks are made of a special material, so the length of each stick can be reduced by at most one. For example, a stick with length "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" can either stay at this length or be transformed into a stick of length "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer the question — what maximum total area of the rectangles can Ilya get with a file if makes rectangles from the available sticks?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of the available sticks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ li ≤ 106"},{"kind":"text","text":") — the lengths of the sticks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output must contain a single non-negative integer — the maximum total area of the rectangles that Ilya can make from the available sticks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 4 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 2 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n100003 100004 100005 100006\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10000800015\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"525C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/525/problem/C"}