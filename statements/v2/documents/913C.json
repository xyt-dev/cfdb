{"assets":[],"contentKind":"statement","contestId":"913","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Party Lemonade"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A New Year party is not a New Year party without lemonade! As usual, you are expecting a lot of guests, and buying lemonade has already become a pleasant necessity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your favorite store sells lemonade in bottles of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different volumes at different costs. A single bottle of type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has volume "},{"kind":"math_inline","text":"2i - 1"},{"kind":"text","text":" liters and costs "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" roubles. The number of bottles of each type in the store can be considered infinite."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to buy at least "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" liters of lemonade. How many roubles do you have to spend?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 30"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ L ≤ 109"},{"kind":"text","text":") — the number of types of bottles in the store and the required amount of lemonade in liters, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 109"},{"kind":"text","text":") — the costs of bottles of different types."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the smallest number of roubles you have to pay in order to buy at least "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" liters of lemonade."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 12\n20 30 70 90\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"150\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n10000 1000 100 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n10 100 1000 10000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 787787787\n123456789 234567890 345678901 456789012 987654321\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"44981600785557577\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you should buy one 8-liter bottle for 90 roubles and two 2-liter bottles for 30 roubles each. In total you'll get 12 liters of lemonade for just 150 roubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, even though you need only 3 liters, it's cheaper to buy a single 8-liter bottle for 10 roubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example it's best to buy three 1-liter bottles for 10 roubles each, getting three liters for 30 roubles."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"913C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/913/problem/C"}