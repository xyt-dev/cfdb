{"assets":["/statement-assets/672cb6296fb71a406095763d7e0adf856e3c740314b70ecdabd60a1b95e3f95c.png","/statement-assets/045be4f6cb369e0ec1453b7f3584c7a331036eceedee7c617edbc7c3e9f5b8ff.png"],"contentKind":"statement","contestId":"811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vladik and Courtesy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"At regular competition Vladik and Valera won "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" candies respectively. Vladik offered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" his candy to Valera. After that Valera gave Vladik "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" his candies, so that no one thought that he was less generous. Vladik for same reason gave "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" candies to Valera in next turn."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, the guys take turns giving each other one candy more than they received in the previous turn."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This continued until the moment when one of them couldn’t give the right amount of candy. Candies, which guys got from each other, they "},{"children":[{"kind":"text","text":"don’t consider as their own"}],"kind":"container"},{"kind":"text","text":". You need to know, who is the first who can’t give the right amount of candy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Single line of input data contains two space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 109"},{"kind":"text","text":") — number of Vladik and Valera candies respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pring a single line \""},{"children":[{"kind":"text","text":"Vladik"}],"kind":"container"},{"kind":"text","text":"’’ in case, if Vladik first who can’t give right amount of candy, or \""},{"children":[{"kind":"text","text":"Valera"}],"kind":"container"},{"kind":"text","text":"’’ otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Valera\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Vladik\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Illustration for first test case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/672cb6296fb71a406095763d7e0adf856e3c740314b70ecdabd60a1b95e3f95c.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Illustration for second test case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/045be4f6cb369e0ec1453b7f3584c7a331036eceedee7c617edbc7c3e9f5b8ff.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"811A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/811/problem/A"}