{"assets":[],"contentKind":"statement","contestId":"1065","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Fibonacci Suffix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's denote (yet again) the sequence of Fibonacci strings:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$F(0) = $$$ "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", $$$F(1) = $$$ "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", $$$F(i) = F(i - 2) + F(i - 1)$$$, where the plus sign denotes the concatenation of two strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote the "},{"children":[{"kind":"text","text":"lexicographically sorted"}],"kind":"container"},{"kind":"text","text":" sequence of suffixes of string $$$F(i)$$$ as $$$A(F(i))$$$. For example, $$$F(4)$$$ is "},{"children":[{"kind":"text","text":"01101"}],"kind":"container"},{"kind":"text","text":", and $$$A(F(4))$$$ is the following sequence: "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"01101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1101"}],"kind":"container"},{"kind":"text","text":". Elements in this sequence are numbered from $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to print $$$m$$$ first characters of $$$k$$$-th element of $$$A(F(n))$$$. If there are less than $$$m$$$ characters in this suffix, then output the whole suffix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains three numbers $$$n$$$, $$$k$$$ and $$$m$$$ ($$$1 \\le n, m \\le 200$$$, $$$1 \\le k \\le 10^{18}$$$) denoting the index of the Fibonacci string you have to consider, the index of the element of $$$A(F(n))$$$ and the number of characters you have to output, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$k$$$ does not exceed the length of $$$F(n)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$m$$$ first characters of $$$k$$$-th element of $$$A(F(n))$$$, or the whole element if its length is less than $$$m$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"110\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1065G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1065/problem/G"}