{"assets":["/statement-assets/64d2647bac85b6fcd6e89a8183c567c2dc0abac3ba1b725bae8864d09fd944d3.png"],"contentKind":"statement","contestId":"280","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maximum Xor Secondary"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bike loves looking for the second maximum element in the sequence. The second maximum element in the sequence of distinct numbers "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"math_inline","text":"(k > 1)"},{"kind":"text","text":" is such maximum element "},{"kind":"math_inline","text":"xj"},{"kind":"text","text":", that the following inequality holds: "},{"attrs":{"alt":"","src":"/statement-assets/64d2647bac85b6fcd6e89a8183c567c2dc0abac3ba1b725bae8864d09fd944d3.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lucky number of the sequence of distinct positive integers "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"math_inline","text":"(k > 1)"},{"kind":"text","text":" is the number that is equal to the bitwise excluding OR of the maximum element of the sequence and the second maximum element of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got a sequence of distinct positive integers "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"math_inline","text":"(n > 1)"},{"kind":"text","text":". Let's denote sequence "},{"kind":"math_inline","text":"sl, sl + 1, ..., sr"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"s[l..r]"},{"kind":"math_inline","text":"(1 ≤ l < r ≤ n)"},{"kind":"text","text":". Your task is to find the maximum number among all lucky numbers of sequences "},{"kind":"math_inline","text":"s[l..r]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that as all numbers in sequence "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are distinct, all the given definitions make sence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 < n ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"math_inline","text":"(1 ≤ si ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum lucky number among all lucky numbers of sequences "},{"kind":"math_inline","text":"s[l..r]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 2 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n9 8 3 5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample you can choose "},{"kind":"math_inline","text":"s[4..5] = {4, 3}"},{"kind":"text","text":" and its lucky number is "},{"kind":"math_inline","text":"(4 xor 3) = 7"},{"kind":"text","text":". You can also choose "},{"kind":"math_inline","text":"s[1..2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample you must choose "},{"kind":"math_inline","text":"s[2..5] = {8, 3, 5, 7}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"280B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/280/problem/B"}