{"assets":[],"contentKind":"statement","contestId":"855","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Marvolo Gaunt's Ring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Professor Dumbledore is helping Harry destroy the Horcruxes. He went to Gaunt Shack as he suspected a Horcrux to be present there. He saw Marvolo Gaunt's Ring and identified it as a Horcrux. Although he destroyed it, he is still affected by its curse. Professor Snape is helping Dumbledore remove the curse. For this, he wants to give Dumbledore exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" drops of the potion he made. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is calculated as maximum of "},{"kind":"math_inline","text":"p·ai + q·aj + r·ak"},{"kind":"text","text":" for given "},{"kind":"math_inline","text":"p, q, r"},{"kind":"text","text":" and array "},{"kind":"math_inline","text":"a1, a2, ... an"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ k ≤ n"},{"kind":"text","text":". Help Snape find the value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Do note that the value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" may be negative."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"head