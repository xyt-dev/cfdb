{"assets":[],"contentKind":"statement","contestId":"1485","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Replace and Keep Sorted"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a positive integer $$$k$$$, two arrays are called $$$k$$$-similar if:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" they are "},{"children":[{"kind":"text","text":"strictly increasing"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" they have the same length; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all their elements are positive integers between $$$1$$$ and $$$k$$$ (inclusive); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" they differ in "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one position. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an integer $$$k$$$, a "},{"children":[{"kind":"text","text":"strictly increasing"}],"kind":"container"},{"kind":"text","text":" array $$$a$$$ and $$$q$$$ queries. For each query, you are given two integers $$$l_i \\leq r_i$$$. Your task is to find how many arrays $$$b$$$ exist, such that $$$b$$$ is $$$k$$$-similar to array $$$[a_{l_i},a_{l_i+1}\\ldots,a_{r_i}]$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[