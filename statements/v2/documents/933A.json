{"assets":[],"contentKind":"statement","contestId":"933","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. A Twisty Movement"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"A dragon symbolizes wisdom, power and wealth. On Lunar New Year's Day, people model a dragon with bamboo strips and clothes, raise them with rods, and hold the rods high and low to resemble a flying dragon."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A performer holding the rod low is represented by a "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", while one holding it high is represented by a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Thus, the line of performers can be represented by a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little Tommy is among them. He would like to choose an interval "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":"), then reverse "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":" so that the length of the longest non-decreasing subsequence of the new sequence is maximum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A non-decreasing subsequence is a sequence of indices "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"p1 < p2 < ... < pk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ap1 ≤ ap2 ≤ ... ≤ apk"},{"kind":"text","text":". The length of the subsequence is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 2000)"},{"kind":"text","text":", denoting the length of the original sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, describing the original sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 2, i = 1, 2, ..., n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, which means the maximum possible length of the longest non-decreasing subsequence of the new sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n1 1 2 2 2 1 1 2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, after reversing "},{"kind":"math_inline","text":"[2, 3]"},{"kind":"text","text":", the array will become "},{"kind":"math_inline","text":"[1, 1, 2, 2]"},{"kind":"text","text":", where the length of the longest non-decreasing subsequence is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, after reversing "},{"kind":"math_inline","text":"[3, 7]"},{"kind":"text","text":", the array will become "},{"kind":"math_inline","text":"[1, 1, 1, 1, 2, 2, 2, 2, 2, 1]"},{"kind":"text","text":", where the length of the longest non-decreasing subsequence is "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"933A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/933/problem/A"}