{"assets":[],"contentKind":"statement","contestId":"2020","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bitwise Balancing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three non-negative integers $$$b$$$, $$$c$$$, and $$$d$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please find a non-negative integer $$$a \\in [0, 2^{61}]$$$ such that $$$(a\\, |\\, b)-(a\\, \\&\\, c)=d$$$, where $$$|$$$ and $$$\\&$$$ denote the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#OR"},"children":[{"kind":"text","text":"bitwise OR operation"}],"kind":"link"},{"kind":"text","text":" and the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#AND"},"children":[{"kind":"text","text":"bitwise AND operation"}],"kind":"link"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If such an $$$a$$$ exists, print its value. If there is no solution, print a single integer $$$-1$$$. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^5$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three positive integers $$$b$$$, $$$c$$$, and $$$d$$$ ($$$0 \\le b, c, d \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the value of $$$a$$$, or $$$-1$$$ if there is no solution. Please note that $$$a$$$ must be non-negative and cannot exceed $$$2^{61}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2 2\n4 2 6\n10 2 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n-1\n12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$(0\\,|\\,2)-(0\\,\\&\\,2)=2-0=2$$$. So, $$$a = 0$$$ is a correct answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, no value of $$$a$$$ satisfies the equation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, $$$(12\\,|\\,10)-(12\\,\\&\\,2)=14-0=14$$$. So, $$$a = 12$$$ is a correct answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2020C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2020/problem/C"}