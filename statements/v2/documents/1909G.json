{"assets":[],"contentKind":"statement","contestId":"1909","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Pumping Lemma"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"attrs":{"href":"https://soundcloud.com/messi-ola/crystal-gravity-tanchiky-vs"},"children":[{"kind":"text","text":"Tanchiky & Siromaru - Crystal Gravity"}],"kind":"link"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"⠀"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given two strings $$$s$$$, $$$t$$$ of length $$$n$$$, $$$m$$$, respectively. Both strings consist of lowercase letters of the English alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the triples $$$(x, y, z)$$$ of strings such that the following conditions are true:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s = x+y+z$$$ (the symbol $$$+$$$ represents the concatenation); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$t = x+\\underbrace{ y+\\dots+y }_{k \\text{ times}} + z$$$ for some integer $$$k$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n \\lt m \\leq 10^7$$$) — the length of the strings $$$s$$$ and $$$t$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$, consisting of lowercase letters of the English alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains the string $$$t$$$ of length $$$m$$$, consisting of lowercase letters of the English alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer: the number of valid triples $$$(x, y, z)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 8\nabcd\nabcbcbcd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 5\naaa\naaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12 16\nabbababacaab\nabbababababacaab\n"}],"kind":"section"},{"attr