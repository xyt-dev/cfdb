{"assets":[],"contentKind":"statement","contestId":"811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Vladik and Memorable Trip"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vladik often travels by trains. He remembered some of his trips especially well and I would like to tell you about one of these trips:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vladik is at initial train station, and now "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people (including Vladik) want to get on the train. They are already lined up in some order, and for each of them the city code "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is known (the code of the city in which they are going to)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Train chief selects some number of disjoint segments of the original sequence of people (covering entire sequence by segments is "},{"children":[{"kind":"text","text":"not necessary"}],"kind":"container"},{"kind":"text","text":"). People who are in the same segment will be in the same train carriage. The segments are selected in such way that if at least one person travels to the city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", then all people who are going to city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" should be in the same railway carriage. This means that they can’t belong to different segments. Note, that all people who travel to the city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", either go to it and in the same railway carriage, or do not go anywhere at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Comfort of a train trip with people on segment from position "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":" of all distinct codes of cities for people on the segment from position "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":" operation also known as exclusive "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Total comfort of a train trip is equal to sum of comfort for each segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vladik to know maximal possible total comfort."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — number of people."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 5000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes code of the city to which "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person is going."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output should contain a single integer — maximal possible total comfort."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n4 4 2 5 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n5 1 3 1 5 2 4 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case best partition into segments is: "},{"kind":"math_inline","text":"[4, 4]"},{"kind":"math_inline","text":"[2, 5, 2]"},{"kind":"math_inline","text":"[3]"},{"kind":"text","text":", answer is calculated as follows: "},{"kind":"math_inline","text":"4 + (2"},{"kind":"math_inline","text":"xor"},{"kind":"math_inline","text":"5) + 3 = 4 + 7 + 3 = 14"}],"kind":"paragraph"},{"children":[{"kind"