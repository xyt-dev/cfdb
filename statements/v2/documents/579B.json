{"assets":[],"contentKind":"statement","contestId":"579","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Finding Team Member"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a programing contest named SnakeUp, "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" people want to compete for it. In order to attend this contest, people need to form teams of exactly two people. You are given the strength of each possible combination of two people. All the values of the strengths are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every contestant hopes that he can find a teammate so that their team’s strength is as high as possible. That is, a contestant will form a team with highest strength possible by choosing a teammate from ones who are willing to be a teammate with him/her. More formally, two people "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" may form a team if each of them is the best possible teammate (among the contestants that remain unpaired) for the other one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you determine who will be each person’s teammate?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" lines in the input. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 400"},{"kind":"text","text":") — the number of teams to be formed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line ("},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":") contains "},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"ai1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai2"},{"kind":"text","text":", ... , "},{"kind":"math_inline","text":"ai(i - 1)"},{"kind":"text","text":". Here "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aij ≤ 106"},{"kind":"text","text":", all "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" are distinct) denotes the strength of a team consisting of person "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and person "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (people are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":".)"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a line containing "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" numbers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number should represent the number of teammate of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"