{"assets":[],"contentKind":"statement","contestId":"348","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Turtles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a table of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". We'll consider the table rows numbered from top to bottom 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the columns numbered from left to right 1 through "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Then we'll denote the cell in row "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" contains two similar turtles. Both turtles want to get to cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". Some cells of the table have obstacles but it is guaranteed that there aren't any obstacles in the upper left and lower right corner. A turtle (one or the other) can go from cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to one of two cells "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":", as long as the required cell doesn't contain an obstacle. The turtles have had an argument so they don't want to have any chance of meeting each other along the way. Help them find the number of ways in which they can go from cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, find the number of pairs of non-intersecting ways from cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":". Two ways are called non-intersecting if they have exactly two common points — the starting point and the final point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"math_inline","text":"(2 ≤ n, m ≤ 3000)"},{"kind":"text","text":". Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters describing the table. The empty cells are marked by characters \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", the cells with obstacles are marked by \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the upper left and the lower right cells are empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the number of pairs of non-intersecting paths from cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n.....\n.###.\n.###.\n.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n...\n...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"348D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/348/problem/D"}