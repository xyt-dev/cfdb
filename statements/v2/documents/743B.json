{"assets":[],"contentKind":"statement","contestId":"743","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Chloe and the sequence "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Chloe, the same as Vladik, is a competitive programmer. She didn't have any problems to get to the olympiad like Vladik, but she was confused by the task proposed on the olympiad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider the following algorithm of generating a sequence of integers. Initially we have a sequence consisting of a single element equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Then we perform "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" steps. On each step we take the sequence we've got on the previous step, append it to the end of itself and insert in the middle the minimum positive integer we haven't used before. For example, we get the sequence "},{"kind":"math_inline","text":"[1, 2, 1]"},{"kind":"text","text":" after the first step, the sequence "},{"kind":"math_inline","text":"[1, 2, 1, 3, 1, 2, 1]"},{"kind":"text","text":" after the second step."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The task is to find the value of the element with index "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (the elements are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") in the obtained sequence, i. e. after "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" steps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Chloe to solve the problem!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 2n - 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the integer at the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th position in the obtained sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the obtained sequence is "},{"kind":"math_inline","text":"[1, 2, 1, 3, 1, 2, 1]"},{"kind":"text","text":". The number on the second position is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the obtained sequence is "},{"kind":"math_inline","text":"[1, 2, 1, 3, 1, 2, 1, 4, 1, 2, 1, 3, 1, 2, 1]"},{"kind":"text","text":". The number on the eighth position is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"743B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/743/problem/B"}