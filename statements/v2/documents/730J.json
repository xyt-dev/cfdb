{"assets":[],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Bottles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nick has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bottles of soda left after his birthday. Each bottle is described by two values: remaining amount of soda "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and bottle volume "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ai ≤ bi"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nick has decided to pour all remaining soda into minimal number of bottles, moreover he has to do it as soon as possible. Nick spends "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" seconds to pour "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units of soda from one bottle to another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nick asks you to help him to determine "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimal number of bottles to store all remaining soda and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the minimal time to pour soda into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bottles. A bottle can't store more soda than its volume. All remaining soda should be saved."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of bottles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the amount of soda remaining in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the volume of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"ai ≤ bi"},{"kind":"text","text":" for any "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line should contain two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the minimal number of bottles that can store all the soda and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the minimal time to pour the soda into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bottles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n3 3 4 3\n4 7 6 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10 30 5 6 24\n10 41 7 8 24\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Nick can pour soda from the first bottle to the second bottle. It will take 3 seconds. After it the second bottle will contain "},{"kind":"math_inline","text":"3 + 3 = 6"},{"kind":"text","text":" units of soda. Then he can pour soda from the fourth bottle to the second bottle and to the third bottle: one unit to the second and two units to the third. It will take "},{"kind":"math_inline","text":"1 + 2 = 3"},{"kind":"text","text":" seconds. So, all the soda will be in two bottles and he will spend "},{"kind":"math_inline","text":"3 + 3 = 6"},{"kind":"text","text":" seconds to do it."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"J","problemCode":"730J","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/J"}