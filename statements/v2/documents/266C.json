{"assets":[],"contentKind":"statement","contestId":"266","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Below the Diagonal"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a square matrix consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns. We assume that the rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and the columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. Some cells ("},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" cells in total) of the the matrix are filled with ones, the remaining cells are filled with zeros. We can apply the following operations to the matrix:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Swap "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th rows of the matrix; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th columns of the matrix. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are asked to transform the matrix into a special form using these operations. In that special form all the ones must be in the cells that lie below the main diagonal. Cell of the matrix, which is located on the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column, lies below the main diagonal if "},{"kind":"math_inline","text":"i > j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 1000)"},{"kind":"text","text":" — the number of rows and columns. Then follow "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines that contain one's positions, one per line. Each position is described by two integers "},{"kind":"math_inline","text":"xk, yk"},{"kind":"math_inline","text":"(1 ≤ xk, yk ≤ n)"},{"kind":"text","text":", separated by a space. A pair "},{"kind":"math_inline","text":"(xk, yk)"},{"kind":"text","text":" means that the cell, which is located on the intersection of the "},{"kind":"math_inline","text":"xk"},{"kind":"text","text":"-th row and of the "},{"kind":"math_inline","text":"yk"},{"kind":"text","text":"-th column, contains one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all positions are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the description of your actions. These actions should transform the matrix to the described special form."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line you should print a non-negative integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(m ≤ 105)"},{"kind":"text","text":" — the number of actions. In each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print three space-separated integers "},{"kind":"math_inline","text":"t, i, j"},{"kind":"math_inline","text":"(1 ≤ t ≤ 2, 1 ≤ i, j ≤ n, i ≠ j)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":" if you want to swap rows, "},{"kind":"math_inline","text":"t = 2"},{"kind":"text","text":" if you want to swap columns, and "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" denote the numbers of rows or columns respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note, that you do not need to minimize the number of operations, but their number should not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". If there are several solutions, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1 2\n1 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 3\n1 1 3\n1 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"266C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/266/problem/C"}