{"assets":["/statement-assets/9fbde29a580752dff57c2813f9e287318fec5ad74764f02073fe3356f31570e7.png"],"contentKind":"statement","contestId":"379","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. New Year Cactus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jack and Jill are tired of the New Year tree, now they've got a New Year cactus at home! A cactus is a connected undirected graph where any two simple cycles have at most one common vertex. In other words, this graph doesn't have any edges that lie on more than one simple cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the 31st of December they are going to decorate the cactus by hanging toys to its vertices. At most one toy is going to hang on each vertex — it's either the toy Jack hung or the toy Jill hung. It's possible for a vertex to have no toys."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jack and Jill has been arguing, so they don't want any edge to connect two vertices where one vertex has Jack's toy and the other vertex has Jill's toy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jack has decided to hang "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" toys. What maximum number of toys "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" can Jill hang if they both cooperate to maximize this value? Your task is to write a program that finds the sought "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" from 0 to the number of vertices on the New Year Cactus."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2500, n - 1 ≤ m"},{"kind":"text","text":") — the number of vertices and the number of edges, correspondingly. The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" each ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n, a ≠ b"},{"kind":"text","text":") that mean that there is an edge connecting vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Any pair of vertices has at most one edge between them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line must contain space-separated "},{"kind":"math_inline","text":"ba"},{"kind":"text","text":" (for all "},{"kind":"math_inline","text":"0 ≤ a ≤ n"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ba"},{"kind":"text","text":" equals the maximum number of Jill's toys on the cactus considering that it has "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" Jack's toys. Numbers "},{"kind":"math_inline","text":"ba"},{"kind":"text","text":" go in the order of increasing "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"16 20\n1 2\n3 4\n5 6\n6 7\n7 8\n9 10\n10 11\n11 12\n13 14\n15 16\n1 5\n9 13\n14 10\n10 6\n6 2\n15 11\n11 7\n7 3\n16 12\n8 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16 13 12 12 10 8 8 7 6 4 4 3 3 1 0 0 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The cactus from the second example is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9fbde29a580752dff57c2813f9e287318fec5ad74764f02073fe3356f31570e7.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"379G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/379/problem/G"}