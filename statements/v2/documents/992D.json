{"assets":["/statement-assets/7bcc8fe8a3a464948de000d5ae1eff3f7fdce149532c5a7d097addf4e5c24161.png","/statement-assets/a33a67389eed9ae108b47389407067f314178aa711582fe508f4f066a9b3d8f2.png","/statement-assets/0d283f099cd5b21451211fe8574ad959c45fef8237a0639d46111713ebfed773.png","/statement-assets/cce98a2b96fccd084d64c2894e0832d5257d684b14f34c8cab76444324d20149.png"],"contentKind":"statement","contestId":"992","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Nastya and a Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nastya received one more array on her birthday, this array can be used to play a traditional Byteland game on it. However, to play the game the players should first select such a subsegment of the array that "},{"attrs":{"alt":"","src":"/statement-assets/7bcc8fe8a3a464948de000d5ae1eff3f7fdce149532c5a7d097addf4e5c24161.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the product of all integers on the given array, "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is their sum, and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is a given constant for all subsegments. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nastya wonders how many subsegments of the array fit the described conditions. A subsegment of an array is several consecutive integers of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 105"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the length of the array and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the constant described above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 108"},{"kind":"text","text":") — the elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the number of subsegments such that the ratio between the product and the sum on them is equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n6 3 8 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only subsegment is "},{"kind":"math_inline","text":"[1]"},{"kind":"text","text":". The sum equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the product equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", so it suits us because "},{"attrs":{"alt":"","src":"/statement-assets/a33a67389eed9ae108b47389407067f314178aa711582fe508f4f066a9b3d8f2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two suitable subsegments in the second example — "},{"kind":"math_inline","text":"[6, 3]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[3, 8, 1]"},{"kind":"text","text":". Subsegment "},{"kind":"math_inline","text":"[6, 3]"},{"kind":"text","text":" has sum "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and product "},{"kind":"math_inline","text":"18"},{"kind":"text","text":", so it suits us because "},{"attrs":{"alt":"","src":"/statement-assets/0d283f099cd5b21451211fe8574ad959c45fef8237a0639d46111713ebfed773.png"},"kind":"image"},{"kind":"text","text":". Subsegment "},{"kind":"math_inline","text":"[3, 8, 1]"},{"kind":"text","text":" has sum "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" and product "},{"kind":"math_inline","text":"24"},{"kind":"text","text":", so it suits us because "},{"attrs":{"alt":"","src":"/statement-assets/cce98a2b96fccd084d64c2894e0832d5257d684b14f34c8cab76444324d20149.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"992D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/992/problem/D"}