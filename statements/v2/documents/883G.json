{"assets":[],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Orientation of Edges"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has a graph containing both directed (oriented) and undirected (non-oriented) edges. There can be multiple edges between a pair of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has picked a vertex "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" from the graph. Now Vasya wants to create two separate plans:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" to orient each undirected edge in one of two possible directions to "},{"children":[{"kind":"text","text":"maximize"}],"kind":"container"},{"kind":"text","text":" number of vertices reachable from vertex "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to orient each undirected edge in one of two possible directions to "},{"children":[{"kind":"text","text":"minimize"}],"kind":"container"},{"kind":"text","text":" number of vertices reachable from vertex "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In each of two plans each undirected edge must become directed. For an edge chosen directions can differ in two plans."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya find the plans."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ s ≤ n"},{"kind":"text","text":") — number of vertices and edges in the graph, and the vertex Vasya has picked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain information about the graph edges. Each line contains three integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":") — edge type and vertices connected by the edge. If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":" then the edge is directed and goes from the vertex "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to the vertex "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":" then the edge is undirected and it connects the vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one undirected edge in the graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first two lines should describe the plan which maximizes the number of reachable vertices. The lines three and four should describe the plan which minimizes the number of reachable vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A description of each plan should start with a line containing the number of reachable vertices. The second line of a plan should consist of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" symbols '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"', where "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is the number of undirected edges in the initial graph. Print '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' as the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th symbol of the string if the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th undirected edge "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" from the input should be oriented from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". Print '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' to signify the opposite direction (from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"). Consider undirected edges to be numbered in the same order they are given in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n1 1 2\n2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n-\n2\n+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6 3\n2 2 6\n1 4 5\n2 3 4\n1 4 1\n1 3 1\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n++-\n2\n+-+\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"883G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/883/problem/G"}