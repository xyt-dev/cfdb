{"assets":["/statement-assets/e7a9644f2542f69876a265685044f7abcd69d1d2470072cce70f199146160e09.png"],"contentKind":"statement","contestId":"842","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Gleb And Pizza"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gleb ordered pizza home. When the courier delivered the pizza, he was very upset, because several pieces of sausage lay on the crust, and he does not really like the crust."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pizza is a circle of radius "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and center at the origin. Pizza consists of the main part — circle of radius "},{"kind":"math_inline","text":"r - d"},{"kind":"text","text":" with center at the origin, and crust around the main part of the width "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Pieces of sausage are also circles. The radius of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" -th piece of the sausage is "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", and the center is given as a pair ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gleb asks you to help determine the number of pieces of sausage caught on the crust. A piece of sausage got on the crust, if it completely lies on the crust."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First string contains two integer numbers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ d < r ≤ 500"},{"kind":"text","text":") — the radius of pizza and the width of crust."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of pieces of sausage ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integer numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 500 ≤ xi, yi ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ri ≤ 500"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" are coordinates of the center of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th peace of sausage, "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" — radius of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th peace of sausage."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of pieces of sausage that lay on the crust."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4\n7\n7 8 1\n-7 3 2\n0 2 1\n0 -2 2\n-3 -3 1\n0 6 2\n5 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 8\n4\n0 0 9\n0 0 10\n1 0 1\n1 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below is a picture explaining the first example. Circles of green color denote pieces of sausage lying on the crust."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e7a9644f2542f69876a265685044f7abcd69d1d2470072cce70f199146160e09.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"842B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/842/problem/B"}