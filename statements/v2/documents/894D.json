{"assets":["/statement-assets/ca333b0a05d83f68c794f1eb6d2bd2e8c2e4775e7e9b5cfb67c9ac6bd13ab5a2.png"],"contentKind":"statement","contestId":"894","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ralph And His Tour in Binary Country"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ralph is in the Binary Country. The Binary Country consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" bidirectional roads connecting the cities. The roads are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road connects the city labeled "},{"attrs":{"alt":"","src":"/statement-assets/ca333b0a05d83f68c794f1eb6d2bd2e8c2e4775e7e9b5cfb67c9ac6bd13ab5a2.png"},"kind":"image"},{"kind":"text","text":" (here "},{"kind":"math_inline","text":"⌊ x⌋"},{"kind":"text","text":" denotes the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" rounded down to the nearest integer) and the city labeled "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":", and the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road is "},{"kind":"math_inline","text":"Li"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Ralph gives you "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. In each query he tells you some city "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" and an integer "},{"kind":"math_inline","text":"Hi"},{"kind":"text","text":". He wants to make some tours starting from this city. He can choose any city in the Binary Country (including "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":") as the terminal city for a tour. He gains happiness "},{"kind":"math_inline","text":"(Hi - L)"},{"kind":"text","text":" during a tour, where "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" is the distance between the city "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" and the terminal city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ralph is interested in tours from "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" in which he can gain positive happiness. For each query, compute the sum of happiness gains for all such tours."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ralph will never take the same tour twice or more (in one query), he will never pass the same city twice or more in one tour."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" lines follow, each line contains one integer "},{"kind":"math_inline","text":"Li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ Li ≤ 105"},{"kind":"text","text":"), which denotes the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each line contains two integers "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ Ai ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ Hi ≤ 107"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print one integer — the answer for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n5\n1 8\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n2\n1\n1\n3\n2\n2 4\n1 3\n3 2\n1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n6\n3\n28\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is the explanation for the second sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ralph's first query is to start tours from city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Hi"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". Here are the options:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" He can choose city "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" as his terminal city. Since the distance between city "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", he can gain happiness "},{"kind":"math_inline","text":"4 - 3 = 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He can choose city "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" as his terminal city and gain happiness "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He can choose city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" as his terminal city and gain happiness "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He can choose city "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" as his terminal city and gain happiness "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Note that Ralph can choose city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" as his terminal city and gain happiness "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Ralph won't choose city "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" as his terminal city because the distance between city "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", which leads to negative happiness for Ralph. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the answer for the first query is "},{"kind":"math_inline","text":"1 + 3 + 2 + 1 + 4 = 11"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"894D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/894/problem/D"}