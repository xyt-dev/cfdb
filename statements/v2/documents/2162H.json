{"assets":[],"contentKind":"statement","contestId":"2162","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Beautiful Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For an array $$$a$$$ of length $$$n$$$ and three integers $$$x$$$, $$$l$$$, and $$$r$$$（$$$1 \\le l \\le r \\le n$$$), define:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ f(a,x,l,r) = \\begin{cases} 0, & \\text{if} & (x-\\min_{j=l}^{r}(a_j)) \\cdot (x-\\max_{j=l}^{r}(a_j))) \\lt 0 \\\\ 1, & \\text{if} & (x-\\min_{j=l}^{r}(a_j)) \\cdot (x-\\max_{j=l}^{r}(a_j))) \\ge 0 \\end{cases} $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$n$$$ ($$$1 \\le a_i \\le n$$$), and $$$m$$$ intervals $$$[l_i, r_i]$$$ ($$$1 \\le l_i \\le r_i \\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each $$$x=1, 2, \\dots, n$$$, answer the following question "},{"children":[{"kind":"text","text":"independently"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Does there exist a rearrangement $$$a'$$$ of $$$a$$$, such that for "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" $$$1 \\le i \\le m$$$, $$$f(a',x,l_i,r_i) = 1$$$? "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^4$$$) — the number of test cases. Description of each testcase follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$2 \\le n \\le 2000$$$, $$$1 \\le m \\le 2000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains $$$n$$$ space-separated integers $$$a_1, a_2, \\cdots, a_n$$$ ($$$1 \\le a_i \\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$m$$$ lines each contain two space-separated integers $$$l_i, r_i$$$ ($$$1 \\le l_i \\le r_i \\le n$$$), each denoting an interval."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n^2$$$ and the sum of $$$m^2$$$ over all test cases does not exceed $$$4 \\cdot 10^6$$$, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a binary string $$$s$$$. For $$$x=1,2,\\ldots,n$$$, $$$s_x=1$$$ only if there exists a rearrangement $$$a'$$$ of $$$a$$$, such that for "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" $$$1 \\le i \\le m$$$, $$$f(a',x,l_i,r_i) = 1$$$. Otherwise, $$$s_x=0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4 2\n1 1 3 4\n1 2\n2 4\n3 2\n1 1 3\n1 2\n2 3\n3 1\n1 1 1\n1 3\n9 3\n4 5 9 1 1 1 2 2 3\n1 6\n3 7\n7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1011\n101\n111\n100100001\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case,"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For $$$x=1$$$, one valid rearrangement is $$$a'=[1,1,3,4]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$x=2$$$, there is no rearrangement $$$a'$$$ of $$$a$$$ satisfying $$$f(a',2,1,2)=f(a',2,2,4)=1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$x=3$$$, the "},{"children":[{"kind":"text","text":"only"}],"kind":"container"},{"kind":"text","text":" valid rearrangement is $$$a'=[4,3,1,1]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$x=4$$$, one valid rearrangement is $$$a'=[1,1,3,4]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"2162H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2162/problem/H"}