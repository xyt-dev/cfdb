{"assets":[],"contentKind":"statement","contestId":"911","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Three Garlands"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mishka is decorating the Christmas tree. He has got three garlands, and all of them will be put on the tree. After that Mishka will switch these garlands on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When a garland is switched on, it periodically changes its state — sometimes it is lit, sometimes not. Formally, if "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th garland is switched on during "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th second, then it is lit only during seconds "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + ki"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + 2ki"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + 3ki"},{"kind":"text","text":" and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mishka wants to switch on the garlands in such a way that during each second after switching the garlands on there would be at least one lit garland. Formally, Mishka wants to choose three integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x3"},{"kind":"text","text":" (not necessarily distinct) so that he will switch on the first garland during "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":"-th second, the second one — during "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":"-th second, and the third one — during "},{"kind":"math_inline","text":"x3"},{"kind":"text","text":"-th second, respectively, and during each second starting from "},{"kind":"math_inline","text":"max(x1, x2, x3)"},{"kind":"text","text":" at least one garland will be lit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Mishka by telling him if it is possible to do this!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ki ≤ 1500"},{"kind":"text","text":") — time intervals of the garlands."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Mishka can choose moments of time to switch on the garlands in such a way that each second after switching the garlands on at least one garland will be lit, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Mishka can choose "},{"kind":"math_inline","text":"x1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x3 = 1"},{"kind":"text","text":". The first garland will be lit during seconds "},{"kind":"math_inline","text":"1, 3, 5, 7, ..."},{"kind":"text","text":", the second — "},{"kind":"math_inline","text":"2, 4, 6, 8, ..."},{"kind":"text","text":", which already cover all the seconds after the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd one. It doesn't even matter what "},{"kind":"math_inline","text":"x3"},{"kind":"text","text":" is chosen. Our choice will lead third to be lit during seconds "},{"kind":"math_inline","text":"1, 4, 7, 10, ..."},{"kind":"text","text":", though."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example there is no way to choose such moments of time, there always be some seconds when no garland is lit."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"911C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/911/problem/C"}