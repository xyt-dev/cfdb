{"assets":[],"contentKind":"statement","contestId":"67","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Restoration of the Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"A = {a1, a2, ..., an}"},{"kind":"text","text":" be any permutation of the first "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" natural numbers "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":". You are given a positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and another sequence "},{"kind":"math_inline","text":"B = {b1, b2, ..., bn}"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the number of elements "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to the left of the element "},{"kind":"math_inline","text":"at = i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"aj ≥ (i + k)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if "},{"kind":"math_inline","text":"n = 5"},{"kind":"text","text":", a possible "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"{5, 1, 4, 2, 3}"},{"kind":"text","text":". For "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is given by "},{"kind":"math_inline","text":"{1, 2, 1, 0, 0}"},{"kind":"text","text":". But if "},{"kind":"math_inline","text":"k = 3"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"B = {1, 1, 0, 0, 0}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For two sequences "},{"kind":"math_inline","text":"X = {x1, x2, ..., xn}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y = {y1, y2, ..., yn}"},{"kind":"text","text":", let "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th elements be the first elements such that "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"xi < yi"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":", while if "},{"kind":"math_inline","text":"xi > yi"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" is lexicographically greater than "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", you need to determine the lexicographically smallest "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":"). On the second line are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers specifying the values of "},{"kind":"math_inline","text":"B = {b1, b2, ..., bn}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on a single line "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers of "},{"kind":"math_inline","text":"A = {a1, a2, ..., an}"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is lexicographically minimal. It is guaranteed that the solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 2 1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 5 2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 1 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"67B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/67/problem/B"}