{"assets":[],"contentKind":"statement","contestId":"1446","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Line Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"7.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$k$$$ and $$$n$$$ distinct points with integer coordinates on the Euclidean plane, the $$$i$$$-th point has coordinates $$$(x_i, y_i)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider a list of all the $$$\\frac{n(n - 1)}{2}$$$ pairs of points $$$((x_i, y_i), (x_j, y_j))$$$ ($$$1 \\le i \\lt j \\le n$$$). For every such pair, write out the distance from the line through these two points to the origin $$$(0, 0)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to calculate the $$$k$$$-th smallest number among these distances."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$, $$$k$$$ ($$$2 \\le n \\le 10^5$$$, $$$1 \\le k \\le \\frac{n(n - 1)}{2}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$-10^4 \\le x_i, y_i \\le 10^4$$$)  — the coordinates of the $$$i$$$-th point. It is guaranteed that all given points are pairwise distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should output one number — the $$$k$$$-th smallest distance from the origin. Your answer is considered correct if its absolute or relative error does not exceed $$$10^{-6}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, let your answer be $$$a$$$, and the jury's answer be $$$b$$$. Your answer is accepted if and only if $$$\\frac{|a - b|}{\\max{(1, |b|)}} \\le 10^{-6}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 3\n2 1\n-2 -1\n0 -1\n-2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0.707106780737\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are $$$6$$$ pairs of points: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Line $$$1-2$$$ : distance $$$0$$$ from the origin "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Line $$$1-3$$$ : distance $$$\\frac{\\sqrt{2}}{2} \\approx 0.707106781$$$ from the origin "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Line $$$1-4$$$ : distance $$$2$$$ from the origin "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Line $$$2-3$$$ : distance $$$1$$$ from the origin "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Line $$$2-4$$$ : distance $$$2$$$ from the origin "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Line $$$3-4$$$ : distance $$$\\frac{2}{\\sqrt{29}} \\approx 0.371390676$$$ from the origin "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The third smallest distance among those is approximately $$$0.707106781$$$."}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1446F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1446/problem/F"}