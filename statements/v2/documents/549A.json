{"assets":["/statement-assets/9e1fef0976571c74af131f6e2a17d9bc21d50bb60e043b2683822b037f195786.png","/statement-assets/af6abd1265aff0acd4a5f147e30a24c984b3578ecb5e8212696db862b26b2cca.png"],"contentKind":"statement","contestId":"549","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Face Detection"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The developers of Looksery have to write an efficient algorithm that detects faces on a picture. Unfortunately, they are currently busy preparing a contest for you, so you will have to do it for them. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem an image is a rectangular table that consists of lowercase Latin letters. A face on the image is a "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" square, such that from the four letters of this square you can make word \""},{"children":[{"kind":"text","text":"face"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to write a program that determines the number of faces on the image. The squares that correspond to the faces can overlap."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 50"},{"kind":"text","text":") — the height and the width of the image, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines define the image. Each line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print the number of faces on the image."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\nxxxx\nxfax\nxcex\nxxxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\nxx\ncf\nae\nxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\nfac\ncef\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4\nface\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the image contains a single face, located in a square with the upper left corner at the second line and the second column: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9e1fef0976571c74af131f6e2a17d9bc21d50bb60e043b2683822b037f195786.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample the image also contains exactly one face, its upper left corner is at the second row and the first column."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample two faces are shown: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/af6abd1265aff0acd4a5f147e30a24c984b3578ecb5e8212696db862b26b2cca.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth sample the image has no faces on it."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"549A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/549/problem/A"}