{"assets":["/statement-assets/29aaea6dd87f7b4fc7f85fae324678c835a0f769ef88e3b89beb195886723f34.png"],"contentKind":"statement","contestId":"707","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bakery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Masha wants to open her own bakery and bake muffins in one of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads, each of whose connects some pair of cities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To bake muffins in her bakery, Masha needs to establish flour supply from some storage. There are only "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" storages, located in different cities numbered "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unforunately the law of the country Masha lives in prohibits opening bakery in any of the cities which has storage located in it. She can open it only in one of another "},{"kind":"math_inline","text":"n - k"},{"kind":"text","text":" cities, and, of course, flour delivery should be paid — for every kilometer of path between storage and bakery Masha should pay "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ruble."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, Masha will pay "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" roubles, if she will open the bakery in some city "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ai ≠ b"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"1 ≤ i ≤ k"},{"kind":"text","text":") and choose a storage in some city "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"s = aj"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"1 ≤ j ≤ k"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are connected by some path of roads of summary length "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (if there are more than one path, Masha is able to choose which of them should be used)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Masha is very thrifty and rational. She is interested in a city, where she can open her bakery (and choose one of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" storages and one of the paths between city with bakery and city with storage) and pay minimum possible amount of rubles for flour delivery. Please help Masha find this amount."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":") — the number of cities in country Masha lives in, the number of roads between them and the number of flour storages respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow. Each of them contains three integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":") meaning that there is a road between cities "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" of length of "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" kilometers ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"k > 0"},{"kind":"text","text":", then the last line of the input contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") — the number of cities having flour storage located in. If "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":" then this line "},{"children":[{"kind":"text","text":"is not presented in the input"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible amount of rubles Masha should pay for flour delivery in the only line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the bakery can not be opened (while satisfying conditions) in any of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" in the only line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2\n1 2 5\n1 2 3\n2 3 4\n1 4 10\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n1 2 3\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/29aaea6dd87f7b4fc7f85fae324678c835a0f769ef88e3b89beb195886723f34.png"},"kind":"image"},{"children":[{"kind":"text","text":"Image illustrates the first sample case. Cities with storage located in and the road representing the answer are darkened. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"707B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/707/problem/B"}