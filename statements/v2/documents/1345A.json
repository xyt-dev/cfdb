{"assets":["/statement-assets/6032556a12e271fcb54749acc460672c63ad00e378029aab2265bc3f4fb2e752.png","/statement-assets/e2b8e775a4b77d329608ff926d5c30a5722cc6c9ab829faeab5d0113a5aff4bf.png","/statement-assets/3e06afc233de6b921550740358518bfffba65510bf4b3ccd60ae3e3c5196c78c.png"],"contentKind":"statement","contestId":"1345","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Puzzle Pieces"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a special jigsaw puzzle consisting of $$$n\\cdot m$$$ identical pieces. Every piece has three tabs and one blank, as pictured below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6032556a12e271fcb54749acc460672c63ad00e378029aab2265bc3f4fb2e752.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The jigsaw puzzle is considered solved if the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The pieces are arranged into a grid with $$$n$$$ rows and $$$m$$$ columns. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any two pieces that share an edge in the grid, a tab of one piece fits perfectly into a blank of the other piece. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Through rotation and translation of the pieces, determine if it is possible to solve the jigsaw puzzle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The test consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1\\le t\\le 1000$$$) — the number of test cases. Next $$$t$$$ lines contain descriptions of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n,m \\le 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output a single line containing \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible to solve the jigsaw puzzle, or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise. You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 3\n100000 100000\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, this is an example solution: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e2b8e775a4b77d329608ff926d5c30a5722cc6c9ab829faeab5d0113a5aff4bf.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the second test case, we can show that no solution exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, this is an example solution:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3e06afc233de6b921550740358518bfffba65510bf4b3ccd60ae3e3c5196c78c.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1345A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1345/problem/A"}