{"assets":[],"contentKind":"statement","contestId":"2038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"N. Fixing the Expression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"expression"}],"kind":"container"},{"kind":"text","text":" is a string consisting of three characters, where the first and the last characters are digits (from $$$0$$$ to $$$9$$$), and the middle character is a comparison symbol ("},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An expression is "},{"children":[{"kind":"text","text":"true"}],"kind":"container"},{"kind":"text","text":" if the comparison symbol matches the digits (for example, if the first digit is strictly less than the last digit, the comparison symbol should be "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the expressions "},{"children":[{"kind":"text","text":"1<3"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4>2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0=0"}],"kind":"container"},{"kind":"text","text":" are true, while "},{"children":[{"kind":"t