\n0=0\n0<3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"N","problemCode":"2038N","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2038/problem/N"}