{"assets":["/statement-assets/277255ef1986ef434f2b3d0e4a807d2e0a122b325a08f08f083954186223a33b.png"],"contentKind":"statement","contestId":"487","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tourists"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Cyberland, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", connected by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th road connects city "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For tourists, souvenirs are sold in every city of Cyberland. In particular, city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" sell it at a price of "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now there are "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries for you to handle. There are two types of queries:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"C "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"w"}],"kind":"container"},{"kind":"text","text":"\": The price in city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is changed to "},{"kind":"math_inline","text":"w"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"A "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"}],"kind":"container"},{"kind":"text","text":"\": Now a tourist will travel from city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". He will choose a route, he also doesn't want to visit a city twice. He will buy souvenirs at the city where the souvenirs are the cheapest (possibly exactly at city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"). You should output the minimum possible price that he can buy the souvenirs during his travel."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"More formally, we can define routes as follow:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A route is a sequence of cities "},{"kind":"math_inline","text":"[x1, x2, ..., xk]"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is a certain positive integer."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any "},{"kind":"math_inline","text":"1 ≤ i < j ≤ k, xi ≠ xj"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any "},{"kind":"math_inline","text":"1 ≤ i < k"},{"kind":"text","text":", there is a road connecting "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xi + 1"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The minimum price of the route is "},{"kind":"math_inline","text":"min(wx1, wx2, ..., wxk)"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The required answer is the minimum value of the minimum prices of all valid routes from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers "},{"kind":"math_inline","text":"n, m, q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, q ≤ 105"},{"kind":"text","text":"), separated by a single space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of space-separated integers "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aj, bj ≤ n, aj ≠ bj"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at most one road connecting the same pair of cities. There is always at least one valid route between any two cities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines each describe a query. The format is \""},{"children":[{"kind":"text","text":"C "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"w"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"A "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"}],"kind":"container"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n, 1 ≤ w ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of type \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", output the corresponding answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n1\n2\n3\n1 2\n2 3\n1 3\nA 2 3\nC 1 5\nA 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 9 4\n1\n2\n3\n4\n5\n6\n7\n1 2\n2 5\n1 5\n2 3\n3 4\n2 4\n5 6\n6 7\n5 7\nA 2 3\nA 6 4\nA 6 7\nA 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n5\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the second sample, an optimal routes are:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" it is "},{"kind":"math_inline","text":"[2, 3]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" it is "},{"kind":"math_inline","text":"[6, 5, 1, 2, 4]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" it is "},{"kind":"math_inline","text":"[6, 5, 7]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" it is "},{"kind":"math_inline","text":"[3]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/277255ef1986ef434f2b3d0e4a807d2e0a122b325a08f08f083954186223a33b.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"487E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/487/problem/E"}