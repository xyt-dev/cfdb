{"assets":[],"contentKind":"statement","contestId":"222","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cosmic Tables"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Free Meteor Association (FMA) has got a problem: as meteors are moving, the Universal Cosmic Descriptive Humorous Program (UCDHP) needs to add a special module that would analyze this movement. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"UCDHP stores some secret information about meteors as an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" table with integers in its cells. The order of meteors in the Universe is changing. That's why the main UCDHP module receives the following queries:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The query to swap two table rows; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The query to swap two table columns; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The query to obtain a secret number in a particular table cell. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As the main UCDHP module is critical, writing the functional of working with the table has been commissioned to you."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 500000"},{"kind":"text","text":") — the number of table columns and rows and the number of queries, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated numbers each — the initial state of the table. Each number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in the table is an integer and satisfies the inequality "},{"kind":"math_inline","text":"0 ≤ p ≤ 106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain queries in the format \""},{"kind":"math_inline","text":"si"},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is one of the characters \""},{"children":[{"kind":"text","text":"с"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":"\", and "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" are two integers."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\", then the current query is the query to swap columns with indexes "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ m, x ≠ y"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\", then the current query is the query to swap rows with indexes "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n, x ≠ y"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":"\", then the current query is the query to obtain the number that located in the "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"-th row and in the "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"-th column ("},{"kind":"math_inline","text":"1 ≤ x ≤ n, 1 ≤ y ≤ m"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The table rows are considered to be indexed from top to bottom from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the table columns — from left to right from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query to obtain a number ("},{"kind":"math_inline","text":"si"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":"\") print the required number. Print the answers to the queries in the order of the queries in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 5\n1 2 3\n4 5 6\n7 8 9\ng 3 2\nr 3 2\nc 2 3\ng 2 2\ng 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n9\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n1 2 4\n3 1 5\nc 2 1\nr 1 2\ng 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's see how the table changes in the second test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the first operation is fulfilled, the table looks like that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2 1 4"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1 3 5"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second operation is fulfilled, the table looks like that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1 3 5"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2 1 4"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the answer to the third query (the number located in the first row and in the third column) will be 5."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"222B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/222/problem/B"}