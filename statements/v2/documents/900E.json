xt","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a sequence of positions "},{"kind":"math_inline","text":"i, i + 1, ..., i + m - 1"},{"kind":"text","text":" as "},{"children":[{"kind":"text","text":"occurrence"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"1 ≤ i ≤ n - m + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t1 = si, t2 = si + 1, ..., tm = si + m - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The boy defines the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as maximum number of disjoint occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Vasya can replace some letters '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' with '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' (letters on different positions can be replaced with different letter). Vasya wants to make some replacements in such a way that beauty of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is maximum possible. From all such options, he wants to choose one with the minimum number of replacements. Find the number of replacements he should make."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"