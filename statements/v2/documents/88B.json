{"assets":[],"contentKind":"statement","contestId":"88","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Keyboard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya learns to type. He has an unusual keyboard at his disposal: it is rectangular and it has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of keys containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" keys in each row. Besides, the keys are of two types. Some of the keys have lowercase Latin letters on them and some of the keys work like the \"Shift\" key on standard keyboards, that is, they make lowercase letters uppercase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya can press one or two keys with one hand. However, he can only press two keys if the Euclidean distance between the centers of the keys does not exceed "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". The keys are considered as squares with a side equal to 1. There are no empty spaces between neighbouring keys."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is a very lazy boy, that's why he tries to type with one hand as he eats chips with his other one. However, it is possible that some symbol can't be typed with one hand only, because the distance between it and the closest \"Shift\" key is strictly larger than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". In this case he will have to use his other hand. Having typed the symbol, Vasya returns other hand back to the chips."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given Vasya's keyboard and the text. Count the minimum number of times Vasya will have to use the other hand."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 30, 1 ≤ x ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain descriptions of all the keyboard keys. Each line contains the descriptions of exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" keys, without spaces. The letter keys are marked with the corresponding lowercase letters. The \"Shift\" keys are marked with the \""},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"\" symbol. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow the length of the text "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 5·105)"},{"kind":"text","text":". The last line contains the text "},{"kind":"math_inline","text":"T"},{"kind":"text","text":", which consists of "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" symbols, which are uppercase and lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Vasya can type the text, then print the minimum number of times he will have to use his other hand. Otherwise, print \"-1\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\nab\ncd\n1\nA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\nab\ncd\n1\ne\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\nab\ncS\n5\nabcBA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 9 4\nqwertyuio\nasdfghjkl\nSzxcvbnmS\n35\nTheQuIcKbRoWnFOXjummsovertHeLazYDOG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the symbol \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" is impossible to print as there's no \"Shift\" key on the keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the symbol \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" is impossible to print as there's no such key on the keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample the symbols \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" are impossible to print with one hand. The other letters that are on the keyboard can be printed. Those symbols come up in the text twice, thus, the answer is 2."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"88B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/88/problem/B"}