{"assets":[],"contentKind":"statement","contestId":"114","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cifera"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When Petya went to school, he got interested in large numbers and what they were called in ancient times. For instance, he learned that the Russian word \"tma\" (which now means \"too much to be counted\") used to stand for a thousand and \"tma tmyschaya\" (which literally means \"the tma of tmas\") used to stand for a million."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wanted to modernize the words we use for numbers and invented a word "},{"children":[{"kind":"text","text":"petricium"}],"kind":"container"},{"kind":"text","text":" that represents number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Moreover, "},{"children":[{"kind":"text","text":"petricium la petricium"}],"kind":"container"},{"kind":"text","text":" stands for number "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"petricium la petricium la petricium"}],"kind":"container"},{"kind":"text","text":" stands for "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":" and so on. All numbers of this form are called "},{"children":[{"kind":"text","text":"petriciumus cifera"}],"kind":"container"},{"kind":"text","text":", and the number's importance is the number of articles "},{"children":[{"kind":"text","text":"la"}],"kind":"container"},{"kind":"text","text":" in its title."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya's invention brought on a challenge that needed to be solved quickly: does some number "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" belong to the set "},{"children":[{"kind":"text","text":"petriciumus cifera"}],"kind":"container"},{"kind":"text","text":"? As Petya is a very busy schoolboy he needs to automate the process, he asked you to solve it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains integer number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the second line contains integer number "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k, l ≤ 231 - 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should print in the first line of the output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the number belongs to the set "},{"children":[{"kind":"text","text":"petriciumus cifera"}],"kind":"container"},{"kind":"text","text":" and otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". If the number belongs to the set, then print on the seconds line the only number — the importance of number "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"114A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/114/problem/A"}