{"assets":[],"contentKind":"statement","contestId":"1768","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Partial Sorting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a permutation$$$^\\dagger$$$ $$$p$$$ of length $$$3n$$$. Each time you can do one of the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Sort the first $$$2n$$$ elements in increasing order. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Sort the last $$$2n$$$ elements in increasing order. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can show that every permutation can be made sorted in increasing order using only these operations. Let's call $$$f(p)$$$ the minimum number of these operations needed to make the permutation $$$p$$$ sorted in increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given $$$n$$$, find the sum of $$$f(p)$$$ over all $$$(3n)!$$$ permutations $$$p$$$ of size $$$3n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer could be very large, output it modulo a prime $$$M$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ A permutation of length $$$n$$$ is an array consisting of $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ in arbitrary order. For example, $$$[2,3,1,5,4]$$$ is a permutation, but $$$[1,2,2]$$$ is not a permutation ($$$2$$$ appears twice in the array), and $$$[1,3,4]$$$ is also not a permutation ($$$n=3$$$ but there is $$$4$$$ in the array)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains two numbers $$$n$$$ and $$$M$$$ ($$$1 \\leq n \\leq 10^6$$$, $$$10^8 \\leq M \\leq 10^9$$$). It is guaranteed that $$$M$$$ is a prime number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer modulo $$$M$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 100009067\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 100000357\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1689\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n69 999900997\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n193862705\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, all the permutations are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1, 2, 3]$$$, which requires $$$0$$$ operations; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 3, 2]$$$, which requires $$$1$$$ operation; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 1, 3]$$$, which requires $$$1$$$ operation; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 3, 1]$$$, which requires $$$2$$$ operations; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 1, 2]$$$, which requires $$$2$$$ operations; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 2, 1]$$$, which requires $$$3$$$ operations. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Therefore, the answer is $$$0+1+1+2+2+3=9$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1768E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1768/problem/E"}