{"assets":[],"contentKind":"statement","contestId":"685","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Robbers' watch"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Robbers, who attacked the Gerda's cab, are very successful in covering from the kingdom police. To make the goal of catching them even harder, they use their own watches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, as they know that kingdom police is bad at math, robbers use the positional numeral system "},{"children":[{"kind":"text","text":"with base "},{"kind":"math_inline","text":"7"}],"kind":"container"},{"kind":"text","text":". Second, they divide one day in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hours, and each hour in "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" minutes. Personal watches of each robber are divided in two parts: first of them has the smallest possible number of places that is necessary to display any integer from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", while the second has the smallest possible number of places that is necessary to display any integer from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":". Finally, if some value of hours or minutes can be displayed using less number of places in base "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" than this watches have, the required number of zeroes is added at the beginning of notation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that to display number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" section of the watches is required to have at least one place."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little robber wants to know the number of moments of time (particular values of hours and minutes), such that all digits displayed on the watches are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":". Help her calculate this number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, given in the decimal notation, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 109"},{"kind":"text","text":") — the number of hours in one day and the number of minutes in one hour, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer in decimal notation — the number of different pairs of hour and minute, such that all digits displayed on the watches are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, possible pairs are: "},{"kind":"math_inline","text":"(0: 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0: 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1: 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1: 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, possible pairs are: "},{"kind":"math_inline","text":"(02: 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(03: 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(04: 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(05: 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(06: 1)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"685A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/685/problem/A"}