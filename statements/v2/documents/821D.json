{"assets":["/statement-assets/ee67eaa52e746553241f1ec1fba5b93f207642b26516a3a97b1d3614a4999082.png","/statement-assets/277ce7166180de25ec800de2237ec97ec13933cd61721f2bd678c7f49cd2c9dc.png","/statement-assets/7848e8eb6497e2c8e410dc3b5c83399dc45d19a9c464d800efd2d0c6aba82319.png"],"contentKind":"statement","contestId":"821","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Okabe and City"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Okabe likes to be able to walk through his city on a path lit by street lamps. That way, he doesn't get beaten up by schoolchildren."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Okabe's city is represented by a 2D grid of cells. Rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom, and columns are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. Exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cells in the city are lit by a street lamp. It's guaranteed that the top-left cell is lit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Okabe starts his walk from the top-left cell, and wants to reach the bottom-right cell. Of course, Okabe will only walk on lit cells, and he can only move to adjacent cells in the up, down, left, and right directions. However, Okabe can also temporarily light all the cells in any single row or column at a time if he pays "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" coin, allowing him to walk through some cells not lit initially. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that Okabe can only light a single row or column at a time, and has to pay a coin every time he lights a new row or column. To change the row or column that is temporarily lit, he must stand at a cell that is lit initially. Also, once he removes his temporary light from a row or column, all cells in that row/column not initially lit are now not lit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Okabe find the minimum number of coins he needs to pay to complete his walk!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m, k ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ m"},{"kind":"text","text":") — the row and the column of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th lit cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lit cells are distinct. It is guaranteed that the top-left cell is lit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of coins Okabe needs to pay to complete his walk, or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it's not possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 5\n1 1\n2 1\n2 3\n3 3\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 4\n1 1\n2 1\n3 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 4\n1 1\n1 2\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 4\n1 1\n2 2\n3 3\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test, Okabe can take the path "},{"attrs":{"alt":"","src":"/statement-assets/ee67eaa52e746553241f1ec1fba5b93f207642b26516a3a97b1d3614a4999082.png"},"kind":"image"},{"kind":"text","text":", paying only when moving to "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample, Okabe can take the path "},{"attrs":{"alt":"","src":"/statement-assets/277ce7166180de25ec800de2237ec97ec13933cd61721f2bd678c7f49cd2c9dc.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/7848e8eb6497e2c8e410dc3b5c83399dc45d19a9c464d800efd2d0c6aba82319.png"},"kind":"image"},{"kind":"text","text":", paying when moving to "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"(5, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"821D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/821/problem/D"}