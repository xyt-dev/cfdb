{"assets":[],"contentKind":"statement","contestId":"1473","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Strange Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"32 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note that the memory limit is unusual."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$n$$$ and two sequences $$$a_1, a_2, \\dots, a_n$$$ and $$$b_1, b_2, \\dots, b_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a set of integers $$$S$$$ such that $$$S \\subseteq \\{1, 2, 3, \\dots, n\\}$$$ "},{"children":[{"kind":"text","text":"strange"}],"kind":"container"},{"kind":"text","text":", if, for every element $$$i$$$ of $$$S$$$, the following condition is met: for every $$$j \\in [1, i - 1]$$$, if $$$a_j$$$ divides $$$a_i$$$, then $$$j$$$ is also included in $$$S$$$. An empty set is always "},{"children":[{"kind":"text","text":"strange"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the set $$$S$$$ is $$$\\sum\\limits_{i \\in S} b_i$$$. You have to calculate the maximum possible "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of a "},{"children":[{"kind":"text","text":"strange"}],"kind":"container"},{"kind":"text","text":" set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"inpu