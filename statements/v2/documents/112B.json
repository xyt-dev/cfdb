{"assets":["/statement-assets/0f2236a8fde0bad98acacab289b4e89e8bf23d52129fc39f880664f65798252a.png"],"contentKind":"statement","contestId":"112","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Petya and Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya loves playing with squares. Mum bought him a square "},{"kind":"math_inline","text":"2n × 2n"},{"kind":"text","text":" in size. Petya marked a cell inside the square and now he is solving the following task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The task is to draw a broken line that would go along the grid lines and that would cut the square into two equal parts. The cutting line should not have any common points with the marked cell and the resulting two parts should be equal "},{"children":[{"kind":"text","text":"up to rotation"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wants to determine whether it is possible to cut the square in the required manner given the sizes of the square side and the coordinates of the marked cell. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ 2n ≤ 100, 1 ≤ x, y ≤ 2n"},{"kind":"text","text":"), representing the length of a square's side and the coordinates of the marked cell. It is guaranteed that "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The coordinates of the marked cell are represented by a pair of numbers "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" represents the number of the row and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" represents the number of the column. The rows and columns are numbered by consecutive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":". The rows are numbered from top to bottom and the columns are numbered from the left to the right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the square is possible to cut, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A sample test from the statement and one of the possible ways of cutting the square are shown in the picture: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0f2236a8fde0bad98acacab289b4e89e8bf23d52129fc39f880664f65798252a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"112B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/112/problem/B"}