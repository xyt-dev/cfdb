{"assets":[],"contentKind":"statement","contestId":"429","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tricky Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub and Sorin are the best competitive programmers in their town. However, they can't both qualify to an important contest. The selection will be made with the help of a single problem. Blatnatalag, a friend of Iahub, managed to get hold of the problem before the contest. Because he wants to make sure Iahub will be the one qualified, he tells Iahub the following task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given an (1-based) array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements. Let's define function "},{"kind":"math_inline","text":"f(i, j)"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ n)"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"(i - j)2 + g(i, j)2"},{"kind":"text","text":". Function g is calculated by the following pseudo-code:"}],"kind":"paragraph"},{"kind":"code_block","text":"\nint g(int i, int j) {\n    int sum = 0;\n    for (int k = min(i, j) + 1; k <= max(i, j); k = k + 1)\n        sum = sum + a[k];\n    return sum;\n}\n"},{"children":[{"kind":"text","text":"Find a value "},{"kind":"math_inline","text":"mini ≠ j  f(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Probably by now Iahub already figured out the solution to this problem. Can you?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100000"},{"kind":"text","text":"). Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a[1]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a[2]"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"a[n]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 104 ≤ a[i] ≤ 104"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the value of "},{"kind":"math_inline","text":"mini ≠ j  f(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"429D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/429/problem/D"}