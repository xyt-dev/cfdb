{"assets":[],"contentKind":"statement","contestId":"411","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Password Check"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have probably registered on Internet sites many times. And each time you should enter your invented password. Usually the registration form automatically checks the password's crypt resistance. If the user's password isn't complex enough, a message is displayed. Today your task is to implement such an automatic check."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Web-developers of the company Q assume that a password is complex enough, if it meets all of the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the password length is at least 5 characters; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the password contains at least one large English letter; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the password contains at least one small English letter; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the password contains at least one digit. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a password. Please implement the automatic check of its complexity for company Q."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","t