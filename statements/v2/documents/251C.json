{"assets":[],"contentKind":"statement","contestId":"251","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Number Transformation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya likes positive integers a lot. Recently his mom has presented him a positive integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". There's only one thing Petya likes more than numbers: playing with little Masha. It turned out that Masha already has a positive integer "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Petya decided to turn his number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into the number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" consecutively performing the operations of the following two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Subtract 1 from his number. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose any integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", inclusive. Then subtract number "},{"kind":"math_inline","text":"(a mod x)"},{"kind":"text","text":" from his number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". Operation "},{"kind":"math_inline","text":"a mod x"},{"kind":"text","text":" means taking the remainder from division of number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Petya performs one operation per second. Each time he chooses an operation to perform during the current move, no matter what kind of operations he has performed by that moment. In particular, this implies that he can perform the same operation any number of times in a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he wonders in what minimum number of seconds he could transform his number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Please note that numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the operations of the second type are selected anew each time, independently of each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b ≤ a ≤ 1018"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ 15"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the required minimum number of seconds needed to transform number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000000000000000000 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"666666666666666667\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the sequence of numbers that Petya gets as he tries to obtain number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is as follows: 10 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 8 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 6 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 4 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 3 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 2 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample one of the possible sequences is as follows: 6 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 4 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"251C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/251/problem/C"}