{"assets":[],"contentKind":"statement","contestId":"478","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Initial Bet"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are five people playing a game called \"Generosity\". Each person gives some non-zero number of coins "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" as an initial bet. After all players make their bets of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" coins, the following operation is repeated for several times: a coin is passed from one player to some other player."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to write a program that can, given the number of coins each player has at the end of the game, determine the size "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of the initial bet or find out that such outcome of the game cannot be obtained for any positive number of coins "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the initial bet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing five integers "},{"kind":"math_inline","text":"c1, c2, c3, c4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c5"},{"kind":"text","text":" — the number of coins that the first, second, third, fourth and fifth players respectively have at the end of the game ("},{"kind":"math_inline","text":"0 ≤ c1, c2, c3, c4, c5 ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only line containing a single positive integer "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" — the number of coins in the initial bet of each player. If there is no such value of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then print the only value \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5 4 0 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 9 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the following sequence of operations is possible:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" One coin is passed from the fourth player to the second player; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" One coin is passed from the fourth player to the fifth player; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" One coin is passed from the first player to the third player; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" One coin is passed from the fourth player to the second player. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"478A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/478/problem/A"}