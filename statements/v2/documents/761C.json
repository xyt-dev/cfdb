{"assets":["/statement-assets/1782082e09c7840d5797617c842fb6ff27d03b050ab9f8caba5461757972e121.png","/statement-assets/8ae45400f6304ad7bab4c564bbe27e864ffc819d51eb434f7a234a9fefaf0d9f.png","/statement-assets/4e2c6fa87894b3e1f56987748e2417ae8e538077a3e30c6009d9bd0ca52ee4a4.png"],"contentKind":"statement","contestId":"761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dasha and Password"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After overcoming the stairs Dasha came to classes. She needed to write a password to begin her classes. The password is a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" which satisfies the following requirements:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" There is at least one digit in the string, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is at least one lowercase (small) letter of the Latin alphabet in the string, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is at least one of three listed symbols in the string: '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1782082e09c7840d5797617c842fb6ff27d03b050ab9f8caba5461757972e121.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Considering that these are programming classes it is not easy to write the password."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each character of the password we have a fixed string of length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", on each of these "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings there is a pointer on some character. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character displayed on the screen is the pointed character in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th string. Initially, all pointers are on characters with indexes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the corresponding strings (all positions are numbered starting from one)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During one operation Dasha can move a pointer in one string one character to the left or to the right. Strings are cyclic, it means that when we move the pointer which is on the character with index "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the left, it moves to the character with the index "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", and when we move it to the right from the position "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" it moves to the position "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to determine the minimum number of operations necessary to make the string displayed on the screen a valid password. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(3 ≤ n ≤ 50, 1 ≤ m ≤ 50)"},{"kind":"text","text":" — the length of the password and the length of strings which are assigned to password symbols. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the string which is assigned to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol of the password string. Its length is "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", it consists of digits, lowercase English letters, and characters '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have such input data that you can always get a valid password."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of operations which is necessary to make the string, which is displayed on the screen, a valid password. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1**2\na3*0\nc4**\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n#*&#*\n*a1c&\n&q2w*\n#a3c#\n*&#*&\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test it is necessary to move the pointer of the third string to one left to get the optimal answer. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8ae45400f6304ad7bab4c564bbe27e864ffc819d51eb434f7a234a9fefaf0d9f.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second test one of possible algorithms will be: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" to move the pointer of the second symbol once to the right. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to move the pointer of the third symbol twice to the right. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4e2c6fa87894b3e1f56987748e2417ae8e538077a3e30c6009d9bd0ca52ee4a4.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"761C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/761/problem/C"}