{"assets":[],"contentKind":"statement","contestId":"1276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Asterisk Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a string $$$s$$$ of $$$n$$$ lowercase English letters. Let $$$t_i$$$ be the string obtained by replacing the $$$i$$$-th character of $$$s$$$ with an asterisk character "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":". For example, when $$$s = \\mathtt{abc}$$$, we have $$$t_1 = \\tt{*bc}$$$, $$$t_2 = \\tt{a*c}$$$, and $$$t_3 = \\tt{ab*}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a string $$$s$$$, count the number of distinct strings of lowercase English letters and asterisks that occur as a substring of at least one string in the set $$$\\{s, t_1, \\ldots, t_n \\}$$$. The empty string should be counted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"'s are just characters and do not play any special role as in, for example, regex matching."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a string $$$s$$$ of $$$n$$$ lowercase English letters ($$$1 \\leq n \\leq 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"