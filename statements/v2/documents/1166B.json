{"assets":["/statement-assets/7cbb17e9ffb99737cb0671e2273b2cf174c27044347987236a355e94af7fee93.png"],"contentKind":"statement","contestId":"1166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. All the Vowels Please"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tom loves vowels, and he likes long words with many vowels. His favorite words are vowelly words. We say a word of length $$$k$$$ is vowelly if there are positive integers $$$n$$$ and $$$m$$$ such that $$$n\\cdot m = k$$$ and when the word is written by using $$$n$$$ rows and $$$m$$$ columns (the first row is filled first, then the second and so on, with each row filled from left to right), every vowel of the English alphabet appears at least once in every row and every column."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$k$$$ and you must either print a vowelly word of length $$$k$$$ or print $$$-1$$$ if no such word exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem the vowels of the English alphabet are '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' ,'"},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input consists of a single line containing the integer $$$k$$$ ($$$1\\leq k \\leq 10^4$$$) — the required length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output must consist of a single line, consisting of a vowelly word of length $$$k$$$ consisting of lowercase English letters if it exists or $$$-1$$$ if it does not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible words, you may output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n36\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nagoeuioaeiruuimaeoieauoweouoiaouimae"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example, the word \""},{"children":[{"kind":"text","text":"agoeuioaeiruuimaeoieauoweouoiaouimae"}],"kind":"container"},{"kind":"text","text":"\" can be arranged into the following $$$6 \\times 6$$$ grid:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7cbb17e9ffb99737cb0671e2273b2cf174c27044347987236a355e94af7fee93.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"It is easy to verify that every row and every column contain all the vowels."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1166B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1166/problem/B"}