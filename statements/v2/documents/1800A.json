{"assets":[],"contentKind":"statement","contestId":"1800","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Is It a Cat?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You were walking down the street and heard a sound. The sound was described by the string $$$s$$$ consisting of lowercase and uppercase Latin characters. Now you want to find out if the sound was a cat meowing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the sound to be a meowing, the string can only contain the letters '"},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":"', in either uppercase or lowercase. Also: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" string must start with non-empty sequence consisting only of characters '"},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" it must be immediately followed by non-empty sequence consisting only of characters '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children"