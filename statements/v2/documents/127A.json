{"assets":[],"contentKind":"statement","contestId":"127","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Wasted Time"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Scrooge, a very busy man, decided to count the time he wastes on all sorts of useless stuff to evaluate the lost profit. He has already counted the time he wastes sleeping and eating. And now Mr. Scrooge wants to count the time he has wasted signing papers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr. Scrooge's signature can be represented as a polyline "},{"kind":"math_inline","text":"A1A2... An"},{"kind":"text","text":". Scrooge signs like that: first it places a pen at the point "},{"kind":"math_inline","text":"A1"},{"kind":"text","text":", then draws a segment from point "},{"kind":"math_inline","text":"A1"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"A2"},{"kind":"text","text":", then he draws a segment from point "},{"kind":"math_inline","text":"A2"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"A3"},{"kind":"text","text":" and so on to point "},{"kind":"math_inline","text":"An"},{"kind":"text","text":", where he stops signing and takes the pen off the paper. At that the resulting line can intersect with itself and partially repeat itself but Scrooge pays no attention to it and never changes his signing style. As Scrooge makes the signature, he never takes the pen off the paper and his writing speed is constant — "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" millimeters per second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Scrooge signed exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" papers throughout his life and all those signatures look the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the total time Scrooge wasted signing the papers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the coordinates of the polyline's endpoints. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one contains coordinates of the point "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" — integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", separated by a space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All points "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" are different. The absolute value of all coordinates does not exceed "},{"kind":"math_inline","text":"20"},{"kind":"text","text":". The coordinates are measured in millimeters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one real number — the total time Scrooges wastes on signing the papers in seconds. The absolute or relative error should not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n0 0\n10 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.200000000"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n3 1\n-5 6\n-2 -1\n3 2\n10 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6.032163204"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 10\n5 0\n4 0\n6 0\n3 0\n7 0\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.000000000"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"127A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/127/problem/A"}