{"assets":["/statement-assets/483cd64c749fdcc493446405119184ee24a622705f3508988b12be901edaba23.png","/statement-assets/92b474a66dd5f78489a28c9ec990494c1b72ed206d378eb49ba68ee64e82ff36.png"],"contentKind":"statement","contestId":"1725","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Accumulation of Dominoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pak Chanek has a grid that has $$$N$$$ rows and $$$M$$$ columns. Each row is numbered from $$$1$$$ to $$$N$$$ from top to bottom. Each column is numbered from $$$1$$$ to $$$M$$$ from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each tile in the grid contains a number. The numbers are arranged as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Row $$$1$$$ contains integers from $$$1$$$ to $$$M$$$ from left to right. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Row $$$2$$$ contains integers from $$$M+1$$$ to $$$2 \\times M$$$ from left to right. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Row $$$3$$$ contains integers from $$$2 \\times M+1$$$ to $$$3 \\times M$$$ from left to right. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" And so on until row $$$N$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A domino is defined as two different tiles in the grid that touch "},{"children":[{"kind":"text","text":"by their sides"}],"kind":"container"},{"kind":"text","text":". A domino is said to be "},{"children":[{"kind":"text","text":"tight"}],"kind":"container"},{"kind":"text","text":" if and only if the two numbers in the domino have a difference of exactly $$$1$$$. Count the number of distinct "},{"children":[{"kind":"text","text":"tight"}],"kind":"container"},{"kind":"text","text":" dominoes in the grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two dominoes are said to be distinct if and only if there exists at least one tile that is in one domino, but not in the other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers $$$N$$$ and $$$M$$$ ($$$1 \\leq N, M \\leq 10^9$$$) — the number of rows and columns in the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"An integer representing the number of distinct "},{"children":[{"kind":"text","text":"tight"}],"kind":"container"},{"kind":"text","text":" dominoes in the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture below is the grid that Pak Chanek has in the first example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/483cd64c749fdcc493446405119184ee24a622705f3508988b12be901edaba23.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The picture below is an example of a "},{"children":[{"kind":"text","text":"tight"}],"kind":"container"},{"kind":"text","text":" domino in the grid."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/92b474a66dd5f78489a28c9ec990494c1b72ed206d378eb49ba68ee64e82ff36.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1725A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1725/problem/A"}