{"assets":[],"contentKind":"statement","contestId":"1895","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Two Characters, Two Colors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". You have to paint every character of this string into one of two colors, red or blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you paint the $$$i$$$-th character red, you get $$$r_i$$$ coins. If you paint it blue, you get $$$b_i$$$ coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After coloring the string, you remove every "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" character from it, and count the number of inversions in the resulting string (i. e. the number of pairs of characters such that the left character in the pair is "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and the right character in the pair is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"). For each inversion, you have to pay $$$1$$$ coin."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum number of coins you can earn?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of four lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains one integer $$$n$$$ ($$$1 \\le n \\le 4 \\cdot 10^5$$$) — the length of the string; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains $$$s$$$ — a string of $$$n$$$ characters, where each character is either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third line contains $$$n$$$ integers $$$r_1, r_2, \\dots, r_n$$$ ($$$1 \\le r_i \\le 10^{12}$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the fourth line contains $$$n$$$ integers $$$b_1, b_2, \\dots, b_n$$$ ($$$1 \\le b_i \\le 10^{12}$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of values of $$$n$$$ over all test cases does not exceed $$$4 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the maximum number of coins you can earn."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n7\n0100010\n6 6 6 7 7 6 6\n3 3 5 4 7 6 7\n5\n10111\n9 8 5 7 5\n4 4 7 8 4\n10\n0100000000\n7 7 6 5 2 2 5 3 8 3\n8 6 9 6 6 8 9 7 7 9\n8\n01010000\n8 7 7 7 8 7 7 8\n4 4 4 2 1 4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n43\n36\n76\n52\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Explanations for the test cases for the example (blue characters are underlined, red ones are not):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$0100\\underline{0}1\\underline{0}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$10\\underline{11}1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\underline{0}1\\underline{00000000}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0\\underline{1}010000$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1895G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1895/problem/G"}