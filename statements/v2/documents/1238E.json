{"assets":[],"contentKind":"statement","contestId":"1238","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Keyboard Purchase"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a password which you often type — a string $$$s$$$ of length $$$n$$$. Every character of this string is one of the first $$$m$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since you spend a lot of time typing it, you want to buy a new keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A keyboard is a permutation of the first $$$m$$$ Latin letters. For example, if $$$m = 3$$$, then there are six possible keyboards: "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bca"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cab"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"cba"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since you type your password with one finger, you need to spend time moving your finger from one password character to the next. The time to move from character $$$s_i$$$ to character $$$s_{i+1}$$$ is equal to the distance between these characters on keyboard. The total time you have to spend typing the password with a keyboard is called the "},{"children":[{"kind":"text","text":"slowness"}],"kind":"container"},{"kind":"text","text":" of this keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formaly, the slowness of keyboard is equal to $$$\\sum\\limits_{i=2}^{n} |pos_{s_{i-1}} - pos_{s_i} |$$$, where $$$pos_x$$$ is position of letter $$$x$$$ in keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s$$$ is "},{"children":[{"kind":"text","text":"aacabc"}],"kind":"container"},{"kind":"text","text":" and the keyboard is "},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":", then the total time of typing this password is $$$|pos_a - pos_a| + |pos_a - pos_c| + |pos_c - pos_a| + |pos_a - pos_b| + |pos_b - pos_c|$$$ = $$$|2 - 2| + |2 - 3| + |3 - 2| + |2 - 1| + |1 - 3|$$$ = $$$0 + 1 + 1 + 1 + 2 = 5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Before buying a new keyboard you want to know the minimum possible slowness that the keyboard can have. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 10^5, 1 \\le m \\le 20$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ consisting of $$$n$$$ characters. Each character is one of the first $$$m$$$ Latin letters (lowercase)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer – the minimum slowness a keyboard can have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 3\naacabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 4\naaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n15 4\nabacabadabacaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is considered in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case the slowness of any keyboard is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case one of the most suitable keyboards is "},{"children":[{"kind":"text","text":"bacd"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1238E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1238/problem/E"}