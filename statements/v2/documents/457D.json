er of completely marked columns)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the expected value of the score. The expected score may be very large. If the expected score is larger than "},{"kind":"math_inline","text":"1099"},{"kind":"text","text":", print "},{"kind":"math_inline","text":"1099"},{"kind":"text","text":" instead (for example as \""},{"children":[{"kind":"text","text":"1e99"}],"kind":"container"},{"kind":"text","text":"\" without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input will consist of three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 300; n2 ≤ m ≤ 100000; n ≤ k ≤ m)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the smaller of "},{"kind":"math_inline","text":"1099"},{"kind":"text","text":" and the expected score. Your answer must be correct within an absolute or relative error of "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","