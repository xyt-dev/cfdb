{"assets":[],"contentKind":"statement","contestId":"778","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bitwise Formula"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bob recently read about bitwise operations used in computers: "},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":". He have studied their properties and invented a new game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, Bob chooses integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", bit depth of the game, which means that all numbers in the game will consist of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bits. Then he asks Peter to choose some "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-bit number. After that, Bob computes the values of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" variables. Each variable is assigned either a constant "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-bit number or result of bitwise operation. Operands of the operation may be either variables defined before, or the number, chosen by Peter. After that, Peter's score equals to the sum of all variable values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bob wants to know, what number Peter needs to choose to get the minimum possible score, and what number he needs to choose to get the maximum possible score. In both cases, if there are several ways to get the same score, find the minimum number, which he can choose."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", the number of variables and bit depth, respectively ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ m ≤ 1000"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain descriptions of the variables. Each line describes exactly one variable. Description has the following format: name of a new variable, space, sign \""},{"children":[{"kind":"text","text":":="}],"kind":"container"},{"kind":"text","text":"\", space, followed by one of:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Binary number of exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bits. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The first operand, space, bitwise operation (\""},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":"\"), space, the second operand. Each operand is either the name of variable defined before or symbol '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"', indicating the number chosen by Peter. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Variable names are strings consisting of lowercase Latin letters with length at most 10. All variable names are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output the minimum number that should be chosen by Peter, to make the sum of all variable values minimum possible, in the second line output the minimum number that should be chosen by Peter, to make the sum of all variable values maximum possible. Both numbers should be printed as "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-bit binary numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\na := 101\nb := 011\nc := ? XOR b\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"011\n100\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\na := 1\nbb := 0\ncx := ? OR a\nd := ? XOR ?\ne := d AND bb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample if Peter chooses a number "},{"kind":"math_inline","text":"0112"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"a = 1012, b = 0112, c = 0002"},{"kind":"text","text":", the sum of their values is "},{"kind":"math_inline","text":"8"},{"kind":"text","text":". If he chooses the number "},{"kind":"math_inline","text":"1002"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"a = 1012, b = 0112, c = 1112"},{"kind":"text","text":", the sum of their values is "},{"kind":"math_inline","text":"15"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test, the minimum and maximum sum of variables "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bb"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cx"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" is 2, and this sum doesn't depend on the number chosen by Peter, so the minimum Peter can choose is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"778B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/778/problem/B"}