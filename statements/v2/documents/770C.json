{"assets":[],"contentKind":"statement","contestId":"770","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Online Courses In BSU"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Now you can take online courses in the Berland State University! Polycarp needs to pass "},{"kind":"math_inline","text":"k"},{"children":[{"kind":"text","text":"main"}],"kind":"container"},{"kind":"text","text":" online courses of his specialty to get a diploma. In total "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" courses are availiable for the passage."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The situation is complicated by the dependence of online courses, for each course there is a list of those that must be passed before starting this online course (the list can be empty, it means that there is no limitation)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp to pass the least number of courses in total to get the specialty (it means to pass all "},{"children":[{"kind":"text","text":"main"}],"kind":"container"},{"kind":"text","text":" and necessary courses). Write a program which prints the order of courses. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp passes courses consistently, he starts the next course when he finishes the previous one. Each course can't be passed more than once. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 105"},{"kind":"text","text":") — the number of online-courses and the number of main courses of Polycarp's specialty. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — numbers of main online-courses of Polycarp's specialty. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each of them describes the next course: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them corresponds to the course "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Each line starts from the integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ti ≤ n - 1"},{"kind":"text","text":") — the number of courses on which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th depends. Then there follows the sequence of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — numbers of courses in random order, on which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th depends. It is guaranteed that no course can depend on itself. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of all values "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if there is no the way to get a specialty. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print the integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the minimum number of online-courses which it is necessary to pass to get a specialty. In the second line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers — numbers of courses which it is necessary to pass in the chronological order of their passage. If there are several answers it is allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n5 3\n0\n0\n0\n2 2 1\n1 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 3\n3 9 5\n0\n0\n3 9 4 5\n0\n0\n1 8\n1 6\n1 2\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 9 4 5 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n1 2\n1 3\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test firstly you can take courses number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", after that you can take the course number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", then you can take the course number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", which is the main. After that you have to take only the course number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", which is the last not passed main course. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"770C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/770/problem/C"}