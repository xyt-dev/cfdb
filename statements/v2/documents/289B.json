{"assets":[],"contentKind":"statement","contestId":"289","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Polo the Penguin and Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little penguin Polo has an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix, consisting of integers. Let's index the matrix rows from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and let's index the columns from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. Let's represent the matrix element on the intersection of row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move the penguin can add or subtract number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" from some matrix element. Find the minimum number of moves needed to make all matrix elements equal. If the described plan is impossible to carry out, say so."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inli