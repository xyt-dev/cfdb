{"assets":["/statement-assets/0a705f92b0bba53a411795c4880736ffcc6e1a555ff795616c92845f2e692d54.png","/statement-assets/84061972c17200a862ef13d7d505281b7c9ebe3ac906f1881fc57fe175d6a450.png"],"contentKind":"statement","contestId":"1082","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Maximum Diameter Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Graph constructive problems are back! This time the graph you are asked to build should match the following properties."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The graph is connected if and only if there exists a path between every pair of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The diameter (aka \"longest shortest path\") of a connected undirected graph is the maximum number of edges in the "},{"children":[{"kind":"text","text":"shortest"}],"kind":"container"},{"kind":"text","text":" path between any pair of its vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The degree of a vertex is the number of edges incident to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a sequence of $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ construct a "},{"children":[{"kind":"text","text":"connected undirected"}],"kind":"container"},{"kind":"text","text":" graph of $$$n$$$ vertices such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the graph contains no self-loops and no multiple edges; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the degree $$$d_i$$$ of the $$$i$$$-th vertex doesn't exceed $$$a_i$$$ (i.e. $$$d_i \\le a_i$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the diameter of the graph is maximum possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Output the resulting graph or report that no solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$3 \\le n \\le 500$$$) — the number of vertices in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le n - 1$$$) — the upper limits to vertex degrees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if no graph can be constructed under the given conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and the diameter of the resulting graph in the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain a single integer $$$m$$$ — the number of edges in the resulting graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$m$$$ lines should contain two integers $$$v_i, u_i$$$ ($$$1 \\le v_i, u_i \\le n$$$, $$$v_i \\neq u_i$$$) — the description of the $$$i$$$-th edge. The graph should contain no multiple edges — for each pair $$$(x, y)$$$ you output, you should output no more pairs $$$(x, y)$$$ or $$$(y, x)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES 2\n2\n1 2\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 4 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES 2\n4\n1 2\n3 2\n4 2\n5 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are the graphs for the first two example cases. Both have diameter of $$$2$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0a705f92b0bba53a411795c4880736ffcc6e1a555ff795616c92845f2e692d54.png"},"kind":"image"},{"kind":"text","text":" $$$d_1 = 1 \\le a_1 = 2$$$"},{"children":[{"kind":"text","text":"$$$d_2 = 2 \\le a_2 = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$d_3 = 1 \\le a_3 = 2$$$ "}],"kind":"paragraph"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/84061972c17200a862ef13d7d505281b7c9ebe3ac906f1881fc57fe175d6a450.png"},"kind":"image"},{"kind":"text","text":" $$$d_1 = 1 \\le a_1 = 1$$$"},{"children":[{"kind":"text","text":"$$$d_2 = 4 \\le a_2 = 4$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$d_3 = 1 \\le a_3 = 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$d_4 = 1 \\le a_4 = 1$$$ "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1082D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1082/problem/D"}