{"assets":[],"contentKind":"statement","contestId":"575","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Party"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"4 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note the unusual memory limit for the problem"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"People working in MDCS (Microsoft Development Center Serbia) like partying. They usually go to night clubs on Friday and Saturday."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" people working in MDCS and there are "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" clubs in the city. Unfortunately, if there is more than one Microsoft employee in night club, level of coolness goes infinitely high and party is over, so club owners will never let more than one Microsoft employee enter their club in the same week (just to be sure)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are organizing night life for Microsoft employees and you have statistics about how much every employee likes Friday and Saturday parties for all clubs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to match people with clubs maximizing overall sum of their happiness (they are happy as much as they like the club), while "},{"children":[{"kind":"text","text":"half"}],"kind":"container"},{"kind":"text","text":" of people should go clubbing on Friday and the other "},{"children":[{"kind":"text","text":"half"}],"kind":"container"},{"kind":"text","text":" on Saturday."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" — number of employees in MDCS."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then an "},{"kind":"math_inline","text":"N × N"},{"kind":"text","text":" matrix follows, where element in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column is an integer number that represents how much "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person likes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th club’s "},{"children":[{"kind":"text","text":"Friday"}],"kind":"container"},{"kind":"text","text":" party."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then another "},{"kind":"math_inline","text":"N × N"},{"kind":"text","text":" matrix follows, where element in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column is an integer number that represents how much "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person likes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th club’s "},{"children":[{"kind":"text","text":"Saturday"}],"kind":"container"},{"kind":"text","text":" party."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"2 ≤ N ≤ 20"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"N"},{"kind":"text","text":" is even "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"0 ≤ "},{"kind":"text","text":" level of likeness "},{"kind":"math_inline","text":" ≤ 