{"assets":[],"contentKind":"statement","contestId":"91","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Igloo Skyscraper"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today the North Pole hosts an Olympiad in a sport called... toy igloo skyscrapers' building!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" walruses taking part in the contest. Each walrus is given a unique number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". After start each walrus begins to build his own igloo skyscraper. Initially, at the moment of time equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the height of the skyscraper "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus is equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Each minute the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus finishes building "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" floors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The journalists that are reporting from the spot where the Olympiad is taking place, make "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries to the organizers. Each query is characterized by a group of three numbers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". The organizers respond to each query with a number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", such that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1. Number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" lies on the interval from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" inclusive ("},{"kind":"math_inline","text":"li ≤ x ≤ ri"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. The skyscraper of the walrus number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" possesses the maximum height among the skyscrapers of all walruses from the interval "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" at the moment of time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each journalists' query print the number of the walrus "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that meets the above-given criteria. If there are several possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 105"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 109"},{"kind":"text","text":"). Then follow "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries i the following format "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", one per each line ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ti ≤ 106"},{"kind":"text","text":"). All input numbers are integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each journalists' query print the number of the walrus "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that meets the criteria, given in the statement. Print one number per line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n4 1\n3 5\n6 2\n3 5\n6 5\n1 5 2\n1 3 5\n1 1 0\n1 5 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n2\n1\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n6 1\n5 1\n2 5\n4 3\n6 1\n2 4 1\n3 4 5\n1 4 5\n1 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"91E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/91/problem/E"}