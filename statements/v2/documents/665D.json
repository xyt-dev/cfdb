{"assets":[],"contentKind":"statement","contestId":"665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Simple Subset"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tuple of positive integers "},{"kind":"math_inline","text":"{x1, x2, ..., xk}"},{"kind":"text","text":" is called simple if for all pairs of positive integers "},{"kind":"math_inline","text":"(i,  j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ i  <  j ≤ k"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"xi  +  xj"},{"kind":"text","text":" is a prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1,  a2,  ...,  an"},{"kind":"text","text":" (not necessary distinct). You want to find a simple subset of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with the maximum size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A prime number (or a prime) is a natural number greater than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" that has no positive divisors other than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a subset of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" as a tuple that can be obtained from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by removing some (possibly all) elements of it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of integers in the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") — the elements of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the maximum possible size of simple subset of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"bl"},{"kind":"text","text":" — the elements of the simple subset of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with the maximum size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is more than one solution you can print any of them. You can print the elements of the subset in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n83 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n14 83\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"665D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contes