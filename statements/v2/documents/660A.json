{"assets":[],"contentKind":"statement","contestId":"660","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Co-prime Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements, you must make it a co-prime array in as few moves as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each move you can insert any positive integral number you want not greater than "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" in any place in the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An array is co-prime if any two adjacent numbers of it are co-prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the number theory, two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are said to be co-prime if the only positive integer that divides both of them is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of elements in the given array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the elements of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" on the first line — the least number of elements needed to add to the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to make it co-prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain "},{"kind":"math_inline","text":"n + k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" — the elements of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" after adding "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements to it. Note that the new array should be co-prime, so any two adjacent values should be co-prime. Also the new array should be got from the original array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by adding "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers you can print any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 7 28\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 7 9 28\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"660A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/660/problem/A"}