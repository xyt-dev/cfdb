{"assets":["/statement-assets/225c3f721ac4b21bf9aebc1eacfd455011a34cd24cae1789fddac558f1c3611e.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png","/statement-assets/f97b9c076173a8267323078ecc36d9e073c2a0a3a14374741b1e36ee08293360.png","/statement-assets/3bf0fc7070b81b7224632de1abc0c0c7b64487c8bfa8e36942fd5c2601614782.png"],"contentKind":"statement","contestId":"703","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mishka and Interesting sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Mishka enjoys programming. Since her birthday has just passed, her friends decided to present her with array of non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mishka loved the array and she instantly decided to determine its beauty value, but she is too little and can't process large arrays. Right because of that she invited you to visit her and asked you to process "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each query is processed in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") are specified — bounds of query segment. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Integers, presented in array segment "},{"kind":"math_inline","text":"[l,  r]"},{"kind":"text","text":" (in sequence of integers "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"even number of times"}],"kind":"container"},{"kind":"text","text":", are written down. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" XOR-sum of written down integers is calculated, and this value is the answer for a query. Formally, if integers written down in point 2 are "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"text","text":", then Mishka wants to know the value "},{"attrs":{"alt":"","src":"/statement-assets/225c3f721ac4b21bf9aebc1eacfd455011a34cd24cae1789fddac558f1c3611e.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" — operator of exclusive bitwise OR. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since only the little bears know the definition of array beauty, all you are to do is to answer each of queries presented."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000 000"},{"kind":"text","text":") — the number of elements in the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — array elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 1 000 000"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describes corresponding query by a pair of integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") — the bounds of query segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" non-negative integers — the answers for the queries in the order they appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 7 8\n1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2 1 3 3 2 3\n5\n4 7\n4 5\n1 3\n1 7\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n3\n1\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is no integers in the segment of the first query, presented even number of times in the segment — the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query there is only integer "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is presented even number of times — the answer is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query only integer "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is written down — the answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query all array elements are considered. Only "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" are presented there even number of times. The answer is "},{"attrs":{"alt":"","src":"/statement-assets/f97b9c076173a8267323078ecc36d9e073c2a0a3a14374741b1e36ee08293360.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth query "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are written down. The answer is "},{"attrs":{"alt":"","src":"/statement-assets/3bf0fc7070b81b7224632de1abc0c0c7b64487c8bfa8e36942fd5c2601614782.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"703D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/703/problem/D"}