{"assets":["/statement-assets/07e0531b910aac07815eb683ce14dfd8e8cc737150d2bed311398a90cfe628f8.png","/statement-assets/4b7e236df8f58132fb5dc1b2ec9b4fd59982c887cb9e032dcc2f04b45ebbb31e.png","/statement-assets/9b9cabffed2ea4ed71900261e9843792848c9c6b4a068bf4e3a3eab34db64924.png"],"contentKind":"statement","contestId":"724","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ray Tracing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" sensors located in the rectangular room of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" meters. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sensor is located at point "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". All sensors are located at distinct points strictly inside the rectangle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Opposite corners of the room are located at points "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". Walls of the room are parallel to coordinate axes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", from the point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" the laser ray is released in the direction of point "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". The ray travels with a speed of "},{"attrs":{"alt":"","src":"/statement-assets/07e0531b910aac07815eb683ce14dfd8e8cc737150d2bed311398a90cfe628f8.png"},"kind":"image"},{"kind":"text","text":" meters per second. Thus, the ray will reach the point "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" in exactly one second after the start."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When the ray meets the wall it's reflected by the rule that the angle of incidence is equal to the angle of reflection. If the ray reaches any of the four corners, it immediately stops."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each sensor you have to determine the first moment of time when the ray will pass through the point where this sensor is located. If the ray will never pass through this point, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" for such sensors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 100 000"},{"kind":"text","text":") — lengths of the room's walls and the number of sensors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ n - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ yi ≤ m - 1"},{"kind":"text","text":") — coordinates of the sensors. It's guaranteed that no two sensors are located at the same point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to the number of seconds when the ray first passes through the point where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sensor is located, or "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" if this will never happen. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 4\n1 1\n1 2\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n-1\n-1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 6\n1 1\n2 1\n1 2\n2 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n-1\n-1\n2\n5\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4 5\n1 3\n2 2\n5 1\n5 3\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n2\n9\n5\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the ray will consequently pass through the points "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":". Thus, it will stop at the point "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":" after "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4b7e236df8f58132fb5dc1b2ec9b4fd59982c887cb9e032dcc2f04b45ebbb31e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, the ray will consequently pass through the following points: "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 4)"},{"kind":"text","text":". The ray will stop at the point "},{"kind":"math_inline","text":"(0, 4)"},{"kind":"text","text":" after "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" seconds. It will reflect at the points "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9b9cabffed2ea4ed71900261e9843792848c9c6b4a068bf4e3a3eab34db64924.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"724C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/724/problem/C"}