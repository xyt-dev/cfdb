{"assets":[],"contentKind":"statement","contestId":"747","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mammoth's Genome Decoding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The process of mammoth's genome decoding in Berland comes to its end!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the few remaining tasks is to restore unrecognized nucleotides in a found chain "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Each nucleotide is coded with a capital letter of English alphabet: '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"'. Unrecognized nucleotides are coded by a question mark '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. Thus, "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a string consisting of letters '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"' and characters '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the number of nucleotides of each of the four types in the decoded genome of mammoth in Berland should be equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to decode the genome and replace each unrecognized nucleotide with one of the four types so that the number of nucleotides of each of the four types becomes equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ n ≤ 255"},{"kind":"text","text":") — the length of the genome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the coded genome. It consists of characters '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to decode the genome, print it. If there are multiple answer, print any of them. If it is not possible, print three equals signs in a row: \""},{"children":[{"kind":"text","text":"==="}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\nAG?C??CT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AGACGTCT\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nAGCT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AGCT\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n????G?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"===\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nAA??\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"===\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can replace the first question mark with the letter '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', the second question mark with the letter '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', the third question mark with the letter '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"', then each nucleotide in the genome would be presented twice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the genome is already decoded correctly and each nucleotide is exactly once in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third and the fourth examples it is impossible to decode the genom. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"747B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/747/problem/B"}