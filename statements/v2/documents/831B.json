{"assets":[],"contentKind":"statement","contestId":"831","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Keyboard Layouts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are two popular keyboard layouts in Berland, they differ only in letters positions. All the other keys are the same. In Berland they use alphabet with "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" letters which coincides with English alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings consisting of "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" distinct letters each: all keys of the first and the second layouts in the same order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are also given some text consisting of small and capital English letters and digits. It is known that it was typed in the first layout, but the writer intended to type it in the second layout. Print the text if the same keys were pressed in the second layout."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since all keys but letters are the same in both layouts, the capitalization of the letters should remain the same, as well as all other characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string of length "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" consisting of distinct lowercase English letters. This is the first layout."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" consisting of distinct lowercase English letters. This is the second layout."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase and uppercase English letters and digits. This is the text typed in the first layout. The length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the text if the same keys were pressed in the second layout."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"qwertyuiopasdfghjklzxcvbnm\nveamhjsgqocnrbfxdtwkylupzi\nTwccpQZAvb2017\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"HelloVKCup2017\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"mnbvcxzlkjhgfdsapoiuytrewq\nasdfghjklq