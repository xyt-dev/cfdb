{"assets":[],"contentKind":"statement","contestId":"914","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Travelling Salesman and Special Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Travelling Salesman spends a lot of time travelling so he tends to get bored. To pass time, he likes to perform operations on numbers. One such operation is to take a positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and reduce it to the number of bits set to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the binary representation of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". For example for number "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" it's true that "},{"kind":"math_inline","text":"1310 = 11012"},{"kind":"text","text":", so it has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" bits set and "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" will be reduced to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" in one operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He calls a number "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" if the minimum number of operations to reduce it to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to find out how many special numbers exist which are not greater than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Please help the Travelling Salesman, as he is about to reach his destination!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer can be large, output it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n < 21000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is given in its binary representation without any leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of special numbers not greater than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"110\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"111111011\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"169\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the three special numbers are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". They get reduced to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" in one operation (since there are two set bits in each of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":") and then to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in one more operation (since there is only one set bit in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"914C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/914/problem/C"}