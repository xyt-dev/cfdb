{"assets":[],"contentKind":"statement","contestId":"713","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sonya Partymaker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Owl Sonya decided to become a partymaker. To train for this role she gather all her owl friends in the country house. There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" chairs located in a circle and consequently numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Thus, chairs "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" are neighbouring for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":". Chairs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" are also neighbouring. Some chairs are occupied by her friends. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends in total. No two friends occupy the same chair. Rules are the following:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each participant removes from the game the chair he is currently sitting on. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each of the participants choose a direction that she will follow: clockwise (indices increase, from "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" goes to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") and counter-clockwise (indices decrease, from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" goes to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"). This direction may coincide or be different for any pair of owls. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each turn all guests move one step in the chosen directions. If some guest move to the position with a chair there, he removes this chair from the game. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Game ends if there are no more chairs left in the game. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Owls are very busy and want to get rid of the game as soon as possible. They cooperate to pick the direction. Your goal is to find the minimum number o moves required to finish the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":") — the length of the circle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last line contains an increasing sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ m"},{"kind":"text","text":") — initial positions of all owls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of move required to finish the game. Note, that "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" also may be an answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3\n1 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"406\n6\n1 2 3 204 205 206\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, it's possible if all owls will move clockwise, i.e. in the direction of increasing indices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sample, first owl has to move clockwise, while the second — counterclockwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the first and the fourth owls should move counterclockwise, while the third and the sixth — clockwise. The second and the firth may move in any direction."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"713E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/713/problem/E"}