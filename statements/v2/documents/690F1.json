{"assets":[],"contentKind":"statement","contestId":"690","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F1. Tree of Life (easy)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Heidi has finally found the mythical Tree of Life – a legendary combinatorial structure which is said to contain a prophecy crucially needed to defeat the undead armies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the surface, the Tree of Life is just a regular undirected tree well-known from computer science. This means that it is a collection of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points (called vertices), some of which are connected using "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" line segments (edges) so that each pair of vertices is connected by a "},{"children":[{"kind":"text","text":"path"}],"kind":"container"},{"kind":"text","text":" (a sequence of one or more edges)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To decipher the prophecy, Heidi needs to perform a number of steps. The first is counting the number of "},{"children":[{"kind":"text","text":"lifelines"}],"kind":"container"},{"kind":"text","text":" in the tree – these are paths of length "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", i.e., consisting of two edges. Help her!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" – the number of vertices in the tree ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000"},{"kind":"text","text":"). The vertices are labeled with the numbers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow, each describing one edge using two space-separated numbers "},{"kind":"math_inline","text":"a b"},{"kind":"text","text":" – the labels of the vertices connected by the edge ("},{"kind":"math_inline","text":"1 ≤ a < b ≤ n"},{"kind":"text","text":"). It is guaranteed that the input represents a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer – the number of lifelines in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 3\n3 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample, there are four lifelines: paths between vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F1","problemCode":"690F1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/690/problem/F1"}