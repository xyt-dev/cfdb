{"assets":[],"contentKind":"statement","contestId":"286","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Ladies' Shop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A ladies' shop has recently opened in the city of Ultima Thule. To get ready for the opening, the shop bought "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bags. Each bag is characterised by the total weight "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" of the items you can put there. The weird thing is, you "},{"children":[{"kind":"text","text":"cannot"}],"kind":"container"},{"kind":"text","text":" use these bags to put a set of items with the total weight strictly less than "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". However the weights of the items that will be sold in the shop haven't yet been defined. That's what you should determine right now."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the set of the items' weights "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"math_inline","text":"(1 ≤ p1 < p2 < ... < pk)"},{"kind":"text","text":", such that:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Any bag will be used. That is, for any "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" there will be such set of items that their total weight will equal "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". We assume that there is the infinite number of items of any weight. You can put multiple items of the same weight in one bag. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any set of items that have total weight less than or equal to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", there is a bag into which you can put this set. Similarly, a set of items can contain multiple items of the same weight. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Of all sets of the items' weights that satisfy points 1 and 2, find the set with the minimum number of weights. In other words, value "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" should be as small as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find and print the required set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 106"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a1 < a2 < ... < an ≤ m"},{"kind":"text","text":") — the bags' weight limits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if there isn't set "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", that would meet the conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), in the second line print an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (showing how many numbers are in the suitable set with the minimum number of weights), in the third line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"math_inline","text":"(1 ≤ p1 < p2 < ... < pk)"},{"kind":"text","text":". If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 10\n5 6 7 8 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n5\n5 6 7 8 9 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n6 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"286E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/286/problem/E"}