{"assets":[],"contentKind":"statement","contestId":"609","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Load Balancing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the school computer room there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" servers which are responsible for processing several computing tasks. You know the number of scheduled tasks for each server: there are "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" tasks assigned to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th server."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to balance the load for each server, you want to reassign some tasks to make the difference between the most loaded server and the least loaded server as small as possible. In other words you want to minimize expression "},{"kind":"math_inline","text":"ma - mb"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the most loaded server and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the least loaded one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one second you can reassign a single task. Thus in one second you can choose any pair of servers and move a single task from one server to another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program to find the minimum number of seconds needed to balance the load of servers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of the servers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of non-negative integers "},{"kind":"math_inline","text":"m1, m2, ..., mn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ mi ≤ 2·104"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" is the number of tasks assigned to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th server."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of seconds required to balance the load."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n10 11 10 11 10 11 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example two seconds are needed. In each second, a single task from server #2 should be moved to server #1. After two seconds there should be 3 tasks on server #1 and 4 tasks on server #2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the load is already balanced."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A possible sequence of task movements for the third example is:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" move a task from server #4 to server #1 (the sequence "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" becomes: 2 2 3 3 5); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then move task from server #5 to server #1 (the sequence "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" becomes: 3 2 3 3 4); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then move task from server #5 to server #2 (the sequence "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" becomes: 3 3 3 3 3). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The above sequence is one of several possible ways to balance the load of servers in three seconds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"609C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/609/problem/C"}