{"assets":[],"contentKind":"statement","contestId":"632","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Grandma Laura and Apples"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Grandma Laura came to the market to sell some apples. During the day she sold all the apples she had. But grandma is old, so she forgot how many apples she had brought to the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She precisely remembers she had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" buyers and each of them bought exactly half of the apples she had at the moment of the purchase and also she gave a half of an apple to some of them as a gift (if the number of apples at the moment of purchase was odd), until she sold all the apples she had."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So each buyer took some integral positive number of apples, but maybe he didn't pay for a half of an apple (if the number of apples at the moment of the purchase was odd)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each buyer grandma remembers if she gave a half of an apple as a gift or not. The cost of an apple is "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" (the number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is even)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the total money grandma should have at the end of the day to check if some buyers cheated her."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 40, 2 ≤ p ≤ 1000"},{"kind":"text","text":") — the number of the buyers and the cost of one apple. It is guaranteed that the number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the description of buyers. Each buyer is described with the string "},{"children":[{"kind":"text","text":"half"}],"kind":"container"},{"kind":"text","text":" if he simply bought half of the apples and with the string "},{"children":[{"kind":"text","text":"halfplus"}],"kind":"container"},{"kind":"text","text":" if grandma also gave him a half of an apple as a gift."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that grandma has at least one apple at the start of the day and she has no apples at the end of the day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the total money grandma should have at the end of the day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer can be too large, so you should use "},{"kind":"math_inline","text":"64"},{"kind":"text","text":"-bit integer type to store it. In "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" you can use the "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" integer type and in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" you can use "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" integer type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 10\nhalf\nhalfplus\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10\nhalfplus\nhalfplus\nhalfplus\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"55\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample at the start of the day the grandma had two apples. First she sold one apple and then she sold a half of the second apple and gave a half of the second apple as a present to the second buyer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"632A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/632/problem/A"}