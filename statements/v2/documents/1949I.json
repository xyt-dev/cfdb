{"assets":["/statement-assets/569afcf554b63bca841bb5f4bc2df44c6e71f9d34381682c936f5dc0b0d66d77.png","/statement-assets/8175a101efb567f45b2cb6d048d03a18c2a12e8ef8b31ba462db11b4d7a0eec9.png"],"contentKind":"statement","contestId":"1949","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Disks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ disks in the plane. The center of each disk has integer coordinates, and the radius of each disk is a positive integer. No two disks overlap in a region of positive area, but it is possible for disks to be tangent to each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine whether it is possible to change the radii of the disks in such a way that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Disks that were tangent to each other remain tangent to each other. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two disks overlap in a region of positive area. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The sum of all radii strictly decreases. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The new radii are allowed to be arbitrary positive real numbers. The centers of the disks cannot be changed."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1\\le n \\le 1000$$$) — the number of disks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain three integers each. The $$$i$$$-th of such lines contains $$$x_i$$$, $$$y_i$$$ ($$$-10^9 \\leq x_i, y_i \\leq 10^9$$$), and $$$r_i$$$ ($$$1 \\leq r_i \\leq 10^9$$$) — the coordinates of the center, and the radius, of the $$$i$$$-th disk."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$\\texttt{YES}$$$ if it is possible to change the radii in the desired manner. Otherwise, print $$$\\texttt{NO}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0 2 1\n0 0 1\n4 -3 4\n11 0 3\n11 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 2 2\n7 2 3\n7 7 2\n2 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first sample"}],"kind":"container"},{"kind":"text","text":", one can decrease the radii of the first and third disk by $$$0.5$$$, and increase the radius of the second disk by $$$0.5$$$. This way, the sum of all radii decreases by $$$0.5$$$. The situation before and after changing the radii is depicted below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/569afcf554b63bca841bb5f4bc2df44c6e71f9d34381682c936f5dc0b0d66d77.png"},"kind":"image"},{"children":[{"kind":"text","text":"First sample (left) and a valid way to change the radii of the disks (right)."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"second sample"}],"kind":"container"},{"kind":"text","text":", depicted below, there is no way to change the radii of the disks in the desired manner."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8175a101efb567f45b2cb6d048d03a18c2a12e8ef8b31ba462db11b4d7a0eec9.png"},"kind":"image"},{"children":[{"kind":"text","text":"Second sample."}],"kind":"container"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"1949I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1949/problem/I"}