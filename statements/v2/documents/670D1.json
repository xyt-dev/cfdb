{"assets":[],"contentKind":"statement","contestId":"670","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. Magic Powder - 1"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This problem is given in two versions that differ only by constraints. If you can solve this problem in large constraints, then you can just write a single solution to the both versions. If you find the problem too difficult in large constraints, you can write solution to the simplified version only."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Waking up in the morning, Apollinaria decided to bake cookies. To bake one cookie, she needs "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ingredients, and for each ingredient she knows the value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — how many grams of this ingredient one needs to bake a cookie. To prepare one cookie Apollinaria needs to use all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ingredients."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Apollinaria has "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" gram of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ingredient. Also she has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" grams of a magic powder. Each gram of magic powder can be turned to exactly "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" gram of any of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ingredients and can be used for baking cookies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the maximum number of cookies, which Apollinaria is able to bake using the ingredients that she has and the magic powder."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 1000"},{"kind":"text","text":") — the number of ingredients and the number of grams of the magic powder."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1000"},{"kind":"text","text":"), where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is equal to the number of grams of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ingredient, needed to bake one cookie."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains the sequence "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 1000"},{"kind":"text","text":"), where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is equal to the number of grams of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ingredient, which Apollinaria has."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum number of cookies, which Apollinaria will be able to bake using the ingredients that she has and the magic powder."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 1 4\n11 3 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n4 3 5 6\n11 12 14 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is profitably for Apollinaria to make the existing "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" gram of her magic powder to ingredient with the index "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then Apollinaria will be able to bake "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" cookies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Apollinaria should turn "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" gram of magic powder to ingredient with the index "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" gram of magic powder to ingredient with the index "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Then Apollinaria will be able to bake "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" cookies. The remaining "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" gram of the magic powder can be left, because it can't be used to increase the answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D1","problemCode":"670D1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/670/problem/D1"}