{"assets":["/statement-assets/4d63822028bfc3b4cc5331f560ef026c462095bc290abddfd53e2d05f2e034a4.png","/statement-assets/325cf2742a2cfc00c8ec4f78af3cfd0753c7da295bfa531fe250a793700b7a74.png","/statement-assets/aa9d09bf7cb87d179cc39f460f7bcbf36c3bedb2dc03f899fbadcc969c486b18.png","/statement-assets/50e0556a549ef32f7f9f8725f2ddaf90201adce4656e7ec333d90d4cd816148c.png"],"contentKind":"statement","contestId":"1073","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Choosing Two Paths"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected unweighted tree consisting of $$$n$$$ vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An undirected tree is a connected undirected graph with $$$n - 1$$$ edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to choose two pairs of vertices of this tree (all the chosen vertices "},{"children":[{"kind":"text","text":"should be distinct"}],"kind":"container"},{"kind":"text","text":") $$$(x_1, y_1)$$$ and $$$(x_2, y_2)$$$ in such a way that neither $$$x_1$$$ nor $$$y_1$$$ belong to the simple path from $$$x_2$$$ to $$$y_2$$$ and vice versa (neither $$$x_2$$$ nor $$$y_2$$$ should not belong to the simple path from $$$x_1$$$ to $$$y_1$$$)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that it is possible to choose such pairs for the given tree."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Among all possible ways to choose such pairs you have to choose one with the "},{"children":[{"kind":"text","text":"maximum number of common vertices"}],"kind":"container"},{"kind":"text","text":" between paths from $$$x_1$$$ to $$$y_1$$$ and from $$$x_2$$$ to $$$y_2$$$. And among all such pairs you have to choose one with the "},{"children":[{"kind":"text","text":"maximum total length"}],"kind":"container"},{"kind":"text","text":" of these two paths."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that the answer with at least two common vertices exists for the given tree."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The length of the path is the number of edges in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The simple path is the path that visits each vertex at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ — the number of vertices in the tree ($$$6 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n - 1$$$ lines describes the edges of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Edge $$$i$$$ is denoted by two integers $$$u_i$$$ and $$$v_i$$$, the labels of vertices it connects ($$$1 \\le u_i, v_i \\le n$$$, $$$u_i \\ne v_i$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given edges form a tree."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that the answer with at least two common vertices exists for the given tree."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" two pairs of vertices satisfying the conditions described in the problem statement."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that it is possible to choose such pairs for the given tree."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 4\n1 5\n1 6\n2 3\n2 4\n4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n7 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n9 3\n3 5\n1 2\n4 3\n4 7\n1 7\n4 6\n3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 9\n6 8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n6 8\n10 3\n3 7\n5 8\n1 7\n7 2\n2 9\n2 8\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n1 2\n2 3\n3 4\n1 5\n1 6\n6 7\n5 8\n5 9\n4 10\n4 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9 11\n8 10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture corresponding to the first example: "},{"attrs":{"alt":"","src":"/statement-assets/4d63822028bfc3b4cc5331f560ef026c462095bc290abddfd53e2d05f2e034a4.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The intersection of two paths is $$$2$$$ (vertices $$$1$$$ and $$$4$$$) and the total length is $$$4 + 3 = 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture corresponding to the second example: "},{"attrs":{"alt":"","src":"/statement-assets/325cf2742a2cfc00c8ec4f78af3cfd0753c7da295bfa531fe250a793700b7a74.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The intersection of two paths is $$$2$$$ (vertices $$$3$$$ and $$$4$$$) and the total length is $$$5 + 3 = 8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture corresponding to the third example: "},{"attrs":{"alt":"","src":"/statement-assets/aa9d09bf7cb87d179cc39f460f7bcbf36c3bedb2dc03f899fbadcc969c486b18.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The intersection of two paths is $$$3$$$ (vertices $$$2$$$, $$$7$$$ and $$$8$$$) and the total length is $$$5 + 5 = 10$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture corresponding to the fourth example: "},{"attrs":{"alt":"","src":"/statement-assets/50e0556a549ef32f7f9f8725f2ddaf90201adce4656e7ec333d90d4cd816148c.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The intersection of two paths is $$$5$$$ (vertices $$$1$$$, $$$2$$$, $$$3$$$, $$$4$$$ and $$$5$$$) and the total length is $$$6 + 6 = 12$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1073F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1073/problem/F"}