{"assets":[],"contentKind":"statement","contestId":"527","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Error Correct System"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ford Prefect got a job as a web developer for a small company that makes towels. His current work task is to create a search engine for the website of the company. During the development process, he needs to write a subroutine for comparing strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" of equal length to be \"similar\". After a brief search on the Internet, he learned about the "},{"children":[{"kind":"text","text":"Hamming distance"}],"kind":"container"},{"kind":"text","text":" between two strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" of the same length, which is defined as the number of positions in which "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" have different characters. For example, the Hamming distance between words \""},{"children":[{"kind":"text","text":"permanent"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"pergament"}],"kind":"container"},{"kind":"text","text":"\" is two, as these words differ in the fourth and sixth letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, as he was searching for information, he also noticed that modern search engines have powerful mechanisms to correct errors in the request to improve the quality of search. Ford doesn't know much about human beings, so he assumed that the most common mistake in a request is swapping two arbitrary letters of the string (not necessarily adjacent). Now he wants to write a function that determines which two letters should be swapped in string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", so that the Hamming distance between a new string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and string "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" would be as small as possible, or otherwise, determine that such a replacement cannot reduce the distance between the strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help him do this!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the length of strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains string "},{"kind":"math_inline","text":"T"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the lines only contains "},{"children":[{"kind":"text","text":"lowercase"}],"kind":"container"},{"kind":"text","text":" Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — the minimum possible Hamming distance between strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" if you swap at most one pair of letters in "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, either print the indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"), if reaching the minimum possible distance is possible by swapping letters on positions "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", or print \""},{"children":[{"kind":"text","text":"-1 -1"}],"kind":"container"},{"kind":"text","text":"\", if it is not necessary to swap characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\npergament\npermanent\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nwookie\ncookie\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n-1 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\npetr\negor\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\ndouble\nbundle\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second test it is acceptable to print "},{"kind":"math_inline","text":"i = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j = 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"527B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/527/problem/B"}