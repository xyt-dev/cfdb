{"assets":[],"contentKind":"statement","contestId":"1709","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Recover an RBS"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A bracket sequence is a string containing only characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". A regular bracket sequence (or, shortly, an RBS) is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There was an RBS. Some brackets have been replaced with question marks. Is it true that there is a "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":" way to replace question marks with brackets, so that the resulting sequence is an RBS?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 5 \\cdot 10^4$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each testcase contains an RBS with some brackets replaced with question marks. Each character is either '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. At least one RBS can be recovered from the given sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of the sequences over all testcases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the way to replace question marks with brackets, so that the resulting sequence is an RBS, is "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":". If there is more than one way, then print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n(?))\n??????\n()\n??\n?(?)()?)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, the only possible original RBS is \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second testcase, there are multiple ways to recover an RBS."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third and the fourth testcases, the only possible original RBS is \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth testcase, the original RBS can be either \""},{"children":[{"kind":"text","text":"((()()))"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"(())()()"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1709C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1709/problem/C"}