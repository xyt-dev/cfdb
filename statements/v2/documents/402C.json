{"assets":["/statement-assets/49f8d2938279c99be4aef07f80fc708f4849512aa1c152b6ed20a97585b9b95b.png"],"contentKind":"statement","contestId":"402","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Searching for Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call an undirected graph of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices "},{"children":[{"kind":"math_inline","text":"p"},{"kind":"text","text":"-interesting"}],"kind":"container"},{"kind":"text","text":", if the following conditions fulfill: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the graph contains exactly "},{"kind":"math_inline","text":"2n + p"},{"kind":"text","text":" edges; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the graph doesn't contain self-loops and multiple edges; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for any integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":"), any subgraph consisting of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" vertices contains at most "},{"kind":"math_inline","text":"2k + p"},{"kind":"text","text":" edges. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"subgraph"}],"kind":"container"},{"kind":"text","text":" of a graph is some set of the graph vertices and some set of the graph edges. At that, the set of edges must meet the condition: both ends of each edge from the set must belong to the chosen set of vertices. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find a "},{"children":[{"kind":"math_inline","text":"p"},{"kind":"text","text":"-interesting"}],"kind":"container"},{"kind":"text","text":" graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 5"},{"kind":"text","text":") — the number of tests in the input. Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines each contains two space-separated integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"5 ≤ n ≤ 24"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"p ≥ 0"},{"kind":"text","text":"; "},{"attrs":{"alt":"","src":"/statement-assets/49f8d2938279c99be4aef07f80fc708f4849512aa1c152b6ed20a97585b9b95b.png"},"kind":"image"},{"kind":"text","text":") — the number of vertices in the graph and the interest value for the appropriate test. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the required graph exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" tests print "},{"kind":"math_inline","text":"2n + p"},{"kind":"text","text":" lines containing the description of the edges of a "},{"children":[{"kind":"math_inline","text":"p"},{"kind":"text","text":"-interesting"}],"kind":"container"},{"kind":"text","text":" graph: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must contain two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n; ai ≠ bi"},{"kind":"text","text":") — two vertices, connected by an edge in the resulting graph. Consider the graph vertices numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the answers to the tests in the order the tests occur in the input. If there are multiple solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n6 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n1 3\n1 4\n1 5\n1 6\n2 3\n2 4\n2 5\n2 6\n3 4\n3 5\n3 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"402C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/402/problem/C"}