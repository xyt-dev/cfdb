{"assets":[],"contentKind":"statement","contestId":"246","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Increase and Decrease"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has an array, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Polycarpus likes it when numbers in an array match. That's why he wants the array to have as many equal numbers as possible. For that Polycarpus performs the following operation multiple times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" he chooses two elements of the array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"aj"},{"kind":"math_inline","text":"(i ≠ j)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he simultaneously increases number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and decreases number "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", that is, executes "},{"kind":"math_inline","text":"ai = ai + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aj = aj - 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Th