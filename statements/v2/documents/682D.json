{"assets":["/statement-assets/a741b5f8f255a04e5e2d08d726b370411493085a3ed245beff6b6943d8ecbe7b.png"],"contentKind":"statement","contestId":"682","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Alyona and Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After returned from forest, Alyona started reading a book. She noticed strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", lengths of which are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" respectively. As usual, reading bored Alyona and she decided to pay her attention to strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", which she considered very similar."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alyona has her favourite positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and because she is too small, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". The girl wants now to choose "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" disjoint non-empty substrings of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" such that these strings appear as disjoint substrings of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and in the same order as they do in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". She is also interested in that their length is maximum possible among all variants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, Alyona wants to find a sequence of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-empty strings "},{"kind":"math_inline","text":"p1, p2, p3, ..., pk"},{"kind":"text","text":" satisfying following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"s"},{"kind":"text","text":" can be represented as concatenation "},{"kind":"math_inline","text":"a1p1a2p2... akpkak + 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a1, a2, ..., ak + 1"},{"kind":"text","text":" is a sequence of arbitrary strings (some of them may be possibly empty); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"t"},{"kind":"text","text":" can be represented as concatenation "},{"kind":"math_inline","text":"b1p1b2p2... bkpkbk + 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"b1, b2, ..., bk + 1"},{"kind":"text","text":" is a sequence of arbitrary strings (some of them may be possibly empty); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" sum of the lengths of strings in sequence is maximum possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please help Alyona solve this complicated problem and find at least the sum of the lengths of the strings in a desired sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of a string is a subsequence of consecutive characters of the string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the input three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 10"},{"kind":"text","text":") are given — the length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", the length of the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and Alyona's favourite number respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the only non-negative integer — the sum of the lengths of the strings in a desired sequence."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed"}],"kind":"container"},{"kind":"text","text":", that at least one desired sequence exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\nabc\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 12 4\nbbaaababb\nabbbabbaaaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following image describes the answer for the second sample case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a741b5f8f255a04e5e2d08d726b370411493085a3ed245beff6b6943d8ecbe7b.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"682D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/682/problem/D"}