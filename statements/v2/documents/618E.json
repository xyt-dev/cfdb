{"assets":["/statement-assets/ea489b10711e71b2e44c14f2a879f5f8ebad5474393674fd1068cb67689e018e.png","/statement-assets/84248f28355625ba0f01b29739eab8ef597faab499869ceca05aa9b68d1f315a.png","/statement-assets/c95db1b30cd4b5d53a288fe29201b21f5c144c06fb3303ad3e2d9dbbbec0f246.png","/statement-assets/962025c64508af9e6689cc5736953ff25ec982bef178fafcd6eb9f5def2eeab2.png","/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png","/statement-assets/608c55d8280202a2ad0bc18f7dd10dc6db976fd8095ecb207de8727af057026a.png","/statement-assets/9b74bfcb2eba1e515a8be7adc1103379fd842f93b3d290964cffe4c3341a7543.png","/statement-assets/0373359f167d90387cbe27768cab1252786b1619e141be22feb5422e15ac45c4.png","/statement-assets/e641eafe622498d347409aacdaaa271ed0d90a55f44bc55bed22f54776e0922f.png","/statement-assets/0da34a7117f6cccc4db969736a4116f722f9313bca30ab57bc20eadac6410824.png"],"contentKind":"statement","contestId":"618","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Robot Arm"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roger is a robot. He has an arm that is a series of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments connected to each other. The endpoints of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment are initially located at points "},{"kind":"math_inline","text":"(i - 1, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i, 0)"},{"kind":"text","text":". The endpoint at "},{"kind":"math_inline","text":"(i - 1, 0)"},{"kind":"text","text":" is colored red and the endpoint at "},{"kind":"math_inline","text":"(i, 0)"},{"kind":"text","text":" is colored blue for all segments. Thus, the blue endpoint of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment is touching the red endpoint of the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th segment for all valid "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roger can move his arm in two different ways: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" He can choose some segment and some value. This is denoted as choosing the segment number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and picking some positive "},{"kind":"math_inline","text":"l"},{"kind":"text","text":". This change happens as follows: the red endpoint of segment number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and segments from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":" are all fixed in place. Imagine a ray from the red endpoint to the blue endpoint. The blue endpoint and segments "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" are translated "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" units in the direction of this ray."},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ea489b10711e71b2e44c14f2a879f5f8ebad5474393674fd1068cb67689e018e.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/84248f28355625ba0f01b29739eab8ef597faab499869ceca05aa9b68d1f315a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In this picture, the red point labeled "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and segments before "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" stay in place, while the blue point labeled "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and segments after "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" gets translated."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" He can choose a segment and rotate it. This is denoted as choosing the segment number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and an angle "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The red endpoint of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment will stay fixed in place. The blue endpoint of that segment and segments "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" will rotate clockwise by an angle of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" degrees around the red endpoint."},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c95db1b30cd4b5d53a288fe29201b21f5c144c06fb3303ad3e2d9dbbbec0f246.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/962025c64508af9e6689cc5736953ff25ec982bef178fafcd6eb9f5def2eeab2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In this picture, the red point labeled "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and segments before "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" stay in place, while the blue point labeled "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and segments after "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" get rotated around point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Roger will move his arm "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" times. These transformations are a bit complicated, and Roger easily loses track of where the blue endpoint of the last segment is. Help him compute the coordinates of the blue endpoint of the last segment after applying each operation. Note that these operations are cumulative, and Roger's arm may intersect itself arbitrarily during the moves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input will contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 300 000"},{"kind":"text","text":") — the number of segments and the number of operations to perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" describing a move. If "},{"kind":"math_inline","text":"xi = 1"},{"kind":"text","text":", this line describes a move of type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" denotes the segment number and "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" denotes the increase in the length. If "},{"kind":"math_inline","text":"xi = 2"},{"kind":"text","text":", this describes a move of type 2, where "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" denotes the segment number, and "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" denotes the angle in degrees. ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 2, 1 ≤ yi ≤ n, 1 ≤ zi ≤ 359"},{"kind":"text","text":")"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain two real values, denoting the coordinates of the blue endpoint of the last segment after applying operations "},{"kind":"math_inline","text":"1, ..., i"},{"kind":"text","text":". Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, let's assume that your answer for a particular value of a coordinate is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png"},"kind":"image"},{"kind":"text","text":" for all coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 1 3\n2 3 90\n2 5 48\n1 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8.0000000000 0.0000000000\n5.0000000000 -3.0000000000\n4.2568551745 -2.6691306064\n4.2568551745 -3.6691306064\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following pictures shows the state of the arm after each operation. The coordinates of point "},{"kind":"math_inline","text":"F"},{"kind":"text","text":" are printed after applying each operation. For simplicity, we only show the blue endpoints of a segment (with the exception for the red endpoint of the first segment). For instance, the point labeled "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is the blue endpoint for segment "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and also the red endpoint for segment "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initial state: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/608c55d8280202a2ad0bc18f7dd10dc6db976fd8095ecb207de8727af057026a.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Extend segment "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9b74bfcb2eba1e515a8be7adc1103379fd842f93b3d290964cffe4c3341a7543.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Rotate segment "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees clockwise. "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0373359f167d90387cbe27768cab1252786b1619e141be22feb5422e15ac45c4.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Rotate segment "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"48"},{"kind":"text","text":" degrees clockwise. "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e641eafe622498d347409aacdaaa271ed0d90a55f44bc55bed22f54776e0922f.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Extend segment "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0da34a7117f6cccc4db969736a4116f722f9313bca30ab57bc20eadac6410824.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"618E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/618/problem/E"}