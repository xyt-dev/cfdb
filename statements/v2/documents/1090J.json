{"assets":[],"contentKind":"statement","contestId":"1090","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Two Prefixes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Misha didn't do his math homework for today's lesson once again. As a punishment, his teacher Dr. Andrew decided to give him a hard, but very useless task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Andrew has written two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of lowercase English letters at the blackboard. He reminded Misha that "},{"children":[{"kind":"text","text":"prefix"}],"kind":"container"},{"kind":"text","text":" of a string is a string formed by removing several (possibly none) of its last characters, and a "},{"children":[{"kind":"text","text":"concatenation"}],"kind":"container"},{"kind":"text","text":" of two strings is a string formed by appending the second string to the right of the first string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher asked Misha to write down on the blackboard all strings that are the concatenations of some non-empty prefix of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and some non-empty prefix of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". When Misha did it, Dr. Andrew asked him how many distinct strings are there. Misha spent almost the entire lesson doing that and completed the task. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he asks you to write a program that would do this task automatically."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase English letters. The second line contains the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lengths of both string do not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of distinct strings that are concatenations of some non-empty prefix of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with some non-empty prefix of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aba\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aaaaa\naaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" has three non-empty prefixes: {"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"}. The string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" has two non-empty prefixes: {"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"}. In total, Misha has written five distinct strings: {"},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"abaaa"}],"kind":"container"},{"kind":"text","text":"}. The string "},{"children":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":" has been written twice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, Misha has written eight distinct strings: {"},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"te