{"assets":["/statement-assets/5153ec0d23b1653d3d6abb9bbff3c8d82aadf6827cdeb81cb713d875ac08d856.png"],"contentKind":"statement","contestId":"916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Jamie and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"To your surprise, Jamie is the final boss! Ehehehe."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jamie has given you a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Initially, the root of the tree is the vertex with number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Also, each vertex has a value on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jamie also gives you three types of queries on the tree:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 v"},{"kind":"text","text":" — Change the tree's root to vertex with number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 u v x"},{"kind":"text","text":" — For each vertex in the subtree of smallest size that contains "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", add "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to its value."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"3 v"},{"kind":"text","text":" — Find sum of values of vertices in the subtree of vertex with number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subtree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is a set of vertices such that "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" lies on shortest path from this vertex to root of the tree. Pay attention that subtree of a vertex can change after changing the tree's root."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Show your strength in programming to Jamie by performing the queries accurately!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 1 ≤ q ≤ 105"},{"kind":"text","text":") — the number of vertices in the tree and the number of queries to process respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 108 ≤ ai ≤ 108"},{"kind":"text","text":") — initial values of the vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ui, vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") describing edge between vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each query has one of following formats depending on its type:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":") for queries of the first type."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 u v x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n,  - 108 ≤ x ≤ 108"},{"kind":"text","text":") for queries of the second type."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"3 v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":") for queries of the third type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers in queries' descriptions are integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The queries must be carried out in the given order. It is guaranteed that the tree is valid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the third type, output the required answer. It is guaranteed that at least one query of the third type is given by Jamie."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 7\n1 4 2 8 5 7\n1 2\n3 1\n4 3\n4 5\n3 6\n3 1\n2 4 6 3\n3 4\n1 6\n2 2 4 -5\n1 4\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27\n19\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n4 3 5 6\n1 2\n2 3\n3 4\n3 1\n1 3\n2 2 4 3\n1 1\n2 2 4 -3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following picture shows how the tree varies after the queries in the first sample. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5153ec0d23b1653d3d6abb9bbff3c8d82aadf6827cdeb81cb713d875ac08d856.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"916E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/916/problem/E"}