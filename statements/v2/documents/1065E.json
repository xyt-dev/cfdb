{"assets":[],"contentKind":"statement","contestId":"1065","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Side Transmutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider some set of distinct characters $$$A$$$ and some string $$$S$$$, consisting of exactly $$$n$$$ characters, where each character is present in $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array of $$$m$$$ integers $$$b$$$ ($$$b_1 \\lt b_2 \\lt \\dots \\lt b_m$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are allowed to perform the following move on the string $$$S$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose some valid $$$i$$$ and set $$$k = b_i$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take the first $$$k$$$ characters of $$$S = Pr_k$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take the last $$$k$$$ characters of $$$S = Su_k$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Substitute the first $$$k$$$ characters of $$$S$$$ with the reversed $$$Su_k$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Substitute the last $$$k$$$ characters of $$$S$$$ with the reversed $$$Pr_k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, let's take a look at $$$S =$$$ \""},{"children":[{"kind":"text","text":"abcdefghi"}],"kind":"container"},{"kind":"text","text":"\" and $$$k = 2$$$. $$$Pr_2 =$$$ \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", $$$Su_2 =$$$ \""},{"children":[{"kind":"text","text":"hi"}],"kind":"container"},{"kind":"text","text":"\". Reversed $$$Pr_2 =$$$ \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", $$$Su_2 =$$$ \""},{"children":[{"kind":"text","text":"ih"}],"kind":"container"},{"kind":"text","text":"\". Thus, the resulting $$$S$$$ is \""},{"children":[{"children":[{"kind":"text","text":"ih"}],"kind":"container"},{"kind":"text","text":"cdefg"},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The move can be performed arbitrary number of times (possibly zero). Any $$$i$$$ can be selected multiple times over these moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some strings $$$S$$$ and $$$T$$$ equal if and only if there exists such a sequence of moves to transmute string $$$S$$$ to string $$$T$$$. For the above example strings \""},{"children":[{"kind":"text","text":"abcdefghi"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ihcdefgba"}],"kind":"container"},{"kind":"text","text":"\" are equal. Also note that this implies $$$S = S$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The task is simple. Count the number of distinct strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer can be huge enough, so calculate it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$ and $$$|A|$$$ ($$$2 \\le n \\le 10^9$$$, $$$1 \\le m \\le min(\\frac n 2, 2 \\cdot 10^5)$$$, $$$1 \\le |A| \\le 10^9$$$) — the length of the strings, the size of the array $$$b$$$ and the size of the set $$$A$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$m$$$ integers $$$b_1, b_2, \\dots, b_m$$$ ($$$1 \\le b_i \\le \\frac n 2$$$, $$$b_1 \\lt b_2 \\lt \\dots \\lt b_m$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of distinct strings of length $$$n$$$ with characters from set $$$A$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 2 26\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"150352234\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12 3 1\n2 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are all the distinct strings for the first example. The chosen letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' are there just to show that the characters in $$$A$$$ are different. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"\" = \""},{"children":[{"kind":"text","text":"baa"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\" = \""},{"children":[{"kind":"text","text":"bba"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bab"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bbb"}],"kind":"container"},{"kind":"text","text":"\" "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"106