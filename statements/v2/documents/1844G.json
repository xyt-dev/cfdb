{"assets":["/statement-assets/742dafee5be03c339c418d5c67dc095b97ef0496b436a12b9cb4e1ac4428a7c0.png","/statement-assets/b52c5a1eb809915daf06edca09c6e353e4de92bb86dd622b547faecfd6865b36.png"],"contentKind":"statement","contestId":"1844","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Tree Weights"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ nodes labelled $$$1,2,\\dots,n$$$. The $$$i$$$-th edge connects nodes $$$u_i$$$ and $$$v_i$$$ and has an unknown positive integer weight $$$w_i$$$. To help you figure out these weights, you are also given the distance $$$d_i$$$ between the nodes $$$i$$$ and $$$i+1$$$ for all $$$1 \\le i \\le n-1$$$ (the sum of the weights of the edges on the simple path between the nodes $$$i$$$ and $$$i+1$$$ in the tree)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the weight of each edge. If there are multiple solutions, print any of them. If there are no weights $$$w_i$$$ consistent with the information, print a single integer $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n-1$$$ lines contains two integers $$$u_i$$$ and $$$v_i$$$ ($$$1 \\le u_i,v_i \\le n$$$, $$$u_i \\ne v_i$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains $$$n-1$$$ integers $$$d_1,\\dots,d_{n-1}$$$ ($$$1 \\le d_i \\le 10^{12}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution, print a single integer $$$-1$$$. Otherwise, output $$$n-1$$$ lines containing the weights $$$w_1,\\dots,w_{n-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n1 3\n2 4\n2 5\n31 41 59 26\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n31\n10\n18\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2\n1 3\n18 18\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n3 1\n4 1\n5 9\n2 6\n5 3\n5 8\n9 7\n9 2\n236 205 72 125 178 216 214 117\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n31\n41\n59\n26\n53\n58\n97\n93\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the tree is as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/742dafee5be03c339c418d5c67dc095b97ef0496b436a12b9cb4e1ac4428a7c0.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, note that $$$w_2$$$ is not allowed to be $$$0$$$ because it must be a positive integer, so there is no solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the tree is as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b52c5a1eb809915daf06edca09c6e353e4de92bb86dd622b547faecfd6865b36.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1844G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1844/problem/G"}