{"assets":["/statement-assets/72de3ebec09f05e06afa04fbd26c1b3a8fe96604424b04573629e3355a0b3887.png","/statement-assets/14c11d8bb3a52e051568ee4fbb8c5f136f9cf7a239c027da187da63e1a6453de.png"],"contentKind":"statement","contestId":"243","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Hydra"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Petya got a birthday present from his mom: a book called \"The Legends and Myths of Graph Theory\". From this book Petya learned about a "},{"children":[{"kind":"text","text":"hydra"}],"kind":"container"},{"kind":"text","text":" graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A non-oriented graph is a "},{"children":[{"kind":"text","text":"hydra"}],"kind":"container"},{"kind":"text","text":", if it has a structure, shown on the figure below. Namely, there are two nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" connected by an edge, they are the hydra's "},{"children":[{"kind":"text","text":"chest"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"stomach"}],"kind":"container"},{"kind":"text","text":", correspondingly. The chest is connected with "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" nodes, which are the hydra's "},{"children":[{"kind":"text","text":"heads"}],"kind":"container"},{"kind":"text","text":". The stomach is connected with "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" nodes, which are the hydra's "},{"children":[{"kind":"text","text":"tails"}],"kind":"container"},{"kind":"text","text":". Note that the hydra is a tree, consisting of "},{"kind":"math_inline","text":"h + t + 2"},{"kind":"text","text":" nodes."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/72de3ebec09f05e06afa04fbd26c1b3a8fe96604424b04573629e3355a0b3887.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Also, Petya's got a non-directed graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. Petya got this graph as a last year birthday present from his mom. Graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" contains no self-loops or multiple edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Petya wants to find a hydra in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". Or else, to make sure that the graph doesn't have a hydra."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ h, t ≤ 100"},{"kind":"text","text":") — the number of nodes and edges in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", and the number of a hydra's heads and tails."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the edges of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":") — the numbers of the nodes, connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" contains no self-loops and multiple edges. Consider the nodes of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" numbered with integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" has no hydra, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes). In the second line print two integers — the numbers of nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". In the third line print "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" numbers — the numbers of the nodes that are the heads. In the fourth line print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" numbers — the numbers of the nodes that are the tails. All printed numbers should be distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 12 2 3\n1 2\n2 3\n1 3\n1 4\n2 5\n4 5\n4 6\n6 5\n6 7\n7 5\n8 7\n9 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n4 1\n5 6 \n9 3 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 10 3 3\n1 2\n2 3\n1 3\n1 4\n2 5\n4 5\n4 6\n6 5\n6 7\n7 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is depicted on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/14c11d8bb3a52e051568ee4fbb8c5f136f9cf7a239c027da187da63e1a6453de.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"243B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/243/problem/B"}