{"assets":[],"contentKind":"statement","contestId":"911","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Stack Sorting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's suppose you have an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", a stack "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" (initially empty) and an array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" (also initially empty)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may perform the following operations until both "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are empty:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Take the first element of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", push it into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and remove it from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" (if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is not empty); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take the top element from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", append it to the end of array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and remove it from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" (if "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is not empty). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can perform these operations in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exists a way to perform the operations such that array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is sorted in non-descending order in the end, then array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"[3, 1, 2]"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":", because "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" will be sorted if we perform the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and push it into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and push it into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and append it to the end of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and push it into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and append it to the end of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and append it to the end of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After all these operations "},{"kind":"math_inline","text":"b = [1, 2, 3]"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"[3, 1, 2]"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":". "},{"kind":"math_inline","text":"[2, 3, 1]"},{"kind":"text","text":" is not "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" first elements of some permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (recall that a permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an array of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" where each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs exactly once). You have to restore the remaining "},{"kind":"math_inline","text":"n - k"},{"kind":"text","text":" elements of this permutation so it is "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":". If there are multiple answers, choose the answer such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is lexicographically maximal (an array "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is lexicographically greater than an array "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" iff there exists some integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that for every "},{"kind":"math_inline","text":"i < k"},{"kind":"math_inline","text":"qi = pi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"qk > pk"},{"kind":"text","text":"). "},{"children":[{"kind":"text","text":"You may not swap or change any of first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of the permutation"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the lexicographically maximal permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" you can obtain."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exists no answer then output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k < n"},{"kind":"text","text":") — the size of a desired permutation, and the number of elements you are given, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". These integers are pairwise distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to restore a "},{"children":[{"kind":"text","text":"stack-sortable"}],"kind":"container"},{"kind":"text","text":" permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such that the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" are equal to elements given in the input, print lexicographically maximal such permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1 5 4 "}],"kind":"section"}]