{"assets":["/statement-assets/653d2e89052b816825ab58846bae2351974bb3b3f1701988c994fc22db99feb5.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"],"contentKind":"statement","contestId":"912","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year's Eve"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Since Grisha behaved well last year, at New Year's Eve he was visited by Ded Moroz who brought an enormous bag of gifts with him! The bag contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sweet candies from "},{"children":[{"kind":"text","text":"the good ol' bakery"}],"kind":"container"},{"kind":"text","text":", each labeled from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" corresponding to its tastiness. No two candies have the same tastiness."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The choice of candies has a direct effect on Grisha's happiness. One can assume that he should take the tastiest ones — but no, the holiday magic turns things upside down. It is the xor-sum of tastinesses that matters, not the ordinary sum!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A xor-sum of a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" is defined as the bitwise XOR of all its elements: "},{"attrs":{"alt":"","src":"/statement-assets/653d2e89052b816825ab58846bae2351974bb3b3f1701988c994fc22db99feb5.png"},"kind":"image"},{"kind":"text","text":", here "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" denotes the bitwise XOR operation; more about bitwise XOR can be found "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"here."}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ded Moroz warned Grisha he has more houses to visit, so Grisha can take "},{"children":[{"kind":"text","text":"no more than "},{"kind":"math_inline","text":"k"}],"kind":"container"},{"kind":"text","text":" candies from the bag. Help Grisha determine the largest xor-sum (largest xor-sum means maximum happiness!) he can obtain."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The sole string contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — the largest possible xor-sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, one optimal answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", giving the xor-sum of "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, one can, for example, take all six candies and obtain the xor-sum of "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"912B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/912/problem/B"}