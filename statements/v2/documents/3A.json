{"assets":["/statement-assets/cd7ebcfc8687d4f8ed2562bf352de017ecd0bc2149d845feb054f2d20000da3d.png"],"contentKind":"statement","contestId":"3","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Shortest path of the king"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The king is left alone on the chessboard. In spite of this loneliness, he doesn't lose heart, because he has business of national importance. For example, he has to pay an official visit to square "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". As the king is not in habit of wasting his time, he wants to get from his current position "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to square "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the least number of moves. Help him to do this."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cd7ebcfc8687d4f8ed2562bf352de017ecd0bc2149d845feb054f2d20000da3d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In one move the king can get to the square that has a common side or a common vertex with the square the king is currently in (generally there are 8 different squares he can move to)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the chessboard coordinates of square "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", the second line — of square "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Chessboard coordinates consist of two characters, the first one is a lowercase Latin letter (from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"), the second one is a digit from "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — minimum number of the king's moves. Then in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the moves themselves. Each move is described with one of the 8: "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"LU"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"LD"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"RU"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"RD"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" stand respectively for moves left, right, up and down (according to the picture), and 2-letter combinations stand for diagonal moves. If the answer is not unique, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"a8\nh1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\nRD\nRD\nRD\nRD\nRD\nRD\nRD\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"3A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/3/problem/A"}