{"assets":["/statement-assets/6a37d3dc8a49ca0e9a9dc567353991fd7e4ba5b6addd2895dddcc2739bca8c2f.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png","/statement-assets/2e04b15a39c9b6fd9706749f53c3198710874531c5d4536b0c839ed38d2702c3.png","/statement-assets/94268069b92447c65d43347196eb9144efc2de9204a0687a2bf4f83bdf8a3249.png","/statement-assets/f1be52745ba73902d4ae90609e68dee04e8c2ce150359c723ee5a1b7a8d0e6af.png","/statement-assets/4f705a560543e34c4afb8e5b20213fcf020f2bf0a4e3107f8952676bffdf0726.png"],"contentKind":"statement","contestId":"742","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Arpa’s obvious problem and Mehrdad’s terrible solution"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"There are some beautiful girls in Arpa’s land as mentioned before."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once Arpa came up with an obvious problem:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given an array and a number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", count the number of pairs of indices "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":") such that "},{"attrs":{"alt":"","src":"/statement-assets/6a37d3dc8a49ca0e9a9dc567353991fd7e4ba5b6addd2895dddcc2739bca8c2f.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" is bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation (see notes for explanation)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2e04b15a39c9b6fd9706749f53c3198710874531c5d4536b0c839ed38d2702c3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Immediately, Mehrdad discovered a terrible solution that nobody trusted. Now Arpa needs your help to implement the solution to that problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 0 ≤ x ≤ 105"},{"kind":"text","text":") — the number of elements in the array and the integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":") — the elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer: the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n5 1 2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there is only one pair of "},{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j = 2"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/statement-assets/94268069b92447c65d43347196eb9144efc2de9204a0687a2bf4f83bdf8a3249.png"},"kind":"image"},{"kind":"text","text":" so the answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the only two pairs are "},{"kind":"math_inline","text":"i = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j = 4"},{"kind":"text","text":" (since "},{"attrs":{"alt":"","src":"/statement-assets/f1be52745ba73902d4ae90609e68dee04e8c2ce150359c723ee5a1b7a8d0e6af.png"},"kind":"image"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j = 5"},{"kind":"text","text":" (since "},{"attrs":{"alt":"","src":"/statement-assets/4f705a560543e34c4afb8e5b20213fcf020f2bf0a4e3107f8952676bffdf0726.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" takes two bit integers of equal length and performs the logical "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation on each pair of corresponding bits. The result in each position is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if only the first bit is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or only the second bit is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", but will be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if both are "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or both are "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". You can read more about bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation here: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"742B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/742/problem/B"}