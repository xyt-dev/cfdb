{"assets":[],"contentKind":"statement","contestId":"755","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. PolandBall and White-Red graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"PolandBall has an undirected simple graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Unfortunately, it has no edges. The graph is very sad because of that. PolandBall wanted to make it happier, adding some red edges. Then, he will add white edges in every remaining place. Therefore, the final graph will be a clique in two colors: white and red. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Colorfulness of the graph is a value "},{"kind":"math_inline","text":"min(dr, dw)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"dr"},{"kind":"text","text":" is the diameter of the red subgraph and "},{"kind":"math_inline","text":"dw"},{"kind":"text","text":" is the diameter of white subgraph. The diameter of a graph is a largest value "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" such that shortest path between some pair of vertices in it is equal to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". If the graph is not connected, we consider its diameter to be "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"PolandBall wants the final graph to be as neat as possible. He wants the final colorfulness to be equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Can you help him and find any graph which satisfies PolandBall's requests?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only one input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":"), representing graph's size and sought colorfulness."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to find a suitable graph, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, you can output any graph which fulfills PolandBall's requirements. First, output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of red edges in your graph. Then, you should output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each containing two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") which means that there is an undirected red edge between vertices "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Every red edge should be printed exactly once, you can print the edges and the vertices of every edge in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Remember that PolandBall's graph should remain simple, so no loops or multiple edges are allowed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n3 4\n4 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, no graph can fulfill PolandBall's requirements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, red graph is a path from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Its diameter is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". However, white graph has diameter "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", because it consists of edges "},{"children":[{"kind":"text","text":"1-3"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1-4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1-5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2-4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2-5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"3-5"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"755E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/755/problem/E"}