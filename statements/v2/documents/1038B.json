{"assets":[],"contentKind":"statement","contestId":"1038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Non-Coprime Partition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Find out if it is possible to partition the first $$$n$$$ positive integers into two "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" disjoint sets $$$S_1$$$ and $$$S_2$$$ such that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\mathrm{gcd}(\\mathrm{sum}(S_1), \\mathrm{sum}(S_2)) \\gt 1$$$ "}],"kind":"container"},{"children":[{"kind":"text","text":"Here $$$\\mathrm{sum}(S)$$$ denotes the sum of all elements present in set $$$S$$$ and $$$\\mathrm{gcd}$$$ means the"},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every integer number from $$$1$$$ to $$$n$$$ should be present in "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of $$$S_1$$$ or $$$S_2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a single integer $$$n$$$ ($$$1 \\le n \\le 45\\,000$$$)"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If such partition doesn't exist, print \"No\" (quotes for clarity)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \"Yes\" (quotes for clarity), followed by two lines, describing $$$S_1$$$ and $$$S_2$$$ respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each set description starts with the set size, followed by the elements of the set in any order. Each set must be non-empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible partitions — print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n1 2\n2 1 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there is no way to partition a single number into two non-empty sets, hence the answer is \"No\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the sums of the sets are $$$2$$$ and $$$4$$$ respectively. The $$$\\mathrm{gcd}(2, 4) = 2 \\gt 1$$$, hence that is one of the possible answers."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1038B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1038/problem/B"}