{"assets":[],"contentKind":"statement","contestId":"580","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Kefa and Dishes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When Kefa came to the restaurant and sat at a table, the waiter immediately brought him the menu. There were "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" dishes. Kefa knows that he needs exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" dishes. But at that, he doesn't want to order the same dish twice to taste as many dishes as possible. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kefa knows that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th dish gives him "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" units of satisfaction. But some dishes do not go well together and some dishes go very well together. Kefa set to himself "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" rules of eating food of the following type — if he eats dish "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" exactly before dish "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" (there should be no other dishes between "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), then his satisfaction level raises by "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, our parrot wants to get some maximal possible satisfaction from going to the restaurant. Help him in this hard task!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three space-separated numbers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 18"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n * (n - 1)"},{"kind":"text","text":") — the number of dishes on the menu, the number of portions Kefa needs to eat to get full and the number of eating rules."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — the satisfaction he gets from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th dish."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the rules. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rule is described by the three numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ci ≤ 109"},{"kind":"text","text":"). That means that if you eat dish "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" right before dish "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", then the Kefa's satisfaction increases by "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". It is guaranteed that there are no such pairs of indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < j ≤ k"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"xi = xj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi = yj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line of the output print the maximum satisfaction that Kefa can get from going to the restaurant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n1 1\n2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n1 2 3 4\n2 1 5\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is best to first eat the second dish, then the first one. Then we get one unit of satisfaction for each dish and plus one more for the rule."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test the fitting sequences of choice are 4 2 1 or 2 1 4. In both cases we get satisfaction 7 for dishes and also, if we fulfill rule 1, we get an additional satisfaction 5."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"580D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/580/problem/D"}