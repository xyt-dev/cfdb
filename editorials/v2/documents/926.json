],"kind":"emphasis"},{"kind":"text","text":"] и к ответу не нужно ничего прибавлять. Иначе, в какой-то из дней между "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - 1 баланс стал отрицательным и после этого только убывал, поэтому к ответу нужно прибавить "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", так как первые "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" дней баланс был положительным."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"После обработки этого события, нужно пересчитать значение "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":". Со счета за эти дни убыло ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":")·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" рублей, а прибыло "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] рублей. После этого "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" нужно присвоить значению "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] и перейти к следующему событию поступления денег на счет. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"926G"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/926/problem/G"},"children":[{"kind":"text","text":"926G - Большие букеты"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Выгодно делать букеты двумя способами: букет из одного нечетного и одного четного букетов; букет из трех нечетных букетов."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Посчитаем "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":" — сколько было четных букетов и "},{"children":[{"kind":"text","text":"o"}],"kind":"emphasis"},{"kind":"text","text":" — сколько было нечетных букетов. Сначала по максимуму соберем букеты первого типа (из одного нечетного и одного четного). Эта величина равна "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"o"}],"kind":"emphasis"},{"kind":"text","text":"). Затем вычтем из "},{"children":[{"kind":"text","text":"o"}],"kind":"emphasis"},{"kind":"text","text":" значение "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":". Если после этого "},{"children":[{"kind":"text","text":"o"}],"kind":"emphasis"},{"kind":"text","text":" больше нуля (то есть еще остались нечетные букеты) — соберем из них максимальное количество букетов из трех нечетных. Это количество равно "},{"children":[{"kind":"text","text":"o"}],"kind":"emphasis"},{"kind":"text","text":" / 3. Эту величину и нужно прибавить к ответу."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"926H"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/926/problem/H"},"children":[{"kind":"text","text":"926H - Такие разные розы"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Мы можем собирать букеты двух типов. В букете первого типа будет хотя бы одна оранжевая роза, хотя бы одна красная роза, и не будет ни одной белой розы. В букете второго типа будет хотя бы одна оранжевая роза, хотя бы одна белая роза, и не будет ни одной красной розы."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Найдем ответы для каждого из типов, а затем выберем из них максимум. Для обоих типов задача решается одинаково."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Покажем решение для букета первого типа. Если "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1, то ответ 0. В противном случае, положим красоты всех оранжевых роз в вектор "},{"children":[{"kind":"text","text":"bO"}],"kind":"emphasis"},{"kind":"text","text":", а красоты всех красных роз в вектор "},{"children":[{"kind":"text","text":"bR"}],"kind":"emphasis"},{"kind":"text","text":". Отсортируем их по убыванию. Теперь нам нужно обязательно взять самую красивую оранжевую и самую красивую красную розу в букет. После этого нужно взять еще "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 2 самых красивых розы из оставшихся. Это можно сделать за один проход по векторам "},{"children":[{"kind":"text","text":"bO"}],"kind":"emphasis"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"bR"}],"kind":"emphasis"},{"kind":"text","text":" с помощью двух указателей на самые красивые еще не взятые розы в каждом векторе."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Для букетов второго типа задача решается аналогично."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"926I"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/926/problem/I"},"children":[{"kind":"text","text":"926I - A Vital Problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Переведем все данные времена в минуты и положим в вектор "},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"kind":"text","text":". Если текущее время — "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" часов и "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" минут, то положим в вектор величину ("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":"·60 + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"После этого отсортируем вектор "},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"kind":"text","text":". Теперь осталось добавить самый ранний будильник, который прозвенит в следующий день. Поэтому добавим в "},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"kind":"text","text":" величину ("},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" + 24·60)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ответом на задачу является максимальное значение ("},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1] - "},{"children":[{"kind":"text","text":"times"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - 1) для всех "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" от 0 до "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1, включительно."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"926J"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/926/problem/J"},"children":[{"kind":"text","text":"926J - Отрезки"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Заведем set пар "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":", в котором будем хранить все компоненты из отрезков. Каждая компонента характеризуется самым левым концом отрезка, который в нее входит, и самым правым отрезком, который в нее входит."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Теперь будем обрабатывать отрезки в порядке их добавления. Пусть текущий отрезок задается парой ("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"). Тогда нужно найти в set все компоненты отрезков, с которыми он пересекается. Для этого найдем в "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":" с помощью "},{"children":[{"kind":"text","text":"lower"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"bound"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"make"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"pair"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":",  - 1)) итератор "},{"children":[{"kind":"text","text":"it"}],"kind":"emphasis"},{"kind":"text","text":", указывающий на компоненту с минимальной левой границей, которая может пересекаться с текущим отрезком. Если "},{"children":[{"kind":"text","text":"it"}],"kind":"emphasis"},{"kind":"text","text":" не равен началу "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":" уменьшим его на единицу, так как могла быть компонента, которая началась левее "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", но пересекается с текущим отрезком. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Теперь будем увеличивать "},{"children":[{"kind":"text","text":"it"}],"kind":"emphasis"},{"kind":"text","text":" до тех пор, пока он не стал равен "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":"."},{"children":[{"kind":"text","text":"end"}],"kind":"emphasis"},{"kind":"text","text":"() или пока мы не встретили хотя бы две непересекающиеся с текущим отрезков компоненты. Будем складывать все компоненты, с которыми пересекается текущий отрезок, в вектор "},{"children":[{"kind":"text","text":"inter"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"После окочания прохода по "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":" нужно удалить из "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":" все компоненты, которые попали в вектор "},{"children":[{"kind":"text","text":"inter"}],"kind":"emphasis"},{"kind":"text","text":" (так как текущий отрезок объединил их все в одну), и добавить в "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":" новую компоненту, чья левая граница — минимум из всех левых границ из вектора "},{"children":[{"kind":"text","text":"inter"}],"kind":"emphasis"},{"kind":"text","text":" и левой границы текущего отрезка "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", а правая граница — максимум из всех правых границ из вектор "},{"children":[{"kind":"text","text":"inter"}],"kind":"emphasis"},{"kind":"text","text":" и правой границы текущего отрезка "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"После обработки очередного отрезка нужно выводить размер "},{"children":[{"kind":"text","text":"comp"}],"kind":"emphasis"},{"kind":"text","text":", так как это и есть искомое количество компонент из черных отрезков. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/58424"}