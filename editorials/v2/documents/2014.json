"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Lets sort A, now average should be more than 2*Ak"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"Lets say pot has X gold."},{"kind":"line_break"},{"kind":"text","text":"Let S be the total gold. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$2*Ak \\lt (S+X)/N$$$"},{"kind":"line_break"},{"kind":"text","text":"$$$2*N*Ak \\lt S+X$$$"},{"kind":"line_break"},{"kind":"text","text":"$$$2*N*Ak-S \\lt X$$$"},{"kind":"line_break"},{"kind":"text","text":"$$$2*N*Ak-S+1 \\le X$$$ "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So X should be max(0,2*N*ak-S+1) "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282243282"},"children":[{"kind":"text","text":"282243282"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2014/problem/D"},"children":[{"kind":"text","text":"2014D - Robert Hood and Mrs Hood"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"For each starting day lets find how many jobs it overlaps with."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"attrs":{"href":"https://usaco.guide/silver/two-pointers"},"children":[{"kind":"text","text":"Two Pointers"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282252869"},"children":[{"kind":"text","text":"282252869"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2014/problem/E"},"children":[{"kind":"text","text":"2014E - Rendez-vous de Marian et Robin"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"children":[{"kind":"text","text":"In addition, h of the n vertices each has a single horse available."}],"kind":"paragraph"}],"kind":"blockquote"},{"children":[{"kind":"text","text":"Just forget this condition exists, and assume each place contains unlimited horses."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Now for each place try to find the minimum time, if we reach there using a horse, and without a horse."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Try to solve above problem using a modified version of "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Dijkstra%27s_algorithm"},"children":[{"kind":"text","text":"Dijkstra's algorithm"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"At last fix a meeting point, and take maximum of minimum time each person takes to reach there with or without horse."}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282288329"},"children":[{"kind":"text","text":"282288329"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2014/problem/F"},"children":[{"kind":"text","text":"2014F - Sheriff's Defense"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"attrs":{"href":"https://usaco.guide/gold/dp-trees"},"children":[{"kind":"text","text":"DP on trees"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"For each subtree dp1[u] denotes the best possible sum we can get if we consider only subtree of u and u is destroyed."},{"kind":"line_break"},{"kind":"text","text":"For each subtree dp2[u] denotes the best possible sum we can get if we consider only subtree of u and u is not destroyed. "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282298489"},"children":[{"kind":"text","text":"282298489"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2014/problem/G"},"children":[{"kind":"text","text":"2014G - Milky Days"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Lets first process each day one by one."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"We should maintain list of all drinkable milks in a map."},{"kind":"line_break"},{"kind":"text","text":"We should remove all non drinkable milk."},{"kind":"line_break"},{"kind":"text","text":"We should add all the new milk we have got today. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Now split into 2 cases — "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Latest milk quantity is less than m."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Latest milk quantity is atleast m,"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"For case 1, when latest milk quantity is less than m,"},{"kind":"line_break"},{"kind":"text","text":"We should bruteforce by taking latest milk and until we have total m, or no milk remains. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then increase time by 1."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 5"}]},"children":[{"children":[{"kind":"text","text":"For case 2, when latest milk quantity is atleast m,"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here, lets try to find how long can we drink current milk. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can drink it until — "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Some other milk comes"}],"kind":"list_item"},{"children":[{"kind":"text","text":"If current quantity is C, then we can drink it for next C/m days"}],"kind":"list_item"},{"children":[{"kind":"text","text":"If this milk came on dj day, we can drink it until dj+k-1 day"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Take minimum of these 3, and assume we have gotten m milk each day."},{"kind":"line_break"},{"kind":"text","text":"Then remove this quantity from latest milk, and increase time. "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282316286"},"children":[{"kind":"text","text":"282316286"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2014/problem/H"},"children":[{"kind":"text","text":"2014H - Robin Hood Archery"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Lets say we are playing game on targets B1,B2,B3,...,Bm"},{"kind":"line_break"},{"kind":"text","text":"What is the optimal strategy for players?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Players should always chose the maximum target."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Lets sort B in descending order."},{"kind":"line_break"},{"kind":"text","text":"Then Robin takes B1,B3,B5... and Sheriff will take B2,B4,...."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"Because B1 \\ge B2, B3 \\ge B4, and so on..."},{"kind":"line_break"},{"kind":"text","text":"At this point, Sheriff can never win."},{"kind":"line_break"},{"kind":"text","text":"When can we have a draw? "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 5"}]},"children":[{"children":[{"kind":"text","text":"We will have a draw if and only if no of targets is even, and B1 = B2, B3 = B4, and so on... "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 6"}]},"children":[{"children":[{"kind":"text","text":"In other words, frequency of every no in B should be even. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 7"}]},"children":[{"children":[{"kind":"text","text":"How to check if frequency of every no is even?"},{"kind":"line_break"},{"attrs":{"href":"https://codeforces.com/blog/entry/85900"},"children":[{"kind":"text","text":"Zobrist Hashing"}],"kind":"link"},{"kind":"text","text":" "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/2014/submission/282302515"},"children":[{"kind":"text","text":"282302515"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Chat QnA"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/134210"}