and for each weight "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"newDp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"newDp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"oldDp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":"."},{"children":[{"kind":"text","text":"weight"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":"."},{"children":[{"kind":"text","text":"value"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Run dfs and find groups at first. The problem is same with above problem, each group is some set in above problem, just add the whole group as an item to the set that related to this group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/ec8e554292d8620012089ef4bbd60bedda2442db12843d16993fe950874ac83f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"741C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/741/problem/C"},"children":[{"kind":"text","text":"741C - Arpa’s overnight party and Mehrdad’s silent entering"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Build a graph and put an edge between each 2·"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", 2·"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and each BF and GF. This graph doesn’t have cycles with odd length. So it is a bipartite graph. Now give Kooft to some part and Zahre-mar to other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"741D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/741/problem/D"},"children":[{"kind":"text","text":"741D - Arpa’s letter-marked tree and Mehrdad’s Dokhtar-kosh paths"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Please read "},{"attrs":{"href":"https://codeforces.com/blog/entry/44351"},"children":[{"kind":"text","text":"my dsu on tree (sack) tutorial"}],"kind":"link"},{"kind":"text","text":" before you read."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s calculate for each vertex such "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", length of longest Dokhtar-kosh path that starts in some vertex of subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", passes from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", and ends in some other vertex of subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" using sack (explained below); then we can sum up this values and get answer for each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","te