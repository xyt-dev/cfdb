dren":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"915E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/915/problem/E"},"children":[{"kind":"text","text":"915E - Physical Education Lessons"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's store current intervals with non-working days in set sorted by the right border. When new query comes you search for the first interval to have its right border greater or equal than the currect left border and update all intervals to intersect the query (either fully delete or insert back its part which doesn't intersect query). Finally, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1 then insert the query into current set. Updates on the number of working days can be done while deleting segments on the fly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c266698f19916d8c020066c8b6b61b15ad45febfffcb5e7f826fe98d4b7de956.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"915F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/915/problem/F"},"children":[{"kind":"text","text":"915F - Imbalance Value of a Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's calculate the answer as the difference between sum of maxima and sum of minima over all paths. These sums can be found by the following approach:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the sum of maxima. Let's sort all vertices in ascending order of values of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (if two vertices have equal values, their order doesn't matter). This order has an important property that we can use: for every path, the maximum on this path is written on the vertex that has the greatest position in sorted order. This allows us to do the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote as "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") a tree, rooted at vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", that is formed by the set of such vertices "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" that are directly connected to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" or some other vertex from the set, and have "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Consider the vertices that are connected to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in this tree. Let's denote them as "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (the order doesn't matter), and denote by "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the size of the subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in the tree "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). Let's try to calculate the number of paths going through "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in this tree:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"attrs":{"alt":"","src":"/editorial-assets/65d5153ee187b9ec990826897e72765d4676850e011523320b3bc7ad241eaf3e.png"},"kind":"image"},{"kind":"text","text":" paths that have "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" as its endpoint; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/2d9f6c4c31154231e7e2a1c7bec188749274513c651ae27778dd9a582460ccd4.png"},"kind":"image"},{"kind":"text","text":" paths (connecting a vertex from subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to a vertex from subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" adds the sum of these values, multiplied by "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", to the sum of maxima. To calculate these sums, we will use the following algorithm:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initialize a DSU (disjoint set union), making a set for each vertex. Process the vertices in sorted order. When we process some vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", find all its already processed neighbours (they will be "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":")). For every neighbour "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", denote the size of its set in DSU as "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then calculate the number of paths going through "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" using aforementioned formulas (to do it in linear time, use partial sums). Add this number, multiplied by "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", to the sum of maxima, and merge "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in DSU."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To calculate the sum of minima, you can do the same while processing vertices in reversed order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity of this solution is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"915G"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/915/problem/G"},"children":[{"kind":"text","text":"915G - Coprime Arrays"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"For a fixed upper bound "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", this is a well-known problem that can be solved using inclusion-exclusion:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote by "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") the number of arrays with elements in range [1, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] such that "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") is divisible by "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Obviously, "},{"attrs":{"alt":"","src":"/editorial-assets/bdbad41fe959221ebc64553296e46f29f6178e7cf56edf051d83802db7a4224f.png"},"kind":"image"},{"kind":"text","text":". With the help of inclusion-exclusion formula we can prove that the number of arrays with "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":" = 1 is the sum of the following values over all possible sets "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":": ( - 1)"},{"children":[{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"|"}],"kind":"superscript"},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is some set of prime numbers (possibly an empty set), and "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":") is the product of all elements in the set. "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":")) in this formula denotes the number of arrays such that their "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":" is divisible by every number from set "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, the number of such sets "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is infinite, so we need to use the fact that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") = 0 if "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". With the help of this fact, we can rewrite the sum over every set "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" in such a way: "},{"attrs":{"alt":"","src":"/editorial-assets/3989ea151f698e1a8880540f08ade818007b641f78b854ad742494aba924d953.png"},"kind":"image"},{"kind":"text","text":", where μ ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") is 0 if there is no any set of prime numbers "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", |μ ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":")| = 1 if this set "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" exists, and the sign is determined by the size of "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" (μ ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") = 1 if |"},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"| is even, otherwise μ ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") =  - 1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An easier way to denote and calculate μ ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") is the following (by the way, it is called Möbius function):"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"μ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") = 0, if there is some prime number p such that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Otherwise μ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") = ( - 1)"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is the number of primes in the factorization of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Okay, so we found a solution for one upper bound "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", it's "},{"attrs":{"alt":"","src":"/editorial-assets/3989ea151f698e1a8880540f08ade818007b641f78b854ad742494aba924d953.png"},"kind":"image"},{"kind":"text","text":". How can we calculate it for every "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose we have calculated all values of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") for some "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 and we want to recalculate them for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". The important fact is that these values change (and thus need recalculation) only for the numbers "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". So if we recalculate only these values "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") (and each recalculation can be done in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) time if we precompute the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" for every "},{"attrs":{"alt":"","src":"/editorial-assets/27260a2876b0b77354c677a2adc7098b329b7744c20494a5bed8546832752b7c.png"},"kind":"image"},{"kind":"text","text":"), then we will have to do only "},{"attrs":{"alt":"","src":"/editorial-assets/581906bb76e4cecd7cc6dd18591213e0499d2039105eb5548cb29256bdb165bb.png"},"kind":"image"},{"kind":"text","text":" recalculations overall."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/57123"}