rs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are four cases that should be carefully considered:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 15   —  the answer is always DOWN."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0   —  the answer is always UP."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 1   —  the answer is -1."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" > 1, then if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"–1"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"   —  answer is DOWN, else UP."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/a2041e01572c44473eca912b0924a09a8bfbea569d5ab7e327d083b17d77204d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/719/problem/B"},"children":[{"kind":"text","text":"Div. 2 B — Anatoly and Cockroaches"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can notice that there are only two possible final coloring of cockroaches that satisfy the problem statement: "},{"children":[{"kind":"text","text":"rbrbrb"}],"kind":"emphasis"},{"kind":"text","text":"... or "},{"children":[{"kind":"text","text":"brbrbr"}],"kind":"emphasis"},{"kind":"text","text":"..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s go through both of these variants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the each case let's count the number of red and black cockroaches which are not standing in their places. Let's denote these numbers as "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". Then it is obvious that the "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") pairs of cockroaches need to be swapped and the rest should be repaint."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, the result for a fixed final coloring is exactly "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). The final answer for the problem is the minimum between the answers for the first and the second colorings."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c52394ca7ff0e959107c3520bf3991c587eeaf70496ca2688842aebdd31b8ed2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/718/problem/A"},"children":[{"kind":"text","text":"Div. 1 A — Efim and Strange Grade"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can notice that the closer to the decimal point we round our grade the bigger grade we get. Based on this observation we can easily solve the problem with dynamic programming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the minimum time required to get a carry to the ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1)-th position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote our grade as "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", and let "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":")-th digit of the "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". There are three cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ 5, then "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < 4, then "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"inf"}],"kind":"emphasis"},{"kind":"text","text":" (it means, that we cann't get a carry to the ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1)-th position)."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 4, then "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After computing "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":", we need to find the minimum "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". So, after that we know the position where we should round our grade."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we only need to carefully add 1 to the number formed by the prefix that contains "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" elements of the original grade."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c52394ca7ff0e959107c3520bf3991c587eeaf70496ca2688842aebdd31b8ed2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/718"},"children":[{"kind":"text","text":"Div. 1 B — Alyona and Copiers"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Deleted"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/718/problem/C"},"children":[{"kind":"text","text":"div. 1 C — Sasha and Array"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote "},{"kind":"line_break"},{"attrs":{"alt":" ","src":"/editorial-assets/2ebe49b485d0e4e707f4fb1e095cef114d307efd0df455806d8b3f5567276346.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's recall how we can quickly find "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"-th Fibonacci number. To do this we need to find a matrix product "},{"attrs":{"alt":"","src":"/editorial-assets/cf0ddb39e2318a2b15e923a740bd78d6194e43ee20d411160ec8421da4114c38.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to solve our problem let's create the following segments tree: in each leaf which corresponds to the element "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" we will store a vector "},{"attrs":{"alt":"","src":"/editorial-assets/a6dbc171e33a4b528b9d7ce60ac5546534d0f43d939c999a9229e6572acb059b.png"},"kind":"image"},{"kind":"text","text":" and in all other nodes we will store the sums of all the vectors that correspond to a given segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, to perform the first request we should multiply all the vectors in a segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] by "},{"attrs":{"alt":"","src":"/editorial-assets/d9c44def1ba87861058ee3897b2d224a068b64199c808c1ad691e4e75e0af6e1.png"},"kind":"image"},{"kind":"text","text":" and to get an answer to the second request we have to find a sum in a segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/48220eb165f112257efafba3e106d25c0121b28a0d152a52d7bc772925c7a907.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/718/problem/D"},"children":[{"kind":"text","text":"Div. 1 D — Andrew and Chemistry"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/_XuMuk_"},"children":[{"kind":"text","text":"_XuMuk_"}],"kind":"link"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":" Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/BigBag"},"children":[{"kind":"text","text":"BigBag"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s first figure out how we can solve the problem in "},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":" time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s pick a vertex we’re going to add an edge to and make this vertex the root of the tree. For each vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we’re going to assign a label "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"] (some number). The way we assign labels is the following: if the two given vertices have the same subtrees they’re going to get the same labels, but if the subtrees are different then the labels for these vertices are going to be different as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can do such labeling in a following way: let’s create a "},{"children":[{"kind":"text","text":"map<vector<int>, int> m"}],"kind":"inline_code"},{"kind":"text","text":" (the maximum degree for a vertex is 4, but let’s assume that the length of the vector is always equal to 4). Let "},{"children":[{"kind":"text","text":"m[{x, y, z, w}]"}],"kind":"inline_code"},{"kind":"text","text":" be a label for a vertex which has children with the labels "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":". Let’s note that the vector {"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":"} should be sorted to avoid duplications, also if the number of children is less than 4 then we’ll store  - 1’s for the missing children (to make the length of a vector always equal to 4). Let’s understand how we can compute the value for the label for the vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Let’s recursively compute the labels for its children: "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"s