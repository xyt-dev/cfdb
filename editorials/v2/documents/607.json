{"assets":["/editorial-assets/75a6f2e41b3f9177b480b1f1ce0b5b94308f5802091013088fe6764f6b26956a.png","/editorial-assets/0d0980b96097f84e2645a3d168e17004785f98bcec12240459a9412207e1501f.png","/editorial-assets/77b9f78dd34fe87c33fd355ba768071b913eceea76051a44a776008f0c1b9105.png","/editorial-assets/1cf530f78de5a01947961193c2da472196720a8fa14749066bbc5f8b7c8c58f0.png","/editorial-assets/b2341a77c98f33b797a24003ced55661c935fcb26372e99c5fc7168694b4105c.png","/editorial-assets/0b2c2de1b3214edd0ea039dc29a6a3c262ff9c101cec7a9902461144683e3044.png","/editorial-assets/ff0660a2ba3b2f72691111508681555013778e39440c13f133a7743e16ed254d.png","/editorial-assets/e48366616dfecb29009f447c90bc4f26cc1dc314146cb4b3be1d8e1a3cf3f733.png","/editorial-assets/3a6136af6a189c593b8ee12dbe7aad9a9742d640c3ef56e265a8ef03bafdb551.png","/editorial-assets/55d7bc141701a11c13113ed675402835afa58693296ad8c4fe5dc838a6fe39b5.png","/editorial-assets/28036e98e856731403abac387c0581ed5f20371997997fb8d8fa24ee83151385.png","/editorial-assets/4820554ebfe24a549a4ce072d15da1aca0607eab186a52c5f30485f3bdc5b305.png"],"contestId":"607","diagnostics":[],"document":{"children":[{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/608/problem/A"},"children":[{"kind":"text","text":"608A - Saitama Destroys Hotel"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/ed1d1a8d"},"children":[{"kind":"text","text":"ed1d1a8d"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/HiZd9g"},"children":[{"kind":"text","text":"https://ideone.com/HiZd9g"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The minimum amount of time required is the maximum value of "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", where t_i and f_i are the time and the floor of the passenger respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The initial observation that should be made for this problem is that only the latest passenger on each floor matters. So, we can ignore all passengers that aren't the latest passenger on each floor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, assume there is only a passenger on floor "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Call this passenger "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". The time taken for this passenger is clearly "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (the time taken to wait for the passenger summed to the time taken for the elevator to reach the bottom)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, add in one passenger on a floor lower than "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Call this new passenger "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". There are 2 possibilities for this passenger. Either the elevator reaches the passenger's floor after the passenger's time of arrival or the elevator reaches the passenger's floor before the passenger's time of arrival. For the first case, no time is added to the solution, and the solution remains "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". For the second case, the passenger on floor "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" doesn't matter, and the time taken is "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for the new passenger."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only thing left is to determine whether the elevator reaches the new passenger before "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of the new passenger. It does so if "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Clearly this is equivalent to whether "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Thus, the solution is max of "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A similar line of reasoning can be applied to the rest of the passengers. Thus, the solution is the maximum value of "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/608/problem/B"},"children":[{"kind":"text","text":"608B - Hamming Distance Sum"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/ed1d1a8d"},"children":[{"kind":"text","text":"ed1d1a8d"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/nmGbRe"},"children":[{"kind":"text","text":"https://ideone.com/nmGbRe"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We are trying to find "},{"attrs":{"alt":"","src":"/editorial-assets/75a6f2e41b3f9177b480b1f1ce0b5b94308f5802091013088fe6764f6b26956a.png"},"kind":"image"},{"kind":"text","text":". Swapping the sums, we see that this is equivalent to "},{"attrs":{"alt":"","src":"/editorial-assets/0d0980b96097f84e2645a3d168e17004785f98bcec12240459a9412207e1501f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Summing up the answer in the naive fashion will give an "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") solution. However, notice that we can actually find "},{"attrs":{"alt":"","src":"/editorial-assets/77b9f78dd34fe87c33fd355ba768071b913eceea76051a44a776008f0c1b9105.png"},"kind":"image"},{"kind":"text","text":" without going through each individual character. Rather, all we need is a frequency count of different characters. To obtain this frequency count, we can simply build prefix count arrays of all characters on "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Let's call this prefix count array "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"] gives the number of occurrences of the character "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" in the prefix [0, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". We can then write "},{"attrs":{"alt":"","src":"/editorial-assets/0d0980b96097f84e2645a3d168e17004785f98bcec12240459a9412207e1501f.png"},"kind":"image"},{"kind":"text","text":". as "},{"attrs":{"alt":"","src":"/editorial-assets/1cf530f78de5a01947961193c2da472196720a8fa14749066bbc5f8b7c8c58f0.png"},"kind":"image"},{"kind":"text","text":". This gives us a linear solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"|), Memory Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"|)"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/607/problem/A"},"children":[{"kind":"text","text":"607A - Chain Reaction"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Chilli"},"children":[{"kind":"text","text":"Chilli"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/xOrFhv"},"children":[{"kind":"text","text":"https://ideone.com/xOrFhv"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It turns out that it is actually easier to compute the complement of the problem — the maximum number of objects not destroyed. We can subtract this from the total number of objects to obtain our final answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can solve this problem using dynamic programming. Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] be the maximum number of objects not destroyed in the range [0, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] given that position "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is unaffected by an explosion. We can compute "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] using the following recurrence:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/b2341a77c98f33b797a24003ced55661c935fcb26372e99c5fc7168694b4105c.png"},"kind":"image"},{"children":[{"kind":"text","text":"Now, if we can place an object to the right of all objects with any power level, we can destroy some suffix of the (sorted list of) objects. The answer is thus the maximum number of destroyed objects objects given that we destroy some suffix of the objects first. This can be easily evaluated as"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/0b2c2de1b3214edd0ea039dc29a6a3c262ff9c101cec7a9902461144683e3044.png"},"kind":"image"},{"children":[{"kind":"text","text":"Since this is the complement of our answer, our final answer is actually"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/ff0660a2ba3b2f72691111508681555013778e39440c13f133a7743e16ed254d.png"},"kind":"image"},{"children":[{"kind":"text","text":"Time Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")), Memory Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"))"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/607/problem/B"},"children":[{"kind":"text","text":"607B - Zuma"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Amor727"},"children":[{"kind":"text","text":"Amor727"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/Aw1bSs"},"children":[{"kind":"text","text":"https://ideone.com/Aw1bSs"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We use dp on contiguous ranges to calculate the answer. Let "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] denote the number of seconds it takes to collapse some range ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. Let us work out a transition for this definition. Consider the left-most gemstone. This gemstone will either be destroyed individually or as part of a non-singular range. In the first case, we destroy the left-most gemstone and reduce to the subproblem ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. In the second case, notice that the left-most gemstone will match up with some gemstone to its right. We can iterate through every gemstone with the same color as the left-most (let "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" be the index of this matching gemstone) and reduce to two subproblems ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1] and ["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. We can reduce to the subproblem ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1] because we can just remove gemstones "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" with the last removal of ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1]. We must also make a special case for when the first two elements in a range are equal and consider the subproblem ["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 2, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is a formalization of the dp:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/e48366616dfecb29009f447c90bc4f26cc1dc314146cb4b3be1d8e1a3cf3f733.png"},"kind":"image"},{"children":[{"attrs":{"href":"https://codeforces.com/blog/entry/22256?#comment-268876"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/22256?#comment-268876"}],"kind":"link"},{"kind":"text","text":"Why is this dp correct? Notice that the recursive version of our dp will come across the optimal solution in its search. Moreover, every path in the recursive search tree corresponds to some valid sequence of deletions. Since our dp only searches across valid deletions and will at some point come across the optimal sequence of deletions, the answer it produces will be optimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"), Space Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/607/problem/C"},"children":[{"kind":"text","text":"607C - Marbles"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/ed1d1a8d"},"children":[{"kind":"text","text":"ed1d1a8d"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/giyUNE"},"children":[{"kind":"text","text":"https://ideone.com/giyUNE"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define the reverse of a sequence as the sequence of moves needed to negate the movement. For example, EEE and WWW are reverses, and WWSSSEE and WWNNNEE are reverses. I claim is impossible to get both balls to the end if and only if some suffix of the first sequence is the reverse of a suffix of the second sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us prove the forward case first, that if two suffixes are reverses, then it is impossible to get both balls to the end. Consider a sequence and its reverse, and note that they share the same geometric structure, except that the direction of travel is opposite. Now imagine laying the two grid paths over each other so that their reverse suffixes are laying on top of each other. It becomes apparent that in order to move both balls to their ends, they must cross over at some point within the confines of the suffix. However, this is impossible under the movement rules, as in order for this to happen, the two balls need to move in different directions at a single point in time, which is not allowed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let us prove the backwards case: that if no suffixes are reverses, then it is possible for both balls to reach the end. There is a simple algorithm that achieves this goal, which is to move the first ball to its end, then move the second ball to its end, then move the first ball to its end, and so on. Let's denote each of these \"move the x ball to its end\" one step in the algorithm. After every step, the combined distance of both balls from the start is strictly increasing. Without loss of generality, consider a step where you move the first ball to the end, this increases the distance of the first ball by some value "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". However, the second ball can move back at most "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1 steps (only its a reverse sequence can move back "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" steps), so the minimum change in distance is  + 1. Hence, at some point the combined distance will increase to 2("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) and both balls will be at the end."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to check if suffixes are reverses of each other, we can take reverse the first sequence, and see if one of its prefixes matches a suffix of the second sequence. This can be done using string hashing or KMP in linear time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"), Memory Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/607/problem/D"},"children":[{"kind":"text","text":"607D - Power Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/ed1d1a8d"},"children":[{"kind":"text","text":"ed1d1a8d"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/pObeIV"},"children":[{"kind":"text","text":"https://ideone.com/pObeIV"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's solve a restricted version of the problem where all queries are about the root. First however, let us define some notation. In this editorial, we will use "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") to denote the number of children of vertex "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". If there is an update involved, "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") refers to the value prior to the update."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To deal these queries, notice that each vertex within the tree has some contribution "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to the root "},{"children":[{"kind":"text","text":"power"}],"kind":"emphasis"},{"kind":"text","text":". This contribution is an integer multiple "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of each vertex's value "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", such that "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" If we sum the contributions of every vertex, we get the "},{"children":[{"kind":"text","text":"power"}],"kind":"emphasis"},{"kind":"text","text":" of the root."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To deal with updates, notice that adding a vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to a leaf "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" scales the multiplier of every vertex in "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"'s subtree by a factor of "},{"attrs":{"alt":"","src":"/editorial-assets/3a6136af6a189c593b8ee12dbe7aad9a9742d640c3ef56e265a8ef03bafdb551.png"},"kind":"image"},{"kind":"text","text":". As for the contribution of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", notice that "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, in order to handle both queries and updates efficiently, we need a fast way to sum all contributions, a way to scale contributions in a subtree, and a way to add new vertices. This sounds like a job for ... a segment tree!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We all know segment trees hate insertions, so instead of inserting new vertices, we pre-build the tree with initial values 0, updating values instead of inserting new vertices. In order to efficiently support subtree modification, we construct a segment tree on the preorder walk of the tree, so that every subtree corresponds to a contiguous segment within the segment tree. This segment tree will store the contributions of each vertex and needs to support range-sum-query, range-multiply-update, and point-update (updating a single element). The details of implementing such a segment tree and are left as an exercise to the reader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Armed with this segment tree, queries become a single range-sum. Scaling the contribution in a subtree becomes a range-multiply (we don't need to worry about multiplying un-added vertices because they are set to 0). And adding a new vertex becomes a range-sum-query to retrieve the contribution of the parent, and then a point-set to set the contribution of the added vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, to solve the full version of the problem, notice that the "},{"children":[{"kind":"text","text":"power"}],"kind":"emphasis"},{"kind":"text","text":" of a non-root vertex "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" is a scaled down range sum in the segment tree. The value of the scale is "},{"attrs":{"alt":"","src":"/editorial-assets/55d7bc141701a11c13113ed675402835afa58693296ad8c4fe5dc838a6fe39b5.png"},"kind":"image"},{"kind":"text","text":", the proof of which is left as an exercise to the reader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity — "},{"attrs":{"alt":"","src":"/editorial-assets/28036e98e856731403abac387c0581ed5f20371997997fb8d8fa24ee83151385.png"},"kind":"image"},{"kind":"text","text":", Space Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/607/problem/E"},"children":[{"kind":"text","text":"607E - Cross Sum"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/GlebsHP"},"children":[{"kind":"text","text":"GlebsHP"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://ideone.com/Di8gnU"},"children":[{"kind":"text","text":"https://ideone.com/Di8gnU"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem boils down to summing the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" closest intersections to a given query point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We binary search on the distance "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"th farthest point. For a given distance "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", the number of points within distance "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" of our query point is equivalent to the number of pairwise intersections that lie within a circle of radius "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" centered at our query point. To count the number of intersections, we can find the intersection points of the lines on the circle and sort them. Two lines which intersect will have overlapping intersection points on the circle (i.e. of the form ABAB where As and Bs are the intersection points of two lines). Counting the number of intersections can be done by DP."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once we have "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", we once again draw a circle of size "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" but this time we loop through all points in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") instead of counting the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It may happen that there are "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" intersections inside the circle of radius "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" but also "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":"' > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" inside a circle of radius "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" + ε. In this case, we should calculate the answer for "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" and add "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity — "},{"attrs":{"alt":"","src":"/editorial-assets/4820554ebfe24a549a4ce072d15da1aca0607eab186a52c5f30485f3bdc5b305.png"},"kind":"image"},{"kind":"text","text":", Space Complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/22256"}