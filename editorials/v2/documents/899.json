ext":"sum"}],"kind":"emphasis"},{"kind":"text","text":") / 2."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"899E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/899/problem/E"},"children":[{"kind":"text","text":"899E - Segments Removal"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We will use to set of pairs. In the first set (call it "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":") we will store all segments consisting of the same numbers in a format — the length of the segment multiplied on  - 1 and the position of the beginning of the segment. In the second set (call it "},{"children":[{"kind":"text","text":"segments"}],"kind":"emphasis"},{"kind":"text","text":") we will store all segments consisting of the same numbers in a format — the position of the beginning of the segment and the length of the segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially we will put in the sets all segments from the given array consisting of the same numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that we will repeat the following algorithm until in sets there are non-deleted segments:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" increase answer on 1; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" take from "},{"children":[{"kind":"text","text":"lens"}],"kind":"emphasis"},{"kind":"text","text":" the longest and the leftmost segment (it will be in the beginning of the "},{"children":[{"kind":"text","text":"lens"}],"kind":"emphasis"},{"kind":"text","text":", because we store here all length multiplied on  - 1) and remove it from "},{"children":[{"kind":"text","text":"lens"}],"kind":"emphasis"},{"kind":"text","text":". Let this segment beginning in the position "},{"children":[{"kind":"text","text":"st"}],"kind":"emphasis"},{"kind":"text","text":" and has length "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" with help of "},{"children":[{"kind":"text","text":"lower"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"bound"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we can find in "},{"children":[{"kind":"text","text":"segments"}],"kind":"emphasis"},{"kind":"text","text":" the left and the right segments relatively the segment from the previous article. After that we should remove from the segments the segment ("},{"children":[{"kind":"text","text":"st"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if both left and right relatively of the current longest segment there are non-deleted segments and they consisting of the same numbers, we should to unite them in one segment. To do this, we should remove the left and right segments from "},{"children":[{"kind":"text","text":"lens"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"segments"}],"kind":"emphasis"},{"kind":"text","text":" and put the new merged segment in "},{"children":[{"kind":"text","text":"lens"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"segments"}],"kind":"emphasis"},{"kind":"text","text":" in the described format. "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"899F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/899/problem/F"},"children":[{"kind":"text","text":"899F - Letters Removing"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"For each character "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" we should use set, where we will store positions of all non-deleted characters "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the next query equals to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". Then at first we should transform the given positions "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" to the positions of the initial string, taking into account already deleted characters. We can do it with help of segments tree or sqrt-decomposition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After we transformed "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" we should find the first position in set for character "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" (with help of lower_bound) which is in range ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] and remove positions from the corresponding set until they are in range ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]. Also we need to update information in data structure which we use to transform the given in the query "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" to the positions in the initial string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This algorithm will fit into the time limit, because we will delete each position no more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After we process all queries we should iterate through all sets, find all non-deleted positions and print characters, which are in that positions in the initial string (do not forget before that to sort all non-deleted positions in increasing order)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/56392"}