{"assets":["/editorial-assets/a7c064e19dcb542cf0e3380d2d8988eb9ea8c36bc6c5328bf9af7f42ac1167a9.png","/editorial-assets/12665b4b758700f3024c7c42fb4d66b61517748e97a1464e70acd1b89a822f4f.png","/editorial-assets/fd6e737c175c965416fae14346c6b6b5f4238248e48feaf82eec4f32d150c599.png","/editorial-assets/914c6b56ebe6ab2af80215615902de892de47b012546aee6b4b8664fe909266d.png","/editorial-assets/f34610ae6d004988445de028356e56e77579f8556cc987c76e689395b3ef58e5.png","/editorial-assets/bcaf564017badfec23f4350b8ebbe441e31c58dd0365796633d4b58fc30fd61d.png","/editorial-assets/faf92efc0d7a5a407d5e86d668647c7ef4b9854f54d2de99d3de477e34980d17.png","/editorial-assets/c53c2f38b904d14b407f61577dcbefc0f787ff4520aeae7f5a548d45b3d89f3e.png","/editorial-assets/59cb07a38fa1a2cec39a977981b289cc646f29b4d3694e5bfea544a7d1bf89e3.png","/editorial-assets/9e9dfd8e0903c287c4785957b8d4b261687865c56c8102eb31dd1bb8f429a36c.png"],"contestId":"231","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/231/problem/A"},"children":[{"kind":"text","text":"231A - Team"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is needed just to implement actions described in statement. You had to read data and to calculate number of members of team, which were sure about the solution, for every task. If this number is greater than one, the answer must be increased by one."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/231/problem/B"},"children":[{"kind":"text","text":"231B - Magic, Wizardry and Wonders"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's see, what will be the last number of array after "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" iterations. After the first iteration it will be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (and total number of elements will be decreased by one). After the second iteration the last number will be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". It is not hard to see, that after "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 iterations remain "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"subscript"},{"kind":"text","text":" + ... + ( - 1)"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". In a such way, our task is to put numbers from 1 to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" in array so, that sum of numbers in odd positions minus sum of numbers in even positions will equal to given "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". This means sum of numbers in odd positions must be equal "},{"attrs":{"alt":"","src":"/editorial-assets/a7c064e19dcb542cf0e3380d2d8988eb9ea8c36bc6c5328bf9af7f42ac1167a9.png"},"kind":"image"},{"kind":"text","text":". But the minimal sum can be "},{"attrs":{"alt":"","src":"/editorial-assets/12665b4b758700f3024c7c42fb4d66b61517748e97a1464e70acd1b89a822f4f.png"},"kind":"image"},{"kind":"text","text":", and the maximal — "},{"attrs":{"alt":"","src":"/editorial-assets/fd6e737c175c965416fae14346c6b6b5f4238248e48feaf82eec4f32d150c599.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because of this we should choose "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2·"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" so, that "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" fits the boundaries. Constrains allow to do it in a such manner. Firstly, put ones on the even positions. If "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"maxv"}],"kind":"emphasis"},{"kind":"text","text":" after that, the answer is  - 1. Otherwise, let's increase each "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2·"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by one until "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"minv"}],"kind":"emphasis"},{"kind":"text","text":". If we put "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" in all even positions and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"minv"}],"kind":"emphasis"},{"kind":"text","text":", than answer is  - 1 too. After we put numbers on even positions, let's write 1 in all odd positions, and while sum of this elements is less than "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" increase each one by fitting value."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/231/problem/C"},"children":[{"kind":"text","text":"231C - To Add or Not to Add"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the main observations, needed to solve this problem, is that the second number in answer always coincides with someone "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let's see why it is true. Suppose, the second number of the answer is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" for someone "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". This means, we increased some numbers, which is less than "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", so that they became equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", and then all this numbers and some numbers, which is equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we increased to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". But if we didn't increase all this numbers to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" and remain they equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we'd perform less operations and the answer would be better."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Due to this fact we can solve problem in a such manner. Sort array in non-decreasing order. Iterate over "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and calculate, what is the maximal number of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we can obtain. For maximizing first number of answer, we must increase some lesser numbers to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and perform not greater than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" operations. It is obvious that firstly we should increase such "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is minimal. So, if we can solve problem in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"), we would iterate "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to 0 and increase "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", while we could. But the solution must be faster, and we will use binary search. We will brute the number of numbers, which we must do equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Suppose we fix "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" this value. Now we have to check if we can do "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" numbers equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by not greater than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" operations. For doing this, let’s calculate "},{"attrs":{"alt":"","src":"/editorial-assets/914c6b56ebe6ab2af80215615902de892de47b012546aee6b4b8664fe909266d.png"},"kind":"image"},{"kind":"text","text":". If this value not greater than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", we can do it. For calculating sum quickly, we can save prefix sums and than "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Finally we solved this problem in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/231/problem/D"},"children":[{"kind":"text","text":"231D - Magic Box"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The main subtask of this problem is to check whether we can observe the center of face of parallelepiped from point "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"). Let’s see the case, when the face belongs to plane "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". For performing all calculations in integer numbers, multiply all coordinates "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" by 2. Take the point "},{"attrs":{"alt":"","src":"/editorial-assets/f34610ae6d004988445de028356e56e77579f8556cc987c76e689395b3ef58e5.png"},"kind":"image"},{"kind":"text","text":" and normal to plane, containing the fixed face, which is directed out of interior of parallelepiped, that is "},{"attrs":{"alt":"","src":"/editorial-assets/bcaf564017badfec23f4350b8ebbe441e31c58dd0365796633d4b58fc30fd61d.png"},"kind":"image"},{"kind":"text","text":". Also take vector "},{"attrs":{"alt":"","src":"/editorial-assets/faf92efc0d7a5a407d5e86d668647c7ef4b9854f54d2de99d3de477e34980d17.png"},"kind":"image"},{"kind":"text","text":". If undirected angle between this vectors is less than 90 degrees, we can observe "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":". For checking this we can use scalar product. If scalar product of "},{"attrs":{"alt":"","src":"/editorial-assets/c53c2f38b904d14b407f61577dcbefc0f787ff4520aeae7f5a548d45b3d89f3e.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/59cb07a38fa1a2cec39a977981b289cc646f29b4d3694e5bfea544a7d1bf89e3.png"},"kind":"image"},{"kind":"text","text":" is strictly greater than zero, than that angle is fitting."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/231/problem/E"},"children":[{"kind":"text","text":"231E - Cactus"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you should find the number of simple paths between some pair of vertices in vertex cactus. If you learn the structure of these graphs, it is not hard to see, that if we’ll squeeze each cycle in one vertex, we get a tree. So let’s squeeze all cycles in source graph and get this tree. Also every vertex of this tree we’ll mark, if it is squeezed cycle (let’s call this vertices "},{"children":[{"kind":"text","text":"1-vertices"}],"kind":"emphasis"},{"kind":"text","text":") or single vertex in source graph (this vertices we’ll call "},{"children":[{"kind":"text","text":"0-vertices"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, we’ll do the following to find the number of paths between vertices "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" in source graph. Suppose "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is a vertex, corresponding to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" in obtained tree (it can be a single vertex or a vertex, corresponding to a squeezed cycle with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"), and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" is a vertex, corresponding to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Let’s denote "},{"children":[{"kind":"text","text":"deg"}],"kind":"emphasis"},{"kind":"text","text":" is the number of 1-vertices in path from "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" in tree. Than it is easy to understand, that the answer for query is "},{"attrs":{"alt":"","src":"/editorial-assets/9e9dfd8e0903c287c4785957b8d4b261687865c56c8102eb31dd1bb8f429a36c.png"},"kind":"image"},{"kind":"text","text":", because every cycle (1-vertex) increase the number of possible ways twice (you can go from one vertex to other by two ways in cycle)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It means that we need to count the number of 1-vertex on the path from one vertex to other in tree quickly to answer a query. We can do it in a following way. Hang our tree for one vertex, which we’ll call a root. Denote for every vertex "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the number of 1-vertex on the way to the root (including root and vertex itself). Suppose we want to find the number of 1-vertex on the path from "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Denote "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is the least common ancestor of vertices "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Than number of 1-vertex on the way from "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"–2·"},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", if "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is 0-vertex and "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"–2·"},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1, if "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is 1-vertex. The least common ancestor can be found by standard method — binary method recovery. Finally we have "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":") solution."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/5486"}