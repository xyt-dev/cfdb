,"text":") % "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") / "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". When you've got all the formulas, you can solve the problem using binary search."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/382/problem/C"},"children":[{"kind":"text","text":"382C - Arithmetic Progression"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This problem is about considering cases:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 1, the answer is -1. Because of any two numbers is arithmetical progression."},{"kind":"line_break"},{"kind":"text","text":"2) If array is constant, the answer if that constant."},{"kind":"line_break"},{"kind":"text","text":"3) If you have arithmetical progression initially, you can compute its difference "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". In this case you should just to output "},{"children":[{"kind":"text","text":"minVal"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"maxVal"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"minVal"}],"kind":"emphasis"},{"kind":"text","text":" is minimum value among "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], and "},{"children":[{"kind":"text","text":"maxVal"}],"kind":"emphasis"},{"kind":"text","text":" is maximum value among "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]. But in case of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 2, also you should check ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"[0] + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"[1]) / 2. If this number is integer, it is needed to be output."},{"kind":"line_break"},{"kind":"text","text":"4) Else, the answer has at most one integer. You find this integer you should sort the sequence, and find the place where the number is missed. If such a place exists you should add the corresponding number to the sequence, else, the answer is 0."},{"kind":"line_break"},{"kind":"text","text":"5) In all other cases the answer is 0."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/382/problem/D"},"children":[{"kind":"text","text":"382D - Ksenia and Pawns"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem from every cell except # there is one next cell. That's why this graph is almost functional graph. If this graph contains a cycle, then answer is -1 because the length of the cycle is at least two."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the other case, there are no cycles in the graph. Let's find the longest path in it, denote is as "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". Then is answer is at least 2·"},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 1 because we can put the two pawns in the first two cells of this path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But in some cases we could get the answer 2·"},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" if there are two non-intersecting by vertices (not #) paths of length "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". They are non-intersecting because if they intersect in some cell then they will be equal to the end (and the statement says that such moves are invalid)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we should check if the graph contains two non-intersecting by vertices (not #) paths of length "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". It could be done in any way. For example, using dfs searches."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/382/problem/E"},"children":[{"kind":"text","text":"382E - Ksenia and Combinatorics"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you should count trees with some properties. It can be done using dynamic programming. The main idea is that the maximum mathing in tree can be found using simple dynamic "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"used"}],"kind":"emphasis"},{"kind":"text","text":"] ("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" -- vertex, "},{"children":[{"kind":"text","text":"used"}],"kind":"emphasis"},{"kind":"text","text":" — was this vertex used in matching). So you should to count the trees tou should include in state of the dynamic values dp[v][0]$ and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"][1]. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, you should use dynamic programming "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0]["},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1] — number of rooted trees with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices and values of dynamic in root "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":"][0] = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0 and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":"][1] = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1. But in simple implementation this solution will get TL. There are two ways to get AC. The first is to opltimize code and make precalc. The second is to optimize asymptotics."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The author's solution uses the second way. To optimize solution you should mark that values "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0 and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1 differs at most by one. That is "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0 = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1, or "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0 = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1 + 1. So the first dynamic becomes "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0]["},{"children":[{"kind":"text","text":"add"}],"kind":"emphasis"},{"kind":"text","text":"]. Another optimization is there are not so many triples ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"0, "},{"children":[{"kind":"text","text":"add"}],"kind":"emphasis"},{"kind":"text","text":") with non-negative values (about 250), so you can you use lazy programming to calculate this dynamic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Comments that describe other solutions: "}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/blog/entry/10423#comment-158177"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/10423#comment-158177"}],"kind":"link"},{"kind":"line_break"},{"attrs":{"href":"https://codeforces.com/blog/entry/10423#comment-158182"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/10423#comment-158182"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/10442"}