{"assets":["/editorial-assets/f76e2a2d69e3738af67944855b4390390e4555bc9f8e653c5cd0ed37b3df8be3.png"],"contestId":"581","diagnostics":[],"document":{"children":[{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/A"},"children":[{"kind":"text","text":"581A — Vasya the Hipster"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first number in answer (number of days which Vasya can dress fashionably) is "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") because every from this day he will dress one red sock and one blue sock."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After this Vasya will have either only red socks or only blue socks or socks do not remain at all. Because of that the second number in answer is "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")) / 2, ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")) / 2)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior of this solution — O(1)."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/B"},"children":[{"kind":"text","text":"581B — Luxurious Houses"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem can be solved in the following way. Let's iterate on given array from the right to the left and will store in variable "},{"children":[{"kind":"text","text":"maxH"}],"kind":"emphasis"},{"kind":"text","text":" the maximal height if house which we have already considered.Then the answer to house number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is number "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, "},{"children":[{"kind":"text","text":"maxH"}],"kind":"emphasis"},{"kind":"text","text":" + 1 - "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" number of floors in house number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior of this solution — O("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" — number of houses."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/C"},"children":[{"kind":"text","text":"581C — Developing Skills"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem can be solved in many ways. Let's consider the most intuitive way that fits in the given time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the beginning we need to sort given array in the following way — from two numbers to the left should be the number to which must be added fewer units of improvements to make it a multiple of 10. You must add at least one unit of energy to every of this numbers. For example, if given array is {45, 30, 87, 26} after the sort the array must be equal to {87, 26, 45, 30}."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we iterate on the sorted array for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". Let's "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" = 10 - ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":"10). If "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" assign "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" and from "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" subtract "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" else if "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" break from cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next step is to iterate on array in the same way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need only to calculate answer "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" — we iterate on array for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and assign "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" / 10)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior of this solution — O("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")) where "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is the number of hero skills."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/D"},"children":[{"kind":"text","text":"581D — Three Logos"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem can be solved in many ways, let's consider one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first step is to calculate sum of squares "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" of given rectangles. Then the side of a answer square is "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"). If "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":") is not integer print -1. Else we need to make the following."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We brute the order in which we will add given rectangles in the answer square (we can do it with help of "},{"children":[{"kind":"text","text":"next"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"permutation"}],"kind":"emphasis"},{"kind":"text","text":"()) and for every order we brute will we rotate current rectangle on 90 degrees or not (we can do it with help of bit masks). In the beginning on every iteration the answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" in which we add the rectangles is empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every rectangle, which we add to the answer square we make the following — we need to find the uppermost and leftmost empty cell "},{"children":[{"kind":"text","text":"free"}],"kind":"emphasis"},{"kind":"text","text":" in answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" (recall that we also brute will we rotate the current rectangle on 90 degrees or not). Now we try to impose current rectangle in the answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" and the top left corner must coinside with the cell "},{"children":[{"kind":"text","text":"free"}],"kind":"emphasis"},{"kind":"text","text":". If current rectangle fully placed in the answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" and does not intersect with the some rectangle which has already been added, we need to fill by the required letter appropriate cells in the answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If no one of the conditions did not disrupted after we added all three rectangles and all answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is fully filled by letters we found answer and we neeed only to print the answer square "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Else if we did not find answer after all iterations on the rectangles — print -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For random number of the rectangles "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" asymptotic behavior — O("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"! * 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":") where "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" — the sum of squares of the given rectangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also this problem with 3 rectangles can be solved with the analysis of the cases with asymptotic O("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":") where "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" — the sum of squares of given rectangles."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/E"},"children":[{"kind":"text","text":"581E — Kojiro and Furrari"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" — the position of start, and "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":" — the position of finish. For convenience of implementation we add the gas-station in point "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":" with type equals to 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note: there is never a sense go to the left of the starting point because we already stand with a full tank of the besr petrol. It is correct for every gas-station in which we can appear (if in optimal answer we must go to the left in some gas-station "},{"children":[{"kind":"text","text":"pv"}],"kind":"emphasis"},{"kind":"text","text":", why not throw out all the way from "},{"children":[{"kind":"text","text":"pv"}],"kind":"emphasis"},{"kind":"text","text":" to current gas-station "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and back and after that the answer will be better). Now let's say about algorithm when we are in some gas-station "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first case: on distance no more than "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" there is the gas-station with quality of gasoline not worse, than in the current gas-station. Now we fix nearest from them "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":" (nearest to the right because go to the left as we understand makes no sense). In that case we refuel in such a way to can reach "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":" and go to "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second case: from the current gas-station we can reach only gas-station with the worst quality (the type of the current gas-station can be 2 or 3). If we are in the gas-station of type 2 we need to refuel on maximum possiblevalue and go in the last achievable gas-station. If we are in the gas-station with type 3, we need to go in the farthest gas-station with type 2, but if there is not such gas-station we need to go to the farthest gas-station with type 1. This reasoning are correct because we first need to minimze the count of fuel with type 1, and the second to minimize the count of fuel with type 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This basic reasoning necessary to solve the problem. The next step — calc dynamic on all suffixes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of gas-stations — the answer to the problem if we start from the gas-station "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" with empty tank. We need to make updates, considering the above cases. For update the dynamic in "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" we need to take the value of dynamic in "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":" and make update in addiction of the case. If the case is equals to 1, we need to add to appropriate value the distance "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":". If this case is equals to 2 and we are in the gas-station with type equals to 2 we need to add "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" to the second value of answer, and from the first value we need to substract "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". If it is the case number 2 and we are in the gas-station with type equals to 3, we need to substract from the value, which determined by the type of the gas-station "},{"children":[{"kind":"text","text":"nv"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now to answer on specific query of the starting position we nned to find the first gas-station which is to the right of the startiong position, make one update and take the value of dynamic, which already calculated, and recalculate this value in accordance with the above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior — O(n logn) or O(n) in case how we find position in the list of gas-stations (the first in case of binary search, the second in case of two pointers)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To this solution we need O(n) memory."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/581/F"},"children":[{"kind":"text","text":"581F — Zublicanes and Mumocrates"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let the number of leavs in tree (vertices with degree 1) is equal to "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". It said in statement that "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is even. If in given graph only 2 vertices the answer is equal to 1. Else we have vertex in graph which do not a leaf — we hang the three on this vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need to count 2 dynamics. The first "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"] — the least amount of colored edges in the subtree rooted at the vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", if vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" already painted in color "},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":" equals to 0 or to 1), and among the top of the leaves of the subtree "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" must be exactly "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" vertices with color 0. If we are in the leaf, it is easy to count this value. If we are not in the leaf — we count value with help of dynamic "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"]:  = "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"], where "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" — the first child int the adjacency list of vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need the second dynamic "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"] to spread "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" leaves with color 0 among subtrees of childs of vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". To calc "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"] we brute the color of child "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" — "},{"children":[{"kind":"text","text":"ncol"}],"kind":"emphasis"},{"kind":"text","text":" and the number of childs "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" with color 0, which will be locate in subtree of vertex "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and calc the value in the following way — "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"], "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"ns"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"ncol"}],"kind":"emphasis"},{"kind":"text","text":"] + ("},{"children":[{"kind":"text","text":"ncol"}],"kind":"emphasis"},{"kind":"text","text":"! = "},{"children":[{"kind":"text","text":"col"}],"kind":"emphasis"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"ns"}],"kind":"emphasis"},{"kind":"text","text":" — the next child of vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" after the child "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Note, that it is senselessly to take "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" more than the number of leaves in the subtree "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and to take more than the number of vertices in subtree — "},{"children":[{"kind":"text","text":"size"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (because in that case it will not be enough leaves for painting)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The upper bound of asymptotic for such dynamics "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"). We show that in fact it works with asymptotic "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"). Let's count the number of updates: "},{"attrs":{"alt":"","src":"/editorial-assets/f76e2a2d69e3738af67944855b4390390e4555bc9f8e653c5cd0ed37b3df8be3.png"},"kind":"image"},{"kind":"text","text":". Note, that every pair of vertices ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") appears in the last sum ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") exactly once when "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"lca"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). So we have no more than "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") updates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior of this solution: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/20508"}