kind":"text","text":"Problem author: "},{"attrs":{"href":"https://codeforces.com/profile/KAP"},"children":[{"kind":"text","text":"KAP"}],"kind":"link"},{"kind":"text","text":", preparation: "},{"attrs":{"href":"https://codeforces.com/profile/KAP"},"children":[{"kind":"text","text":"KAP"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"939C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/939/problem/C"},"children":[{"kind":"text","text":"939C - Convenient For Everybody"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Initially, compute prefix sums: for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" the total number of people in timezones from the first to the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th. Let's loop through all possible starting times of the competition. Each starting time gives as one or two segments of timezones, in which people will compete in the contest. We can easily compute the total number of participants in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) with the use of prefix sums. The total complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Problem author: "},{"attrs":{"href":"https://codeforces.com/profile/KAP"},"children":[{"kind":"text","text":"KAP"}],"kind":"link"},{"kind":"text","text":", preparation: "},{"attrs":{"href":"https://codeforces.com/profile/demon1999"},"children":[{"kind":"text","text":"demon1999"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"939D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/939/problem/D"},"children":[{"kind":"text","text":"939D - Love Rescue"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's build a graph with 26 vertices representing the 26 letters of English alphabet. When we buy a spell of form ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"), add an edge between vertices "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":". It's easy to see, that it is possible to change a letter "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" to a letter "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" if and only if there is a path between corresponding vertices in the graph. So our task is to add the minimum possible number of edges such that characters "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] are in one connected component for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (here "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" are the given strings)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's now take an empty graph and add edges between vertices "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". These edges, as we already know, add constraints on the final graph (these letters should be in a single connected component in the final graph). Let's compute the number of connected components in the graph — let it be "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Let's consider one connected component, let its size be "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Note that the spell we should buy should connect all these vertices in a single component. We can do this using at least "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1 edges, and the edges that suit us are any spanning tree of this component, that can be found using a dfs, or just connect one vertex of this component to all the others. So the total number of spells is "},{"attrs":{"alt":"","src":"/editorial-assets/210135dbaca2910b81b81887107f3489262f870d31432a2e7a04764d1592caf8.png"},"kind":"image"},{"kind":"text","text":". This is the answer to the problem."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Problem author: "},{"attrs":{"href":"https://codeforces.com/profile/ZhNV"},"children":[{"kind":"text","text":"ZhNV"}],"kind":"link"},{"kind":"text","text":", preparation: "},{"attrs":{"href":"https://codeforces.com/profile/ZhNV"},"children":[{"kind":"text","text":"ZhNV"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"939E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/939/problem/E"},"children":[{"kind":"text","text":"939E - Maximize!"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's first prove some lemmas we will use in the solution. Let "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be integers that are at the current moment in "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":", sorted in increasing order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lemma 1. Let the maximum element in optimal "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then the rest of the elements