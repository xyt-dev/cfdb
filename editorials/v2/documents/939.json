nd":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":". For effective computing of minimums you can use the queue of minimums, because the bounds of the segments increase with the increase of "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":". The total complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"},{"kind":"text","text":"). You can also use other data structures for computing minimum, and the complexity of such solutions is "},{"attrs":{"alt":"","src":"/editorial-assets/6f0998c07ecb0300a73594638beb6c0e11981e9e1bd90f0ec04230938b7607ca.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Problem author: "},{"attrs":{"href":"https://codeforces.com/profile/KAP"},"children":[{"kind":"text","text":"KAP"}],"kind":"link"},{"kind":"text","text":", preparation: "},{"attrs":{"href":"https://codeforces.com/profile/KAN"},"children":[{"kind":"text","text":"KAN"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/57892"}