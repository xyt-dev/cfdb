xt","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" with the value "},{"attrs":{"alt":"","src":"/editorial-assets/3a255c5e8f1ebe9e19ea854144321f715a5bf4e1afd443d87a2772b9034165c2.png"},"kind":"image"},{"kind":"text","text":". To compute the values "},{"attrs":{"alt":"","src":"/editorial-assets/4458bafe12125b0d449213144361271270c0078270f550e6b2f39e63ed05c258.png"},"kind":"image"},{"kind":"text","text":" fast, we should maintain the array of prefix sums in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" — one more element is added to this array each time a query of type 1 comes."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Problem author: "},{"attrs":{"href":"https://codeforces.com/profile/SYury"},"children":[{"kind":"text","text":"SYury"}],"kind":"link"},{"kind":"text","text":", preparation: "},{"attrs":{"href":"https://codeforces.com/profile/kuzmichev_dima"},"children":[{"kind":"text","text":"kuzmichev_dima"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"939F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/939/problem/F"},"children":[{"kind":"text","text":"939F - Cutlet"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's use dynamic programming approach. Solve the following subproblem: let "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" be the seconds passed since the start of cooking, and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" seconds among them the cutlet was preparing on the current side; what is the minimum number of flips needed to reach this state? This can be easily computed using answers for subproblems ("},{"children":[{"kind":"text","text":