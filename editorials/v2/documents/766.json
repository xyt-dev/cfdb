blem/C"},"children":[{"kind":"text","text":"766C - Mahmoud and a Message"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] be the number of ways to split the prefix of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" ending at index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" into substrings that fulfills the conditions. Let it be 1-indexed. Our base case is "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[0] = 1. Our answer is "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]. Now let's calculate it for every "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" be the minimum possible index such that the substring from "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" satisfies the condition, Let "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" be a moving pointer, At the beginning "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 and it decreases, Every time we decrease "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", We calculate the new value of "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" depending on the current character like that, "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]"}],"kind":"subscript"},{"kind":"text","text":"). While "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is greater than or equal to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" we add "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] to "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], To find the longest substring, Find maximum "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", To find the minimum number of substrings, there is an easy greedy solution, Find the longest valid prefix and delete it and do the same again until the string is empty, The number of times this operation is repeated is our answer, Or see the dynamic programming solution in the code."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code : "},{"attrs":{"href":"http://pastebin.com/4JiXSwfU"},"children":[{"kind":"text","text":"http://pastebin.com/4JiXSwfU"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time co