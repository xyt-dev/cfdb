{"assets":["/editorial-assets/4f191dfb9315504bcbc30c70221653f5973c1fc50bb8dceed717489133dd4357.png","/editorial-assets/24a6f429cb9c93ca6e45c9ed51b0890882f2f26d41420a4479dda0772b1a73fd.png","/editorial-assets/a178addb7224270d05523950c1705ed74fc7250084d2787fcec7415bfa040218.png"],"contestId":"749","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"749A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/749/problem/A"},"children":[{"kind":"text","text":"749A - Bachgold Problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We need represent integer number "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" (1 < "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") as a sum of maximum possible number of prime numbers, they don’t have to be different. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" is even number, we can represent it as sum of only 2 - minimal prime number. It is minimal prime number, so number of primes in sum is maximal in this case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" is odd number, we can use representing of "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - 1 as sum with only 2 and replace last summand from 2 to 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using of any prime "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" > 3 as summand is not optimal, because it can be replaced by more than one 2 and 3."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"749B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/749/problem/B"},"children":[{"kind":"text","text":"749B - Parallelogram is Back"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Denote the input points as "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":", and the point we need to find as "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the case when the segments "},{"children":[{"kind":"text","text":"AD"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"BC"}],"kind":"emphasis"},{"kind":"text","text":" are the diagonals of parallelogram. Vector AD is equal to the sum of two vectors AB + BD = AC + CD. As in the parallelogram the opposite sides are equal and parallel, BD = AC, AB = CD, and we can conclude that AD = AB + AC. So, the coordinates of the point D can be calculated as "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" + AB + AC = ("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") = ("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cases where the diagonals are "},{"children":[{"kind":"text","text":"BD"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"AC"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"CD"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"AB"}],"kind":"emphasis"},{"kind":"text","text":" are processed in the same way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prove that all three given points are different. Let's suppose it's wrong. Without losing of generality suppose that the points got in cases "},{"children":[{"kind":"text","text":"AD"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"BD"}],"kind":"emphasis"},{"kind":"text","text":" are equal. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the system of two equations for the equality of these points:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can see that in can be simplified as"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"And we got a contradiction, as all the points "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"749C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/749/problem/C"},"children":[{"kind":"text","text":"749C - Voting"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We will emulate the process with two queues. Let’s store in the first queue the moments of time when D-people will vote, and in the second queue - the moments of time of R-people. For every man where will be only one element in the queue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now compare the first elements in the queues. The man whose moment of time is less votes first. It’s obvious that it’s always profitable to vote against the first opponent. So we will remove the first element from the opponent’s queue, and move ourselves to the back of our queue, increasing the current time by "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - next time this man will vote after "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" turns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When one of the queues becomes empty, the corresponding party loses."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"749D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/749/problem/D"},"children":[{"kind":"text","text":"749D - Leaving Auction"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"For every man at the auction we will save two values: his maximum bid and the list of all his bids. Then save all men in the set sorted by the maximal bid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, when the query comes, we will remove from the set all men who left the auction, then answer the query, and then add the men back. The total number of deletions and insertions will not exceed 200000."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How to answer the query. Now our set contains only men who has not left. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the set is empty, the answer is 0 0. Otherwise, the maximal man in the set is the winner. Now we have to determine the winning bid. Let’s look at the second maximal man in the set. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If it doesn’t exist, the winner takes part solo and wins with his minimal bid. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise he should bid the minimal value that is greater than the maximal bid of the second man in the set. This is where we need a list of bids of the first maximal man. We can apply binary search and find the maximal bid of the second man there. "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"749E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/749/problem/E"},"children":[{"kind":"text","text":"749E - Inversions After Shuffle"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Lets calculate all available segments count – "},{"attrs":{"alt":"","src":"/editorial-assets/4f191dfb9315504bcbc30c70221653f5973c1fc50bb8dceed717489133dd4357.png"},"kind":"image"},{"kind":"text","text":". It will be a denominator of answer fraction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, necessary to understand, that expected value of inversion count in shuffled permutation with length len equal "},{"attrs":{"alt":"","src":"/editorial-assets/24a6f429cb9c93ca6e45c9ed51b0890882f2f26d41420a4479dda0772b1a73fd.png"},"kind":"image"},{"kind":"text","text":" (It can be prooved by fact, that for each permutation there are mirrored permutation (or biection "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" -  > "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1) and sum of inversion count his permutations are equal "},{"attrs":{"alt":"","src":"/editorial-assets/a178addb7224270d05523950c1705ed74fc7250084d2787fcec7415bfa040218.png"},"kind":"image"},{"kind":"text","text":" inversions)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next, we will find expected value of difference between expected value of inversion count after operation and inversion count in the source array. And add it to the inversion count in the source array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Naive solution:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every segment we will calculate the count of inversions in it, and also the expected value of the inversion count in it after shuffle. Take the difference and divide by a denominator. Sum these values for all segments. This solution has quadratic asympthotics, try to improve it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Optimized solution:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will go through the permutation from right to left and for each position count the sum of inversions in the initial permutation for all segments that start in the current position (denote that the largest segment which ends at the position "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" has the length "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"), also we will maintain the sum of expected values of the inversion counts on the segments of lengths 1.."},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". Knowing these two numbers, increase the answer by their difference divided by the denominator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To calculate the first value we will use the data structure that can get the sum of numbers on the prefix and modify the value at the single position (e.g. Fenwick tree). For the position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" we need to know how many numbers are less than "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", and every number should be taken "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" times, where "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" is number of segments where it is contained. Suppose we have calculated answers for some suffix and are now standing at the position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". For every position to the left it will be added "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 times (the number of positions "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" >  = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" as the candidates for the right bound, in 1-indexation). Perform fenwick add(a[i], n - i + 1)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/49186"}