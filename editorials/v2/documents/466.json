t","text":": "},{"attrs":{"alt":"","src":"/editorial-assets/1505455711f5b63a12c04cde7fc90a517b3e762063e1b91b4cf788d1d0980d57.png"},"kind":"image"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/466/submission/7784788"},"children":[{"kind":"text","text":"7784788"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/466/problem/C"},"children":[{"kind":"text","text":"466C - Number of Ways"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all, notice that if sum of all elements is equal "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" then sum of each of three parts is equal "},{"attrs":{"alt":"","src":"/editorial-assets/ce805a5534fd981f7ea6035a8737c1db8bff4105a2ce350a1745a3620ff8f9a5.png"},"kind":"image"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":" Therefore, if "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is not divided by 3 — then answer is 0."},{"kind":"line_break"},{"kind":"text","text":" Otherwise, let’s iterate the end of first part "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (1 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2) and if sum of 1..i elements is equal "},{"attrs":{"alt":"","src":"/editorial-assets/ce805a5534fd981f7ea6035a8737c1db8bff4105a2ce350a1745a3620ff8f9a5.png"},"kind":"image"},{"kind":"text","text":" then it means that we have to add to the answer the amount of such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 < "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") that the sum of elements from "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"-tn also equals "},{"attrs":{"alt":"","src":"/editorial-assets/ce805a5534fd981f7ea6035a8737c1db8bff4105a2ce350a1745a3620ff8f9a5.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s create an array "},{"children":[{"kind":"text","text":"cnt[]"}],"kind":"inline_code"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] equals 1, if the sum of elements from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"-th equals "},{"attrs":{"alt":"","src":"/editorial-assets/ce805a5534fd981f7ea6035a8737c1db8bff4105a2ce350a1745a3620ff8f9a5.png"},"kind":"image"},{"kind":"text","text":" and 0 — otherwise. Now, to calculate the answer we have to find the sum "},{"children":[{"kind":"text","text":"cnt[j] + cnt[j+1] + ... + cnt[n]"}],"kind":"inline_code"},{"kind":"text","text":" faster then O(n). There are a lot of required ways to do this, but the easiest one is to create a new additional array "},{"children":[{"kind":"text","text":"sums[]"}],"kind":"inline_code"},{"kind":"text","text":" where in "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th element will be "},{"children":[{"kind":"text","text":"cnt[j] + cnt[j+1] + ... + cnt[n]"}],"kind":"inline_code"},{"kind":"text","text":". It is easy to calculate in such way: "},{"children":[{"kind":"text","text":"sums[n] = cnt[n]"}],"kind":"inline_code"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"sums[i] = sums[i+1] + cnt[i] (i < n)"}],"kind":"inline_code"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, we receive very simple solution: for each prefix of initial array 1..i with the sum that equals "},{"attrs":{"alt":"","src":"/editorial-assets/ce805a5534fd981f7ea6035a8737c1db8bff4105a2ce350a1745a3620ff8f9a5.png"},"kind":"image"},{"kind":"text","text":" we need to add to the answer "},{"children":[{"kind":"text","text":"sums[i+2]"}],"kind":"inline_code"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/466/submission/7784781"},"children":[{"kind":"text","text":"7784781"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/466/problem/D"},"children":[{"kind":"text","text":"466D - Increase Sequence"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Lets use dynamic programming to solve this problem. "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":"] — the number of ways to cover prefix of array 1..i by segments and make it equal to "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" and remain after "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th element "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" segments that are not closed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all possible variants opening/closing segments in each position:"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"]"}],"kind":"inline_code"},{"kind":"text","text":" closing one segment"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"["}],"kind":"inline_code"},{"kind":"text","text":" opening one new segment"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"[]"}],"kind":"inline_code"},{"kind":"text","text":" adding one segment with length 1"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"]["}],"kind":"inline_code"},{"kind":"text","text":" closing one opened segment and opening a new one"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"-"}],"kind":"inline_code"},{"kind":"text","text":" do nothing"},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lets understand how to build dynamic. It is obviously to understand that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" can be equal "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" - 1. Otherwise, number of such ways equals 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider this two cases separately: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"line_break"},{"kind":"text","text":" It means that number of opened segments after "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th as max as possible and we can’t open one more segment in this place. So there are two variants:"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"["}],"kind":"inline_code"},{"kind":"text","text":" Opening a new segment. If only "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" > 0. "},{"children":[{"kind":"text","text":"dp[i][opened] += dp[i-1][opened + 1]"}],"kind":"inline_code"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"-"}],"kind":"inline_code"},{"kind":"text","text":" Do nothing. "},{"children":[{"kind":"text","text":"dp[i][opened] += dp[i-1][opened]"}],"kind":"inline_code"},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Other variants are impossible because of summary value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] will be greater than "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":"(when segment is finishing in current position — it increase value, but do not influence on "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":", by the dynamic definition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" + 1 = "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" "},{"kind":"line_break"},{"kind":"text","text":" Here we consider ways where "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th element has been increased by "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" + 1 segments, but after "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th remain only "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" not closed segments. Therefore, there are next variants:"},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"]"}],"kind":"inline_code"},{"kind":"text","text":" — closing one of the opened segments(we can do it "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" + 1 ways). "},{"children":[{"kind":"text","text":"dp[i][opened] += dp[i-1][opened + 1] * (opened + 1)"}],"kind":"inline_code"},{"kind":"text","text":" "},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"[]"}],"kind":"inline_code"},{"kind":"text","text":" — creating 1-length segment. "},{"children":[{"kind":"text","text":"dp[i][opened] += dp[i-1][opened]"}],"kind":"inline_code"},{"kind":"text","text":" "},{"kind":"line_break"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"]["}],"kind":"inline_code"},{"kind":"text","text":" — If only "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":" > 0. Amount of ways to choose segment which we will close equals "},{"children":[{"kind":"text","text":"opened"}],"kind":"emphasis"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"dp[i][opened] += dp[i-1][opened] * opened"}],"kind":"inline_code"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Start values — "},{"children":[{"kind":"text","text":"dp[1][0] = (a[1] == h || a[1] + 1 == h?1:0); dp[1][1] = (a[1] + 1 == h?1:0)"}],"kind":"inline_code"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answer — "},{"children":[{"kind":"text","text":"dp[n][0]"}],"kind":"inline_code"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/466/submission/7784697"},"children":[{"kind":"text","text":"7784697"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/466/problem/E"},"children":[{"kind":"text","text":"466E - Information Graph"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let’s introduce all structure of the company as a graph(if "},{"children":[{"kind":"text","text":"у"}],"kind":"emphasis"},{"kind":"text","text":" is the head of "},{"children":[{"kind":"text","text":"х"}],"kind":"emphasis"},{"kind":"text","text":" then we add edge "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" -> "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"). It is obviously to understand that after each operation our graph will be the set of trees. Actually, the third query — to check is our vertex belong to the subtree of the vertex which has received data package. Graph that we will receive after doing all operations we call final. Also, we will say that two vertexes belong to the same connectivity component if they belong to the same component in graph that we can have from final by changing directed edge to undirected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the following statement: vertex "},{"children":[{"kind":"text","text":"у"}],"kind":"emphasis"},{"kind":"text","text":" is the parent of vertex "},{"children":[{"kind":"text","text":"х"}],"kind":"emphasis"},{"kind":"text","text":" in current graph(after doing first "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" queries) if "},{"children":[{"kind":"text","text":"у"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"х"}],"kind":"emphasis"},{"kind":"text","text":" belongs to the same conectitive component and in final graph "},{"children":[{"kind":"text","text":"у"}],"kind":"emphasis"},{"kind":"text","text":" is the parent of "},{"children":[{"kind":"text","text":"х"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will solve this problem offline. After each query of adding data package we will immediately answer all the questions about this package. Besides that, use disjoint set union to define is this vertex belong to the same component or not. To answer the question we need to check that "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is the parent of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in final graph and that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is currently belong to the same connectivity component. Final graph we will build before doing this algorithm because we know all queries. Check that "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is the parent of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in final tree we can simply in O(1) by arrays of entry-time and output-time which we can calculate use dfs("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" —parent "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" <=> ("},{"children":[{"kind":"text","text":"in"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"in"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"out"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"out"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"])."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" — inverse Ackerman function. "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/466/submission/7784662"},"children":[{"kind":"text","text":"7784662"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/13758"}