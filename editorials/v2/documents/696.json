{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + 1 < "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/c59c3ed6c740f50d09745fc1ed4922e9f968b7522d658ce6d59631870b0c3449.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/b8bbea3eed2105931d1edb4568d21125f68626bb45dda01714916dba0e56d081.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/2A"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"Div.2 B"}],"kind":"heading"},{"children":[{"kind":"text","text":"Nothing special, right? just find the position of letters "},{"children":[{"kind":"text","text":"."}],"kind":"inline_code"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"e"}],"kind":"inline_code"},{"kind":"text","text":" with string searching methods (like "},{"children":[{"kind":"text","text":".find"}],"kind":"inline_code"},{"kind":"text","text":") and do the rest."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/69007a212a9478ebd9083888b87b1395ab40e8d44e32b5b4d7c3e2737e8b8f70.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/2B"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"A"}],"kind":"heading"},{"children":[{"kind":"text","text":"Do what problem wants from you. The only thing is to find the path between the two vertices (or LCA) in the tree. You can do this in "},{"attrs":{"alt":"","src":"/editorial-assets/facc4ade6b369bca0a45764d9c61c2e5820631c33bfada9b2854c2e8d5d874ab.png"},"kind":"image"},{"kind":"text","text":" since the height of the tree is "},{"attrs":{"alt":"","src":"/editorial-assets/facc4ade6b369bca0a45764d9c61c2e5820631c33bfada9b2854c2e8d5d874ab.png"},"kind":"image"},{"kind":"text","text":". You can keep edge weights in a map and get/set the value whenever you want. Here's a code for LCA:"}],"kind":"paragraph"},{"kind":"code_block","text":"LCA(v, u):\n        while v != u:\n                if depth[v] < depth[u]:\n                        swap(v, u)\n                v = v/2        // v/2 is parent of vertex v\n"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/ea4d3121d9e3e16388b0c1d5dc173677029369a90f32847a0d39cf70c769ef45.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/d5064032e544417e6d24d22d003fc11f51aa22a3ee3ccbf56d300e95a9b49372.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/A"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"B"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all "},{"children":[{"kind":"text","text":"starting"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"time"}],"kind":"emphasis"},{"kind":"text","text":" of a vertex is the number of "},{"children":[{"kind":"text","text":"dfs"}],"kind":"inline_code"},{"kind":"text","text":" calls before the "},{"children":[{"kind":"text","text":"dfs"}],"kind":"inline_code"},{"kind":"text","text":" call of this vertex plus 1. Now suppose we want to find the answer for vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". For any vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" that is not in subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and is not an ancestor "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", denote vertices "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" but not "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" but not "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" share the same direct parent; That is "},{"children":[{"kind":"text","text":"par"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"par"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/7d37f61543e19896584977ca7eb50f40cd3f5fdc8a0fc2c15cc90f88f43a1160.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The probability that "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" occurs sooner than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"children"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"par"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]] after shuffling is 0.5. So the probability that "},{"children":[{"kind":"text","text":"starting"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"time"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] < "},{"children":[{"kind":"text","text":"starting"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"time"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] is 0.5. Also We know if "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is ancestor of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" this probability is 1 and if it's in subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" the probability is 0. That's why answer for "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"attrs":{"alt":"","src":"/editorial-assets/f21ae2a407167b30e385523effb59d3bfc17bc8e2e00fe47df13a36ab160687a.png"},"kind":"image"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"depth"}],"kind":"emphasis"},{"kind":"text","text":" is 1-based and "},{"children":[{"kind":"text","text":"sub"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] is the number of vertices in subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" including "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" itself). Because "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"sub"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] is the number of vertices like the first "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" (not in subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and not an ancestor of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus answer is always either an integer or an integer and a half."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/B"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"C"}],"kind":"heading"},{"children":[{"kind":"text","text":"It gets tricky when the problem statement says "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" should be coprimes. A wise coder in this situation thinks of a formula to make sure this happens."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First of all let's solve the problem if we only want to find the fraction "},{"attrs":{"alt":"","src":"/editorial-assets/98d633f3e4c4b219e2ecd183a937e9bd319a8f002852b56a02e519a888723c55.png"},"kind":"image"},{"kind":"text","text":". Suppose "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is answer for swapping the cups "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" times. It's obvious that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[1] = 0. For "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > 0, obviously the desired cup shouldn't be in the middle in ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1) - "},{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"},{"kind":"text","text":" swap and with this condition the probability that after "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"},{"kind":"text","text":" swap comes to the middle is 0.5. That's why "},{"attrs":{"alt":"","src":"/editorial-assets/47513b95ba2b5af1273bf4de097ce37fafbefb83cb1542f397a4ab418b9256f1.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/35e506029c819dab014ffbafea7dbfca4bfffcea593fb94c31cd1ac5827ebbc6.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some people may use matrix to find "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" using this dp (using pair of ints instead of floating point) but there's a risk that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" are not coprimes, but fortunately or unfortunately they will be."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using some algebra you can prove that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"if "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is even then "},{"attrs":{"alt":"","src":"/editorial-assets/cbf466f65c02bbe0b3a4e5d206f2ed8e288a74448c413e85c7311a2344b0e225.png"},"kind":"image"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" = 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":"if "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is odd then "},{"attrs":{"alt":"","src":"/editorial-assets/237d77121640d48d924b609b7a2c6b3d2a158eefbf1495b76f1d3c78e0bbafea.png"},"kind":"image"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" = 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can confirm that in both cases "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" are coprimes (since "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is odd and "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" is a power of 2)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only thing left to handle is to find 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" (or 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":") and parity. Finding parity is super easy. Also 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" = 2"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" × ... × "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" = (...((2"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":")"},{"kind":"superscript"},{"kind":"text","text":"...)"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":". So it can be calculated using binary exponential. Also dividing can be done using Fermat's little theorem. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"klg"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/C"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"D"}],"kind":"heading"},{"children":[{"kind":"text","text":"Build the prefix automaton of these strings (Aho-Corasick). In this automaton every state denotes a string which is prefix of one of given strings (and when we feed characters to it the current state is always the longest of these prefixes that is a suffix of the current string we have fed to it). Building this DFA can be done in various ways (fast and slow)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose these automaton has "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" states ("},{"attrs":{"alt":"","src":"/editorial-assets/350c8f63c767b16306f9b357f9c564e278b03c9ecdc340d0d3dda19392a12ae4.png"},"kind":"image"},{"kind":"text","text":") and state "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" has edges outgoing to states in vector "},{"children":[{"kind":"text","text":"neigh"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] (if we define our DFA as a directed graph). Suppose state number 1 is the initial state (denoting an empty string). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" was smaller we could use dp: suppose "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] is the maximum score of all strings with length equal to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ending in state "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" of our DFA when fed into it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to show that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[0][1] = 0 and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[1]["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + 1]["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] for "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"neigh"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] and calculating dps can be done using this (here "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is sum of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" of all strings that are a suffix of string related to state "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/798de52ce844db88bfb31852d27c7f6caae57b0bee73804cb96e1b41e993bde0.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now that "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" is large, let's use matrix exponential to calculate the dp. Now dp is not an array, but a column matrix. Finding a matrix to update the dp is not hard. Also we need to reform "},{"children":[{"kind":"text","text":"+"}],"kind":"inline_code"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"*"}],"kind":"inline_code"},{"kind":"text","text":" operations. In matrix multiplying we should use "},{"children":[{"kind":"text","text":"+"}],"kind":"inline_code"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"*"}],"kind":"inline_code"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"max"}],"kind":"inline_code"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"+"}],"kind":"inline_code"},{"kind":"text","text":" in normal multiplication. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/dcc3ee0be264567c6eb72dd32ee317f9c2a910ceb9fe3b6d3d96bd2e56415e36.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/D"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"E"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all, for each query of 1st type we can assume "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1 (because we can perform this query "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" times, it doesn't differ)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider this problem: there are only queries of type 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For solving this problem we can use heavy-light decomposition. If for a vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" of the tree we denote "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the weight of the lightest girl in it (∞ in case there is no girl in it), for each chain in HLD we need to perform two type of queries:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"Get weight of the lightest girl in a substring (consecutive subsequence) of this chain (a subchain)."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Delete the lightest girl in vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". As the result only "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" changes. We can find this value after changing in "},{"attrs":{"alt":"","src":"/editorial-assets/b8bbea3eed2105931d1edb4568d21125f68626bb45dda01714916dba0e56d081.png"},"kind":"image"},{"kind":"text","text":" if we have the sorted vector of girls' weights for each vertex (and then we pop the last element from it and then current last element is the lightest girl, ∞ in case it becomes empty)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/420e9d97857efab1f640a11e122bf06cf1eeb245f4affdc5a7f43954eea24158.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This can be done using a classic segment tree. In each node we only need a pair of integers: weight of lightest girl in interval of this node and the vertex she lives in (a "},{"children":[{"kind":"text","text":"pair<int, int>"}],"kind":"inline_code"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This works for this version of the problem. But for the original version we need an additional query type:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"3."}],"kind":"emphasis"},{"kind":"text","text":" Increase weight of girls in a substring (consecutive subsequence) of this chain (a subchain) by "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This can be done using the previous segment tree plus lazy propagation (an additional value in each node, type 3 queries to pass to children)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now consider the original problem. Consider an specific chain: after each query of the first type on of the following happens to this chain:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"Nothing."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Only an interval (subchain) is effected."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Whole chain is effected."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"When case 2 happens, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" (query argument) belongs to this chain. And this can be done using the 3rd query of chains when we are processing a 2nd type query (effect the chain "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" belongs to)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When case 3 happens, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of the topmost vertex in this chain. So when processing 1st type query, we need to know sum of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" for all 2nd type queries that their "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of topmost chain in current chain we're checking. This can be done using a single segment/Fenwick tree (using starting-finishing time trick to convert tree to array)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So for each query of 1st type, we will check all chains on the path to find the lightest girl and delete her."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/e879ac239666a49b84dc5113a1f0c973dfdcfccdd26e7d9fab5a0120852ffa48.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/E"},"children":[{"kind":"text","text":"Codes"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"F"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first thoughts you see that there's definitely a binary search needed (on "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"). Only problem is checking if there are such two points fulfilling conditions with radius "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each edge, we can shift it "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" units inside the polygon (parallel to this edge). The only points that can see the line coinciding the line on this edge are inside the half-plane on one side of this shifted line (side containing this edge). So problem is to partition these half-planes in two parts such that intersection of half-planes in each partition and the polygon (another "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" half-planes) is not empty. There are several algorithms for this propose:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/8ef94d9a5553de9d2be7b1c5e42618fe9072bd72325834ec94f29c168295cffc.png"},"kind":"image"},{"kind":"text","text":" Algorithm:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/69fa25ce6bf946036a55ad2e97a673fb9c92a8d6b799be6dbdb82984e6eb0a67.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's obvious that if intersection of some half-planes is not empty, then there's at least on point inside this intersection that is intersection of two of these lines (lines denoting these half-planes). The easiest algorithm is to pick any intersection of these 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" lines ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" shifted half-planes and "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" edges of the polygon) like "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" that lies inside the polygon, delete any half-plane containing this point (intersection of deleted half-planes and polygon is not empty because it contains at least "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":") and check if the intersection of half-planes left and polygon is not empty (of course this part needs sorting half-planes and adds an additional "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" but we can sort the lines initially and use something like counting sort in this step)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Well, constant factor in this problem is too big and this algorithm will not fit into time limit. But this algorithm will be used to prove the faster algorithm:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/c06e8da5a5f4ac59568c754015217c9b8d877fbc02ad69660a9b448653a237b9.png"},"kind":"image"},{"kind":"text","text":" Algorithm:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the previous algorithm we checked if "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" can be in intersection of one part. Here's the thing:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lemma 1:"}],"kind":"strong"},{"kind":"text","text":" If "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is inside intersection of two half-planes ("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is not necessarily intersection of their lines) related to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"},{"kind":"text","text":" edge ("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") and two conditions below are fulfilled, then there's no partitioning that in it "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is inside intersection of a part (and polygon):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"At least one of the half-planes related to an edge with index between "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" exists that doesn't contain "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":"At least one of the half-planes related to an edge with index greater than "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" or less than "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" exists that doesn't contain "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Because if these two lines exist, they should be in the other part that doesn't contain "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and if they are, intersection of them and polygon will be empty(proof is easy, homework assignment ;))."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/a4767821371c62f7da5368d68aef8d19db42566b80255177de0b024c33f7bff5.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This proves that if such partitioning is available that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is in intersection of one of them, then it belongs to an interval of edges(cyclic interval) and the rest are also an interval (so intersection of both intervals with polygon should be non-empty). Thus, we don't need "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" anymore. We only need intervals! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Result is, if such partitioning exists, there are integers "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" (1 ≤ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") such that intersection of half-planes related to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + 1, ..., "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" and polygon and also intersection of half-planes related to "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 2, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", 1, 2, ..., "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - 1 and polygon are both non-empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This still gives an "},{"attrs":{"alt":"","src":"/editorial-assets/8ef94d9a5553de9d2be7b1c5e42618fe9072bd72325834ec94f29c168295cffc.png"},"kind":"image"},{"kind":"text","text":" algorithm (checking every interval). But this lemma comes handy here:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call an interval(cyclic) good if intersection of lines related to them and polygon is non-empty."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lemma 2:"}],"kind":"strong"},{"kind":"text","text":" If an interval is good, then every subinterval of this interval is also good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof is obvious."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That gives and idea: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote "},{"children":[{"kind":"text","text":"interval"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") is a set of integers such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"interval"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") = {"},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + 1, ..., "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"}"}],"kind":"list_item"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"interval"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") = {"},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", 1, ..., "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"}"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"(In other words it's a cyclic interval)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also "},{"children":[{"kind":"text","text":"MOD"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") is:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" iff "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"MOD"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") iff "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"(In other words it's modulo "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" for 1-based)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only thing that matters for us for every "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", is maximum "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"interval"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"MOD"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":")) is good (because then all its subintervals are good)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is maximum "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"interval"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"MOD"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":")) is good, we can use 2-pointer to find values of "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lemma 3:"}],"kind":"strong"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"MOD"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1)"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof is obvious in result of "},{"children":[{"kind":"text","text":"lemma 2"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here's a pseudo code:"}],"kind":"paragraph"},{"kind":"code_block","text":"check(r):\n        len = 0\n        for i = 1 to n:\n                while len < n and good(i, MOD(i+len)):        // good(l, r) returns true iff interval(l, r) is good\n                        len = len + 1\n                if len == 0:\n                        return false        // Obviously\n                if len == n:\n                        return true        // Barney and Lyanna can both stay in the same position\n                l[i] = len\n        for i = 1 to n:\n                if l[i] + l[MOD(i+l[i])] >= n:\n                        return true\n        return false\n"},{"children":[{"children":[{"kind":"text","text":"good"}],"kind":"emphasis"},{"kind":"text","text":" function can be implemented to work in "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"},{"kind":"text","text":" (with sorting as said before). And 2-pointer makes the calls to "},{"children":[{"kind":"text","text":"good"}],"kind":"emphasis"},{"kind":"text","text":" to be "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the total complexity to check an specific "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/editorial-assets/c06e8da5a5f4ac59568c754015217c9b8d877fbc02ad69660a9b448653a237b9.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/1e45dff513d479711c8ec1e218d3941fd9829a53f331358277fe2247568d96fb.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://gitlab.com/amirmd76/cf-round-362/tree/master/F"},"children":[{"kind":