,"text":", and the power of 2 in their multiplication is just x+y+z."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us denote "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":") for the answer to the original problem that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" 's upper limit is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". And their can only use the prime factors which are not less than "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the next prime to be "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":", so we can try to fix the power of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and get the new upper limit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we can do transform like t