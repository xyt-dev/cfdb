,"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It is an implementation problem. Let's store in the variable "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" the number of words inside brackets and in the variable "},{"children":[{"kind":"text","text":"maxL"}],"kind":"emphasis"},{"kind":"text","text":" — the maximum length of the word outside brackets. You can add the symbol «_» to the end of the given string, to correctly process the last word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's iterate through the given string from the left to the right and store in the variable "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" the current word. Also in the variable "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" we need to store balance of the open and close brackets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the current symbol is letter — add it to the end of the string "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" and go to the next symbol of the given string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the current symbol is open bracket, make "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" + 1. If the current symbol is close bracket, make "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" - 1. After that if "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" is non-empty string add 1 to "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" if "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" equals to 1. Else if "},{"children":[{"kind":"text","text":"bal"}],"kind":"emphasis"},{"kind":"text","text":" equals to 0 update "},{"children":[{"kind":"text","text":"maxL"}],"kind":"emphasis"},{"kind":"text","text":" with length of the string "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":". After that we need to assign "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" to the empty string and go to the next symbol of the given string."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"723C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/723/problem/C"},"children":[{"kind":"text","text":"723C - Polycarp at the Radio"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It is easy to understand that we always can get the maximum value of the minimum of the values "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" which equals to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". So, we need to make vector "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":" which will store positions of the given array in which we will change values. At first it is all positions of the given array, in which the values are more than "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Then we need to store for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" in vectors "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the positions of the given array, in which the bands equal to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Then for every vector, which size is more than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" we need to add tje first "},{"children":[{"kind":"text","text":"sz"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") - ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") elements in the vector "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"sz"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") is the size of the vector "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that we need to iterate through the numbers of bands from 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"sz"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"t