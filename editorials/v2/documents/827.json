{"assets":["/editorial-assets/f876798b26cf218cb1293559008adcca35b77fcb9365ff881ecf57e73c1b6205.png","/editorial-assets/b078d12513ee093d6e373c8d9dc81ba20e28a9c30f0de7271effe61c407a02ce.png","/editorial-assets/c1d5a745d9ac05da27c2f31fa2d1b6242bdc292b5cddc961b1df647aba96f40b.png","/editorial-assets/56c675073652009fd6d8bb93c085924781182ed6495975e4b894a668e49019d1.png","/editorial-assets/c7183f807282bb7c5522647dd0cb81d1acb1f5e2e20338ec25e0aa801ad12158.png","/editorial-assets/1f447c7845259d8fc77bcecb4eae9d0e78100139ff505266da254fbed57c44c0.png","/editorial-assets/e2f16f7954612213dbdcf7621d9f99801f73c3b0a212e6a6d5b121e7036245a4.png","/editorial-assets/8ea8be0db8738881c73964a25621e4444d352af9c772237c9f0991893cd20b25.png","/editorial-assets/3760bb8ae8e29d4423afa6337946fe1ea7ffd8dce5e6a6e0d9ce0ff43f28715c.png"],"contestId":"827","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"The analysis is being updated."}],"kind":"paragraph"},{"attrs":{"problemCode":"828A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/828/problem/A"},"children":[{"kind":"text","text":"828A - Restaurant Tables"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We need to store three values: "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" — the number of free tables for one person, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" — the number of free tables for two persons and "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" — the number of tables for two persons occupied by single person."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the next group consisting of 2 persons and there are no free tables for two persons (i. e. "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" =  = 0) the restaurant denies service to this group and we need to add 2 to the answer. In the other case, we need subtract one from "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" and move to the next group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the next group consisting of 1 person and there is free table for one person (i. e. "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" > 0) we need to subtract one from "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and move to the next group. In the other case, if there is free table for two persons you need to put person for this table, subtract one from "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" and add one to "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". If there are no free tables but "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" > 0 we need to subtract one form "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". If no one from the described conditions did not met the restaurant denies service to this group consisting of one person and we need to add one to the answer and move to the next group."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"828B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/828/problem/B"},"children":[{"kind":"text","text":"828B - Black Square"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If there are no black cells on the field it is enough to paint any one cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the other case, we need to calculate 4 values:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"minX"}],"kind":"emphasis"},{"kind":"text","text":" — the index of upper row with black cell; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"maxX"}],"kind":"emphasis"},{"kind":"text","text":" — the index of bottom row with black cell; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"minY"}],"kind":"emphasis"},{"kind":"text","text":" — the index of leftmost column with black cell; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"maxY"}],"kind":"emphasis"},{"kind":"text","text":" — the index of rightmost column with black cell. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After that we can get the length of square side which should be obtained after repainting. Let this side equals to "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"maxX"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"minX"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"maxY"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"minY"}],"kind":"emphasis"},{"kind":"text","text":" + 1). If "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" more than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" more than "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" there is no solution. Else, the answer is equals to "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" is the number of cells in the resulting square and "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" is the number of black cells on the initial field. The value "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" can be calculated in one iteration through the given field."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"827A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/827/problem/A"},"children":[{"kind":"text","text":"827A - String Reconstruction"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"At first let's sort all given string by their positions and also determine the length of the answer string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that fill the answer string with letters \"a\" because the answer string must be lexicographically minimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's use variable "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" — the minimal index of letter in the answer string which did not already processed. After that we need to iterate through the sorted strings. If the next string ends before "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" we skip it. In the other case, we need to impose this string to the answer string beginning from necessary position and write down all letters beginning from "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" or from the beginning of impose (depending on which of these values is greater). If the imposing of string ends in position "},{"children":[{"kind":"text","text":"endPos"}],"kind":"emphasis"},{"kind":"text","text":" we need to make "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"endPos"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and move to the next string."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"827B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/827/problem/B"},"children":[{"kind":"text","text":"827B - High Load"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Hint: one of the optimal solutions is a star-like tree: one \"center\" node with "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" paths with lengths difference at most one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof: let the optimal answer be something different from the structure described. If it is a star with "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" paths, but the lengths differ by more than one, we can shorten the longest one and lengthen the shortest one, and the answer won't become greater. So, doing this operation once or more, we eventually get the described structure, that means that our answer is optimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the optimal answer is not a star, let's hang it on one of its centers, and let the diameter be "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". Then the depths of all leaves are not greater than "},{"attrs":{"alt":"","src":"/editorial-assets/f876798b26cf218cb1293559008adcca35b77fcb9365ff881ecf57e73c1b6205.png"},"kind":"image"},{"kind":"text","text":". Suppose there is some edge "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":" from the root that has more than one leaf in its subtree. Let "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" be some leaf in this subtree, and its depth be "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". Let's take the path from leaf "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" all the way up to some vertex with degree more than 2, and rehang this path to the root. The tree is now more star-like, and we are going to prove that the answer didn't become larger. Obviously, we're only interested in distances between "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and other leaves. Moreover, we can see that the current depth of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is smaller than "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", and the distance between "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and other leaves doesn't exceed "},{"attrs":{"alt":"","src":"/editorial-assets/b078d12513ee093d6e373c8d9dc81ba20e28a9c30f0de7271effe61c407a02ce.png"},"kind":"image"},{"kind":"text","text":". It is proved now."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"827C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/827/problem/C"},"children":[{"kind":"text","text":"827C - DNA Evolution"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Note that there are only 4 different characters and queries' lengths are only up to 10. How does this help? Let's make 4 arrays of length |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"| for each of the possible letters, putting 1 where the letter in "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" is that letter, and 0 otherwise. We can update these arrays easily with update queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider a letter in a query string "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":". It appears equidistantly in the string we write down under the string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Thus, we should count the number of ones (in one of our four arrays) at positions which indices form an arithmetic progression, and bounded by some segment (the query segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]). This sounds hard, but we can note that the difference between the indices (i.e. the common difference of the arithmetic progression) is not larger than 10. Thus, we can store 10 copies of each of four arrays we created above. For the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-th copy of some letter, we reorder the elements so that first we put all positions "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" for which "},{"attrs":{"alt":"","src":"/editorial-assets/c1d5a745d9ac05da27c2f31fa2d1b6242bdc292b5cddc961b1df647aba96f40b.png"},"kind":"image"},{"kind":"text","text":", then all positions "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" for which "},{"attrs":{"alt":"","src":"/editorial-assets/56c675073652009fd6d8bb93c085924781182ed6495975e4b894a668e49019d1.png"},"kind":"image"},{"kind":"text","text":", and so on. This will make possible to change each query on an arithmetic progression to a sum query on a segment. Thus, we can just sum up answers for each letter in string "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"827D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/827/problem/D"},"children":[{"kind":"text","text":"827D - Best Edge Weight"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Hint 1: Find some MST in the initial graph and name it "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". Now there are edges of two types: in the tree, and not in the tree. Process them in a different way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hint 2: For edges not in the MST, the answer is the maximum weight of MST edges on the path between the edge's ends, minus one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof: Consider the edge "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" such that it doesn't appear in our MST and its weight is "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" and consider the maximum weight of MST edges on the path between the edge's ends is "},{"children":[{"kind":"text","text":"MX"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's obvious that if "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"MX"}],"kind":"emphasis"},{"kind":"text","text":" there is an MST such that "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" will not appear in that (at least it will not appear in "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's prove that if "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"MX"}],"kind":"emphasis"},{"kind":"text","text":" - 1 it will appear in any MST. Consider an MST like "},{"children":[{"kind":"text","text":"OM"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" does not appear in that, let's prove "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" was not an MST and it's a contradiction. Let ends of "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" be "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". Look, consider the path between "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":", there is an edge with weight "},{"children":[{"kind":"text","text":"MX"}],"kind":"emphasis"},{"kind":"text","text":" in this path but there isn't any edge in "},{"children":[{"kind":"text","text":"OM"}],"kind":"emphasis"},{"kind":"text","text":" with weight greater than or equal to "},{"children":[{"kind":"text","text":"MX"}],"kind":"emphasis"},{"kind":"text","text":". So "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" is not an MST because when we build an MST we sort edges by their weight and add them greedily (Kruskal's algorithm)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hint 3: For an edge "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" in the MST, let non-MST edges such that MST path between their ends go through "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" be bad edges, the answer is the minimum weight of bad edges, minus one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof: Let the minimum weight of bad edges be "},{"children":[{"kind":"text","text":"CW"}],"kind":"emphasis"},{"kind":"text","text":" and weight of "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" be "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":". It is obvious that if "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"CW"}],"kind":"emphasis"},{"kind":"text","text":" there is an MST such that "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" will not appear in that. Now if "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"CW"}],"kind":"emphasis"},{"kind":"text","text":" so we will check "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" before bad edges and we will add it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The remaining part is easy: for non-MST edges, one can just query the maximum on a tree path with binary lifts or whatever other structure on a tree. For MST edges, we can do the same, but in the other direction, like range queries, or even easier with centroid decomposition, HLD or using sets and the smaller-to-larger optimization."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Thanks "},{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"},{"kind":"text","text":" for the proofs!"}],"kind":"paragraph"},{"attrs":{"problemCode":"827E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/827/problem/E"},"children":[{"kind":"text","text":"827E - Rusty String"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is symbol number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from the given string. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Statement: "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" can be period of string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" when if and only if there are no two indices "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" for which "},{"attrs":{"alt":"","src":"/editorial-assets/c7183f807282bb7c5522647dd0cb81d1acb1f5e2e20338ec25e0aa801ad12158.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Evidence: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Necessity: Let it is not true. Then for any letter fill of omissions such paint "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" will left that "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ?, "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ? and this contradicts the definition of the period."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Adequacy: Let fill omissions with constructive algorithm in a way that string after that is having a period "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Let's look on some remainder of division on "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". There are two options. In the first option there are no such "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" gives needed remainder by divide on "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ?. Then let fill all positions with such remainder with symbol \"V\". In the second option there are "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" gives this remainder by division on "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ?. Let fill all positions with this remainder symbol "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Now in all positions with equal remainder by division on "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" in string stand equal symbols and it means that string has period "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a pair indices "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" contradictory, if "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ? and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ ?, then the string has period "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" if and only if there are no contradictory pair "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" for which |"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "