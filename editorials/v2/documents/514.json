/codeforces.com/contest/514/problem/B"},"children":[{"kind":"text","text":"514B - Han Solo and Lazer Gun"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Antoniuk"},"children":[{"kind":"text","text":"Antoniuk"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's run through every point, where the stormtroopers are situated. If in current point stormtroopers are still alive, let's make a shot and destroy every stormtrooper on the same line with gun and current point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Points ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":") are on the same line, if ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":")("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":") = ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":")("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"alt":"","src":"/editorial-assets/98afe20962c9b99df5b90be1ebc048bbe742eaec8c882459125d8874453c7627.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/514/problem/C"},"children":[{"kind":"text","text":"514C - Watto and Mechanism"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Rebryk"},"children":[{"kind":"text","text":"Rebryk"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While adding a string to the set, let's count its polynomial hash and add it to an array. Then let's sort this array. Now, to know the query answer, let's try to change every symbol in the string and check with binary search if its hash can be found in the array (recounting hashes with "},{"attrs":{"alt":"","src":"/editorial-assets/b8bbea3eed2105931d1edb4568d21125f68626bb45dda01714916dba0e56d081.png"},"kind":"image"},{"kind":"text","text":" complexity). If the hash is found in the array, the answer is \"YES\", otherwise \"NO\"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"alt":"","src":"/editorial-assets/5ebd9ff248c712d0628c39e56dd25b0cd54eee30b71aef74be50d0d253b892a1.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" is total length of all strings."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/514/problem/D"},"children":[{"kind":"text","text":"514D - R2D2 and Droid Army"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Rebryk"},"children":[{"kind":"text","text":"Rebryk"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To destroy all the droids on a segment of "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", we need to make "},{"attrs":{"alt":"","src":"/editorial-assets/eded7e138cad291a8e5f75b7631115f0fcd5353bfef1b34f3bbefc2592ee2e7a.png"},"kind":"image"},{"kind":"text","text":" shots, where "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — number of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-type details in "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th droid. Let's support two pointers — on the beginning and on the end of the segment, which we want to destroy all the droids on. If we can destroy droids on current segment, let's increase right border of the segment, otherwise increase left border, updating the answer after every segment change. Let's use a queue in order to find the segment maximum effectively."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"alt":"","src":"/editorial-assets/0fd8a10f727b2d93445c320765d5107531a6612865c4da94f6787f0ad84671ef.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/514/problem/E"},"children":[{"kind":"text","text":"514E - Darth Vader and Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Author:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Antoniuk"},"children":[{"kind":"text","text":"Antoniuk"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to realize that "},{"attrs":{"alt":"","src":"/editorial-assets/3b70dde3c554b4dc50e0ba93d4a4d3fc65f941ffe6bd153de567806bcbc504a7.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is number of vertices, which are situated on a distance "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from the root, and "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] is number of children, which are situated on a distance "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Answer "},{"attrs":{"alt":"","src":"/editorial-assets/5b5ce9350412d256dac66e4031effa5bab4df4a72bb5063c0f8b9ab9eb00939d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the dynamics condition"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/aee9aa142368552f4fc9d73762dc5f9b1b08ee482c01c943c39f71c87959b119.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's build a transformation matrix of 101 × 101 size"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/bf0223195b8f776f2dbda56f93d210c30fb11154b0fb26b41724b1656085ee9c.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, to move to the next condition, we need to multiply A by B. So, if matrix "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - 100"}],"kind":"superscript"},{"kind":"text","text":", then the answer will be situated in the very right cell of this matrix. For "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" < 100 we'll find the answer using dynamics explained in the beginning."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to find "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" let's use binary power."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"alt":"","src":"/editorial-assets/8d2238152f3113897a8054e16c18918fbf9c712d52f22d2a773a8bb46d066f57.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/16398"}