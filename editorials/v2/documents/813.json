ext","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - 1)) if "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" > 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is easy to prove that the warrior "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" will be among "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" first warriors in some plan iff "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we can make a new array "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"). Then we build a segment tree on this array. The node of the segment tree will store all values of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" from the segment corresponding to this node (in sorted order). Then to get answer to the plan, we have to count the number of elements on segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] that are less than "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/422d3d7388062cd413ac98a0b5bed42c209e89c5a8564d61b195649c3c7644d8.png"},"kind":"image"},{"kind":"text","text":", or "},{"attrs":{"alt":"","src":"/editorial-assets/4237f553bf315cbc75f63dee3be515a20dce144717e1926cc4de7fef2470f7f8.png"},"kind":"image"},{"kind":"text","text":" if you use fractional cascading technique."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"813F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/813/problem/F"},"children":[{"kind":"text","text":"813F - Bipartite Checking"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If the edges were only added and not deleted, it would be a common problem that is solved with disjoint set union. All you need to do in that problem is implement a DSU which maintains not only the leader in the class of some vertex, but also the distance to this leader. Then, if we try to connect two vertices that have the same leader in DSU and the sum of distances to this leader is even, then we get a cycle with odd length, and graph is no longer bipartite."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But in this problem we need to somehow process removing edges from the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the algorithm I will describe below we will need to somehow remove the last added edge from DSU (or even some number of last added edges). How can we process that? Each time we change some variable in DSU, we can store an address of this variable and its previous value somewhere (for example, in a stack). Then to remove last added edge, we rollback these changes — we rewrite the previous values of the variables we changed by adding the last edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we can add a new edge and remove last added edge. All these operations cost ("},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":")) because we won't use path compression in DSU — path compression doesn't work in intended time if we have to rollback. Let's actually start solving the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For convinience, we change all information to queries like \"edge ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") exists from query number "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" till query number "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"\". It's obvious that there are no more than "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" such queries. Let's use divide-and-conquer technique to make a function that answers whether the graph is bipartite or not after every query from some segment of queries ["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"]. First of all, we add to DSU all the edges that are present in the whole segment (and not added yet); then we solve it recursively for "},{"attrs":{"alt":"","src":"/editorial-assets/c6939ceeab1ca857110f6765cb60d17910367318d52d7c4b46cf3433bc7d79e3.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/6d1ba717117d52ab6171d564d94405f513daf028ed060ba62d7e1e59f0c13c8a.png"},"kind":"image"},{"kind":"text","text":"; then we remove edges from DSU using the rollback technique described above. When we arrive to some segment ["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"], then after adding the edges present in this segment we can answer if the graph is bipartite after query "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Remember to get rid of the edges that are already added and the edges that are not present at all in the segment when you make a recursive call. Of course, to solve the whole problem, we need to call our function from segment [1, "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/b993b9140fa9ac9bdd78b3e5eb0121bc84f76608aa3fd7efca2e5af529ace274.png"},"kind":"image"},{"kind":"text","text":", because every edge will be added only in "},{"attrs":{"alt":"","src":"/editorial-assets/1e87664632afb960c1fbbf3cb6ef584e154208a8032594c74eb8c363ff1a50d0.png"},"kind":"image"},{"kind":"text","text":" calls of the function."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/52410"}