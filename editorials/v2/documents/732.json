xt","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (and to our answer), so Cormen has enough walks during days "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1. After we have iterated through all days, we can print the answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"732C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/732/problem/C"},"children":[{"kind":"text","text":"732C - Sanatorium"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's iterate on the time of day when Vasiliy arrived at the sanatorium (breakfast, dinner or supper) and on the time when Vasiliy left. We sum the changed values of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" (considering that we take all possible meals during the first and the last day) into the variable "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":", find "},{"children":[{"kind":"text","text":"mx"}],"kind":"emphasis"},{"kind":"text","text":" — the maximum of these three variables (also changed), and if our current answer is more than 3·"},{"children":[{"kind":"text","text":"mx"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":", we update it with this value. After considering all 9 possible scenarios, we print the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"const"}],"kind":"emphasis"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"const"}],"kind":"emphasis"},{"kind":"text","text":" = 3"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"732D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/732/problem/D"},"children":[{"kind":"text","text":"732D - Exams"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's use binary search to find the answer (the latest day when we have passed all the exams). To check whether we can pass all the exams until some fixed day "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", we will take all the examples as late as possible. We will prepare to the earliest exam, then to the second earliest, and so on. If we are not ready for some exam or if we don't pass them until the day "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ends, then we can't pass all the exams in time. After finishing our binary search we print the answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"mlogn"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"732E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/732/problem/E"},"children":[{"kind":"text","text":"732E - Sockets"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly, we need to sort both arrays (with computers and with sockets) in non-descending order (also we need to sustain their indices to print the answer). Then we iterate on the value "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" until it reaches the logarithm of the maximum value in "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" (or until it reaches 31). For each value of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" we iterate on computers in non-descending order, also we maintain the index of the most suitable socket (let's call this index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). If socket number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is already used or if its power is less than current computer's requirement, we increase "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". If our current socket's power matches current computer's requirement, then we connect this computer with current socket. Each iteration connects the largest possible number of computers and sockets. After each iteration we install adapters on all non\"=used sockets: "},{"attrs":{"alt":"","src":"/editorial-assets/5a6fa992334af5c143d6759886df6f704abff8d4101e304327cf89d9138cdb33.png"},"kind":"image"},{"kind":"text","text":". After all iterations we print the answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlogn"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"mlogm"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"logA"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" is the maximum power of socket."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"732F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/732/problem/F"},"children":[{"kind":"text","text":"732F - Tourist Reform"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly, we have to find all the bridges and divide the graph into 2\"=edge\"=connected components. Then we calculate the size of each component. It can be easily proved that the answer is equal to size of the largest component. Then we need to orient the edges somehow. Start DFS from any vertex of the largest component. If we traverse the edge ("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":") (coming from vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") and it has not been oriented yet, we orient it from "},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", if it's a bridge (so it leads to the largest component) or from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":" otherwise. When all vertices are visited and all edges are oriented, we can print the answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/47890"}