d":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/68aad1dab51b49c0b916c1e6ac1118e3638896a6beff3176f77c3a93e85cd171.png"},"kind":"image"},{"kind":"text","text":" are in the getting above restrictions. Complexity of this solution is "},{"attrs":{"alt":"","src":"/editorial-assets/41a1d1a0d683c745e2d379927f1cac93d3538a423dae57a2dfd98ffd85ea31ed.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39423481"},"children":[{"kind":"text","text":"39423481"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"(Idea of the problem — "},{"attrs":{"href":"https://codeforces.com/profile/----------"},"children":[{"kind":"text","text":"----------"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"problemCode":"992C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/992/problem/C"},"children":[{"kind":"text","text":"992C - Nastya and a Wardrobe"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's present we have initially "},{"attrs":{"alt":"","src":"/editorial-assets/ae52d3f87b76c93dcaef7d88a3c25889491d65b51ef9c31d44b0d09034c3468b.png"},"kind":"image"},{"kind":"text","text":" dresses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What does occur in the first month? Initially the number of dresses is multiplied by 2, that is becomes "},{"attrs":{"alt":"","src":"/editorial-assets/bcb5f95c5e60a1ca02a2b07e872b09d2dba20b5f511b63e8f761660ebcb9f50e.png"},"kind":"image"},{"kind":"text","text":". Then with probability "},{"attrs":{"alt":"","src":"/editorial-assets/d70c9a88eb147c341847e9cb393de8683718afd98d012e8bd8bd0e321b3471bb.png"},"kind":"image"},{"kind":"text","text":" the wardrobe eats a dress, that is expected value of the number of dresses becomes "},{"attrs":{"alt":"","src":"/editorial-assets/40fd433ba0a345de1a4ae6f1333fd6ac4f4dd624caa585a48fa90f91bd81ad67.png"},"kind":"image"},{"kind":"text","text":". The same way after the second month expected value becomes "},{"attrs":{"alt":"","src":"/editorial-assets/7761e77b0952c5b0e786eef70503db6e2205cd2b84ab3a774dbe89cd034f7795.png"},"kind":"image"},{"kind":"text","text":". It's easy to notice that after "},{"attrs":{"alt":"","src":"/editorial-assets/826e149ac8cce9a92f00e88cc51d9e17199b1eb82c476408ff00be5b068cf035.png"},"kind":"image"},{"kind":"text","text":"-th month(if "},{"attrs":{"alt":"","src":"/editorial-assets/b29dc4daacbdb9eaa2dab5f42c8e6aaeb8a2f60ab9defd4e96411abf67c6d084.png"},"kind":"image"},{"kind":"text","text":") expected value equals "},{"attrs":{"alt":"","src":"/editorial-assets/89435255f8c2fcba6fee8620f0c3e6e7363fe69fe43844dca578af2603397bd2.png"},"kind":"image"},{"kind":"text","text":". Eventually it will be only doubled(as the wardrobe doesn't eat a dress in the last month), that is will be equal "},{"attrs":{"alt":"","src":"/editorial-assets/248179a35607299b574498da082f523e89f72523d92c440e5723601ce03673d2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, answer of the problem is "},{"attrs":{"alt":"","src":"/editorial-assets/248179a35607299b574498da082f523e89f72523d92c440e5723601ce03673d2.png"},"kind":"image"},{"kind":"text","text":". Expressing it with "},{"attrs":{"alt":"","src":"/editorial-assets/b9583c1713995dd2da226c5d0e2a498bf7f858c4fd320086af658db6a83cfc8c.png"},"kind":"image"},{"kind":"text","text":", we get:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/130a660c8c3af0207e61e3a50225917ff925401aad66798bcb6f0dfb497b9fbf.png"},"kind":"image"},{"kind":"text","text":" = "},{"attrs":{"alt":"","src":"/editorial-assets/2e986cca49a96c63acf4673a2a8dfe3c68ef62d8db4712b2bc59510ccee61597.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/130a660c8c3af0207e61e3a50225917ff925401aad66798bcb6f0dfb497b9fbf.png"},"kind":"image"},{"kind":"text","text":" = "},{"attrs":{"alt":"","src":"/editorial-assets/0923f99f3e197ec63cfd1d3c09085cd5b8879e3132fefc77ee131b6ecd54d9cc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, we need to calculate degree of 2 right up to "},{"attrs":{"alt":"","src":"/editorial-assets/7ea58ce5dfd9bb447a772c28a8390d6340ef3efd5b66c459229ddab0d593fb81.png"},"kind":"image"},{"kind":"text","text":". Complexity of the soltion is "},{"attrs":{"alt":"","src":"/editorial-assets/a26e7ddb9462a9122e57c00c96d78888a9f2a97ff4660698774367c40a7fa22a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's notice that the case "},{"attrs":{"alt":"","src":"/editorial-assets/76089857bae0eddb2a28ca1a9305e71143952f9528792bb6a225629c0c4ccfea.png"},"kind":"image"},{"kind":"text","text":" we need to calculate separately, because wardrobe can't eat a dress when it doesn't exist. If "},{"attrs":{"alt":"","src":"/editorial-assets/9d0e640df84a5b2d7bd4c9bac4d2ad8e3dd614b4fd55d80d92a55463a8fa44f7.png"},"kind":"image"},{"kind":"text","text":" it's easy to proof that the number of dresses is never negative, that is the formula works."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39423497"},"children":[{"kind":"text","text":"39423497"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"(Idea of the problem — "},{"attrs":{"href":"https://codeforces.com/profile/DmitryGrigorev"},"children":[{"kind":"text","text":"DmitryGrigorev"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"problemCode":"992D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/992/problem/D"},"children":[{"kind":"text","text":"992D - Nastya and a Game"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's call numbers which are more than 1 as good. Notice the following fact:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If a subsegment is suitable, it contains not more than 60 good numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Indeed, let's assume that a subsegment contains more than 60 good numbers. In this subsegment "},{"attrs":{"alt":"","src":"/editorial-assets/329f6dd998c36415d12698b435d0ff48dd8499635168d75e91ebb50d46f80fc0.png"},"kind":"image"},{"kind":"text","text":". At the same time, as "},{"attrs":{"alt":"","src":"/editorial-assets/b31d019a6317c84e7fec7b6505ad3a94744f5d4b47a51f13b7b4380b13993398.png"},"kind":"image"},{"kind":"text","text":", and "},{"attrs":{"alt":"","src":"/editorial-assets/b9276ed928f0b15ab9a0dfbd1ca5b026cba263b9ea7550746331f7f7f014f669.png"},"kind":"image"},{"kind":"text","text":", there is "},{"attrs":{"alt":"","src":"/editorial-assets/cd24bb6c0f5244304e26535a15ce37de61a97ef44c7c6cf7f20089d99dd74c0d.png"},"kind":"image"},{"kind":"text","text":". Therefore, this subsegment can't be suitable due to "},{"attrs":{"alt":"","src":"/editorial-assets/ac1e1f87a494ce70bea1d0415a56e89622c214d2f7a9239d0ca0a3fc4b6bbba5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's keep all positions of good numbers in a sorted array. We sort out possible left border of a subsegment and then with binary search we find the next good number to the right of this left border. Then let's iterate from this found number to the right by the good numbers(that is we sort out the rightmost good number in a subsegment), until product of all numbers in the subsegment becomes more than "},{"attrs":{"alt":"","src":"/editorial-assets/8847fcccc1860fbb77172a896d7abc53fd32de310df6a9fea57fa960ce271bee.png"},"kind":"image"},{"kind":"text","text":" (it's flag which shows us, that product is too big for a suitable subsgment and we need to finish to iterate). We have shown above the number of iterations isn't more than 60. Now for sorted out the left border and the rightmost good number we only need to know the number of 1's which needs to be added to the right of the rightmost good number, as we can easily maintain sum and product in the subsegment during iterating. Then we need to check whether found number of 1's exists to the right of the rightmost good number. It can be checked if we look at the next good number's position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/42d151c6db42ca22fc58cba32c32bb2dee0f9ca40c97770dd927908643a4d786.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to check that "},{"attrs":{"alt":"","src":"/editorial-assets/117de5064f92523ac1ea0634f39a92bb33babc988e31727d41ab9507eee5cc4f.png"},"kind":"image"},{"kind":"text","text":" is more than "},{"attrs":{"alt":"","src":"/editorial-assets/8847fcccc1860fbb77172a896d7abc53fd32de310df6a9fea57fa960ce271bee.png"},"kind":"image"},{"kind":"text","text":", you shouldn't calculate "},{"attrs":{"alt":"","src":"/editorial-assets/90d023b63b13a820179a79d2bd899daaae375ad268b29ecc7988c7fe28e7feb6.png"},"kind":"image"},{"kind":"text","text":" multiply by "},{"attrs":{"alt":"","src":"/editorial-assets/6fb7d8cc124a734c9fd88c8239db9f26fd69a01dbb31e34aeff985e7996fa30c.png"},"kind":"image"},{"kind":"text","text":", due to overflow. You must only check that "},{"attrs":{"alt":"","src":"/editorial-assets/10ce8388650a870e37572156759d7d93111fead9a10f86d614225794f1bc7bb6.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"(Idea of the problem — "},{"attrs":{"href":"https://codeforces.com/profile/DmitryGrigorev"},"children":[{"kind":"text","text":"DmitryGrigorev"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39423501"},"children":[{"kind":"text","text":"39423501"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"992E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/992/problem/E"},"children":[{"kind":"text","text":"992E - Nastya and King-Shamans"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This problem was inspired by idea which was offered by my unbelievable girlfriend :)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution I"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem we maintain two segment trees - with maximum and with sum. After every query we recalculate these trees in "},{"attrs":{"alt":"","src":"/editorial-assets/a46ee6d40983c8cdd2516d54a81d90e3066a94d8a3beb0ba06a9fc4a7f38057e.png"},"kind":"image"},{"kind":"text","text":" for a query. Now we only have to understand, how to answer for a query? Let's call a prefix of the array as good in the case if we surely know that it doesn't contain a king-shaman. So either the first shaman is king and we are able to answer for the query, or we call the prefix with length 1 as good. Then let's repeat the following operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" We call "},{"attrs":{"alt":"","src":"/editorial-assets/8fb886c2520cc4c3276f25cb1fea7b30eeb3c999c204abed7c7dc7df33560a91.png"},"kind":"image"},{"kind":"text","text":" as sum in the good prefix now. We find it using the segment tree with sums. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We find the leftmost element which may be king-shaman yet. We can realise that it's the leftmost element, which doesn't lie in the good prefix (as there isn't king-shaman according the definition), which have a value at least "},{"attrs":{"alt":"","src":"/editorial-assets/8fb886c2520cc4c3276f25cb1fea7b30eeb3c999c204abed7c7dc7df33560a91.png"},"kind":"image"},{"kind":"text","text":". It can be done using segment tree with maximums, with descent. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We check if this found shaman is king. If isn't, we can say that the good prefix finishes in this shaman now, because it was the leftmost shaman who might be king. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Every operation works in "},{"attrs":{"alt":"","src":"/editorial-assets/a46ee6d40983c8cdd2516d54a81d90e3066a94d8a3beb0ba06a9fc4a7f38057e.png"},"kind":"image"},{"kind":"text","text":". Let's notice, that one operation increases sum in the good prefix at least by two times. So, after "},{"attrs":{"alt":"","src":"/editorial-assets/dd408c78a3331f4fa7d56b06c4df1580be087cad858eaee6d7fd09566a01a104.png"},"kind":"image"},{"kind":"text","text":" operations sum in the good prefix will become more than a maximal possible number in the array, so that we will be able to finish, because we will be sure that answer will be -1. Complexity of the solution is "},{"attrs":{"alt":"","src":"/editorial-assets/4891ed69020e4cd3cffd9c8d3c95f145f061632a007bceeb2c24c5cabc82e291.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution II"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the prefix sums of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". We're gonna introduce "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 2·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and reformulate the queries using these new terms."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Imagine we wanna change the value at "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":". Let δ = "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will decrease by δ whereas "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will increase by δ. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Imagine we wanna find the answer. Then it's sufficient to find any "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" satisfying "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Split "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" into blocks of size "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". Each block will be comprised of pairs ("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") sorted by "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":". At the same time we will maintain "},{"children":[{"kind":"text","text":"overhead"}],"kind":"emphasis"},{"kind":"text","text":" array responsible for lazy additions to blocks. How does this help?"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Let "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". The goal is to find the position of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", decrease its value and increase values for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" within this block. It can be done in a smart way in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":") (actually, this can be represented as merging sorted vectors). You should also take care of the tail, i.e add δ to "},{"children":[{"kind":"text","text":"overhead"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":") time. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We're asked to find such "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"overhead"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0. All blocks are sorted, thus we can simply apply binary search in "},{"attrs":{"alt":"","src":"/editorial-assets/86bac002cd0845072aba056c3a02617251c2b263bfd27236af82b344c546cbe0.png"},"kind":"image"},{"kind":"text","text":" overall. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The optimal assignment is "},{"attrs":{"alt":"","src":"/editorial-assets/580d22b5a49954be22a8b187c47fe6252af02e695a1d1ee413b9cebef1a5a603.png"},"kind":"image"},{"kind":"text","text":" which results into "},{"attrs":{"alt":"","src":"/editorial-assets/45e910e89668541ae2d7b04fda8a339e03f07983e6605c3749556840421f2ce3.png"},"kind":"image"},{"kind":"text","text":" total runtime. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The huge advantage of this approach is its independency from constraints on "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" (i.e non-negativity). Although we didn't succeed in squeezing this into TL :)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution III"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Group the numbers according to their highest bits (with groups of the form [2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"... 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":"] and separately for zeros). Inside each groups (no more than "},{"attrs":{"alt":"","src":"/editorial-assets/f4501b2de12f1d685f1a9f0fc92ecfc5fd3dd9bdf7d1a69d522cbcc0a715e0c7.png"},"kind":"image"},{"kind":"text","text":" of them) we maintain elements in increasing order of indexes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to see that each group contains no more than two candidates for answer (since their sum is guaranteed to be greater than any of the remaining ones). This observation leads to an easy solution in "},{"attrs":{"alt":"","src":"/editorial-assets/f1512fb9dd42ce7fb5a1106fd2417a84ec9f3dbd602b4fdb0367d3c5fe734727.png"},"kind":"image"},{"kind":"text","text":" — we iterate over groups and check prefix sums for these candidates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There's actually further space for optimizations. Let's maintain prefix sums for our candidates — this allows us to get rid of the extra log when quering the tree. Almost everything we need at this step is to somehow process additions and deletions — change the order inside two blocks and probably recalculate prefix sums. The only thing left is to stay aware of prefix sum changes for the remaining blocks. Luckily, they can be fixed in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) per block (if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" then the sum increases by "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and stays the same otherwise). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The resulting comlexity is "},{"attrs":{"alt":"","src":"/editorial-assets/d9cad6669f3371107f303dcb1a3ca236621bd1cf9dda03ecfe0241b8cec5fac6.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code of the solution I — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39423519"},"children":[{"kind":"text","text":"39423519"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code of the solution II — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39418926"},"children":[{"kind":"text","text":"39418926"}],"kind":"link"},{"kind":"text","text":". Try to optimize :)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thank you "},{"attrs":{"href":"https://codeforces.com/profile/tfg"},"children":[{"kind":"text","text":"tfg"}],"kind":"link"},{"kind":"text","text":" for the idea and the code of the solution III. Very good job!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code of the solution III — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39392321"},"children":[{"kind":"text","text":"39392321"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/60083"}