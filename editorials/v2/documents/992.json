fee728aff97.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code — "},{"attrs":{"href":"https://codeforces.com/contest/992/submission/39423470"},"children":[{"kind":"text","text":"39423470"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"(Idea of the problem — "},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"attrs":{"problemCode":"992B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/992/problem/B"},"children":[{"kind":"text","text":"992B - Nastya Studies Informatics"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's consider some suitable pair "},{"attrs":{"alt":"","src":"/editorial-assets/35435cb870dffb391b914daf946448ae1540f1c5696d988409bdaeb94ab3d128.png"},"kind":"image"},{"kind":"text","text":". As "},{"attrs":{"alt":"","src":"/editorial-assets/0567ca6fb5678984876917d96c37380c8e66775ce0d970f6c60e49c19cd07261.png"},"kind":"image"},{"kind":"text","text":", we can present number "},{"attrs":{"alt":"","src":"/editorial-assets/90d023b63b13a820179a79d2bd899daaae375ad268b29ecc7988c7fe28e7feb6.png"},"kind":"image"},{"kind":"text","text":" as "},{"attrs":{"alt":"","src":"/editorial-assets/75503953131a099c35b05e8afb5e8d0496a78d434549d31f6ab8a20786e4d56a.png"},"kind":"image"},{"kind":"text","text":", and number "},{"attrs":{"alt":"","src":"/editorial-assets/6fb7d8cc124a734c9fd88c8239db9f26fd69a01dbb31e34aeff985e7996fa30c.png"},"kind":"image"},{"kind":"text","text":" as "},{"attrs":{"alt":"","src":"/editorial-assets/4610bce86ae30a9e304401a9317da65efe4c5a9ae06dc84e7b67ea13871c1abe.png"},"kind":"image"},{"kind":"text","text":", where we know that "},{"attrs":{"alt":"","src":"/editorial-assets/8244219d0328054db956a58f4e8fb6f7