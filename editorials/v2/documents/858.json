{"assets":["/editorial-assets/5892acbe534b0671175f40412c82c70ff28a589209b4cecd9b20c72db27bdce7.png","/editorial-assets/0330493386eab8de581e4ccf7079cbcc15ff038752c19f24492fcdf8c8148e6c.png","/editorial-assets/d78bfe50eb074f36d86ad1bc6153a370b8c474a44b33b4a8d8c62b84b2ea5f15.png","/editorial-assets/fa0d3f4f3f91d89e751c4efa54bdb2acd84fe9b204d416f5059b89db7f70b778.png","/editorial-assets/1d070aa57b3792895e2901c76b837f61253ac0415ec6a53d8458da330cd194e9.png","/editorial-assets/bbe2e52775a4fed3b177fd9165aff525f260e653f610d9bbae7f78b447a4181d.png"],"contestId":"858","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"858A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/A"},"children":[{"kind":"text","text":"858A - k-rounding"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Notice that the number "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ends with "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" or more zeros if the maximal power of 2 that is a divisor of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and the maximal power of 5 that is a divisor of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Let's calculate the maximal powers of 2 and 5 that are divisors of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". If any of the powers is less than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" then multiply the number by appropriate number of 2 and 5."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer is also "},{"children":[{"kind":"text","text":"LCM"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"858B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/B"},"children":[{"kind":"text","text":"858B - Which floor?"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We will store our current answer in some variable "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":". Initially it is -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's iterate over the quantity of the flats on each floor (it will be from 1 to 100 inclusive). Let it be "},{"children":[{"kind":"text","text":"cf"}],"kind":"emphasis"},{"kind":"text","text":". Then we have to check that this quantity coincides with given input. If "},{"attrs":{"alt":"","src":"/editorial-assets/5892acbe534b0671175f40412c82c70ff28a589209b4cecd9b20c72db27bdce7.png"},"kind":"image"},{"kind":"text","text":" for any "},{"attrs":{"alt":"","src":"/editorial-assets/0330493386eab8de581e4ccf7079cbcc15ff038752c19f24492fcdf8c8148e6c.png"},"kind":"image"},{"kind":"text","text":" then this quantity is incorrect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now if "},{"attrs":{"alt":"","src":"/editorial-assets/d78bfe50eb074f36d86ad1bc6153a370b8c474a44b33b4a8d8c62b84b2ea5f15.png"},"kind":"image"},{"kind":"text","text":" then we can't determine on which floor flat "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is situated. Print -1. In the other case set "},{"attrs":{"alt":"","src":"/editorial-assets/fa0d3f4f3f91d89e751c4efa54bdb2acd84fe9b204d416f5059b89db7f70b778.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"858C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/C"},"children":[{"kind":"text","text":"858C - Did you mean..."}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We will solve the problem greedily. Let's find the leftmost typo. It will be three consecutive characters "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" such that all of them are consonants and there are at least two diffirent letters. It is clear that we can cut this string after position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", because prefix will be correct and we will leave only one letter in the remaining part of the string. So each time we find the leftmost typo and cut out the prefix. Remember that after cutting the prefix you have to continue checking from index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 2, not "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"858D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/D"},"children":[{"kind":"text","text":"858D - Polycarp's phone book"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Find the shortest substring of each string such that it doesn't appear in any other string as a substring. For each substring let's store the index of the string which contains this substring or  - 1 if there are more than one such string. Iterate over all substrings which have values that are not  - 1 and update the answer for the corresponding string."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"858E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/E"},"children":[{"kind":"text","text":"858E - Tests Renumeration"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly we will get rid of all tests that are already named correctly. After this, let's call samples \"tests of 1 type\", and system tests \"tests of 2 type\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote \"free positions\" such indices "},{"attrs":{"alt":"","src":"/editorial-assets/1d070aa57b3792895e2901c76b837f61253ac0415ec6a53d8458da330cd194e9.png"},"kind":"image"},{"kind":"text","text":" such that there is currently no test with the name "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". If there are no any free positions, then we can't rename each test using only one operation "},{"children":[{"kind":"text","text":"move"}],"kind":"emphasis"},{"kind":"text","text":" because firstly we have to make its index a free position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's show that one free position is always enough. If there is one, then let's put some test of the corresponding type which has wrong name (a name that doesn't coincide with its type) into this position. It is clear that there will be at least one such test — otherwise all tests of corresponding type are at their positions, and there is no free position of this type. Then there are two cases — either we free a correct position (then we will have another free position) or we move a test which had illegal name (so we don't create any free positions)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's better to move a test which occupies some position so we will have a new free position after it. It is clear that when there are no tests such that their names are correct numbers, but they are in position of different type, then we can't keep the quantity of free positions as it is, and after moving any test this quantity will decrease."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This approach is optimal because we will have to perform either "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" is the number of tests that aren't correctly named initially) or "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" + 1 operations. "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" + 1 will be the answer only if we have to make an operation that will create a free position (if there are no free positions initially)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This number of operations is optimal because if we have "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" incorrectly named tests, then we can't rename them in less than "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" operations; and this is possible only if we have at least one free position initially; otherwise we have to free some position."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"858F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/858/problem/F"},"children":[{"kind":"text","text":"858F - Wizard's Tour"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Obviously the task can be solved independently for each component. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is the algorithm that allows you to reach exactly "},{"attrs":{"alt":"","src":"/editorial-assets/bbe2e52775a4fed3b177fd9165aff525f260e653f610d9bbae7f78b447a4181d.png"},"kind":"image"},{"kind":"text","text":" tours, where "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is the number of edges in the component. Let's take arbitrary tree built by depth-first search. While exiting vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", we can process all the edges to the vertices with greater height and the edge connecting vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to its parent in the tree (if "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" isn't a root). If the number of edges to the lower vertices is even then we can split then into pairs. Otherwise let's add the edge from the parent to this splitting and not handle it for the parent itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This algorithm will find the pair to every edge for all the vertices but the root. There will be at most one edge without the pair so the answer is maximal."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"860E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/860/problem/E"},"children":[{"kind":"text","text":"860E - Arkady and a Nobody-men"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" First of all, "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"parent"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]] + "},{"children":[{"kind":"text","text":"depth"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"], where "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] is the sum of (number of descendants of the rank depth[v]) for all predecessors of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". All we need is to compute "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] now. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's make a dfs in the graph. Let the dfs(v) return a vector "},{"children":[{"kind":"text","text":"ret"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] such that "},{"children":[{"kind":"text","text":"ret"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"] is the following tuple: (number of vertices on depth "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" in subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", some vertex "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" with depth "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" in the subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", the "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] if we consider only predecessors in the subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"). Also let's build some structure so that we can easily restore answers in this subtree if we know the final value of "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]. We will see what is this structure later. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" To compute "},{"children":[{"kind":"text","text":"ret"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] we need to be able to merge two "},{"children":[{"kind":"text","text":"ret"}],"kind":"emphasis"},{"kind":"text","text":"s of its sons. Let's say we merge tuple ("},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"]) with ("},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"]). Then all we need to do is: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"] +  = "},{"children":[{"kind":"text","text":"depth"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"] +  = "},{"children":[{"kind":"text","text":"depth"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" return ("},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"]) as the result. "}],"kind":"list_item"},{"kind":"text","text":" However, we must also be able to restore "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"] after the dfs is complete (remind the unknown structure). So after performing "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"] +  = "},{"children":[{"kind":"text","text":"depth"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" let's add an edge "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" → "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" to a new graph with weight "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"]. Note that the difference between these values will be the same all the time after the tuples are merged, so using this edge we will be able to restore the answer "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"]. "},{"children":[{"kind":"text","text":" After the dfs is done, run another dfs on the new graph to restore the values "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] and then "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" To perform the second step fast, we need to note that we can always merge smaller "},{"children":[{"kind":"text","text":"ret"}],"kind":"emphasis"},{"kind":"text","text":"s into larger, and move them in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) into parents. Since each tuple is merged into a larger vector only once, this solution works in total in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/54604"}