sset"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/xnq9Iu"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/D2hHEL"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem can be also solved by rotating vector (1, 0) by angle "},{"attrs":{"alt":"","src":"/editorial-assets/d483f691fbcc671a64c6355871ae0588110e7327fe0bc24bdd47a73bd91f18ee.png"},"kind":"image"},{"kind":"text","text":" until it returns in this position (but at most 360 times), and checking that only one full turn has been made (implementation example: C++)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is also a rare problem on Codeforces that contains just 1 sample test, 1 pretest and 1 full test."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/270/problem/B"},"children":[{"kind":"text","text":"Div II B — Multithreading"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"In this problem we are asked to find the number of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"-permutation elements that definitely have been moved after performing any sequence of move-to-front element operations. Equally, we should find the maximum possible number of elements that could have not been moved."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"If some "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is greater than "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":", it is clear that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" definitely contains a new message because the order of these two elements has changed. Let the last such element be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then all of the elements "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" can contain no new messages, since their order has not changed. The answer to the problem is "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". If there is no such "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the order hasn’t changed at all and there may be no new messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") / "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/PJFbnJ"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/0DR19E"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was born while staring at the Codeforces main page and trying to think up an easy Div II problem. =)"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/269/problem/A"},"children":[{"kind":"text","text":"Div II C / Div I A — Magical Boxes"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"We are given "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" squares with side length 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":". It is allowed to insert squares only inside larger ones, and no two squares should overlap. We must determine the minimum "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" so we can place all the given squares inside a square with side length 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"Suppose we can put all the squares inside a square with side length 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". Then we can insert each "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" type squares independently along the grid as shown in the picture. No two squares will overlap, since 2"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" divides 2"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". That means that we can find the smallest square that can hold all the given squares with side length 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" for each "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" separately. The answer will be the side length of the largest such square."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" "},"kind":"missing_asset"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To be able to put "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" squares with side length 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" inside a square with side length 2"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", the following should hold:"}],"kind":"paragraph"},{"kind":"text","text":"(2"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" ≥ (2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" 4"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" ≥ 4"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" 4"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"kind":"text","text":"We can then find the minimum "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/55043345a48420f36dab36cffd0c0c1f3b4905d6ec479aadca734a4a9fcb0d2f.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/15190ecf3c3b873412670911fc0ba5f92f17b45e923202755a145f267ff693e9.png"},"kind":"image"},{"children":[{"kind":"text","text":"In a special case, if we obtain "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" should be increased by 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"attrs":{"alt":"","src":"/editorial-assets/0ee765d6a2cfbe7ba887e322f8d8236bfa5fed376fd08a44f403d59245baba4d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/NORd3X"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/Zp7Nno"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem can be also solved using binary search on "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":". However, we can see that each square with side length 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 15"}],"kind":"superscript"},{"kind":"text","text":" holds any number of squares with side length less than 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", since "},{"attrs":{"alt":"","src":"/editorial-assets/3e4186b28d5aa5f75c7bc7aa37a928182045a89924910d9ac5e37b0600ba26fa.png"},"kind":"image"},{"kind":"text","text":". So it is enough to find the first square that fits from range 2"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"{"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"} + 1"}],"kind":"superscript"},{"kind":"text","text":" to 2"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"{"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"} + 15"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/269/problem/B"},"children":[{"kind":"text","text":"Div II D / Div I B — Greenhouse Effect"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" points on the line, each of type from 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". We can freely divide the line into "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - 1 intervals and replace some points so each point with type "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is inside the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th interval numbered 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" from left to right. We must find the minimum number of points to replace."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"First, observe that the coordinates don’t matter: only the order of the points is important. Let there be some number of points we can replace to achieve the good arrangement. Then all the other points remain in their positions, so their values must be in increasing order from left to right. Then we must find the maximum number of points that can remain in their positions, which is the longest non-decreasing subsequence of types in the input. If it is of length "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", the answer is "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem it was enough to implement a quadratic solution. We count "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — the length of the longest non-decreasing subsequence on prefix [1;"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], with element of type "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" being the last in subsequence. The transition is as follows:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/2610ea6c1f71a860b4fdbaacfabf4d0def78c1065aa59af890690a62768b443c.png"},"kind":"image"},{"children":[{"kind":"text","text":"For easy implementation, we can maintain only array "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"], and skip the second case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") / "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") / "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/8uzrrr"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"We had to solve this problem during the work on our project, the origin lies in arranging some rectangular table borders. Our original project dp implementation actually runs in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/269/problem/C"},"children":[{"kind":"text","text":"Div II E / Div I C — Flawed Flow"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"In this problem we are given an undirected graph and its flow, and we must reconstruct the edge directions of this flow."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"The key element to solving the task is the following observation: if we know all the incoming edges of a vertex, all the remaining edges must be outgoing. The source has no incoming edges, so we already know that all its edges are outgoing. For all other vertices except the sink the amount of incoming and outcoming flow is the same, and is equal to half of the sum of the flow along its incident edges. The algorithm then is to repeatedly direct all the flow from the vertices for which all the incoming edges are known. This can be done with a single BFS:"}],"kind":"paragraph"},{"kind":"code_block","text":"for all v from 2 to n-1\n    f[v] := sum(flow(v,u))/2;\nput source in queue\nwhile queue is not empty\n    v := pop(queue)\n    for all edges (v, u)\n        if (v, u) is not directed yet\n            direct v -> u\n            f[u] = f[u] - flow(v,u)\n            if u not sink and f[u] = 0\n                push(queue, u)\n"},{"children":[{"kind":"text","text":"As the flow contains no cycles, we can sort the vertices topologically. Then we can be sure that, until all edge directions are known, we can put at least the first vertex with unknown edges in the queue, as all of its incoming edges will be from vertices with lower indices, but we took the first vertex with unknown edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/ePdlwd"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/qE3vYO"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"The obvious \"easy\" solution is to run some maxflow algorithm and get the answer. However, such implementations failed on anti-maxflow pretest #6."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/269/problem/D"},"children":[{"kind":"text","text":"Div I D — Maximum Waterfall"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"We are given "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" horizontal segments on a plane, and 2 extra topmost and bottommost segments. These two segments are the source and the sink of the flow. A flow can pass from one segment to a lower segment, if their horizontal projections overlap and there is no other segment between them so their projections overlap. The value of the flow on such segment edge is equal to the length of the horizontal projection overlap. We must find the maximum possible value of the flow along a single segment path."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"We will use a sweepline algorithm to solve this task. This horizontal sweepline runs from bottom to top, and holds the parts of the segments that are visible from the line this sweepline is currently at. Each part also holds the reference to its original segment. The sweepline itself is implemented with a binary search tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The events of the sweep are the segments. When a new segment is found, we want to find all the lower segments that we can direct the flow onto from this segment. These can be only the original segments of the parts currently in the sweepline whose projections overlap with this segment. Then we iterate over all such parts "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" (finding the first such part is an "},{"attrs":{"alt":"","src":"/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png"},"kind":"image"},{"kind":"text","text":" operation). How do we know that we can direct the flow onto "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"? Observe that if there is some segment that prevents this, there should be also a part "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" in the sweepline that also can be seen from the current segment. And since the projections of all three segments overlap, this part can only be directly to the left or to the right of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" in the binary search tree. So we just check whether the original segments of the two parts next to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" prevent the flow from the current segment to the original segment of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Afterwards, we remove all such parts from the sweepline, and insert a new part corresponding to the new segment. If the new segment only partially covered an existing part, we reinsert the remaining portion of that part. There are at most two such portions — one on each side of the segment. Thus each segment inserts at most 3 new parts and the size of the sweepline is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Each part is handled just once before removal, so the total time of such operations is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once we know we can direct the flow through "},{"attrs":{"alt":"","src":"/editorial-assets/bf4b22aeadcfd22fcaba8726b3c16da7b6de9778e14f93ec0a4158937bdf877e.png"},"kind":"image"},{"kind":"text","text":" we can immediately update the maximum downwards flow of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")))"},{"children":[{"kind":"text","text":"When we reach the top, "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"top"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be the answer."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" "},"kind":"missing_asset"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/bka28U"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/frmAwe"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"Another problem from our project. You can also first build a graph from the segments using the same sweepline and then find the path with the maximum flow in that graph. In the original problem you have to find this graph and there are no top and bottom segments."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/269/problem/E"},"children":[{"kind":"text","text":"Div I E — String Theory"}],"kind":"link"}],"kind":"heading"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Problem"}],"kind":"heading"},{"children":[{"kind":"text","text":"In this problem we have an "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" rectange. Each unit midpoint is connected with a segment to some other midpoint not on the same side of the rectangle. We can change the order of the columns and rows, but the segments must remain attached to their midpoints. We should find such a rearrangement that no two segments intersect, or tell that there is no solution."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Solution"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are overall 6 types of segments that connect the sides:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"left-top;"}],"kind":"list_item"},{"children":[{"kind":"text","text":"top-right;"}],"kind":"list_item"},{"children":[{"kind":"text","text":"right-bottom;"}],"kind":"list_item"},{"children":[{"kind":"text","text":"bottom-left;"}],"kind":"list_item"},{"children":[{"kind":"text","text":"left-right;"}],"kind":"list_item"},{"children":[{"kind":"text","text":"top-bottom;"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are both left-right and top-bottom segments, there is no solution. Otherwise there remain only 5 types of segments. Without loss of generality suppose there are no left-right segments. Let’s take a closer look at what should the end picture of the rectangle be:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" "},"kind":"missing_asset"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All left-top segments should be at the left top corner connecting positions (L,i) and (T,i), otherwise they surely would cross some other segment. Similarly must be positioned top-right, right-bottom, bottom-left segments. Finally, all top-bottom segments should be parallel. We also observe that the number of left-top segments must be equal to the number of right-bottom segments and the number of top-right segments should be equal to the number of bottom-right segments. Thus the important observation: the picture of the end arrangement is unique and can be determined from the input simply by counting the number of segments of each type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next we define a cycle to be the sequence of segments, where the second midpoint of some segment in the cycle is equal to the first midpoint in the next segment in the cycle. In the given example there are two such cycles (but the direction of each cycle actually matters):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" "},"kind":"missing_asset"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we observe that the set of the cycles does not change with any permutation by the definition of the cycle. We can make a sketch of the solution: we should find the cycle sets in the given arrangement and in the end arrangement, and compare them for equality."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At this point we actually find all the cycles in both arrangements. There are only two types of cycles:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"(left-top) "},{"attrs":{"alt":"","src":"/editorial-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (top-right) "},{"attrs":{"alt":"","src":"/editorial-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (right-bottom) "},{"attrs":{"alt":"","src":"/editorial-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (bottom-left);"}],"kind":"list_item"},{"children":[{"kind":"text","text":"other cycles."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can easily check whether the sets of first type cycles match, since the length of such cycles is 4. If they match, we rearrange the columns and rows involved to match the end arrangement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How to compare the remaining cycles. Consider a following example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/f0d6298849135a7e692bd1580c691c54d55fab3593a30b2f77635b6e6ad550c0.jpg"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the difference in the number of left-top and left-bottom segments be "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", and this number plus the number of top-bottom segments "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". If we enumerate the midpoints as in the figure, we can see that each top midpoint "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is connected to the bottom midpoint "},{"attrs":{"alt":"","src":"/editorial-assets/faed8e8cc73bc72af7f3b7820ae9d8fe63c955b0253ff08e135eca7c2f0fbdb8.png"},"kind":"image"},{"kind":"text","text":" (top-right segments continue as corresponding left-bottom segments). Thus we can describe it as a permutation"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/e444415cf0993a4640ce252cc85b96efa83415d09537ca46ba18f0d5b33e895d.png"},"kind":"image"},{"children":[{"kind":"text","text":"Our cycles correspond to the cycles in this permutation, with top-right segment continuation to left-bottom segment corresponding to the case where permutation cycle element decreases. It is known that the number of such permutations is "},{"attrs":{"alt":"","src":"/editorial-assets/eac06254b467d57db89caf503ca1b19e7ec5fcc41ea3d8eac39cf9bdbc8857f8.png"},"kind":"image"},{"kind":"text","text":" and their length is "},{"attrs":{"alt":"","src":"/editorial-assets/a9301fce1185af362ba38b187ae7fa4b175a0c0f823d860647184820a3c353e0.png"},"kind":"image"},{"kind":"text","text":". So all these cycles have the same length. Denote the remaining segment types as some letters (in picture A, B, C). Then not only the length, but the strings describing the cycles are also the same, but can be shifted cyclically (here the direction of the cycles also is important). Besides, we know this string from the correct arrangement cycle. Thus we need to compare all the remaining given arrangement cycle strings to this string, considering cyclic shifts as invariant transformations. For each string this can be done in linear time, for example, using the Knuth-Morris-Pratt algorithm. When we find a cyclical shift for each cycle, we can position its relevant columns and rows according to the end arrangement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Memory: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implementation: "},{"attrs":{"href":"http://ideone.com/bm0GQP"},"children":[{"kind":"text","text":"C++"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"http://ideone.com/QYJR6c"},"children":[{"kind":"text","text":"Java"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Comments"}],"kind":"heading"},{"children":[{"kind":"text","text":"This is a total killer task for coding. It took both of us around 5 hours to code the implementation. Congratulations again to "},{"attrs":{"href":"https://codeforces.com/profile/kelvin"},"children":[{"kind":"text","text":"kelvin"}],"kind":"link"},{"kind":"text","text":", at the time of writing still the only one to solve the problem (and of course to anyone who will get this difficult problem accepted =) )."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/6596"}