{"assets":["/editorial-assets/1b80c729450741467cc541b7ab1e54c6be7b6db5bb08a7a2411452334d091d0e.png","/editorial-assets/ac46c8b46d788a0523ff1448b313d179d276cc92924df1e9ce64fbfa2b32be1c.png","/editorial-assets/aa2e7e4936a428d98f46d5f72f429e0b99a5f50d840aeae9b2ea69a204ab771d.png","/editorial-assets/bb63c8c0e7f8992a71fd3e843218366993a83b01df10d77283f70c0d18a6e029.png","/editorial-assets/91d62a0fb3a7cbbf2ef70c092422b72021153426243d9b82af17aed2e58edc70.png","/editorial-assets/c940bf3b60a0ad32e7015828f7fe9aac35d0ceb80944c0b210bc8462c26782df.png","/editorial-assets/5c0680e6ce2b39e3641c5acc06c2b525ba9b8158affb9f7d336cfeb972b5cd07.png","/editorial-assets/4514d1612019b5d4f7cf902b6eb248a60b6d3aa25c1eb95d6fc0d97f42d3f4fe.png","/editorial-assets/f140f8a0911228ce7cb4d1f5add11bf93c37146686a7884a180d2533e1d79028.png","/editorial-assets/c153a676edde2f3b72c27a108598aaf5796ae54754054685116cb42122f76558.png","/editorial-assets/a38598de942325cff619baec6f5f16c9e86ff9ac1fc1193d5d9bbd9172c97035.png","/editorial-assets/5558a14d7de69b6c4c4deac4462dbdf18509550a2ff971588d54295e69f1ab74.png","/editorial-assets/a8f6f2790d016470191b7eb8e7c51a6e3d18901c0a3b6e45ab9539bccb69775a.png","/editorial-assets/581906bb76e4cecd7cc6dd18591213e0499d2039105eb5548cb29256bdb165bb.png","/editorial-assets/e0255194e970e3b8cc7b8656504cad8baa863bd7b7ad590104e5d3b48bd50911.png","/editorial-assets/e232c4ef9c75397d89cbb87c2ed2875a9ce6f70c15d351ad8f600e5f9832561b.png","/editorial-assets/9f37891d0d7816fb534a78046bef9ce5c478b86af2d57d547abef9876b0c9047.png","/editorial-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"],"contestId":"912","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"We, the round authors, are eternally grateful to all the brave who took part in this round. Sadly there were some issues to encounter, but we hope it only made the contest more interesting :)"}],"kind":"paragraph"},{"attrs":{"problemCode":"912A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/912/problem/A"},"children":[{"kind":"text","text":"912A - Tricky Alchemy"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Note that the crystals of each color are bought independently. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One needs 2·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" yellow and 3·"},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" blue crystals. The answer therefore is "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, 2·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, 3·"},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author — "},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code: "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946912"},"children":[{"kind":"text","text":"33946912"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"912B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/912/problem/B"},"children":[{"kind":"text","text":"912B - New Year's Eve"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1, the answer is "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, let's take a look at the most significant bit of answer and denote it by "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" (with the 0-th bit being the least possible). It must be the same as the most significant bit of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". This means the answer cannot exceed 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the numbers 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" and 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" - 1. Obviously, they both do not exceed "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". At the same time, their xor is 2"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":" - 1. Hence, the maximum answer can always be obtained if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" > 1."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author — "},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code: "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946939"},"children":[{"kind":"text","text":"33946939"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"912C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/912/problem/C"},"children":[{"kind":"text","text":"912C - Perun, Ult!"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The statement almost directly states the formula for the answer — it is calculated as "},{"attrs":{"alt":"","src":"/editorial-assets/1b80c729450741467cc541b7ab1e54c6be7b6db5bb08a7a2411452334d091d0e.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") is amount of enemies we can kill at "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"-th second. Thus, we need to learn how to calculate "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") and find such values of "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" that are potential candidates for the point the maximum is achieved at."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, let's consider the case we have no enemies with maximum health exceeding "},{"attrs":{"alt":"","src":"/editorial-assets/ac46c8b46d788a0523ff1448b313d179d276cc92924df1e9ce64fbfa2b32be1c.png"},"kind":"image"},{"kind":"text","text":". Additionally, let "},{"attrs":{"alt":"","src":"/editorial-assets/aa2e7e4936a428d98f46d5f72f429e0b99a5f50d840aeae9b2ea69a204ab771d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, how we can calculate "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":")? Let's model the process. There are three kinds of events that affect its value: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Some enemy has his health updated, it is now less than or equal to "},{"attrs":{"alt":"","src":"/editorial-assets/ac46c8b46d788a0523ff1448b313d179d276cc92924df1e9ce64fbfa2b32be1c.png"},"kind":"image"},{"kind":"text","text":", thus we can kill the enemy; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Some enemy has his health updated, it is now greater than "},{"attrs":{"alt":"","src":"/editorial-assets/ac46c8b46d788a0523ff1448b313d179d276cc92924df1e9ce64fbfa2b32be1c.png"},"kind":"image"},{"kind":"text","text":", thus we can't kill the enemy; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The enemy has regenerated enough health to become invincible again. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"One can observe that the optimal answer is reached at the second exactly preceeding the events of the second and the third kind. Indeed, otherwise we can move on to the next second: the bounty is increased and "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") doesn't decrease, thus providing us with a better answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What remains for us is to calculate the time when the aforementioned events occur to run scanline. The first two kinds correspond directly to the updates (and initial values — we can treat them as updates occuring at zeroth second). Let's calculate when the events of third kind would occur. Let the second "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" be the moment when one of the enemies' health became equal to "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" be the regeneration rate of the enemy. At the second "},{"attrs":{"alt":"","src":"/editorial-assets/bb63c8c0e7f8992a71fd3e843218366993a83b01df10d77283f70c0d18a6e029.png"},"kind":"image"},{"kind":"text","text":" he will regenerate enough health to become invincible again. One also needs take care of the case when "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" = 0: if there are no health updates after the enemy became killable, one can kill him at any moment and earn infinitely large amount of money. Note that one should need when did the last event of the first kind happen as updates cancel the potentially planned events of the third kind."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, consider the case when some enemy has maximum health less than or equal to "},{"attrs":{"alt":"","src":"/editorial-assets/ac46c8b46d788a0523ff1448b313d179d276cc92924df1e9ce64fbfa2b32be1c.png"},"kind":"image"},{"kind":"text","text":". In that case, there is always an enemy to kill, and, since the bounty increases over time, the answer can be infinitely large."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, if "},{"attrs":{"alt":"","src":"/editorial-assets/91d62a0fb3a7cbbf2ef70c092422b72021153426243d9b82af17aed2e58edc70.png"},"kind":"image"},{"kind":"text","text":", the bounty stays constant and we cannot obtain the infinitely large answer. Since the bounty is constant, we are to find the maximum value of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") and multiply it by bounty. This is a simple task and is left as an excersise :)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity — "},{"attrs":{"alt":"","src":"/editorial-assets/c940bf3b60a0ad32e7015828f7fe9aac35d0ceb80944c0b210bc8462c26782df.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author — "},{"attrs":{"href":"https://codeforces.com/profile/rek"},"children":[{"kind":"text","text":"rek"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/rek"},"children":[{"kind":"text","text":"rek"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33953146"},"children":[{"kind":"text","text":"33953146"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/xen"},"children":[{"kind":"text","text":"xen"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946949"},"children":[{"kind":"text","text":"33946949"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33947166"},"children":[{"kind":"text","text":"33947166"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"912D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/912/problem/D"},"children":[{"kind":"text","text":"912D - Fishes"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's solve a simplified problem first. Assume we know all fishes' positions ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") (1-indexed). Denote as "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") the amount of fish that is inside a scoop with lower-left angle located at ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). Then the expected value is equal to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/5c0680e6ce2b39e3641c5acc06c2b525ba9b8158affb9f7d336cfeb972b5cd07.png"},"kind":"image"},{"children":[{"kind":"text","text":"It's quite obvious that straightforward computation will result into "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") time. However, we can invert the problem and calculate for each fish "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") — how many scoops it is covered by. "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" is given by the following formula:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/4514d1612019b5d4f7cf902b6eb248a60b6d3aa25c1eb95d6fc0d97f42d3f4fe.png"},"kind":"image"},{"children":[{"kind":"text","text":"Let's get back to "},{"attrs":{"alt":"","src":"/editorial-assets/f140f8a0911228ce7cb4d1f5add11bf93c37146686a7884a180d2533e1d79028.png"},"kind":"image"},{"kind":"text","text":" and transform it into:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/c153a676edde2f3b72c27a108598aaf5796ae54754054685116cb42122f76558.png"},"kind":"image"},{"children":[{"kind":"text","text":"In other words, in order to maximize the expected value we have to choose "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" best values among "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" possibilities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From now on there are several approaches."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Solution I."},{"children":[{"kind":"text","text":"Imagine we're considering "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"), i.e. with a fixed coordinate "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":". Note that in this case "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-convex, i.e. it's non-decreasing until some point, and after — non-increasing. Moreover, it always reaches its maximum at "},{"attrs":{"alt":"","src":"/editorial-assets/a38598de942325cff619baec6f5f16c9e86ff9ac1fc1193d5d9bbd9172c97035.png"},"kind":"image"},{"kind":"text","text":". Denote the points to the left of this one "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":", and to the right (inclusive) — "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rest of the solution looks as follows: initially we put 2·"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" points into the set, two per each "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-coordinate, one for "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" and one for "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":". On each step we take the point with maximum value of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" and replace it with its left or right neighbour (depending on which part it was from: "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" means that the substitute will be to the left, "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":" — to the right)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/5558a14d7de69b6c4c4deac4462dbdf18509550a2ff971588d54295e69f1ab74.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":"Solution II."},{"children":[{"kind":"text","text":"Let's enhance the contemplations from the previous paragraph. Notice that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" is convex by both values. Then we can take "},{"attrs":{"alt":"","src":"/editorial-assets/a8f6f2790d016470191b7eb8e7c51a6e3d18901c0a3b6e45ab9539bccb69775a.png"},"kind":"image"},{"kind":"text","text":") as the starting point and launch a breadth-first search with a priority queue, erasing the most significant point according to "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" from the queue and checking all of its yet unvisited neighbours in a 4-connected area."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/581906bb76e4cecd7cc6dd18591213e0499d2039105eb5548cb29256bdb165bb.png"},"kind":"image"},{"kind":"text","text":" with a greater constant compared with solution one. "}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author — "},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/xen"},"children":[{"kind":"text","text":"xen"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946962"},"children":[{"kind":"text","text":"33946962"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":", solution 1): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946974"},"children":[{"kind":"text","text":"33946974"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":", solution 2): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946993"},"children":[{"kind":"text","text":"33946993"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"912E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/912/problem/E"},"children":[{"kind":"text","text":"912E - Prime Gift"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The initial idea that emerges in such kind of problems is to use binary search to determine the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th element. Still we have to somehow answer the following query: \"how many elements no greater than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" satisfy the conditions?\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to see that all such numbers can be represented as "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·...·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":". Denote "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":") as a set of numbers not exceeding 10"},{"children":[{"kind":"text","text":"18"}],"kind":"superscript"},{"kind":"text","text":" such that all their prime divisors lie inside "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" be our initial set. Sadly we cannot just generate "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") since its size might be of the order of 8·10"},{"children":[{"kind":"text","text":"8"}],"kind":"superscript"},{"kind":"text","text":". Actually, the goal is to invent a way to obtain information about all elements without having to generate them explicitly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Imagine we split "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" into two such sets "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"attrs":{"alt":"","src":"/editorial-assets/e0255194e970e3b8cc7b8656504cad8baa863bd7b7ad590104e5d3b48bd50911.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/e232c4ef9c75397d89cbb87c2ed2875a9ce6f70c15d351ad8f600e5f9832561b.png"},"kind":"image"},{"kind":"text","text":". According to the fact that each element of "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") can be represented as product of some element of "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") and some element of "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"), we can explicitly generate "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"), then sort them and find out how many pairwise products do not exceed "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":")| + |"},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":")|) using two pointers approach. This gives "},{"attrs":{"alt":"","src":"/editorial-assets/9f37891d0d7816fb534a78046bef9ce5c478b86af2d57d547abef9876b0c9047.png"},"kind":"image"},{"kind":"text","text":" in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The main part is to find the optimal partition. The first thought is to send the first "},{"attrs":{"alt":"","src":"/editorial-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"},"kind":"image"},{"kind":"text","text":" elements to "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and the rest to "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". However, this is not enough; in this case the approximate size of "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") might reach 7·10"},{"children":[{"kind":"text","text":"6"}],"kind":"superscript"},{"kind":"text","text":" which is way too much to pass. To speed it up we can, for example, comprise "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" of elements with even indexes (i.e "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ...) so that sizes of both "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") do not exceed 10"},{"children":[{"kind":"text","text":"6"}],"kind":"superscript"},{"kind":"text","text":" and the solution runs swiftly."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author — "},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/xen"},"children":[{"kind":"text","text":"xen"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33947002"},"children":[{"kind":"text","text":"33947002"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":" Code ("},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/912/submission/33946911"},"children":[{"kind":"text","text":"33946911"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/56920"}