],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"][0... "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]). So, there is an interesting event only if value "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1] is smaller than the whole prefix before it. On the other hand, the value "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"][0... "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]) can't increase more than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" times by 1 (each time when we pass through the right end of the duck) and so, it also can't decrease more then "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" times (since it is a non-negative value)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, the events \"we passed through the right end of the duck\" and \"we should non-trivially calculate "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]\" are in total linear. Each of them can be processed in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) operation with Cartesian tree, that gives as totally an "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" solution. Whooray! "}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/542/problem/C"},"children":[{"kind":"text","text":"542C - Idempotent functions"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"In order to solve this task it's good to understand how does the graph corresponding the function from {1, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"} to itself looks. Let's consider a graph on vertices 1, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" with edges from vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to the vertex "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). Such graph always looks like a set of cycles with several trees leading to that cycles. How should the graph look like for function to be the idempotent? It's easy to see that in such graph all cycles should be of length 1 and all vertex that are not cycles of length 1 (i. e. all not fixed points) should immediatly lead to some fixed point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we should satisfy two conditions. First, all cycles should become of length 1 — in order to do that "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" should be divisible by "},{"children":[{"kind":"text","text":"lcm"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") where "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are the lengths of all cycles. Second, all vertices not lying on cycles should become leading to the vertices lying on cycles. In other words, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" should be no less than the distance from any vertex "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" to the cycle it goes into (or, that the same, the length of pre-period in the sequence "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":")), "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"))), ...)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, are task is about finding the smallest number "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" divisible by "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" that is no less than "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", it is not hard at all."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Challenge"}],"kind":"strong"},{"kind":"text","text":". What is the maximum possible answer for this task? (Answer: "},{"attrs":{"href":"http://oeis.org/A000793"},"children":[{"kind":"text","text":"first"}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"http://oeis.org/A000793/b000793.txt"},"children":[{"kind":"text","text":"second"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/542/problem/D"},"children":[{"kind":"text","text":"542D - Superhero's Job"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First step is to understand the properties of a Joker function. It's important property is that it is multiplicative: "},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"ab"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") for ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") = 1, so we can write the value of function knowing the factorization of an argument: "},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"}],"kind":"superscript"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"... "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":")... "},{"children":[{"kind":"text","text":"J"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":