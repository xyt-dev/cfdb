xt","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"] above. In other words, let's just suppose that the lats segment in structure "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] is infinite in right direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's sweep with the variable "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". The function "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1][·] changes in comparsion to "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"][·] very rarely For example, the value "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1]["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1] is almost always the same as "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1] (that is equal to "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] as said above). Indeed, if we suppose that there is no duck ending in "},{"children":[{"kind":"text","text":"