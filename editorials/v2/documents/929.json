нападающих из "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":", то нужно к ответу прибавить "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Пусть минимальный номер, который мы возьмем в команду, принадлежит одному из защитников. Тогда переберём кому из защитников принадлежит этот номер. Пусть это защитник, который имеет на футболке номер "},{"children":[{"kind":"text","text":"minD"}],"kind":"emphasis"},{"kind":"text","text":". Тогда мы можем взять в состав вместе с ним одного вратаря, ещё одного защитника и трёх нападающих с номерами от "},{"children":[{"kind":"text","text":"minD"}],"kind":"emphasis"},{"kind":"text","text":" + 1 до 2·"},{"children":[{"kind":"text","text":"minD"}],"kind":"emphasis"},{"kind":"text","text":". Количество подходящих вратарей "},{"children":[{"kind":"text","text":"cntG"}],"kind":"emphasis"},{"kind":"text","text":", количество подходящих защитников "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" и количество подходящих нападающих "},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" определяем с помощью проходов по соответствующим массивам. Таким образом, мы можем взять одного вратаря, эта величина "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntG"}],"kind":"emphasis"},{"kind":"text","text":", взять ещё одного защитника из "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" защитников, эта величина равна "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":", а также взять трёх нападающих, эта величина равна "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" * ("},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * ("},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" - 2) / 6. Так как для каждого вратаря из "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" подойдет любой защитник из "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" и любая тройка нападающих из "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":", то нужно к ответу прибавить "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Пусть минимальный номер, который мы возьмем в команду, принадлежит одному из нападающих. Тогда переберём кому из нападающих принадлежит этот номер. Пусть это нападающий, который имеет на футболке номер "},{"children":[{"kind":"text","text":"minF"}],"kind":"emphasis"},{"kind":"text","text":". Тогда мы можем взять в состав вместе с ним одного вратаря, двух защитников и двух нападающих с номерами от "},{"children":[{"kind":"text","text":"minF"}],"kind":"emphasis"},{"kind":"text","text":" + 1 до 2·"},{"children":[{"kind":"text","text":"minF"}],"kind":"emphasis"},{"kind":"text","text":". Количество подходящих вратарей "},{"children":[{"kind":"text","text":"cntG"}],"kind":"emphasis"},{"kind":"text","text":", количество подходящих защитников "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" и количество подходящих нападающих "},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" определяем с помощью проходов по соответствующим массивам. Таким образом, мы можем взять одного вратаря, эта величина "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntG"}],"kind":"emphasis"},{"kind":"text","text":", взять двух защитников из "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" защитников, эта величина равна "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" * ("},{"children":[{"kind":"text","text":"cntD"}],"kind":"emphasis"},{"kind":"text","text":" - 1) / 2, а также взять двух нападающих, эта величина равна "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" * ("},{"children":[{"kind":"text","text":"cntF"}],"kind":"emphasis"},{"kind":"text","text":" - 1) / 2. Так как для каждого вратаря из "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" подойдет любая пара защитников из "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" и любая пара нападающих из "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":", то нужно к ответу прибавить "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Стоит отметить, что не нужно забывать про переполнение и выполнять все вычисления в 64-битном типе данных. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"929D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/929/problem/D"},"children":[{"kind":"text","text":"929D - Пограничные врата"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Во-первых, для удобства, если "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", то развернем все зоны и поменяем соответствующим образом "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" так, чтобы выполнялось "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Теперь понятно, что Аркадию надо все время идти налево (уменьшая номер зоны) до зоны "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", иногда при необходимости возвращаясь направо, правее зоны "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", за необходимыми ключами. При этом, чтобы пройти некоторые врата правее зоны "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", необходимо сначала пройти за ключом в некоторые зоны левее "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Поэтому задача определения, в какие моменты времени и насколько далеко нужно ходить направо, не является тривиальной."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Пройдем из зоны "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" в зону "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", поддерживая набор ключей, которые у нас есть в данный момент. Кроме того, будем поддерживать, насколько далеко мы когда либо ходили вправо, пусть "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" — самый правый номер зоны, где мы когда-либо были. Пусть мы сейчас хотим перейти из зоны "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" в зону "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - 1. Если перед нами врата, ключа от которых у нас нет, будем увеличивать "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" до тех пор, пока не найдем подходящий ключ. Если же в какой-то момент мы не сможем изменить ни "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", ни "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", потому что с обоих сторон врата, от которых у нас нет ключей, то, очевидно, Аркадий не сможет добраться до зоны "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". В противном случае для каждой позиции "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" мы можем легко вычислить самую правую позицию "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", которую нам надо посетить до перехода в зону "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - 1. В то же время, для каждой такой правой позиции "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" мы можем легко вычислить самую левую позицию "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"', которую необходимо посетить для прохода в зону "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". Очевидно, "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"' ≥ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", иначе ответ -1. Теперь по тройкам ("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"') необходимо посчитать минимальную длину пути, удовлетворяющую всем тройками."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Воспользуемся методом динамического программирования. Пусть "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — минимальное число ходов, необходимое, чтобы оказаться в точке "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", при этом последние перемещения были "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"' → "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" → "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Отметим, что в данном случае должно выполняться "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"' ≥ "},{"children":[{"kind":"text","text":"l"}]