{"assets":["/editorial-assets/2f58d49cfd955303e6720409d0cefcd3c70d0f42bcb81f68c19d202ba7ca9649.png","/editorial-assets/3277997a8e9bc14fc3fbdb2ada4d2660399d7fa2eb0a9b34dea27fdfbcb7d8c6.png","/editorial-assets/daebf5f805688c3956ffa9584c8a78462be492242f02efa93f8060c8e7dbd564.png","/editorial-assets/e5bbe8dd8a97a3de7b332b16d41bfa000fdd3e38bd178760138bac543e387120.png","/editorial-assets/399d8c00fcda13d4cb659cb09f6f32deb6e33e5b593213783bcdb0fc1dc0d0ad.png","/editorial-assets/ca3d52ef53e5b88d6fadba2cc526c97971cfd7961b01facf60b690f9058197aa.png","/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png","/editorial-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png","/editorial-assets/4735180acfdee1fbf45990d0bf6e5f99381bad8cba8f1e644071c53577c28c0f.png","/editorial-assets/a590b9966dd9fa887a6eb0213dea9a6c0aa91211c29fb58742179f913fcc760b.png","/editorial-assets/1e98d296ddce67baae841a2182dafbd1cce872252d39a34cba7494e1e979a817.png","/editorial-assets/bb830cabed293169c5540586aeeb05f04194fe54ee3a9827e00e2f633e0cef6b.png","/editorial-assets/6ad28090e5b8ef0844653cdb12be73dab88a359feda27a67ecc39c65c14ea0ac.png","/editorial-assets/8a4e358f0277ac8cf80421b4524977cc01e79a29bdcfb064b6f5ad08a153cb63.png"],"contestId":"586","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/586/problem/A"},"children":[{"kind":"text","text":"586A - Alena's Schedule"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/adedalic"},"children":[{"kind":"text","text":"adedalic"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To solve this problem one should remove all leading and trailing zeroes from array and then calculate the number of ones and number of zeroes neighboured by ones. The sum of this values is the answer for the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/586/problem/B"},"children":[{"kind":"text","text":"586B - Laurenty and Shop"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/Oleg_Smirnov"},"children":[{"kind":"text","text":"Oleg_Smirnov"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some path "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"th if we start it by going "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" times left, then we cross the prospect and go left "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" times again. Let "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be equal to the time we should wait on traffic lights while following "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th path. If we consider any way from the shop to home, it is equal (but reversed) to only path from home to the shop, meaning that we need to find two distinct paths from home to the shop. So the answer to the problem is the sum of the smallest and the second smallest values among "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". One could easily calculate "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" using calculated "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":", so "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" could be found in one for cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we will consider only two minimum values among "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", solution complexity will be "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/A"},"children":[{"kind":"text","text":"585A - Gennady the Dentist"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/Neon"},"children":[{"kind":"text","text":"Neon"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's store for each child his current confidence value and a boolean indicating whether child had left the queue (or visited the dentist office) or not. Then one could easily process children one by one, considering only children who still are in the queue (using boolean array), and changing stored values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Such solution has complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") and requires author's attention much, especially the case with possible confidence value overflowing. Of course there are much faster solutions not required in our case."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/B"},"children":[{"kind":"text","text":"585B - Phillip and Trains"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/IlyaLos"},"children":[{"kind":"text","text":"IlyaLos"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One could consider a graph with vertices corresponding to every ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") position. I should notice that train positions for each Phillip position are fully restorable from his "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" coordinate. Edge between vertices "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" means that we could get from position corresponding to "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to position corresponding by "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" in one turn without moving onto a train cell or moving in a cell which will be occupied by some train before the next turn. All we need next is to find whether any finishing position is reachable from the only starting position (using BFS or DFS, or, as soon as graph is a DAG, dynamic programming)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As soon as graph has "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") vertices and "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") edges, solution complexity equals to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/C"},"children":[{"kind":"text","text":"585C - Alice, Bob, Oranges and Apples"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/Edvard"},"children":[{"kind":"text","text":"Edvard"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, let's understand the process described in problem statement. If one would write a tree of a sum-pairs ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") with letters "},{"attrs":{"alt":"","src":"/editorial-assets/2f58d49cfd955303e6720409d0cefcd3c70d0f42bcb81f68c19d202ba7ca9649.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/3277997a8e9bc14fc3fbdb2ada4d2660399d7fa2eb0a9b34dea27fdfbcb7d8c6.png"},"kind":"image"},{"kind":"text","text":", he would get the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Stern%E2%80%93Brocot_tree"},"children":[{"kind":"text","text":"Stern–Brocot tree"}],"kind":"link"},{"kind":"text","text":". Let the number of oranges be enumerator and the number of apples be denumerator of fraction. At every step we have two fractions (at first step they are "},{"attrs":{"alt":"","src":"/editorial-assets/daebf5f805688c3956ffa9584c8a78462be492242f02efa93f8060c8e7dbd564.png"},"kind":"image"},{"kind":"text","text":") and should replace exactly one of them with their mediant. In such way first fraction is first parent to the left from mediant while second fraction is parent to the right. The process described in statement is, this way, a process of finding a fraction in the Stern-Brocot tree, finishing when the current mediant is equal to current node in the tree and ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") pair is the fraction we are searching. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This means that if "},{"attrs":{"alt":"","src":"/editorial-assets/e5bbe8dd8a97a3de7b332b16d41bfa000fdd3e38bd178760138bac543e387120.png"},"kind":"image"},{"kind":"text","text":", ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") does not correspond to any correct fraction and the answer is \"Impossible\". Other way, we could find it in the tree. If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", we should firstly go in the right subtree. Moreover, we could then consider we are searching "},{"attrs":{"alt":"","src":"/editorial-assets/399d8c00fcda13d4cb659cb09f6f32deb6e33e5b593213783bcdb0fc1dc0d0ad.png"},"kind":"image"},{"kind":"text","text":" from the root. If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", we should go left and next consider "},{"attrs":{"alt":"","src":"/editorial-assets/ca3d52ef53e5b88d6fadba2cc526c97971cfd7961b01facf60b690f9058197aa.png"},"kind":"image"},{"kind":"text","text":" from the root. This gives us Euclidian algorithm, which could be realized to work in "},{"attrs":{"alt":"","src":"/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png"},"kind":"image"},{"kind":"text","text":" complexity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/D"},"children":[{"kind":"text","text":"585D - Lizard Era: Beginning"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/danilka.pro"},"children":[{"kind":"text","text":"danilka.pro"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To solve the problem we will use meet-in-the-middle approach. For "},{"attrs":{"alt":"","src":"/editorial-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png"},"kind":"image"},{"kind":"text","text":" we should consider all "},{"attrs":{"alt":"","src":"/editorial-assets/4735180acfdee1fbf45990d0bf6e5f99381bad8cba8f1e644071c53577c28c0f.png"},"kind":"image"},{"kind":"text","text":" variants. Let in some variant approval values of three companions are "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" respectively. If we will consider some variant from other half (there are "},{"attrs":{"alt":"","src":"/editorial-assets/a590b9966dd9fa887a6eb0213dea9a6c0aa91211c29fb58742179f913fcc760b.png"},"kind":"image"},{"kind":"text","text":" of them) and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"', "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"', "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"' approval values, then to ``merge'' such two parts correctly, two conditions "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"' - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"' и "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"' - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"' must be true ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"' = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"' = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"' is true), and the value we are maximizing is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This way, to solve the task one could consider every variant from the first half and store for every possible pair ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":") the maximum "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" value achievable (using, for example, the "},{"attrs":{"alt":"","src":"/editorial-assets/1e98d296ddce67baae841a2182dafbd1cce872252d39a34cba7494e1e979a817.png"},"kind":"image"},{"kind":"text","text":" structure or any fast sorting algorithm). If one would then consider every variant from the second half, he just need to find ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"' - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"', "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"' - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"') pair in the structure to get the maximum "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" value if possible and update answer with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"' value. Answer restoring is pretty same to the algorithm above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Such solution has "},{"attrs":{"alt":"","src":"/editorial-assets/bb830cabed293169c5540586aeeb05f04194fe54ee3a9827e00e2f633e0cef6b.png"},"kind":"image"},{"kind":"text","text":" complexity."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/E"},"children":[{"kind":"text","text":"585E - Present for Vitalik the Philatelist "}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/gridnevvvit"},"children":[{"kind":"text","text":"gridnevvvit"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's calculate the number of subsets with gcd equal to 1 — value A. Let's do that using principle of inclusions-exclusions: firstly we say that all subsets is good. The total number of subsets is equal to 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". Now let's subtract subsets with gcd divisible by 2. The number of that subsets is equal to 2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1 ("},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the number of numbers that is divisable by "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). Next we should subtract 2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1. Subsets with gcd divisible by 4 we already counted with number two. Next we should subtract 2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1. Now we should notice that subsets with gcd divisible by 6 we already processed twice: firstly with number 2, then with — 3, so let's add the number of these subsets 2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"6"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1. If we continue this process we will get, that for all numbers "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" we should add the value μ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":")(2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1), where μ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":") is equals to 0, if "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" is divisible by square of some prime, 1, if the number of primes in factorization of "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" is even and  - 1 in other case. So the numbers that is divisible by square of some prime we can ignore, because they have coefficient 0. To calculate values "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we should factorize all numbers and iterate over 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" divisors with value μ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":") ≠ 0. Now it's easy to see, that the number of subsets with gcd greater than 1 equals to "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" = 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":". To solve the problem let's fix the stamp that Vitaliy will buy "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let's recalculate the number "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" for array a without element "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". To do that we should only subtract those terms that was affected by number "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We can do that in 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the number of primes in factorization of the number "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". It's easy to see that only the subsets with gcd greater than 1, but not divisible by any divisor of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", should we counted in answer. To calculate number of those subsets let's again use the principle of inclusions-exclusions. For every divisor "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" let's subtract the value μ (2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" - 1) from "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". So now we got "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the number of subsets with gcd greater than 1, but coprime with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". The answer to problem is the sum over all "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". The maximum number of primes in factorization of number not greater than 10"},{"children":[{"kind":"text","text":"7"}],"kind":"superscript"},{"kind":"text","text":" is equal to 8. We can factorize all numbers from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" in linear time by algorithm for finding the smallest divisors for all intergers from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", or by sieve of Eratosthenes in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nloglogn"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"2"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"), where "},{"attrs":{"alt":"","src":"/editorial-assets/6ad28090e5b8ef0844653cdb12be73dab88a359feda27a67ecc39c65c14ea0ac.png"},"kind":"image"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" — is the largest number of primes in factorization of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/585/problem/F"},"children":[{"kind":"text","text":"585F - Digits of Number Pi"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/Edvard"},"children":[{"kind":"text","text":"Edvard"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all substrings of string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" with length "},{"attrs":{"alt":"","src":"/editorial-assets/8a4e358f0277ac8cf80421b4524977cc01e79a29bdcfb064b6f5ad08a153cb63.png"},"kind":"image"},{"kind":"text","text":". Let's add them all to "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Trie"},"children":[{"kind":"text","text":"trie"}],"kind":"link"},{"kind":"text","text":" data structure, calculate failure links and build automata by digits. We can do that in linear time using "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Aho%E2%80%93Corasick_algorithm"},"children":[{"kind":"text","text":"Aho-Korasik"}],"kind":"link"},{"kind":"text","text":" algorithm. Now to solve the problem we should calculate dp "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". State of dp is described by five numbers: "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" — number of digits, that we already put to our number, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" — in which vertex of trie we are, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" — equals to one if the prefix that we built is equals to prefix of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" — equals to one if the prefix that we built is equals to prefix of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" — equals to one if we already have some substring with length "},{"attrs":{"alt":"","src":"/editorial-assets/8a4e358f0277ac8cf80421b4524977cc01e79a29bdcfb064b6f5ad08a153cb63.png"},"kind":"image"},{"kind":"text","text":" on the prexif that we built. The value of dp is the number of ways to built prefix with the given set of properties. To update dp we should iterate over the digit that we want to add to prefix, check that we still is in segment ["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"], go from vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to the next vertex in automata. So the answer is the sum by all "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", 1"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nd"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/20898"}