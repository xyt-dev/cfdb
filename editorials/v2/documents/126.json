kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":")], where ["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] is rounding up of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". You should iterate over all cases and choose one optimal of them."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The last tricky case consists in the fact that for all 1 ≤ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" и 1 ≤ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") < "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":". For example, you can see following test"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"100 110 2 2 109 (it is the 6th pretest)."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"In this case you should output (0, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":")."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"All calculations should be done in 64-bit integers (8th pretest checks overflow of 32-bit integers) or very carefully in the real numbers."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"div2 D. div1 B."}],"kind":"strong"},{"kind":"text","text":"  "},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us calculate a prefix-function for all prefices of string. Prefix-function "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is maximal length of prefix that also is suffix of substring [1..."},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]. More about prefix function you can see in a description of Knuth-Morris-Pratt algorithm (KMP)."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The first of possible answers is prefix of length "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]. If "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] = 0, there is no solution. For checking the first possible answer you should iterate over "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]. If at least one of them equal to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] (but not "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"-th, of course) - you found the answer. The second possible answer is prefix of length "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]]. If "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]] = 0, you also have no solution. Otherwise you can be sure that the answer already found. This substring is a prefix and a suffix of our string. Also it is suffix of prefix with length "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] that places inside of all string. This solution works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Also this problem can be solved using hashing. You can find hash of every substring in O(1) and compare substrings by comparing thier hashes. Well, let's check for every prefix that it is a suffix of our string and store thier lengths into some array in the increasing order. Then, using binary search over the array, you can find maximal length of prefix that lie inside of string. Check of every prefix you can do in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). So, you have some "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" solution."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"In point of fact, the array of prefix lengths in the previous solution is list { "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"], "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]], ... }, that written if reversed order. From the first solution you know that the answer is prefix of length either "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"], or "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]] (if it exists, of course). Therefore some naive solution without binary search can fits in the limits if you will stupidly check all prefices in the order of decrease thier lengths:) This solution works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Also this problem can be solved using "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"-function."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"div2 E. div1 C."}],"kind":"strong"},{"kind":"text","text":" You can see that every command "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" you should do no more than once. Also order of commands doesn't matter. Actually, sequence of command you can represent as boolean matrix "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" with size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 mean that you do the command "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0 mean that you don't do it."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us describe one way to construct the matrix."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Let the starting image is boolean matrix "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":". A boolean matrix "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" of size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" stores intermediate image that you will recieve during process of doing commands."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"For the upper half of matrix "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" without main diagonal you should move line by line from the up to the down. For every line you should move from the right to the left. You can see that for every positions all nonconsidered positions do not affect the current position. So, if you see that values for position  "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" in the matrices "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" are different, you should do command "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":": set in the matrix "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1, and change segments ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") - ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") - ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") in the matrix "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"For the lower half of the matrix "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" without main diagonal you should do it absolutely symmetric. At the end you should iterate over main diagonal. Here it should be clear."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Well, for matrix "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" you always can build matrix "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and do it by exactly one way. It mean that this way requires minimum number of commands. So, you can get answer for problem by following way: you can build the matrix "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" from the matrix "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" and output number of ones in the matrix "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"There is only one problem that you should solve. Algorithm that you can see above works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"), that doesn't fit into time limits. Let's speed up it to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"). Consider in the matrix "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" the upper half without main diagonal. During doing commands all columns of cells that placed below current position will have same values. Values above current position are not matter for us. Therefore instead of the matrix "},{"children":[{"kind":"text","text":"B "}],"kind":"emphasis"},{"kind":"text","text":"you can use only one array that stores values of columns. It allows you do every command in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) instead of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). This optimization gives a solution that works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"div1 D."}],"kind":"strong"},{"kind":"text","text":" Let us represent a number in the Fibonacci code. You can imagine Fibonacci coding by following way: "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of number corresponds to the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th Fibonacci number. For example, 16=13+3 will be written as 100100. You can represent into this code any positive integer, for that no two neighbouring 1-bit will be present. It is possible to do it by only one way (let's define this way as canonical). In the problem you should calculate a number of ways to represent some number into Fibonacci code in that two ones can be placed in the neighbour positions."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"You can easily get the canonical representation if you generate several of Fibonacci numbers (about 90) and after that try to substract all of them in the decreasing order."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"You should store positions of 1-bits of canonical representation into an array "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" in the increasing order. You can decompose any of them into two ones. It looks like that:"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"1000000001 // starting number;"},{"kind":"line_break"},{"kind":"text","text":"0110000001 // there we decompose"},{"kind":"line_break"},{"kind":"text","text":"0101100001 // the first \"one\""},{"kind":"line_break"},{"kind":"text","text":"0101011001 // using all"},{"kind":"line_break"},{"kind":"text","text":"0101010111 // possible ways"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"After some number of such operations you will meet next 1-bit (or the end of number). This 1-bit also can be decomposed, but it can be \"shifted\" by only one bit."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Let us "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is number of ways to represent a number that consists of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" last 1-bits of our number in the case that the first of 1-bits are NOT decomposed. Also let us "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is number of ways to represent a number that consists of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" last 1-bits of our number in the case that the first of 1-bits are decomposed."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"You can easily recaclulate this dp following way"},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1[0] = 1, "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2[0] = 0"},{"kind":"line_break"},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1]"},{"kind":"line_break"},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] * [("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] - 1) / 2] + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] * [("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1]) / 2]"},{"kind":"line_break"},{"kind":"text","text":"where ["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] is rounding down."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Answer will be "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"1["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"2["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"], where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is total number of 1-bits in the canonical representation. So, we have "},{"attrs":{"alt":"","src":"/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png"},"kind":"image"},{"kind":"text","text":" solution for one test."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"div1 E. "}],"kind":"strong"},{"kind":"text","text":"Consider all partitions of 7 × 8 board into dominoes. There is only 12988816 of them (you can get this number using some simple bruteforce algorithm)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, consider all \"paintings\" of 7 × 8 board (i.e. number of cells of every color) and find number of patritions into set of pills of 10 types for every of them. In the worst case you will get 43044 partitions (this number you can get using another bruteforce algo)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first part of solution you should iterate over all partitions of board into dominoes and find all sets of pills that you will get. You will have no more than 43044 of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second part of solution you should try to distribute all available pills for every of sets that you recieved in the first part. You should distribute them in such way that maximal number of colors match."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should build a graph that composed from 4 parts - source, the first part of 10 nodes, the second part of 10 nodes and sink. There are edges between all pairs of nodes from neighbour parts. From source to the first part you should set capacities of edges equal to numbers of available pills of every type. From the second part to sink you should set capacities of edges equal to numbers of pills in the current partition. From the first part to the second part you should use infty capacities and set costs equal to number of MISmatched colors in the types of pills (it is some numbers in range from 0 to 2). At the end, you should find maximal flow of minimal cost (MCMF) if this graph and save a flow that gets minimal cost."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third part of solution you should restore answer from optimal flow."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second part of solution you can replace MCMF by usual maxflow. You can see that at the beginning MCMF will fill edges of cost 0. So, you can fill them by hand. After that you can drop all edges of cost 0 and 2 and just find maxflow."},{"kind":"line_break"}],"kind":"paragraph"},{"kind":"text","text":"Complexity of solution is difficult, but it is clear that this solution fits into limits. The first jury solution in C++ that was written carelessly works in 1 sec. Some more clever solutions works in 0.4 sec, but you can write something more faster."}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/3140"}