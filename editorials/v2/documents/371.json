t":"(0, "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"kind":"text","text":"Obviously, the function "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") is monotonic (increasing). So it is possible to use binary search approach to find largest "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"ler"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/371/problem/D"},"children":[{"kind":"text","text":"371D - Vessels"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The naive solution for this problem will work like this. Let us store an amount of water in each vessel in some array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". If we need to know how much water is in some vessel, we just take the number from the array. If we need to pour "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" units of water into vessel number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", we must follow the simple procedure: 1. If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 0 then all water is poured and we must end the procedure 2. If "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" then all remaining water is spilled on the floor and we must end the procedure 3. If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" units of water can fit into the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vessel, then add "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and end the procedure 4. Fill "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vessel completely and subtract used amount from "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". 5. Assign "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1. 6. Go to the first step."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the worst case scenario such procedure can iterate through all vessels each time. For example, if there are "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vessels and each vessels have capacity of one unit of water, each query like 11"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" will take "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make this solution faster we should notice, that once completely filled, vessel can be skipped during the algorithm above because it can not consume any more water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So instead of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 assignment should be like "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"findNextNotFilledVessel"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To implement this function we can use different structures. For example, we can use sorted set of numbers (set in C++, TreeSet in Java). Let store the set of indices of unfilled vessels. So to find next not filled vessel from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vessel, we must find smallest number, that is contained in set and is strictly greater than "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". There are built-in methods for it (upper_bound in C++, higher in Java). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, each time we fill the vessel, we must erase corresponding index from the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So now we can see, that algorithm can not complete more that "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":") operations for all queries. Because on each iteration of the pouring procedure either the vessel is filled (which can only happen "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" times during the whole runtime), or we run out of water (or vessels) and the procedure is stopped. So there will be only total of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") iterations of the pouring procedure and each iteration require one lookup in the sorted set, which takes "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":") operations. So the total number of needed operations is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"logn"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/371/problem/E"},"children":[{"kind":"text","text":"371E - Subway Innovation"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"It is easy to see that you need to minimize the sum of pairwise distances between "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" stations. The main idea to do it is to sort them and the required stations will form a continuous segment. It is easy to prove by contradiction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Huge constraints do not allow to use straight-forward method to find required segment. Let’s call "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") — sum of pairwise distances of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"