{"assets":["/editorial-assets/e2af3a4bbb1e48f0a8ea1121ae02259bc9f29b1ad3761b070f8ce7dd14e45482.png","/editorial-assets/9db4cb199b3c13ba55fe2156704651c1fb3ee66ecaf9067e8ff7e19b48f1e426.png"],"contestId":"371","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"The tutorial has been prepared by "},{"attrs":{"href":"https://codeforces.com/profile/Fefer_Ivan"},"children":[{"kind":"text","text":"Fefer_Ivan"}],"kind":"link"},{"kind":"text","text":" and "},{"attrs":{"href":"https://codeforces.com/profile/NALP"},"children":[{"kind":"text","text":"NALP"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/371/problem/A"},"children":[{"kind":"text","text":"371A - K-Periodic Array"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"For array to be periodic, elements 1, 1 + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", 1 + 2 * "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", … must be equal. Also, elements 2, 2 + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", 2 + 2 * "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", … must be equal. And so on up to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". So each element of the array is a part of exactly one group. And there are "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" groups total. Each such group is independent. Let’s consider some group of elements, that contain "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" ones and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" twos. All elements in this group must be equal. So we either change all ones to twos or all twos to ones. First option will require "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" changing operations and second one — "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" changing operations. For the optimal solution, you should select the operation with smaller number of changing operations required."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/371/problem/B"},"children":[{"kind":"text","text":"371B - Fox Dividing Cheese"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"It is easy to see that the fox can do three type of operations: divide by 2, divide by 3 and divide by 5. Let’s write both given numbers in form "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"·2"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·3"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·5"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"·2"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·3"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"·5"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" are not dibisible by 2, 3 and 5. If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" the fox can’t make numbers equal and program should print "},{"children":[{"kind":"text","text":"-1"}],"kind":"inline_code"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" then soluion exists. The answer equals to |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"},{"kind":"text","text":"|, because |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| is the minimal number of operations to have 2 in the same power in both numbers, |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":"| is the minimal number of operations to have 3 in the same power in both numbers, and |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"},{"kind":"text","text":"| is the same for 5."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/371/problem/C"},"children":[{"kind":"text","text":"371C - Hamburgers"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's use binary search approach. For given number of hamburgers (say, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") let's find the minimal number of money needed to cook them. Say, for one hamburger Polycarpus needs "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" bread pieces, "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" sausages pieces, "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"