{"assets":["/editorial-assets/4577c6673740beb82435ab764414e0a93f15b70a85240669c4d0cfac88fc9d01.png","/editorial-assets/98d633f3e4c4b219e2ecd183a937e9bd319a8f002852b56a02e519a888723c55.png"],"contestId":"305","diagnostics":[],"document":{"children":[{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/305/problem/A"},"children":[{"kind":"text","text":"305A - Strange Addition"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"All you have to do is implement following algorithm: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"If we have numbers 0 or 100, we take them to needed subset."}],"kind":"list_item"},{"children":[{"kind":"text","text":"If we got number greater than 0 and less than 10, we take it."}],"kind":"list_item"},{"children":[{"kind":"text","text":"If we got number "},{"attrs":{"alt":"","src":"/editorial-assets/4577c6673740beb82435ab764414e0a93f15b70a85240669c4d0cfac88fc9d01.png"},"kind":"image"},{"kind":"text","text":" divisible by 10 we take it."}],"kind":"list_item"},{"children":[{"kind":"text","text":"In case we have no numbers of second and third type, we take a number "},{"attrs":{"alt":"","src":"/editorial-assets/4577c6673740beb82435ab764414e0a93f15b70a85240669c4d0cfac88fc9d01.png"},"kind":"image"},{"kind":"text","text":" that is not divisible by 10"}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"href":"http://pastebin.com/nQXi0Khh"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/305/problem/B"},"children":[{"kind":"text","text":"305B - Continued Fractions"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are at most two ways to represent rational fraction as continued. Using Euclid algorithm you can do that for "},{"attrs":{"alt":"","src":"/editorial-assets/98d633f3e4c4b219e2ecd183a937e9bd319a8f002852b56a02e519a888723c55.png"},"kind":"image"},{"kind":"text","text":" and then check equality of corresponding "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/x4rXtxen"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/305/problem/C"},"children":[{"kind":"text","text":"305C - Ivan and Powers of Two"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all, let's carry over all powers of two in the following way: if we have "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", carry 1 to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1. Now as all of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are distinct, the answer is "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") — "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") + 1, where "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") — maximal value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") — size of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/RrRe5ffR"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/305/problem/D"},"children":[{"kind":"text","text":"305D - Olya and Graph"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all let's consider a graph on a number line. It's neccesary to have edges "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" -  > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1(first type). Also you can edges like "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" -  > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 (second type). Other edges are forbidden. This allows us to understand whether the answer is 0 or not. Also answer is 0 when all edges of second type doesn't intersect, considering them to be segments of number line, except when "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 — in this case answer is 1. Now we know that answer != 0. Frow all edges we have let's use only second type edges. If there aren't any of this edges we can add 1 to the answer, because of possibility of adding 0 edges to graph. For every vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", that has possibility of adding second type edges, let's add to answer 2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" — amount of vertexes on [i, min(i + k, n — k — 1)] without edges of second type out of them. Also it is necessary for all the second type edges to start in this segment."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/JaL2y2Gc"},"children":[{"kind":"text","text":"Solution O(n + m)"}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"http://pastebin.com/GRKqSsmH"},"children":[{"kind":"text","text":"Solution O(m + log(n))"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/305/problem/E"},"children":[{"kind":"text","text":"305E - Playing with String"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider substring of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"... "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"], that all characters from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" are palindrome centers, and "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1 are not. Every such substring can be treated independently from the others, and as we don't need to know it'sstructure let's consider only it length "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". Let's calculate "},{"children":[{"kind":"text","text":"grundy"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"] — Grundy function. If we want to cut character at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" 0 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" then our game splits in to independent ones: first will have length "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, second — "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 2, as "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1] are not centers of palindrome any more."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/niiD2WDM"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/7712"}