{"assets":["/editorial-assets/1668603bd96b1d0462b4181b67599d5219eecb99d916857540c83a4d0af5165b.png","/editorial-assets/33c4d8b35e9f96238dae96833f54549cc150a4a23ba65f6004dd25dd4068b6eb.png","/editorial-assets/98afe20962c9b99df5b90be1ebc048bbe742eaec8c882459125d8874453c7627.png","/editorial-assets/1c9e857116ac3dc8ea9f4ef615c03c4405a836bc231ffe88cd3546cb790d3572.png","/editorial-assets/afc5bc953e3b8723c4058743f054eba34ccb1f791f3130f773216c95731e1ff1.png","/editorial-assets/12e6b25c7dbde12331725d7b04a08c9058532ab0c47e86cbcd16c2db0edc0dfd.png","/editorial-assets/0124f05d467fd69f3fe461739b89e80124033639ae1d45ab665f3a52a3f58e23.png","/editorial-assets/4243ea8523fd89ab0aae51c328042be4a398357089222dcf4f6e55bdfb89914d.png","/editorial-assets/4aaa199903109cb18a014bb42b0d84f48e19f5052870fbbde3e0eee92aa00894.png","/editorial-assets/6e08e9f9df1108faa098def02a2f84ce6a1b31fbdc738c7b55975a1e2e8aab84.png","/editorial-assets/f046325a5783526ca608d2128ba54bc4de6c05a14a44198daee6e6f1c1685c6c.png","/editorial-assets/368f2943fd5262e5946ed7fce0db1d3c8dfc5e4dd1dce6f9674523c4afdc6620.png","/editorial-assets/d812e2cd669cecca2568d2fe417d76e3fc233ade80ba06fe8b7cf905066bf93b.png","/editorial-assets/c48dbde0251147d16040f53a1bffcf5e9a5b597bb165f6b56507113f2e531304.png","/editorial-assets/444c0a9529dab780ba090e6a4acd2642cf097651cfec1cf49de771467f53ca1c.png","/editorial-assets/1b3c1caffff980250f8efe63063d29bb01942d6f6878235ec6b77df76724d4fa.png","/editorial-assets/92325ede12b872925810e4b3370179fef9d67aceed39afbb30ddf63c91c17a60.png","/editorial-assets/638ab344f88df9fa1c9ff5fd838c59f79f9d85a0e82584095ae95da9a4e7f58e.png","/editorial-assets/662afded2cd04174eaa10e947c858eac0ae235bc7656b6ca9210bfe82f26a14d.png","/editorial-assets/6e49c6a774852bd7e4266d814d434bf0a67702b7aebddfa51cdb2c6ec39fea9b.png","/editorial-assets/8c7155dd77970cca1fdd71ae4956a42655452bcb2d8a059c7ef80aef7f531d25.png","/editorial-assets/61d97c09ac312ee050652cd8a397bd61f894c64be36f622683f0aa001ac76bac.png","/editorial-assets/b3f7482082d5ccd2aab6a60d71a39ba39d8321babb1372648fbd6304615ab453.png","/editorial-assets/0b1853ea22cc751416bbf25bf8ce4b2393a744e206b747a3c49eb30c2f6555d6.png","/editorial-assets/ee89e45af347d945d284432fa5efb16d8a8b43b2ffcfc990120dec25f777fb7f.png","/editorial-assets/91ced4b6c0991fc933b35f293238b82ae97ae085d79080ca781807e7c532ba68.png","/editorial-assets/df70a3832d1db48c57da177fcb3a4fd0f8940471aecdc10364e6f3a82efbdd5b.png","/editorial-assets/209fecbbc6cf778c84dcf7365c581c1dc7462d07ddc3524b72b9bef06df5ccc0.png","/editorial-assets/0d9f46cf4cdb81fa9bae0a3463f7f5a8c1a9639300ba4f708273c7ed7fec03de.png","/editorial-assets/1d86d76dbaae449adac933e009481fdc775e2f36e6e6013ece154fa1db9fb193.png","/editorial-assets/e6b4a62848299ddacea580bc7c04546b34f2fd5128d409e04c1dcd23971cac42.png","/editorial-assets/74506eed053d1d2ff4f5c68b92cbb86bace028498b092410c1641320cb2a03e0.png","/editorial-assets/2e17720421e64b69ceb21ab670045a1a47b07256483230c533b7e2ef64bb72dd.png","/editorial-assets/0ac37a38112b367469724a8f7641a711fbef305a754d3ede14fb83a3c87d1b1a.png","/editorial-assets/7d9368d8dcd13a3e9515d02bd64f9bf4a3b433fabc2bfa75b2e234ba2d0ab1e2.png","/editorial-assets/d3e012de0bcd3f51551a8e694ece84716d7d3cf34c127c82724b631a53b0aa20.png","/editorial-assets/8b09654f149a0833f1ed5113b1e5c5a2f80e613a1bf5376f708a4bfd6873872f.png","/editorial-assets/d390e63d585890ea3c28613a4ad2b9a8fc60fa639e1bf4592f3b24349e259613.png","/editorial-assets/81eabe1eab96b720179c1bb9c396fed4e1b97ff69e19cd82dfca3f8f1cec2a47.png","/editorial-assets/f1546ab7a96a28ca7758499c6c942bf13c528d222a5da5533550e5527e526938.png","/editorial-assets/0c5756a088f4aff5e2da8e90737fda3012d2bdec5d25867fbce1a820b9d4fefa.png","/editorial-assets/c06e8da5a5f4ac59568c754015217c9b8d877fbc02ad69660a9b448653a237b9.png","/editorial-assets/ebe91cbfb85f3cb6f07ada134231a1b1fb0b5d133bbcbba43e88be8377294b2a.png","/editorial-assets/94b052a7ca1b89c2c0b79c47ec79b8a80a090d217a4591b2f91902a0f6a5ef62.png"],"contestId":"948","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"948A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/948/problem/A"},"children":[{"kind":"text","text":"948A - Protect Sheep"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Suppose that there is a wolf and a sheep in adjacent cells. It is obvious that in this case, the answer \"NO\" — this particular wolf can always attack this sheep."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, the answer is always \"YES\". The simplest way of protecting all sheep is to place a dog in every empty cell. Then no wolf can move and all sheep are safe and happy."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/A"},"children":[{"kind":"text","text":"923A - Primal Sport"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") be the largest prime factor of "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":". Clearly, we can obtain "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" from any number in interval ["},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") + 1, "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"] by picking "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") as the prime, and we cannot obtain "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" from any other number. By factorizing "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", we can find the range for "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". By factorizing all numbers from the range of "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", we can find intervals for "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":". The answer is the minimum of their union. The solution works in "},{"attrs":{"alt":"","src":"/editorial-assets/1668603bd96b1d0462b4181b67599d5219eecb99d916857540c83a4d0af5165b.png"},"kind":"image"},{"kind":"text","text":", which is fast in practice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bonus: Solve it for "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" queries of "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in "},{"attrs":{"alt":"","src":"/editorial-assets/33c4d8b35e9f96238dae96833f54549cc150a4a23ba65f6004dd25dd4068b6eb.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/B"},"children":[{"kind":"text","text":"923B - Producing Snow"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We can directly simulate the process, but it takes "},{"attrs":{"alt":"","src":"/editorial-assets/98afe20962c9b99df5b90be1ebc048bbe742eaec8c882459125d8874453c7627.png"},"kind":"image"},{"kind":"text","text":" time, which is too slow. There are multiple approaches how to make this simulation faster. We present two of them."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" In the first solution, instead of calculating the total volume of the snow melted, we first calculate two quantities: "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] — the number of piles left after day "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] — the total volume of piles that disappear on day "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". The answer will then be "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]."},{"children":[{"kind":"text","text":"Calculate prefix sums of the temperatures. This way, when a snow pile is formed on day "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", we can use binary search to determine on which day it will disappear completely. Denote this day by "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" and put "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" + 1 if the pile survives. We can note that on every day "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1 inclusive, this pile will lose "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] of its volume, which corresponds to increasing "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] by one. Furthermore, we add the remaining volume to "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To calculate all "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]'s fast, we can again use prefix sums — adding 1 to interval can then be done by two additions."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second solution can handle queries online. For each pile, we calculate how big it would be if it was created on the first day: "},{"attrs":{"alt":"","src":"/editorial-assets/1c9e857116ac3dc8ea9f4ef615c03c4405a836bc231ffe88cd3546cb790d3572.png"},"kind":"image"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"We maintain all existing piles in a multiset. When a day "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" starts, we add "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":"'["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] into the multiset. Then we remove all piles with "},{"attrs":{"alt":"","src":"/editorial-assets/afc5bc953e3b8723c4058743f054eba34ccb1f791f3130f773216c95731e1ff1.png"},"kind":"image"},{"kind":"text","text":" — those are the piles that disappear on day "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" — and easily calculate the total volume of melted snow in them. All the piles left in the multiset contribute exactly "},{"attrs":{"alt":"","src":"/editorial-assets/12e6b25c7dbde12331725d7b04a08c9058532ab0c47e86cbcd16c2db0edc0dfd.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the multiset is sorted, and each pile is added and removed only once, the total complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/0124f05d467fd69f3fe461739b89e80124033639ae1d45ab665f3a52a3f58e23.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/C"},"children":[{"kind":"text","text":"923C - Perfect Security"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We decrypt the message greedily, one number at a time. Note that "},{"attrs":{"alt":"","src":"/editorial-assets/4243ea8523fd89ab0aae51c328042be4a398357089222dcf4f6e55bdfb89914d.png"},"kind":"image"},{"kind":"text","text":" is a bijection on non-negative integers. For that reason, there is always a unique number from the key that lexicographically minimises the string. We can always pick and remove that number, output its xor with the current number from the encrypted text. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It remains to show how to do the above faster than "},{"attrs":{"alt":"","src":"/editorial-assets/98afe20962c9b99df5b90be1ebc048bbe742eaec8c882459125d8874453c7627.png"},"kind":"image"},{"kind":"text","text":". We build a trie on the numbers from the key, more precisely on their binary representation, starting from the most significant bit. To find the number "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" that minimises "},{"attrs":{"alt":"","src":"/editorial-assets/4aaa199903109cb18a014bb42b0d84f48e19f5052870fbbde3e0eee92aa00894.png"},"kind":"image"},{"kind":"text","text":", one can simply search for "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", bit by bit. That is, if the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th most significant bit of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is 1, we try to follow the edge labelled 1, and 0 otherwise. If we always succeed in that, we have found "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in the key multiset, and hence "},{"attrs":{"alt":"","src":"/editorial-assets/6e08e9f9df1108faa098def02a2f84ce6a1b31fbdc738c7b55975a1e2e8aab84.png"},"kind":"image"},{"kind":"text","text":", which is clearly minimal. If at some bit, we do not succeed, we select the other branch (that is, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is 1, but there is no such number in the key set, we pick 0 instead and continue. This solution uses "},{"attrs":{"alt":"","src":"/editorial-assets/f046325a5783526ca608d2128ba54bc4de6c05a14a44198daee6e6f1c1685c6c.png"},"kind":"image"},{"kind":"text","text":" time, where "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" is the number of bits (here it is 30)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The same approach can be also implemented using multiset, which is probably faster to write, but has an extra "},{"attrs":{"alt":"","src":"/editorial-assets/368f2943fd5262e5946ed7fce0db1d3c8dfc5e4dd1dce6f9674523c4afdc6620.png"},"kind":"image"},{"kind":"text","text":" multiplicative factor, which may or may not fit into TL."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/D"},"children":[{"kind":"text","text":"923D - Picking Strings"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First note that "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" can be always changed to "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" and vice versa: "},{"attrs":{"alt":"","src":"/editorial-assets/d812e2cd669cecca2568d2fe417d76e3fc233ade80ba06fe8b7cf905066bf93b.png"},"kind":"image"},{"kind":"text","text":". Hence we can replace all "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":"'s with "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Furthermore, see that: "},{"attrs":{"alt":"","src":"/editorial-assets/c48dbde0251147d16040f53a1bffcf5e9a5b597bb165f6b56507113f2e531304.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The above implies the set of following rules: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/editorial-assets/444c0a9529dab780ba090e6a4acd2642cf097651cfec1cf49de771467f53ca1c.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/1b3c1caffff980250f8efe63063d29bb01942d6f6878235ec6b77df76724d4fa.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/92325ede12b872925810e4b3370179fef9d67aceed39afbb30ddf63c91c17a60.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/638ab344f88df9fa1c9ff5fd838c59f79f9d85a0e82584095ae95da9a4e7f58e.png"},"kind":"image"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can translate these rules to the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the number of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"s can be increased by any non-negative even number "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the number of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"s before any "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" may change arbitrarily "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The only remaining thing is to determine what should happen to the number of trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s. There are three cases: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The number of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s is the same in the source and target "},{"attrs":{"alt":"","src":"/editorial-assets/662afded2cd04174eaa10e947c858eac0ae235bc7656b6ca9210bfe82f26a14d.png"},"kind":"image"},{"kind":"text","text":" the number of trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s can decrease by any non-negative multiple of 3, as no application of the first rule occurs, and the second and third rule cannot affect trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are some "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s in the source and the number of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s increases "},{"attrs":{"alt":"","src":"/editorial-assets/662afded2cd04174eaa10e947c858eac0ae235bc7656b6ca9210bfe82f26a14d.png"},"kind":"image"},{"kind":"text","text":" the number of trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s can decrease by any non-negative number. To decrease the number to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", just morph the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" from the end to "},{"children":[{"kind":"text","text":"BB"}],"kind":"emphasis"},{"kind":"text","text":". To keep it the same, morph any "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"AB"}],"kind":"emphasis"},{"kind":"text","text":" and then to "},{"children":[{"kind":"text","text":"BBB"}],"kind":"emphasis"},{"kind":"text","text":" to introduce extra "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s as needed. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are no "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s in the source, but some "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"'s in the target "},{"attrs":{"alt":"","src":"/editorial-assets/662afded2cd04174eaa10e947c858eac0ae235bc7656b6ca9210bfe82f26a14d.png"},"kind":"image"},{"kind":"text","text":" the number of trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s has to decrease by any positive integer. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is now easy to calculate prefix sums of the "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" occurrences, and calculate the number of trailing "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"'s for every end position. The rest is just casework. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/E"},"children":[{"kind":"text","text":"923E - Perpetual Subtraction"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We can model this process as a Markov chain with "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" + 1 states with transition matrix"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/6e49c6a774852bd7e4266d814d434bf0a67702b7aebddfa51cdb2c6ec39fea9b.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The task is to find "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". A naive solution using Matrix exponentiation is obviously too slow, as it uses "},{"attrs":{"alt":"","src":"/editorial-assets/8c7155dd77970cca1fdd71ae4956a42655452bcb2d8a059c7ef80aef7f531d25.png"},"kind":"image"},{"kind":"text","text":" time. We need to improve upon it and we look for eigenvalue decomposition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is a triangular matrix, thus its eigenvalues are the elements on the main diagonal. Hence"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/61d97c09ac312ee050652cd8a397bd61f894c64be36f622683f0aa001ac76bac.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that the eigenvector corresponding to "},{"attrs":{"alt":"","src":"/editorial-assets/b3f7482082d5ccd2aab6a60d71a39ba39d8321babb1372648fbd6304615ab453.png"},"kind":"image"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/editorial-assets/0b1853ea22cc751416bbf25bf8ce4b2393a744e206b747a3c49eb30c2f6555d6.png"},"kind":"image"},{"kind":"text","text":" (consult proof at the end)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, we have "},{"attrs":{"alt":"","src":"/editorial-assets/ee89e45af347d945d284432fa5efb16d8a8b43b2ffcfc990120dec25f777fb7f.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To finalise the eigenvalue decomposition, we need to find the inverse of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":". It can be shown "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" are the same up to the sign (consult proof at the end): "},{"attrs":{"alt":"","src":"/editorial-assets/91ced4b6c0991fc933b35f293238b82ae97ae085d79080ca781807e7c532ba68.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The advantage of eigendecomposition is that "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":"·Λ"},{"children":[{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":",  where the diagonal matrix Λ can be exponentiated in "},{"attrs":{"alt":"","src":"/editorial-assets/df70a3832d1db48c57da177fcb3a4fd0f8940471aecdc10364e6f3a82efbdd5b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can calculate the result as "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":"·(Λ"},{"children":[{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"·("},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":")) ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Performed naively, this runs in "},{"attrs":{"alt":"","src":"/editorial-assets/209fecbbc6cf778c84dcf7365c581c1dc7462d07ddc3524b72b9bef06df5ccc0.png"},"kind":"image"},{"kind":"text","text":", which is still too slow. We obviously need to multiply with "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" (and its inverse) faster."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fortunately, both linear functions "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" are a convolution and we can compute the multiplication in "},{"attrs":{"alt":"","src":"/editorial-assets/0124f05d467fd69f3fe461739b89e80124033639ae1d45ab665f3a52a3f58e23.png"},"kind":"image"},{"kind":"text","text":" using FFT, which is a bit hinted by the modulus in which to compute the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof of the eigenvectors"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We show that "},{"attrs":{"alt":"","src":"/editorial-assets/0d9f46cf4cdb81fa9bae0a3463f7f5a8c1a9639300ba4f708273c7ed7fec03de.png"},"kind":"image"},{"kind":"text","text":" it holds"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/1d86d76dbaae449adac933e009481fdc775e2f36e6e6013ece154fa1db9fb193.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"where the fifth equality can be proven by induction on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof of the inverse"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"QQ"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, we show that the diagonal of the product only contains ones. This is easy, since the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th row of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" has zeroes until "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1-th column, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th column of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" has zeroes starting from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th row, and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1. Thus, "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1. Next we show that the "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0 for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". When "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", all the summands in the inner product are zero. It remains to show the claim for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/e6b4a62848299ddacea580bc7c04546b34f2fd5128d409e04c1dcd23971cac42.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof that "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" are convolutions"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Put "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"kind":"text","text":" - 1"}],"kind":"superscript"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". We want to show that "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" can be computed by convolution. See that"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/74506eed053d1d2ff4f5c68b92cbb86bace028498b092410c1641320cb2a03e0.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"hence "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is a convolution of functions "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":" up to some multiplicative factors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The proof for "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" is similar, we can just remove all the ( - 1)"},{"children":[{"kind":"text","text":"α"}],"kind":"superscript"},{"kind":"text","text":" terms."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"923F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/923/problem/F"},"children":[{"kind":"text","text":"923F - Public Service"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"For "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 0, we call graph "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-star, if we can remove "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" vertices to form a star, and we cannot remove "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1 vertices to form a star. In this terminology, a 0-star is a star. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It should be rather obvious that if one of the graphs is a 0-star, then the answer is clearly No. This is because the minimum degree of a vertex in a tree is 1, and star has a vertex of degree "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - 1, and the corresponding vertex in the merged graph would have degree at least "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":", which is clearly impossible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Surprisingly, the answer is Yes in all other cases. We prove this by giving an explicit construction. There are three cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Assume that one of the graphs is 1-star. Without loss of generality let it be "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":". Denote "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" the vertex that can be removed to turn "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" into star, "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" its only neighbor, and "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" be the vertex of degree "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - 2. In graph "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":", find any leaf and denote it "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":"'. Let its only neighbour be "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"'. Furthermore, pick "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"' a vertex that is not adjacent to "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"' (such vertex always exists as "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":" is not a star). Observe that mapping "},{"attrs":{"alt":"","src":"/editorial-assets/2e17720421e64b69ceb21ab670045a1a47b07256483230c533b7e2ef64bb72dd.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/0ac37a38112b367469724a8f7641a711fbef305a754d3ede14fb83a3c87d1b1a.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/7d9368d8dcd13a3e9515d02bd64f9bf4a3b433fabc2bfa75b2e234ba2d0ab1e2.png"},"kind":"image"},{"kind":"text","text":" does not introduce multiedges in the merged graph. Furthermore, all other edges in "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" are incident to "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", but none of the unprocessed edges in "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":" are incident to "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":"'. We can thus map the remaining "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - 3 vertices arbitrarily. "},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/d3e012de0bcd3f51551a8e694ece84716d7d3cf34c127c82724b631a53b0aa20.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mapping a 1-star "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" (in red), to arbitrary tree "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":" (in blue). See that there are no multiedges between "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", no multiedges from "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" to the rest of the graph (since "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":"' have no neighbours there), and no multiedges in the rest of the graph (since "},{"attrs":{"alt":"","src":"/editorial-assets/8b09654f149a0833f1ed5113b1e5c5a2f80e613a1bf5376f708a4bfd6873872f.png"},"kind":"image"},{"kind":"text","text":" is a graph with zero edges)."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" = 4 or "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" = 5: There are only five non-isomorphic trees on this many vertices. Two of them are 0-stars (for which the answer is No), two of them are 1-stars (that we handled in previous case). The only remaining graph is a path on five vertices. Two such graphs can always be merged together. For simplicity of implementation, we can simply try all 5! possible mappings."},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/d390e63d585890ea3c28613a4ad2b9a8fc60fa639e1bf4592f3b24349e259613.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All trees on 4 or 5 vertices."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, we use induction. In "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":", find two leaves "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") ≥ 3 and "},{"attrs":{"alt":"","src":"/editorial-assets/81eabe1eab96b720179c1bb9c396fed4e1b97ff69e19cd82dfca3f8f1cec2a47.png"},"kind":"image"},{"kind":"text","text":" is not a star. This is always possible: either "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" is a 2-star, and then we can pick one of the neighbouring leaves of the vertex with highest degree and one other leaf, or we can pick any two leaves that are not adjacent to the same vertex. Do the same thing for "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":", finding "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"' and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"'. Remove these pairs of vertices from the respective graphs and use induction to merge those smaller graphs. Now we can either map "},{"attrs":{"alt":"","src":"/editorial-assets/2e17720421e64b69ceb21ab670045a1a47b07256483230c533b7e2ef64bb72dd.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/0ac37a38112b367469724a8f7641a711fbef305a754d3ede14fb83a3c87d1b1a.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/f1546ab7a96a28ca7758499c6c942bf13c528d222a5da5533550e5527e526938.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/0c5756a088f4aff5e2da8e90737fda3012d2bdec5d25867fbce1a820b9d4fefa.png"},"kind":"image"},{"kind":"text","text":" — as only one of these mappings may introduce a multiedge. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The above is relatively simple to implement in "},{"attrs":{"alt":"","src":"/editorial-assets/c06e8da5a5f4ac59568c754015217c9b8d877fbc02ad69660a9b448653a237b9.png"},"kind":"image"},{"kind":"text","text":". To turn it into an "},{"attrs":{"alt":"","src":"/editorial-assets/ebe91cbfb85f3cb6f07ada134231a1b1fb0b5d133bbcbba43e88be8377294b2a.png"},"kind":"image"},{"kind":"text","text":" algorithm, we need to maintain a few additional information about the graph. Furthemore, note that a graph "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-star if and only if the maximum degree is |"},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"| - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The list vertices sorted by their degree, for instance using set of pairs. This is so that we can find the vertex with maximum degree easily, which is useful for testing "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-starness. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the set of vertices with a leaf neighbour, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the set of leaves neighbouring a given vertex, so that we can find the leaves quickly "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Using the above, we can always find appropriate leaf and remove it in "},{"attrs":{"alt":"","src":"/editorial-assets/94b052a7ca1b89c2c0b79c47ec79b8a80a090d217a4591b2f91902a0f6a5ef62.png"},"kind":"image"},{"kind":"text","text":", which is sufficient."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/58286"}