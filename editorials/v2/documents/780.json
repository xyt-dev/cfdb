n: "},{"attrs":{"alt":"","src":"/editorial-assets/1892faa775c4b7e5c25c1eb3a5154faf609f66556bde0d8fe6326428f6425139.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/df4d0da621c563260f2b1e43bfa494c391dde7fd95fc867c050ddfd1de47d9f8.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To use the matrices "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to find the answer, let us store "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" — the largest answer found, and "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" — the set of vertices reachable from the vertex 1 in exactly "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" steps. Let's process "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" by decreasing from a certain value "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", and see if "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" can be increased by 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". The next 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" characters after "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":"-th position will form the string "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" depending on the popcount parity of "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":". Let's denote "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"' the set of vertices reachable from "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" following "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"' is non-empty, we can increase "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" by 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":", and assign "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"', otherwise, we don't change anything. In the end, "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" will be the maximal path length as long as it at less than 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that we can take "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" = 60 since we don't care about exact value of answer if it is greater than 2"},{"children":[{"kind":"text","text":"60"}],"kind":"superscript"},{"kind":"text","text":". This results in an "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") solution, which is too slow. However, optimizing boolean multiplication with bitsets cuts the working time "},{"attrs":{"alt":"","src":"/editorial-assets/55f30edebc01e85df9098796c40ac5431f07d250b6eea54f91a84bfb59609b01.png"},"kind":"image"},{"kind":"text","text":" times, and the solution is now fast enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/815e3f66e317ccac618788de4747a2398f1395347ae083c695fbdad2d5a73e2d.png"},"kind":"image"},{"kind":"text","text":" time, and "},{"attrs":{"alt":"","src":"/editorial-assets/f22180ea5c386877afa2b662f53d1cea77b60f8d2dc9f84a5dc447c54388578c.png"},"kind":"image"},{"kind":"text","text":" memory. Here "},{"attrs":{"alt":"","src":"/editorial-assets/affcf649a7f539f88b0c2abaa46a017f780728e03d04eb1b6818f60d638eab65.png"},"kind":"image"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" = 64 is the word length in bits."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"781E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/781/problem/E"},"children":[{"kind":"text","text":"781E - Andryusha and Nervous Barriers"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Solution 1: Let us move a sweep-line from the bottom to the top, and say that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th barrier is active if the current "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-coordinate satisfies "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If we want to find the result of dropping a ball in column "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" at a certain moment, we have to find the highest active barrier that covers "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" at the moment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us store a segment tree, with a set of active segments in each tree node. When introducing a new active segment, we represent it as a union of "},{"attrs":{"alt":"","src":"/editorial-assets/f855e7521dc8ff78c984005d9448d5764e39f6561d15f0c11007fc20d194f9aa.png"},"kind":"image"},{"kind":"text","text":" tree nodes, and add this segment in each of these nodes' set; when a segment becomes non-active, we delete these entries. If at any point we are interested in finding the highest active barrier for a column "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", we consider all "},{"attrs":{"alt":"","src":"/editorial-assets/f855e7521dc8ff78c984005d9448d5764e39f6561d15f0c11007fc20d194f9aa.png"},"kind":"image"},{"kind":"text","text":" tree nodes covering "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and look at their highest entries only. Also, for each segment we store the number of resulting balls after hitting this segment; this number can be found by making two queries to the tree (for the two balls resulting from the collision) at the same time we activate the barrier. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To find the final answer, for each column drop a ball in it from height "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and sum the results. Thus, the answer can be found in "},{"attrs":{"alt":"","src":"/editorial-assets/379c465ab46a0df8b3610f36f9835afa2d18365358d6d8be9f2186eae0e2d0c8.png"},"kind":"image"},{"kind":"text","text":" time (with the second logarithm for std::set working time)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution 2: Let us go from the top to the bottom instead, and maintain positions of all balls to be dropped. If any of these balls occupy the same position, we group them together and store the size of the group. Each column will have a separate stack of groups, with lower groups on top of the stack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's see how a new barrier ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] changes our configuration. For each column ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] we want to drop several lowest groups on the barrier, which will result in creating at most two new groups next to the barrier. Let us store a segment tree of size "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", with "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-th entry equal to the height of the lowest group in column "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". While ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] range minimum in the segment tree is low enough, we pop the lowest group from the corresponding stack (and update the segment tree accordingly). Finally, we create the new groups, and push them to their respective stacks. After processing all barriers, the rest groups will fall straight to the bottom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A standard amortized estimate shows that "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":") operations will be performed, for "},{"attrs":{"alt":"","src":"/editorial-assets/cade8d3e4a96159c9a6aeaad6ac6805c48c288850ec4373264861077d7133035.png"},"kind":"image"},{"kind":"text","text":" time complexity."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"781F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/781/problem/F"},"children":[{"kind":"text","text":"781F - Intranet of Buses"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let us do a binary search on the answer. Inside it, we have to check if at any time moment bus pairs 1 and 2, 2 and 3, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and 1 are within distance "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" of each other simultaneously."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") be the location of the bus 1 (that departed at time 0) at time "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". Let us call a time moment "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" good, if we have ||"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":")|| ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", with ||"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"|| equal to the distance between points "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". If there is a moment "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - 1)"},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" are all good, then the answer is at least "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can build the two-dimensional graph (as in \"function graph\", not \"graph with vertices and edges\") of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") over time by keeping track of segments where points "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") are. When the points are bounded to a pair of sides, the vector "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") changes linearly in time. There are "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time moments when either point switches from side to side, hence the difference graph can be constructed in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time with the two pointers approach."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, for a certain "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" let's find the set of good moments "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". We will do this separately for each segment of the difference graph, and then paste the answers. We have the condition ||"},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":"|| ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" ranges over a segment. This is the segment-circle intersection problem, which is a standard geometrical primitive, with various approaches from solving quadratic equations to rotating a certain vector by an angle. In any case, the result will be a time range or an empty set. Note that "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" may stay still for a certain time range of the graph, which should be treated separately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To ensure that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"), and so on are all good for certain "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", let us \"cut\" the segment [0, "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"] into "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" equal parts and superimpose them, with \"good\" segments possibly being cut into parts, now overlapping each other. A suitable moment "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" is now a point that is covered "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" times. Finding such point is a simple scan-line application."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/8f4d061f5c8dbc2f00647cf65acfe2bada1c5f86e7ebaa47ff4c67d497c6ef19.png"},"kind":"image"},{"kind":"text","text":", where ε is the required relative precision."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/50854"}