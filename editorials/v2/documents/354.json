{"assets":["/editorial-assets/49fdd513f9d7cf9033c5db266994698c86c1645e24aea2e582f2654571d66262.png","/editorial-assets/197b6265f639bd6ea53e64bfe0edf44b4c1b511af1b9a8bb069525e3fb9041c5.png","/editorial-assets/7dc1aecc5670a68ee58830849d5f8c53c0f757be31a9f746acfda8c2af90b3a5.png","/editorial-assets/80b73e2247fac0776122d956dd6ee06008f0c63fc935aadd4997ebcaece73873.png","/editorial-assets/138d6bcaef61d7d3eefedbddbe1ae4ea9dd22f6f0dade0797d7fd7a3095cf3fa.png","/editorial-assets/a774a8e282c1a988d2fa8591941bff84a4d22de90c2951ff8723dee4250b7327.png","/editorial-assets/2f12ed1b8f3e28446109ea978849c135004b1f920d24c7a1fa32d5d2fb4d463d.png","/editorial-assets/da084bc7687cd0780c073f0670ae03471c6a444b5f4b0f4a12fd218a55428d3a.png","/editorial-assets/3eec97bfaba7cc4e97346d7efee524b44b1b1d72b0da7d2aae8bdd1c32165dfe.png","/editorial-assets/9a64bf2b0658471478979fda9230a9062eff4259cc38a40bc53546e3a7943189.png","/editorial-assets/f1b88c221a1e192958bfbd375e0f66c8c1b581a4a188f0160b93ccf763d53ee1.png","/editorial-assets/9d8af150e54befe53ada97a06ab0e92fb0f9f7fa3394f8a8946d6901638c8655.png","/editorial-assets/b8656f7358fe8cf17a30cd7164673477d3c293819f22bd640eda0fb849b9cc0d.png","/editorial-assets/0f01403b803d41176086335e85eb4931552ef2e7ddb53ababf8622a254afb381.png","/editorial-assets/ac129eb6d660fffe87a40fda8266b11cde1d5599a79c0d79057be2d2e9c42d57.png","/editorial-assets/0c00ece6cf12a76dbdda78440c7f5d69129dd719e0bda8c2e3f3aee84e77bb8b.png"],"contestId":"354","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/355/problem/A"},"children":[{"kind":"text","text":"355A - Vasya and Digital Root"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" = 0, the there is the only number with "},{"attrs":{"alt":"","src":"/editorial-assets/49fdd513f9d7cf9033c5db266994698c86c1645e24aea2e582f2654571d66262.png"},"kind":"image"},{"kind":"text","text":", so, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1, the answer is 0, otherwise — "},{"children":[{"kind":"text","text":"No"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"solution"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" > 0, then one of correct numbers is "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" × 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) + "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") for the output."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/355/problem/B"},"children":[{"kind":"text","text":"355B - Vasya and Public Transport"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we buy a ticket of the fourth type, we don't have to buy anything else, so, the answer is "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"answer"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"using"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"tickets"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"of"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"first"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"three"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"types"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, when we don't have ticket of the fourth type, we can solve the task separately for buses and trolleys."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solving the problem only for buses: if we buy a ticket of the third type, we don't have to buy anything else, so, the answer is "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"answer"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"using"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"tickets"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"of"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"first"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"two"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"types"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Without tickets of type three, we can solve the problem separately for each bus. If we buy a ticket of the second type, we will spend "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" burles and if we buy "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" tickets of the first type, we will spend ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":") burles. So, the answer for bus "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now it is not difficult to obtain the following solution:"}],"kind":"paragraph"},{"kind":"code_block","text":"  function f(x, k) {\n    res = 0;\n    for i = 1 .. k\n      res = res + min(c2, x[i] * c1);\n\n    return min(c3, res);\n  }\n\n  ans = min(c4, f(a, n) + f(b, m));\n"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/354/problem/A"},"children":[{"kind":"text","text":"354A - Vasya and Robot"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Brute force how many times we will use operation from the left. So, if we use it "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" times, then it's clear, that we will take first "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" items by the left operations and last ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") items by the right operations. So, robot will spend "},{"children":[{"kind":"text","text":"sumLeft"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"]·"},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"sumRight"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"]·"},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" energy plus some penalty for the same operations. To minimize this penalty we should perform the operations in the following order LRLRL ... RLRLLLLL ..., starting from the bigger set. For example, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 7, "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 4, we should perform operations in this order: LRLRLRLRL "},{"children":[{"kind":"text","text":"LL"}],"kind":"strong"},{"kind":"text","text":". So, we will have to pay the penalty two times (7 - 4 - 1)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"sumLeft"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] — sum of first "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" weights, "},{"children":[{"kind":"text","text":"sumRight"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] — sum of last "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" weights."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution in pseudocode:"}],"kind":"paragraph"},{"kind":"code_block","text":"  ans = inf;\n  for i = 0 .. n {\n    curr = firstSum[i] * l + lastSum[n-i] * r;\n    if ( i > n - i ) curr = curr + (2i - n - 1) * Ql;\n    if ( i < n - i ) curr = curr + (n - 2i - 1) * Qr;\n\n    ans = min(ans, curr);\n  }\n"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/354/problem/B"},"children":[{"kind":"text","text":"354B - Game with Strings"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will say that cell ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":") corresponds to a string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", if there exist correct path, which ends in the cell ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":") and this path corresponds to a string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let call a set of cells which corresponds to some string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" a state. One state can correspond to different strings. We can't brute force all possible strings, because their count — "},{"attrs":{"alt":"","src":"/editorial-assets/197b6265f639bd6ea53e64bfe0edf44b4c1b511af1b9a8bb069525e3fb9041c5.png"},"kind":"image"},{"kind":"text","text":" is too big, but we can brute force all possible states. It's not hard to observe that all cells that corresponds to some string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" lies on same diagonal, so the total count of states is 2"},{"children":[{"kind":"text","text":"1"}],"kind":"superscript"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" + ... + 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" + 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" + 2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" + ... + 2"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"1"}],"kind":"superscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"). In implementation we can denote state with diagonal number (from 1 to 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) and bitmask of cells corresponding to this state (2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From each state we can move to 26 different states (actually less) and all possible moves depends on the state, not on the string. On the image you can see an example of move: from state, which is highlighted in blue by letter "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" we will move to the state, which is highlighted in yellow."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/7dc1aecc5670a68ee58830849d5f8c53c0f757be31a9f746acfda8c2af90b3a5.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, for each state we can calculate a value of (count of letters A  -  count of letters B) in the string, starting from this state. If at the moment is first players turn (an even diagonal), we have to maximize this value, otherwise — minimize. It can be implemented as recursion with memoization."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The winner can be determined by the value of state, which corresponds to the single cell (1, 1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" × ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"alpha"}],"kind":"emphasis"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"alpha"}],"kind":"emphasis"},{"kind":"text","text":" is the size of alphabet."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/354/problem/C"},"children":[{"kind":"text","text":"354C - Vasya and Beautiful Arrays"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem was to find greatest "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":",  "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" holds for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), then "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Let consider two cases:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/80b73e2247fac0776122d956dd6ee06008f0c63fc935aadd4997ebcaece73873.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/138d6bcaef61d7d3eefedbddbe1ae4ea9dd22f6f0dade0797d7fd7a3095cf3fa.png"},"kind":"image"},{"kind":"text","text":". In this case we will brute force answer from "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". We can check, if number "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" is a correct answer in the following way:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have to check that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" for some fixed "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", which is equals to "},{"attrs":{"alt":"","src":"/editorial-assets/a774a8e282c1a988d2fa8591941bff84a4d22de90c2951ff8723dee4250b7327.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/editorial-assets/2f12ed1b8f3e28446109ea978849c135004b1f920d24c7a1fa32d5d2fb4d463d.png"},"kind":"image"},{"kind":"text","text":". Since all these intervals ["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] doesn't intersects each with other, we can just check that "},{"attrs":{"alt":"","src":"/editorial-assets/da084bc7687cd0780c073f0670ae03471c6a444b5f4b0f4a12fd218a55428d3a.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] — count of numbers "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in the interval ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"maxA"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"maxA"}],"kind":"emphasis"},{"kind":"text","text":"), proof is based on the sum of "},{"attrs":{"href":"https://ru.wikipedia.org/wiki/%D0%93%D0%B0%D1%80%D0%BC%D0%BE%D0%BD%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D1%80%D1%8F%D0%B4"},"children":[{"kind":"text","text":"harmonic series"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/354/problem/D"},"children":[{"kind":"text","text":"354D - Transferring Pyramid"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/3eec97bfaba7cc4e97346d7efee524b44b1b1d72b0da7d2aae8bdd1c32165dfe.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This tasks is solvable with dynamic programming. First of all let consider solution with complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] be the answer for the highlighted in blue part (minimal cost of transferring all special cells that lies inside this area). Then "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"][0] will be the answer for our original problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How to recalculate such DP? It's clear that in the leftmost column (inside the blue area) we will choose at most one cell as the top of some subpyramid. If we choose two, then the smallest one will lie fully inside the biggest one (as the orange subpyramid lies inside the blue one). Now, let brute force the cell, which will be the top of subpyramid in this column in time "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") and we will obtain the following transition:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To simplify the formulas, let assume that "},{"attrs":{"alt":"","src":"/editorial-assets/9a64bf2b0658471478979fda9230a9062eff4259cc38a40bc53546e3a7943189.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/f1b88c221a1e192958bfbd375e0f66c8c1b581a4a188f0160b93ccf763d53ee1.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/9d8af150e54befe53ada97a06ab0e92fb0f9f7fa3394f8a8946d6901638c8655.png"},"kind":"image"},{"kind":"text","text":"0 ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the height on which we will choose our top cell, or 0, if we don't choose any subpyramid in this column. "},{"children":[{"kind":"text","text":"sumUp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"] — count of special cells in the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th column at height starting from "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", this cells we will have to transfer one by one, using the first type operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can reduce the complexity by one "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", if we will recalculate out DP in the following way:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/b8656f7358fe8cf17a30cd7164673477d3c293819f22bd640eda0fb849b9cc0d.png"},"kind":"image"},{"kind":"text","text":"0 ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":";"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/0f01403b803d41176086335e85eb4931552ef2e7ddb53ababf8622a254afb381.png"},"kind":"image"},{"kind":"text","text":" for all "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The proof that this is correct is quite simple and is left to the reader. :)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, we can observe that it is not profitably to take some subpyramid with height greater than "},{"attrs":{"alt":"","src":"/editorial-assets/ac129eb6d660fffe87a40fda8266b11cde1d5599a79c0d79057be2d2e9c42d57.png"},"kind":"image"},{"kind":"text","text":", because for such subpyramid we will pay  > 3"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", but if we transfer all cells using the first type operations we will pay only 3"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". So, the second dimension ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") in out DP can be reduced to "},{"attrs":{"alt":"","src":"/editorial-assets/ac129eb6d660fffe87a40fda8266b11cde1d5599a79c0d79057be2d2e9c42d57.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, to receive AC, you should store only last 2 layers of the DP, otherwise there will be not enough memory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/0c00ece6cf12a76dbdda78440c7f5d69129dd719e0bda8c2e3f3aee84e77bb8b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/354/problem/E"},"children":[{"kind":"text","text":"354E - Lucky Number Representation"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution, much more complicated than suggested by many participants during the competition, easy solution will be described below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First of all, let write a DP with complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"count"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"count"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") is the count of lucky numbers  ≤ "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"count"}],"kind":"emphasis"},{"kind":"text","text":"(10"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":") = 3"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". As we can see, for all sufficiently large "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" solution exists. Really — for every "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" > 523."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, we can say that for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 10000 we have a solution, which is found using DP. Let's solve the task for larger values of "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next and key idea is to separate the task into two parts: "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2. Let's choose "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 and "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 in such way that for them it was easy to find a solution and then merge these two solutions into one. Let "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" 4000, "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1. Here we can have a problem that there is no solution for number "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1, in this case we can do "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 + 4000, "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 - 4000."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now it is guaranteed that solutions exists for both "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 and "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2, moreover, the solution for number "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 will contain only numbers of not more than 3 digits ( < 1000). The proof is quite easy: if "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 < 4000 — it is obvious; else — if the solution uses some number of the form (4000 + "},{"children":[{"kind":"text","text":"some"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"number"}],"kind":"emphasis"},{"kind":"text","text":"), we can replace it with just "},{"children":[{"kind":"text","text":"some"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"number"}],"kind":"emphasis"},{"kind":"text","text":" and receive a correct solution for number ("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 - 4000), but is doesn't exist!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, the solution for number "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1 we have found using DP, now let's find the solution for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2. If it will contains only of numbers of the form ("},{"children":[{"kind":"text","text":"some"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"lucky"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"number"}],"kind":"emphasis"},{"kind":"text","text":" × 1000), then we will be able to easily merge this solution with solution for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1, so, let's find such a solution. Here we will use the fact that "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 is divisible by 4. For simplicity, let's divide "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 by 1000 and in the end multiply all "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"2("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") by the same 1000. Let "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2 / 4. Now, let's construct the solution. Consider, for example, P = 95: we will walk through digits of this number, last digit — 5, means that we want to put digit 4 at the last decimal position of five answer numbers — ok, put it and in the last, sixth, number leave there digit 0. Go forward, digit 9 — we don't have nine numbers, but we can replace seven fours with four sevens, then to the second position we have to put (9 - 7) fours and 4 sevens, in total — 6 numbers, exactly as much as we have."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, if next digit "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 6, we just put to the first "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" answer numbers digit 4 to the next position; if "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" > 6, then we put 4 sevens and ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" - 7) fours. In all other numbers we just leave digit 0 at this position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"1("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") — answer for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"2("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") — for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":"2, the the answer for "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" will be just "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"1("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"Ans"}],"kind":"emphasis"},{"kind":"text","text":"2("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity for one number: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logN"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the competition many participants have wrote the following solution:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — can we put the digit to the last "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" decimal positions of the answer number in such way that we will get correct last "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" digits in the sum and with carry to the next position equals to "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Then the solution exist iff "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[19][0] = "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":". To restore the answer we just have to remember for each state the previous state. Base — "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"[0][0] = "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":". Transition — brute force how many fours and sevens we will put to the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th position."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/8672"}