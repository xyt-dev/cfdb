dren":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" will have ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1)"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" elements. Now for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th kid you should output numbers "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"[("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1) + 1], "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"[("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1) + 2], ... "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"[("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1) + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1] ("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is 1-based). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Gerald"},"children":[{"kind":"text","text":"Gerald"}],"kind":"link"},{"kind":"text","text":" ."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Bvid2."}],"kind":"strong"},{"kind":"text","text":" Solution 1. You should write some bruteforce solution over all numbers with no more than 9 digits (number 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" should be considered separately). Bruteforce algo seems like this:"}],"kind":"paragraph"},{"kind":"code_block","text":"dfs( int num ) // run it as dfs(0)\n  if (num > 0 && num <= n) ans++\n  if (num >= 10^8) return\n  for a = 0..9 do\n    if num*10+a>0 then\n      if number num*10+a has no more than 2 different digits then\n        dfs( num*10+a )\n"},{"children":[{"kind":"text","text":"ans will store the answer. After that you wrote bruteforce, you can run it and see that it works fast (that is same time for any testcase)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution 2. Let's build all undoubdetly lucku numbers using bitmasks. You can iterate over length of number "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":", pair of digits "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", and bitmask "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" of length "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":". If the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is 1, the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th digit of number should be "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"; otherwise it should be "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". So about 10"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":" × 2"},{"children":[{"kind":"text","text":"10"}],"kind":"superscript"},{"kind":"text","text":" numbers will be generated (it is very rough estimate, count of numbers will be more than 10 times less)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this solution you should accurately process the case of leading zeroes and the case when all digits of number are same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Gerald"},"children":[{"kind":"text","text":"Gerald"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Adiv1, Cdiv2"}],"kind":"strong"},{"kind":"text","text":" Let's see how function "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" changes for all suffixes of sequence "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Values of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" will increase when you will increase length of suffix. For every increase all 1-bits will stay 1-bits, but some 0-bits will be changed by 1-bits. So, you can see that no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" increasing will be, where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" number of bits (in this problem "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 20). Among all suffixes will be no more that "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 values of function "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you can run over sequence "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" trom left to right and support an array "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" (or a set) of values of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" for all subsegments that end in the current position. Size of "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" always no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1. When you go from position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 into position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", you should replace "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = {"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"} by "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"' = {"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", ... "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"}. After that you should remove from "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" repeated values (if you use set, set will do this dirty work itself). Then you should mark all numbers from "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" in some global array (or put them into some global set). At the end you should calculate answer from the global array (or set)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Authors are "},{"attrs":{"href":"https://codeforces.com/profile/Gerald"},"children":[{"kind":"text","text":"Gerald"}],"kind":"link"},{"kind":"text","text":" , "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Bdiv1, Ddiv2"}],"kind":"strong"},{"kind":"text","text":" You should check for every edge: this one can be body of hydra or not. Let's fix some edge ("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") (order of vertices is important, i.e. you should also check edge ("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":")). Now you should chose some set of "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" vertices connected with "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and some set of "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" vertices connected with "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". These sets should not contain vertices "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Also, these two sets should have no common vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"attrs":{"alt":"","src":"/editorial-assets/3b0d0b5c80bb0084d43c4fe6291c2b42c37d82a9d03412372edafe85e6dcb124.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/169c434851bf04c66073e5618552abff82f89029d9cae80a30abc37e350c628b.png"},"kind":"image"},{"kind":"text","text":", there is no any hydra here."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Orherwise, if "},{"attrs":{"alt":"","src":"/editorial-assets/e8a73179ca1d7e8dda8c6978bc47034106595e2f68c707d3b2570ad6836f2ac5.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/cf7ab74eaab5100f840e0f2bec83d83b6cf49b2420db5ee86e34a51d96204ee6.png"},"kind":"image"},{"kind":"text","text":", there is some hydra in any case. Even if all vertices connected with "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and with "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" are common, number of them so big, that you always can split them into groups of size  ≥ "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" and size  ≥ "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last case is "},{"attrs":{"alt":"","src":"/editorial-assets/0be2c39e31502c11e143b11825e0375b37f0b76f4964c1b3a77da7893db25f08.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/aa50b07bea76a729d84b27260fba2c5ca5665474fb8d7910fc9478967c1fb2a8.png"},"kind":"image"},{"kind":"text","text":". Here you can find all common vertices in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"), using array of flags. When you find the common subset, you can easy check existence of hydra."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"UPD"}],"kind":"strong"},{"kind":"text","text":" How to find common vertices in O(h + t) using array of flgs? You should initailize that array in the beginning of program. For every check you should do following actions. Firstly in "},{"attrs":{"alt":"","src":"/editorial-assets/24e69d679000c916598e8bbd81b998e04aa202f172f04f0b98ac78eff80df933.png"},"kind":"image"},{"kind":"text","text":" you should mark in the array all neighbours of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". After that you should iterate over all adjacent to "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" vertices and check value of flag in the array for every of them (in "},{"attrs":{"alt":"","src":"/editorial-assets/ec5f95e9b650ecc24a35039f75617daf2cd4f32adbbaf0ecd8a2c8132578a2ea.png"},"kind":"image"},{"kind":"text","text":"). Vertices that have \"thue\" in the array will be common. Finally you should clear the array in "},{"attrs":{"alt":"","src":"/editorial-assets/24e69d679000c916598e8bbd81b998e04aa202f172f04f0b98ac78eff80df933.png"},"kind":"image"},{"kind":"text","text":": you should iterate over all adjacent to "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" vertices again and mark these vertices in the array as \"false\". Because "},{"attrs":{"alt":"","src":"/editorial-assets/e670cfc4d5cc697e603a257a031d52cd86ba8f00e553ff9ea1013f29ddb420ce.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/a48d65f1bcfe53b1ba58b4262482b5326629e76333e33ae60d6626b8de82059c.png"},"kind":"image"},{"kind":"text","text":", the total complexity will be O(h + t)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All edges can be checked in time "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":")). So you either find reqired edge or find that there is no required edge. Also in time "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") you can build hydra with fixed body-edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This problem also has solution in "},{"attrs":{"alt":"","src":"/editorial-assets/a96815ad39c4293c9aa30f91fa85aeefd1ee3dbfa3b1a573bfcde266c1c754c9.png"},"kind":"image"},{"kind":"text","text":" independent from values of "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", but this solution is more complex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"},{"kind":"text","text":" "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Cdiv1, Ediv2"}],"kind":"strong"},{"kind":"text","text":" Firstly tou should emulate all process in \"idle mode\". Let farmer was in points ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2), ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2), ... , ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1 / 2). Coordinates "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1, ... "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1 on axis "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" are interesting for us. Coordinates "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1, ... "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1 on axis "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" are interesting too. You should store all of them into two arrays. Also you should add to these coordinates bounds of the field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then you should build \"compressed\" field: every cell of this field means rectangle of the starting field that placed between neighbour interesting coordinates. Size of the compressed field is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") × "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Let's initally all cells painted into the white color. Now you should emulate all process again and paint all visited cells in the compressed field by the black color. During every move you will paint "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") cells, so all process will be done in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you should emulate bugs' actions. You should run DFS (ot BFS) from some border cell of the compressed field and paint all reached cells be red color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the end you should iterate over all compressed field and find sum of areas of rectengles corresponding to black and white cells. So, you will receive the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"},{"kind":"text","text":" "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Ddiv1"}],"kind":"strong"},{"kind":"text","text":" You need for every column find the lowermost cube that you can see. You will see all cubes above this cube."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the city from above. You will see drid of size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". Now you should draw the line through every node of the grid parallel to vector "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". We need know only that happens in every strip between two neighbour lines. Every column cover segment of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") adjacent strips."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you should create an array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"; every element of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" corresponding to one strip. This array will store maximal height of considered columns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then you should sort all columns in order if increasing distance from observer. In that order you should do following queries of 2 types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"Minimum on segment. This query is needed when you want find the lowermost visible cube."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Replace "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" → "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":") on segment. You need this query for \"drawing\" column in the array."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"That is all solution. You just need choose some data structure that can fast do queries. You can select from: block decomposition (length of every block should be "},{"attrs":{"alt":"","src":"/editorial-assets/18cc6aa2fb5a5821c487baa2398d4e5e10cc7faffa1d2fb410447b773c2e3ac2.png"},"kind":"image"},{"kind":"text","text":"; because length of every query about "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"), total complexity of solution will be "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5 / 2"}],"kind":"superscript"},{"kind":"text","text":")), segment tree ("},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":"), stupid array (it's "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"), cache optimized implementaton fits in the time limit)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Ediv1"}],"kind":"strong"},{"kind":"text","text":" We will build the matrix constructively. At any step we will have array of groups of columns. Order of groups is defined but order of columns inside every group is unknown."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During building we will change order of rows because it is doesn't affect the answer (we can build answer using order of columns only)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the way of building of the matrix. Firstly you should find the row that has maximal number of ones. You should swap this row with the first row. Aftar that two groups of columns should be created. Into the first group you should put columns that have \"1\" in the firts row; all other columns should be stored into the second group. The second group is \"special\" — see about it below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you should more times search the row that has \"1\" in at least two groups. For every of that rows you can determine positions of all ones no more than only way. If you determined no ways, you should output NO and finish execution. After that you determined positions of ones, you should split some groups of columns into two subgroups."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"About \"special\" group. You should take into account case when you should drop some columns from this group and insert them before all groups. You will never face with situation when it is not clear which columns should be dropped and which should not, because in the beginning you chose the row with maximal number of ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After repeating process than described above sevaral times, \"good\" rows may end. I.e. for every row all ones will be placed in no more than one group. Now you should recursively do solution described above inside every of groups of columns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"). It can be upgraded to "},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":", but it was not required."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"UPD"}],"kind":"strong"},{"kind":"text","text":" Also here some "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") solution exists based on PQ-trees, as said "},{"attrs":{"href":"https://codeforces.com/profile/mugurelionut"},"children":[{"kind":"text","text":"mugurelionut"}],"kind":"link"},{"kind":"text","text":". More information "},{"attrs":{"href":"https://codeforces.com/blog/entry/5895#comment-112518"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/5895"}