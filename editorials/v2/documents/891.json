{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" = {"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"} if 1 wasn't in t we would have "}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/96a1bdacd8500c93657277daa7c8e57d69bb9ad7a7614d62a89d46c5eb8eb9f8.png"},"kind":"image"},{"kind":"text","text":" otherwise consider "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" = {"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"} = "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" then 1 can't be in "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" and we have "},{"attrs":{"alt":"","src":"/editorial-assets/32fb75fc7f766e46f2fde6c61d5f5ea6ef65f54bddc27bc58c0f4d9ca3d930a9.png"},"kind":"image"},{"kind":"text","text":" so "},{"attrs":{"alt":"","src":"/editorial-assets/57eea09dc0e1f9c5c1b519e147fd090f5413576a346bc54d130fabc93c8f9c24.png"},"kind":"image"},{"kind":"text","text":" and we are done!"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"891C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/891/problem/C"},"children":[{"kind":"text","text":"891C - Envy"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It can be proven that there's a MST containing these edges if and only if there are MSTs that contain edges with same weight. So for each query we need to check if the edges with weight X have a MST. For checking this, if we remove all edges with weight greater than or equal to X, and consider each connected component of this graph as a vertex, the edges given in query with weight X should form a cycle in this new graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can check this for all queries offline by sorting edges from minimum weight and do simple dfs for each weight in each query."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"891D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/891/problem/D"},"children":[{"kind":"text","text":"891D - Sloth"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If graph had odd number of vertices the answer is 0. Otherwise let's call edges that by removing them the remaining graph would have two even components good, and all the other edges are bad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you remove a good edge and put another edge somewhere such that the final graph is a tree, then it would have prefect matching if and only if the input tree had prefect matching."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If no two bad edges share a vertex, after removing a bad edge (lets call it "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":") we should chose the end points of the edge we want to add (lets call them "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") such that the path between "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" in the input tree has alternately bad and good edges, the first and the last edges in the path are bad and "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" is in this path too. So for any path in the tree that has alternately bad and good edges and the first and final edges in it are bad we should add the "},{"attrs":{"alt":"","src":"/editorial-assets/254a5e62be0c7cf1d482fbb8a570cc3b2214be10c64a4f93da977ad4ffc274d0.png"},"kind":"image"},{"kind":"text","text":" to the answer. This can be done using dp."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are bad edges that share vertices, we know that each vertex has odd number of bad edges to its neighbors, and if this number is greater than 3 then the answer is 0. So each vertex has 1 or 3 odd edges to its neighbors. The path between end points of added edge should contain all the vertices with 3 bad edges and also two of their bad edges should be in the path. So if the vertices with 3 bad edges aren't in a path with this condition then the answer is 0 and otherwise we can calculate the answer by checking some conditions in their path and counting the number of paths with some condition at the end points of their path."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"also there's another solution using dp by "},{"attrs":{"href":"https://codeforces.com/profile/KAN"},"children":[{"kind":"text","text":"KAN"}],"kind":"link"},{"kind":"text","text":" : "},{"attrs":{"href":"https://codeforces.com/contest/891/submission/32407269"},"children":[{"kind":"text","text":"32407269"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"891E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/891/problem/E"},"children":[{"kind":"text","text":"891E - Lust"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Lemma : expected value of res is equal to multiply of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"s minus expected value of multiply of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"s at the end of process. Prove : Imagine that at the end of process, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" turns to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). For this case, it is easy to prove that res is equal to multiply of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"s minus multiply of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"s (can be proved by induction). So we can see truth of lemma."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as expected value of multiply of mask's subset after k'th repeat. Now we want to calculate this dp. Fix index of k'th chosen number. If mask's subset contains that fixed number, then expected value of multiply of mask's subset decreases by expected value of "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" (mask2 is equal to subset of mask minus chosen fixed number). If mask's subset doesn't contains fixed index, then expected value of multiply of mask's subset doesn't change. More formally , for all indices i from 1 to n :"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/92c784aa80763be583a4556be11db7acd720f67d36eeca7f0e5655f90de9d6f9.png"},"kind":"image"},{"kind":"text","text":". (If mask contains i'th element)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/d071b6eb7c8dc2d5deb6c654a480ef9d105c71a16782ad9715ec221e51530046.png"},"kind":"image"},{"kind":"text","text":" (If mask dosent contains i'th element)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we can write :"}],"kind":"paragraph"},{"chi