,"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Sum will decrease, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"iT"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < 0, in ather words "},{"attrs":{"alt":"","src":"/editorial-assets/865f5beda38103055303646ff3e57eba5c9fb13c980724486b470d48ff4d15c2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"container"},{"children":[{"kind":"text","text":"Therefore, one can't decrease average time, if subtrees are sorted by increasing value "},{"attrs":{"alt":"","src":"/editorial-assets/a93caf5880ad986ca409f3007137ef4fe891d14327ff014dd5f3f0e28c050e98.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"container"},{"children":[{"kind":"text","text":"So, we must to sorted trees in this order and traveling from them in this order."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"7. Candies and Stones. (E Div-1)"}],"kind":"strong"}],"kind":"container"},{"children":[{"children":[{"kind":"line_break"}],"kind":"strong"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Essence of problem is that there is a board "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" in cell of wich placed numbers. And one must go from cell (0, 0) to cell ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - 1), doing moves to one cell up and right (that is, increasing by 1 on of coordinates), maximizing sum o number on the cell in the path."}],"kind":"container"},{"children":[{"kind":"text","text":"Gerald's problems is determine "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 cells of optimal path. Lets start with search one, middle cell. Lets "},{"attrs":{"alt":"","src":"/editorial-assets/0ed3481962478b6d04d0329ce087017986d6c406d75d324c07fe1f9a03c67713.png"},"kind":"image"},{"kind":"text","text":". What cell of board can be "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th in path? It is cell, sum of coordinate of wich is equal to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", thus, it is diagonal of doard. And then we can calculate, what maximum sum Gerald can collect, came to every cell in the diagonal, by dynamic programming in lower triangle. And the same way, we can calculate, what maximum sum Gerald can collect, came to cell (n-1,m-1), starting from every cell in the diagonal. Sumed up this to values, we calculate, what maximum sum Gerald can collect, came to from cell (0, 0) to cell ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - 1), travel throw every cell in the diagonal. And now we will find cell ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"), in wich maximum is reached. It is "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th cell of the path. We used time "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") and memory "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"text","text":"Then we make recursive call on subproblems. In other word, will find optimal path from cell (0, 0) to cell ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") and from cell ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") to cell ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"text","text":"It is evident, this solution take memory O(n+m). Why it tkae time O((n+m)^2)?"}],"kind":"container"},{"children":[{"kind":"text","text":"Lets "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Once we are find middle cell of path of length "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Twice we are find middle cell of path of length "},{"attrs":{"alt":"","src":"/editorial-assets/aa8523cb71bc7e5f156b5c1df870ea082a143b1ea470068a8ddafae6610f805e.png"},"kind":"image"},{"kind":"text","text":". Four times we are find middle cell of path of length "},{"attrs":{"alt":"","src":"/editorial-assets/de1b188467e8e73fd087aacff66e1e812fa8e734a193b3e6cb4a64cbe595fb7d.png"},"kind":"image"},{"kind":"text","text":". And so on. Therefore, time of program working will be "},{"attrs":{"alt":"","src":"/editorial-assets/a2f74b9a9e6ff71b0a8a1f91232f220b37c9eacb25547d6044861786738e5f2f.png"},"kind":"image"},{"kind":"text","text":". Thus, this solution take time "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"container"}],"kind":"container"}],"kind":"container"}],"kind":"container"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/2393"}