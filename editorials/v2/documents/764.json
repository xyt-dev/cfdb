{"assets":["/editorial-assets/f141fd2eff4a6b2476b4dae3898a4c201c1896233f1ea3e1943cd1e6733ab251.png","/editorial-assets/8e9ae41b003685ffac3f59fc7d0236591231763b13948102c1fe2c8983188e98.png","/editorial-assets/d3014a3e636b9d0293c006598a33c313a423c5c3ad0cb05119a5bc26f3a1e4b1.png","/editorial-assets/c9e2c5657f3c0f55ad990513e4233fcfed70a0ede8477b4c9408748e972eefa1.png","/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png","/editorial-assets/e4ba9223f6b622d862b68e36a95570602cb18cef3332df419708dd28732c4632.png","/editorial-assets/f20c97f1a96b3477f214548489b3007e763179232a627f697cba1065c1320db1.png","/editorial-assets/ce18dce7d55985f48390e781e3062b4af3cef7436449fa83e80b62136f227882.png","/editorial-assets/ebeb36d722aa748fa73f147d3cb41e956b2e71f7b938f39d532620b28371dc73.png","/editorial-assets/f321211db63e641aa57b5d5a6b9b82f9575df50420972871b73a00f22144ca1f.png","/editorial-assets/9bcd8a58daaa4cba999c5b29deea9b195757c57215d9cd0924b5958aed644271.png","/editorial-assets/9f8920fc9759584e3084a0756b58fd9706ad9eb88644e35e38f1268a4fdf0719.png","/editorial-assets/7081f470688523b0c06263b01bcbed8559622c3de7eee46744846f2416ec8474.png","/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png","/editorial-assets/f342d794b611aa86aa607a27f30e134607f685c2b99a068ae04a2311d7458909.png","/editorial-assets/d2f89bf8c66d7f1883442c8192db04a33520d187115c013fce56c289817a8e7b.png","/editorial-assets/9b3c681a5da95694dbd7a5f8768694d6880b86156eacfc3506f325f8839ecf91.png"],"contestId":"764","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"764A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/764/problem/A"},"children":[{"kind":"text","text":"764A - Taymyr is calling you"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"You can look over all minutes of the day. If both events happen on the some minute, we increment our answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/jBB0fbu5"},"children":[{"kind":"text","text":"http://pastebin.com/jBB0fbu5"}],"kind":"link"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/s17b2_voroneckij"},"children":[{"kind":"text","text":"s17b2_voroneckij"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/s17b2_voroneckij"},"children":[{"kind":"text","text":"s17b2_voroneckij"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"764B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/764/problem/B"},"children":[{"kind":"text","text":"764B - Timofey and cubes"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Note that Dima's operations are reversible. If we apply them to the current order, we will get the initial. Also note that all the elements on even positions will remain on their places. Such numbers are affected an even number of times, so nothing will change. Similarly all elements on odd positions will change places with simmetrial ones relatively the centre. So, we change elements on odd places with their pairs. This works for "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/X8R0i9vM"},"children":[{"kind":"text","text":"http://pastebin.com/X8R0i9vM"}],"kind":"link"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"763A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/763/problem/A"},"children":[{"kind":"text","text":"763A - Timofey and a tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Take any edge which vertices are colored in different colors. If such edge doesn't exist you can print any vertex, because all the tree is colored in the same color. Otherwise, try to make a root from each of these vertices. Check if is possible with simple dfs. If it succeedes for one of them, print \"YES\" and this vertex. If it fails for both vertices, the answer is \"NO\". Indeed, if both of them cannot be the root, they lay in the same subtree and they are colored differently. So the condition isn't fulfilled. The asymptotics of this solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/M58NY7C1"},"children":[{"kind":"text","text":"http://pastebin.com/M58NY7C1"}],"kind":"link"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"},{"kind":"text","text":" , "},{"attrs":{"href":"https://codeforces.com/profile/ilya_the_lamer"},"children":[{"kind":"text","text":"ilya_the_lamer"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"763B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/763/problem/B"},"children":[{"kind":"text","text":"763B - Timofey and rectangles"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's consider vertical touchings graph, where vertex is rectangle. For each vertex we keep x coordinate of bottom-right angle. While moving to next rectangle it changes by odd number. In this graph doesn't exist cycle of odd length (sum of odd number of odd numbers can't be zero). Similar to this you can see about horizontal touchings. Let's consider two touching rectagles. Sides lengths are odd, so "},{"attrs":{"alt":"","src":"/editorial-assets/f141fd2eff4a6b2476b4dae3898a4c201c1896233f1ea3e1943cd1e6733ab251.png"},"kind":"image"},{"kind":"text","text":" give different colors for adjacent rectangles, where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinate of bottom-left angle and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" coordinate of bottom-left angle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/ntEV9bGt"},"children":[{"kind":"text","text":"http://pastebin.com/ntEV9bGt"}],"kind":"link"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/ilya_the_lamer"},"children":[{"kind":"text","text":"ilya_the_lamer"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/ilya_the_lamer"},"children":[{"kind":"text","text":"ilya_the_lamer"}],"kind":"link"},{"kind":"text","text":" , "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"763C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/763/problem/C"},"children":[{"kind":"text","text":"763C - Timofey and remoduling"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First, let's think about the case when 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this editorial we say that an outcoming sequence is "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1)"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is the difference of some two elements "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/editorial-assets/8e9ae41b003685ffac3f59fc7d0236591231763b13948102c1fe2c8983188e98.png"},"kind":"image"},{"kind":"text","text":"). Let's say that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" was on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th place in the sequence and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" was on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th place. Then "},{"attrs":{"alt":"","src":"/editorial-assets/d3014a3e636b9d0293c006598a33c313a423c5c3ad0cb05119a5bc26f3a1e4b1.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the other hand, we have that "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is less then "},{"attrs":{"alt":"","src":"/editorial-assets/c9e2c5657f3c0f55ad990513e4233fcfed70a0ede8477b4c9408748e972eefa1.png"},"kind":"image"},{"kind":"text","text":", so "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" must be difference of exactly "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 pairs of elements of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":". We can count this value in "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" time using binary search or in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time using a hashtable. Then we know the value of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". After that we calculate the value "},{"attrs":{"alt":"","src":"/editorial-assets/e4ba9223f6b622d862b68e36a95570602cb18cef3332df419708dd28732c4632.png"},"kind":"image"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is prime so we can use Fermat's little theorem) and then we know the difference of the sequence. Then we just take any element "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and look on values "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", ..., and also on "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - 2"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", .... If we can get all of the numbers in "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" in this way, then we know the first element of the sequence. Otherwise, the answer is NO."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", we just solve the problem for the complement of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"attrs":{"alt":"","src":"/editorial-assets/f20c97f1a96b3477f214548489b3007e763179232a627f697cba1065c1320db1.png"},"kind":"image"},{"kind":"text","text":", and then add to the first element value ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":". If we had a correct sequence in "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", then we must have a correct sequence in its complement with the same difference (as long as "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is coprime with the difference, the complement is just set of numbers "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"nd"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1)"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - 1)"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/jTdcUpFM"},"children":[{"kind":"text","text":"http://pastebin.com/jTdcUpFM"}],"kind":"link"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/platypus179"},"children":[{"kind":"text","text":"platypus179"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/platypus179"},"children":[{"kind":"text","text":"platypus179"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"763D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/763/problem/D"},"children":[{"kind":"text","text":"763D - Timofey and a flat tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"There are only 2·("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) subtrees in the whole tree: two for each edge. Let's calculate hashes of each of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can calculate hash of a subtree, for example, in a following. Let's associate each vertex with a correct bracket sequence. Leaves are associated with \"()\", other vertices are associated with their sequences according to the following rule. Assume that the children of our vertex are associated with sequences "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let's sort strings "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in some order, for example, in order of ascending hashes. Then our vertex is associated with sequence ("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"... "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). It's easy to check that isomorphic subtrees are associated with equal sequences and non-isomoriphic are associated with different sequences. Then hash of a subtree is the hash of the sequence associated with the root of the subtree. In this problem we will calculate the polynomial hash because we will need to count the hash of concatenation of several strings knowing only their hash and length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know hashes for all of the leaves. Let's do a bfs-like algorithm that will greedily count all of the hashes. Let's count "},{"children":[{"kind":"text","text":"out"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" – number of outer edges for vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", for which we have already counted hashes of their subtrees. Then we know new hashes in two cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"attrs":{"alt":"","src":"/editorial-assets/ce18dce7d55985f48390e781e3062b4af3cef7436449fa83e80b62136f227882.png"},"kind":"image"},{"kind":"text","text":". Then we can calculate the hash for the inner edge of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", for which we don't already know the outer hash in "},{"attrs":{"alt":"","src":"/editorial-assets/ebeb36d722aa748fa73f147d3cb41e956b2e71f7b938f39d532620b28371dc73.png"},"kind":"image"},{"kind":"text","text":" time."}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/f321211db63e641aa57b5d5a6b9b82f9575df50420972871b73a00f22144ca1f.png"},"kind":"image"},{"kind":"text","text":". Then we can calculate the hash for all of the inner edges, for which we don't already know it. Let's calculate hashes for all of concatenations of prefixes and suffixes of the sorted array. If we count polynomial hash, we can calculate them knowing only their hashes and length. Then when we calculate the hash for particular edge, we just have to concatenate the prefix and the suffix of our array. This all works in "},{"attrs":{"alt":"","src":"/editorial-assets/9bcd8a58daaa4cba999c5b29deea9b195757c57215d9cd0924b5958aed644271.png"},"kind":"image"},{"kind":"text","text":" time. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now we have to calculate for each vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" the number of distinct hashes in case "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is the root. Let's select some vertex and calculate this number fairly, using dfs and storing for each hash number of its occurrences in a hashtable. Then we go through the tree in order of Euler tour and maintain the hashtable. When we go through edge "},{"attrs":{"alt":"","src":"/editorial-assets/9f8920fc9759584e3084a0756b58fd9706ad9eb88644e35e38f1268a4fdf0719.png"},"kind":"image"},{"kind":"text","text":", we should add hash of the edge "},{"attrs":{"alt":"","src":"/editorial-assets/7081f470688523b0c06263b01bcbed8559622c3de7eee46744846f2416ec8474.png"},"kind":"image"},{"kind":"text","text":" and remove hash of the edge "},{"attrs":{"alt":"","src":"/editorial-assets/7081f470688523b0c06263b01bcbed8559622c3de7eee46744846f2416ec8474.png"},"kind":"image"},{"kind":"text","text":", other hashes in the hashtable doesn't change."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This works in "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/05KPvqN1"},"children":[{"kind":"text","text":"http://pastebin.com/05KPvqN1"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bonus: Find the vertex with minimal amount of distinct subtrees in terms of isomorphism in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/platypus179"},"children":[{"kind":"text","text":"platypus179"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/platypus179"},"children":[{"kind":"text","text":"platypus179"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"763E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/763/problem/E"},"children":[{"kind":"text","text":"763E - Timofey and our friends animals"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's build a segment tree on crow families. Let's save DSU in each vertex, having information about number of components of connectivity on it. In one vertex will be DSU with size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". In two vertices will be DSU with size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / 2. In four vertices will be DSU with size "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / 4. It's easy to show that we will store only "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlogn"}],"kind":"emphasis"},{"kind":"text","text":") values. Let's understand how we can unite segments. Knowing answer (number of components) for [a; b) and [b; c) we can obtain answer for [a; c) in the following way: We can sum answers for for [a; b) and [b; c) and substract number of components, which united during the \"gluing\". If components become united, there is edge between vertex in one and vertex in another. We have constraint on edge legth: vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" can be connected only if "},{"children":[{"kind":"text","text":"abs"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" Then we can easily unite two segments of the segment tree in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") time: we just unite some of the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" components of families represented in the end of each segment when they are connected by edge. Segment tree can split query in "},{"attrs":{"alt":"","src":"/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png"},"kind":"image"},{"kind":"text","text":" already calculated segments. So we can answer the query in "},{"attrs":{"alt":"","src":"/editorial-assets/f342d794b611aa86aa607a27f30e134607f685c2b99a068ae04a2311d7458909.png"},"kind":"image"},{"kind":"text","text":" time. Precalc will take nearly "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author's solution: "},{"attrs":{"href":"http://pastebin.com/1CwUVyME"},"children":[{"kind":"text","text":"http://pastebin.com/1CwUVyME"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bonus: Solve the problem in "},{"attrs":{"alt":"","src":"/editorial-assets/d2f89bf8c66d7f1883442c8192db04a33520d187115c013fce56c289817a8e7b.png"},"kind":"image"},{"kind":"text","text":" time for the precalculation and "},{"attrs":{"alt":"","src":"/editorial-assets/9b3c681a5da95694dbd7a5f8768694d6880b86156eacfc3506f325f8839ecf91.png"},"kind":"image"},{"kind":"text","text":" time for the query."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/KAN"},"children":[{"kind":"text","text":"KAN"}],"kind":"link"},{"kind":"text","text":" Development: "},{"attrs":{"href":"https://codeforces.com/profile/platypus179"},"children":[{"kind":"text","text":"platypus179"}],"kind":"link"},{"kind":"text","text":" , "},{"attrs":{"href":"https://codeforces.com/profile/ilya_the_lamer"},"children":[{"kind":"text","text":"ilya_the_lamer"}],"kind":"link"},{"kind":"text","text":" , "},{"attrs":{"href":"https://codeforces.com/profile/akvasha"},"children":[{"kind":"text","text":"akvasha"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/50205"}