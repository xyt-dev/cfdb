s. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need to use binary search and iterate on volume of tea which will be poured for every girl. Let on current iteration ("},{"children":[{"kind":"text","text":"lf"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":") / 2 = "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":". Then if for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" it is correct that "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1 to 2 * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" it is correct that 2 * "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" then we need to make "},{"children":[{"kind":"text","text":"lf"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":". Else we need to make "},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptoti