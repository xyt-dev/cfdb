xt":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th positions in all string then we can write any symbol. Obviously, it is better to write not '?' but any letter, 'x' for example. Lastly we should consider the case when there are only '?' and one the same letter on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th positions. In this case we should find this letter and put it to the answer."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/412/problem/D"},"children":[{"kind":"text","text":"412D - Giving Awards"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's build sought permutation by adding employee one-by-one. Let's we already define the order of the first "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" employees: "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let's place "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th after "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"-th. If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"-th employee owe money to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th then we will swap their positions (and will get permutation "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":"-th employee also owe money to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th then we will also swap their positions and so on. If all first "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" employees owe money to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th then "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th employee will be placed first in permutation. This algorithm has time complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is the number of the debt relationships."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/412/probl