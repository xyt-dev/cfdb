{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" isn't important for us. Really, if we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equal to "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" then it also be equal to "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". And if we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" not equal to "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" then it also be not equal to "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". So, we have an answer that is closer or further to both of s and t. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we interested about such position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equal to "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" further from "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". If we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equal to "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" further from "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". It means that we need to divide these positions into two equal parts to have equidistant string. For example, we can make first of these positions closer to "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", second closer to "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" and so on. If the number of these positions is even, we find an answer, if it is odd, answer doesn't exist. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/545/problem/C"},"children":[{"kind":"text","text":"545C - Woodcutters"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can solve this problem using dynamic programming or greedy algorithm. Start with DP solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define "},{"children":[{"kind":"text","text":"stay"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as maximal count of trees that woodcutters can fell, if only trees with number from 1 to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" exist, and "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th tree isn't cutted down, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th tree is cutted down and fallen left, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th tree is cutted down and fallen right correspondingly. Now we can compute this values for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" by "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time because for each next we need only two previous value. Answer is maximum of "},{"children":[{"kind":"text","text":"stay"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also this problem can be solved by the next greedy algoritm. Let's fell leftmost tree to the left (it always doesn't make an answer worse). After that, try to fell the next tree. If we can fell it to the left, let's do it (because it also always doesn't make an answer worse). If we can't, then try to fell it to the right. If it is possible, let's do it. Last step is correct because felling some tree to the right may only prevent the next tree's fallen. So we may \"exchange\" one tree to another without worsing an answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/545/problem/D"},"children":[{"kind":"text","text":"545D - Queue"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can solve this problem by greedy algorithm. Let's prove that it is always possible find an answer (queue with the maximal number of not disappointed people), where all not disappointed people are at the begin of queue. Assume the contrary — there are two position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", persons at position from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1 are disappointed, but "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th person isn't. Then just swap persons at positions "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". After that all persons from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1 will be still disappointed (or become not disappointed) and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th person will be still not disappointed. So the answer isn't maked worse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we need to find person with minimal "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", that can be served now and will be not disappointed. We can do that by sorting all the people by time "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and try to serve them one by one. If somebody will be disappointed, we may send he to the end of queue, and doesn't add his serve time to the waiting time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity — "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"sort"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/545/problem/E"},"children":[{"kind":"text","text":"545E - Paths and Trees"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's true, that Dijkstra modification, where in case of equal distances we take one with shorter last edge, find an answer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For prove that let's do some transformation with graph. At first, find all shortest paths from "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to other vertices. Define "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the length of shortest path from "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". After that, we can delete some edges. Specifically, we can delete an edge with ends in "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" and weight "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" if |"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"| ≠ "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":", because it isn't contained in any shortest path, so it isn't contained in shortest path tree. After that, we can direct all edges from vertices with less distance to vertices with greater distance (because of all weight are positive). It's easy to prove, that if we take one edge that entering each vertex, we have a shortest path tree. Then we only need to take for each vertex minimal egde, that entering this vertex. Why? Because we have to take at least one edge, that entering each vertex to make a graph connected. We can't take edges with less weights than minimal. And if we take minimal edges, that entering each vertex we will have an shortest path tree. So that is minimal possible total wieght of shortest path tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see, that Dijkstra with modification do exactly the same things."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity — "},{"attrs":{"alt":"","src":"/editorial-assets/9da868919fa4eafb00ba5b3937648442c6f9570abcfa73635c5ab43b31ff76fd.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/17982"}