ind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"| > |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"|."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus we can sort all numbers and check only adjacent ones. There are exactly "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 of such pairs. The only thing left is to find minimal distance of all pairs and count pairs with that distance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"792B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/792/problem/B"},"children":[{"kind":"text","text":"792B - Counting-out Rhyme"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The task was just about implementing algorithm described in statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is one of many possible ways of doing this. Firstly you should notice that doing "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" iterations in "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th step is equal to doing "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") iterations (0-based numbering). That is less than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now fill array of length "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" with ones and create pointer to current leader. Then on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th step move pointer to the right (from cell "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 proceed to 0) till you encounter "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") ones. When finished, write 0 to this cell and move pointer to next cell which contains 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"792C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/792/problem/C"},"children":[{"kind":"text","text":"792C - Divide by Three"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's declare a function which takes number as a string and erases minimal number of digits in substring from 2-nd to last character to obtain beautiful number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that if the answer for given string exists, then this function will erase no more than 2 digits. If the number is divisible by 3 then sum of its digits is also divisible by 3. So here are the only options for the function:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Sum of digits is already equal to 0 modulo 3. Thus you don't have to erase any digits. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists such a digit that equals sum modulo 3. Then you just have to erase this digit. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All of the digits are neither divisible by 3, nor equal to sum modulo 3. So two of such digits will sum up to number, which equals sum modulo 3 ((2 + 2) "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" 3 = 1, (1 + 1) "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" 3 = 2). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let positions of non-zero numbers be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then you can easily see that its enough to check only three function outputs: on substrings ["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"], ["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] и ["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]. We imply that all digits to the left of the taken non-zero digit are erased. As we can erase no more than 2 digits, these options will cover all the cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exists no answer for any of substrings, than you need to check if the number contains 0 — it will be answer in that case. If there is no 0, then answer is  - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise the answer is the function output of maximal length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"792D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/792/problem/D"},"children":[{"kind":"text","text":"792D - Paths in a Complete Binary Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"In this editorial "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" represents the number of vertex we are currently in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" be the maximum integer number such that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is divisible by 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" (or the number of zeroes at the end of the binary representation of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"). It is easy to prove that if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 0, then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is a leaf; if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1, then both children of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" are leaves, and so on. Even more, the difference between "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and any of his children is exactly 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":". So to traverse to the left child, we have to subtract 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" (if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is not a leaf), and to traverse to the right child, we add 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How can we process traversions up? Let "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" be the number of the parent node. "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" has exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 zeroes at the end of its binary representation, so to traverse from "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", we need to either add or subtract 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". And to traverse from "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" we also have to either subtract or add 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". One of these operations will lead us to the number divisible by 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":" and not divisible by 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 2"}],"kind":"superscript"},{"kind":"text","text":", and we need to choose this operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/061f03dfac64ea4a63f53e580688442a55ab5dcea4a0714bc640c4a531adceb4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"792E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/792/problem/E"},"children":[{"kind":"text","text":"792E - Colored Balls"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If we want to divide all balls from some box into "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" sets with sizes "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 (and there are "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" balls in this box), then either "},{"attrs":{"alt":"","src":"/editorial-assets/a4fa9d8cd47ff24a51055c0ae95648e3a730aa670ac9fbe3cfcebcad68bf82fd.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/f32ecaafab50ea0a44638e261f16df4b7533f543595722fd12d233bf5d74578e.png"},"kind":"image"},{"kind":"text","text":". So the solution will be like that:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Iterate over the possible sizes of sets "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" (from 1 to "},{"attrs":{"alt":"","src":"/editorial-assets/e8b98b271ccd5b48bc689fbd753d0f497e3faf46d425ed4adde95e2ec668a76f.png"},"kind":"image"},{"kind":"text","text":", or to some constant — in our solution it's 40000) and check if we can divide all balls into sets with sizes "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then iterate over the number of sets "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", calculate the sizes of sets if we want to divide the first box exactly into "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" sets and try to divide balls from all other boxes into sets of these sizes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If we want to divide "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" balls from the same box into "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" sets, then the sizes will be "},{"attrs":{"alt":"","src":"/editorial-assets/78e1a561b3fab880ee92d27c2ccfefb54abe6946afa47f1e04496fb332e9659a.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/a3208ae824bff9a9e5db6a440eb6183efc9d6d6d56ede5f1e6e6911a64a529c2.png"},"kind":"image"},{"kind":"text","text":"; but if "},{"attrs":{"alt":"","src":"/editorial-assets/5e1c7fae9072890c51635d4b6e667f707237911847f44614fc9d04b659508a6d.png"},"kind":"image"},{"kind":"text","text":", then we also have to check if sizes can be "},{"attrs":{"alt":"","src":"/editorial-assets/64729e22ddd16f9e02606f9afb99f85a085ca626934418aead3c43d1bf25013a.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/78e1a561b3fab880ee92d27c2ccfefb54abe6946afa47f1e04496fb332e9659a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we fix sizes "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and we want to check whether we can divide a box with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" balls into sets with these sizes (and to get the minimum possible number of such sets), then the best option will be to take "},{"attrs":{"alt":"","src":"/editorial-assets/ec7b09639c4ee62d1f7b642ea596e74acba6797c84e9961b9efd6631bf876e8d.png"},"kind":"image"},{"kind":"text","text":" sets. If "},{"attrs":{"alt":"","src":"/editorial-assets/98de661696c09c7a9834f60189c670709e1bc7f702b081e275ec1ad8fc85ed18.png"},"kind":"image"},{"kind":"text","text":", then such division is possible. If not, then it's impossible to divide "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" balls into sets of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity of this solution is "},{"attrs":{"alt":"","src":"/editorial-assets/cfa7d6a2c0101fd007cd4b95caa9d0961db7d91d82532f0039fdfd70162d9538.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"792F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/792/problem/F"},"children":[{"kind":"text","text":"792F - Mages and Monsters"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's represent spells as points on cartesian plane. If we consider three spells "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is above "},{"children":[{"kind":"text","text":"AC"}],"kind":"emphasis"},{"kind":"text","text":" on the cartesian plane or belongs to it, then we don't need to use spell "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" because we can replace it with a linear combination of spells "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" without any additional mana cost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can maintain the lower boundary of the convex hull of all points from 1-type queries and the point (0, 0). Then to process 2-type query we have to find the intersection of aforementioned lower boundary and the line "},{"attrs":{"alt":"","src":"/editorial-assets/34b071296ee3f0f8895f2ddfc995d3b48196f0d8c24fcf123667f7e08891e398.png"},"kind":"image"},{"kind":"text","text":" (our average damage in this fight has to be at least this value). If there is no intersection, then the answer is NO because even with infinite mana Vova's character can't deal that much damage before dying. If there is an intersection, we have to check that it is not higher than the line "},{"attrs":{"alt":"","src":"/editorial-assets/3d9837238fc78f05b134b11a43a7773eb23c3a1b5754286fd7dfc4a61d050d71.png"},"kind":"image"},{"kind":"text","text":" to ensure that we have enough mana to kill the monster in given time. Model solution uses only integral calculations, but it seems that long double precision is enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/51254"}