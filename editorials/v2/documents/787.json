"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":", and such "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" exist, then "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":", so you can iterate over "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and check if such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" exists. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c91a0b5502c991cb46e8d72f03f1ad36c8a84d2d7f2dfb9e47db825e970c0024.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/252fac9890bd3879b626f46c8571062fe00967208a56b289ac184b311e7a4c64.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"problemCode":"787B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/787/problem/B"},"children":[{"kind":"text","text":"787B - Not Afraid"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The problem says given a CNF formula, check if we can set value of literals such that the formula isn't satisfied. Answer is yes if and only if you can set values so that at least one clause isn't satisfied. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to show that answer is yes if and only if there's at least one clause that for that clause there's no "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/a57099d9f7cb38013b5b17a881149bb2e7f52003243af39970bfd454a7e0ecfa.png"},"kind":"image"},{"kind":"text","text":" are both in it. This can be easily implemented."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/6ef131e97c8696159dcfc1c2c0b45f3ce927fbd866a5f62573235c306c791b78.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/d02ba2b42228b412842c5558c35f3ed56b287a01d158330035a02dc51053873b.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"problemCode":"786A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/786/problem/A"},"children":[{"kind":"text","text":"786A - Berzerk"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"For each state of monster (2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" possible states, the position and whose turn it is) we will determine if it will be won, lost, or stuck in loop (the player whose turn it is, will win, lose, or the game will never end if this state happens). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For this purpose, first each state with monster on 1 is lost. Then if we consider a graph that its vertices are our 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" states, we will recursively determine the answer for each vertex. If a state has an edge to a lost state, it's won, and if all its edges are to won states, it's lost. The vertices that are neither lost or won at the end have answer \"loop\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can implement this using a simple memoize."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/c06e8da5a5f4ac59568c754015217c9b8d877fbc02ad69660a9b448653a237b9.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/4c7977ab5f31b08b4a77af7bf399e347300f4a428ba886149522d9dfcd00eb49.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"problemCode":"786B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/786/problem/B"},"children":[{"kind":"text","text":"786B - Legacy"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Consider a weighted directed graph (initially it has "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices and no edges). We will construct a segment tree to handle queries of second type (and one for the third type but with similar approach)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Build a segment tree on number 1, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". For each node of segment tree consider a vertex in the graph. For each leaf in this tree (like one with interval ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" + 1)), add an edge with weight equal to 0 from vertex corresponding to this node to vertex "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" in the original graph. And for each non-leaf node, add an edge with weight equal to 0 from vertex corresponding to this node to the vertex corresponding to node of each of its children."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we're adding about 4"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices and edges to the graph. For each query of second type, we will add an edge from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to each maximal node of segment tree that ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") contains ("},{"children":[{"kind":"text","text":"lg"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") nodes for each query) with weight equal to "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And construct a segment tree in the same way for queries of third type. Finally run Dijkstra's algorithm on this graph. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/157b2f08d7300d73df668d030e21f789726bb9fe4dbbad71c8ebf17bb801edb8.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/fdd885b27d378fcffd472f8d834caf65862c966da7eb3aa58a52199752cf8d6d.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"problemCode":"786C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/786/problem/C"},"children":[{"kind":"text","text":"786C - Till I Collapse"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Your task is to find the minimum number of parts needed to partition this such that each part contains no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" different numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a fixed "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", we can greedily find the answer. First, fix a maximal partition with at most "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" different numbers in it, then a maximal after that and so on. If answer for "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), we can find this number in "},{"attrs":{"alt":"","src":"/editorial-assets/736d80363a987b5c8434318c25dff1cdf79defd28d36cd7db08555dbe28a5cf7.png"},"kind":"image"},{"kind":"text","text":". The only thing we want is to find maximum "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" for a fixed "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" so that ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] has at most "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" distinct numbers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This can be done with binary search + segment tree, but it's too slow. We can do this using a persistent segment tree in "},{"attrs":{"alt":"","src":"/editorial-assets/facc4ade6b369bca0a45764d9c61c2e5820631c33bfada9b2854c2e8d5d874ab.png"},"kind":"image"},{"kind":"text","text":": for a fixed "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", we define "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") to be 1 if "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and there's no such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" otherwise 0. So, if we have a segment tree on every "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we can use this segment tree to find the first "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" for an arbitrary "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" (it's like finding "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"},{"kind":"text","text":" one in this array)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we find the answer in "},{"attrs":{"alt":"","src":"/editorial-assets/736d80363a987b5c8434318c25dff1cdf79defd28d36cd7db08555dbe28a5cf7.png"},"kind":"image"},{"kind":"text","text":", so the total complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/1c449819a5648e4d7b6ce5a663af7a590c793d3fa31d1263813804c2ad7b44fb.png"},"kind":"image"},{"kind":"text","text":", and because "},{"attrs":{"alt":"","src":"/editorial-assets/acec7e76ceed34bd8c1fc75a2ea3eeb1250800ed43b76d0c0da84d2fe598fdbe.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/9096615aff965516db828d409d6c88c4ddec189f8048f3cb4205a69c57c4f876.png"},"kind":"image"},{"kind":"text","text":", so:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Total time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/157b2f08d7300d73df668d030e21f789726bb9fe4dbbad71c8ebf17bb801edb8.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/7991f36cd16cd2beb2e6870e8076480ccfe2a48b76b2df3649628272b89b0dc2.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"problemCode":"786D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/786/problem/D"},"children":[{"kind":"text","text":"786D - Rap God"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Use centroid-decomposition. In each decomposition: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is centroid of current subtree. Then for each vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" in current subtree, we want to find some part of answer for each query with "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". More precisely, for each query ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is in the current subtree (in the decomposition), we want to find the number of vertices like "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" is also in the subtree, if we remove the centroid from the tree "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" will be disconnected (centroid itself satisfies this condition) and "},{"children":[{"kind":"text","text":"str"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":") < "},{"children":[{"kind":"text","text":"str"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"str"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"str"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":") + "},{