:"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1. We will iterate over these primes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose prime "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" is fixed. For each number we know that it's either divisible by "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" or we can pay "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" to fix it or it should be in the subarray to change for "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can use dynamic programming dp[number of numbers considered][subarray to change not started/started/finished] = minimal cost"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"Nd"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"Nlog"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")), where "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" is the number of primes to check."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/623/problem/C"},"children":[{"kind":"text","text":"623C - Electric Charges"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First of all consider cases where all points are projected to the same axis. (In that case answer is difference between maximum and minimum of this coordinate)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now consider leftmost and rightmost points among projected to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" axis. Let "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are their "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-coordinates. Notice that points with x-coordinate "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" may also be projected to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-axis and that will not increase the diameter. So, if we sort all points by "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-coordinate, we may suppose that points projected to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-axis form a continuous subarray."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will use a binary search. Now we will need to check if it's possible to project point in a such way that diameter is <= M."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's fix the most distant by "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-coordinate point from 0 that is projected to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-axis. It may be to the left or to the right of 0. This cases are symmetrical and we will consider only the former one. Let "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < 0 be its coordinate. Notice that one may project all points such that 0 ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" and |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"| ≤ |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"| to the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" axis (and it'll not affect the diameter) and we have to project other points to "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-axis. Among all other points we should find the maximum and minimum by "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" coordinate. Answer is \"yes ("},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":")\" if "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" <  = "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" and distance from ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", 0) to both (0, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") and (0, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") is not greater than M."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's precalculate maximums and minimums of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" coordinates on each prefix and suffix of original (sorted) points array. Now iterate over left border of subarray of points projected to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-axis and find the right border using binary search or maintain it using two-pointers technique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we've got one check in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":") or "},{"attrs":{"alt":"","src":"/editorial-assets/f8b6caf6e650cd665af253868688dd42664ec93fe840ec99ea8ece44c7864aa2.png"},"kind":"image"},{"kind":"text","text":" and entire solution in "},{"attrs":{"alt":"","src":"/editorial-assets/5e114c71da2fd17e9e39db26a5da5b85983d00cf699d42ec6d99f8bc1bd35bac.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/440684056d8aa7e89cd29cefb86e1677741af996060a5d541a1beb022556d692.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/623/problem/D"},"children":[{"kind":"text","text":"623D - Birthday"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Main idea: first of all guess each friend once, then maximize probability to end game on current step. Let's simulate first 300000 steps, and calculate "},{"attrs":{"alt":"","src":"/editorial-assets/6ed554e90032eed539cc2b01025e6e9762e414e129362e2cbcc7e551ae398a33.png"},"kind":"image"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/editorial-assets/a0b7d8749bb94ab833d27f033e9603d07b45be833c34ec0bf42a220084fc38ec.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — how many times we called "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th friend ("},{"attrs":{"alt":"","src":"/editorial-assets/310eeed5ed8727e4d2e483c5fbcaee7644b02076a17c6573cbf077ebc844c56c.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Expectation with some precision equals "},{"attrs":{"alt":"","src":"/editorial-assets/f959c57f8aebb005bb26c6520a4700a9bc46be87dbef3a4a69fad973bf07f85e.png"},"kind":"image"},{"kind":"text","text":". So it is enough to prove that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Greedy strategy gives maximum values for all "},{"children":[{"kind":"text","text":"Pr"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) On 300000 step precision error will be less than 10"},{"children":[{"kind":"text","text":" - 6"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Suppose, that for some "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" there exists set "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/editorial-assets/4209db53ecb1a267d4e6167530fc93308f232b1e8638dd396311202cb1cb9a69.png"},"kind":"image"},{"kind":