ildren":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" gives bigger value of "},{"children":[{"kind":"text","text":"Pr"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"), contradiction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ 0.99. Let's take set "},{"attrs":{"alt":"","src":"/editorial-assets/d82e91bc9ba1d1fdb5f168970512997f50f7bf86e756a892061d7c782c2a16f0.png"},"kind":"image"},{"kind":"text","text":", it gives probability of end of the game not less than optimal. Then "},{"children":[{"kind":"text","text":"Pr"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":") ≥ (1 - 0.99"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" / 100"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"100"}],"kind":"superscript"},{"kind":"text","text":" ≥ 1 - 100·0.99"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" / 100"}],"kind":"superscript"},{"kind":"text","text":". Precision error does not exceed "},{"attrs":{"alt":"","src":"/editorial-assets/37714af949dc80f522d91d2e604049afc107ec00f520b2fc076109baafd0d525.png"},"kind":"image"},{"kind":"text","text":". It could be estimated as sum of geometric progression. If "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 300000 precision error doesn't exceed 10"},{"children":[{"kind":"text","text":" - 7"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/623/problem/E"},"children":[{"kind":"text","text":"623E - Transforming Sequence"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First observation is that if the sequence of prefix xors is strictly increasing, than on each step "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" has at least one new bit comparing to the previous elements. So, since there are overall "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" bits, the length of the sequence can't be more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". So, if "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", the answer is 0. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's firstly solve the task with "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") complexity. We calculate "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] — the number of sequences of length "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"|... |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" has "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" bits. The transition is to add a number with "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" new bits, and choose those "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" bits which are already in the prefix xor arbitrarily. So, "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1]["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"] is increased by "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"]·2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". The last binomial coefficient complies with the choice these very "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" bits from "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" which will be present in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"|... |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note now that the transition doesn't depend on "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", so let's try to use the idea of the binary exponentiation. Suppose we want to merge two dynamics "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"], "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"], where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the number of bits present in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"|... |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"|... |"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" correspondingly. Now we want to obtain "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] for arrays of size "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":". The formula is:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/a0141ca3a9fc6dbc75a5c11dd3b25e3428645608733e3e65469d6aac31d62eda.png"},"kind":"image"},{"children":[{"kind":"text","text":"Here "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" corresponds to the bits present in the xor of the left part, and for each number of the right part we can choose these "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" bits arbitrarily. Rewrite the formula in the following way:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/be76e6405ebb338346e6035cee5e0a1798ba51569e0026ebed9d1c5684fbbf4b.png"},"kind":"image"},{"children":[{"kind":"text","text":"So, we can compute "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"] for all "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" having multiplied two polynomials "},{"attrs":{"alt":"","src":"/editorial-assets/c217f7c517749722164232d9fbab52dbea2510e19c03ab7e6ebc439671ae773f.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/97ac6d1c2c137ab2a37090422bfd82dff3d4397d47c99edf56f375613b19dc16.png"},"kind":"image"},{"kind":"text","text":". We can obtain the coefficients of the first polynomial from the coefficients of the second in "},{"attrs":{"alt":"","src":"/editorial-assets/581906bb76e4cecd7cc6dd18591213e0499d2039105eb5548cb29256bdb165bb.png"},"kind":"image"},{"kind":"text","text":". So, we can compute this dynamic programming for all lengths — powers of two, in "},{"attrs":{"alt":"","src":"/editorial-assets/7b963941d66adb78fa71ce0b7baa60feb1181ed76df8786e2f1fdb0f66caf0ee.png"},"kind":"image"},{"kind":"text","text":", using the fast Fourier transform. In fact, it is more convenient to compute "},{"attrs":{"alt":"","src":"/editorial-assets/40dbd70b2e54f2249fb17c592c3e416fc0cab929518ab636b82bbdf6be796cc5.png"},"kind":"image"},{"kind":"text","text":" using the same equation. After that, we can use the same merge strategy to compute the answer for the given "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", using dynamics for the powers of two. Overall complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/7b963941d66adb78fa71ce0b7baa60feb1181ed76df8786e2f1fdb0f66caf0ee.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We decided to ask the answer modulo 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" + 7 to not let the participants easily guess that these problem requires FFT :) So, in order to get accepted you had to implement one of the methods to deal with the large modulo in polynomial multiplication using FFT. Another approach was to apply Karatsuba algorithm, our realisation timed out on our tests, but "},{"attrs":{"href":"https://codeforces.com/profile/EvenImage"},"children":[{"kind":"text","text":"EvenImage"}],"kind":"link"},{"kind":"text","text":" somehow made it pass :)"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/23278"}