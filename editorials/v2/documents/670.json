"text","text":" > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" than we can't bake more cookies. Else let's make "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":" and go to bake new cookie."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/670/problem/D2"},"children":[{"kind":"text","text":"670D2 - Magic Powder - 2"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here we will use binary search on the answer. Let's we check the current answer equals to "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":". Then the objective function must be realized in the following way. Let's store in the variable "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" how many grams of the magic powder we need to bake "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" cookies. Let's iterate through the ingredients and the current ingredient has the number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Then if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]·"},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] let's make "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]·"},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]. If after looking on some ingredient "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" becomes more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" the objective function must return "},{"children":[{"kind":"text","text":"false"}],"kind":"emphasis"},{"kind":"text","text":". If there is no such an ingredient the objective function must return "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the objective function returned "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":" we need to move the left end of the binary search to the "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":", else we need to move the right end of the binary search to the "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/670/problem/E"},"children":[{"kind":"text","text":"670E - Correct Bracket Sequence Editor"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's solve this problem in the following way. At first with help of stack let's calculate the array "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] equals to the position of the bracket which paired for the bracket in the position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Then we need to use two arrays "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":". Then "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] will equals to the position of the closest to the left bracket which did not delete and "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] will equals to the position of the closest to the right bracket which did not delete. If there are no such brackets we will store -1 in the appropriate position of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's the current position of the cursor equals to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":". Then if the current operation equals to \\texttt{L} let's make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"] and if the current operation equals to \\texttt{R} let's make "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"]. We need now only to think how process the operation \\texttt{D}."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"lf"}],"kind":"emphasis"},{"kind":"text","text":" equals to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":" equals to "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"]. If "},{"children":[{"kind":"text","text":"lf"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":" let's swap them. Now we know the ends of the substring which we need to delete now. If "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":"] =  =  - 1 we need to move "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" to the left ("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"lf"}],"kind":"emphasis"},{"kind":"text","text":"]), else we need to move "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" to the right ("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"rg"}],"kind":"emphasis"},{"kind":"text","text":"]). Now we need to recalculate the links for the ends of the deleted substring. Here we need to check is there any brackets which we did not deleted to the left and to the right from the ends of the deleted substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To print the answer we need to find the position of the first bracket which we did not delete and go through all brackets which we did not delete (with help of the array "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":") and print all such brackets. To find the position of the first bracket which we did not delete we can store in the array all pairs of the ends of substrings which we deleted, then sort this array and find the needed position. Bonus: how we can find this position in the linear time?"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/670/problem/F"},"children":[{"kind":"text","text":"670F - Restore a Number"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"At first let's find the length of the Vasya's number. For make this let's brute it. Let the current length equals to "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". Then if "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" equals to the difference between the length of the given string and the number of digits in "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" if means that "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" is a length of the Vasya's number. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we need to remove from the given string all digits which appeared in the number "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":", generate three strings from the remaining digits and choose smaller string from them — this string will be the answer. Let "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" is a substring which Vasya remembered. Which three strings do we need to generate?"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"Let's write the string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" and after that let's write all remaining digits from the given string in the ascending order. This string can be build only if the string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" does not begin with the digit 0."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Let's write at first the smallest digit from the remaining digits which does not equal to 0. If we have no such a digit we can't build such string. Else we need then to write all digits with smaller than the first digit in the "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" in the ascending order, then write the string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" and then write all remaining digits in the ascending order."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Let's write at first the smallest digit from the remaining digits which does not equal to 0. If we have no such a digit we can't build such string. Else we need then to write all digits with smaller than or equal to the first digit in the "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" in the ascending order, then write the string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" and then write all remaining digits in the ascending order."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Also we need to separately consider the case when the Vasya's number equals to zero."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/44715"}