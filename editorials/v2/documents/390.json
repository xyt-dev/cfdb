{"assets":["/editorial-assets/4ad92288c7a937caca5bb9038d6996320a768ff696ed06f1c4b73e95acb06160.png","/editorial-assets/d1a6765eefb5aa63a9b724b827d0d716feec56cb9c88aecfb781c0c8195038df.png","/editorial-assets/cfec830cf25dfa2e960a09bd8db7796089eea2c501510406adb88d3aa80b6a79.png","/editorial-assets/38c41b3a1430a69a8e3fd6e6227ee8c151573ba50b16eb9cd1813cf2e088c427.png","/editorial-assets/e1d0163f454d79c0a169c51c00f5404302d105216f14b2e775965eb52bd6e7aa.png","/editorial-assets/c43aa8f6edebfc218172d44299e5a5668f681d3e9b7d3e05fc4193b3c81f9fb3.png","/editorial-assets/043faefc0ab36f27aa37581d7086b89cbe599b49ea3cfc3576c48efb9cbfd0c4.png","/editorial-assets/1bf1ea7d37fc45bff078c135b7e46bdef57e386e553e84d54ba043993555d8cf.png","/editorial-assets/878e2ebd34dad548ef8676d498e825def0c7ac3433b74724690fd85f864df58b.png","/editorial-assets/f79d7c3436b9339947cd2f8fe9c7f5b52d40768a7886da49c6d2d4033a87fdee.png","/editorial-assets/a9c65e877ed3e38bdb4ee9aceb79806bb23662d221004938ff83e023185c4311.png","/editorial-assets/f44a1fbf0f1e62e3ecedf6c439254f6bd08cd48ed843d95f0be64632b7c72874.png","/editorial-assets/8148f9242379dbcc04cc4da5d9bf332947c1d44104ad9a1fff4d30cc4a2d1854.png","/editorial-assets/f62f644ab64e07c3ed226e2717ea3d3313c5fe1697d2aa7dae3d4eb5683fa63b.png","/editorial-assets/9d467a4242375baa52ce2921bee3cac07d13fff6f8a57105a7afe3fb3b964c7b.png","/editorial-assets/7bd6fb7a5791e0ce62bdb53824697314661e6642192718108d1b10e0aee3e55e.png","/editorial-assets/9e2d8d41cf64c5c8ad6053fef82d2d6ad073d3a8bfdeb2ab44e9827104c3b7d4.png"],"contestId":"390","diagnostics":[],"document":{"children":[{"children":[{"children":[{"kind":"text","text":"Since the original data has been lost during the dark days of Codeforces, no version of the editorial has been re-released, and I feel the round itself is quite educational, so I decided to give a try."}],"kind":"emphasis"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/390/problem/A"},"children":[{"kind":"text","text":"390A - Inna and Alarm Clock"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Approach"}]},"children":[{"children":[{"kind":"text","text":"The criterion shows that we can only use either vertical segments or horizontal segments."},{"kind":"line_break"},{"kind":"text","text":"Since there is no limit on the segments' length, we can see that it's always optimal to use a segment with infinite length (or may be known as a line)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can see that the vertical line "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" will span through every alarm clocks standing at positions with x-coordinate being equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". In a similar manner, the horizontal line "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" will span through every alarm clocks standing at positions with y-coordinate being equal to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, if we use vertical lines, the number of segments used will be the number of distinct values of x-coordinates found in the data. Similarly, the number of horizontal segments used will be the number of distinct values of y-coordinates found."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The process can be implemented by a counting array, or a map."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/4ad92288c7a937caca5bb9038d6996320a768ff696ed06f1c4b73e95acb06160.png"},"kind":"image"},{"kind":"text","text":" for regular arrays, or "},{"attrs":{"alt":"","src":"/editorial-assets/d1a6765eefb5aa63a9b724b827d0d716feec56cb9c88aecfb781c0c8195038df.png"},"kind":"image"},{"kind":"text","text":" for maps."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution 1 (Map)"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48214007"},"children":[{"kind":"text","text":"48214007"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n; cin >> n;\n\t\n\tmap<int, int> cntx, cnty;\n\t\n\twhile (n--) {\n\t\tint x, y;\n\t\tcin >> x >> y;\n\t\tcntx[x]++; cnty[y]++;\n\t}\n\t\n\tcout << min(cntx.size(), cnty.size()) << endl;\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution 2 (Array)"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48213984"},"children":[{"kind":"text","text":"48213984"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n; cin >> n;\n\t\n\tvector<int> cntx(101, 0);\n\tvector<int> cnty(101, 0);\n\t\n\twhile (n--) {\n\t\tint x, y;\n\t\tcin >> x >> y;\n\t\tcntx[x]++; cnty[y]++;\n\t}\n\t\n\tint distinctx = 0, distincty = 0;\n\tfor (int i=0; i<101; i++) {\n\t    distinctx += (cntx[i] > 0);\n\t    distincty += (cnty[i] > 0);\n\t}\n\t\n\tcout << min(distinctx, distincty) << endl;\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/390/problem/B"},"children":[{"kind":"text","text":"390B - Inna, Dima and Song"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Approach"}]},"children":[{"children":[{"kind":"text","text":"From the constraints given, for the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th song, provided there exists corresponding "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" values, then the following inequality must hold: 2 ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ 2·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"Thus, if any "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is either lower than 2 or higher than 2·"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", then no "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" can be found, thus, Sereja's joy will surely decrease by 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Amongst all pairs of "},{"attrs":{"alt":"","src":"/editorial-assets/cfec830cf25dfa2e960a09bd8db7796089eea2c501510406adb88d3aa80b6a79.png"},"kind":"image"},{"kind":"text","text":" that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", the pair with the highest value of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be one with the equal value of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (this can be proven by the famous AM-GM inequality)."},{"kind":"line_break"},{"kind":"text","text":"Thus, if "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is divisible by 2, we can easily pick "},{"attrs":{"alt":"","src":"/editorial-assets/38c41b3a1430a69a8e3fd6e6227ee8c151573ba50b16eb9cd1813cf2e088c427.png"},"kind":"image"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"Also, from this, we can see (either intuitively or with static proofs) that the lower the difference between "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is, the higher the value "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be. Thus, in case "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" being odd, the most optimal pair will be "},{"attrs":{"alt":"","src":"/editorial-assets/e1d0163f454d79c0a169c51c00f5404302d105216f14b2e775965eb52bd6e7aa.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/c43aa8f6edebfc218172d44299e5a5668f681d3e9b7d3e05fc4193b3c81f9fb3.png"},"kind":"image"},{"kind":"text","text":" (the order doesn't matter here)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/043faefc0ab36f27aa37581d7086b89cbe599b49ea3cfc3576c48efb9cbfd0c4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48212208"},"children":[{"kind":"text","text":"48212208"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n; cin >> n;\n\t\n\tvector<int> a(n), b(n);\n\tfor (auto &z: a) cin >> z;\n\tfor (auto &z: b) cin >> z;\n\t\n\tlong long Joy = 0;\n\tfor (int i=0; i<n; i++) {\n\t\tif (b[i] < 2 || b[i] > a[i] * 2) {Joy--; continue;}\n\t\tint x = b[i] / 2, y = b[i] - x;\n\t\tJoy += 1LL * x * y;\n\t}\n\tcout << Joy << endl;\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/390/problem/C"},"children":[{"kind":"text","text":"390C - Inna and Candy Boxes"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Approach"}]},"children":[{"children":[{"kind":"text","text":"The query content looks pretty confusing at first, to be honest."},{"kind":"line_break"},{"kind":"text","text":"Since "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is static throughout a scenario, we can group the boxes into "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" groups, the "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"-th box (in this editorial let's assume that the indices of the boxes start from 0) falls into group number "},{"attrs":{"alt":"","src":"/editorial-assets/1bf1ea7d37fc45bff078c135b7e46bdef57e386e553e84d54ba043993555d8cf.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, each query can be simplified as this: \"Is that true that among the boxes with numbers from "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", inclusive, the candies lie "},{"children":[{"kind":"text","text":"only"}],"kind":"strong"},{"kind":"text","text":" in boxes of group "},{"attrs":{"alt":"","src":"/editorial-assets/878e2ebd34dad548ef8676d498e825def0c7ac3433b74724690fd85f864df58b.png"},"kind":"image"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make sure the answer for a query being \"Yes\", Dima has to remove candies from all candied-box in all groups other than "},{"attrs":{"alt":"","src":"/editorial-assets/878e2ebd34dad548ef8676d498e825def0c7ac3433b74724690fd85f864df58b.png"},"kind":"image"},{"kind":"text","text":", while in that exact group, fill every empty box with a candy. Obviously, we'll consider boxes with indices between "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" inclusively only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can make "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" lists, the "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"-th (0-indexed) list stores the indices of candied boxes in group "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll process with each query as the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Obviously, given from the criteria, each range will consist of exactly "},{"attrs":{"alt":"","src":"/editorial-assets/f79d7c3436b9339947cd2f8fe9c7f5b52d40768a7886da49c6d2d4033a87fdee.png"},"kind":"image"},{"kind":"text","text":" boxes per each group. Let's denote "},{"attrs":{"alt":"","src":"/editorial-assets/a9c65e877ed3e38bdb4ee9aceb79806bb23662d221004938ff83e023185c4311.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Traverse all groups, for the "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"-th group (again, 0-indexed), let's denote "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the number of candied boxes of group "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" in the given range. This value can be calculated quickly through binary searching the constructed lists above."}],"kind":"list_item"},{"children":[{"kind":"text","text":"If group "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" is not the group being demanded to have candies (group "},{"attrs":{"alt":"","src":"/editorial-assets/878e2ebd34dad548ef8676d498e825def0c7ac3433b74724690fd85f864df58b.png"},"kind":"image"},{"kind":"text","text":"), we'll need to perform "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" actions (removing candies). Otherwise, we'll need to perform "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" actions (adding candies to empty boxes)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/f44a1fbf0f1e62e3ecedf6c439254f6bd08cd48ed843d95f0be64632b7c72874.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48213932"},"children":[{"kind":"text","text":"48213932"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n, k, w; string s;\n\tcin >> n >> k >> w >> s;\n\t\n\tvector< vector<int> > CandyGrp(k);\n\t\n\tfor (int i=0; i<n; i++) {\n\t    if (s[i] == '0') continue;\n\t    CandyGrp[i % k].push_back(i);\n\t}\n\t\n\twhile (w--) {\n\t    int l, r;\n\t\tcin >> l >> r; l--; r--;\n\t\t\n\t\tint res = 0;\n\t\tint demandedGroup = (l + k - 1) % k;\n\t\tint BoxesPerGroup = (r - l + 1) / k;\n\t\t\n\t\tfor (int id=0; id<k; id++) {\n\t\t    \n\t\t\tint x = lower_bound(CandyGrp[id].begin(), CandyGrp[id].end(), l) - CandyGrp[id].begin();\n\t\t\tint y = upper_bound(CandyGrp[id].begin(), CandyGrp[id].end(), r) - CandyGrp[id].begin();\n\t\t\t\n\t\t\tif (id == demandedGroup) {\n\t\t\t    res += (BoxesPerGroup - (y - x));\n\t\t\t}\n\t\t\telse res += (y - x);\n\t\t}\n\t\t\n\t\tcout << res << endl;\n\t}\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/390/problem/D"},"children":[{"kind":"text","text":"390D - Inna and Sweet Matrix"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Approach"}]},"children":[{"children":[{"kind":"text","text":"We can see that the most optimal placement will be choosing "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" cells being nearest to cell (1, 1) (yup, including (1, 1) itself)."},{"kind":"line_break"},{"kind":"text","text":"To find these "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" points, we can simply do a BFS starting from (1, 1), with traceback feature to construct the paths to get to those cells."},{"kind":"line_break"},{"kind":"text","text":"However, keep in mind that any cell being candied will later on become obstacles for the following paths. Thus, to avoid blocking yourself, you should transfer candies to the farthest cells first, then getting closer. Thus, cell (1, 1) will be the last one being filled with candy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/8148f9242379dbcc04cc4da5d9bf332947c1d44104ad9a1fff4d30cc4a2d1854.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/f62f644ab64e07c3ed226e2717ea3d3313c5fe1697d2aa7dae3d4eb5683fa63b.png"},"kind":"image"},{"kind":"text","text":", based on implementation (I myself did "},{"attrs":{"alt":"","src":"/editorial-assets/f62f644ab64e07c3ed226e2717ea3d3313c5fe1697d2aa7dae3d4eb5683fa63b.png"},"kind":"image"},{"kind":"text","text":", since the difference isn't too much)."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48213856"},"children":[{"kind":"text","text":"48213856"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nint dx[] = {-1, +0, +0, +1};\nint dy[] = {+0, -1, +1, +0};\npair<int, int> Default = {-1, -1};\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n, m, k; cin >> n >> m >> k;\n\t\n\tvector<vector<int>> Dist(n+2, vector<int>(m+2, 4444));\n\tvector<vector<pair<int, int>>> Last(n+2, vector<pair<int, int>>(m+2, Default));\n    \n\tstack<pair<int, int>> Cells;\n\tint cost = 0;\n\t\n\tqueue<pair<int, int>> Q;\n\tQ.push({1, 1}); Dist[1][1] = 1;\n\t\n\twhile (!Q.empty() && Cells.size() < k) {\n\t\tpair<int, int> C = Q.front(); Q.pop();\n\t\tCells.push(C); int x = C.first, y = C.second;\n\t\t\n\t\tcost += Dist[x][y];\n\t\t\n\t\tfor (int dir=0; dir<4; dir++) {\n\t\t\tif (x + dx[dir] < 1 || x + dx[dir] > n) continue;\n\t\t\tif (y + dy[dir] < 1 || y + dy[dir] > m) continue;\n\t\t\t\n\t\t\tif (Dist[x+dx[dir]][y+dy[dir]] != 4444) continue;\n\t\t\t\n\t\t\tDist[x+dx[dir]][y+dy[dir]] = Dist[x][y] + 1;\n\t\t\tQ.push({x + dx[dir], y + dy[dir]});\n\t\t\tLast[x+dx[dir]][y+dy[dir]] = C;\n\t\t}\n\t}\n\t\n\tcout << cost << endl;\n\t\n\twhile (!Cells.empty()) {\n\t\tint x = Cells.top().first, y = Cells.top().second; Cells.pop();\n\t\tstack<pair<int, int>> Traceback;\n\t\t\n\t\twhile (x != -1 && y != -1) {\n\t\t\tTraceback.push({x, y});\n\t\t\tpair<int, int> NextCell = Last[x][y];\n\t\t\tx = NextCell.first; y = NextCell.second;\n\t\t}\n\t\t\n\t\twhile (!Traceback.empty()) {\n\t\t\tpair<int, int> CurCell = Traceback.top();\n\t\t\tTraceback.pop();\n\t\t\tcout << \"(\" << CurCell.first << \", \" << CurCell.second << \") \";\n\t\t}\n\t\tcout << endl;\n\t}\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/390/problem/E"},"children":[{"kind":"text","text":"390E - Inna and Large Sweet Matrix"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Approach"}]},"children":[{"children":[{"kind":"text","text":"Let's denote "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" as the total number of candies on the board, "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the total number of candies on the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th row (1 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the total number of candies on the "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th column (1 ≤ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, let's denote "},{"attrs":{"alt":"","src":"/editorial-assets/9d467a4242375baa52ce2921bee3cac07d13fff6f8a57105a7afe3fb3b964c7b.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/7bd6fb7a5791e0ce62bdb53824697314661e6642192718108d1b10e0aee3e55e.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's considered the 2nd type of query first. Denoting the answer for the query as "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"), we can see that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" (you can draw a simple diagram and validate this function)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, the problem is now reduced to calculating "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" can be easily calculated. After each query of the 1st type with parameters "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"; "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" will be increased by "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"·("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1)·("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 1)."}],"kind":"list_item"},{"children":[{"kind":"text","text":"The calculation of "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") makes us thinking about some kinds of data structures that support range sum update and range sum query. Segment trees and Fenwick trees can both work on that. Personally I used segment trees, they fit in just right for the memory limit (I implemented it by vectors, regular arrays will obviously be safer)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/9e2d8d41cf64c5c8ad6053fef82d2d6ad073d3a8bfdeb2ab44e9827104c3b7d4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Submission link: "},{"attrs":{"href":"https://codeforces.com/contest/390/submission/48213830"},"children":[{"kind":"text","text":"48213830"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Source code in plain text"}]},"children":[{"kind":"code_block","text":"#pragma GCC optimize(\"Ofast\")\n\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define endl '\\n'\nmt19937 rng32(chrono::steady_clock::now().time_since_epoch().count());\nmt19937_64 rng64(chrono::steady_clock::now().time_since_epoch().count());\n\nstruct SegTree_Sum {\n\tint n; vector<long long> Tree, Lazy;\n\tSegTree_Sum() {}\n\tSegTree_Sum(int _n) {\n\t\tn = _n;\n\t\tTree.resize(n*4);\n\t\tLazy.resize(n*4);\n\t}\n\t\n\tvoid Propagate(int node, int st, int en) {\n\t\tif (Lazy[node] == 0) return;\n\t\tTree[node] += Lazy[node] * (en - st + 1);\n\t\tif (st != en) {\n\t\t\tLazy[node*2+1] += Lazy[node];\n\t\t\tLazy[node*2+2] += Lazy[node];\n\t\t}\n\t\tLazy[node] = 0;\n\t}\n\t\n\tvoid Update(int node, int st, int en, int L, int R, long long val) {\n\t\tPropagate(node, st, en);\n\t\tif (en < st || R < st || en < L) return;\n\t\tif (L <= st && en <= R) {\n\t\t\tLazy[node] += val;\n\t\t\tPropagate(node, st, en); return;\n\t\t}\n\t\tUpdate(node*2+1, st, (st+en)/2+0, L, R, val);\n\t\tUpdate(node*2+2, (st+en)/2+1, en, L, R, val);\n\t\tTree[node] = Tree[node*2+1] + Tree[node*2+2];\n\t}\n\t\n\tlong long Sum(int node, int st, int en, int L, int R) {\n\t\tPropagate(node, st, en);\n\t\tif (en < st || R < st || en < L) return 0LL;\n\t\tif (L <= st && en <= R) return Tree[node];\n\t\tlong long p1 = Sum(node*2+1, st, (st+en)/2+0, L, R);\n\t\tlong long p2 = Sum(node*2+2, (st+en)/2+1, en, L, R);\n\t\treturn (p1 + p2);\n\t}\n\t\n\tvoid RangeUpdate(int L, int R, long long val) {\n\t\tUpdate(0, 0, n-1, L, R, val);\n\t}\n\t\n\tlong long RangeSum(int L, int R) {\n\t\treturn Sum(0, 0, n-1, L, R);\n\t}\n};\n\nint main(int argc, char* argv[]) {\n\tios_base::sync_with_stdio(0); cin.tie(NULL);\n\t\n\tint n, m, w; cin >> n >> m >> w;\n\t\n\tlong long TotalCandies = 0;\n\t\n\tSegTree_Sum TreeRow = SegTree_Sum(n);\n\tSegTree_Sum TreeCol = SegTree_Sum(m);\n\t\n\twhile (w--) {\n\t\tint t, x1, y1, x2, y2;\n\t\tcin >> t >> x1 >> y1 >> x2 >> y2;\n\t\t\n\t\tif (t == 0) {\n\t\t\tint v; cin >> v;\n\t\t\t\n\t\t\tTotalCandies += 1LL * (x2 - x1 + 1) * (y2 - y1 + 1) * v;\n\t\t\t\n\t\t\tTreeRow.RangeUpdate(x1, x2, 1LL * v * (y2 - y1 + 1));\n\t\t\tTreeCol.RangeUpdate(y1, y2, 1LL * v * (x2 - x1 + 1));\n\t\t}\n\t\telse if (t == 1) {\n\t\t\tlong long res = 0;\n\t\t\t\n\t\t\tres += TreeRow.RangeSum(x1, x2);\n\t\t\tres += TreeCol.RangeSum(y1, y2);\n\t\t\tres -= TotalCandies;\n\t\t\t\n\t\t\tcout << res << endl;\n\t\t}\n\t}\n\t\n\treturn 0;\n}\n"}],"kind":"spoiler"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/64453"}