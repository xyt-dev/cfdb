{"assets":[],"contestId":"1812","diagnostics":[{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <style> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"}],"document":{"children":[{"children":[{"kind":"text","text":"Thank you for participating in our contest! We hope you enjoyed it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please let us know what you thought of the problems by voting!"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/A"},"children":[{"kind":"text","text":"1812A - Are You a Robot?"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/flamestorm"},"children":[{"kind":"text","text":"flamestorm"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"Have you seen the \"are you a robot\" boxes on websites? "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/A"},"children":[{"kind":"text","text":"1812A - Are You a Robot?"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"You just need to output the word security that is distorted in the image."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Video Editorial"}]},"children":[{"children":[{"attrs":{"href":"https://www.youtube.com/watch?v=dQw4w9WgXcQ"},"children":[{"kind":"text","text":"Video Editorial"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"    Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/B"},"children":[{"kind":"text","text":"1812B - Was it Rated?"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/BucketPotato"},"children":[{"kind":"text","text":"BucketPotato"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/BucketPotato"},"children":[{"kind":"text","text":"BucketPotato"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"children":[{"kind":"text","text":"Was"}],"kind":"strong"},{"kind":"text","text":" it rated?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/B"},"children":[{"kind":"text","text":"1812B - Was it Rated?"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The input to the problem represents a Codeforces contest ID. Out of the first $$$25$$$ Codeforces contests, the only unrated ones had IDs $$$15$$$, $$$20$$$, and $$$21$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we output NO if $$$n \\in \\{15, 20, 21\\}$$$, and YES otherwise."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/C"},"children":[{"kind":"text","text":"1812C - Digits"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"$$$8$$$, $$$7$$$, and $$$30$$$ all seem to be products of some numbers in the input."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"The answer is to print the product of all numbers in a test case, but we don't know $$$n$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/C"},"children":[{"kind":"text","text":"1812C - Digits"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The answer is the product of $$$a_i$$$ in a test case. In other words, it is"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\prod_{i=1}^n a_i.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But what is $$$n$$$? In the samples, the value of $$$n$$$ in each test case is either $$$[3, 2, 3]$$$ or $$$[3, 1, 4]$$$. The latter looks familiar – it is the digits of $$$\\pi$$$! There are subtle hints about this in the problem, for example the problem name or the fact that Pi is the symbol for product. We may verify that $$$\\pi$$$ is the answer by checking that its $$$32$$$ digits sum to $$$155$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The full solution is: In the $$$k$$$-th test case, read $$$n$$$ numbers (where $$$n$$$ is the $$$k$$$-th digit of $$$\\pi$$$), then print the product of those $$$n$$$ numbers."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/D"},"children":[{"kind":"text","text":"1812D - Trivial Conjecture"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/AlperenT"},"children":[{"kind":"text","text":"AlperenT"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/AlperenT"},"children":[{"kind":"text","text":"AlperenT"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"What is a conjecture? Is this problem really a conjecture?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"The problem name is \"Trivial Conjecture\". Is it really trivial?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"What are the most used words in the statement?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/D"},"children":[{"kind":"text","text":"1812D - Trivial Conjecture"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"attrs":{"href":"https://xkcd.com/710/"},"children":[{"kind":"text","text":"A comic about the problem"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given function in the statement defines "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Collatz_conjecture"},"children":[{"kind":"text","text":"Collatz Conjecture"}],"kind":"link"},{"kind":"text","text":". It is one of the most famous unsolved problems in mathematics. This is why the problem is actually harder to solve if you have a math background. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Basically, the problem asks you to find a number such that it doesn't take less than $$$k$$$ steps to reach $$$1$$$ using the defined function. There are many numbers that take a high amount of steps, but they don't seem to get accepted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Many people tried to find the value of $$$[REDACTED]$$$ and find a number that takes longer than it. However, doing so is very hard and wastes a lot of time. For people who tried to do so and interested in its value, it is $$$142023$$$ (01/04/2023)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The important thing here is to read the statement very carefully. Collatz Conjecture is defined on positive integers. However, the statement only says \"Output a single integer $$$n$$$\", which means it's possible to print a negative integer or $$$0$$$. Doing so solves the problem successfully because any integer $$$n \\leq 0$$$ never becomes $$$1$$$. We don't know if this is the only solution. It's possible that there is a positive integer that takes longer than $$$142023$$$ steps. If you find a number that takes very long or actually takes longer than $$$142023$$$ steps, please write in the comments."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/E"},"children":[{"kind":"text","text":"1812E - Not a Geometry Problem"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"Read the output constraint carefully!"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/E"},"children":[{"kind":"text","text":"1812E - Not a Geometry Problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The error should be at most $$$10^{+6}$$$, instead of the usual $$$10^{-6}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This means that you can just output $$$0$$$, since then $$$\\frac{|a-b|}{\\max(1,|b|)} = \\frac{|-b|}{\\max(1,|b|)} = \\frac{|b|}{\\max(1,|b|)} \\le 10^6$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/F"},"children":[{"kind":"text","text":"1812F - Factorization"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/flamestorm"},"children":[{"kind":"text","text":"flamestorm"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/flamestorm"},"children":[{"kind":"text","text":"flamestorm"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"Factor the first number. What do you notice?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/F"},"children":[{"kind":"text","text":"1812F - Factorization"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"If we factor the first number (using Wolfram|Alpha or some program you code), you can see that it is the product of two primes: $$$991999999999 \\times 4201403994187$$$. This first prime is an example of a glitch prime: a prime whose digits are all the same, except one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The conclusion is that the larger number should also be the product of two primes, one of which is a glitch prime. So you can test all glitch primes using a local program, which shouldn't take more than a few minutes (or you can even submit it directly to Codeforces and it should work)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We won't spoil the factorization here, you should try to figure it out ;)"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/G"},"children":[{"kind":"text","text":"1812G - Colour Vision"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/flamestorm"},"children":[{"kind":"text","text":"flamestorm"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/flamestorm"},"children":[{"kind":"text","text":"flamestorm"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Besides the sample, which doesn't provide much information, we have to continue based off of the image. How can we extract information from an image, given that we only have three rectangles in a shade of green?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Hex?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812G"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/G"},"children":[{"kind":"text","text":"1812G - Colour Vision"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The rectangles are in the shape of the Codeforces logo. The only other information that the picture gives us is the fact that they are green, so if we want to get information from this shade of green, we can use hex codes! Extracting the hex code gives us #01722B."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What about Codeforces is related to 01722B? It looks suspiciously similar to a problem code, and indeed, if you go to https://codeforces.com/contest/1722/problem/B, you get the problem Colourblindness, which is clearly related to the title of this problem!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Looking at the sample, then, solution is simple: just solve the problem Colourblindness, and send the code to this problem."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/H"},"children":[{"kind":"text","text":"1812H - Expected Twist"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Some details are suspiciously specific."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"624 is a weird number. Google (or DuckDuckGo, Bing, etc.) the suspicious keywords like \"624 random\", \"random number 624\", \"random twist\" or something similar."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812H"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/H"},"children":[{"kind":"text","text":"1812H - Expected Twist"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Doing the web searches in the hint above shows results about the Mersenne Twister (or more specifically, MT19937), which is a random number generator. With additional hint from the problem name, it is reasonable to assume that the array $$$a$$$ is generated by an MT19937 like this:"}],"kind":"paragraph"},{"kind":"code_block","text":"mt19937 rng(seed);vector<uint32_t> a(n);for (auto &i : a) {    i = rng();}"},{"children":[{"kind":"text","text":"Searching more on the web shows the following fact: given the first 624 output values of an MT19937, its entire internal state can be recovered, and therefore we can know all its future outputs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In fact, many top results from DuckDuckGo and Google, when given the keyword \"624 random\", show how to break the MT19937 generator, and many implementations are available online. We can use this to solve the problem. The full solution is:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" For $$$i=1,2,\\dots,624$$$, query $$$\\texttt{?}\\ i\\ i$$$ to get the value of $$$a_i$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Recover the state of the MT19937 used to generate $$$a$$$ using the first 624 values. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Generate the remaining values of $$$a$$$ with the recovered generator. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Output the minimum value of $$$a$$$ which we now know. "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/I"},"children":[{"kind":"text","text":"1812I - Mountain Climber"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/Ari"},"children":[{"kind":"text","text":"Ari"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/Ari"},"children":[{"kind":"text","text":"Ari"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"How do mountains and the \"YES\"-words relate to each other?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812I"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/I"},"children":[{"kind":"text","text":"1812I - Mountain Climber"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This problem provides very little information, giving us only the samples, and minor confirmation in the form of the title."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By looking carefully at the accepted samples, particularly the shorter ones such as big and clump, we may notice that they have a similar \"shape\". As it turns out, this problem is related to the concept of "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Ascender_(typography)"},"children":[{"kind":"text","text":"ascenders"}],"kind":"link"},{"kind":"text","text":" and "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Descender"},"children":[{"kind":"text","text":"descenders"}],"kind":"link"},{"kind":"text","text":" in typography. The title of the problem provides a nice bit of confirmation for this idea. Ultimately, a string is accepted if and only if its sequence of ascenders of descenders is a regular bracket sequence, and we can implement this easily."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a little ambiguity regarding whether the dots on i and j count as ascenders, but the given samples are enough to disambiguate and conclude that j is considered to have a descender, whereas i is considered to have neither an ascender nor a descender."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/J"},"children":[{"kind":"text","text":"1812J - Unmysterious Language"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ScarletS"},"children":[{"kind":"text","text":"ScarletS"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"text","text":", et al."},{"kind":"line_break"},{"kind":"text","text":"Preparation: "},{"attrs":{"href":"https://codeforces.com/profile/ToxicPie9"},"children":[{"kind":"text","text":"ToxicPie9"}],"kind":"link"},{"kind":"text","text":", ChatGPT"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"Think of unmysterious languages."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Even Bigger Hint"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/blog/entry/114538?#comment-1018014"},"children":[{"kind":"text","text":"We literally told you."}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1812J"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1812/problem/J"},"children":[{"kind":"text","text":"1812J - Unmysterious Language"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The unmysterious language is English. You just need to ask the checker nicely, i.e. have \"please\". However, our AI gets tired from reading long messages, so if your output is too long, it won't accept it either!"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Feedback"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Amazing problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/114616"}