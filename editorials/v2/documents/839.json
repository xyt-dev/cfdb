":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the children of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex , then "},{"attrs":{"alt":"","src":"/editorial-assets/b43c9537b9ade4c13b17c5e5b1957574525c2316ebbb6e6291a87aa16a6df34d.png"},"kind":"image"},{"kind":"text","text":" . Because when we are at "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex , we have "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" choices with equal probabilities and  + 1 for going to one of them (length of the edge between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex and it’s children)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So if we know the answer of some vertex’s children, we can calculate its expected value and we can do it by a simple DFS (note that the answer for a leave is 0)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"},{"kind":"text","text":"'s solution: "},{"attrs":{"href":"https://codeforces.com/contest/839/submission/29412220"},"children":[{"kind":"text","text":"29412220"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"839D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/839/problem/D"},"children":[{"kind":"text","text":"839D - Winter is here"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"1st method:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"em