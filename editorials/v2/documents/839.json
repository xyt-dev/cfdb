t":"] be count of people in clans with "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". To find "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] let's understand, how to find count of people in clans, in which every number is divided by "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", it's"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/bfd845f0c2df0a4fb01e90ff59cde17ad4e190e0f8980065cd04ce2b1e6e0bc4.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's calculate "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] from the end. Then "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]·2"},{"children":[{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - 1"}],"kind":"superscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"[2"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"[3"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - ...."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answer for problem's question is "},{"attrs":{"alt":"","src":"/editorial-assets/d040274ad1af3732bb44393371ca6c2c652d27cdf7fc14a86170f7811811407c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotics of solution is "},{"attrs":{"alt":"","src":"/editorial-assets/27cb833f46e22fcd9020b4d8f592c98baa4076ccb3fe9e07f197de2759993fc1.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is maximal value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"href":"https://codeforces.com/profile/NikaraBika"},"children":[{"kind":"text","text":"NikaraBika"}],"kind":"link"},{"kind":"text","text":"'s solution: "},{"attrs":{"href":"https://codeforces.com/contest/839/submission/29458745"},"children":[{"kind":"text","text":"29458745"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"problemCode":"839E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/839/problem/E"},"children":[{"kind":"text","text":"839E - Mother of Dragons"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Lemma : Let "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" be a simple graph. To every vertex of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" we assign a nonnegative real number such that the sum of the numbers assigned to all vertices is 1. For any two connected vertices (by an edge), compute the product of the numbers associated to these vertices. The maximal value of the sum of these products is when assign equal numbers to a maximal clique (a subgraph that all of its vertices are connected to each other) and 0 to the rest of the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof : If the graph is complete of order "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" then the problem reduces to finding the maximum of "},{"attrs":{"alt":"","src":"/editorial-assets/350b2ac4b7c98f787934372f344e0d5fa565e51666ce907152f6fba34bd53e0c.png"},"kind":"image"},{"kind":"text","text":" knowing that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + … + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1. This is easy, since "},{"attrs":{"alt":"","src":"/editorial-assets/088e92444653becdc47d0ce4c87caed17951e40e00f947cfedc98c3ba197d98b.png"},"kind":"image"},{"kind":"text","text":". The last inequality is just the Cauchy-Schwarz inequality and we have equality when all variables are "},{"attrs":{"alt":"","src":"/editorial-assets/2361f526888cf2e68b17ac82284945db05c8da11a7a4ca22fad634367c22aa80.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, the problem is much more difficult in other cases, but at least we have an idea of a possible answer: indeed, it is easy now to find a lower bound for the maximum: if "},{"children":[{"kind":"text","text":"H"}],"kind":"emphasis"},{"kind":"text","text":" is the complete subgraph with maximal number of vertices "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", then by assigning these vertices "},{"attrs":{"alt":"","src":"/editorial-assets/f024835f6b1376ed924c38302c15afd89a03107dd4bb53ae11cc1052575c1f9d.png"},"kind":"image"},{"kind":"text","text":" and to all other vertices 0, we find that the desired maximum is at least "},{"attrs":{"alt":"","src":"/editorial-assets/b889a6a728271e7a433e0ab28b1cc5da3afe11021fda230d583df631f7a14851.png"},"kind":"image"},{"kind":"text","text":". We still have to solve the difficult part: showing that the desired maximum is at most "},{"attrs":{"alt":"","src":"/editorial-assets/b889a6a728271e7a433e0ab28b1cc5da3afe11021fda230d583df631f7a14851.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us proceed by induction on the number n of vertices of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 1 everything is clear, so assume the result true for all graphs with at most "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"−1 vertices and take a graph "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices, numbered 1, 2, ... , "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" be the set of vectors with nonnegative coordinates and whose components add up to 1 and "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" the set of edges of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":". Because the function "},{"attrs":{"alt":"","src":"/editorial-assets/40d5bb73b85f2951e4ebe950e3c8bd439af83557d01dd9edbe23431bff6d85da.png"},"kind":"image"},{"kind":"text","text":" is continuous on the compact set "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" , it attains its maximum in a point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). If at least one of the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is zero, then "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":") where "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" is the graph obtained by erasing vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and all edges that are incident to this vertex. It suffices to apply the induction hypothesis to "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" (clearly, the maximal complete subgraph of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" has at most as many vertices as the maximal complete subgraph of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"). So, suppose that all "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are positive. We may assume that "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" is not complete, since this case has already been discussed. So, let us assume for example that vertices 1 and 2 are not connected. Choose any number 0 < "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and assign to vertices 1, 2, ... , "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":" the numbers "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"−"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". By maximality of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"G"}],"kind":"emphasis"},{"kind":"text","text":"), we must have "},{"attrs":{"alt":"","src":"/editorial-assets/adef1e509f6d0d98b7a5db741c664ba9cbdb5426fd2810d5a2c48a01a99d46d6.png"},"kind":"image"},{"kind":"text","text":" , where "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" is the set of vertices that are adjacent to vertex 2 and not adjacent to vertex 1 (the definition of C2 being clear). By symmetry, we deduce that we must actually have "},{"attrs":{"alt":"","src":"/editorial-assets/a269cddb46f69728a420c193b8308247313b668bc72cc5314f48b76f115058d9.png"},"kind":"image"},{"kind":"text","text":" , which shows that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"(0, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Hence we can apply the previous case and the Lemma is solved."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now by the Lemma , we have to find the maximal clique and get the answer.(Let the maximal clique have "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" vertices, then the answer is "},{"attrs":{"alt":"","src":"/editorial-assets/ef52337deef68e24a71240740e884164ab65add78dd4f948df63dcd8cb051b4f.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can find the maximal clique by the \"meet in the middle\" approach. Divide the vertices of the graph into 2 sets with equal number of vertices in each set(if "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is odd, one set will have a vertex more than the other). We can save the maximal clique for each subset of the first set in "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"]. Now ,for each clique "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" in the second set, let "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be vertices in the first set that are connected to all of the vertices of "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":". Then "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", ... , "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")] + "},{"children":[{"kind":"text","text":"sizeof"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":")) ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is size of maximum clique). Note : finding the maximal clique is also possible by a wise brute forces."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"},{"kind":"text","text":"'s solution: "},{"attrs":{"href":"https://codeforces.com/contest/839/submission/29412249"},"children":[{"kind":"text","text":"29412249"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"P.S."}],"kind":"strong"},{"kind":"text","text":" Please notify me if there is any problem."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/53815"}