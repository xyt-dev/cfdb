{"assets":["/editorial-assets/d6b9a88b0f575fbb752ead5eda6b55e7221ac649171415df537fbd10c4e8813f.png","/editorial-assets/b7e7b981f8d44464801efc7ae94d8bb0062988f6340e6759e03ae9d6d2bae7f7.png"],"contestId":"1968","diagnostics":[{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <style> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"}],"document":{"children":[{"children":[{"kind":"text","text":"We thank everyone who participated in the round."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/A"},"children":[{"kind":"text","text":"1968A - Максимизировать?"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Try to find the upper bound of $$$\\gcd(x,y)+y$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"$$$\\gcd(x,y)+y=\\gcd(x-y,y)+y$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"$$$\\gcd(x,y)+y\\le x$$$. Try to find such $$$y$$$, that $$$\\gcd(x,y)+y=x$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/A"},"children":[{"kind":"text","text":"1968A - Maximize?"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The core idea is to find the upper bound of $$$\\gcd(x,y)+y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us look closer at the formula $$$\\gcd(x,y)+y$$$. It is a well-known fact that $$$\\gcd(a,b)=\\gcd(a-b,b)$$$ for $$$a\\geq b$$$. Applying it to our formula, we get $$$\\gcd(x-y,y)+y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using the fact that $$$\\gcd(x-y,y)\\le x-y$$$, we get $$$\\gcd(x-y,y)+y\\le x-y+y=x$$$. Hence, $$$\\gcd(x,y)+y\\le x$$$ for $$$1\\le y \\lt x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$y=x-1$$$, we have $$$\\gcd(x,x-1)+x-1=1+x-1=x$$$, which is the maximal possible value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the constraints allow finding the optimal $$$y$$$ in $$$O(x)$$$, while the above solution works in $$$O(1)$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<iostream>\nusing namespace std;\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint x;\n\t\tcin>>x;\n\t\tcout<<x-1<<\"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve   "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"    "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/B"},"children":[{"kind":"text","text":"1968B - Префиксная подпоследовательность"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/FBI"},"children":[{"kind":"text","text":"FBI"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Try to check for every $$$k$$$ if the prefix of $$$a$$$ of length $$$k$$$ is a subsequence of $$$b$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/B"},"children":[{"kind":"text","text":"1968B - Prefiquence"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"We will be solving this task using dynamic programming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us define $$$dp_i$$$ as the maximal prefix of $$$a$$$ that is contained in $$$b_1,\\dots,b_i$$$ as a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the transitions are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$b_i$$$ is equal to $$$a_{dp_{i-1}+1}$$$ then $$$dp_i = dp_{i-1} + 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise $$$dp_i=dp_{i-1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The answer is $$$dp_{m}$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<iostream>\n#include<vector>\nusing namespace std;\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n,m;\n\t\tcin>>n>>m;\n\t\tvector<char>a(n+1),b(m+1);\n\t\tfor(int i=1;i<=n;i++){\n\t\t\tcin>>a[i];\n\t\t}\n\t\tfor(int i=1;i<=m;i++){\n\t\t\tcin>>b[i];\n\t\t}\n\t\tvector<int>dp(m+1);\n\t\tdp[1]=(a[1]==b[1]?1:0);\n\t\tfor(int i=2;i<=m;i++){\n\t\t\tif(dp[i-1]!=n && b[i]==a[dp[i-1]+1]){\n\t\t\t\tdp[i]=dp[i-1]+1;\n\t\t\t}else{\n\t\t\t\tdp[i]=dp[i-1];\n\t\t\t}\n\t\t}\n\t\tcout<<dp[m]<<\"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/C"},"children":[{"kind":"text","text":"1968C - Восстановление по остаткам"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Why constraints are small?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Try to think about increacing $$$a_1,\\dots,a_n$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"$$$((a + b)\\bmod a) = b$$$ for $$$0\\le b \\lt a$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/C"},"children":[{"kind":"text","text":"1968C - Assembly via Remainders"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Notice that $$$((a+b) \\bmod a)=b$$$ for $$$0\\le b \\lt a$$$. So we may try to generate a sequence with $$$b=x_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us take $$$a_1=1000$$$, because $$$1000$$$ is larger than any of $$$x_i$$$. Then, we can take $$$a_i$$$ as $$$a_{i-1}+x_i$$$, since $$$((a_{i-1}+x_i)\\bmod a_{i-1})=x_i$$$ will be hold."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maximal value of $$$a$$$ will be at most $$$1000+500n$$$ what is smaller than $$$10^9$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<iostream>\nusing namespace std;\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n;\n\t\tcin>>n;\n\t\tint S=1000;\n\t\tcout<<S<<\" \";\n\t\tfor(int i=2;i<=n;i++){\n\t\t\tint x;\n\t\t\tcin>>x;\n\t\t\tS+=x;\n\t\t\tcout<<S<<\" \";\n\t\t}\n\t\tcout<<\"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/D"},"children":[{"kind":"text","text":"1968D - Игра в перестановке"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/FBI"},"children":[{"kind":"text","text":"FBI"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Consider a cycle of the permutation."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"When it is optimal to stay on the same place till the end of the game?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/D"},"children":[{"kind":"text","text":"1968D - Permutation Game"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Because $$$p$$$ is a permutation, it will be divided into cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every player it is optimal to move during the first $$$min(n,k)$$$ turns. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will answer the question by calculating maximal possible score for both players."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us define $$$sum_i$$$ and $$$pos_i$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" sum of values in the positions that occur during the first $$$i$$$ turns. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" position in which player will stop if he decides to move $$$i$$$ times. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" We will calculate them as follows: "},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$sum_i = sum_{i-1} + a_{pos_{i}}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$pos_i$$$=$$$p_{pos_{i-1}}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now the maximal possible answer for one player is equal to:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ans=\\max\\limits_{0\\le i\\le \\min(n,k)}(sum_i+(k-i)a_{pos_i})$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we will compare maximal possible answers for every player."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<bits/stdc++.h>\nusing namespace std;\nlong long score(vector<int>&p,vector<int>&a,int s,int k){\n\tint n=p.size();\n\tlong long mx=0,cur=0;\n\tvector<bool>vis(n);\n\twhile(!vis[s]&&k>0){\n\t\tvis[s]=1;\n\t\tmx=max(mx,cur+1ll*k*a[s]);\n\t\tcur+=a[s];\n\t\tk--;\n\t\ts=p[s];\n\t}\n\treturn mx;\n}\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n,k,s1,s2;\n\t\tcin>>n>>k>>s1>>s2;\n\t\tvector<int>p(n),a(n);\n\t\tfor(auto&e:p){\n\t\t\tcin>>e;\n\t\t\te--;\n\t\t}\n\t\tfor(auto&e:a){\n\t\t\tcin>>e;\n\t\t}\n\t\tlong long A=score(p,a,s1-1,k),B=score(p,a,s2-1,k);\n\t\tcout<<(A>B?\"Bodya\\n\":A<B?\"Sasha\\n\":\"Draw\\n\");\n\t}\n}\n\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/E"},"children":[{"kind":"text","text":"1968E - Расположение ячеек"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"What is the maximal possible size of $$$\\mathcal{H}$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Can you always get that size for $$$n\\geq 4$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Consider odd and even distances independently."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Let us find an interesting pattern for $$$n\\geq 4$$$."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Pattern for n=4"}]},"children":[{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/d6b9a88b0f575fbb752ead5eda6b55e7221ac649171415df537fbd10c4e8813f.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Pattern for n=5"}]},"children":[{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/b7e7b981f8d44464801efc7ae94d8bb0062988f6340e6759e03ae9d6d2bae7f7.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"Can you generalize the pattern? We put $$$n-2$$$ cells on the main diagonal. Then put two cells at $$$(n-1,n)$$$ and $$$(n,n)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But why does it work? Interesting fact, that in such way we generate all possible Manhattan distances. Odd distances are generated between cells from the main diagonal and $$$(n-1,n)$$$. Even distances are generated between cells from the main diagonal and $$$(n,n)$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<iostream>\nusing namespace std;\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n;\n\t\tcin>>n;\n\t\tfor(int i=1;i<=n-2;i++){\n\t\t\tcout<<i<<' '<<i<<\"\\n\";\n\t\t}\n\t\tcout<<n-1<<' '<<n<<\"\\n\"<<n<<' '<<n<<\"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/F"},"children":[{"kind":"text","text":"1968F - Отрезки с равным XOR"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Is it useful to divide the segment into more than three segments?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Use the fact, that $$$x\\oplus x=0$$$ and $$$x\\oplus x\\oplus x=x$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"When you can divide the segment into $$$2$$$ parts?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"When can you divide the segment into $$$3$$$ parts?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/F"},"children":[{"kind":"text","text":"1968F - Equal XOR Segments"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Observation: any division on more than $$$k \\gt 3$$$ segments can be reduced to at most $$$3$$$ segments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof: suppose the XORs of elements from the segments are $$$x_1,\\dots,x_k$$$. The condition $$$x_1=x_2=\\dots=x_k$$$ must be fulfilled. If $$$k \\gt 3$$$ we may take any three consecutive segments and merge them into one, because $$$x\\oplus x\\oplus x=x$$$. In such way, we reduce $$$k$$$ by two. We may repeat this process while $$$k \\gt 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us construct an array $$$b_1=a_1$$$ and $$$b_i=b_{i-1}\\oplus a_i$$$ for $$$i\\geq 2$$$. Now, $$$a_l\\oplus a_{l+1}\\oplus \\dots \\oplus a_r=b_r\\oplus b_{l-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two cases: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$k=2$$$, meaning that we divide the segment $$$[l,r]$$$ into two segments. Suppose the segments are $$$[l,m]$$$ and $$$[m+1,r]$$$. In such case we must check if $$$b_m\\oplus b_{l-1}=b_{r}\\oplus b_m$$$. This equality reduces to $$$b_{l-1}=b_r$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$k=3$$$, meaning that we divide segment $$$[l,r]$$$ into $$$[l,s]$$$, $$$[s+1,t]$$$ and $$$[t+1,r]$$$. We must check if $$$b_s\\oplus b_{l-1}=b_{t}\\oplus b_s$$$ and $$$b_s \\oplus b_{t}=b_r \\oplus b_{t}$$$. It is equivalent to check if $$$b_{l-1}=b_t$$$ and $$$b_s=b_r$$$. Also, $$$s \\lt t$$$ must be fulfilled. Hence, we may find the largest $$$t \\lt r$$$ that $$$b_t=b_{l-1}$$$ and the minimal $$$s\\geq l$$$ that $$$b_s=b_r$$$. It can be done using binary search on the positions of a certain value. "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<bits/stdc++.h>\nusing namespace std;\nconst int N=200005;\nint a[N];\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n,q;\n\t\tcin>>n>>q;\n\t\tmap<int,vector<int>>id;\n\t\tid[0].push_back(0);\n\t\tfor(int i=1;i<=n;i++){\n\t\t\tcin>>a[i];\n\t\t\ta[i]^=a[i-1];\n\t\t\tid[a[i]].push_back(i);\n\t\t}\n\t\twhile(q--){\n\t\t\tint l,r;\n\t\t\tcin>>l>>r;\n\t\t\tif(a[r]==a[l-1]){\n\t\t\t\tcout<<\"YES\\n\";\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tint pL=*--lower_bound(id[a[l-1]].begin(),id[a[l-1]].end(),r);\n\t\t\tint pR=*lower_bound(id[a[r]].begin(),id[a[r]].end(),l);\n\t\t\tcout<<(pL>pR?\"YES\\n\":\"NO\\n\");\n\t\t}\n\t\tif(t)cout << \"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/G1"},"children":[{"kind":"text","text":"1968G1 - Деление + LCP (простая версия)"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Binary search."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"How to check if two strings are equal?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968G1"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/G1"},"children":[{"kind":"text","text":"1968G1 - Division + LCP (easy version)"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Consider $$$F_{\\ell}$$$ is a function which returns true iff it is possible to divide the string into at least $$$k$$$ segments with their LCP equal to $$$\\ell$$$. Notice that $$$F_{\\ell}$$$ implies $$$F_{\\ell - 1}$$$ for $$$\\ell \\gt 0$$$. So we may find the maximal $$$\\ell$$$ using binary search, which will be the answer for the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How to compute $$$F_{\\ell}$$$? Let us find Z-function $$$z_1,\\dots,z_n$$$ of the given string. Notice that in the division $$$w_1,\\dots,w_k$$$ we have $$$w_1$$$ as the prefix of the given string and all the strings have the common prefix with $$$w_1$$$ of length $$$\\ell$$$. Notice that $$$z_p$$$ gives us the longest common prefix with $$$w_1$$$ and a segment starting at $$$p$$$. So if $$$z_p\\geq \\ell$$$ we may take this segment into account. In such greedy approach we count the maximal number of segments we can divide our string into. If this number is at least $$$k$$$, then $$$F_{\\ell}$$$ is true."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The complexity is $$$O(n\\log n)$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<bits/stdc++.h>\nusing namespace std;\nvector<int>Zfunc(string& str){\n\tint n=str.size();\n\tvector<int>z(n);\n\tint l=0,r=0;\n\tfor(int i=1;i<n;i++){\n\t\tif(i<=r){\n\t\t\tz[i]=min(r-i+1,z[i-l]);\n\t\t}\n\t\twhile(i+z[i]<n&&str[z[i]]==str[i+z[i]]){\n\t\t\tz[i]++;\n\t\t}\n\t\tif(i+z[i]-1>r){\n\t\t\tl=i;\n\t\t\tr=i+z[i]-1;\n\t\t}\n\t}\n\treturn z;\n}\nint f(vector<int>&z,int len){\n\tint n=z.size();\n\tint cnt=1;\n\tfor(int i=len;i<n;){\n\t\tif(z[i]>=len){\n\t\t\tcnt++;\n\t\t\ti+=len;\n\t\t}else{\n\t\t\ti++;\n\t\t}\n\t}\n\treturn cnt;\n}\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n,k;\n\t\tstring s;\n\t\tcin>>n>>k>>k>>s;\n\t\tvector<int>z=Zfunc(s);\n\t\tint l=0,r=n+1;\n\t\twhile(r-l>1){\n\t\t\tint mid=(l+r)/2;\n\t\t\tif(f(z,mid)>=k){\n\t\t\t\tl=mid;\n\t\t\t}else{\n\t\t\t\tr=mid;\n\t\t\t}\n\t\t}\n\t\tcout<<l<<\"\\n\";\n\t}\n}\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/G2"},"children":[{"kind":"text","text":"1968G2 - Деление + LCP (сложная версия)"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/JuicyGrape"},"children":[{"kind":"text","text":"JuicyGrape"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Consider the general case: $$$L=1$$$ and $$$R=n$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"You must find the answer for each $$$k$$$ in the range $$$[1,n]$$$. Consider the cases $$$k\\le \\sqrt{n}$$$ and $$$k\\geq \\sqrt{n}$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"attrs":{"problemCode":"1968G2"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/1968/problem/G2"},"children":[{"kind":"text","text":"1968G2 - Division + LCP (hard version)"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"In general, in this version we must answer for each $$$k\\in\\{1,2,\\dots,n\\}$$$. We will use a similar idea as in the easy version considering two cases: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$k\\le \\sqrt{n}$$$. We may calculate these values as in the easy version in $$$O(n\\sqrt{n}\\log n)$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$k \\gt \\sqrt{n}$$$. As we divide the string into $$$k$$$ segments and the LCP is $$$\\ell$$$, then $$$k\\cdot \\ell\\le n$$$. We get, that $$$\\ell\\le \\sqrt{n}$$$. We may find the maximal possible $$$k$$$ for a fixed $$$\\ell$$$ as our answer. It works in $$$O(n\\sqrt{n})$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There are other approaches to solving this problem, but the authors believe this solution is the simplest one."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Implementation"}]},"children":[{"kind":"code_block","text":"#include<bits/stdc++.h>\nusing namespace std;\nvector<int>Zfunc(string& str){\n\tint n=str.size();\n\tvector<int>z(n);\n\tint l=0,r=0;\n\tfor(int i=1;i<n;i++){\n\t\tif(i<=r){\n\t\t\tz[i]=min(r-i+1,z[i-l]);\n\t\t}\n\t\twhile(i+z[i]<n&&str[z[i]]==str[i+z[i]]){\n\t\t\tz[i]++;\n\t\t}\n\t\tif(i+z[i]-1>r){\n\t\t\tl=i;\n\t\t\tr=i+z[i]-1;\n\t\t}\n\t}\n\treturn z;\n}\nint f(vector<int>&z,int len){\n\tint n=z.size();\n\tint cnt=1;\n\tfor(int i=len;i<n;){\n\t\tif(z[i]>=len){\n\t\t\tcnt++;\n\t\t\ti+=len;\n\t\t}else{\n\t\t\ti++;\n\t\t}\n\t}\n\treturn cnt;\n}\nint main(){\n\tint t;\n\tcin>>t;\n\twhile(t--){\n\t\tint n,L,R;\n\t\tstring s;\n\t\tcin>>n>>L>>R>>s;\n\t\tvector<int>z=Zfunc(s);\n\t\tconst int E=ceil(sqrt(n));\n\t\tvector<int>ans(n+1);\n\t\tfor(int k=1;k<=E;k++){\n\t\t\tint l=0,r=n+1;\n\t\t\twhile(r-l>1){\n\t\t\t\tint mid=(l+r)/2;\n\t\t\t\tif(f(z,mid)>=k){\n\t\t\t\t\tl=mid;\n\t\t\t\t}else{\n\t\t\t\t\tr=mid;\n\t\t\t\t}\n\t\t\t}\n\t\t\tans[k]=l;\n\t\t}\n\t\tfor(int len=1;len<=E;len++){\n\t\t\tint k=1;\n\t\t\tfor(int i=len;i<n;){\n\t\t\t\tif(z[i]>=len){\n\t\t\t\t\tk++;\n\t\t\t\t\ti+=len;\n\t\t\t\t}else{\n\t\t\t\t\ti++;\n\t\t\t\t}\n\t\t\t}\n\t\t\tans[k]=max(ans[k],len);\n\t\t}\n\t\tfor(int i=n-1;i>=1;i--){\n\t\t\tans[i]=max(ans[i],ans[i+1]);\n\t\t}\n\t\tfor(int i=L;i<=R;i++){\n\t\t\tcout<<ans[i]<<' ';\n\t\t}\n\t\tcout<<\"\\n\";\n\t}\n}\n\n"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Didn't solve  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Good task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Average task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Bad task  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/129096"}