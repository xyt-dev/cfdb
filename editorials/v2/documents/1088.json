{"assets":["/editorial-assets/a4860f748a484cbbfd3d3b722803b905e1d720f1e674cc947284f982e40a8e4e.png","/editorial-assets/0ba6601ffc17843028e7e2881646ca91fb602ce9c3fae2a1e0b3abd77b941dec.png","/editorial-assets/0f96e5659eb66d75ae58c3252e3d042e92c2f99e1643bc990cb706a0c44fad34.png","/editorial-assets/efc72d4793b3ef696b3dfb1b99df67872373b8ff86b3ef9ade0a9c00a72ec76e.png","/editorial-assets/daa70f80dd7e5f21fea5166a9d887c4dde89c74eb3e031c77f425c1bf2216c96.png","/editorial-assets/8d15eb1a42e9b9ec37793cf49dd688cd737ab80bea5a42868e957d45dfc93fa9.png","/editorial-assets/3ae5aa4179cd834641081c56b48ed5f6e2393ca9f118457f3db14d3736ba1970.png"],"contestId":"1088","diagnostics":[],"document":{"children":[{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/A"},"children":[{"kind":"text","text":"1088A - Ehab and another construction problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Well, the constraints allow a brute-force solution, but here's an "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) solution:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 1, there's no solution. Otherwise, just print "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"%2 and 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/LXvuX8Ez"},"children":[{"kind":"text","text":"https://pastebin.com/LXvuX8Ez"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/B"},"children":[{"kind":"text","text":"1088B - Ehab and subtraction"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" be the set of numbers in input (sorted and distinct). In the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" step, "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is subtracted from all bigger or equal elements, and all smaller elements are 0. Thus, the answer in the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" step is "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" = 0)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/bpz1YxBe"},"children":[{"kind":"text","text":"https://pastebin.com/bpz1YxBe"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlog"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/C"},"children":[{"kind":"text","text":"1088C - Ehab and a 2-operation task"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The editorial uses 0-indexing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Both solutions make "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"First solution, n adds and 1 mod"}],"kind":"heading"},{"children":[{"kind":"text","text":"First, let's make "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (for some "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"). Then, let's mod the whole array with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" (making "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). If the \"add update\" changed one index, we can just add "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"%"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" to index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". The problem is, if we make "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", then update an index "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be ruined. Just start from the back of the array!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/dBfhNBL8"},"children":[{"kind":"text","text":"https://pastebin.com/dBfhNBL8"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"Second solution, 1 add and n mods"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Note"}],"kind":"strong"},{"kind":"text","text":": for any "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", if "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"%"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Additionally, if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"attrs":{"alt":"","src":"/editorial-assets/a4860f748a484cbbfd3d3b722803b905e1d720f1e674cc947284f982e40a8e4e.png"},"kind":"image"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"%"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's add 5·10"},{"children":[{"kind":"text","text":"5"}],"kind":"superscript"},{"kind":"text","text":" to the whole array, loop over "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (in order), and mod prefix "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Why does this work? Notice that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"%("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (the second note). Also, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" won't be changed afterwards (the first note)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/L6suPC1f"},"children":[{"kind":"text","text":"https://pastebin.com/L6suPC1f"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/D"},"children":[{"kind":"text","text":"1088D - Ehab and another another xor problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem is particularly hard to explain :/ I recommend the simulation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's build "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" bit by bit from the most significant to the least significant (assume they're stored in "},{"children":[{"kind":"text","text":"curA"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"curB"}],"kind":"emphasis"},{"kind":"text","text":"). Then, at the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" step, "},{"attrs":{"alt":"","src":"/editorial-assets/0ba6601ffc17843028e7e2881646ca91fb602ce9c3fae2a1e0b3abd77b941dec.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/0f96e5659eb66d75ae58c3252e3d042e92c2f99e1643bc990cb706a0c44fad34.png"},"kind":"image"},{"kind":"text","text":" have all bits from the most significant to the ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1)"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" set to 0. Notice that whether "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is greater or less than "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is judged by the most significant bit in which they differ (the one that has 1 is bigger). Let's query with "},{"attrs":{"alt":"","src":"/editorial-assets/efc72d4793b3ef696b3dfb1b99df67872373b8ff86b3ef9ade0a9c00a72ec76e.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/daa70f80dd7e5f21fea5166a9d887c4dde89c74eb3e031c77f425c1bf2216c96.png"},"kind":"image"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/editorial-assets/8d15eb1a42e9b9ec37793cf49dd688cd737ab80bea5a42868e957d45dfc93fa9.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/3ae5aa4179cd834641081c56b48ed5f6e2393ca9f118457f3db14d3736ba1970.png"},"kind":"image"},{"kind":"text","text":" can only differ in the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" bit (or a bit less significant). Now, if the results of the queries are different, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" have the same value in this bit, and this value can be determined by the answer of respective queries (1 if the second query's answer is 1, 0 otherwise). If the queries give the same result, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" must differ in this bit. How to know which of them has a 1 and which has a 0? We know that the greater between them (after setting the processed bits to 0) has a 1 and the other has a 0. The trick is to keep track of the greater between them. Before all queries, we send (0, 0) to know the greater. Every time they differ in a bit, the greater may change. It'll simply change to the answer of the 2 queries we sent! In other words, we know when we sent the queries that after making "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" equal in this bit, some other bit became the most significant bit in which they differ. Also, we know who has a 1 in this bit (the greater in this query). Thus, we'll keep the answer of this query for the future, so when this bit comes, we don't need additional queries."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Simulation for an example"}]},"children":[{"children":[{"kind":"text","text":"Let's simulate for "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = 6 and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = 5."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first query, we'll send (0, 0) to know that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query, we'll send (4, 0) (the answer is -1) and (0, 4) (the answer is 1). Since the answers differ, this bit has the same value for "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Since the answer to the second query is 1, they both have a 1. Now, "},{"children":[{"kind":"text","text":"curA"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"curB"}],"kind":"emphasis"},{"kind":"text","text":" = 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query, we'll send (6, 4) (the answer is -1) and (4, 6) (the answer is -1). Since the answers are the same, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" differ in this bit. Since "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is currently the greater, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" has a 1 and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" has a 0. Now, the greater is "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" (the next time 2 bits differ, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" will have a 1). Also, "},{"children":[{"kind":"text","text":"curA"}],"kind":"emphasis"},{"kind":"text","text":" = 6 and "},{"children":[{"kind":"text","text":"curB"}],"kind":"emphasis"},{"kind":"text","text":" = 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last query, we'll send (7, 4) (the answer is 0) and (6, 5) (the answer is 0). Since the answers are the same, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" differ in this bit. Since "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" is currently greater, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" has a 1. Now, "},{"children":[{"kind":"text","text":"curA"}],"kind":"emphasis"},{"kind":"text","text":" = 6 and "},{"children":[{"kind":"text","text":"curB"}],"kind":"emphasis"},{"kind":"text","text":" = 5 and we're done :D"}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/b9zgKuJ6"},"children":[{"kind":"text","text":"https://pastebin.com/b9zgKuJ6"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/E"},"children":[{"kind":"text","text":"1088E - Ehab and a component choosing problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Assume you already chose the components. Let the sum of nodes in the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" component be "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then, the expression in the problem is equivalent to "},{"children":[{"kind":"text","text":"average"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Assume we only bother about the fraction maximization problem and don't care about "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Then, it'll always be better to choose the component with the maximum "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and throw away the rest! This is because of the famous inequality:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") ≥ "},{"children":[{"kind":"text","text":"average"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") and the equality only occurs if all "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are equal!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This means that the maximum value of the fraction is simply the maximum sum of a sub-component in the tree. To calculate it, let's root the tree at node 1, and calculate "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":"], the maximum sum of a sub-component that contains node. Now, I'll put the code, and explain it after."}],"kind":"paragraph"},{"kind":"code_block","text":"void dfs(int node,int p,bool f)\n{\n    dp[node]=a[node];\n    for (int u:v[node])\n    {\n        if (u!=p)\n        {\n            dfs(u,node,f);\n            dp[node]+=max(dp[u],0LL);\n        }\n    }\n    if (f)\n    ans=max(ans,dp[node]);\n    else if (dp[node]==ans)\n    {\n        dp[node]=0;\n        k++;\n    }\n}\n"},{"children":[{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" denotes the maximum sub-component sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, we call "},{"children":[{"kind":"text","text":"dfs"}],"kind":"emphasis"},{"kind":"text","text":"(1, 0, 1). We calculate the "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":" of all the children of "},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":". For every child "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", we extend the component of "},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":" with the component of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" if "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] > 0, and do nothing otherwise. Now, we solved the first half of our problem, but what about maximizing "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"? Notice that all components you choose must have a sum of weights equal to "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" (because the equality occurs if and only if all "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are equal). You just want to maximize their count. Let's calculate our "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":" again. Assume "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":". We have 2 choices: either mark the "},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":" and its component as a component in the answer (but then other nodes won't be able to use them because the components can't overlap), or wait and extend the component. The idea is that there's no reason to wait. If we extend the component with some nodes, they won't change the sum, and they may even have another sub-component with maximal sum that we're merging to our component and wasting it! Thus, we'll always go with the first choice, making "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"node"}],"kind":"emphasis"},{"kind":"text","text":"] = 0 so that its parent can't use it, and increasing "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" :D"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/8pCrTfuP"},"children":[{"kind":"text","text":"https://pastebin.com/8pCrTfuP"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/1088/problem/F"},"children":[{"kind":"text","text":"1088F - Ehab and a weird weight formula"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First, let's reduce the problem to ordinary MST. We know that each edge {"},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"} adds ⌈"},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"dist"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"))⌉·"},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") to "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":". In fact, it also adds 1 to "},{"children":[{"kind":"text","text":"deg"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"deg"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Thus, the problem is ordinary MST on a complete graph where each edge {"},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"} has weight (⌈"},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"dist"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"))⌉ + 1)·"},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the node with the minimum weight be "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Let's root the tree at it."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lemma"}],"kind":"strong"},{"kind":"text","text":": for every node "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and a child "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". In simpler words, the weight increase as we go down the tree."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Proof"}],"kind":"strong"},{"kind":"text","text":": the proof is by contradiction. Assume "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then, the condition in the problem (that every node has an adjacent node with less weight) isn't satisfied yet for "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Therefore, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" must have a child "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". However, the condition isn't satisfied for "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", so "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" needs another child and the child needs another child etc. (the tree will be infinite) which is clearly a contradiction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From that, we know that the weights decrease as we go up the tree and increase as we go down."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Back to the MST problem. From Kruskal's algorithm, we know that the minimal edge incident to every node will be added to the MST (because the edges are sorted by weight). Let's analyze the minimal edge incident to every node "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". Let its other end be "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Except for node "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" will be an ancestor of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"strong"},{"kind":"text","text":". Why? Assume we fix the distance part and just want to minimize "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We'll keep going up the tree (it's never optimal to go down, since the weights will increase) until we reach the desired distance. Now, since the minimal edge incident to every node will be added to the MST (by Kruskal's algorithm), and they're distinct (because, otherwise, you're saying that "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is an ancestor of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"), THEY ARE THE MST. Now, the problem just reduces to finding the minimal edge incident to every node and summing them up (except for "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"). To do that, we'll fix the ⌈"},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"dist"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"))⌉ (let it be "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), and get the 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"}],"kind":"superscript"},{"kind":"text","text":" ancestor with the well-known sparse-table (binary lifting)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code link: "},{"attrs":{"href":"https://pastebin.com/vzJqh8si"},"children":[{"kind":"text","text":"https://pastebin.com/vzJqh8si"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlog"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/63656"}