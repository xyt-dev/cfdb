{"assets":["/editorial-assets/f74e3c3399fdfef9f45ecc9c1ec273cb294ff881ea2c8b611a215cdfee41bc50.png","/editorial-assets/e3d93844040221bdc617cb6e7b75abe0106cf47af39bc1d12f2ac63b15475dd6.png","/editorial-assets/d0392c8b224cdea872ecb03db53cf32977ab89b96184a828ee25ce17be3f88c6.png","/editorial-assets/fbf3fda80cd993170a7e953f3275bbf321fbd37d34c0664e4e258b562ad23343.png","/editorial-assets/65b5033bef0d033c51e6da921e44205f41caadd076ea71a489b2b65172de4d98.png","/editorial-assets/338758a7b28d0b8134e5da5d8e3fd368317c9ae9f89389a418b3a2b6601b0f51.png","/editorial-assets/ddbf017d62d1ce80f59e0fd0ae4f7e99704ea4f8b496a7ac91f284d7a80eb932.png","/editorial-assets/ca01708134814096a9fb16cc94dd2bee977966f6a6caf0dcbc54a3c960d29a0a.png","/editorial-assets/4aab8b47a42b2cc91cadabe2ca91f384c883e6022c8bfde0d7de0928f459d8ac.png","/editorial-assets/f26094fb82e8ecd231f45eeb3bf9cb55e5d498d1d5fa6fc0b7643fecc9b33742.png","/editorial-assets/e5bb8d39286a7c3a97e5c765b12b7d6a62b3c59bd94490a95dc334dc0766810c.png","/editorial-assets/53d3594178a34b633637ca46f22e5b1c3df076de66d0257a5624de1bdab354d3.png","/editorial-assets/d9510abd9424750edee7342995a905cdb56f0045815f8d6339169e71ac50978c.png","/editorial-assets/69ed052c2d53024e92258c6eb84352fb593795cf4a9546f9ac417382de421b47.png","/editorial-assets/cc0d9ba133be6f4cb2ed990d307af3c07c29b8c7b79529f95bd79e6b63c58a39.png","/editorial-assets/67e9cbd34e43baf07d5ddd1e5c333201bcabff58c682a616aebd266874589d94.png","/editorial-assets/9f609f71bfb57679cf414e7da00a276efa00ba42488ecf5458febd600cba9cf7.png"],"contestId":"439","diagnostics":[],"document":{"children":[{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/problem/A"},"children":[{"kind":"text","text":"439A - Devu, the Singer and Churu, the Joker"}],"kind":"link"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For checking whether there is a way to conduct all the songs of the singer, you can conduct the event in the following way. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"First singer will sing a song."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Then during 10 minutes rest of the singer, the joker will crack 2 jokes(each of 5 minutes)"}],"kind":"list_item"},{"children":[{"kind":"text","text":"Then singer will again sing a song, then joker, etc."}],"kind":"list_item"},{"children":[{"kind":"text","text":"After the singer has completes all his songs, the joker will keep on cracking jokes of 5 minutes each."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Hence minimum duration of the even needed such that sing could sing all his songs will be "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + 10 + "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + 10 + ... +"},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * 10 where "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":" denote the total time of the songs of the singer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So for checking feasibility of the solution, just check whether "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * 10 ≤ "},{"children":[{"kind":"text","text":"duration"}],"kind":"emphasis"},{"kind":"text","text":" or not?. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is feasible, then time remaining for joker will be the entire duration except the time when the singer is singing the song. Hence time available for the joker will be "},{"children":[{"kind":"text","text":"duration"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":". In that time joker will sing "},{"attrs":{"alt":"","src":"/editorial-assets/f74e3c3399fdfef9f45ecc9c1ec273cb294ff881ea2c8b611a215cdfee41bc50.png"},"kind":"image"},{"kind":"text","text":" songs."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solution codes"}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814268"},"children":[{"kind":"text","text":"my solution"}],"kind":"link"}],"kind":"list_item"}],"kind":"list"},{"kind":"horizontal_rule"},{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/problem/B"},"children":[{"kind":"text","text":"439B - Devu, the Dumb Guy"}],"kind":"link"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can formulate the problem in following way. Given two arrays "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Find minimum cost of matching the elements of array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". For our problem the array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" will be same as "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". The array "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" will have content "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" — 1, , 1, 1. For a general version of this problem, we can use min cost max flow(min cost matching), but for this problem following simple greedy solution will work."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Sort the array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" in increasing and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" in decreasing order (or vice versa)."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Now match "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" element of the array a with "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" element of array b."}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Proof:"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be easily proved by exchange argument. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solution Codes"}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814439"},"children":[{"kind":"text","text":"my solution"}],"kind":"link"}],"kind":"list_item"}],"kind":"list"},{"kind":"horizontal_rule"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/problem/C"},"children":[{"kind":"text","text":"439C - Devu and Partitioning of the Array"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us first try to find the condition required to make sure the existence of the partitions. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice the following points."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"If the parity of sum does not match with parity of number of odd partitions ("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":") , then we can't create the required partitions. eg. "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = [1;2], "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2, "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" = 0, Then you can not create two partitions of odd size, because then sum of the elements of the partitions of the array will be even whereas the sum of elements of the array is odd."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If number of odd elements in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" are less than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" (number of required partitions with odd sum), then we can not do a valid partitioning."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"If number of even elements are less than "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", then we can not create even partitions simply by using even numbers, we have to use odd numbers too. Notice the simple fact that sum of two odd numbers is even. Hence we will try to include 2 odd elements in our partitions too. So if we can create "},{"children":[{"kind":"text","text":"oddsRemaining"}],"kind":"emphasis"},{"kind":"text","text":" / 2 partitions in which every partition contains 2 odd elements, then we can do a valid partitioning otherwise we can't. Here "},{"children":[{"kind":"text","text":"oddsRemaining"}],"kind":"emphasis"},{"kind":"text","text":" denotes the number of odd elements which are not used in any of the partitions made up to now."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"oddElements"}],"kind":"emphasis"},{"kind":"text","text":" denotes the number of odd elements in array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Similarly "},{"children":[{"kind":"text","text":"evenElements"}],"kind":"emphasis"},{"kind":"text","text":" denotes the number of even elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the answer exists if "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Number of possible odd partitions are  ≥  "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" i.e. "},{"children":[{"kind":"text","text":"oddElements"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Number of possible even partitions are  ≥  "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" i.e. "},{"children":[{"kind":"text","text":"evenElements"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"oddRemaining"}],"kind":"emphasis"},{"kind":"text","text":") / 2 ≥ "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":". where "},{"children":[{"kind":"text","text":"oddRemaining"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"oddElements"}],"kind":"emphasis"},{"kind":"text","text":" - ("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For generating the actual partitions, you can follow the same strategy used in detecting the existence of the partitions. We will first generate any valid "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" partitions (forget about the condition of using the entire array), then we can simply include the remaining elements of the array in the last partition and we are done."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solution Codes"}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814269"},"children":[{"kind":"text","text":"[user:Gerald]'s solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814282"},"children":[{"kind":"text","text":"my code"}],"kind":"link"}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"kind":"horizontal_rule"},{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/problem/D"},"children":[{"kind":"text","text":"439D - Devu and his Brother"}],"kind":"link"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can solve the problem in two ways."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"By using ternary search"}],"kind":"strong"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let us define a function f. Function f(k) = cost needed to make array a elements  ≥  k + cost needed to make array b elements  ≤  k"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Instead of proving it formally, try checking the property on many random test cases. You will realize that f is convex."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Claim: f is convex"}],"kind":"strong"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Proof:"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is fairly easy to prove. See the derivative of f."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/e3d93844040221bdc617cb6e7b75abe0106cf47af39bc1d12f2ac63b15475dd6.png"},"kind":"image"},{"kind":"text","text":" = — (# of elements of b > k) + (# of elements of a < k)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first term (without sign) can only decrease as k increases whereas second term can only increase as k increases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, "},{"attrs":{"alt":"","src":"/editorial-assets/d0392c8b224cdea872ecb03db53cf32977ab89b96184a828ee25ce17be3f88c6.png"},"kind":"image"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"By using the fact that optimal values are attainable at the array values"}],"kind":"strong"},{"kind":"text","text":":"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All the extremum points will lie in the elements from the any of the arrays because f is convex and "},{"attrs":{"alt":"","src":"/editorial-assets/fbf3fda80cd993170a7e953f3275bbf321fbd37d34c0664e4e258b562ad23343.png"},"kind":"image"},{"kind":"text","text":" at the event points (or the points of array a and b)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For learning more about ternary search, you can see following topcoder "},{"attrs":{"href":"http://apps.topcoder.com/forums/?module=Thread&threadID=506787&start=0&mc=27"},"children":[{"kind":"text","text":"discussion"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Another smart solution"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please see following "},{"attrs":{"href":"https://codeforces.com/blog/entry/12545#comment-172684"},"children":[{"kind":"text","text":"comment"}],"kind":"link"},{"kind":"text","text":" of "},{"attrs":{"href":"https://codeforces.com/profile/goovie"},"children":[{"kind":"text","text":"goovie"}],"kind":"link"},{"kind":"text","text":" and proof is given in the "},{"attrs":{"href":"https://codeforces.com/blog/entry/12545#comment-172693"},"children":[{"kind":"text","text":"reply"}],"kind":"link"},{"kind":"text","text":" by "},{"attrs":{"href":"https://codeforces.com/profile/himank"},"children":[{"kind":"text","text":"himank"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solutions Code"}],"kind":"strong"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814294"},"children":[{"kind":"text","text":"ternary search solution"}],"kind":"link"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814314"},"children":[{"kind":"text","text":"my solution using 2nd fact"}],"kind":"link"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6814333"},"children":[{"kind":"text","text":"[user:Gerald] solution"}],"kind":"link"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/439/submission/6813224"},"children":[{"kind":"text","text":"[user:triveni] solution using smart solution"}],"kind":"link"}],"kind":"list_i