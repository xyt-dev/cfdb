{"assets":["/editorial-assets/08633e9b991efc316e55bd279b0cd6632cacd91ead91d074e4e4a810679c5f93.png","/editorial-assets/cdab8ff09583e5c579740bc17c3b40b66fe0ddbce6e2eb1afb46230d468e3b76.png","/editorial-assets/056dc034aa251e769852bf108a18785e8c194de53420fe15e8c2efff991b7ff1.png"],"contestId":"298","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/298/problem/A"},"children":[{"kind":"text","text":"298A - Snow Footprints"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The starting position can be anywhere with a footprint. The footprints can be categorized into 3 types."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"only "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" s"}],"kind":"list_item"},{"children":[{"kind":"text","text":"only "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" s"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" s followed by "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" s"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In case 1, we end in the left of all footprints. In case 2, we end in the right of all footprints. In case 3, we either end in the rightmost "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" or the leftmost "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/298/problem/B"},"children":[{"kind":"text","text":"298B - Sail"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can simply move by greedy method — only moves when it takes the boat closer to the destination."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/297/problem/A"},"children":[{"kind":"text","text":"297A - Parity Game"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Obv 1"}],"kind":"strong"},{"kind":"text","text":": If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" has odd parity, we can apply operation 1 to increase its number of 1s by 1."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Obv 2"}],"kind":"strong"},{"kind":"text","text":": If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" has even parity, its number of 1s cannot increase anymore."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Claim"}],"kind":"strong"},{"kind":"text","text":": If the number of 1s in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is not fewer than those in "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", we can always turn "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The idea is to make a copy of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" at the right of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Lets assume "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" starts with even parity. If we need a 0, simply apply operation 1. If we need a 1, keep remove from the head until we removed an 1. Notice that we never remove digits from 'new part' of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Now the parity of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" will be odd and we can apply operation 1. After that, the parity of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" becomes even again, the number of 1 in the 'old part' of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" decrease by 1 and we handle a 1 in "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Finally, remove the remaining old part of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and we get "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Combine all those facts, we can conclude that we can turn "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" if and only if "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"countOnes"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"parity"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"countOnes"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":")) ≥ "},{"children":[{"kind":"text","text":"countOnes"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/297/problem/B"},"children":[{"kind":"text","text":"297B - Fish Weight"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First we sort "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" in non-increasing order. We claim that the answer is YES if and only if exists "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is lexicographically larger than "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/08633e9b991efc316e55bd279b0cd6632cacd91ead91d074e4e4a810679c5f93.png"},"kind":"image"},{"kind":"text","text":" If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is not lexicographcally larger than "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", that means for every "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". That implies for every fish Alice has, there is a corresponding fish Bob has and is as heavy as Alice's. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/cdab8ff09583e5c579740bc17c3b40b66fe0ddbce6e2eb1afb46230d468e3b76.png"},"kind":"image"},{"kind":"text","text":" Let "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" be the smallest index such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We can amplify the gap between "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" as large as we want to make Alice wins."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/297/problem/C"},"children":[{"kind":"text","text":"297C - Splitting the Uniqueness"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An equivalent definition for "},{"children":[{"kind":"text","text":"almost unique"}],"kind":"emphasis"},{"kind":"text","text":", is an array with at least ⌊ 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / 3⌋ different elements. The idea is to split "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" into three parts: In the first part, we give uniqueness to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". In the second part, we give uniqueness to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". In the third part, we give uniqueness to both."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lets assume "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" is sorted. Since "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" is an unique array, we know "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (0-based). The image below will give some intuition on how we are going to split it. "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is red, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" is blue, the length of the bar represent the magnitude of the number. In the first and second part, we do not care about the array that we are not giving uniqueness to."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/056dc034aa251e769852bf108a18785e8c194de53420fe15e8c2efff991b7ff1.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For exampmle, if "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 30:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = 0... 9:  assign "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (do not care values of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = 10... 19:  assign "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (do not care values of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = 20... 29:  assign "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 29 - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and set "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". From "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = 20, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" will have strictly increasing values starting from at least 11."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/297/problem/D"},"children":[{"kind":"text","text":"297D - Color the Carpet"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1 there is only one coloring so we just need to check the number of  =  constraints. When "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 2, it turns out that using only 2 colors is always sufficient to satisfy at least 3 / 4 of the constraints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lets assume "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" (rotate if not). We will call the constraints that involves cells in different row \"vertical constraints\", and similar for \"horizontal constraints\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First we color the first row such that all horizontal constraints in row 1 are satisfied. We will color the remaining rows one by one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To color row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", first we color it such that all horizontal constraints in row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" are satisfied. Then consider the vertical constraints between row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1. Count the number of satisfied and unsatisfied vertical constraints. If there are more unsatisfied constraints than satisfied constraints, flip the coloring of row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Flipping a row means turning 2211212 → 1122121, for example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we flip the coloring of row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", all horizontal constraints in row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" are still satisfied, but for the vertical constraints between row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, satisfied will turn to unsatisfied, unsatisfied will turn to satisfied. Therefore, we can always satisfy at least half the vertical constraints between row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and row "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of unsatisfied constraints is at most ("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" - 1) × ⌊ "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" / 2⌋, which is at most 1 / 4 of the total number of constraints (recall "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/297/problem/E"},"children":[{"kind":"text","text":"297E - Mystic Carvings"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Problem and editorial written by "},{"attrs":{"href":"https://codeforces.com/profile/AEtheReal"},"children":[{"kind":"text","text":"AEtheReal"}],"kind":"link"},{"kind":"text","text":". "},{"attrs":{"href":"https://www.codeforces.com/blog/AEtheReal"},"children":[{"kind":"text","text":"Link to editorial"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/7437"}