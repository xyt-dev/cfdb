nd":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":", then the position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" belongs to at least one occurrence of the "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", in other case the occurrence doesn’t exist. We can easily check it by creating an array "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for each letter, which is a number of letters "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" in the positions 1... "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". The complexity of the solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"|). "}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"Div2 E/Div1 C. Частичные суммы"}],"kind":"heading"},{"children":[{"kind":"text","text":"You were given an array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" in this problem. You could replace "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" by the array of its partial sums by one step. You had to find the array after "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" such steps. All the calculations were modulo "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" = 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" + 7."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write partial sums in following way:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/699913088c76c33a7ba49655d098cd61c5baedd23f9335eaac9e578669aece1e.png"},"kind":"image"},{"children":[{"kind":"text","text":"where "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0 if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", for each 1 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". We can represent "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" as vector-columns, therefore one step corresponds to multiplying matrix "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and vector-column "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Then the array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" after "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" steps is equal to "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". We can raise a matrix to a power for "},{"attrs":{"alt":"","src":"/editorial-assets/9c61cfa439c036704212dfb8a294dca79f43ac05b08a8c2c6fb28111d2bc2b6a.png"},"kind":"image"},{"kind":"text","text":". It is not bad, but not fast enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can notice, that "},{"attrs":{"alt":"","src":"/editorial-assets/bf8a24b9bc10ae8c8cfbb5de158867615bed6e0a4e6e894bce600bb4938f0100.png"},"kind":"image"},{"kind":"text","text":" = "},{"attrs":{"alt":"","src":"/editorial-assets/c1e4c12e102dae153f70e4bfa02f382e08a59052b4abf08bc7d936a459236b18.png"},"kind":"image"},{"kind":"text","text":", i.e. the elements of the matrix "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" on diagonals parallel to the main are the equal. It is easy to prove this fact using mathematical induction. You may prove it by yourself. Then we can determine the matrix by an array of numbers "},{"attrs":{"alt":"","src":"/editorial-assets/e0bc1ab062becd4fdf05c9ae299eaaeb707c04f06a77f79ab01c5bfc520658b9.png"},"kind":"image"},{"kind":"text","text":", equal to the elements of the first column. The elements of the first column of the product "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" are equal "},{"attrs":{"alt":"","src":"/editorial-assets/d804eb78af6c9577b54056c8725c7f689623461adea6d1fc422791f44918c096.png"},"kind":"image"},{"kind":"text","text":". It is a straight consequence of formula of matrix product. The computing of one element requires "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time, there are "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" elements therefore we can multiply matriсеs in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") time. Then we can solve the problem in "},{"attrs":{"alt":"","src":"/editorial-assets/582fd978e3a62872b825c67f850d6a5f1fd01b8552157263371d215281d6f071.png"},"kind":"image"},{"kind":"text","text":" time and this solution fits the consrtaints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This problem can be solved faster. We can assure that "},{"attrs":{"alt":"","src":"/editorial-assets/bb1f34de414f061f086318920d810193b40ff47f4308eb6f84b3f02b9d0306b4.png"},"kind":"image"},{"kind":"text","text":". Let this formula be correct for some "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Prove that it is correct for "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 either. Using the formula of product we get:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/a4d7e4e7e4eb314240b996e14eb544d40fc6cae5e8a254f57f4fdf4f9bda2e51.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/ab478d61b742f4fdc1c374578a3fcb7b33a94c48d77ed1daf71f8a16379c9eb2.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/42dce6fd0c992e038e68f59e1a00e775fafbe2c14863e51449851d3397990a54.png"},"kind":"image"},{"children":[{"kind":"text","text":"Используя формулу "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"! / "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"!("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")!, можно получить, что "},{"attrs":{"alt":"","src":"/editorial-assets/ae7db0ac2ed60d65603326a7098814b88c249610a42c337143a22be037a781ce.png"},"kind":"image"},{"kind":"text","text":", поэтому мы можем построить все коэффициенты "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", если умеем делить по модулю "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", поэтому в этом решении существенна простота "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". Обратный для числа "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" по простому модулю равен "},{"attrs":{"alt":"","src":"/editorial-assets/a84f5ccae6deb5028af4290f293e82940f1f5b5ce579b7ec0a30492bae492afa.png"},"kind":"image"},{"kind":"text","text":" в силу малой теоремы Ферма. Таким образом, мы получаем решение за "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using the formula "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"! / "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"!("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")! we can obtain "},{"attrs":{"alt":"","src":"/editorial-assets/ae7db0ac2ed60d65603326a7098814b88c249610a42c337143a22be037a781ce.png"},"kind":"image"},{"kind":"text","text":", so we can find all the coefficients "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" if we can divide modulo "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". Therefore it is significant that "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" is prime. Inverse "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" modulo "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"attrs":{"alt":"","src":"/editorial-assets/a84f5ccae6deb5028af4290f293e82940f1f5b5ce579b7ec0a30492bae492afa.png"},"kind":"image"},{"kind":"text","text":" according to the Fermat little theorem. Therefore we get "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"solution"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"Div1 D. Spider"}],"kind":"heading"},{"children":[{"kind":"text","text":"You were given a polygon consisting of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices, you had to find the shortest way from one of its vertices to another. You were allowed to move along the border and go stricktly down without going outside the polygon"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the sides of the polygon can be divided into three groups: top, bottom and vertical. The side is vertical if and only if the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinates of its ends are equal. The side is bottom if and only if the polygon's interior is above the side. The side it top if and only if the polygon's interior is below the side. We can descend only from points of the top sides to the points of the bottom sides. Vertical sides can be ignored because every descend that has common points with a vertical side can be splitted into two descends and one transfer. One can prove that it is useless to descend from a side's interior to side's interior. Len one of the descends in the optimal solution start in the inner point and end in the inner point. We can slightly change the "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinate of the descend. The path's lenght is monotonically (possibly not strictly) depends on "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", so we can move "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in order to improve the answer. In case of not strictly monotone dependance the answer do not depend on "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", so we also can move it. This proof is wrong if the descend passes through a vertex, therefore we have to examine all possible descends from the vertices and to the vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can solve this problem using scan-line method. We well move a vertical straight line from the left to the right and keep set "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" of the sides that intersect the line. We store the segments in the "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" in the sorted by "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" order. Let "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" be an abscissa of the line. The events happen during the moving: some segments are added to the "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" set, some are deleted. We can make an array of events, each events is described by its "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinate that is equal to "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" of the line when the corresponding event happens, the number of the segment and a kind of event: adding or deleting. There are two events for every side, their "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinates correspond to abscissas of their ends. The vertical sides can be ignored."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us proceed the events in non-decreasing order of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coords. If the current event is adding we add the side to "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" set. Then we check on its closest neighbours in the set. If the current segment is a top segment we can make a descend from its left vertex down to the intersection with it's lower neighbor. We find the point of the intersection, remember the segment where the point is located and remember that there can be a descend from a vertex to the new point. If the current side is the bottom side we make a descand from the upper neighbour to the left end of the current segment and do the same things. If the current event is deleting we analize its neighbours in the same way, but the descends start or end on the right end of the segment we are going to delete. It is important that if there are many events of one kind we should proceed them simultaneously, i.e. if there are many addings in the same "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coordinate we must add all the segments and then examine their neighbours. It is the same for deletings: firstly we analize the neighbours for all the segments and only then we delete them. Also in the case of equal "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" coords of the events the adding events must be first, otherwise the solution is wrong for the case of two angles separated by a vertical line with vertices lying on this line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Set "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is easy to keep in container such as \"set\". We have to write a comparator for segments. We can do it in following way: two segments can be in "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" simultaneously if and only if there is a vertical line that intersects both of them. In common case such a line is not the unique, all the possible values of "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" are in segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] that can be easily found if we know the coors of the ends of the segments. Then we can choose an arbitrary "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" inside of ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] and compare the ordinates of the intersection points. Is better to choose inner point because in this case we don't have to examine special cases of segments having a common point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After this we can build a graph. It's vertices are the vertices of the polygon and the ends of possible descends. The edges of the graphs are the sides of the polygon and the descends. The shortest path can be found using Dijkstra algorithm. The complexity of the solution is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"Div1 E. Planar graph"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the problem we were given an undirected planar graph without bridges, cutpoints, loops and multiedge laid on the plane. We get requests of the following type: to calculate the number of vertices inside the cycle or on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us take an arbitrary vertex on the border of the graph, for example a vertex that has the least absciss. Let's add a new vertex with an edge to the chosen vertex in such way that the edge is outside the outer border of the graph. We'll call this new vertex a sink. Let's create a 1 value flow running to the sink from each vertex except the sink. Flow can be created using breadth-first or depth-first search. This operation will take the "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's examine any request. We assume that the cycle is oriented counter-clockwise (if it is not so, we can just reorient it). Let's make a cut on the graph. The first part will contain the vertices laying on the cycle or inside it, the second one — all remaining vertices including the sink. We'll now prove that the flow value through the cut is equal to the vertices number in the first part. It's obvious that we can calculate contribution from every vertex to the flow value independently. Let's assume that the vertex is situated in the first part. A unit flow runs from it to the sink along some path. As soon as this vertex and the sink are situated in different parts the flow passes the edges of the cut an odd number of times, that's why the contribution of this vertex to the flow through the cut is equal to 1. Let's take now a vertex situated in the second part. As soon as it's situated in the same part as the sink the flow passes the edges of the cut an even number of times, that's why the contribution of this vertex to the flow through the cut is zero. In order to calculate the flow value through the cut we need to sum up flow values passing through the cut's edges. It's important to notice that every edge of the cut is incident to only one vertex lying on the cycle, that's why we can sum up flows passing though edges going outside the cycle for each vertex in the cycle. In order to find all edges going outside the cycle we'll sort all edges going from each vertex counter-clockwise by angle. In this case all edges going outside the cycle will be placed after the previous vertex of the cycle and before the following vertex of the cycle. That's why the sum of flow values over the edges going outside reduces to a sum over an segment which is easily calculated using partial sums. The complexity of the solution is "},{"attrs":{"alt":"","src":"/editorial-assets/4ad15abba0151614d31981342a7027d89c64835e8d8a6db16c0c630148050a45.png"},"kind":"image"},{"kind":"text","text":" for graph sorting plus "},{"attrs":{"alt":"","src":"/editorial-assets/1b1d3125920f03920e563b8c2a6bece4e79636644f937ba55f62d3b5d44fe13f.png"},"kind":"image"},{"kind":"text","text":" for the request where "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" is the cycle length. There is "},{"attrs":{"alt":"","src":"/editorial-assets/ce5f8687826ce79c19f836c2417291d1b27f2e14595df70d449ead541e4cf862.png"},"kind":"image"},{"kind":"text","text":" in complexity because we have to know a position of a vertex in the adjacency list of another vertex."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/5301"}