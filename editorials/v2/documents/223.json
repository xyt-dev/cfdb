kind":"text","text":" different numbers among "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". The definition of the \"minimal by inclusion\" you can read in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us make a new array "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":". In the beginning its element "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is equal to number of occurencies of number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". It is possible to make this array because elements of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" are not very large. Amount of nonzero elements in "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" is equal to amount of different elements in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". There is no solution if this number is less then "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is not true, we have to find the answer segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]. In the beginning let ["},{"children":[{"kind":"text","