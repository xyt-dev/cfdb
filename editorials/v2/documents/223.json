l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"]. The amount of different numbers on it is equal to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and on every its subsegment is less than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Therefore, this segment is an answer. The complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"kind":"text","text":"Div2 C/Div1 A. Bracket sequence"}],"kind":"heading"},{"children":[{"kind":"text","text":"You were given a bracket sequence "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" consisting of brackets of two kinds. You were to find regular bracket sequence that was a substring of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and contains as many <<"},{"attrs":{"alt":"","src":"/editorial-assets/a8fdaa7c681863027f13c8107274dcc3d1582f740b1f3810ea9fb661eeacd21b.png"},"kind":"image"},{"kind":"text","text":">> braces as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will try to determine corresponding closing bracket for every opening one. Formally, let a bracket on the i-th position be opening, then the closing bracket on the position j is corresponding to it if and only if a substring "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"... "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the shortest regular bracke