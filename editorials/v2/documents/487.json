d":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", 4"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", 3"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"} is a solution. For each solution, check if it matches the known numbers."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solution 3:"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 0, just output any answer (such as {1, 1, 3, 3}). If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 1, just output {"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", 3"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", 3"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"}, where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is the known number. If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 4, just check whether the four known numbers meet the condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, we can enumerate the 1 or 2 missing number(s), and check if the four numbers meet the condition."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/487/problem/A"},"children":[{"kind":"text","text":"487A - Fight the Monster"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"It is no use to make Yang's ATK > HP_M + DEF_M (Yang already can beat it in a second). And it's no use to make Yang's DEF > ATK_M (it cannot deal any damage to him)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a result, Yang's final ATK will not exceed 200, and final DEF will not exceed 100. So just enumerate final ATK from ATK_Y to 200, final DEF from DEF_Y to 100."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"With final ATK and DEF known, you can calculate how long the battle will last, then calculate HP loss. You can easily find the gold you spend, and then find the optimal answer."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/487/problem/B"},"children":[{"kind":"text","text":"487B - Strip"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"We can use dynamic programming to solve this problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] denote the minimal number of pieces that the first "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" numbers can be split into. "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] denote the maximal length of substrip whose right border is "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"(included) and it satisfy the condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","t