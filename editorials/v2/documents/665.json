ext","text":"Answer all the queries off-line: compute the sieve for numbers up to "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":", then sort all numbers by the smallest prime divisor. Now all queries can be answered using RSQ structure. Store all the answers globally."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Run recurisive evaluation of "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" yet again. If we want to compute a state with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":", then we must have preprocessed a query for this state, so take it from the global set of answers."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The performance of this approach relies heavily on "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" — the number of queries we have to preprocess."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Statement"}],"kind":"emphasis"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/editorial-assets/7cc5d559f010bfc070912b8fd8d3a7b78fd66ebef32dcc63305e02f36cfbc1d8.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Proof"}],"kind":"emphasis"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each state we have to preprocess is obtained by following a "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"⌊ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"⌋, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" transition from some greater state. It follows that "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" doesn't exceed the total number of states for "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/7b2d9e465acc299ffda23882e3f42c2fda8847e7f8b82df7f9920e3938be2e2f.png"},"kind":"image"},{"children":[{"kind":"text","text":"The preprocessing of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" queries can be done in "},{"attrs":{"alt":"","src":"/editorial-assets/885de7c62b075ca144dab5e7231768e7358fbf116b827de189531cdab777138e.png"},"kind":"image"},{"kind":"text","text":", and it is the heaviest part of the computation. Choosing optimal "},{"attrs":{"alt":"","src":"/editorial-assets/adb651167410ae10f13a39c1dec6ed07d4fc7b5ff8864ca61a1662917663ff05.png"},"kind":"image"},{"kind":"text","text":", we obtain the complexity "},{"attrs":{"alt":"","src":"/editorial-assets/af0d5d5c4eaa8f52cf568d5630a062faeff6922bbdcadf9f0e829483483b519f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"C++ solution"}]},"children":[{"kind":"code_block","text":"li n;\n\nbool read() {\n\treturn !!(cin >> n);\n}\n\nconst int K = 10 * 1000 * 1000;\nconst int N = K;\nconst int P = 700100;\nconst int Q = 25 * 1000 * 1000;\n\nint szp, p[P];\nint mind[N];\n\nvoid prepare() {\n\tszp = 0;\n\tforn(i, N) mind[i] = -1;\n\tfore(i, 2, N) {\n\t\tif (mind[i] == -1) {\n\t\t\tassert(szp < P);\n\t\t\tmind[i] = szp;\n\t\t\tp[szp++] = i;\n\t\t}\n\t\tfor (int j = 0; j < szp && j <= mind[i] && i * p[j] < N; j++)\n\t\t\tmind[i * p[j]] = j;\n\t}\n}\n\ninline int getk(li n) {\n\tint lf = 0, rg = szp - 1;\n\twhile (lf != rg) {\n\t\tint md = (lf + rg) >> 1;\n\t\tif (p[md] * 1ll * p[md] > n) rg = md;\n\t\telse lf = md + 1;\n\t}\n\tassert(p[lf] * 1ll * p[lf] > n);\n\treturn lf;\n}\n\nint t[K];\nvoid inc(int i, int val) {\n\tfor ( ; i < K; i |= i + 1)\n\t\tt[i] += val;\n}\nint sum(int i) {\n\tint ans = 0;\n\tfor ( ; i >= 0; i = (i & (i + 1)) - 1)\n\t\tans += t[i];\n\treturn ans;\n}\n\nint szq;\npti q[Q];\nint ans[Q];\nvector<int> vs[P];\n\nvoid process() {\n\tsort(q, q + szq, greater<pti> ());\n\tmemset(t, 0, sizeof(t));\n\n\tforn(i, szp) vs[i].clear();\n\tfore(i, 2, K)\n\t\tvs[mind[i]].pb(i);\n\n\tinc(1, +1);\n\n\tint p = szp - 1;\n\tfor (int i = 0, j = 0; i < szq; i = j) {\n\t\twhile (p >= q[i].x) {\n\t\t\tfor (auto v : vs[p])\n\t\t\t\tinc(v, +1);\n\t\t\tp--;\n\t\t}\n\n\t\twhile (j < szq && q[j].x == q[i].x) {\n\t\t\tans[j] = sum(q[j].y);\n\t\t\tj++;\n\t\t}\n\t}\n}\n\nmap<pair<li, int>, li> z;\n\nli solve(li n, int jj, bool fs) {\n\tif (!n) return 0;\n\tint j = min(jj, getk(n));\n\tif (!j) return n + j - jj;\n\n\tli ans = 0;\n\tif (n < K) {\n\t\tpti p(j, (int) n);\n\t\tif (fs) {\n\t\t\tassert(szq < Q);\n\t\t\tq[szq++] = p;\n\t\t\tans = 0;\n\t\t\treturn 0;\n\t\t} else {\n\t\t\tint idx = int(lower_bound(q, q + szq, p, greater<pti> ()) - q);\n\t\t\tassert(idx < szq && q[idx] == p);\n\t\t\tans = ::ans[idx];\n\t\t}\n\t} else {\n\t\tif (!z.count(mp(n, j))) {\n\t\t\tans = solve(n, j - 1, fs);\n\t\t\tans -= solve(n / p[j - 1], j - 1, fs);\n\t\t\tz[mp(n, j)] = ans;\n\t\t} else {\n\t\t\tans = z[mp(n, j)];\n\t\t}\n\t}\n\n\tans += j - jj;\n\n\treturn ans;\n}\n\ninline li pi(li n, bool fs) {\n\tint k = szp - 1;\n\treturn solve(n, k, fs) + k - 1;\n}\n\nvoid solve() {\n\tszq = 0;\n\tz.clear();\n\tfor (int j = 0; p[j] * 1ll * p[j] <= n; j++) {\n\t\tli nn = n / p[j];\n\t\tif (nn > p[j]) {\n\t\t\tpi(n / p[j], true);\n\t\t}\n\t}\n\n\tprocess();\n\n\tz.clear();\n\tli ans = 0;\n\tfor (int j = 0; p[j] * 1ll * p[j] <= n; j++) {\n\t\tli nn = n / p[j];\n\t\tif (nn > p[j]) {\n\t\t\tans += pi(n / p[j], false);\n\t\t\tans -= j + 1;\n\t\t}\n\t}\n\n\tfor (int i = 0; i < szp && p[i] * 1ll * p[i] * 1ll * p[i] <= n; i++)\n\t\tans++;\n\n\tcout << ans << endl;\n}\n"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/af0d5d5c4eaa8f52cf568d5630a062faeff6922bbdcadf9f0e829483483b519f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/44466"}