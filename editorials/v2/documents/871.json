{"assets":["/editorial-assets/9cd66503f3a48e531d9f00abc67bc3e1a001e56ad4f15e0547bfcf085651d24e.png","/editorial-assets/39bddd9205a9186dfa3e0777b93e191bce0bf635c73150eca58ad430b4baa788.png","/editorial-assets/944339717a152e727608741b6b3756a79849af970bc7ae5f5527c99de88721cf.png","/editorial-assets/698945e92fa63f8ffd628dec3ed53b9ebaa2650d6be50d385cba375d9fcb0939.png","/editorial-assets/147282c0f8dab0909a38c87d05f6e99e6666c6d1f9ac89194cae16fa7af70e87.png"],"contestId":"871","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/A"},"children":[{"kind":"text","text":"870A - Search for Pretty Integers"}],"kind":"link"},{"kind":"text","text":" Idea, preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/komendart"},"children":[{"kind":"text","text":"komendart"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/B"},"children":[{"kind":"text","text":"870B - Maximum of Maximums of Minimums"}],"kind":"link"},{"kind":"text","text":" Idea "},{"attrs":{"href":"https://codeforces.com/profile/DPR-pavlin"},"children":[{"kind":"text","text":"DPR-pavlin"}],"kind":"link"},{"kind":"text","text":", preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/mHuman"},"children":[{"kind":"text","text":"mHuman"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/C"},"children":[{"kind":"text","text":"870C - Maximum splitting"}],"kind":"link"},{"kind":"text","text":" Idea, preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/komendart"},"children":[{"kind":"text","text":"komendart"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/D"},"children":[{"kind":"text","text":"870D - Something with XOR Queries"}],"kind":"link"},{"kind":"text","text":" Idea, preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/mHuman"},"children":[{"kind":"text","text":"mHuman"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/E"},"children":[{"kind":"text","text":"870E - Points, Lines and Ready-made Titles"}],"kind":"link"},{"kind":"text","text":" Idea, preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/komendart"},"children":[{"kind":"text","text":"komendart"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/F"},"children":[{"kind":"text","text":"870F - Paths"}],"kind":"link"},{"kind":"text","text":" Idea, preparation, editorial "},{"attrs":{"href":"https://codeforces.com/profile/komendart"},"children":[{"kind":"text","text":"komendart"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/871/problem/E"},"children":[{"kind":"text","text":"871E - Restore the Tree"}],"kind":"link"},{"kind":"text","text":" Idea "},{"attrs":{"href":"https://codeforces.com/profile/MikeMirzayanov"},"children":[{"kind":"text","text":"MikeMirzayanov"}],"kind":"link"},{"kind":"text","text":", preparation "},{"attrs":{"href":"https://codeforces.com/profile/fcspartakm"},"children":[{"kind":"text","text":"fcspartakm"}],"kind":"link"},{"kind":"text","text":", editorial "},{"attrs":{"href":"https://codeforces.com/profile/mHuman"},"children":[{"kind":"text","text":"mHuman"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also many thanks to coordinator "},{"attrs":{"href":"https://codeforces.com/profile/KAN"},"children":[{"kind":"text","text":"KAN"}],"kind":"link"},{"kind":"text","text":", testers "},{"attrs":{"href":"https://codeforces.com/profile/ifsmirnov"},"children":[{"kind":"text","text":"ifsmirnov"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/vintage_Vlad_Makeev"},"children":[{"kind":"text","text":"vintage_Vlad_Makeev"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/AlexFetisov"},"children":[{"kind":"text","text":"AlexFetisov"}],"kind":"link"},{"kind":"text","text":" and any other people who participates in preparation of contest."}],"kind":"paragraph"},{"attrs":{"problemCode":"870A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/A"},"children":[{"kind":"text","text":"870A - Search for Pretty Integers"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Note that the length of the answer does not exceed two because we can take one number from the first list and one number from the second lists and make up of them a pretty number. So we need to check two cases:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Iterate through the digits from the first list and check if digit belongs to the second list too. Make up the number of this digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) Iterate through the numbers from the first list and from the second list. Make up the number of this two digits. There are two ways: digit from the first list, then from the second list and vice versa."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then you should choose the minimal number."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code (C++) "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31365874"},"children":[{"kind":"text","text":"31365874"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Code (Python) "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31365844"},"children":[{"kind":"text","text":"31365844"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"870B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/B"},"children":[{"kind":"text","text":"870B - Maximum of Maximums of Minimums"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"To solve the problem, we need to consider three cases:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 3:  then let "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":" be the position of the element with the maximum value, then it is always possible to divide the array into subsegments so that one subsegment contains only this number, so the answer to the problem is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2:  then all possible partitions are some prefix of nonzero length and coresponding suffix of nonzero length. You can iterate through all positions of the prefix end, and сalculate the answer for this fixed partition, that equals to maximum of minima on the prefix and on the suffix. Minimum value for all suffixes and prefixes can be counted in advance. The answer is the maximum of the answers for all possible partitions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"*Also it can be proved that for "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2 the answer is the maximum of the first and last element."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 1:  then the only possible partition is one segment equal to the whole array. So the answer is the minimum value on the whole array."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31366254"},"children":[{"kind":"text","text":"31366254"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"870C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/C"},"children":[{"kind":"text","text":"870C - Maximum splitting"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Note that minimal composite number is equal to 4. So it is quite logical that there will be a lot of 4 in splitting of big numbers. Let's write for small numbers (1 ≤ "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"  – number of composite summands in splitting of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If our query "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is small number let's print "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Else let's find minimal number "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 4·"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is small number. Then print "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 4·"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can find "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") or any other reasonable complexity. We even can find all "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by hands if we set "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" to 15 or something like that (it will be proved later that 15 is enough)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So now we have right solution but it is not obvious why this solution works."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof (not very beautiful but such thoughts can lead to correct solution):"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's find answer for all numbers from 1 to 15. Several observations:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Only 4, 6, 9 occurs in optimal splittings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) It is not beneficial to use 6 or 9 more than once because 6 + 6 = 4 + 4 + 4, 9 + 9 = 6 + 6 + 6."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) 12, 13, 14, 15 have valid splittings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's prove that all numbers that are greater than 15 will have 4 in optimal splitting. Let's guess that it is incorrect. If minimal number in splitting is neither 4 nor 6 nor 9 than this number will have some non-trivial splitting by induction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If this number either 6 or 9 and we will decrease query by this number then we will sooner or later get some small number (which is less or equal than 15). There is no splitting of small numbers or it contains 4 in splitting (and it contradicts with minimality of the first number) or it contains 6 and 9. So we have contradiction in all cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can subtract 4 from any big query and our solution is correct."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31365909"},"children":[{"kind":"text","text":"31365909"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"870D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/D"},"children":[{"kind":"text","text":"870D - Something with XOR Queries"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The statement: those and only those permutations whose answers to the queries (0, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", 0) for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" coincide with the answers given to the program, are suitable for all possible queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The proof: "},{"attrs":{"alt":"","src":"/editorial-assets/9cd66503f3a48e531d9f00abc67bc3e1a001e56ad4f15e0547bfcf085651d24e.png"},"kind":"image"},{"kind":"text","text":", which means that with the answers to the queries (0, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", 0) you can restore the answers to all other queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we fix the value "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", then we can restore the whole permutation, since we know the answers to the queries ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", 0), and "},{"attrs":{"alt":"","src":"/editorial-assets/39bddd9205a9186dfa3e0777b93e191bce0bf635c73150eca58ad430b4baa788.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can iterate through the value "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", restore the whole permutation, and if there were no contradictions in it (that is, every number from 0 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 occurs 1 time) and for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" values "},{"attrs":{"alt":"","src":"/editorial-assets/944339717a152e727608741b6b3756a79849af970bc7ae5f5527c99de88721cf.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/698945e92fa63f8ffd628dec3ed53b9ebaa2650d6be50d385cba375d9fcb0939.png"},"kind":"image"},{"kind":"text","text":" coincide with the answers given to the program, then this permutation is indistinguishable from the hidden permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer is the number of such permutations, and one of such permutations."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31366223"},"children":[{"kind":"text","text":"31366223"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"870E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/E"},"children":[{"kind":"text","text":"870E - Points, Lines and Ready-made Titles"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's build graph on points. Add edge from point to left, right, top and bottom neighbours (if such neigbour exist). Note that we can solve problem independently for each connected component and then print product of answer for components. So we can consider only connected graphs without loss of generality."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define X as number of different x-coords, Y as number of different y-coords."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What if graph contains some cycle? Let's consider this cycle without immediate vertices (vertices that lie on the same line with previous and next vertices of cycle). Draw a line from each such vertex to the next vertex of cycle (and from last to the first). We got all lines that are corresponding to x-coords and y-coords of vertices of cycle. Let's prove by induction that we can got all such lines from the whole graph"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Run depth-first search from vertices of cycle. Let we enter in some vertex that is not from cycle. It mush have at least one visited neighbour. By induction for graph consisting of visited vertices we can get all lines. So there is line from visited neighbour. Draw line in another direction and continue depth-first search. Sooner or later we will get all lines for the whole graph. Please note that intermediate vertices of cycle will be processed correctly too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we can get all lines the we can get all subsets of lines. Answer for cyclic graph is 2"},{"children":[{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"Y"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now look at another case  — acyclic graph or tree. We can prove that we can get any incomplete subset of lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's fix subset and some line not from this subset. Just draw this line without restriction. By similar induction as in cyclic graph case we can prove that we can get all lines (but fixed line doesn't exist really)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's prove that it is impossible to take all lines. For graph consisting of only one vertex it is obvious. Else fix some leaf. We must draw a line which are not directed to any neigbour because it is the only way to draw this line. But now we have tree with less number of vertices. So our statement is correct by induction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answer for tree is 2"},{"children":[{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"Y"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the problem now is just about building graph on points and checking each component on having cycles."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31365959"},"children":[{"kind":"text","text":"31365959"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"870F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/870/problem/F"},"children":[{"kind":"text","text":"870F - Paths"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Integer 1 ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is bad is "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 1 or "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is prime and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / 2. Otherwise integer is good."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for 1 < "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is minimal prime divisor of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Path between two vertices doesn't exist if at least one of them is bad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Distance equals to zero if this two vertices are the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Distance equals to one if their numbers have common divisor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Distance between vertices "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" equals to two if "},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise distance is three because path "},{"attrs":{"alt":"","src":"/editorial-assets/147282c0f8dab0909a38c87d05f6e99e6666c6d1f9ac89194cae16fa7af70e87.png"},"kind":"image"},{"kind":"text","text":" always exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is easy to find number of pairs of vertices between which there is no path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of pairs with distance 1 equals to sum over all good "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" of expressions "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - 1 - φ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of pairs with distance 3 can be found if we subtract number of pairs without path and number of pairs with distances 0 and 1 from number of all pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So it only remains to find number of pairs with distance 2. Let's divide such pairs on three types"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Pairs of coprime composite numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) Good prime "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and good number "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" such as "},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is not divided by "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) Two different good prime numbers, product of which is less or equal than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of pairs with distance 2 equals to number of pairs of the first and the second types minus number of pairs of the third type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of pairs of the first type equals to sum over all composite 1 ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" of expressions φ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") - (("},{"children":[{"kind":"text","text":"number"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"of"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"noncomposite"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"numbers"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"which"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"are"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"less"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"than"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"number"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"of"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"unique"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"divisors"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"of"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second type we should sum up over all prime "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" number of good numbers "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"prime"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and subtract number of such numbers divided by "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":". The first we can calculate with some additional precalculations, for the second we can just check all numbers divided by "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of the pairs of the third type can be found trivially."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For other details please see the author's code."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/870/submission/31366002"},"children":[{"kind":"text","text":"31366002"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"871E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/871/problem/E"},"children":[{"kind":"text","text":"871E - Restore the Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"In the beginning, it should be noted that it is possible to find out numbers of vertices from which distances are given, the number of the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"th specified vertex is "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", such that "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" = 0. If there is no such a vertex, or more than one, then there is no answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fix the "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" equal to some vertex from which distances are given in the input data. Assume "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". For any vertex "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we can find vertices lying in the path from "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" to this vertex, since for such and only for such vertices "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":". And accordingly, the vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" suitable for this condition will be at a distance "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":". So, we have learned to build a part of a tree that consists of vertices that lie on the path from "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" to some vertex "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If we couldn't build the path in such a way, then there is no answer. Time complexity of this phase is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now consider the remaining vertices, in order of increasing depth (distance to the root). Let's consider a fixed vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", look at the path from it to "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":", this path can be divided into 2 parts - ("},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") where "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is the vertex from the already constructed tree, let's find the deepest of such "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", this can be done with "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") operations by using the fact that "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is the deepest vertex among all "},{"children":[{"kind":"text","text":"lca"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), which equals the vertex on the path from "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" at a depth of "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then the ancestor "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is the vertex that was added in the same way to the subtree "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" but with a depth of 1 less, or the vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" (if the depth "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is 1 less than the depth of the vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"). If no such vertices have been added yet, then there is no answer, since we considered the vertices in order of increasing depth. Time complexity of adding each vertex is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The resulting tree is also the desired tree. Time complexity of the whole algorithm is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Code "},{"attrs":{"href":"https://codeforces.com/contest/871/submission/31368704"},"children":[{"kind":"text","text":"31368704"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/55200"}