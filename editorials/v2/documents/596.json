text":" falling right and add to the value of the subproblem "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", 1, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is another interesting case where Wilbur chooses the left tree and it falls left. In this case we calculate the expected length and multiply by the chance of this occurring, which is "},{"attrs":{"alt":"","src":"/editorial-assets/dedd0b1c8ff0e6a177e1f974785368960da77204fce402f1b9282c9e25150b0a.png"},"kind":"image"},{"kind":"text","text":". The expected length of ground covered by the trees here is just the length contributed by tree "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" falling left, which we must be careful calculating as there might be overlapping covered regions with the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"th tree falling left and the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1th tree falling right. Then we also add the value of subproblem "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", 0, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Doing this naively would take "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") time, but this can be lowered to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") by precalculating what happens when tree "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" falls left or right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We should also consider the cases that Wilbur chooses the right tree, but these cases are analogous by symmetry."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/596/submission/14290514"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":1},"children":[{"attrs":{"href":"https://codeforces.com/contest/596/problem/E"},"children":[{"kind":"text","text":"Problem E"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Solution 1"}],"kind":"strong"},{"kind":"text","text":": Suppose that "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" is a string in the query. Reverse "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and the direction of all the moves that can be made on the table. Note that starting at any point that is part of a cycle, there is a loop and then edges that go out of the loop. So, for every point, it can be checked by dfs whether the "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" can be made by starting at that point by storing what is in the cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, note that in the reversed graph, each point can only be a part of one cycle. Therefore, the total time for the dfs in a query is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"SIGMA"}],"kind":"emphasis"},{"kind":"text","text":" + |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"|). This is good enough for "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" queries to run in time."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"alt":"","src":"/editorial-assets/0d6938bffeefece10987df2aedd818e96c27c04cb57afce6fa99196ec081bfd6.png"},"kind":"image"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"SIGMA"}],"kind":"emphasis"},{"kind":"text","text":" = 10 is the number of distinct characters in the table, and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the query string for the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" th query."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/596/submission/14290517"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Solution 2"}],"kind":"strong"},{"kind":"text","text":" (Actually too slow, see comment by "},{"attrs":{"href":"https://codeforces.com/profile/waterfalls"},"children":[{"kind":"text","text":"waterfalls"}],"kind":"link"},{"kind":"text","text":" below for more details): For each string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", dfs from every node that has in degree equal to 0 in the original graph. There will be a path which leads into a cycle after which anything in the cycle can be used any number of times in "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Only every node with in degree equal to 0 has to be checked because every path which leads to a cycle is part of a larger path which starts with a vertex of in degree 0 that leads into a cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution is slower, but it works in practice since it is really hard for a string to match so many times in the table. Each query will take "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") time, but it is much faster in practice."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"alt":"","src":"/editorial-assets/7a3584a8a9e10debf1f3d37af82f7bb073163ffd820a6cc50e13469b4687e122.png"},"kind":"image"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"SIGMA"}],"kind":"emphasis"},{"kind":"text","text":" = 10 is the number of distinct characters in the table, and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the query string of the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" th query."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/21599"}