,"text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally,the answer is "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"[0]["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1]. It's obvious that we didn't miss some triangulation. And we use a triangle to split the polygon each time, so if the triangle is different then the triangulation must be different, too. So we didn't count some triangulation more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the total time complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":"), which is sufficient for this problem."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/438/problem/D"},"children":[{"kind":"text","text":"438D - The Child and Sequence"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The important idea of this problem is the property of "},{"attrs":{"alt":"","src":"/editorial-assets/98eb3c6a7f880ec07d2063bf5b533212f904b4b02e7af16d2f1f97d26cf83f71.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"attrs":{"alt":"","src":"/editorial-assets/264829f35ccecb2ab1727ba94d1512d4e752583ac27e4a51438c8d3842cd9c89.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, "},{"attrs":{"alt":"","src":"/editorial-assets/534ed50078289c65c6b963f1794cdfd5b86483d07a6d72b25edef7b9f9c0d2da.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"