asis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":") must equals the "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", because they are not connected until we add node "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we use Union-Find Set to do such procedure, and maintain the size of each connected component, then we can calculate the answer easily."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/437/problem/E"},"children":[{"kind":"text","text":"437E - The Child and Polygon"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"In this problem, you are asked to count the triangulations of a simple polygon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First we label the vertex of polygon from 0 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we let "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] be the number of triangulations from vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to vertex "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". (Suppose there is no other vertices and there is an edge between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"