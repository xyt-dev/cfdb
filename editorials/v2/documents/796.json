":"| < "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer is 10 * "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution runs in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/jsXSst"},"children":[{"kind":"text","text":"http://ideone.com/jsXSst"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"attrs":{"problemCode":"796B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/796/problem/B"},"children":[{"kind":"text","text":"796B - Find The Bone"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This is another implementation problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s create an array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" of length "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" (with initial values set to 0), and set "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 only for the positions "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" where there is a hole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is a hole at "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"  =  1, obviously, the answer is 1, because the ball must fall onto the ground before any operation is applied. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, consider each swapping operation chronologically (from the first to the last)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While doing so, we will also maintain a variable "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":", the position where the ball is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the involving cup positions be "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". There are three cases to consider:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) If "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", set "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"  =  "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) If "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", set "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":"  =  "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) Otherwise, skip the operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Make sure to stop considering any more operations if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equals 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After this procedure, "},{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" will be the final answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution runs in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/YD7s4S"},"children":[{"kind":"text","text":"http://ideone.com/YD7s4S"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"NOTE: If you get TLE, use faster input methods. For example, use scanf instead of cin."}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"attrs":{"problemCode":"796C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/796/problem/C"},"children":[{"kind":"text","text":"796C - Bank Hacking"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First, note that the input graph is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" be the greatest value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (that is, "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")). Observe that the answer can be "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1, or "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 2 only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Why? It is because each bank’s strength can be increased at most twice, once by a neighboring bank, and once by a semi-neighboring bank. So the strength required to hack bank "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is at most "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 2, regardless of the sequence of banks you choose to hack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, suppose "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is the first bank we would hack first. We would need a computer with strength at least "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to hack it. Let the neighboring banks of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" be "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We would need a computer with strength at least "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" + 1 to hack those banks. And for each bank "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" not yet hacked, we can hack them with a computer with strength at least "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For simplicity, add 2 to all the banks’ strengths. Let’s maintain a map data structure to keep track of number of times some value of strength occurs. Again, suppose we would start by hacking bank "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". Now, we would need a computer with strength at least "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 2 to hack it. For the neighboring banks "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", it would be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1. For other banks "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", it would be "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a fixed bank "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", you can iterate through its neighboring banks, and update the map data structure accordingly. Keep track of the maximum value that occurs, and update the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can simply iterate through banks "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to start with, and get the final answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But wait. Won’t it work in "},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":" or something like that?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No. Let’s analyze the runtime carefully. (You can skip this if you know why. This is for beginners.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose we choose bank "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" to start with. We have to iterate through its neighboring banks. The number of the banks neighboring to "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" is equal to the degree of bank "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". We would need "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1 + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") operations for bank "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By iterating through all possible "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", we will perform "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + ... + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") operations. You can see that if there are "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" edges in a graph, the degrees of all nodes sum to 2"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Trees have "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 edges, so "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + ... + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"  =  2("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1)  =  2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2  =  "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Therefore, we need to perform only "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") operations. However, each operation involves the map data structure, so the overall runtime is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":". Be aware that the use of hash map could bring the runtime to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Looking more closely, we can also keep track of the occurrences of only "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 2, and no other values. So, although not required to get AC, we can get rid of the map data structure, and therefore eliminate the logarithmic factor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The official solution provided here runs in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/B9pjyi"},"children":[{"kind":"text","text":"http://ideone.com/B9pjyi"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"NOTE: If you get TLE, use faster input methods. For example, use scanf instead of cin."}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"attrs":{"problemCode":"796D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/796/problem/D"},"children":[{"kind":"text","text":"796D - Police Stations"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"A greedy solution shutting down either every d roads or when a police station is encountered, although seems pretty nice, turns out to be incorrect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider performing a breadth first search (BFS) with “cities with a police station” as starting vertices, and shutting down the road when it leads to a visited vertex (city). This will leave every bad city connected (either directly or indirectly) with one of its nearest police stations, and thus will not break the law."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"With this method, you can see that exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ - 1 roads will be shut down (where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ is the number of cities that have a police station in them). Suppose this is not optimal, and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 0) roads can be shut down. The tree will break into "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" + 1 components, while there are only "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ cities with a police station, so this is a contradiction, since there will be at least one component without any police station. Hence, shutting down "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"’ - 1 roads is optimal."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/nlPVW0"},"children":[{"kind":"text","text":"http://ideone.com/nlPVW0"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"attrs":{"problemCode":"796E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/796/problem/E"},"children":[{"kind":"text","text":"796E - Exam Cheating"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This problem can be solved using dynamic programming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, observe that it is never suboptimal to look as many consecutive questions as possible. That is, just look "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" consecutive questions whenever you decide to glance, unless it exceeds the corner (question "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"] denote the number of questions you can get correct by considering questions 1 to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" by glancing exactly "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" times with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" being the number of remaining questions that can be looked at as a benefit of the previous glances. As stated before, it is optimal to look as many consecutive questions as possible, so when we decide to look, we share this benefit (of looking) to the next questions too, and it are stored in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", which denote how many of the next consecutive questions can be looked without paying one more glance. The answer can be calculated in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"npk"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"). (You can see in the code as to how.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, "},{"children":[{"kind":"text","text":"npk"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" can be up to (1000) * (1000) * (50) * (50)  =  2, 500, 000, 000, so the solution will not fit in the time limit of 2 seconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This can be improved. Observe that if "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" > 2 * "},{"children":[{"kind":"text","text":"ceil"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), you can look at all questions on both geniuses’ answer sheets, so the answer can be found in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") (or you can just set "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" to 2 * "},{"children":[{"kind":"text","text":"ceil"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") and run the dynamic programming). By eliminating this case, the running time for dynamic programming will become "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"npk"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"). This, indeed, will fit in time, as "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is only (1000) * (1000) * (50)  =  50, 000, 000."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Problem with memory limit might still persist, so you will need to optimize the use of memory. For example, since you need only "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1][..][..][..] and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"][..][..][..] when calculating "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"][..][..][..], you could remember only the two last rows. The memory use will be much smaller. The use of short data type (instead of int) may also help."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please see the commented code for more details."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/cwP55b"},"children":[{"kind":"text","text":"http://ideone.com/cwP55b"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"attrs":{"problemCode":"796F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/796/problem/F"},"children":[{"kind":"text","text":"796F - Sequence Recovery"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First, let’s find the maximum value each integer can be. Chronologically considering the operations, you can see that once an integer is involved in type 2 operation, future type 1 operations can tell nothing about its initial value. You can find naively find the maximum value each integer can be in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":"), but that’s obviously way too slow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This can be solved using segment trees. You might be familiar with point updates and range queries, but now you have to consider point queries and range updates. No—lazy propagation is not needed. This process can be solved in "},{"attrs":{"alt":"","src":"/editorial-assets/3042e4d00c44c45524b37c785b5f5fc864a16f47fef87c303d544fccd3bdc045.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that, let each integer has its maximum possible value as its value. Go through the operations once again one by one (both type 1 and type 2), and check with another segment tree whether this sequence gives correct results for type 1 operations. If it is not, you can be sure that there is no valid sequence. Why? Let’s consider two cases. If the result is smaller than what the input says, this integer can’t really be bigger than it is (other type 1 operations needed it to be this small, or maybe type 2 operation forced it to become this value). If the result is bigger than what the input says, this happens only when there is a contradiction between type 1 and type 2 operations, and nothing can be done (because type 2 operations say so)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let’s complete the final step — make the bitwise OR maximal. You should consider 2 cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) There is more than one free integer. (Free integer is the one such that no type 1 operation limits it maximum value.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The optimal bitwise OR is simply 2"},{"children":[{"kind":"text","text":"30"}],"kind":"superscript"},{"kind":"text","text":" - 1. Just make one of the free integers 2"},{"children":[{"kind":"text","text":"29"}],"kind":"superscript"},{"kind":"text","text":" - 1 and the others 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" (any value no less than 2"},{"children":[{"kind":"text","text":"29"}],"kind":"superscript"},{"kind":"text","text":" but also no more than 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" will work). You can be sure that this is optimal. Other integers can simply remain untouched."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) Otherwise"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For case 2, for each value appearing in more than one integer of the sequence (do not consider the one without maximum value yet), you can lower one of them. Lowering more than one of them will not give a better result if you lower it in this way: sacrifice the most significant bit for ALL other less significant bits. It’s obvious that the operations remain satisfied. As for the free integer, if any, you can greedily assign some bit to it, starting from the most significant bit, but make sure that it doesn’t exceed 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" in value."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Official Implementation: "},{"attrs":{"href":"http://ideone.com/FfnJyp"},"children":[{"kind":"text","text":"http://ideone.com/FfnJyp"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"==="}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Feel free to ask any questions below. It's hard to write an editorial that satisfies the need of everyone. I hope you'll enjoy solving the problems :)"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/51527"}