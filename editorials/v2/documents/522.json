xt":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"] - 1 (уменьшать количество порций блюда). Кроме того, пусть "},{"children":[{"kind":"text","text":"unknown"}],"kind":"emphasis"},{"kind":"text","text":" — это количество пассажиров, про которых неизвестно какие точно блюда им достались (то есть для них "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0). Пусть величина "},{"children":[{"kind":"text","text":"unknownBeforeUpset"}],"kind":"emphasis"},{"kind":"text","text":" — это такое же количество, но до первого недовольного."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Таким образом, есть два основных случая:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"недовольных пассажиров нет вообще, тогда блюдо "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" могло закончится тогда и только тогда, когда "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"unknown"}],"kind":"emphasis"},{"kind":"text","text":" (жадно отдаем это блюдо всем пассажирам, для кого их точное блюдо неизвестно),"}],"kind":"list_item"},{"children":[{"kind":"text","text":"недовольный пассажир есть, этот случай разберем подробнее."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Каким блюдом мог быть недоволен первый из таких пассажиров? Очевидно из списка кандидатов надо выкинуть все такие блюда, которые упоминаются не раньше него (значит, что они закончится до него не могли). Из оставшегося набора блюд достаточно перебрать все блюда и проверить могли ли они закончиться до этого пассажира. То есть блюдо "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" могло быть тем блюдом, что привело в недовольство первого недовольного, если одновременно верно:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"это блюдо "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" не упоминается на этом пассажире или позже,"}],"kind":"list_item"},{"children":[{"kind":"text","text":"это блюдо "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" такое, что "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"unknownBeforeUpset"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Для всех таких блюд, очевидно, в ответе должно стоять "},{"children":[{"kind":"text","text":"Y"}],"kind":"inline_code"},{"kind":"text","text":" (они могли закончится к Поликарпу). Кроме того, из всех таких блюд наибольшую степень свободы дает блюдо с наименьшим расходом (количеством порций b[i]). Выберем именно такое блюдо и в остаток пассажиров с неизвестным блюдом "},{"children":[{"kind":"text","text":"restUnknown"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"unknown"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"minFirstFinished"}],"kind":"emphasis"},{"kind":"text","text":"] попробуем поместить все вхождения каждого из других блюд. То есть блюдо "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" могло закончится до Поликарпа тогда и только тогда, если для него "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ "},{"children":[{"kind":"text","text":"restUnknown"}],"kind":"emphasis"},{"kind":"text","text":" (то есть закончилось то блюдо, что расстроило первого из недовольных, а следом — "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-е)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Такое решение работает за "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Пример решения: "},{"attrs":{"href":"https://codeforces.com/contest/522/submission/10212686"},"children":[{"kind":"text","text":"10212686"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/522/problem/D"},"children":[{"kind":"text","text":"522D - Closest Equals"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Воспользуемся тем, что задача задана в офлайн-формулировке, то есть все запросы можно считать до нахождения ответов на них."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Пройдем слева направо по массиву и составим новый массив "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", записав в "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] расстояние до ближайшего слева парного "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-му элементу значения, то есть "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]] = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. Если такового нет, то запишем в ячейку бесконечность."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Эти значения соответствуют расстояниям между парными элементами и записаны они в позициях правых элементов в этих парах."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"При рассмотрении запроса на отрезке ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] нам не нужны вообще такие пары, что начинаются левее "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", а минимум надо искать среди пар, что заканчиваются не правее "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Отсортируем все запросы по "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" слева направо. Тогда при прохождении по запросам можно поддерживать, что для запроса ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] в массиве "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" установлены бесконечности для всех пар, в которых левый элемент левее "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":". Для этого просто предподсчитаем для каждого элемента ближайший справа парный "},{"children":[{"kind":"text","text":"next"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] (то есть верно, что "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"next"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]] = "},{"children":[{"kind":"text","text":"next"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"), и при покидании ячейки "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" будем записывать в "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"next"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]] значение бесконечность."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"В таком случае, для ответа на запрос ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] надо просто найти минимум на префиксе до индекса "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" включительно по массиву "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Это можно делать быстро разными способами (дерево отрезков, дерево Фенвика)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Асимптотическая временная сложность такого решения составляет "},{"attrs":{"alt":"","src":"/editorial-assets/5492d48d57341c9fa9cdd00d68e0f7ed0b0045ffaa889b5b97bd5069238b0c5f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","tex