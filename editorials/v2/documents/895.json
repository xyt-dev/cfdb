ext":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://ideone.com/VfEMOp"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/895/problem/D"},"children":[{"kind":"text","text":"895D - String Mark"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Suppose that we can calculate the function "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":") equal to the number of permutations of the string "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" strictly less than "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Then the answer is "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":") - 1. Now we need to understand how to find "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"). First we should count the number of occurrences of each letter in the string "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"[26].Than we can iterate through the position of the first different symbol in the permutation "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and the string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and update the number of remaining symbols "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"[26]. For each such position, we need to iterate through the symbol in the permutation of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" which will stand in this position. It must be less than the character at this position in the "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" string. For each such situation we can calculate and add to the answer the number of different permutations that can be obtained using symbols not currently involved. Their number is stored in "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"[26]. In its simplest form, this solution works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the size of the alphabet. Such a solution can't pass the tests, but it can be optimized to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), and that is enough to solve the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the size of alphabet."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://ideone.com/fjz8E0"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"},{"kind":"text","text":"'s "},{"attrs":{"href":"https://codeforces.com/contest/895/submission/32695728"},"children":[{"kind":"text","text":"solution"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/895/problem/E"},"children":[{"kind":"text","text":"895E - Eyes Closed"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each position we need to maintain mathematical expectation of the value on it. Initially, for position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", it is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]. Let's process the query of the first type. Each number from the interval ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1] remains on its place with probability ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1) / ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1 + 1). The probability that it will be replaced by a number from ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"2] is 1 / ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1 + 1). The mathematical expectation of the number to which it will be replaced is the arithmetic mean of sum of the mathematical expectation of numbers in ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"2], let it be "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Then, to update the expectation of a number from ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1], we need to multiply it by ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1) / ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1 + 1) and add "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" / ("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"1 + 1) to it. That is, the query of the first type is reduced to the query multiplying all the numbers in a segment and adding to them a number. To process the second type query, you must find the sum of the numbers in the segment. All these queries can be processed with the help of segment tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"))"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://ideone.com/nGpGqY"},"children":[{"kind":"text","text":"Solution"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"},{"kind":"text","text":"'s "},{"attrs":{"href":"https://codeforces.com/contest/895/submission/32695726"},"children":[{"kind":"text","text":"solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/56028"}