text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" day. Then at the noon of the "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"th"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" day, the box will contain "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" bacteria. So the answer is the number of ones in the binary form of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/579/submission/13053439"},"children":[{"kind":"text","text":"code of author's friend: this"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/579/B"},"children":[{"kind":"text","text":"Problem 2 : Finding Team Member"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sort all possible combinations from high strength to low strength. Then iterator all combinations. If two people in a combination still are not contained in any team. then we make these two people as a team."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/579/submission/13053526"},"children":[{"kind":"text","text":"author's code: this"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/A"},"children":[{"kind":"text","text":"Problem 3 : A Problem about Polyline"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"If point ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") is located on the up slope/ down slope of this polyline. Then the polyline will pass the point ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":",0)/("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":",0).(we call ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") or ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") as "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" afterwards) And we can derive that "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" / (2 * "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") should be a positive integer. Another condition we need to satisfy is that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" must be larger than or equal to "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". It’s easy to show that when those two conditions are satisfied, then the polyline will pass the point ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally speaking in math : Let "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" / (2 * "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" Then we have "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" / (2 * "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") ≥ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" and we want to find the maximum integer "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". After some more math derivation, we can get the answer is "},{"attrs":{"alt":"","src":"/editorial-assets/980521b5d032e1d7e38bd50d2031ca3467ba69aa81ed349b910d20e15c8e7201.png"},"kind":"image"},{"kind":"text","text":". Besides, the only case of no solution is when "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In fact, "},{"attrs":{"alt":"","src":"/editorial-assets/0f960f914726d49b04a75c515b53bab71dac02edd94b77155271ab24c257ab87.png"},"kind":"image"},{"kind":"text","text":" always dosn't exist or larger than "},{"attrs":{"alt":"","src":"/editorial-assets/f82f424e522da3fd23bae5675ee2ff6fe3f6e89bf7c0183e8e438a690c36b815.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"author's code:"}],"kind":"paragraph"},{"kind":"code_block","text":"#include <bits/stdc++.h>\ntypedef long long LL;\nusing namespace std;\nint main(){\n    LL a,b;\n    cin>>a>>b;\n    if(a<b)puts(\"-1\");\n    else printf(\"%.12f\\n\",(a+b)/(2.*((a+b)/(2*b))));\n    return 0;\n}\n\n"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/B"},"children":[{"kind":"text","text":"Problem 4 : Or Game"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"We can describe a strategy as multiplying "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" times so "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will become "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" and sum of all "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be equals to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". The fact is there must be a "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equal to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and all other "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equals to 0. If not, we can choose the largest number "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in sequence "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", and change the strategy so that "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and all other "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0. The change will make the highest bit 1 of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" become higher so the "},{"children":[{"kind":"text","text":"or"}],"kind":"emphasis"},{"kind":"text","text":"-ed result would be higher."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After knowing the fact, We can iterator all number in sequence a and multiply it by "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" and find the maximum value of our target between them. There are several method to do it in lower time complexity. You can check the sample code we provide.(I believe you can understand it quickly.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"author's code:"}],"kind":"paragraph"},{"kind":"code_block","text":"#include<cstdio>\n#include<algorithm>\nusing namespace std;\nconst int SIZE = 2e5+2;\nlong long a[SIZE],prefix[SIZE],suffix[SIZE];\nint main(){\n    int n,k,x;\n    scanf(\"%d%d%d\", &n, &k, &x);\n    long long mul=1;\n    while(k--)\n        mul *= x;\n    for(int i = 1; i <= n; i++)\n        scanf(\"%I64d\", &a[i]);\n    for(int i = 1; i <= n; i++)\n        prefix[i] = prefix[i-1] | a[i];\n    for(int i = n; i > 0; i--)\n        suffix[i] = suffix[i+1] | a[i];\n    long long ans = 0;\n    for(int i= 1; i <= n; i++)\n        ans = max(ans, prefix[i-1] | (a[i] * mul) | suffix[i+1]);\n    printf(\"%I64d\\n\",ans);\n}\n"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/C"},"children":[{"kind":"text","text":"Problem 5 : Weakness and Poorness"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let "},{"attrs":{"alt":"","src":"/editorial-assets/9bae75a630732946855ebbd81ce86094ea66842a80d741c6d9a8fb2be35afbfd.png"},"kind":"image"},{"kind":"text","text":", we can write down the definition of poorness formally as"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/7dd6947284aa19748c41a8dc034d6b5df85f86751eeb401cce4eb3da93779942.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":". It's easy to see that "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" is a strictly decreasing function of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is a strictly increasing function of x. Thus the minimum of "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") can be found using binary or ternary search. The time complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/401bc63b756a448d159ae5d906e4424f608d2d96447ca1985074ee0f17338330.png"},"kind":"image"},{"kind":"text","text":","}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now here give people geometry viewpoint of this problem:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"let "},{"attrs":{"alt":"","src":"/editorial-assets/bcd2bfd0f440b0c49a7e7847cfd1fdc327ecd0dabe4589dd409df161c6db8c69.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We plot "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1 straight line "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" in the plane for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 0 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can discover when you are given "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"weakness"}],"kind":"strong"},{"kind":"text","text":" will be (y coordinator of highest line at x) — (y coordinator of lowest line at x)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we only need to consider the upper convex hull and the lower convex hull of all lines. And the target x value will be one of the intersection of these convex hull."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because you can get these line in order of their slope value. we can use stack to get the convex hulls in O(n)."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/578/submission/13053708"},"children":[{"kind":"text","text":"author's code : this (using binary search)"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/578/submission/13053614"},"children":[{"kind":"text","text":"code of author's friend (using stack to handle convexhull with O(n), have more precision)"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/D"},"children":[{"kind":"text","text":"Problem 6 : LCS again"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Followings are solution in short. Considering the LCS dp table "},{"children":[{"kind":"text","text":"lcs"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"] which denotes the LCS value of first "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" characters of "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" and first "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" characters of "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":". If we know "},{"children":[{"kind":"text","text":"lcs"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1, then we only concern values in the table which "},{"children":[{"kind":"text","text":"abs"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") ≤ 1 and all value of "},{"children":[{"kind":"text","text":"lcs"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"] must be "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") or "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") - 1. So each row contains only 8 states(In fact,three states among these states will never be used), we can do dp on it row by row with time complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is another not dp method. "},{"attrs":{"href":"https://codeforces.com/blog/entry/20368#comment-251453"},"children":[{"kind":"text","text":"You can refer this comment."}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"author's code:"}],"kind":"paragraph"},{"kind":"code_block","text":"#include <bits/stdc++.h>\n#define SZ(X) ((int)(X).size())\n#define ALL(X) (X).begin(), (X).end()\n#define REP(I, N) for (int I = 0; I < (N); ++I)\n#define REPP(I, A, B) for (int I = (A); I < (B); ++I)\n#define RI(X) scanf(\"%d\", &(X))\n#define RII(X, Y) scanf(\"%d%d\", &(X), &(Y))\n#define RIII(X, Y, Z) scanf(\"%d%d%d\", &(X), &(Y), &(Z))\n#define DRI(X) int (X); scanf(\"%d\", &X)\n#define DRII(X, Y) int X, Y; scanf(\"%d%d\", &X, &Y)\n#define DRIII(X, Y, Z) int X, Y, Z; scanf(\"%d%d%d\", &X, &Y, &Z)\n#define RS(X) scanf(\"%s\", (X))\n#define CASET int ___T, case_n = 1; scanf(\"%d \", &___T); while (___T-- > 0)\n#define MP make_pair\n#define PB push_back\n#define MS0(X) memset((X), 0, sizeof((X)))\n#define MS1(X) memset((X), -1, sizeof((X)))\n#define LEN(X) strlen(X)\n#define PII pair<int,int>\n#define VPII vector<pair<int,int> >\n#define PLL pair<long long,long long>\n#define F first\n#define S second\ntypedef long long LL;\nusing namespace std;\nconst int MOD = 1e9+7;\nconst int SIZE = 1e5+10;\n// template end here\nLL dp[SIZE][8];\nchar s[SIZE];\nint get_bit(int x,int v){return (x>>v)&1;}\nint main(){\n    DRII(n,m);\n    RS(s+1);\n    REPP(i,1,n+1)s[i]-='a';\n    s[n+1]=-1;\n    REP(i,m){\n        int state=1;\n        if(i==s[1])state|=2;\n        if(i==s[1]||i==s[2])state|=4;\n        dp[1][state]++;\n    }\n    REPP(i,2,n+1){\n        REP(j,8){\n            int d[4]={i-3+get_bit(j,0),i-2+get_bit(j,1),i-2+get_bit(j,2)};\n            REP(k,m){\n                int d2[4]={};\n                REPP(l,1,4){\n                    if(s[i-2+l]==k)d2[l]=d[l-1]+1;\n                    else d2[l]=max(d2[l-1],d[l]);\n                }\n                if(d2[1]>=i-2&&min(d2[2],d2[3])>=i-1)dp[i][(d2[1]-(i-2))|((d2[2]-(i-1))<<1)|((d2[3]-(i-1))<<2)]+=dp[i-1][j];\n            }\n        }\n    }\n    printf(\"%lld\\n\",dp[n][0]+dp[n][1]+dp[n][4]+dp[n][5]);\n    return 0;\n}\n"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/E"},"children":[{"kind":"text","text":"Problem 7 : Walking!"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Since there is only one person, it’s not hard to show the difference between the number of left footprints and the number of right footprints is at most one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a particular possible time order of a sequence of footprints, if there are "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" backward steps, we can easily divide all footprints into at most "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 subsequences without backward steps. Then you might guess that another direction of the induction is also true.That is, we can combine any "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 subsequence without backward steps into a whole sequence contains at most "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" backward steps. Your guess is correct !"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we demostrate the process of combining those subsequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We only concern the first step and the last step of a divided subsequence. There are four possible combinations, we denote them as "},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"LR"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":" subsequence separately(the first character is the type of the first step and the second character is the type of the second step)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose the number of four types of subseueqnce("},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"LR"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":"/"},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":") are "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" separately. We have "},{"children":[{"kind":"text","text":"abs"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":") ≤ 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can combine all "},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":" subsequeces in turn into one subsequenceswith at most "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" - 1 backward steps(the result may be of any of the four subsquence types). Now we have at most one "},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":" type subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we can combine all "},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":" subsequence into only one "},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":" subsequence with at most "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" - 1 backward steps easily. And so do "},{"children":[{"kind":"text","text":"LR"}],"kind":"emphasis"},{"kind":"text","text":" subsequences. Now we want to combine the final "},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"LR"}],"kind":"emphasis"},{"kind":"text","text":" subsequences together. We could pick the last footprint among two subsequences, exclude it from the original subsequcne and append it at the tail of another subsequence. The move will not increase the number of backward step and the types of the two subsequences would become "},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":" ! We can easily combine them into one "},{"children":[{"kind":"text","text":"LR"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"RL"}],"kind":"emphasis"},{"kind":"text","text":" subsequence now. If there is still a "},{"children":[{"kind":"text","text":"LL"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"RR"}],"kind":"emphasis"},{"kind":"text","text":" type subsequence reamained. We can easily combine them, too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So if we can divide all footprints into the least number of subsequences without backward steps. Then we have solved the problem. And this part can be done with greedy method."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we provide one possible greedy method:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, we translate this problem to a maximum matching problem on bipartite graph as following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Take \"RLLRRL\" as example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/0e50ca8b3bbd348aac45d4f5b921463c23ed0f422fffeab12469daa3e2d0a4b5.png"},"kind":"image"},{"attrs":{"alt":" ","src":"/editorial-assets/554284820fb8e0a67118a66919ae42821b1c0555332b1c8bb5739ba971bb3ea1.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We split each footprint into two vertices which on is in left part and another is in right part."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If two footprints is next to each other in resulted subsequnces, we will connect the left vertex of the former to right vertex of the latter in the corresponded matching. So the matching described in above left graph is subsequences: \"RL-R--\" and \"--L-RL\" and in above right graph is \"RL-R-L\" and \"--L-R-\". we can find that the number of subsequences is (number of footprints) — (value of matching)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Due to the graphs produced by this problem is very special, we can solve this bipartite matching as following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iterate each vertex in left part from top to bottom and find the uppermost vertex which is able to be matched in right part and connect them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we process this algorithm in \"RLLRRL\", the resulted matching is the above right graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Why the greedy method is correct? we can prove it by adjusting any maximum matching to our intended matching step by step. In each step, you can find the uppermost vertex the state of which is different to what we intend and change its state. I guess the mission of adjusting is not too hard for you to think out! Please solve it by yourself >_<"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By the way, I believe there are also many other greedy methods will work. If your greedy method is different to author's. Don't feel strange."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/578/submission/13053747"},"children":[{"kind":"text","text":"author's code: this"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/problemset/problem/578/F"},"children":[{"kind":"text","text":"Problem 8 : The Mirror Box"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we view the grid intersections alternatively colored by blue and red like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/53c7aea114baa6c282cab7da6397477508da296ccbdd34c576f7865501d400bf.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we know that the two conditions in the description are equivalent to a spanning tree in either entire red intersections or entire blue dots. So we can consider a red spanning tree and blue spanning tree one at a time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can use disjoint-sets to merge connected components. Each component should be a tree, otherwise some grid edges will be enclosed inside some mirrors. So for the contracted graph, we would like to know how many spanning trees are there. This can be done by "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Kirchhoff%27s_theorem"},"children":[{"kind":"text","text":"Kirchhoff’s theorem"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since there are at most 200 broken mirrors, the number of vertices in the contracted graph should be no more than 401. Hence a "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") determinant calculation algorithm may be applied onto the matrix."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/578/submission/13053777"},"children":[{"kind":"text","text":"author's code: this"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/20368"}