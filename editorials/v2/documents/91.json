sis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":". Now for every position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" using binary search let's find j ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"), that "},{"children":[{"kind":"text","text":"Min"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Min"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" >  = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"{"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"}. For such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" there are no walruses who have age younger then walrus "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". It's obviously because "},{"children":[{"kind":"text","text":"Min"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the minimum on ["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"]. If there is no such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" then print  - 1 else print "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1."},{"kind":"line_break"}],"kind":"paragraph"},{"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Problem E(div2), C(div1)"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"line_break"},{"kind":"text","text":"We will count the number of ski bases including the base consisted of empty subset of edges (before printing just subtract one). In the beginning the number of bases is equal to 1. If we connect vertexes in the same connected components then the result should be multiplied by 2 else do nothing. You should use DJS data structure to know information about connected components where vertexes are and to unite them."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Why is it correct?"},{"kind":"line_break"},{"kind":"text","text":"To prove it we will use the matrix of incidence "},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":", rows in it will be edges and columns will be vertexes. Let's define "},{"children":[{"kind":"text","text":"xor"}],"kind":"emphasis"},{"kind":"text","text":" of two rows. "},{"children":[{"kind":"text","text":"Xor"}],"kind":"emphasis"},{"kind":"text","text":" of two rows "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" will be row "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" xor "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Notice if  "},{"children":[{"kind":"text","text":"xor"}],"kind":"emphasis"},{"kind":"text","text":" of some subset of rows is equal to a zero row then this subset form the ski base. It's correct because, the degree of contiguity of every vertex is even, so we can form an Euler cycle in every connected component. The answer is  2"},{"kind":"superscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"rank"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":")). "},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Why it is correct? Let's write the number of edge from the right of each row which suit this row. While finding the matrix rank using gauss method with "},{"children":[{"kind":"text","text":"xor"}],"kind":"emphasis"},{"kind":"text","text":" operation, we will "},{"children":[{"kind":"text","text":"xor"}],"kind":"emphasis"},{"kind":"text","text":" the subsets from the right of the strings. In the end the subsets of edges written from the right of the zero rows will form the basis of the linear space. Thats why we can take any subset of vectors from basis and make up a new ski base. The number of these subsets is equal to 2"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" = 2"},{"kind":"superscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"rank"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"I"}],"kind":"emphasis"},{"kind":"text","text":")), where k is the number of zero rows."}],"kind":"paragraph"},{"children":[{"kind":"line_break"},{"kind":"text","text":"The last thing we should notice that the adding row is liner depended if and only if there is exist a way between the vertexes "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" are the ends of the adding edge)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Задача D(div1)"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"line_break"},{"kind":"text","text":"Let's find all cycles in substitution:"},{"kind":"line_break"},{"kind":"text","text":"1 2 3 4 5 ..."},{"kind":"line_break"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"subscript"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"5"}],"kind":"subscript"},{"kind":"text","text":" ..."},{"kind":"line_break"},{"kind":"text","text":"For example, in sequence "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = {2, 1, 4, 5, 3} exist two cycles with length 2 and 3 on positions 1 2 and 3 4 5 respectively. If the length of the cycle is more than 5, then we can take 5 consecutive elements and make a new order in such way that 4 elements will take their places where they should be in sorted array. In common: if we take "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" elements in a cycle of length more than "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", the we can make a new order in such way that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" - 1 elements  will take their places where they should be in sorted array. If the cycle length is "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" we can sort all the elements taking "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" elements from it. Next in the analysis I will define length of a cycle as a real length of a cycle - 1 (now I can say that if we take "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" consecutive elements then "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" - 1 will take the right places)."},{"kind":"line_break"},{"kind":"text","text":"We also can take some elements in one and some elements in other cycles. We can make up division numbers from 2 to 5 into a sum to see how we can use them: 5, 4, 3, 2, 2 + 3, 2 + 2. We can take, for example, three elements in one cycle and two in other, their sizes were reduced by 2 and 1."},{"kind":"line_break"},{"kind":"text","text":"The task now is to get all cycle lengths equal to zero. Let's to suppose that an optimal solution have four operations which decrease the same cycle length by one. We will work with operations of 5 elements and which are not process the same cycle except one, because it's more stronger condition."},{"kind":"line_break"},{"kind":"text","text":"Such operation can be shown as a table where rows are operations, columns are cycles and cells of table are the values on which cycles will be reduced."},{"kind":"line_break"},{"kind":"text","text":"a    b   c    d    e"},{"kind":"line_break"},{"kind":"text","text":"1    2"},{"kind":"line_break"},{"kind":"text","text":"1        2"},{"kind":"line_break"},{"kind":"text","text":"1              2"},{"kind":"line_break"},{"kind":"text","text":"1                   2 "},{"kind":"line_break"},{"kind":"text","text":"Replace operations this way:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c    d    e"},{"kind":"line_break"},{"kind":"text","text":"4"},{"kind":"line_break"},{"kind":"text","text":"      2   1"},{"kind":"line_break"},{"kind":"text","text":"           1    2"},{"kind":"line_break"},{"kind":"text","text":"                       2"},{"kind":"line_break"},{"kind":"text","text":"The number of operations was not increased, but now we can see that if there is an optimal solution where one cycle reduced by one four times then there is an optimal solution where no cycles reduced by one four times. Look at some other replacements:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c"},{"kind":"line_break"},{"kind":"text","text":"2    1"},{"kind":"line_break"},{"kind":"text","text":"2          1"},{"kind":"line_break"},{"kind":"text","text":"Replace by:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c"},{"kind":"line_break"},{"kind":"text","text":"4"},{"kind":"line_break"},{"kind":"text","text":"      1    1"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"and"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"a    b    c    d"},{"kind":"line_break"},{"kind":"text","text":"2    1"},{"kind":"line_break"},{"kind":"text","text":"1         2"},{"kind":"line_break"},{"kind":"text","text":"1               2"},{"kind":"line_break"},{"kind":"text","text":"Replace by:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c    d"},{"kind":"line_break"},{"kind":"text","text":"4"},{"kind":"line_break"},{"kind":"text","text":"      1   2"},{"kind":"line_break"},{"kind":"text","text":"                 2"},{"kind":"line_break"},{"kind":"text","text":"Now we can see that there is an optimal solution where no operation reducing one cycle in ways:1 + 1 + 1 + 1, 2 + 2, 1 + 1 + 2. That's why we can reduce any cycle by 4 while it's size is  >  = 4. Let's use zhe same method to prove that cycles of size 3 reduced by 3 in some optimal solution."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"a    b    c  "},{"kind":"line_break"},{"kind":"text","text":"2    1"},{"kind":"line_break"},{"kind":"text","text":"1          2"},{"kind":"line_break"},{"kind":"text","text":"Replace by:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c    d"},{"kind":"line_break"},{"kind":"text","text":"3"},{"kind":"line_break"},{"kind":"text","text":"      1    2"},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"and"}],"kind":"paragraph"},{"children":[{"kind":"line_break"},{"kind":"text","text":"a    b    c    d"},{"kind":"line_break"},{"kind":"text","text":"1    2"},{"kind":"line_break"},{"kind":"text","text":"1         2"},{"kind":"line_break"},{"kind":"text","text":"1               2"},{"kind":"line_break"},{"kind":"text","text":"Replace by:"},{"kind":"line_break"},{"kind":"text","text":"a    b    c    d"},{"kind":"line_break"},{"kind":"text","text":"3"},{"kind":"line_break"},{"kind":"text","text":"      2   1"},{"kind":"line_break"},{"kind":"text","text":"           1    2"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Now we have cycles only with size 1 or 2. Let's brute the number of operations to process like {2, 2} -  > {0, 1} (one cycle will be reduced from 2 to 1 and the other will be reduced from 2 to 0). Fix some such number and make these operations. Now we should process the maximum available operations like {2, 1} -  > {0, 0}. After it we will have no cycles or some cycles of size 1 or  some cycles of size 2. In the second case  we should do the maximum of available operations like {1, 1} -  > {0, 0} and if one cycle lasts we should do {1} -  > {0}. In the third case we should to do operations like {2} -  > {0}. Using such way we can find the optimal set of operations. We shouldn't divide cycle into a parts because it makes the number of operation bigger or the same. Stress test shows the uniting cycles will not improve the answer.  "}],"kind":"paragraph"},{"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Problem E(div1)"}],"kind":"strong"}],"kind":"paragraph"},{"children":[{"kind":"line_break"},{"kind":"text","text":"We are given the array where the value in each cell is described by the formula depends on T "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" (in geometry mean it is a line equation). Lt's divide the array in blocks of size "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" ~ "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"): [0;"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"), ["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" * 2), ["},{"children":[{"kind":"text","text":"d"}],"kind"