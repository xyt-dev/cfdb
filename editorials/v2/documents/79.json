xt":"2"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"E. "},{"attrs":{"href":"https://www.codeforces.com/contest/79/problem/E"},"children":[{"kind":"text","text":"Security System"}],"kind":"link"},{"kind":"text","text":" (writer: "},{"attrs":{"href":"https://www.codeforces.com/profile/ir5"},"children":[{"kind":"text","text":"ir5"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"heading"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Lemma."}],"kind":"strong"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"The sensors we should consider are only four sensors at the corner."},{"kind":"line_break"}],"kind":"strong"},{"children":[{"kind":"text","text":"proof"}],"kind":"emphasis"},{"kind":"text","text":": Let's think about sensors at a fixed row "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". As the definition, when Ciel entered to ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"), a sensor at ("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") decreases its count by |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"|. Let this value be "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"). If we fix Ciel's path, the total decrease of each sensor is expressed as the summation of "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" is one of the path. Because "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") is a convex function about variable "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and the fact that \"the summation of convex functions is also a convex function\", we can ignore sensors at center points: i.e. "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - 1."},{"kind":"line_break"},{"kind":"text","text":"The same thing holds true for vertical direction, so it is enough to consider only four sensors at corner: ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"), ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - 1), ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" - 1). ■"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Because we need the lexicographically first solution, we want to use 'R' rather than 'U' in each step. Thus, it is enough if we can determine whether a feasible path exists with constraints that Ciel is at ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") and the rest counts of four corners are "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"subscript"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Lemma."}],"kind":"strong"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"Optimal step is following (except sensors region):"}],"kind":"strong"},{"kind":"line_break"},{"attrs":{"alt":""},"kind":"missing_asset"},{"kind":"line_break"},{"children":[{"kind":"text","text":"proof"}],"kind":"emphasis"},{"kind":"text","text":": A following figure shows that if a blue path is good a brown path is also good. (Here, the blue path means arbitrary one, and the brown path means optimal one.) ■"},{"kind":"line_break"},{"attrs":{"alt":""},"kind":"missing_asset"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The problem is sensors region.  In sensors region, it is possible to assume that the optimal path always passes a right-top sensor."},{"kind":"line_break"},{"kind":"text","text":"While Ciel moves in sensors region to right-top sensor, the total decrease of both left-bottom and right-top sensor is constant. So we should think about only two sensors: left-top and right-bottom."},{"kind":"line_break"},{"kind":"text","text":"In addition, let the total decrease of left-top and right-bottom be "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":". Then following holds: "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"const"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The smallest value for "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" is the total decrease when Ciel moves upward then moves rightward, and the smallest value for "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" is in the same way (moves rightward  →  upward)."},{"kind":"line_break"},{"kind":"text","text":"So we can calculate the minimal value and the maximal value of "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". And actually, "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" can be an arbitrary value between them with interval of 2. A following picture shows it."},{"kind":"line_break"},{"attrs":{"alt":""},"kind":"missing_asset"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Complexity at a simulation part is O(1). Overall, the complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."},{"kind":"line_break"}],"kind":"container"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/1839"}