{"assets":[],"contestId":"2258","diagnostics":[{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <style> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"},{"code":"dropped-dangerous-subtree","message":"Dropped dangerous <script> subtree","severity":"warning"}],"document":{"children":[{"children":[{"kind":"text","text":"Sorry for underestimating the difficulties of the problems, especially B2 and D. We tried to serve as many cool problems as we could. And apparently, this led to some difficult ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thank you for participating in the round. We all hope you enjoyed all of our problems. "}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/A"},"children":[{"kind":"text","text":"2258A - Odd Eraser"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ItsNotMeItsYou"},"children":[{"kind":"text","text":"ItsNotMeItsYou"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/mychecksdead"},"children":[{"kind":"text","text":"mychecksdead"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"Think of the case $$$n=3$$$. Can you remove the first or the last number in any way?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"We cannot obtain a number larger than $$$\\gcd(a_1,a_n)$$$ because the first and last numbers in the array can't be removed. We can remove all other elements by choosing $$$[1, i, n]$$$, so the answer is $$$\\gcd(a_1, a_n)$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911115"},"children":[{"kind":"text","text":"388911115"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing   "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"    Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/B1"},"children":[{"kind":"text","text":"2258B1 - Carrot Chopdown (Easy Version)"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/mychecksdead"},"children":[{"kind":"text","text":"mychecksdead"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"What is the answer for a fixed $$$x$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Iterating over the values $$$x=1...m$$$, we can find the answer for each possible $$$x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For any $$$x$$$, the answer is the number of carrots of length greater than or equal to $$$x$$$, plus the number of carrots of length $$$2x$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911137"},"children":[{"kind":"text","text":"388911137"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/B2"},"children":[{"kind":"text","text":"2258B2 - Carrot Chopdown (Hard Version)"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/mychecksdead"},"children":[{"kind":"text","text":"mychecksdead"}],"kind":"link"},{"kind":"text","text":" (This problem was originally designed with only $$$k=2$$$; thanks to "},{"attrs":{"href":"https://codeforces.com/profile/ItsNotMeItsYou"},"children":[{"kind":"text","text":"ItsNotMeItsYou"}],"kind":"link"},{"kind":"text","text":" for expanding on the idea.)"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"Consider solving the problem for a fixed $$$x$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint2"}]},"children":[{"children":[{"kind":"text","text":"Consider solving the problem for $$$k=2$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint3"}]},"children":[{"children":[{"kind":"text","text":"What happens if $$$k$$$ is bigger than $$$18$$$? "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint4"}]},"children":[{"children":[{"kind":"text","text":"What are the optimal $$$x$$$ values for cutting?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"For target value $$$x$$$, it is optimal to use cuts in the following order: $$$x \\cdot 2^{k-1}, x \\cdot 2^{k-2}, \\ldots, x \\cdot 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each $$$i$$$, $$$a_i=2^k \\cdot x$$$ adds $$$2^k$$$ to the answer. Otherwise, the contribution is $$$\\min(\\frac{a_i}{x}, 2^k-1)$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The optimal $$$x$$$ is less than or equal to $$$\\frac{m}{2^k}$$$ (if less than $$$1$$$, it equals $$$1$$$, and the answer is basically the sum of all carrot lengths). Moreover, no $$$i$$$ can contribute more than $$$2^k$$$ to any $$$x$$$. Using prefix sum, determine the number of values contributing $$$y$$$ to the answer for each possible $$$x$$$. This solution runs in $$$\\mathcal{O}(n + m \\log m)$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911156"},"children":[{"kind":"text","text":"388911156"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/C"},"children":[{"kind":"text","text":"2258C - Far Cities"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/Seferoglu"},"children":[{"kind":"text","text":"Seferoglu"}],"kind":"link"},{"kind":"text","text":" (This problem was originally designed simply to find the furthest node from the root; thanks to "},{"attrs":{"href":"https://codeforces.com/profile/cadmiumky"},"children":[{"kind":"text","text":"cadmiumky"}],"kind":"link"},{"kind":"text","text":" for expanding on the idea. Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/robert9524"},"children":[{"kind":"text","text":"robert9524"}],"kind":"link"},{"kind":"text","text":" for providing stronger tests on cutting random solutions without an adaptive grader.)"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"How to find a diameter?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint2"}]},"children":[{"children":[{"kind":"text","text":"Consider the simplest algorithm."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"For each node, first determine whether it is closer to the first vertex than the longest distance seen so far. If not, just skip the node. This uses $$$n-1$$$ queries. Otherwise, while the query returns true, increase the queried distance by one. This can happen up to $$$n-1$$$ times. We can find one end of the diameter by running $$$2n - 2$$$ queries in total. Then repeat the process to find the other end of the diameter. This yields a total of $$$4n-4$$$ queries. But, as previously written, distance can increase at most $$$n-1$$$ times. So this yields a total of $$$3n-3$$$ queries."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911205"},"children":[{"kind":"text","text":"388911205"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/D"},"children":[{"kind":"text","text":"2258D - Magic Tiles"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ItsNotMeItsYou"},"children":[{"kind":"text","text":"ItsNotMeItsYou"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"What happens when a range includes another?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint2"}]},"children":[{"children":[{"kind":"text","text":"A range that is included by another range is useless. What happens when we remove all such useless ranges?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint3"}]},"children":[{"children":[{"kind":"text","text":"We only need to solve the problem for chains of ranges. How?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"In this editorial we will use BigIntegers, which are simple vectors, and addition and comparison is $$$\\mathcal{O}(n)$$$. It can be proven that if one range includes another, we can remove the other. Also, it can be proven that only start and endpoints of the intervals are important, and let them be $$$pts$$$. Well-known $$$\\mathcal{O}(n^3)$$$ dp exists; $$$dp_i$$$ means the maximum score if we fill all of the rows through $$$pts_i$$$; $$$dp_i=\\max dp_j + 100^{100^{i-j}}$$$ if there is an interval that covers interval $$$[j, i)$$$. Because there are only $$$2$$$ columns, it can be proven that this solution works in $$$\\mathcal{O}(n^2)$$$. From another perspective, you can imagine you have chains. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911243"},"children":[{"kind":"text","text":"388911243"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Challenge"}]},"children":[{"children":[{"kind":"text","text":"Can you solve for bigger constraints, such as $$$n,m \\le 2 \\cdot 10^5$$$? Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/dinohaur"},"children":[{"kind":"text","text":"dinohaur"}],"kind":"link"},{"kind":"text","text":" for the code: "},{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911329"},"children":[{"kind":"text","text":"388911329"}],"kind":"link"},{"kind":"text","text":" "}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Answer"}]},"children":[{"kind":"text","text":" With using faster BigIntegers, you can solve in $$$\\mathcal{O}(n \\log n)$$$. For more info: "},{"attrs":{"href":"https://codeforces.com/problemset/problem/464/E"},"children":[{"kind":"text","text":"https://codeforces.com/problemset/problem/464/E"}],"kind":"link"}],"kind":"spoiler"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/E"},"children":[{"kind":"text","text":"2258E - DivMEX"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ItsNotMeItsYou"},"children":[{"kind":"text","text":"ItsNotMeItsYou"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/carcinisation"},"children":[{"kind":"text","text":"carcinisation"}],"kind":"link"},{"kind":"text","text":" (This problem was actually designed differently. Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/anpaio"},"children":[{"kind":"text","text":"anpaio"}],"kind":"link"},{"kind":"text","text":" for this version.)"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint1"}]},"children":[{"children":[{"kind":"text","text":"What kind of integers can exist as an $$$f(l,r)=x$$$ value?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint2"}]},"children":[{"children":[{"kind":"text","text":"How to check a value $$$x$$$ exists as a $$$f(l,r)$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"It can be seen that each value of $$$f$$$ must satisfy $$$f(l,r) \\leq \\text{smallest prime power bigger than n}$$$; for each $$$x$$$ that satisfies this constraint, we will try to check whether this value can be obtained or not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A range that satisfies $$$f(l,r)=x$$$ can't contain a multiple of $$$x$$$; otherwise, the set of divisors would have $$$x$$$ in it. When considering multiples of $$$x$$$ as obstacles, we realize that it is optimal to greedily select between two consecutive obstacles. Hence, at each obstacle, we check whether every number $$$y$$$ that satisfies $$$1 \\leq y \\le x$$$ appears as a factor of any integer between this and the previous obstacle. This solution works in $$$\\mathcal{O}(( \\sum_{i=1}^n |S_i|) \\cdot n$$$. Where $$$S_x$$$ represents the prime powers of $$$x$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To optimize this solution, we iterate over all $$$a_i$$$ and check every factor of $$$a_i$$$, considering the index $$$i$$$ as an obstacle. In order to verify that every element smaller than $$$x$$$ is present between this and the previous obstacle, use a minimum segment tree. This solution works in $$$\\mathcal{O}(( \\sum_{i=1}^n |S_i|) \\log n) \\le \\mathcal{O}(n \\log^2 n)$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code (anpaio)"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911266"},"children":[{"kind":"text","text":"388911266"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/problem/F"},"children":[{"kind":"text","text":"2258F - Plus Minus Tree"}],"kind":"link"},{"kind":"text","text":" Idea: "},{"attrs":{"href":"https://codeforces.com/profile/ItsNotMeItsYou"},"children":[{"kind":"text","text":"ItsNotMeItsYou"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Consider $$$\\mathcal{O}(n^2)$$$ $$$dp[v][\\text{#1's count in subtree of v}]$$$ using the merging subtrees technique. The dp is convex because we are adding only two convex functions, resulting in a convex function. Then, using small to large, you can achieve $$$\\mathcal{O}(n \\log^2 n)$$$ complexity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To elaborate: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$\\mathcal{O}(n^2)$$$, you can keep dp as pairs for simplicity: $$$(\\text{score of v}, \\text{minimum score})$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As can be seen in the vector, scores are increasing by $$$2$$$. So you can keep dp with the vector's first element and then with the differences. When you merge two children's subtrees, you are basically doing a Minkowski sum, which is just updating the first element as $$$\\text{(lhs[0].first + rhs[0].first, lhs[0].second + rhs[0].second})$$$, and merging the differences. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, for each point added to $$$|x|$$$, you must add $$$+2$$$ or $$$-2$$$ ($$$2$$$ due to parity) for all differences split by $$$0$$$ (be careful not to add any difference to $$$[-1, +1]$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can maintain two sets for each vertex, resulting in $$$\\mathcal{O}(n \\log^2 n)$$$ complexity from small to large. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911297"},"children":[{"kind":"text","text":"388911297"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Alternative Solution"}]},"children":[{"children":[{"kind":"text","text":"First, identify all nodes in the tree with an initial value of zero, set them to one, and store them in a candidate list. Then, until the list is completely empty, select the most advantageous node at each step. For each node, we trace the path up to the root, counting how many nodes along that path have a subtree sum greater than one ($$$\\text{pos}$$$) and how many have a subtree sum less than one ($$$\\text{neg}$$$), thereby calculating a score based on the difference $$$\\text{pos} - \\text{neg}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After finding the node with the highest score among the list, select it, change its value to minus one, and decrease the subtree sums of all ancestors along the path from the chosen node to the root by two. We repeat this process until all special nodes are processed and the list is empty. And you can fasten this algorithm by HLD. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\mathcal{O}(n^3)$$$ code by "},{"attrs":{"href":"https://codeforces.com/profile/anpaio"},"children":[{"kind":"text","text":"anpaio"}],"kind":"link"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911953"},"children":[{"kind":"text","text":"388911953"}],"kind":"link"},{"kind":"text","text":" $$$\\mathcal{O}(n \\log^2 n)$$$ code by "},{"attrs":{"href":"https://codeforces.com/profile/anpaio"},"children":[{"kind":"text","text":"anpaio"}],"kind":"link"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/2258/submission/388911806"},"children":[{"kind":"text","text":"388911806"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem"}]},"children":[{"children":[{"kind":"text","text":"Amazing  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Ok  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Terrible  "},{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  "}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/156316"}