xt":" и "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". Таким образом, ответ равен "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" или 0, если "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" или "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" не нашлось или "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/523/problem/D"},"children":[{"kind":"text","text":"523D - Statistics of Recompressing Videos"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Для эффективной реализации алгоритма моделирования процесса необходимо хранить в какой-то структуре "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" отсортированные моменты освобождения каждого из серверов. Сначала "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" состоит "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" единиц."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Будем обрабатывать ролики последовательно в хронологическом порядке. Для того, чтобы начать обрабатывать очередной "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-й надо дождаться освобождения какого-либо сервера. Пусть ролик приходит в момент "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" и имеет длительность "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"