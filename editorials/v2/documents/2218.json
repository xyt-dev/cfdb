_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard contest"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible contest"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/A"},"children":[{"kind":"text","text":"A — The 67th Integer Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Many solutions exist here, and they are all trivial to find. Consider the value of $$$\\min(x, y)$$$ when $$$x$$$ is constant, and you vary $$$y$$$. When $$$y \\gt = x$$$, the value is $$$x$$$, and when $$$y \\lt x$$$ the value is $$$y$$$. Therefore, the largest that $$$\\min(x, y))$$$ can get for any value of $$$y$$$ is $$$x$$$. Therefore, outputting $$$y$$$ as any integer greater than or equal to $$$x$$$ works. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A common mistake was to output $$$y=x+1$$$, which fails because $$$68$$$ is greater than $$$67$$$, therefore not a valid output. "}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for _ in range(int(input())):\n    print(67)\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/B"},"children":[{"kind":"text","text":"B — The 67th 6-7 Integer Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Note how negating 6 out of 7 numbers is equivalent to negating all of them, and then negating one out of 7 numbers. Therefore, you can negate all 7 numbers, and then negate the least one afterwards."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for i in range(int(input())):\n    nums = list(map(int, input().split()))\n    print(2 * max(nums) - sum(nums))\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/C"},"children":[{"kind":"text","text":"C — The 67th Permutation Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Observe that the position of an element doesn't really matter: we are only interested in whether an element is a median, a large element or a small element (in its triple). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since $$$3n$$$ has no elements larger than it, it must be a large element. Similarly, since $$$1$$$ has no elements smaller than it, it must be a small element. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To maximise the sum of medians, we should pick the largest possible median available, which is $$$3n-1$$$. Since $$$1 \\lt 3n-1 \\lt 3n$$$, this forms a valid triple. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we can repeat the process on the subset $$${2, 3, ... 3n-2}$$$, yielding the construction"}],"kind":"paragraph"},{"kind":"text","text":"$$$\\{1, 3n-1, 3n\\}, \\{2, 3n-2, 3n-3\\}, \\cdots , \\{n, 2n-1, 2n\\}$$$ "},{"attrs":{"title":[{"kind":"text","text":"Proof that this is optimal"}]},"children":[{"children":[{"kind":"text","text":"Let the $$$i^{th}$$$ triple be $$${l_i, m_i, r_i}$$$, with $$$l_i \\lt m_i \\lt r_i$$$, and wlog let $$$m_1 \\lt m_2 \\lt \\cdots \\lt m_n$$$ be the $$$n$$$ medians. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each median needs an element strictly larger than it not used in any other triple. So there should be at least $$$1$$$ element larger than $$$m_n$$$, at least $$$3$$$ elements larger than $$$m_{n-1}$$$ (namely $$$m_n$$$, $$$r_n$$$, $$$r_{n-1}$$$), and more generally, at least $$$2k - 1$$$ elements larger than $$$m_{n-k+1}$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the set $$$1 \\ldots 3n$$$, there are $$$3n - m_{n-k+1}$$$ elements larger than m_{n-k+1} (namely $$$m_{n-k+1}+1 \\ldots 3n$$$), and so we need "}],"kind":"paragraph"},{"kind":"text","text":"$$$2k-1 \\leq 3n - m\\_{n-k+1}$$$"},{"children":[{"kind":"text","text":"Rearranging, we get $$$m_{n-k+1} \\leq 3n - 2k + 1$$$, as in the optimal construction."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for _ in range(int(input())):\n    n = int(input())\n    k = 3 * n\n    for i in range(1,n+1):\n        print(i, k-1, k, end=\" \")\n        k -= 2\n    print()\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/D"},"children":[{"kind":"text","text":"D — The 67th OEIS Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Think something related to coprime numbers."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"There are many ways to construct the array — we will provide two ways to do it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's take $$$n+1$$$ distinct numbers $$$b_1,b_2,\\ldots,b_{n+1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let $$$a_i=b_i\\cdot b_{i+1}$$$ for all $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now $$$\\operatorname{gcd}(a_i,a_{i+1})=b_{i+1}\\cdot \\operatorname{gcd}(b_i,b_{i+2})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now if $$$\\operatorname{gcd}(b_i,b_{i+2})=1$$$ for all $$$i$$$, then we can obtain a distinct gcd for each adjacent pair and the construction is valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One way to obtain this is to let all $$$b_i$$$ be all primes starting from $$$2,3,5,\\ldots$$$. Since all numbers are coprime to each other, their pairwise $$$gcd$$$ is $$$1$$$ and we get a valid construction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Another way to obtain this to let all $$$b_i$$$ be odd numbers starting from $$$1,3,5,\\ldots$$$. Since $$$\\operatorname{gcd}(x,x+4)=1$$$ , where $$$x$$$ is odd, this construction is also valid."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for _ in range(int(input())):\n    n = int(input())\n    k = 1\n    for i in range(1,n+1):\n        print(k * (k+2), end=\" \")\n        k += 2\n    print()\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/E"},"children":[{"kind":"text","text":"E — The 67th XOR Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"What happens after two operations? Does the first operation matter?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Remember the propery that $$$x \\oplus x = 0$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"We have an array $$$a = [a_1, a_2, a_3, \\ldots, a_n]$$$. Suppose we performed the operations from left to right, to see how operations affect the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the first operation, the array becomes: $$$a = [a_2 \\oplus a_1, a_3 \\oplus a_1, \\ldots, a_n \\oplus a_1]$$$. Note that the first element was removed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second operation, the array becomes $$$a = [(a_3 \\oplus a_1) \\oplus (a_2 \\oplus a_1), \\ldots, (a_n \\oplus a_1) \\oplus (a_2 \\oplus a_1)]$$$. Due to Hint $$$2$$$, this is the same as $$$a = [a_3 \\oplus a_2, \\ldots, a_n \\oplus a_2]$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that this new array is independent of $$$a_1$$$. In fact, after any two operations, the value of the element chosen in the first operation does not matter. Taking this a step further: when doing three operations, the elements chosen for the first two operations do not matter. Inductively, the only thing that matters is the element we choose last for an operation (let it be $$$x$$$) and which element we never choose for an operation (let it be $$$y$$$). The final value of the array is going to be $$$x \\oplus y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since $$$n$$$ is small, it is enough to brute force all possible pairs $$$(x, y)$$$. The answer is the maximum value of $$$a_x \\oplus a_y$$$ among all pairs."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for _ in range(int(input())):\n    n = int(input())\n    a = list(map(int, input().split()))\n    m = 0\n    for i in range(n):\n        for j in range(i+1, n):\n            m = max(m, a[i] ^ a[j])\n            \n    print(m)\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Bonus"}]},"children":[{"children":[{"kind":"text","text":"The problem of finding the integers $$$a$$$ and $$$b$$$ from an array such that $$$a \\oplus b$$$ is maximized can be done in $$$O(n \\log n)$$$ using a trie. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see in detail how this would work on "},{"attrs":{"href":"https://threadsiiithyderabad.quora.com/Tutorial-on-Trie-and-example-problems"},"children":[{"kind":"text","text":"this"}],"kind":"link"},{"kind":"text","text":" post. Roughly speaking, we insert the binary representation of each number in the trie. After that, for each number we try to find which other number gives maximum xor, which can be done with a greedy walk on the trie. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/F"},"children":[{"kind":"text","text":"F — The 67th Tree Problem"}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"We know that the number of vertices in the entire tree is $$$x+y$$$. Therefore, the subtree of the root has size $$$x+y$$$. So if $$$x+y$$$ is even and $$$x$$$ is zero, there is no valid tree. Similarly, if $$$x+y$$$ is odd and $$$y$$$ is zero, there is no valid tree. From this point onwards, we can now exclude the root by decrementing either $$$x$$$ or $$$y$$$, and only considering the other vertices. The root will be trivially satisfied."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"We claim that for any vertex whose subtree has an even size, it must have at least one child with an odd size. Indeed, suppose all of its children have even size. Then the total number of vertices in the subtree will be the sum of some even numbers, plus one, the node itself. By contrapositive, this implies the desired claim."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Therefore, if the number of vertices with an even subtree size is larger than the number of vertices with an odd subtree size (excluding the root), there is no valid tree."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"All other cases are possible."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Read the hints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, we will try to make every vertex (excluding the root) have subtree size either $$$1$$$ or $$$2$$$. To do this, we will attach $$$x$$$ disjoint pairs of vertices. Then we will attach each pair, and all of the remaining vertices, to the root. Now, the number of vertices with an even subtree size is exactly $$$x$$$, the parent from each of the pairs, as desired."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"for _ in range(int(input())):\n    x, y = map(int, input().split())\n    n = x + y\n    d = y - x\n\n    if (x == 0 and n % 2 == 0) or n//2<x:\n        print(\"NO\")\n        continue\n\n    print(\"YES\")\n\n    mm = 2 * x + (d % 2)\n\n    for i in range(2, mm + 1):\n        print(i - 1, i)\n\n\n    for i in range(mm + 1, n + 1):\n        print(mm, i)\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/2218/problem/G"},"children":[{"kind":"text","text":"G — The 67th Iteration of \"Counting is Fun\""}],"kind":"link"}],"kind":"heading"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"When is there no valid $$$a$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Remember for a person $$$i$$$ with $$$b_i \\gt 0$$$ to be able to sit down, one of their neighbours already needs to be sat down."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"What do you notice about people where $$$b_i = 0$$$?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"If $$$b_i = 0$$$, then $$$a_i$$$ must also equal $$$0$$$."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"If a person $$$i$$$ with $$$b_i \\gt 0$$$ has no neighbour with a smaller $$$b_i$$$, they would never sit down so there is no valid $$$a$$$ so we output $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can observe that all $$$a_i$$$ are independent of each other so long as they are consistent with the array $$$b$$$. This means we can compute the number of possible $$$a_i$$$ for every $$$i$$$ separately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$c_t$$$ be the number of people sat down at time $$$t$$$ or earlier. This is all people where $$$b_i \\leq t$$$. For a time $$$t$$$, we can calculate $$$c_t$$$ using prefix sums as it is the sum of $$$c_{t-1}$$$ and the number of people that sit down at time $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a person to sit down at time $$$t$$$, two conditions had to be met:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"At least $$$a_i$$$ people have already sat down strictly before time $$$t$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"At least one of their neighbors (person $$$i−1$$$ or $$$i+1$$$, if they exist) has already sat down strictly before time $$$t$$$. "}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can now split people into $$$2$$$ types depending on which condition occurs first for them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Type A: Condition $$$1$$$ is satisfied first. This means they are waiting for one of their neighbours to sit down so they can sit down. A person is of this type if the earliest time one of their neighbours sat down is exactly $$$1$$$ less than the time they sat down. This means their $$$a_i$$$ can be any value between $$$1$$$ and $$$c_{t-1}$$$ inclusive so there are $$$c_{t-1}$$$ possible values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Type B: Condition $$$2$$$ is satisfied first. This means they are waiting for enough people to have sat down. A person is of this type if the time they sit down is at least $$$2$$$ greater than the earliest time one of their neighbours sat down. Since they did not sit down at time $$$t-1$$$, their $$$a_i$$$ must be greater than $$$c_{t-2}$$$. This means it must be between $$$c_{t-2}+1$$$ and $$$c_{t-1}$$$ inclusive, giving $$$c_{t-1}-c_{t-2}$$$ possibilities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can iterate over all people $$$i$$$ and look at the earliest time one of their neighbours sat down to find out which type of person they are, and then compute how many valid $$$a_i$$$ there are for them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, we can multiply the number of valid $$$a_i$$$ for every person, and output this modulo $$$676767677$$$."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code (Python)"}]},"children":[{"kind":"code_block","text":"from itertools import accumulate\nMOD = 676767677\n\nfor _ in range(int(input())):\n    n, m = map(int, input().split())\n    b = [*map(int, input().split())]\n    cnt = [0] * m\n    for i in range(n):\n        cnt[b[i]] += 1\n    p = [0, *accumulate(cnt)]\n    ans = 1\n    for i in range(n):\n        if b[i] > 0:\n            t = float(\"inf\")\n            for v in (i-1, i+1):\n                if v not in range(n): continue\n                t = min(t, b[v])\n            t += 1\n            if b[i] > t:\n                ans = ans * cnt[b[i] - 1] % MOD\n            elif b[i] == t:\n                ans = ans * p[b[i]] % MOD\n            else:\n                ans = 0\n    print(ans % MOD)\n\n"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Rate the problem!"}]},"children":[{"attrs":{"title":[{"kind":"text","text":"Quality"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Excellent problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Good problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Bad problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Horrible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Difficulty"}]},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Trivial problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Easy problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Average problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Hard problem"}],"kind":"list_item"},{"children":[{"attrs":{"href":"https://codeforces.com/data/like?action=like"},"children":[{"kind":"emphasis"},{"kind":"text","text":" "}],"kind":"link"},{"kind":"text","text":"  Impossible problem"}],"kind":"list_item"}],"kind":"list"}],"kind":"spoiler"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/152680"}