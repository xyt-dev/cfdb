n":[{"kind":"text","text":"6"}],"kind":"superscript"},{"kind":"text","text":" and store the expected score as integer number to avoid this error."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/277/problem/E"},"children":[{"kind":"text","text":"277E - Binary Tree on Plane"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no \"binary\" restriction, the solution is simple greedy. Each node of the tree (except the root) must have exactly 1 parent, and each node could be parent for any number of nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assign for each node "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (except the root) such a node "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as a parent, so that "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and distance between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is minimal possible. Renumerate all the nodes in order of non-increasing of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". Now it's clear that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" (2 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). So we've just built a directed tree with all the arcs going downwards. And it has minimal possible length. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's recall the \"binary\" restriction. And realize that it doesn't really change anything: greedy transforms to min-cost-max-flow on the same distance matrix as edge's costs, but each node must have no more than 2 incoming flow units."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/6815"}