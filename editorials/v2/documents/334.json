ind":"text","text":"2"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" = 1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lets consider all pair of natural numbers ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") so that there exist nutural number "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" so that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1. Existence of two equals such pairs is equals to existence of above four numbers. But it is can be only "},{"attrs":{"alt":"","src":"/editorial-assets/d942a27df2d2cb38053390ab83d41ee1fc62c8db0e09e58f2d1c43714a3b4008.png"},"kind":"image"},{"kind":"text","text":" such pairs. Therefore we can make the array where we will mark pair who were meets. Lets iterate all pairs in any order until we meet repeated pair or pairs are ends. So we have solution of time "},{"attrs":{"alt":"","src":"/editorial-assets/dd2c277fdcd0a684d7ecaf21f6d9057b46eef76c733bf5fec17eccbdc7315175.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/333/pro