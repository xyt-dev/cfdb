B"}],"kind":"emphasis"},{"kind":"text","text":"|, |"},{"children":[{"kind":"text","text":"BC"}],"kind":"emphasis"},{"kind":"text","text":"|)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And then lets do the follows. Lets iterate apex "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and for each "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" lets find triangle with maximal minimum of sides when "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is the apex of triangle and "},{"attrs":{"alt":"","src":"/editorial-assets/d05fefa39b858999d886c35ea67f4b2b8c8f8e8c4717040f2b0303185f985b0c.png"},"kind":"image"},{"kind":"text","text":". For it lets sort all other points by the angle relative to "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", and for each point "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" lets find point "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" most distant to "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" among such points that "},{"attrs":{"alt":"","src":"/editorial-assets/a66c032f30a049356d0294780c8f5449cf976e5aedd538c27ddb7ddf28286ae2.png"},"kind":"image"},{"kind":"text","text":". We have to use segment tree for maximum and two pointers or binary searsh to now left and right bound of possible points "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" during iterating "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, we have solution of time "},{"attrs":{"alt":"","src":"/editorial-assets/dd2c277fdcd0a684d7ecaf21f6d9057b46eef76c733bf5fec17eccbdc7315175.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/8418"}