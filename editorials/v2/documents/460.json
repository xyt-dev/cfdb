children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"), ..., ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":").Let's first "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - 1 points are fixed, and we can move last point — ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). In terms of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" we'd like to maximize"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/fdcd123017506ade0e8270e55180f3d4c6d9f842e9f8c7780ae4f4efb2a52bb8.png"},"kind":"image"},{"children":[{"kind":"text","text":"We left out all squares without "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". Maximization of this "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" function is equivalent to maximization of "}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/08110e6e7b8329fcaed11b24097edfd4bcb1f89756d2c8bf926bcd1c95fc6f5a.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/ec5ec392276f1fd8bc53ee82ba56ea1d4f308c6671b1d899a5b5491915eb3805.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/fc366cdbc8907bb59afeca83efc771f08ab36c84cc2d42a29043df77b4dd6612.png"},"kind":"image"},{"children":[{"kind":"text","text":"So, we've reduced our problem to finding the furthest integer point from "},{"attrs":{"alt":"","src":"/editorial-assets/2059999ccf8c3311d5d39a95e3536e124018c1e44b20fc0aee62a056c8d3db81.png"},"kind":"image"},{"kind":"text","text":". Now we can declare: the furthest point is placed at one vertex of convex hull of all integer points inside the circle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Proof. Let "},{"attrs":{"alt":"","src":"/editorial-assets/2059999ccf8c3311d5d39a95e3536e124018c1e44b20fc0aee62a056c8d3db81.png"},"kind":"image"},{"kind":"text","text":" be a point "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":", and the furthest integer point inside "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" (convex hull) is "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":"(obviously, it placed somewhere in convex hull). Lets extend "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":" beyond "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" to intersection with one side of polygon — let it be "},{"children":[{"kind":"text","text":"AB"}],"kind":"emphasis"},{"kind":"text","text":", and lets mark point of intersection as "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":"'. Clearly "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":"' ≥ "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":". It's easy to see, that one of angles "},{"attrs":{"alt":"","src":"/editorial-assets/6bf7921fb7f88c13793bc6362e6e665c9f0847aba04ca3284a04a14afb179bdc.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/36e5a4eb4461c8b57980f5ebdd7f3c90241542f97cc28456165f8ab1ef7ba1d7.png"},"kind":"image"},{"kind":"text","text":" is obtuse, so, according to properties of obtuse triangles on of inequalities holds: "},{"children":[{"kind":"text","text":"TA"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":"' ≥ "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"TB"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":"' ≥ "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":", so, we can replace "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", and distanse "},{"children":[{"kind":"text","text":"TX"}],"kind":"emphasis"},{"kind":"text","text":" will increase. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we can assume, that every point in optimal set belongs to the convex hull. So, solution is check all sets of points from convex hull and check values on this sets. If "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 30, then convex hull contains no more than 36 points — it's easy to check with computer. So, brute force will take "},{"attrs":{"alt":"","src":"/editorial-assets/ff7a9093317b510ea3020bbdc0757fba9cc5873c168ffd873aab248afef039d4.png"},"kind":"image"},{"kind":"text","text":" time, and it passes TL easily (depending on realizations and optimizations)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For those, who interested in realization of algorithm: at first we place convex hull to some vector(and points become ordered). After that we build recursion function with the next parameters:1) how many points in the set on this iteration 2) vector with points 3) sum "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-coordinats of points from set 4) sum of squares of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"- coordinates 5) sum of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-coordinates 6) sum of squares of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-coordinates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On each iteration we take last point from set, and trying to add all points, starting with this, and finishing on the end of convex hull — it starts new iteration of recursion. Also, we recalculate meaning of cur value in fast way using parameters 3, 4, 5 and 6."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the last iteration, when we took "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" points, we are comparing value on this set with maximal value. If maximal value is less, than cur value, then "},{"children":[{"kind":"text","text":"maxvalue"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"curvalue"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"bestvector"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"cursetofpoints"}],"kind":"emphasis"},{"kind":"text","text":". After recursion we output "},{"children":[{"kind":"text","text":"maxvalue"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"bestvector"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/460/submission/7536206"},"children":[{"kind":"text","text":"7536206"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"UPD"}],"kind":"strong"},{"kind":"text","text":" Editorial of problem C was expanded"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/13465"}