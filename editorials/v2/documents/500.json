text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"]\" (when we knock over a domino) and \"compute how much of the range ["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":"] is not covered\" (when we wish to answer a query). This can be done using coordinate compression and a segment tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's worth noting there are a lot of other ways to solve this problem. The other tutorial uses a completely different approach. Also, the approach described here may be implemented using different data structures. For example, here is "},{"attrs":{"href":"https://codeforces.com/contest/500/submission/9331215"},"children":[{"kind":"text","text":"my implementation"}],"kind":"link"},{"kind":"text","text":" using BBSTs and a Binary Indexed Tree."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/500/problem/F"},"children":[{"kind":"text","text":"500F — New Year Shopping"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"We will use the standard dynamic programming approach for 0/1 knapsack. To summarize what it does for us, imagine we are given an ordered list of items ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Let "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") be the maximum happiness we can buy, if we consider only the first "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" items in the list, and have a budget of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" is the size of the list, and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is the maximum possible budget, we can compute "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") for all possible "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"KB"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us sort all of the items by their display time. Suppose that we focus on the queries ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") with "},{"attrs":{"alt":"","src":"/editorial-assets/d5b64db4c971e10c04c73d4bbc2a3d32fad8ec5395b727091db52d48d44a0193.png"},"kind":"image"},{"kind":"text","text":", for some particular "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" be a list of the items with display time in ("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"], and let "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" be a list of the items with display time in ("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":"). Let both lists be sorted in order of display time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every query with "},{"attrs":{"alt":"","src":"/editorial-assets/d5b64db4c971e10c04c73d4bbc2a3d32fad8ec5395b727091db52d48d44a0193.png"},"kind":"image"},{"kind":"text","text":" will have available to it some suffix of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", along with some prefix of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". We'll do a knapsack DP on the elements of "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", in reverse order, and another on the elements of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", in normal order. Finally, to answer any query ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") with "},{"attrs":{"alt":"","src":"/editorial-assets/d5b64db4c971e10c04c73d4bbc2a3d32fad8ec5395b727091db52d48d44a0193.png"},"kind":"image"},{"kind":"text","text":", we can consider all possible ways to split the budget "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" between the items in "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and the items in "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", in linear time. For each possible way to split the budget, we need simply look up one value from each DP table to know the maximum possible happiness."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we perform the process above on "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" = 1, 1 + "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", 1 + 2"},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", 1 + 3"},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", ... until "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" exceeds the maximum possible day "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":", we'll be able to answer all of the queries. Let's think about the runtime of this solution. For each "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":", the described process takes "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"KB"}],"kind":"emphasis"},{"kind":"text","text":") time, where "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" is the number of items whose display time is in ("},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":"). Each object can only appear in up to two of these intervals. So, the overall runtime for all of the knapsack DP's we perform is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nB"}],"kind":"emphasis"},{"kind":"text","text":"). Computing the final answer takes "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") per query, or "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"qB"}],"kind":"emphasis"},{"kind":"text","text":") overall."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/500/problem/G"},"children":[{"kind":"text","text":"500G — New Year Running"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Don't know how to solve this yet. Maybe someone who is not gray can provide the solution. :)"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/15513"}