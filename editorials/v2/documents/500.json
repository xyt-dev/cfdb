text","text":", we know one component has size equal to the subtree size of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". For the other component, we use the fact that |"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"| = "},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" - |"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"|. "}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/500/problem/E"},"children":[{"kind":"text","text":"500E — New Year Domino"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"When domino "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is knocked over, it covers the interval ["},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"]. If we see a query ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), it is equivalent to the question \"If we knock over all dominoes with index "},{"attrs":{"alt":"","sr