,{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"2. Find the LCP for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Now, the minimum of the length of LCP, length of shortest unique substring starting from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", length of shortest unique substring starting from "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is the answer for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Now we need to find the minimum answer from all possible "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":","},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" pair. This problem can also be solved in "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" by suffix array and in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") using suffix automaton."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Model solution : "},{"attrs":{"href":"https://codeforces.com/contest/427/submission/6546277"},"children":[{"kind":"text","text":"6546277"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/427/problem/E"},"children":[{"kind":"text","text":"427E - Police Patrol"}],"kind":"link"},{"kind":"text","text":" ( Author : "},{"attrs":{"href":"https://codeforces.com/profile/Bidhan"},"children":[{"kind":"text","text":"Bidhan"}],"kind":"link"},{"kind":"text","text":" )"}],"kind":"heading"},{"children":[{"kind":"text","text":"Trying to place the police station on existing criminal locations is the best strategy. Calculate the cost from the leftmost criminal location, then sweep over the next locations. By doing some adjustments on the cost of the previous location will yield the cost of the current location."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Model solution : "},{"attrs":{"href":"https://codeforces.com/contest/427/submission/6546283"},"children":[{"kind":"text","text":"6546283"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/12082"}