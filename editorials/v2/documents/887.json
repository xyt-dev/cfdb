{"assets":[],"contestId":"887","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"Once again we apologize for making mistakes during preparation."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/A"},"children":[{"kind":"text","text":"887A - Div. 64"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the string contains no ones then the answer is \"NO\" as the remainig number must be positive. Otherwise we can find the leftmost one and check if it is followed by at least six zeroes."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/mKYmrrnm"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/B"},"children":[{"kind":"text","text":"887B - Cubes for Masha"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer is always less or equal to 98. We can go through numbers from 1 to 99 and find the first one which we cannot make using cubes."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/W5MBrL5e"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/C"},"children":[{"kind":"text","text":"887C - Solution for Cube"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The amount of variants of input data for which the answer is \"YES\" is not more than 12 without considering rearrangement of colours. They all could be written in an array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The alternative solution is writing a function of rotating a specific edge of the cube and checking if it is solved."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/G8kAaSVz"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/guUQaYKE"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/D"},"children":[{"kind":"text","text":"887D - Ratings and Reality Shows"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can create two arrays of prefix sums of events given in input. The first one on values ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") and the second one on values ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"). The answer is either 0 or the moment of time right after an event occured. Let's use the method of two pointers. One pointer will indicate an event "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":" after which we want to participate in the talk show and the other one at the moment of time right after its influence ends. Then we can participate in the talk show if the minimum of prefix sums on values ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":") from elements between pointers is not less than the difference of prefix sums on values ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":") from element "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":". Also we must check that Izabella's rating doesn't become negative before participating in the talk show or during its peroid of influence."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/te2R75QA"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/spVHQqvf"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/E"},"children":[{"kind":"text","text":"887E - Little Brother"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Authors: "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The center of required circle is on a perpendicular to the middle of the segment "},{"children":[{"kind":"text","text":"AB"}],"kind":"emphasis"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" are two points from the input. If a circle with the center on the segment "},{"children":[{"kind":"text","text":"AB"}],"kind":"emphasis"},{"kind":"text","text":" and the radius equal to half of its length satisfies the conditions then it is the answer. Otherwise we can find on which side relative to AB the center of the circle is. Every drawn circle blocks a continious interval of allowed values for the requierd circle. The limits of this interval can be found by using binary search. Now we have to find the least allowed value for the radius. It can be done, for example, by using method of scanning line."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/1Qkef8JL"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/MbfMAqH2"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/.31"},"children":[{"kind":"text","text":".31"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/zVWdJM1S"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/cdkrot"},"children":[{"kind":"text","text":"cdkrot"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/887/problem/F"},"children":[{"kind":"text","text":"887F - Row of Models"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every element of an array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we can check "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" elements on its right. If there are no elements less than "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we will mark it as \"-1\" and call it \"bad\". If there is exactly one element then make an edge from "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to this element. Otherwise swapping elements of the array will never make "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" \"bad\". If there are no \"bad\" elements in the array then the answer is \"YES\". Otherwise we should find the leftmost \"bad\" element in the array bad. "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" elements after it are not less than itself. All elements before it are also not less than itself because otherwise an element less than bad would be \"bad\" too. Swapping bad with an element in suffix also makes no sense because its place will be taken by lesser element and the position will remain \"bad\". Thus, swapping bad with other element of the array makes no sense. The only way to satisfy the conditions is to swap one of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" elements after "},{"children":[{"kind":"text","text":"bad"}],"kind":"emphasis"},{"kind":"text","text":" with other element in the remaining suffix without considering a segment with length "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" after bad. Let's try to do it obviously. Then the following conditions must be satisfied. Consider choosing an element "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" in the remaining suffix. Then the swap can be the answer if "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"bad"}],"kind":"emphasis"},{"kind":"text","text":". Also suffix after "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" and the segment between "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" and the segment with length "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" after "},{"children":[{"kind":"text","text":"bad"}],"kind":"emphasis"},{"kind":"text","text":" must not contain \"bad\" elements. An element, which we swap "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" with, from the segment with length "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" after "},{"children":[{"kind":"text","text":"bad"}],"kind":"emphasis"},{"kind":"text","text":" must be less than any adress on "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". Also we need to check that after the swap on the right side of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" we can find an element less than itself no further than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") or "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlogn"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/eM5MCtbZ"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/X8KSfKzx"},"children":[{"kind":"text","text":"Solution."}],"kind":"link"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/Denisson"},"children":[{"kind":"text","text":"Denisson"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/55584"}