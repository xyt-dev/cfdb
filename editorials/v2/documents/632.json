"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/632/problem/B"},"children":[{"kind":"text","text":"632B - Alice, Bob, Two Teams"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was suggested by Lewin Gan "},{"attrs":{"href":"https://codeforces.com/profile/Lewin"},"children":[{"kind":"text","text":"Lewin"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's calculate the prefix sums for all numbers (and store it in array "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"1) and for numbers with letter B (and store it in array "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"2). Now we can find the sum of all numbers in any segment in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) time and the sum of numbers with letter B."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's iterate over prefix or suffix to flip and calculate the sum in that case by formulas: "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"1, 0, "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) + "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"2, 0, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") - 2·"},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"1, 0, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") for prefixes and "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"1, 0, "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) + "},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) - 2·"},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1) for suffixes."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/3WQTWaxD"},"children":[{"kind":"text","text":"C++ solution"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/ZsjnmDhq"},"children":[{"kind":"text","text":"Python solution"}],"kind":"link"},{"kind":"text","text":" by "},{"attrs":{"href":"https://codeforces.com/profile/Lewin"},"children":[{"kind":"text","text":"Lewin"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/632/problem/C"},"children":[{"kind":"text","text":"632C - The Smallest String Concatenation"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was suggested by Lewin Gan "},{"attrs":{"href":"https://codeforces.com/profile/Lewin"},"children":[{"kind":"text","text":"Lewin"}],"kind":"link"},{"kind":"text","text":". The proof of the transitivity also belongs to him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's sort all the strings by comparator "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and concatenate them. Let's prove that it's the optimal answer. Let that operator be transitive (so if "},{"attrs":{"alt":"","src":"/editorial-assets/d7c036e71bb17c0bd9eb045050bbd81b29fdec912975d550788bb9400f9816a6.png"},"kind":"image"},{"kind":"text","text":"). Consider an optimal answer with two strings in reverse order by that operator. Because of the transitivity of operator we can assume that pair of strings are neighbouring. But then we can swap them and get the better answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's prove the transitivity of operator. Consider the strings as the 26-base numbers. Then the relation "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" equivalent to "},{"attrs":{"alt":"","src":"/editorial-assets/f4a580ba36914bb2f8c697274690cdd73be56ecb563c814bdf6c687225407a45.png"},"kind":"image"},{"kind":"text","text":". The last is simply the relation between real numbers. So we proved the transitivity of the relation "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/48WhrGLn"},"children":[{"kind":"text","text":"C++ solution"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/b7Gc34ez"},"children":[{"kind":"text","text":"Python solution"}],"kind":"link"},{"kind":"text","text":" by "},{"attrs":{"href":"https://codeforces.com/profile/Lewin"},"children":[{"kind":"text","text":"Lewin"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nLlogn"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" is the maximal string length."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/632/problem/D"},"children":[{"kind":"text","text":"632D - Longest Subsequence"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was suggested by Denis Bezrukov "},{"attrs":{"href":"https://codeforces.com/profile/pitfall"},"children":[{"kind":"text","text":"pitfall"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the number of occurences of the number "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in the given array (easy to see that we can ignore the numbers greater than "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"). Let's iterate over "},{"attrs":{"alt":"","src":"/editorial-assets/2c7e9220ce4cc9d2fb342cb74b8bfd81ea69e79c5eb63b12b362c3a0c7dbb267.png"},"kind":"image"},{"kind":"text","text":" and 1 ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" and increase the value in the position "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" in some array "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" by the value "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". So the value "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equals the number of numbers in the given array which divide "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":". Let's find the minimal "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" with the maximum value "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (1 ≤ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"). Easy to see that the answer to the problem is the numbers which divide "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's calculate the complexity of the solution. The number of the pairs ("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") we can bound with the value "},{"attrs":{"alt":"","src":"/editorial-assets/74e3d6759d5cbac7b417b8dab5365821bd392688a3470df05519f9b80e4eb618.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/v5tayDQq"},"children":[{"kind":"text","text":"C++ solution"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/aZQ2c1xR"},"children":[{"kind":"text","text":"Java solution"}],"kind":"link"},{"kind":"text","text":" by "},{"attrs":{"href":"https://codeforces.com/profile/pitfall"},"children":[{"kind":"text","text":"pitfall"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"mlogm"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/632/problem/E"},"children":[{"kind":"text","text":"632E - Thief in a Shop"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was suggested by Alexey Chesnokov "},{"attrs":{"href":"https://codeforces.com/profile/CleRIC"},"children":[{"kind":"text","text":"CleRIC"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2, then it is the standard problem which can be solved by FFT (Fast Fourier Transform). The solution is the following: consider the polynomial which the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th coefficient equals to one if and only if there is the number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in the given array. Let's multiply that polynomial by itself and find "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" for which the coefficient in square not equals to 0. Those values "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" will be in the answer. Easy to modificate the solution for the arbitrary "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". We should simply calculate the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th degree of the polynomial. The complexity will be "},{"children":[{"kind":"text","text":"WlogWlogk"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" is the maximal sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can improve that solution. Instead of calculating the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th degree of the polynomial we can calculate the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th degree of the DFT of the polynomial. The only problem is the large values of the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th degrees. We can't use FFT with complex numbers, because of the precision problems. But we can do that with NTT (Number-theoretic transform). But that solution also has a problem. It can happen that some coefficients became equals to zero modulo "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", but actually they are not equal to zero. To get round that problem we can choose two-three random modules and get the complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logW"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"logk"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The main author solution has the complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"WlogWlogk"}],"kind":"emphasis"},{"kind":"text","text":") (FFT with complex numbers), the second solution has the same complexity, but uses NTT and the third solution has the improved complexity (but it was already hacked by "},{"attrs":{"href":"https://codeforces.com/profile/halyavin"},"children":[{"kind":"text","text":"halyavin"}],"kind":"link"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/vdw5DWLC"},"children":[{"kind":"text","text":"С++ solution, complex FFT"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/z6b7wu5b"},"children":[{"kind":"text","text":"С++ solution, NTT"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/t6nguiHa"},"children":[{"kind":"text","text":"С++ solution, improved NTT"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/Wu3RY6UD"},"children":[{"kind":"text","text":"С++ solution"}],"kind":"link"},{"kind":"text","text":" by "},{"attrs":{"href":"https://codeforces.com/profile/CleRIC"},"children":[{"kind":"text","text":"CleRIC"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"P.S.: To get faster solution you should each time multiply the polynomials of the required degree, but not of the degree 2"},{"children":[{"kind":"text","text":"20"}],"kind":"superscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"WlogWlogk"}],"kind":"emphasis"},{"kind":"text","text":") or "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logW"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"logk"}],"kind":"emphasis"},{"kind":"text","text":")), depending the bravery of the coder :-)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"UPD: It turns out that the first approach also has complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logW"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"logk"}],"kind":"emphasis"},{"kind":"text","text":")). See below the comment of "},{"attrs":{"href":"https://codeforces.com/profile/halyavin"},"children":[{"kind":"text","text":"halyavin"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/632/problem/F"},"children":[{"kind":"text","text":"632F - Magic Matrix"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"The problem was suggested by Lewin Gan "},{"attrs":{"href":"https://codeforces.com/profile/Lewin"},"children":[{"kind":"text","text":"Lewin"}],"kind":"link"},{"kind":"text","text":". The solution and proof also belongs to him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the undirected complete graph with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" nodes, with an edge between nodes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" with cost "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" denote the minimum possible value of the max edge of a path from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". We know that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by definition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the matrix is magic, we can choose arbitrary "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") by repeating invocations of the inequality given. Also, you can show that if this inequality is satisfied, then the matrix is magic (by choosing an "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = 1 and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" arbitrary)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, this shows that the matrix is magic if and only if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Thus, combining with "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we have "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need a fast way to compute "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"ij"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for all pairs "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". This can be computed as the MST, as the path in the MST minimizes the max edge between all pairs of nodes. So, the algorithm works as follows. First, find the MST on the complete graph. Then, the matrix is magic if and only if the max edge on the path between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" in the MST is exactly equal to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Also you shouldn't forget to check symmetry of the matrix and diagonal for zeros."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"P.S.: Unfortunately we couldn't increase the value "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" in this problem: the tests already had the size about 67MB and they couldn't be given with generator. So most of the users who solved this problem uses "},{"children":[{"kind":"text","text":"bitset"}],"kind":"emphasis"},{"kind":"text","text":"-s. The complexity of their solution is "},{"attrs":{"alt":"","src":"/editorial-assets/7ea6abbca47ed0a7e502847137e77d07236fe0f36558acf676adf6602298e79f.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = 32 or "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = 64."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/rh96ipzn"},"children":[{"kind":"text","text":"C++ solution, binary lifts"}],"kind":"link"},{"kind":"text","text":" by me."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pas