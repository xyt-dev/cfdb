{"assets":["/editorial-assets/a7d4811b7d549f5b58d776342784baddb4e78523bdabb01a7d772eac8fc89fc6.png","/editorial-assets/906db20d74df54f9b3378c862775a17f06039c1b798b0a214fd076d6813012a3.png","/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png","/editorial-assets/458b224bd5e89810510cef471f4a652e81a673cbe91c14e104ae8212c5faa02a.png","/editorial-assets/c24812c9d9a6076303dc066de42ead535b9fab13fd2589cd4df5a5d07f962ded.png","/editorial-assets/ca81a5dc63f31da154ca4d87c064dc225bb7f3300b011b47cbb102a79398197e.png","/editorial-assets/86f630188831bb90ccbe1b0afeded6695b4129aca1afeed7356c0a52ded7ebb9.png","/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png","/editorial-assets/9da868919fa4eafb00ba5b3937648442c6f9570abcfa73635c5ab43b31ff76fd.png","/editorial-assets/4f02a103264708a50eec5ad557b67f435123da1fe9d70731d7990e57da8837c2.png","/editorial-assets/c45c1a2c4c9c28e60f36d2c7126116d604a04e91459643a19c69589580c1935a.png"],"contestId":"727","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"727A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/A"},"children":[{"kind":"text","text":"727A - Transformation: from A to B"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's solve this problem in reverse way — try to get the number "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that if "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" ends with 1 the last operation was to append the digit 1 to the right of current number. Because of that let delete last digit of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and move to the new number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the last digit is even the last operation was to multiply the current number by 2. Because of that let's divide "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" on 2 and move to the new number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the other cases (if "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" ends with odd digit except 1) the answer is «NO». "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need to repeat described algorithm after we got the new number. If on some step we got the number equals to "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" we find the answer, and if the new number is less than "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" the answer is «NO»."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"727B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/B"},"children":[{"kind":"text","text":"727B - Bill Total Value"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"In this problem we need to simply implement calculating the sum of prices. At first we need to find all prices — sequences of consecutive digits and dots."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we need to find the integer number of dollars in each price and count integer sum of dollars in the variable "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". Also we need to make the same thing for cents and calculate in the variable "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After process all prices we need to transform cents in rubles, i. e. add to "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" the value "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" / 100, and "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" assign to "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"%100. Now we need only to print the answer and do not forget, that for cents if "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" < 10 we need to print 0 at first and then "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" because the number of cents must consisting of two digits like wrote in the statement. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"727C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/C"},"children":[{"kind":"text","text":"727C - Guess the Array"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"At first let's make three queries on sum "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"с"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" и "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that we got a system of three equations with three unknown variables "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":". After simple calculating we got that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" = ("},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":") / 2. The values of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":" now can be simply found. After that we now the values of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"subscript"},{"kind":"text","text":" and spent on it 3 queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from 4 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" we need to make the query "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If the next sum equals to "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" then "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" (recall that we already know the value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we guess the array with exactly "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" queries."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"727D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/D"},"children":[{"kind":"text","text":"727D - T-shirts Distribution"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let in the array "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" we store how many t-shirts of each size are in the typography."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At first let's give the t-shirts to participants who wants exactly one size of the t-shirt and decrease appropriate values in "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":". If in some moment we have no t-shirt of needed size the answer is \"NO\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need to give the t-shirts to participants who wants t-shirt with one of two sizes. Let's use greedy. At first we need to give t-shirts with size S to participants who wants it or t-shirt with size M. After that let's move to the t-shirts with size M. At first let's give this t-shirts to participants who wants it or t-shirts with size S and do not already have the t-shirt. After that if t-shirts with size M remain we need to give this t-shirts to participants who wants it or t-shirts with sizes L. Similarly, we must distribute the remaining t-shirts sizes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If after all operations not each participant has the t-shirt the answer is \"NO\". In the other case we found the answer."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"727E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/E"},"children":[{"kind":"text","text":"727E - Games on a CD"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"With help of Aho Corasick algorithm we need to build the suffix tree on the set of game names ans in the vertex of the tree (which correspond to the name of some game, this vertex will be on the depth "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") we will store the number of this game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Builded tree allows to add symbols to some string one by one and find the vertex which corresponds to the longest prefix from all prefixes of game names which equals to the suffix of our string. If the length of this prefix equals to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" the suffix equals to some game name."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's write the string which wrote on disk twice and calculate "},{"children":[{"kind":"text","text":"idx"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the index of the game which name equals to substring of doubled string from index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1 to index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" inclusively (if such index does not exist it's equals to  - 1). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need to iterate through the indexes of symbols which is last in the name of some game. We can iterate from 0 to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1. With fixed "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" we need to check that all game names with last symbols in indexes "},{"attrs":{"alt":"","src":"/editorial-assets/a7d4811b7d549f5b58d776342784baddb4e78523bdabb01a7d772eac8fc89fc6.png"},"kind":"image"},{"kind":"text","text":" for 0 ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" are different (for it we need to check that among "},{"children":[{"kind":"text","text":"idx"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"("},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"ik"}],"kind":"emphasis"},{"kind":"text","text":")%"},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" there is no  - 1 and all of them are different). If it is performed — print YES and now it is easy to restore the answer. If the condition failed for all "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" — print NO."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Asymptotic behavior of this solution  — "},{"attrs":{"alt":"","src":"/editorial-assets/906db20d74df54f9b3378c862775a17f06039c1b798b0a214fd076d6813012a3.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"727F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/727/problem/F"},"children":[{"kind":"text","text":"727F - Polycarp's problems"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"At first let's solve the problem for one value of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":". It is easy to show that optimal solution is the following: add to the set of tasks next task with quality equals to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". While the value of mood (the sum of qualities and "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":") is less than 0, delete from the set of remaining task the task with worst quality. The quality of such task will be less than 0, because we will not spoil the mood on previous tasks. This solution can be implement with help of structures std::set or std::priority_queue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Described solution helps us to find answer on the query in "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":", but "},{"attrs":{"alt":"","src":"/editorial-assets/458b224bd5e89810510cef471f4a652e81a673cbe91c14e104ae8212c5faa02a.png"},"kind":"image"},{"kind":"text","text":" does not fill in time limit. Note, that while we increase "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" the number of deleted problems does not increase and the possible number of such numbers is only "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". So we need to solve the following task: for 0 ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" calculate minimum value of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" that the number of deleted problems does not exceed "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". This problem can be easily solved for each "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" with help of binary search in "},{"attrs":{"alt":"","src":"/editorial-assets/c24812c9d9a6076303dc066de42ead535b9fab13fd2589cd4df5a5d07f962ded.png"},"kind":"image"},{"kind":"text","text":", in sum for all "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" we got "},{"attrs":{"alt":"","src":"/editorial-assets/ca81a5dc63f31da154ca4d87c064dc225bb7f3300b011b47cbb102a79398197e.png"},"kind":"image"},{"kind":"text","text":". Also we have an interest only "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" values of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":", we can make the binary search only on this values and in total we got "},{"attrs":{"alt":"","src":"/editorial-assets/86f630188831bb90ccbe1b0afeded6695b4129aca1afeed7356c0a52ded7ebb9.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each answer "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" with help of stored values we need to find the first answer which minimum value of "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" does not more than "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" in the query. We can do it easy in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") or with binary search in "},{"attrs":{"alt":"","src":"/editorial-assets/f9edda04d142988747c93c4e7ffb9141d5687b7dd90520c29948f28573b3d1a1.png"},"kind":"image"},{"kind":"text","text":" (because the values "},{"children":[{"kind":"text","text":"Q"}],"kind":"emphasis"},{"kind":"text","text":" for the answers does not increase). In total we will get "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"mn"}],"kind":"emphasis"},{"kind":"text","text":") or "},{"attrs":{"alt":"","src":"/editorial-assets/9da868919fa4eafb00ba5b3937648442c6f9570abcfa73635c5ab43b31ff76fd.png"},"kind":"image"},{"kind":"text","text":" in sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The best asymptotic behavior is "},{"attrs":{"alt":"","src":"/editorial-assets/4f02a103264708a50eec5ad557b67f435123da1fe9d70731d7990e57da8837c2.png"},"kind":"image"},{"kind":"text","text":" but solutions which work in "},{"attrs":{"alt":"","src":"/editorial-assets/c45c1a2c4c9c28e60f36d2c7126116d604a04e91459643a19c69589580c1935a.png"},"kind":"image"},{"kind":"text","text":" also passed all tests."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/47773"}