":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th voter. If "},{"attrs":{"alt":"","src":"/editorial-assets/275a22c785323107b00beaf9ba287d776086728263b97aa955afad7fb42d8ebd.png"},"kind":"image"},{"kind":"text","text":", only one permutation. So, total number of permutation is "},{"attrs":{"alt":"","src":"/editorial-assets/941c0bef271fae601c42bd4ea0094924ce676e70214d89dcaa929038bfa54fb0.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, answer to the problem is "}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/fec68f36061273c13e5eafbc4e5e92be6d15f83ce7f6a4d4775d491188707439.png"},"kind":"image"},{"children":[{"kind":"text","text":"Denote "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" = {"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") = 1}. Lets solve more general problem, for each "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":", how many pairs ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") are there such that "},{"attrs":{"alt":"","src":"/editorial-assets/57fc7f0f16d53c013fe836f221d1cd82a881caa0cef336b31b95de2e9bebc102.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/4e9fac6bdccd5d48fb414bbadae5cef471da3059bb3de7459720ca5615f4a059.png"},"kind":"image"},{"kind":"text","text":"? This is well-known problem. There are multiple "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(2"},{"children":[{"children":[{"kind":"text","text":"nn"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":") solutions. Probably first usage of this problem in competitive programming can be found here "},{"attrs":{"href":"https://apps.topcoder.com/wiki/display/tc/SRM+518"},"children":[{"kind":"text","text":"https://apps.topcoder.com/wiki/display/tc/SRM+518"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you interesting in understanding this approach more deeply from math perspective, you can start investigate from here "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Fourier_transform_on_finite_groups"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Fourier_transform_on_finite_groups"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sorry for late editorial. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Btw, in task D there are always an answer (for any set S), that's called Reid's conjectue and was proven by T.X. Yao in 1988 (and have very difficult proof that I didn't manage to find in English; if somebody succeed in search, please direct it to me). "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/Arterm"},"children":[{"kind":"text","text":"Arterm"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/Arterm"},"children":[{"kind":"text","text":"Arterm"}],"kind":"link"},{"kind":"text","text":", the writer of this tutorial."}],"kind":"paragraph"},{"attrs":{"problemCode":"850F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/850/problem/F"},"children":[{"kind":"text","text":"850F - Радужные шары"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First, let's fix the final color of the balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After fixing the final color, we can see the other colors don't matter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define an \"interesting\" draw as one where we choose a ball of the final color and one of a different color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once we do an interesting draw, we can see there is an equal probability of increasing or decreasing the number of balls of our final color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we can view this as a random walk, with equal probability of going in either direction. Let "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the number of balls of the final color at time "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" be the first time we hit 0 or "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, we can write the expected value of time as follows: Let "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"tex