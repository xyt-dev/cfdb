ask"}],"kind":"emphasis"},{"kind":"text","text":" to ("},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"»"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")|("},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"&((1«"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") - 1)). So, for each "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", there is an edge between state ("},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"»"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")|("},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"&((1«"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") - 1)) and "},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":". We can caluclate the grundy numbers by this way."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/Arpa"},"children":[{"kind":"text","text":"Arpa"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"850D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/850/problem/D"},"children":[{"kind":"text","text":"850D - Tournament Construction"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" be the number of players participating in the tournament. First of all, note that "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 61, since the total number of wins must be "},{"attrs":{"alt":"","src":"/editorial-assets/95cda37eaf41d946d92254d095126fda530c7e4b7615c1d6225b91369182e7c4.png"},"kind":"image"},{"kind":"text","text":", and there can be no more than 30 × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", therefore "},{"attrs":{"alt":"","src":"/editorial-assets/c8db2d6d79f981a0a381ecaf1f7077944351b29cfb48f8bb8ef5066d1c30d49a.png"},"kind":"image"},{"kind":"text","text":", hence "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 61. Next, we find an appropriate "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", based on the criterion of the condition. We will go through all possible "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to 61 and use the dynamic programming method to determine whether there can be a given number of participants, the parameters will be:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the current element in the sorted list "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" how many participants are already aware of their number of victories "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the total number of wins for the already known participants "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"From these parameters, we store whether it is possible for the remaining participants to assign any "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"pos"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":"... "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" so that there is a tournament for these participants. Also, do not forget that each of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" should be taken at least once. Further, if we did not find "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", then we print  - 1. Otherwise, you can recover from the dynamics how many times we took each "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", it remains to build a correct tournament on these values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do this, each time we take the player with the smallest number of wins, let this number be "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", and we make him win "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" other players with the least number of wins, and loose to the remaining players. Next, delete this player, recompute for each remaining player how many times they have to win, and continue this process until all of the players are processed. The proof that a correct tournament is always built by this algorithm follows from the criterion."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, the first part works in "},{"attrs":{"alt":"","src":"/editorial-assets/2467fc9b42232549211b1ca5d4e3dc97630db88661b6954a5c74d51af92d3f11.png"},"kind":"image"},{"kind":"text","text":" the second part works in "},{"attrs":{"alt":"","src":"/editorial-assets/4d528c78803fc0dad6b4e1b2a247417119aa3650e7025ba179bc422e8aaff27b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Author: "},{"attrs":{"href":"https://codeforces.com/profile/Arterm"},"children":[{"kind":"text","text":"Arterm"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/WHITE2302"},"children":[{"kind":"text","text":"WHITE2302"}],"kind":"link"},{"kind":"text","text":", the writer of this tutorial. I translated this tutorial to English."}],"kind":"paragraph"},{"attrs":{"problemCode":"850E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/850/problem/E"},"children":[{"kind":"text","text":"850E - Выборы"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") denotes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/editorial-assets/fed304deeb247db3b54ed7a405653eb704ec37df2974ff9a815b315ff3341289.png"},"kind":"image"},{"kind":"text","text":" denotes number of bits in "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count number of ways where Alice wins. Suppose Alice wins in first round with mask "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and in third round with mask "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis