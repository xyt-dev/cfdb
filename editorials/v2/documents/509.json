asis"},{"kind":"text","text":"| - "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1 to "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Otherwise, "},{"children":[{"kind":"text","text":"SP"}],"kind":"emphasis"},{"kind":"text","text":" is increased by the number of vowel occurrences in the substring from "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" to |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"| - "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This way we can easily recalculate "},{"children":[{"kind":"text","text":"SP"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" using "},{"children":[{"kind":"text","text":"SP"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by adding (subtracting) the number of vowel occurrences on a substring (which is done in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) time). The complexity of this solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prepared by: "},{"attrs":{"href":"https://codeforces.com/profile/zemen"},"children":[{"kind":"text","text":"zemen"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Author of editorial: "},{"attrs":{"href":"https://codeforces.com/profile/zemen"},"children":[{"kind":"text","text":"zemen"}],"kind":"link"}]