{"assets":["/editorial-assets/c3c97e884555054c60a364c9ad3332c8d2b40c2a36b1a456787ad572257b7c41.png","/editorial-assets/bd72434f9f1f63c2cd57d1853b8dc2786c76d2ff9a2b1027952c22c16ef4246e.png","/editorial-assets/cde29e6ff2477ddfecf863a45f057213094d9a47f081fe96e2d2e21318a7ff3c.png","/editorial-assets/4034985e59d48dd7b7a1d8471357bbce4547457ddb14f5c90c14ac16b5d895af.png","/editorial-assets/153e2d65b5e86fb45fd191ab8623968f640f72b79ab7f13f8ad638a61ad988c7.png","/editorial-assets/ade8c18a2008477b2d412e4edc7e0cce69264621959f1724069472a5ff4f1f3e.png"],"contestId":"509","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/509/problem/A"},"children":[{"kind":"text","text":"509A - Maximum in Table"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem one needed to implement what was written in the statement: create matrix (two-dimensional array) using given rules and find maximal value in the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is also possible to see that maximal element is always in bottom-right corner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Easier solution with recursion also was enough to get AC:"}],"kind":"paragraph"},{"kind":"code_block","text":"def elem(row, col):\n    if row == 1 or col == 1:\n        return 1\n    return elem(row - 1, col) + elem(row, col - 1)\n"},{"children":[{"kind":"text","text":"One may see the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Pascal%27s_triangle"},"children":[{"kind":"text","text":"Pascal's triangle"}],"kind":"link"},{"kind":"text","text":" in the given matrix and understand that answer is equal to "},{"attrs":{"alt":"","src":"/editorial-assets/c3c97e884555054c60a364c9ad3332c8d2b40c2a36b1a456787ad572257b7c41.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prepared by: "},{"attrs":{"href":"https://codeforces.com/profile/riadwaw"},"children":[{"kind":"text","text":"riadwaw"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Author of editorial: "},{"attrs":{"href":"https://codeforces.com/profile/riadwaw"},"children":[{"kind":"text","text":"riadwaw"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/509/problem/B"},"children":[{"kind":"text","text":"509B - Painting Pebbles"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose there are two piles with number of pebbles differed by more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", then there is no solution:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/bd72434f9f1f63c2cd57d1853b8dc2786c76d2ff9a2b1027952c22c16ef4246e.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"There's a way to construct correct coloring: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"Chose "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" peebles from each pile and assign first color to them."}],"kind":"list_item"},{"children":[{"kind":"text","text":"In each pile assign different colors to all other pebbles (you may use first color once more) (It's possible bacause there are no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" uncolored pebbles."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now there are "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1 pebbles of first color and 0 or 1 pebbles of any other color in each pile."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prepared by: "},{"attrs":{"href":"https://codeforces.com/profile/Kostroma"},"children":[{"kind":"text","text":"Kostroma"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Author of editorial: "},{"attrs":{"href":"https://codeforces.com/profile/riadwaw"},"children":[{"kind":"text","text":"riadwaw"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/509/problem/C"},"children":[{"kind":"text","text":"509C - Sums of Digits"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The algorithm is greedy: first, take the minimal number with sum of digits "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" — call it "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". Then, on the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th step take "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the minimal number with sum of digits "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", which is more than "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be easily proven that this algorithm gives an optimal answer. But how to solve the subproblem: given "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", find the minimal number with sum of digits "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", which is more than "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We use a standard approach: iterate through the digits of "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" from right to left, trying to increase the current digit and somehow change the digits to the right in order to reach the sum of digits equal to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Note that if we are considering the ("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1)-th digit from the right and increase it, we can make the sum of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" least significant digits to be any number between 0 and 9"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". When we find such position, that increasing a digit in it and changing the least significant digits gives us a number with sum of digits "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", we stop the process and obtain the answer. Note that if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" least significant digits should have sum "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" (where 0 ≤ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 9"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), we should obtain the answer greedily, going from the right to the left and putting to the position the largest digit we can. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us bound the maximal length of the answer, i.e. of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If some "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" has at least 40 digits, than we take the minimal "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" such that 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Than between 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" and 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":" there exist numbers with any sum of digits between 1 and 9"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 40, than 9"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 300, which is the upper bound of all "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". So, in the constraints of the problem, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" will be less than 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"superscript"},{"kind":"text","text":". Than, similarly, "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 2"}],"kind":"subscript"},{"kind":"text","text":" < 10"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 2"}],"kind":"superscript"},{"kind":"text","text":" and so on. So, the length of the answer increases by no more than one after reaching the length of 40. Consequently, the maximal length of the answer can't be more than 340. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The complexity of solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"maxLen"}],"kind":"emphasis"},{"kind":"text","text":"). Since "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 300, "},{"children":[{"kind":"text","text":"maxLen"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 340, the solution runs much faster the time limit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prepared by: "},{"attrs":{"href":"https://codeforces.com/profile/Endagorion"},"children":[{"kind":"text","text":"Endagorion"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Author of editorial: "},{"attrs":{"href":"https://codeforces.com/profile/Kostroma"},"children":[{"kind":"text","text":"Kostroma"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/509/problem/D"},"children":[{"kind":"text","text":"509D - Restoring Numbers"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First we note that if the sequences "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" are a valid solution, then so are the sequences "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" for any integer "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". This means that we can consider "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" to be equal to 0 which allows us to recover the sequence "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by simply taking the first row of the matrix. Knowing "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" we can also recover "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" (for example by subtracting "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" from the first column of the matrix) At this stage we allow "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to contain negative numbers, which can be later fixed by adding "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" a sufficient amount of times. Now we consider the “error” matrix "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":": "},{"attrs":{"alt":"","src":"/editorial-assets/cde29e6ff2477ddfecf863a45f057213094d9a47f081fe96e2d2e21318a7ff3c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":" consists entirely of 0s, then we’ve found our solution by taking a sufficiently large "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":". That is: "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, we note that "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0("},{"children":[{"kind":"text","text":"modK"}],"kind":"emphasis"},{"kind":"text","text":") which implies that "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" is a divisor of "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). The greatest such number is "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":" itself, so all that remains is to check if "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":" is strictly greater than all the elements of the matrix "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":". If that is the case, then we’ve found our solution by setting "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":". Otherwise, there’s no solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prepared by: "},{"attrs":{"href":"https://codeforces.com/profile/Kostroma"},"children":[{"kind":"text","text":"Kostroma"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/riadwaw"},"children":[{"kind":"text","text":"riadwaw"}],"kind":"link"},{"kind":"line_break"},{"kind":"text","text":"Author of editorial: "},{"attrs":{"href":"https://codeforces.com/profile/riadwaw"},"children":[{"kind":"text","text":"riadwaw"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/509/problem/E"},"children":[{"kind":"text","text":"509E - Pretty Song"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We first calculate the prefix sums of "},{"children":[{"kind":"text","text":"vowel"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") which allows to calculate the sum of "},{"children":[{"kind":"text","text":"vowel"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") on any substring in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"attrs":{"alt":"","src":"/editorial-assets/4034985e59d48dd7b7a1d8471357bbce4547457ddb14f5c90c14ac16b5d895af.png"},"kind":"image"},{"kind":"text","text":", we will calculate the sum of simple pretinesses of all substrings of that length, let’s call it "},{"children":[{"kind":"text","text":"SP"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". For that purpose, let’s calculate the number of times the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th character of the string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" is included in this sum. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = 1 and "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"|, every character is included exactly 1 time. For "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = 2 and "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"| - 1, the first and the last character are included 1 time and all other characters are included 2 times. For "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = 3 and "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = |"},{"children":[{"kind":"text","text":"s"}],"kind":"emp