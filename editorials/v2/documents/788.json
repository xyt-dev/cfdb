kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", 1001))."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"788D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/788/problem/D"},"children":[{"kind":"text","text":"788D - Finding lines"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First we solve another problem. Let we have points not straight lines, but points on one axis. Let "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" = 10"},{"children":[{"kind":"text","text":"8"}],"kind":"superscript"},{"kind":"text","text":", that is, the maximum coordinate. First, we find the left and right points. The left is ( - "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"get"}],"kind":"emphasis"},{"kind":"text","text":"( - "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":")), and the right one ("},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"get"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":")). Then we solve the problem recursively. There will be a function "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") that finds all points on the segment ("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":