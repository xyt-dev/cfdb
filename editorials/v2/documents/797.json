{"assets":["/editorial-assets/91ee570e2d4fddd7a512102021145786e9ec944340b811493749b46f8bbd8b02.png","/editorial-assets/05551a042268291669571dbe35101a8bdc5dcce0412f9045d56ed53d1094a765.png","/editorial-assets/6f43d30ab13f20a9264b63c4688294e9fc6e6ddee461706708836e5f8593fc32.png","/editorial-assets/18cc6aa2fb5a5821c487baa2398d4e5e10cc7faffa1d2fb410447b773c2e3ac2.png"],"contestId":"797","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"797A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/A"},"children":[{"kind":"text","text":"797A - k-Factorization"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"There are many approaches to this problem. You can, for example, factorize "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", store all multipliers in a list, and while size of this list is greater than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", take any two elements of this list and replace them with their product. If the initial size of this list is less than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", then answer is -1."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"797B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/B"},"children":[{"kind":"text","text":"797B - Odd sum"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The answer to this problem can be constructed this way:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Sum up all positive numbers "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find maximum "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"odd"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of negative odd numbers "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find minimum "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"odd"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of positive odd numbers "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If sum was even then subtract "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"odd"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":",  - "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"odd"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"797C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/C"},"children":[{"kind":"text","text":"797C - Minimal string"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"On every step you should maintain minimal alphabetic letter in current string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" (this can be done by keeping array of 26 cells with number of times each letter appear in string nd updating it on every step). Let's call string "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" a stack and use its terms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you extract letters from "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" one by one. Put the letter to the top of the stack. Pop letters from the top of stack and push them to answer while they are less or equal than any letter left in string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". After string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" becomes empty push all the letters from stack to answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer will be lexicographically minimal. It is obvious if we consider the case when current top of stack is strictly greater than any character from the remaining string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", or there is a character in "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" that is strictly less than current top. If current top is equal to some character then appending answer with the letter from top won't make answer worse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * |"},{"children":[{"kind":"text","text":"AL"}],"kind":"emphasis"},{"kind":"text","text":"|), where |"},{"children":[{"kind":"text","text":"AL"}],"kind":"emphasis"},{"kind":"text","text":"| is the length of the alpabet, 26 in our case."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"797D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/D"},"children":[{"kind":"text","text":"797D - Broken BST"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's firstly consider tree with only distinct values in its nodes. Then value will be reached if and only if all the jumps to the left children on the path from the root were done from the vertices with values greater than the current one and all the jumps to the right children on the path from the root were done from the vertices with values less than the current one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus let's run dfs from the root and maintain maximal transition to the left child on current path and minimal transition to the right child on current path. If the value of current node is greater than left bound and less than right bound then it will be found."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's return to the original problem. Notice that transitions and comparations won't change. Store every found value in set and just calculate how many values of vertices isn't present there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"))."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"797E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/E"},"children":[{"kind":"text","text":"797E - Array Queries"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"There are two possible solutions in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First of them answers each query using simple iteration — changes "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" for each query until "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" becomes greater than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", as stated in the problem. But it is too slow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second solution precalculates answers for each "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":": if "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1, else "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1. But this uses "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") memory and can be done in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we can notice that if "},{"attrs":{"alt":"","src":"/editorial-assets/91ee570e2d4fddd7a512102021145786e9ec944340b811493749b46f8bbd8b02.png"},"kind":"image"},{"kind":"text","text":", then second solution will use only "},{"attrs":{"alt":"","src":"/editorial-assets/05551a042268291669571dbe35101a8bdc5dcce0412f9045d56ed53d1094a765.png"},"kind":"image"},{"kind":"text","text":" time and memory, and if "},{"attrs":{"alt":"","src":"/editorial-assets/6f43d30ab13f20a9264b63c4688294e9fc6e6ddee461706708836e5f8593fc32.png"},"kind":"image"},{"kind":"text","text":", then first solution will do not more than "},{"attrs":{"alt":"","src":"/editorial-assets/18cc6aa2fb5a5821c487baa2398d4e5e10cc7faffa1d2fb410447b773c2e3ac2.png"},"kind":"image"},{"kind":"text","text":" operations on each query. So we can combine these two solutions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/05551a042268291669571dbe35101a8bdc5dcce0412f9045d56ed53d1094a765.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"797F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/797/problem/F"},"children":[{"kind":"text","text":"797F - Mice and Holes"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This problem can be solved using dynamic programming. Let "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the answer for first "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" holes and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" mice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the constraints were smaller, then we could calculate it in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") just trying to update "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by all values of "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" and calculating the cost to transport all mice from the segment to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"th hole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To calculate this in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":"), we will use a deque maintaining the minimum (or a queue implemented on two stacks, for example). We iterate on "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and update all the values of "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with the help of this deque: for each index "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" we insert a value in the deque equal to "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cost"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"cost"}],"kind":"emphasis"},{"kind":"text","text":" is the total distance required to move first "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" mice to hole "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1. Updating the value is just extracting the minimum and adding this "},{"children":[{"kind":"text","text":"cost"}],"kind":"emphasis"},{"kind":"text","text":" to it. Don't forget to delete values from the deque to ensure that we don't send too much mice to the hole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/51588"}