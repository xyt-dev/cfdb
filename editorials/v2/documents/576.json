text":", that means for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":". Let's calculate "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] only for "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We can calculate "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":"] using "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"] by raising the adjacency matrix to the "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" power and applying it to "},{"children":[{"kind":"text","text":"can"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next step is to fix an edge with maximal "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" on our shortest path, let it be "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". We know all the vertices we can be at moment "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", so we need to calculate the shortest path to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 using edges we can go through. We can even use Floyd algorithm to calculate that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The complexity of this solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")) and it's not enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next observation is that adjacency matrix contains only zeroes or ones, so we can multiply these matrixes using bitsets in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":" / 32)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This makes complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") / 32), which gets accepted."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/6AtgHs8B"},"children":[{"kind":"text","text":"Source"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Task E. Div1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's solve an easier task first: independent of bipartivity, the color of edge changes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we could write a solution, which is pretty similar to solution of Dynamic Connectivity Offline task in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlog"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider only cases, where edges are not being deleted from the color graph. Then, we could use DSU with storing parity of the way to the parent along with parent. Now we can find parity of the path to the root by jumping through parents and xoring the parities. Also, we can connect two components by accurately calculating the parity of the path from one root to another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now edges are being deleted. For each edge and each color we know the segments of requests, when this edge will be in the graph of specified color. Let's build a segment tree on requests, in each vertex of the tree we store list of edges which exist on the subsegment. Every segment will be split into "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" parts, so, totally there would be "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" small parts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we can dfs this segment tree with DSU. We get inside the vertex, apply all the requests inside it, go through the children and revert DSU to initial state. We also answer requests in leafs of the segment tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's return to initial task. We can't use this technique, because we don't know the exact segments of edge existence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Instead, let's do following. Initially we add each edge right until the first appearance of this edge in requests. Now, when we're in some leaf, we found out which color this edge would be right until the next appearance of this edge. So, let's update this edge on that segment. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each leaf we're going to make an update at most once, so the complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nlog"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"http://pastebin.com/PjFbTB5v"},"children":[{"kind":"text","text":"Source"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If anything is unclear or bad-written, ask any questions."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/20226"}