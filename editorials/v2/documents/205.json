":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th digit of integer "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" (from left to right, starting from 0). Interate through all possible first digit "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" (which is the last at the same time) and through the length "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the number. Then if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 2 or ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 2 and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":") you need to add 10"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" to the answer. Otherwise, if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 2 and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" you need to add "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"' to the answer. Finally, if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 2 and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" add 1 to the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This problems also can be solved using DP."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/205/problem/D"},"children":[{"kind":"text","text":"205D - Little Elephant and Cards"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"It is nice to use the "},{"children":[{"kind":"text","text":"map"}],"kind":"emphasis"},{"kind":"text","text":" structure in this problem, but you can solve it without "},{"children":[{"kind":"text","text":"map"}],"kind":"emphasis"},{"kind":"text","text":" (using sorting and binary serach). Lets iterate through all possible colors that we have and suppose that this currect color is the one that will make our set funny. The minimal number through all this will be the answer. To find the minimal number of turns to make our set funny using current color we need to know two numbers: the number of cards with current color on the front side and the number of cards with the current color on back side (but not at the same time). Let it be integers "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) / 2 — the minimal number of the same cards required to get the funny set. Then if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" it is impossible to make set funny using current color at all. If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" then the answer is 0, otherwise the answer is "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/205/problem/E"},"children":[{"kind":"text","text":"205E - Little Elephant and Furik and Rubik"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem is to find the expected value. Important fact here is the linearity of the expected value. This means that we can for each element of the first strings find the probability that exactly this element will me matched with some other (but, of course, equal) from the second string. The answer will be the sum of all such probabilities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the current character of the first string be the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th character (1-based numeration). Firstly we try to solve problem in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") time. Namely, as it was said above, we need to find the number of such pairs of substrings that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th character (which is on probably some other position in substring) is the same as the corresponding character of the second substring. Iterate through all "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") such that "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". The number of such pairs of substrings that have match in that characters is "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1) (considering 1-based numeration). This is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"). And because we need to find the sum of such values for all possible "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", we can rewrite it as "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1), where "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equals to the sum of all integers "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") that "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Array "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" can be simply computed in a linear time. Analogically you should process all indices to the right from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After we know the number of pairs of substrings with the match with the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th character (let it be "},{"children":[{"kind":"text","text":"count"}],"kind":"emphasis"},{"kind":"text","text":"), the probability is "},{"children":[{"kind":"text","text":"count"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"total"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"total"}],"kind":"emphasis"},{"kind":"text","text":" is the total number of pair of substrings (it can be found by loop or with some simple formula)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The comlexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/204/problem/D"},"children":[{"kind":"text","text":"204D - Little Elephant and Retro Strings"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Firstly we should solve following subproblem: for each prefix find the number of it's fillings such that there is no consecutive block of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". Let it be "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is the index in of the last character if the prefix. Assing "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" = 2 if "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 'X' and 1 otherwise. After such assing there may be some bad filling included to "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"). Since we suppouse that "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - 1) is caclulated correctly, all bad filling must contain blocks of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" charcters "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" only at the end of the prefix (they may be included only if substring "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1.."},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" doesn't contain characters "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" and character "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is not "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"). So, if it's possible, we must subtract from "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") value "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1), because it's exactly the number of bad fillings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"With the same DP you should you calc the same values for suffixes (but this time changing "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" by "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" and vice versa). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we should carefully calculate the result in such way that now repeatings occur. Let iterate (from right to left) through all possible positions of the first blocks of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" (this means that we suppose that no block occur to the left). Using our DP we can simply find the number of fillings of all characters to the left from that block in such way that no another blocks of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" occur. Considering "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") solutions, we can iterate through all possible indexes of the begging of the last block of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" (again we suppose that this blocks must be the last and no another may occur to the right) and agin using our DP count the number of fillings to the right. We don't care what is between that blocks, so we just multiply answer by 2^(the number of characters "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" between blocks). But, since we are going from right to the left, we can just keep tracking on all possible last blocks and get "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") solution."}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/204/problem/E"},"children":[{"kind":"text","text":"204E - Little Elephant and Strings"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"To solve this problems we can use suffix array. More information about suffix arrays you can find in the Internet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, concatenate all strings into the one separating consecutive strings by some unique characters (it was also useful to not use strings, but arrays of integers). For example, three strings "},{"children":[{"kind":"text","text":"abc"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ab"}],"kind":"emphasis"},{"kind":"text","text":" may be concatenated in the following way: "},{"children":[{"kind":"text","text":"abc"}],"kind":"emphasis"},{"kind":"text","text":"#"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"@"},{"children":[{"kind":"text","text":"ab"}],"kind":"emphasis"},{"kind":"text","text":". Now we should build suffix array using this total string, this allows to us to sort all cyclic shifts of the string. After that each cyclic shift will either begin with additional character or the character from the input strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice now that to find the result we need to find for each cyclic shift (begging of which doesn't contain additional character) the largest size of it's prefix such that this prefix is substring of at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" different input strings. This value can be found by binary search, but for this we need some function "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":") which can answer the questions: how many input strings contain prefix of size "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" cyclic shift as a substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How to make "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":")? Look at all cyclic shifts, prefix of size "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" of which is equal to preifx of size "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"-th shift. Since all shifts are sorted lexicoraphically, this set of shifts can be represented as integral ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":";"},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] of indices of shifts (1 ≤ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"). How to find "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"? For each pair of consecutive shifts we can find it's greatest common prefix (using properties of suffix array). Than "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" can be found using RMQ. For "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" we need to know the rigthmost pair of shift (but to the left from "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") that their greatest common prefix is less than "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":". Analogically we can find "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". After that we have interval ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":";"},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] and we need to find the number of different input strings that belongs to the shifts from "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"-th to "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"-th (actually, we need to find the number of different integer on interval). But, notice that we dont need the exactly number of different integers, we need to know just it is at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" or not. So let "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] equals to the greatest "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") such that the number of different integers on interval ["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":";"},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is equal to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Then if "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] ≥ "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", obiously, interval ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":";"},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] will also contains at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" different. So "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":") is done."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only thing to done is to fill array "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":". This is pretty simple using "