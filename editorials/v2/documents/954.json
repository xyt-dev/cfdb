{"assets":["/editorial-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png","/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png","/editorial-assets/b91c7ab24b4a012b0a680e7d33381e69954f99575864419e68588b5c9d0ef19f.png","/editorial-assets/aea4bc8bf06b604776a8883befdafc488de483ee722e3e3363449b8f1b0dc8e3.png","/editorial-assets/38318cc102dc7ddd2653dbf167c696cea265297c3262c0fcf73def6fc54e0eab.png","/editorial-assets/aeec8d9d661635a97a48930583be71e079f0ef6a777823624eaf400970d8288d.png"],"contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"954A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/A"},"children":[{"kind":"text","text":"954A - Diagonal Walking"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's iterate over all characters of the string from left to right (excluding last character). Suppose "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is a position of the current element of the string. If "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":", increase answer by 1 and increase "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" by 2, else just increase "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" by 1."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/B"},"children":[{"kind":"text","text":"954B - String Typing"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's consider "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"; "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") as a substring of string "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" from position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to position "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is not included). Let's iterate over all lenghts of the copied prefix from "},{"attrs":{"alt":"","src":"/editorial-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png"},"kind":"image"},{"kind":"text","text":" to 0 inclusive, and then if "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"[0; "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":"; 2·"},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":") then answer will be "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" + 1) and iterating over smaller lenghts is not necessary."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/C"},"children":[{"kind":"text","text":"954C - Matrix Walk"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"You can notice that moves of kind ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") and ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") are changing value "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Thus, you can determine "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" by checking adjacent nodes in the path. The answer is YES if there are one or zero distinct values of differences not counting difference of 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can also set "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" to arbitrary big value, it doesn't really matter until you can fit all values. 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" will work just fine."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, knowing "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", simulate the process and check that all moves are valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/D"},"children":[{"kind":"text","text":"954D - Fight Against Traffic"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's use bfs to calculate the smallest distances to all vertices from the vertex "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and from the vertex "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". These will be "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":" is the the current smallest distance between "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". What you need is to iterate over all pairs ("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") and check if the edge between them doesn't exist and neither ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] + 1) nor ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"] + 1) is smaller than "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/E"},"children":[{"kind":"text","text":"954E - Water Taps"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The following greedy strategy work. Let's turn all the taps at full power. If total temperature is greater than "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" then we would like to decrease power on some taps with higher temperature. We want to decrease as low power as possible, so we should prioritize taps with the highest temperature. Sort all taps by temperature and find the total power on suffix you should decrease to have equal temperatures. This can be done with binary search. The same works for smaller initial temperature."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/F"},"children":[{"kind":"text","text":"954F - Runner's Problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"There is a simple dynamic programming solution that works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"). Let's try to improve it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, if there are no obstacles in some column "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and we have calculated the number of paths to every cell of the previous column, then we may get the values in column "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" by multiplying the vector of values in column "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 by the following matrix:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/b91c7ab24b4a012b0a680e7d33381e69954f99575864419e68588b5c9d0ef19f.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then we may use binary exponentiation to skip long segments without obstacles in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"logk"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is the length of the segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's try to modify this matrix if we have to forbid some rows. All we need to change is to set every value in "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th row to 0 if "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th row is forbidden. So we may skip long segments not only if they don't contain any obstacles, but also if the set of forbidden rows doesn't change on this segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the solution is the following: divide the whole matrix into 2"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1 segments by the endpoints of the obstacles, then in every segment the set of forbidden rows doesn't change (so we can skip it using fast matrix exponentiation)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954G"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/G"},"children":[{"kind":"text","text":"954G - Castle Defense"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly, if we may obtain reliability at least "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", then we may obtain reliability not less than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - 1 with the same number of archers. So we may use binary search and check whether we may obtain reliability at least "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How can we check it? Let's find the leftmost section such that its defense level is less than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Let its index be "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". We obviously have to add some archers controlling this section, and since every section to the left of it is already controlled, the best option where to add archers is the section with index "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). After we added enough archers, we move to next section such that its defense level is less than "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" and do the same. If we run out of archers without protecting all the sections, then it's impossible to obtain reliability "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do checking in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"), we may use prefix sums or \"sliding window\" technique."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954H"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/H"},"children":[{"kind":"text","text":"954H - Path Counting"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"At first when we read the problem, a simple solution comes to our mind, take a look at the LCA (Lowest Common Ancestor) of that starting and ending vertices of the path and then use combinatorics to calculate the number of the paths, but after trying to implement this or solve this on paper it doesn't seem to be easy at all and it may even be impossible to implement this. So lets try to solve this problem in a different way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For calculating the answer, we count the number of times each path starts or ends at every vertex, and then divide them by 2 to get the answer for each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For calculating the answer to the above, it is easy to see that all vertices with the same height have the same number of paths going through them, so if we calculate the number of paths going through one of them and then multiply it by the number of the vertices in that height (let it be "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") it gets equal to our answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can calculate the answer for a certain height. So to do that, we divide the paths into two types, paths that go only into the subtree of a vertex (let's call it "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), and paths that go up (let's call it "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the ones that are in the subtree, it is easy to see if there are at least "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" other vertices that go down, we can go all paths going down (let the number of them be "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), and the answer for this part, equals to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/aea4bc8bf06b604776a8883befdafc488de483ee722e3e3363449b8f1b0dc8e3.png"},"kind":"image"},{"children":[{"kind":"text","text":"For the ones that go up, we use dynamic-programming, and we define "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the number of paths that start at a vertex with height "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" and have length "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and do not use the leftmost edge exiting the vertex at height "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":". To update this either we go down on one of the "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1 paths and then we go through a path of length "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1, or we go up and get a path of length "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1 starting at a vertex from height "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"kind":"text","text":" - 1, so the answer for this one equals to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/38318cc102dc7ddd2653dbf167c696cea265297c3262c0fcf73def6fc54e0eab.png"},"kind":"image"},{"children":[{"kind":"text","text":"Now "},{"attrs":{"alt":"","src":"/editorial-assets/aeec8d9d661635a97a48930583be71e079f0ef6a777823624eaf400970d8288d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And the final complexity of the solution will be "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"), but because of the large constant of the solution the time limit is higher."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"954I"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/954/problem/I"},"children":[{"kind":"text","text":"954I - Yet Another String Matching Problem"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Unfortunately, it seems we failed to eliminate bitset solutions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The approach in our model solution is the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, let's try to find some \"naive\" solution for calculating the distance between two strings. We may build an undirected graph where vertices represent letters, and edges represent that one letter must be transformed into another. Then all letters in the same component should become one letter, so the answer is the number of distinct letters minus the number of components."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then let's get back to original problem. For every substring of "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" we have to find which letters have to be merged to make it equal with "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":". This can be done with the help of FFT: to find all positions in substrings of "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" with character "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" that coincide with occurences of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":", we may compute a convolution of two following arrays: set 1 to every position in "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" where occurs "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", and to every position in "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" occurs (all other elements should be 0). After trying these convolutions for every pair of different characters, we compute the answer for every substring using DFS (or any other method)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/58519"}