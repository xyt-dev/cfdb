ext":") < "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":", then answer is "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(2 * "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"), else answer is  - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author solution: "},{"attrs":{"href":"https://codeforces.com/contest/350/submission/4632352"},"children":[{"kind":"text","text":"4632352"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/350/problem/B"},"children":[{"kind":"text","text":"350B - Resort"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input data represents a graph, by using a array of parents of every vertex. Because every vertex has at most one parent, we can use following solution: we will go up to parent of vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"prev"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"]) until not found vertex with the outcome degree  ≥ 2. It is better to calculate outcome degrees in advance. After all, we will update the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This algorithm works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author solution: "},{"attrs":{"href":"https://codeforces.com/contest/350/submission/4632399"},"children":[{"kind":"text","text":"4632399"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/350/problem/C"},"children":[{"kind":"text","text":"350C - Bombs"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all, Let's sort all point by increasing of value |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"| + |"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"|, all points we will process by using this order. We will process each point greedily, by using maximum six moves. Now we want to come to the point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). Let's "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≠ 0. Then we need to move exactly |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"| in the "},{"children":[{"kind":"text","text":"dir"}],"kind":"emphasis"},{"kind":"text","text":" direction (if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" < 0 the dir is "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" > 0 — "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"). Similarly we will work with "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"-coordinates of point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). Now we at the point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"), let's pick a bomb at point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). After that we should come back to point (0, 0). Why it is correct to sort all point by increasing of "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Taxicab_geometry"},"children":[{"kind":"text","text":"Manhattan distance"}],"kind":"link"},{"kind":"text","text":"? If you will look at the path that we have received, you can notice that all points of path have lower Manhattan distance, i.e. we will process this points earlier."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution works in "},{"attrs":{"alt":"","src":"/editorial-assets/cc3c1ecb1b0469c6167f8e23f30d6c7baf9660af42fe8381854b550eac1ce3cc.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Authors solution: "},{"attrs":{"href":"https://codeforces.com/contest/350/submission/4632478"},"children":[{"kind":"text","text":"4632478"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/350/problem/D"},"children":[{"kind":"text","text":"350D - Looking for Owls"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"It's possible to solve this problem by using only integer calculations. Normalization of the line "},{"children":[{"kind":"text","text":"Ax"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"By"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" is following operation: we multiply our equation on the value "},{"attrs":{"alt":"","src":"/editorial-assets/65a4ee2c1ffe16ee552e903628a34daacecece5c29bdad31979ce28d893d690e.png"},"kind":"image"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"gcd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":")), if "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" < 0 ("},{"children":[{"kind":"text","text":"orA"}],"kind":"emphasis"},{"kind":"text","text":" = 0"},{"children":[{"kind":"text","text":"andB"}],"kind":"emphasis"},{"kind":"text","text":" < 0) then "},{"children":[{"kind":"text","text":"sgn"}],"kind":"emphasis"},{"kind":"text","text":" equals to  - 1, else sgn equals to 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now the solution. We will have two maps (map<> in С++, TreeMap(HashMap) in Java) to a set of points (it's possible that some points will have multiply occurrence into the set). In first map we will store right boundaries of the segments, in second — left boundaries (in increasing order)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In advance for every segment we will build a normalized line, and for this normalized line we will put in our maps left and right segments of the segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After all, for every fixed line let's sort our sets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's fix two different circles. After that, let's check that distance beetween them is greater then sum their radiuses, also you should check that circles has same radius. We can assume that we builded a line between centers of circles ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1) and ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2). Perpendicular to this line will have next coefficients (center of the segment [("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1), ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2)] also will belong to the next line) "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" = 2("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2), "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" = 2("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2), "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" =  - (("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2) * ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2) + ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2) * ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2)). After that you need to calculate values "},{"children":[{"kind":"text","text":"cntL"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cntR"}],"kind":"emphasis"},{"kind":"text","text":" by using binary search on set of points that lie on this line. "},{"children":[{"kind":"text","text":"cntL"}],"kind":"emphasis"},{"kind":"text","text":" — amount of left boundaries that lie on the right side of point (("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2) / 2, ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2) / 2), "},{"children":[{"kind":"text","text":"cntR"}],"kind":"emphasis"},{"kind":"text","text":" -- amount of right boundaries that lie on the left side of the point (("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2) / 2, ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2) / 2). After that you should add to answer value "},{"children":[{"kind":"text","text":"cntV"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cntR"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cntL"}],"kind":"emphasis"},{"kind":"text","text":",l where "},{"children":[{"kind":"text","text":"cntV"}],"kind":"emphasis"},{"kind":"text","text":" — amount of segments, that lie on the nolmalized line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Total complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/5fe2a2d424e0341c7421d94497d7b5322e4f1fce52d17388fe942e01e87c6090.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"solution: "},{"attrs":{"href":"https://codeforces.com/contest/350/submission/4632546"},"children":[{"kind":"text","text":"4632546"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/350/problem/E"},"children":[{"kind":"text","text":"350E - Wrong Floyd"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's do the following: construct the graph with the maximum possible number of edges and then remove the excess. First of all, you can notice that if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" answer is  - 1. Else let's fix some marked vertex, for example "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":". Let's put in our graph all edges except edges beetween "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" — an another marked vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, why this algorithm is correct? If Valera's algorithm is wrong, then there are a ''bad'' pair of vertexes (i, j). ``Bad'' pair is a pair for that Valera's algorithm works wrong. So, there are not marked vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" on the shortest path from i to j, and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Without loss of generality, we can assume, that distance beetween "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" equals to 2, but Valera's algorithm gives greater answer. There are some cases, that depends on the type of vertexes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". But we can look only at the case where ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") are marked vertexes. First, add to the graph all edges beetween not fixed ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") vertexes. Second, add to the graph edges beetween some fixed vertex ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") and some not marked vertex. Third, add to the graph edges beetween "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and some marked vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". It's simple to understand, that if we add some another edge, the Valera's algorithm will work correctly. Total amount of edges is "},{"attrs":{"alt":"","src":"/editorial-assets/f5de3e9d70d2c95af173126a0740c54807f9a708cdd37791cdea48eeb3b3bfd7.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"BONUS"}],"kind":"strong"},{"kind":"text","text":" Simple bonus. For same contrains ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") can you build a graph, where Valera's code works correctly? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Код: "},{"attrs":{"href":"https://codeforces.com/contest/350/submission/4632600"},"children":[{"kind":"text","text":"4632600"}],"kind":"link"},{"kind":"text","text":" "}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/9042"}