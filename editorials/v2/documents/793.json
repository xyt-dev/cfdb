ildren":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" number that divides k. "},{"attrs":{"alt":"","src":"/editorial-assets/5df237cff376e90fc733f71959c5f9dd93a051b72e02a2b7932030364d78d9cd.png"},"kind":"image"},{"kind":"text","text":", then for "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") solve other query part."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now time complexity is: "},{"attrs":{"alt":"","src":"/editorial-assets/e1ffd92a7a88ad1b956b847ec21b7301b62837df01f787c083d854e541ac3cb6.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Optimal choice of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/editorial-assets/1300517920598d1a4a05931bfa6f27e7200862dc66991e85975b9f6a2f52c68b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"793G"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/793/problem/G"},"children":[{"kind":"text","text":"793G - Oleg and chess"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Naive solution: Make bipartite graph, there is edge "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" → "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" only if cell ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") is free."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then answer is maximum matching."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But this solution time complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To get faster solution, let's cut our field into rectangles that are free of occupied cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will go from left to right wth line sweep and store all vertical free spaces to the left of the line in the set. Triples ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") — from "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 to "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2 border of free space is "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". When we meet rectangle ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2), we should take everything that lies between "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2 in the set, seperate boundary segments, throw out everything that lies inside, construct new rectangles, and add ("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2 + 1) to the set. We will have "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") rectangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then for each rectangle ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2) we need to add for all vertices from left part from "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1 to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2 edges to all verticles of right part from "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1 to "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's build segment tree for all verticles of left part, and another segment tree for all vertices from right part."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then to add rectangle of free cells to our graph, lets split segment ["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"1;"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"2] into "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" vertices in segment tree of left part, and segment ["},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"1;"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"2] into "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" in segment tree of right part."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then for all pairs of these vertixes add edge with capacity ∞."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all vertices of left segment tree add edges from them to their parents with capacity ∞."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all vertices of right segment tree add edges from their parents to them with capacity ∞."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all leafs of the left segment tree add edge from source to them with capacity 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all leafs of the right segment tree add edge from them to sink with capacity 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then max flow in this graph is the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Why does this work fast?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At first let's try the Edmonds–Karp algorithm. It works in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nE"}],"kind":"emphasis"},{"kind":"text","text":") in this task, where "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" — is the number of edges, "},{"attrs":{"alt":"","src":"/editorial-assets/a940704efd0be8e3d2f7870fa74319aff64750b2c5515774462238c341103dc9.png"},"kind":"image"},{"kind":"text","text":". In the given constraints "},{"children":[{"kind":"text","text":"E"}],"kind":"emphasis"},{"kind":"text","text":" is bounded by value about several million, because the rectangles do not intersect. This gives complexity about 10"},{"children":[{"kind":"text","text":"10"}],"kind":"superscript"},{"kind":"text","text":", and indeed, this algorithm passes, but very close to the time limit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's not try Dinic algorithm. We can prove (using a theorem that is known as Karsanov theorem in Russian) that, similar to matching search, the Dinic algorithm has no more than "},{"attrs":{"alt":"","src":"/editorial-assets/5765783c370f76a8199ad12f54a5947b7e3a12c3809adfc9a8c2f4ac52f41261.png"},"kind":"image"},{"kind":"text","text":" phases. With the use of the same bound on the edges number, we can get around 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" operations that is ok. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also there are alternative solution with sparse table."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/51685"}