":"text","text":" and push these values to heap. When finished, "},{"children":[{"kind":"text","text":"dist"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" will be equal to the shortest path."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/z11zpAWA"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"E. Max History"}]},"children":[{"children":[{"kind":"text","text":"Hint 1: Count the number of times each number appears in the sum of all "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hint 2: Try to find a sufficient and necessary condition that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" appears in "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of a permutation."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"More hints"}]},"children":[{"children":[{"kind":"text","text":"Hint 3: Prove that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" appears if and only if all elements appearing before it are strictly less than it (other than the largest element). And then try to solve the problem first in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now try to solve to simplify your solution with "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"It is easy to see that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th element appears in "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" if and only if all elements appearing before it in the array are less than it, so if we define "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the number of elements less than "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the answer will be equal to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/9dad33c7e7b90291b20351e3c6bede8e145ee40392ad8a533df6e2fd7cdc41f5.png"},"kind":"image"},{"children":[{"kind":"text","text":"By determining the index of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", if it is on the index "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" then we have to choose "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1 of the "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" elements smaller than it and then permuting them and then permuting the other elements. We can find all "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with complexity of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). If we were to implement this, the complexity would equal to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's make our formula better. So let's open it like so:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/4d86b318ba4da41ff59c292d2dd826f118b70e7802cefcfe8db682f47a4601dd.png"},"kind":"image"},{"children":[{"kind":"text","text":"and then it equals to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/410e0d7bc449bc22f87bab5c0735a999813c5887199b30121cb508eb25ee91b7.png"},"kind":"image"},{"children":[{"kind":"text","text":"and now let's take out the "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"! ,"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/b52ad2b10626fcfd611ff10de0f30d57867cf8607da735fbc80a83d428eaa5da.png"},"kind":"image"},{"children":[{"kind":"text","text":"now let's multiply the inside the first sigma by "},{"attrs":{"alt":"","src":"/editorial-assets/222ff35a7e34bc9d9605d69094f058bd8d3f76ab3fe595d3e1619324e70bb210.png"},"kind":"image"},{"kind":"text","text":" and the second sigma by ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1)! and it gets equal to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/21a3373385d82098d9948e687763d6c2c3c91d9f187aeaf888d10734dc3f3d0a.png"},"kind":"image"},{"children":[{"kind":"text","text":"and it is easy to see it equals to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/d36e02c137091d0488fff7c2709ba9c1dbe2325046818558d187ad11fddda1ef.png"},"kind":"image"},{"children":[{"kind":"text","text":"and using the fact that"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/7c9642d8e19a89f65cf33108afd936691ab51847d83a3cff74facf0f0571d886.png"},"kind":"image"},{"children":[{"kind":"text","text":"it will equal to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/6f43a05178a02e09c95fce8f1403ffc9a3fe0d6c4fb84b66efeaf4ec34dd9ea0.png"},"kind":"image"},{"children":[{"kind":"text","text":"So the final answer will equal to:"}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/16c48c7182054c47fe1fbd8506932044163b697b09966823980e932dc732890a.png"},"kind":"image"},{"children":[{"kind":"text","text":"of which can be easily implemented in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Make sure to not add the answer for maximum number in the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is also another solution that you can read "},{"attrs":{"href":"https://codeforces.com/blog/entry/57840"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/892Hp9jP"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"F. Erasing Substrings"}]},"children":[{"children":[{"kind":"text","text":"Let's denote "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = |"},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"|."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hint: There is a simple "},{"attrs":{"alt":"","src":"/editorial-assets/57a04fd35f027718dd41b65d37a5b7633101abcc9c886a6aeb61ea4f278ec60d.png"},"kind":"image"},{"kind":"text","text":" solution: "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"] — best answer if we considered first "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" characters of the string and a mask of erased substrings. However, storing a string as a result of each state won't fit neither into time limit nor into memory limit. Can we make it faster?"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Let's try to apply some greedy observations. Since each state represents a possible prefix of the resulting string, then among two states "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"] such that the lenghts of corresponding prefixes are equal, but the best answers for states are not equal, we don't have to consider the state with lexicographically greater answer. So actually for every length of prefix there exists only one best prefix we will get, and we may store a boolean in each state instead of a string. The boolean will denote if it is possible to get to corresponding state with minimum possible prefix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To calculate this, we iterate on the lengths of prefixes of the resulting string. When we fix the length of prefix, we firstly consider dynamic programming transitions that denote deleting a substring (since they don't add any character). Then among all states "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"] that allow us to reach some fixed length of prefix and have "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":" we pick the best character we can use to proceed to next prefix (and for a fixed state that's actually ("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1)-th character of the string)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is "},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":", but in fact it's pretty fast."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/K5cHmbgs"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"G. Shortest Path Queries"}]},"children":[{"children":[{"kind":"text","text":"This is a more complex version of problem G from Educational Round 27. You can find its editorial "},{"attrs":{"href":"https://codeforces.com/blog/entry/57840"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To solve the problem we consider now, you have to use a technique known as dynamic connectivity. Let's build a segment tree over queries: each vertex of the segment tree will contain a list of all edges existing in the graph on the corresponding segment of queries. If some edge exists from query "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" to query "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", then it's like an addition operation on segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] in segment tree (but instead of addition, we insert this edge into the list of edges on a segment, and we make no pushes). Then if we write some data structure that will allow to add an edge and rollback operations we applied to the structure, then we will be able to solve the problem by DFS on segment tree: when we enter a vertex, we add all edges in the list of this vertex; when we are in a leaf, we calculate the required answer for the corresponding moment of time; and when we leave a vertex, we rollback all changes we made there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What data structure do we need? Firstly, we will have to use DSU maintaining the distance to the leader (to maintain the length of "},{"children":[{"kind":"text","text":"some"}],"kind":"emphasis"},{"kind":"text","text":" path between two vertices). Don't use path compression, this won't work well since we have to do rollbacks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Secondly, we have to maintain the base of all cycles in the graph (since the graph is always connected, it doesn't matter that some cycles may be unreachable: by the time we get to leaves of the segment tree, these cycles will become reachable, so there's no need to store a separate base for each component). A convenient way to store the base is to make an array of 30 elements, initially filled with zeroes (we denote this array as "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"). "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th element of the array will denote some number in a base such that "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit is largest in the number. Adding some number "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" to this base is really easy: we iterate on bits from 29-th to 0-th, and if some bit "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is equal to 1 in "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] ≠ 0, then we just set "},{"attrs":{"alt":"","src":"/editorial-assets/4f2a83ad671fd24c451da4900c71db84431e3655a020cff21a8f3e46cc9dc613.png"},"kind":"image"},{"kind":"text","text":" (let's call this process "},{"children":[{"kind":"text","text":"reduction"}],"kind":"strong"},{"kind":"text","text":", we will need it later). If we get 0 after doing these operations, then the number we tried to add won't affect the base, and we don't need to do anything; otherwise, let "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" be the highmost bit equal to 1 in "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", and then we set "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"]:  = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This method of handling the base of cycles also allows us to answer queries of type 3 easily: firstly, we pick the length of some path from DSU (let it be "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":"), and secondly, we just apply "},{"children":[{"kind":"text","text":"reduction"}],"kind":"strong"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", and this will be our answer."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/C8v3YiEM"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/57840"}