{"assets":["/editorial-assets/f2758a23a4922ae0c705c1194f5564e9817e10582cef60bde86737ac0c23355f.png","/editorial-assets/178177e4a739534932e982f86b469b00e9cc24e762ffa23f0dabc6a6f21bfc6f.png","/editorial-assets/d3123dfba02a2d4631e626863d6bc61b79adca791850feb0e2033d4354022669.png","/editorial-assets/c184f803a3753f7906b88be324aec0b95305ea6f406445e6d8c732ba2fb31d93.png","/editorial-assets/8478e62ad97a200603eee1d9f970b496f76dc43ad47bcf52bab8dd93c35b97af.png","/editorial-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png","/editorial-assets/954b7a421e12bb3b077c6cb860b9f6a7d8f5719bd01fd3dc84a611334ded2a29.png","/editorial-assets/d042db7489605055bae0b483c16bf7eea2c6bb695abeb91b39a4f143e31dd0fa.png","/editorial-assets/b5048f286b197d0643fe0ab485b6c5a969be414c1ed08398437b513bef8bba7f.png","/editorial-assets/1ec5bd237767aaedf896475992cf9f21480f994c1ef1b275c23f0e7568f737ac.png","/editorial-assets/9dad33c7e7b90291b20351e3c6bede8e145ee40392ad8a533df6e2fd7cdc41f5.png","/editorial-assets/4d86b318ba4da41ff59c292d2dd826f118b70e7802cefcfe8db682f47a4601dd.png","/editorial-assets/410e0d7bc449bc22f87bab5c0735a999813c5887199b30121cb508eb25ee91b7.png","/editorial-assets/b52ad2b10626fcfd611ff10de0f30d57867cf8607da735fbc80a83d428eaa5da.png","/editorial-assets/222ff35a7e34bc9d9605d69094f058bd8d3f76ab3fe595d3e1619324e70bb210.png","/editorial-assets/21a3373385d82098d9948e687763d6c2c3c91d9f187aeaf888d10734dc3f3d0a.png","/editorial-assets/d36e02c137091d0488fff7c2709ba9c1dbe2325046818558d187ad11fddda1ef.png","/editorial-assets/7c9642d8e19a89f65cf33108afd936691ab51847d83a3cff74facf0f0571d886.png","/editorial-assets/6f43a05178a02e09c95fce8f1403ffc9a3fe0d6c4fb84b66efeaf4ec34dd9ea0.png","/editorial-assets/16c48c7182054c47fe1fbd8506932044163b697b09966823980e932dc732890a.png","/editorial-assets/57a04fd35f027718dd41b65d37a5b7633101abcc9c886a6aeb61ea4f278ec60d.png","/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png","/editorial-assets/4f2a83ad671fd24c451da4900c71db84431e3655a020cff21a8f3e46cc9dc613.png"],"contestId":"938","diagnostics":[],"document":{"children":[{"attrs":{"title":[{"kind":"text","text":"A. Word Correction"}]},"children":[{"children":[{"kind":"text","text":"Hint: When does some vowel stay in string?"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Iterate over the string, output only consonants and vowels which don't have a vowel before them."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/J0py2Gef"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"B. Run For Your Prize"}]},"children":[{"children":[{"kind":"text","text":"Hint 1: It's never profitable to go back. No prizes left where you have already gone."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Hint 2: The optimal collecting order will be: some prefix of prizes to you and the other prizes to your friend (some suffix)."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"You can find the total time with the knowledge of the prefix length. The final formula is "},{"attrs":{"alt":"","src":"/editorial-assets/f2758a23a4922ae0c705c1194f5564e9817e10582cef60bde86737ac0c23355f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://pastebin.com/mKhxYUxK"},"children":[{"kind":"text","text":"Model solution"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"spoiler"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"C. Constructing Tests"}]},"children":[{"children":[{"kind":"text","text":"Hint: At first we will solve the problem mentioned in the statement. The formula is "},{"attrs":{"alt":"","src":"/editorial-assets/178177e4a739534932e982f86b469b00e9cc24e762ffa23f0dabc6a6f21bfc6f.png"},"kind":"image"},{"kind":"text","text":". Firstly, each submatrix "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" should have at least one row with zero in it. Exactly "},{"attrs":{"alt":"","src":"/editorial-assets/d3123dfba02a2d4631e626863d6bc61b79adca791850feb0e2033d4354022669.png"},"kind":"image"},{"kind":"text","text":" non-intersecting submatrices fit in matrix "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". The same with the columns. So you should have at least this amount squared zeros."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Solution"}]},"children":[{"children":[{"kind":"text","text":"Now that you know the formula, you can iterate over "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and find the correct value. The lowest non-zero value you can get for some "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is having "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2. So you can estimate "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" as about "},{"attrs":{"alt":"","src":"/editorial-assets/c184f803a3753f7906b88be324aec0b95305ea6f406445e6d8c732ba2fb31d93.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's get "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" for some fixed "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/editorial-assets/8478e62ad97a200603eee1d9f970b496f76dc43ad47