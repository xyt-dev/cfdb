 "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]]. In that solution we use same idea, which is used to calculate binomial coefficients using Pascal's triangle. So overall solution will have complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury solution: "},{"attrs":{"href":"https://codeforces.com/contest/543/submission/11035704"},"children":[{"kind":"text","text":"11035704"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/543/problem/B"},"children":[{"kind":"text","text":"543B - Destroying Roads"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's solve easiest task. We have only one pair of vertices, and we need to calculate smallest amout of edges, such that there is a path from first of vertex to the second. It's clear, that the answer for that problem equals to shortest distance from first vertex to the second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's come back to initial task. Let's "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — shortest distance between "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". You can calculate such matrix using bfs from each vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we need to handle two cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"Paths doesn't intersects. In such way we can update the answer with the following value: "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"] (just in case wheh conditions on the paths lengths fullfills)."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Otherwise paths are intersecting, and the correct answer looks like a letter 'H'. More formally, at the start two paths will consists wiht different edges, after that paths will consists with same edges, and will finish with different edges. Let's iterate over pairs ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") — the start and the finish vertices of the same part of paths. Then we can update answer with the following value: "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":"] (just in case wheh conditions on the paths lengths fullfills)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please note, that we need to swap vertices "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", and recheck the second case, because in some situations it's better to connect vertex "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" with vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" with vertex "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". Solutions, which didn't handle that case failed system test on testcase 11. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury solution: "},{"attrs":{"href":"https://codeforces.com/contest/543/submission/11035716"},"children":[{"kind":"text","text":"11035716"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/543/problem/C"},"children":[{"kind":"text","text":"543C - Remembering Strings"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First that we need to notice, that is amout of strings is smaller then alphabet size. It means, that we can always change some character to another, because at least one character is not used by some string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that we need handle two cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"We can change exactly one character to another. The cost of such operation equals to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] (which depends on chosed column) After that we can remember string very easy."}],"kind":"list_item"},{"children":[{"kind":"text","text":"We can choose some column, and choose some set of strings, that have same character in that column, By one move we can make all these strings are easy to remember.The cost of such move equals to cost of all characters, except most expensive."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As the result, we will have following solution: d[mask] — answer to the problem, when we make all strings from set "},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":" easy to remember. We can calculate this dp in following way: let "},{"children":[{"kind":"text","text":"lowbit"}],"kind":"emphasis"},{"kind":"text","text":" — smallest element of set "},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":". It's clear, that we can do this string easy to remember using first or second move. So we need just iterate over possible columns, and try first or second move (in second move we should choose set that contain string "},{"children":[{"kind":"text","text":"lowbit"}],"kind":"emphasis"},{"kind":"text","text":") Overall complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"2"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" — is length of strings. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury solution: "},{"attrs":{"href":"https://codeforces.com/contest/543/submission/11035719"},"children":[{"kind":"text","text":"11035719"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/543/problem/D"},"children":[{"kind":"text","text":"543D - Road Improvement"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's suppose "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is a root of tree. Let's calculate extra dynamic programming "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] — answer to the problem for sub-tree with root "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" We can understand, that d[i] equals to the following value: "},{"attrs":{"alt":"","src":"/editorial-assets/bd679cbaffa6cb8978a85532164fdce3d32ce331673bce2f2e3aff8c20c4ce44.png"},"kind":"image"},{"kind":"text","text":" — where "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is a child of the vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". It's nice. After that answer to problem for first vertex equal to "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"[1]. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that let's study how to make child "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" of current root "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" as new root of tree. We need to recalculate only two values "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. First value we can recalculate using following formula "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]: "},{"children":[{"kind":"text","text":"suf"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] * "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"parent"}],"kind":"emphasis"},{"kind":"text","text":"], where "},{"children":[{"kind":"text","text":"parent"}],"kind":"emphasis"},{"kind":"text","text":" — is the parent of vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", (for vertex 1 "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"parent"}],"kind":"emphasis"},{"kind":"text","text":"] = 1), and array "},{"children":[{"kind":"text","text":"suf"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — is the product of values "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"], for all childs of vertex "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] have same definition, but "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"). And after we can calculate "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] as "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] * ("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + 1). That is all, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is root now, and answer to vertex "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" equals to current value "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury solution: "},{"attrs":{"href":"https://codeforces.com/contest/543/submission/11035737"},"children":[{"kind":"text","text":"11035737"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/543/problem/E"},"children":[{"kind":"text","text":"543E - Listening to Music"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's sort all songs in decreasing order. We will iterate over songs, and each time we will say, that now current song will fully satisfy our conditions. So, let's "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0, is song "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" was not processed yet and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1 otherwise. Let "},{"attrs":{"alt":"","src":"/editorial-assets/425ea9955fd38f7292b5660e89b2e9209aa1dc11eba2b7ea0e0664fa7655895f.png"},"kind":"image"},{"kind":"text","text":". It's clear, when we add new song in position "},{"children":[{"kind":"text","text":"idx"}],"kind":"emphasis"},{"kind":"text","text":" then we should do  + 1 for all on segment ["},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"(0, "},{"children":[{"kind":"text","text":"idx"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" + 1), "},{"children":[{"kind":"text","text":"idx"}],"kind":"emphasis"},{"kind":"text","text":"] in our array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". So, when we need to implement some data structure, which can restore our array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" to the position when all strings have quality  ≥ "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"},{"kind":"text","text":". It also should use very small amout of memory. So, answer to the query will be "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will store this data structure in the following way. Let's beat all positions of songs in blocks of length "},{"attrs":{"alt":"","src":"/editorial-assets/18cc6aa2fb5a5821c487baa2398d4e5e10cc7faffa1d2fb410447b773c2e3ac2.png"},"kind":"image"},{"kind":"text","text":". Each time, when we added about "},{"attrs":{"alt":"","src":"/editorial-assets/18cc6aa2fb5a5821c487baa2398d4e5e10cc7faffa1d2fb410447b773c2e3ac2.png"},"kind":"image"},{"kind":"text","text":" songs as good, we will store three arrays: first array will contain value "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" of first element of the block of indices. second array will contain maximum value of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" on each block and also we will keep about "},{"attrs":{"alt":"","src":"/editorial-assets/3e162769725563625433b8dc1fae4d57eaad14fcdbdb982e18968ff43e1f24a7.png"},"kind":"image"},{"kind":"text","text":" of ''small'' updates which doesn't cover full block. Using this information array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" will be restored and we process current query in easy way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury solution: "},{"attrs":{"href":"https://codeforces.com/contest/543/submission/11035739"},"children":[{"kind":"text","text":"11035739"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/17773"}