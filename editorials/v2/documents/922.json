hacks is palindromic!"}],"kind":"paragraph"},{"attrs":{"problemCode":"922A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/A"},"children":[{"kind":"text","text":"922A - Cloning Toys"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Consider a few cases:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = 0, the answer is always «No». "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = 1, then the answer «Yes» is possible only if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 0; if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" > 0, the answer is «No». "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can observe that the original was cloned "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - 1 times to produce the requested amount of originals, then the additional copies were created by cloning the copies emerged from cloning the original. As every cloning of a copy results in additional two, we need to check whether ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + 1) is divisible by 2. We also need to take care of the case when ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + 1) is less than zero — in this case, the answer is also «NO»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036267"},"children":[{"kind":"text","text":"35036267"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"922B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/B"},"children":[{"kind":"text","text":"922B - Magic Forest"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Consider some triple ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":") for which "},{"attrs":{"alt":"","src":"/editorial-assets/cad10359b19645daa3c0b5c8b0bd136de95ca73c3eb1cff62fa09f1ae4c82777.png"},"kind":"image"},{"kind":"text","text":" holds. Due to xor invertibility, we can see that "},{"attrs":{"alt":"","src":"/editorial-assets/4ebf2f6e92f44a0226e72e6199cbde0d6f347b59ec3b1fd449cbef96ed0bd88f.png"},"kind":"image"},{"kind":"text","text":". So, we only need to iterate through two of three possible sides of the xorangle as the third can be deduced uniquely."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One could also apply some constant optimizations (and put some pragmas) get "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") solution with small constant accepted."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036334"},"children":[{"kind":"text","text":"35036334"}],"kind":"link"},{"kind":"text","text":" "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" (bless pragmas): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036420"},"children":[{"kind":"text","text":"35036420"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"922C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/C"},"children":[{"kind":"text","text":"922C - Cave Painting"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Consider the way remainders are obtained."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Remainder "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1 can be obtained only when "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is taken modulo "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remainder "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 2 can either be obtained when taken modulo "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1 or "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Since the remainder modulo "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is already fixed, the only opportunity left is "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Proceeding this way, we come to a conclusion that if answer exists, then "},{"attrs":{"alt":"","src":"/editorial-assets/998b34ffc3e09538e1ba3dfddbbf3fda3bd111d50e42be73d0059365b55bad14.png"},"kind":"image"},{"attrs":{"alt":"","src":"/editorial-assets/4ea03d4a6a0b155adc720e24396e6908d0d6aa35d3437fd1eb078304b0bd8490.png"},"kind":"image"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 holds. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This condition is equal to ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) mod "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" = 0, i. e. ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) should be divisible by all numbers between 1 and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". In other words, ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) must be divisible by their LCM. Following the exponential growth of LCM, we claim that when "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is huge enough, the answer won't exists (more precisely at "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 43). And for small "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" we can solve the task naively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/802a91f2239f1e2490ace8457e8c71046738e220e84fe2ec2d6843a4999fe962.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036537"},"children":[{"kind":"text","text":"35036537"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"922D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/D"},"children":[{"kind":"text","text":"922D - Robot Vacuum Cleaner"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Denote "},{"attrs":{"alt":"","src":"/editorial-assets/79a5699ec13416f2d37828e67596fcf58bb9272c9d89eabae0933cfe7c8caf4a.png"},"kind":"image"},{"kind":"text","text":" as the noise function. We are gonna sort the string set in the following way: for each pair ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") we will put "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" earlier if "},{"attrs":{"alt":"","src":"/editorial-assets/c713c9e7a01468b8aefa4c093933dd0425e079dc4b37bc74a14c670526358198.png"},"kind":"image"},{"kind":"text","text":". The claim is that the final concatenation will be optimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" be the number of subsequences "},{"children":[{"kind":"text","text":"sh"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" — in "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". Then "},{"attrs":{"alt":"","src":"/editorial-assets/af53f5084e6159717b56028800abe569c94957ebaa583a878dd616ffb451faf4.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/5b472828dd5caa43abd7625e080762a265298eb8f1bb022aa62f75774db0b5b6.png"},"kind":"image"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" are reduced, and the comparator turns into "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". This is almost equivalent to "},{"attrs":{"alt":"","src":"/editorial-assets/bd83ea368f5958fd21226e2e7606e6932cdaf3770e1029a4ac363227804a40c5.png"},"kind":"image"},{"kind":"text","text":" (except the degenerate case when the string consists of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" only), meaning that the sort is transitive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now suppose that this is all false and in the optimal concatenation for some pair of strings ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") the aforementioned statement doesn't hold. Then it can be easily shown that you can change their positions and the answer will only get better."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"children":[{"kind":"text","text":"Code:"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35053688"},"children":[{"kind":"text","text":"35053688"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"922E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/E"},"children":[{"kind":"text","text":"922E - Birds"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The problem can be solved by utilizing dynamic programming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us denote by "},{"attrs":{"alt":"","src":"/editorial-assets/84d98e81dd8cbbae564fda65855c23f9d1713bdeb3524f3bc1d4c77119635388.png"},"kind":"image"},{"kind":"text","text":" the maximum possible remaining amount mana for the state ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" stands for the number of nests passed by and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" stands for the number of birds summoned."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The base is "},{"attrs":{"alt":"","src":"/editorial-assets/7b6782516e50c4daff3817d244153da84e7633afbd8005de5457740031f42571.png"},"kind":"image"},{"kind":"text","text":" as we have passed by no nests, have summoned no birds and have "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" mana at our disposal in the beginning. Let us also initialize all other states with ∞."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The transitions are as follows: consider us having walked to the next nest and summoned "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" additional birds from there, therefore proceeding from the state ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") to ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":") (of course, it is reasonable to require that the answer for ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":") is not ∞). After we have proceeded, "},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":" units of mana would be replenished (taking summoned birds into consideration, the amount of mana at the moment is bounded above by "},{"children":[{"kind":"text","text":"W"}],"kind":"emphasis"},{"kind":"text","text":" + ("},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":")·"},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"). The summoning would cost us "},{"attrs":{"alt":"","src":"/editorial-assets/7906c14bf63bf7437cc8c1ea20e0365824df8ef0e1b5ff01f5349ddd2cd84a9c.png"},"kind":"image"},{"kind":"text","text":" mana. If after the replenishing and the summoning the remaining amount of mana is nonnegative, we update the answer for the state ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"): "}],"kind":"paragraph"},{"attrs":{"alt":"","src":"/editorial-assets/ad65215eb99f7350dc8daee577bce136dce2aeda33bb761408452ab1a5c788a5.png"},"kind":"image"},{"children":[{"kind":"text","text":"The answer is the maximal "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" among reachable states (those not equal to ∞)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/d7234e4d0f4b67094a85d419fb255dfe29977469a491afb599223c079fadcfdb.png"},"kind":"image"},{"kind":"text","text":". Note that the constant in the square is no more than "},{"attrs":{"alt":"","src":"/editorial-assets/3748278d06635a6a76de1e304597aec8ab893bd6ffdc06074ab96e9568ec73c2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" (backward dp): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036591"},"children":[{"kind":"text","text":"35036591"}],"kind":"link"},{"kind":"text","text":" "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" (forward dp): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35036674"},"children":[{"kind":"text","text":"35036674"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"problemCode":"922F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/922/problem/F"},"children":[{"kind":"text","text":"922F - Divisibility"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let the sought pairs be the edges in a graph with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices. Then the problem is reduced to finding such a vertex subset that the induced graph contains exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") be the number of edges in the graph on {1, 2, ..., "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"} and "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") be the number of divisors of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" (strictly less than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We claim that the answer always exists if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") (otherwise it's obviously NO). Let's enlighten it a bit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's find the minimum possible "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") ≥ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and try to paraphrase the problem: we have to throw away some vertices from the graph on "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" vertices to leave exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" edges. Note that the degree of vertex "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"attrs":{"alt":"","src":"/editorial-assets/53adfa85e3a6f89412154eac621355cce172e665e4ff2e2e4bf3fbdecd5b2341.png"},"kind":"image"},{"kind":"text","text":": hence the most interesting numbers for us are primes strictly larger than "},{"attrs":{"alt":"","src":"/editorial-assets/c9e2c5657f3c0f55ad990513e4233fcfed70a0ede8477b4c9408748e972eefa1.png"},"kind":"image"},{"kind":"text","text":" since their degree is equal to 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now it's time to expose the most important fact of the day: we claim that "},{"attrs":{"alt":"","src":"/editorial-assets/e6f9e8f5f3c1ce609f5f1143d60163e031c1c6a06143881be920d703527a051d.png"},"kind":"image"},{"kind":"text","text":". At the same time the number of primes greater than "},{"attrs":{"alt":"","src":"/editorial-assets/c9e2c5657f3c0f55ad990513e4233fcfed70a0ede8477b4c9408748e972eefa1.png"},"kind":"image"},{"kind":"text","text":", is about "},{"attrs":{"alt":"","src":"/editorial-assets/e3124c1d376c14a4f3c371819d3b5a319aaaa06870206e02c5b7f2bb877c01b5.png"},"kind":"image"},{"kind":"text","text":". Quite intuitive that asymptotically it's almost enough to throw only them away (there are only 16 possible counters and they all appear with "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 120 which could be solved manually). This observation is sufficient to get AC."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You could've chosen the parallel way and note that vertices greater than "},{"attrs":{"alt":"","src":"/editorial-assets/c9e2c5657f3c0f55ad990513e4233fcfed70a0ede8477b4c9408748e972eefa1.png"},"kind":"image"},{"kind":"text","text":" — do not share edges, therefore they can be thrown away independently (adding the statement from the previous paragraph, greedy approach will do). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You could've even written recursive bruteforce :D Summarizing the aforementioned, it works well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"Note that the solutions might not fully match the editorial, though the ideas are still the same."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" ("},{"attrs":{"href":"https://codeforces.com/profile/GreenGrape"},"children":[{"kind":"text","text":"GreenGrape"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35055945"},"children":[{"kind":"text","text":"35055945"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35055961"},"children":[{"kind":"text","text":"35055961"}],"kind":"link"},{"kind":"text","text":" "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" ("},{"attrs":{"href":"https://codeforces.com/profile/KAN"},"children":[{"kind":"text","text":"KAN"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35055995"},"children":[{"kind":"text","text":"35055995"}],"kind":"link"},{"kind":"text","text":" "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Code"}],"kind":"strong"},{"kind":"text","text":" ("},{"attrs":{"href":"https://codeforces.com/profile/xen"},"children":[{"kind":"text","text":"xen"}],"kind":"link"},{"kind":"text","text":"): "},{"attrs":{"href":"https://codeforces.com/contest/922/submission/35055977"},"children":[{"kind":"text","text":"35055977"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/57605"}