{"assets":["/editorial-assets/84794820dffcad1b6d46b3f6d05a8e4f5aeee75e031706e275e911d5a2c2d993.png","/editorial-assets/7f70e7c0c910098b5e87b59dc1e9924583be103abd9809d159e7dc7479c03ac1.png","/editorial-assets/8dce511da02ad94b1521cc64f2a0f35dcf3b4bf1644006a91f6b3c3bc3e30bd4.png"],"contestId":"748","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"748A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/A"},"children":[{"kind":"text","text":"748A - Santa Claus and a Place in a Class"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It can be easily seen that the side on which Santa should sit depends only on the parity of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", while the number of desk and the number of lane depend only on a value "},{"attrs":{"alt":"","src":"/editorial-assets/84794820dffcad1b6d46b3f6d05a8e4f5aeee75e031706e275e911d5a2c2d993.png"},"kind":"image"},{"kind":"text","text":". We can see that in such numeration the number of lane equals "},{"attrs":{"alt":"","src":"/editorial-assets/7f70e7c0c910098b5e87b59dc1e9924583be103abd9809d159e7dc7479c03ac1.png"},"kind":"image"},{"kind":"text","text":", while the number of desk equals "},{"attrs":{"alt":"","src":"/editorial-assets/8dce511da02ad94b1521cc64f2a0f35dcf3b4bf1644006a91f6b3c3bc3e30bd4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"748B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/B"},"children":[{"kind":"text","text":"748B - Santa Claus and Keyboard Check"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Denote the two strings from the input by "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":". It's enough to find all pairs of distinct "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and then do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Ensure that each symbol is in no more than one different pair, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Ensure that if symbol "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is in a pair with another symbol "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", then each occurrence of "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" on the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th place takes place iff "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", and vice versa. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If at least one of these conditions fails, there is no answer, otherwise, it's enough to print the obtained pairs."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"748C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/C"},"children":[{"kind":"text","text":"748C - Santa Claus and Robot"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Solution #1: denote by "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" the least possible number of points if the robot passed only "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" unit segments, and we assume that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" = 0. Thus, the answer to the problem is "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". It's clear that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for every "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", so for every "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" one can obtain that "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 1, where "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is the minimal of such indices that "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1... "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] can be a path from one point to another. That means two constraints:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1... "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] doesn't contain any L, or it doesn't contain any R; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" either "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1... "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] doesn't contain any U, or it doesn't contain any D. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This fact is offered to the reader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Such "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" can be found in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1) if we iterate over all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-s from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" and keep the last occurence of L, R, U and D. So one can, storing these occurences and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":" itself, implement the algorithm above and pass each test for "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution #2: since we know the way to determine whether the path is valid or not (from the first solution), let's find the longest prefix of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":" and say that that's a path to the first point of the required collection. Then we find the longest prefix of the remaining string and state that this is the shortest path from "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":", and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This greedy algorithm works (obviously, in linear time), since the first solution is in fact the same greedy algorithm applied to the reversed string."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"748D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/D"},"children":[{"kind":"text","text":"748D - Santa Claus and a Palindrome"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Imagine a palindrome split into substrings of equal size (say, "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Here is how it may look like:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ABC DEF XYX FED CBA"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We may notice a regular structure: each block, except the middle one, has its pair, which is the same string, but reversed. Here, the first block (ABC) is paired with the last (CBA), the second — with the first-but-last."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For now, let's assume that we take an even number of strings, so each string has its pair. Let's split given strings into groups; strings "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"rev"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":") belong to one group. Clearly, if "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is not a palindrome, we must make a pair with the string "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" with maximum value and the string "},{"children":[{"kind":"text","text":"rev"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":") with maximum value, until both strings exist and the sum of their values is nonnegative. If "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" is a palindrome, we will take two its occurrences with maximum value at a time (of course, again, if there are still at least two occurrences and the sum of values is nonnegative)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The trickiest part is the central block. Clearly, only the palindromic strings may be at the central block. However, there may be many of them, and we should select the one which gives the maximum value overall. There are several cases. Consider the point when you've taken the last pair from the list of "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"-s and stopped."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the value of the next element is nonnegative (say, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"), we may simply take it and say that "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is our possible score for "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" being in the center. We wouldn't make a valuable pair of it anyway. Otherwise we need to split the last taken pair. Denote the values of last taken strings as "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"). Note that "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" < 0, because otherwise it makes no sense to use "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" separately. If we take a pair, we get score "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":". If we take just the first element, we get score "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". So, in this case our possible score is  - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" (while "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" is already added to the main answer!)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, the central string will be the one with the maximum possible score, and its value should be added to the answer."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"748E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/E"},"children":[{"kind":"text","text":"748E - Santa Claus and Tangerines"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It is obvious that if the total number of slices is less than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", then the answer is  - 1. Otherwise it's at least 1. Let's find the answer in this case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's divide tangerines and parts in halves one by one in order to find the best answer. It's easy to see that it makes no sense to divide a part of size "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" if there is an undivided part of size "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". So we are going to proceed dividing the largest part on each step. Let's also maintain current answer, i. e. the size of the "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th biggest current part, and a set of parts which we are going to present to the pupils. When we divide the largest part, there are two possible cases: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the size of any part is less then the current answer, then it's obvious that the answer will never be greater if we proceed further, so we can stop the process. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the sizes of both parts are greater than or equal to the current answer, then we should delete the initial part and add the resulting parts to those we present to the pupils in the current answer, and then delete the smallest part from the set making it of size "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" again. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We can see that in the second case the answer never decreases so we can just proceed until the first case happens."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To emulate this process in a fast way, we can keep an array from 1 to "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" = 10"},{"children":[{"kind":"text","text":"7"}],"kind":"superscript"},{"kind":"text","text":" is the maximum possible number of slices in a part, where each cell contain the current number of parts of that size. Thus, we can maintain two pointers: one to the current answer and one to the current maximum size, so the whole process can be done in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). The overall complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"748F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/748/problem/F"},"children":[{"kind":"text","text":"748F - Santa Clauses and a Soccer Championship"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly, let's prove that there exists a vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" in the tree such that if we make it a root, all subtrees of its neighbours (which does not contain "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") contain no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" vertices in which some games are played (we call these vertices chosen further). We root the tree in some vertex "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":" and denote "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") the number of chosen vertices in the subtree of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":". Now we need to prove that there exists vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":") ≥ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" (then no more than "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" vertices outside subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" are chosen), but for all children "},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":" of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":") ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" holds. Assume there is no such vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", then each vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" has some child "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"' such that "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":"') > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". So we can build a sequence "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":", ... such that "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"0"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"root"}],"kind":"emphasis"},{"kind":"text","text":",  "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" is a child of "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". But obviously, at some point we will go to the leaf, which clearly has "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") ≤ 1. This leads us to a contradiction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This argument also gives us an easy way to find the desired vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":": just calculate "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":") for all subtrees of the rooted tree and then go from the root down, always going to the child with "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", at some point we will find that such vertex does not exist — then current vertex is the one we were looking for."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We claim that the answer to the original problem is always 1, i.e. we can always choose one vertex, where all teams will live. Consider vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" having "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":") ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" for all its children. We create a list of all chosen vertices, firstly we write all chosen vertices of the first child's subtree of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", then all chosen vertices of the second child's subtree, and so on. In the end, if "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is chosen too, we add it to the end of the list. Now we have a list of 2"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" vertices "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Let's create "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" pairs of the form ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Since for all children of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"to"}],"kind":"emphasis"},{"kind":"text","text":") ≤ "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" holds, the vertices which numbers in the list differ by "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" can not belong to the same subtrees, and thus the shortest path between "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" passes through the vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/49328"}