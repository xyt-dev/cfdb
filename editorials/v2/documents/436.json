}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":". Computing the sum of these smallest values can be done with a data structure like Cartesian tree or BIT."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The described solution has time completixy of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/436/problem/F"},"children":[{"kind":"text","text":"436F - Banners"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Tutorial author: "},{"attrs":{"href":"https://codeforces.com/profile/Gerald"},"children":[{"kind":"text","text":"Gerald"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/profile/Nerevar"},"children":[{"kind":"text","text":"Nerevar"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Task F was the hardest one in the problemset. To better understand the 