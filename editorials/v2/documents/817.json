{"assets":["/editorial-assets/513d6d36e3e902df74c17d0c40afe4aa0b13344e51651ba8654b9b9583294919.png","/editorial-assets/60370dde38b2469760e39f4fa2fcd31793ac4984cc96703076cdf3aaccee95bf.png","/editorial-assets/9132bfd3c2924b7a2ce55fbce5137174016d276326f6922b7059e36ce91e8d6d.png","/editorial-assets/0cd76d605c2ac5c467772ac682c3c5184041f72ff9f09ac1e3faf5e4472916cc.png","/editorial-assets/a591cf7406d7e3711c50aca6de1f31d43a2aa585d6de150f6e15cc254316b941.png","/editorial-assets/5618e3a010d5bcb630f477b5975b8cf5b656b16292bb5058396896cf8b9c8ef2.png","/editorial-assets/ab600f036336822b1c78c6321f48e22a3219f90097fb1b20c835bd6dd8b4aa24.png","/editorial-assets/1ee05d7c831b730a7e88ba6e229ba6d2be1d43f75a24f859c4bb472c010e627d.png","/editorial-assets/0f5710b61e253aed60c8c06f8650cfdbdfe3c243130312d812ab2bcee15ad0db.png","/editorial-assets/28036e98e856731403abac387c0581ed5f20371997997fb8d8fa24ee83151385.png"],"contestId":"817","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"We are really sorry for the issue with the testing system. We hope that it won't happen during next contests."}],"kind":"paragraph"},{"attrs":{"problemCode":"817A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/A"},"children":[{"kind":"text","text":"817A - Treasure Hunt"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Firstly, let's approach this problem as if the steps were "},{"attrs":{"alt":"","src":"/editorial-assets/513d6d36e3e902df74c17d0c40afe4aa0b13344e51651ba8654b9b9583294919.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/editorial-assets/60370dde38b2469760e39f4fa2fcd31793ac4984cc96703076cdf3aaccee95bf.png"},"kind":"image"},{"kind":"text","text":". Then the answer is \"YES\" if |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 0 and |"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to see that if the answer to this problem is \"NO\" then the answer to the original one is also \"NO\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's return to the original problem and take a look at some sequence of steps. It ends in some point ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"e"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Define "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as "},{"attrs":{"alt":"","src":"/editorial-assets/9132bfd3c2924b7a2ce55fbce5137174016d276326f6922b7059e36ce91e8d6d.png"},"kind":"image"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as "},{"attrs":{"alt":"","src":"/editorial-assets/0cd76d605c2ac5c467772ac682c3c5184041f72ff9f09ac1e3faf5e4472916cc.png"},"kind":"image"},{"kind":"text","text":". The parity of "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the same as the parity of "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". It is like this because every type of move changes parity of both "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the answer is \"YES\" if |"},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" = 0, |"},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"subscript"},{"kind":"text","text":"| "},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = 0 and "},{"attrs":{"alt":"","src":"/editorial-assets/a591cf7406d7e3711c50aca6de1f31d43a2aa585d6de150f6e15cc254316b941.png"},"kind":"image"},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" "},{"attrs":{"alt":"","src":"/editorial-assets/5618e3a010d5bcb630f477b5975b8cf5b656b16292bb5058396896cf8b9c8ef2.png"},"kind":"image"},{"children":[{"kind":"text","text":"mod"}],"kind":"emphasis"},{"kind":"text","text":" 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"817B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/B"},"children":[{"kind":"text","text":"817B - Makes And The Product"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Minimal product is obtained by multiplying three smallest elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's iterate over the middle element of these three and calc sum of all options."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly let's precalc two arrays of pairs — "},{"children":[{"kind":"text","text":"mnl"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"mnr"}],"kind":"emphasis"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"mnl"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] is minimum and number of its occurrences on the prefix of array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" up to index "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" inclusive. "},{"children":[{"kind":"text","text":"mnr"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"] is minimum and number of its occurrences on the suffix of array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" up to index "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" inclusive. It can be done with two traversals over the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's also store set of three elements which give minimal product of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider every index "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2 inclusive (0-indexed). If set ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"],  "},{"children":[{"kind":"text","text":"mnl"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1]."},{"children":[{"kind":"text","text":"first"}],"kind":"emphasis"},{"kind":"text","text":",  "},{"children":[{"kind":"text","text":"mnr"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1]."},{"children":[{"kind":"text","text":"first"}],"kind":"emphasis"},{"kind":"text","text":") is equal to the stored set of three minimums then add to the answer number of ways to choose pair ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":",  "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), that is "},{"children":[{"kind":"text","text":"mnl"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1]."},{"children":[{"kind":"text","text":"second"}],"kind":"emphasis"},{"kind":"text","text":" · "},{"children":[{"kind":"text","text":"mnr"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1]."},{"children":[{"kind":"text","text":"second"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"817C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/C"},"children":[{"kind":"text","text":"817C - Really Big Numbers"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's prove that if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is really big, then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 is really big too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the sum of digits of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 (let's call it "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1)) is not greater than "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") + 1, then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 - "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1) ≥ "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"), and if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") ≥ "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 - "},{"children":[{"kind":"text","text":"sumd"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1) ≥ "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". So if "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" is really big, then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1 is really big."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This observation allows us to use binary search to find the minimum really big number (let's call it "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":"). And if "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", then all numbers in the segment ["},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"] are really big and not greater than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", so the quantity of these numbers is the answer to the problem."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"817D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/D"},"children":[{"kind":"text","text":"817D - Imbalanced Array"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"First of all, we will calculate the sum of maximum and minimum values on all segments separatedly. Then the answer is the difference between the sum of maximum values and minimum values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How can we calculate the sum of minimum values, for example? For each element we will try to find the number of segments where it is the leftmost minimum element. So, we will calculate two arrays "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" means that "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is the maximum index such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" means that "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" is the minimum index such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). So actually, "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] represent the borders of the largest segment where "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the leftmost minimum element (and we need to exclude those borders). While knowing these values, we can calculate the number of subsegments where "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is the leftmost minimum element."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How can we calculate, for example, the array "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"? We will use a stack where we will store some indices in the array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" in such a way that, if we change all indices to the values in the array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", they will be in sorted order (the maximum element will be at the top of the stack, and the minimum — at the bottom). Let's calculate "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":" from the minimum index to the maximum. When we calculate "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], we remove all elements "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" from the stack (since the stack is \"sorted\", all these elements will be at the top of the stack, and when we encounter the first element "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", it is guaranteed that all elements below it don't need to be deleted). Then, if there's any element on top of the stack, it becomes the value of "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], then we push "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" into the stack. Since every element will be added (and deleted) not more than one time, the complexity of this algorithm is linear."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can apply the same technique to calculate the values of "},{"children":[{"kind":"text","text":"right"}],"kind":"emphasis"},{"kind":"text","text":" and the sum of maximums."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"817E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/E"},"children":[{"kind":"text","text":"817E - Choosing The Commander"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's use binary trie to store all personalities of warriors (that is, just use the trie data structure on binary representations of all "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). For each subtree of this trie you have to maintain the number of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"'s currently present in this subtree — when inserting a value of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we increase the sizes of subtrees on the path from the node with "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to the root by 1, and when removing "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", we decrease the sizes of subtrees on this path by 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How can it help us with answering the events of third type? We will descend the trie. When descending, we will try to find the number "},{"attrs":{"alt":"","src":"/editorial-assets/ab600f036336822b1c78c6321f48e22a3219f90097fb1b20c835bd6dd8b4aa24.png"},"kind":"image"},{"kind":"text","text":" in the structure. When we go to some subtree, we determine whether we add the quantity of numbers in the subtree we are not going into by checking if the current bit in "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is equal to 1 (if so, then for all numbers from this subtree their bitwise xor with the current commander's personality is less than "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). The answer to the event is the sum of sizes of all subtrees we \"added\" while descending into the trie."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"817F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/817/problem/F"},"children":[{"kind":"text","text":"817F - MEX Queries"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"There are many ways to solve this problem, you can use cartesian tree, segment tree, sqrt decomposition, maybe something else. I personally see the solution with the segment tree the easiest one so let me describe it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, let's notice that the queries are offline. So we can compress the numbers by taking "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":" + 1 of each query. MEX will be either one of these numbers or 1. So now we have numbers up to 2·10"},{"children":[{"kind":"text","text":"5"}],"kind":"superscript"},{"kind":"text","text":" and pretty basic task on segment tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first two types of queries are translated to \"assign value 1 or 0 on a segment\" (set the number on some position is either present or not). The third is \"for each "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in segment ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] assign "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"attrs":{"alt":"","src":"/editorial-assets/1ee05d7c831b730a7e88ba6e229ba6d2be1d43f75a24f859c4bb472c010e627d.png"},"kind":"image"},{"kind":"text","text":"\" (this will inverse the segment as described in statement)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Segment tree should keep sum of the segment in its nodes. XOR on segment will turn "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"val"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" is the length of the segment being covered by the node."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The leftmost zero cell is MEX."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While standing in some node "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":", check if its left son is full (has 1 in every cell of the segment, like "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" * 2] = "},{"children":[{"kind":"text","text":"mid"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"left"}],"kind":"emphasis"},{"kind":"text","text":" if you use 1-indexed tree and intervals for it). If it is full then go down to the right son, otherwise there exists some zero cell in a segment of the left child and you should go down to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should use lazy propagation to guarantee "},{"attrs":{"alt":"","src":"/editorial-assets/0f5710b61e253aed60c8c06f8650cfdbdfe3c243130312d812ab2bcee15ad0db.png"},"kind":"image"},{"kind":"text","text":" per query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"attrs":{"alt":"","src":"/editorial-assets/28036e98e856731403abac387c0581ed5f20371997997fb8d8fa24ee83151385.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/52638"}