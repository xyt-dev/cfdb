{"assets":["/editorial-assets/e6afec9805b839b18c32b0bd5a55b5e6fa9af198c7073559f4a88026fb1de444.png","/editorial-assets/801ed27a691ed597ff8b3703496e453d8fa0f900980a38ec9d64eeab83fbfa7c.png","/editorial-assets/6b252656b715abf46e0334011bd5b23e79d665ae6167727e7ee4e226425b875c.png","/editorial-assets/cc3c1ecb1b0469c6167f8e23f30d6c7baf9660af42fe8381854b550eac1ce3cc.png"],"contestId":"402","diagnostics":[],"document":{"children":[{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/402/problem/A"},"children":[{"kind":"text","text":"402A - Nuts"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's fix some value of boxes "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":". After that we can get exactly "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"(("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - 1) * "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") of sections. So, if "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" be an answer. After that you can use brute force to find smallest possible value of "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/402/problem/B"},"children":[{"kind":"text","text":"402B - Trees in a Row"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's fix height of the first tree: let's call it "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Of course, "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" is an integer from segment [1, 1000]. After that, for the fixed height "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" of the first tree we can calculate heights of the others trees: "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", and so on. After that you should find minimal number of operations "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" to achive such heights. After that we can use brute force to find smallest possible "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" for each "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" from 1 to 1000. For best height of the first tree you should print all operations."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/402/problem/C"},"children":[{"kind":"text","text":"402C - Searching for Graph"}],"kind":"link"},{"kind":"text","text":" / "},{"attrs":{"href":"https://codeforces.com/contest/403/problem/A"},"children":[{"kind":"text","text":"403A - Searching for Graph"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"I will describe