ng graph with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertexes, We will build 0-interesting graph, and after that we will add to it "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":" another edges, which is not in the graph. We will build 0-interesting graphs using the following approach: Let's took "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" disjointed components, from graphs with number of vertexes from 5 to 9, in such way that there are exactly "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertexes in graph."}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/402/problem/D"},"children":[{"kind":"text","text":"402D - Upgrading Array"}],"kind":"link"},{"kind":"text","text":" / "},{"attrs":{"href":"https://codeforces.com/contest/403/problem/B"},"children":[{"kind":"text","text":"403B - Upgrading Array"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"I will describe two solutions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First. Dynamic programming approach. Let's calculate an DP "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] — which is the best possible answer we can achieve, if current prefix has length "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and we used operation of Upgrading last time in position "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":". It is clear to understand, that we should iterate "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" to 1, and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". There are only two transitions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":"First, "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"], "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]) — we will not use operation of upgrading of array in the current position."}],"kind":"list_item"},{"children":[{"kind":"text","text":"Second, "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1] = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}