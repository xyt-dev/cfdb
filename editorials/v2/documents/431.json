nd":"line_break"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To quickly find for "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"[0] + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"[1] + ... + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" - 1] and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"[0] + ... + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" - 1], and perform queries of the first type, you can use the Fenwick tree. "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Асимптотика"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"qlog"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")) "},{"kind":"line_break"},{"children":[{"kind":"text","text":"Решение"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/431/submission/6676668"},"children":[{"kind":"text","text":"6676668"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/12369"}