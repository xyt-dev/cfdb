eue."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"!)"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/431/submission/6676695"},"children":[{"kind":"text","text":"6676695"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/431/problem/C"},"children":[{"kind":"text","text":"431C - k-Tree"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"This problem can be solved by dinamic programming."},{"kind":"line_break"},{"kind":"text","text":" Let's "},{"children":[{"kind":"text","text":"Dp[n][is]"}],"kind":"inline_code"},{"kind":"text","text":" — number of ways with length equals to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" in k-tree, where if "},{"children":[{"kind":"text","text":"is"}],"kind":"emphasis"},{"kind":"text","text":" = 1 — there is exists edge with length at least "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"is"}],"kind":"emphasis"},{"kind":"text","text":" = 0 — lengths of all edges less then "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":" Initial state "},{"children":[{"kind":"text","text":"Dp[0][0] = 1"}],"kind":"inline_code"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":" Transition — iterate all edges which can be first on the way in k-tree, then problem transform to the same, but with less length of the way (because subtree of vertex son is the k-tree)."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Dp[n][0] = Dp[n-1][0] + ... + Dp[n-min(d-1,n)][0]"}],"kind":"inline_code"},{"kind":"text","text":" "},{"children":[{"kind":"text","text":"Dp[n][1] = Dp[n-1][1] + ... + Dp[n-min(d-1,n)][1] + (Dp[n-d][0] + Dp[n-d][1]) + ... + (Dp[n-min(n,k)][0] + Dp[n-min(n,k)][1])"}],"kind":"inline_code"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See solution for more details."},{"kind":"line_break"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Complexity"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nk"}],"kind":"emphasis"},{"kind":"text","text":")"},{"kind":"line_break"},{"kind":"text","text":" Notice that this solution can be easy midify to "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":") complexity, only precalc partial sums. But it is not neccesary to solve this problem in such way."},{"kind":"line_break"},{"children":[{"kind":"text","text":"Solution"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/431/submission/6676700"},"children":[{"kind":"text","text":"6676700"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":2},"children":[{"attrs":{"href":"https://codeforces.com/contest/431/problem/D"},"children":[{"kind":"text","text":"431D - Random Task"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"We will search "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" by binary search. Such function is monotone, because the amount of numbers with exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" 1-bits on a segment "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 2 ... 2·("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) more or equal than amount of such numbers on segment "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1 ... 2·"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". Last statement is correct, because of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1 and 2·("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1) have equals number of 1-bits."},{"kind":"line_break"},{"kind":"text","text":" To find the amount of numbers on segment "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":"..."},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":", which have exactly "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" 1-bits, it is sufficient to can calculate this number for segment 1..."},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":", then the answer will be "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"(1..."},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"(1.."},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" - 1)."},{"kind":"line_break"},{"kind":"text","text":" Let's understand how we can calculate "},{"children":[{"kind":"text","text":"F"}],"kind":"emphasis"},{"kind":"text","text":"(1..."},{"children":[{"kind":"text","text":"X"}],"kind":"emphasis"},{"kind":"text","text":"). Iterate number of bit will be the first(from biggest to smallest) which is different in X and numbers, which amount we want to calculate. Let the first difference will be in "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit(it's possible, if in X this bit equals to 1, because we consider all numbers do not exceed X). Then other smallest bits we can choose in any way, but only amount of 1-bits must equals to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". We can do this in "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" ways, where "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":" — the number of 1-bits in X, bigger then "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" — binomailany factor. Finally, you should not forget about X (if it, of course, has k one bits)."},{"kind":"line_break"}],"kind":"paragraph"},{"kind":"code_block","text":"long long F( X )\n   Ans = 0 , cnt = 0;\n   for i = Max_Bit...0\n      if (bit(X,i) == 1) Ans += C[i][K - cnt] , cnt ++;\n   if (Bit_Counts(X) == K) Ans ++;   \n   return Ans;\n"},{"children":[{"children":[{"kind":"text","text":"Асимптотика"}],"kind":"strong"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"("},{"children":[{"kind":