:"text","text":" for first variant and ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" + 1) / "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" for second. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need to choose better variant, also we must keep in mind case of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" = 1."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/submission/12523744"},"children":[{"kind":"text","text":"Solutions"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/problem/C"},"children":[{"kind":"text","text":"570C — Replacement"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lets find how replacements occur. If we have segment of points with length "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":",we need "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - 1 operations and stop replacements for this segment. If we sum lenghts of all segments and its quantity then answer will be = total length of segments — quantity of segments. After change of one symbol length changes by 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Quantity of segments can be supported by array. Consider events of merging, dividing,creation and deletion of segments. For merging we need to find if both of neighbors(right and left) are points then merging occured and quantity of segments reduced by 1. Other cases can be cosidered similarly."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/submission/12523751"},"children":[{"kind":"text","text":"Solutions"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/problem/D"},"children":[{"kind":"text","text":"570D — Tree Requests"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need to write vertices in DFS order and store time of enter/exit of vertices in DFS. All vertices in subtree represent a segment. Now we can get all vertices in subtree v on height h as a segment, making two binary searches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can make a palindrome if quantity of uneven entries of each letter is less than 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This function can be counted for each prefix in bypass for each depth."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For saving the memory bit compression can be used considering that we need only parity and function is xor."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" * ("},{"children":[{"kind":"text","text":"log"}],"kind":"emphasis"},{"kind":"text","text":" + 26) + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"D had a offline solution too in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" * (26 / 32)) time and "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * 26 / 8) memory"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/submission/12523757"},"children":[{"kind":"text","text":"Solutions"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/problem/E"},"children":[{"kind":"text","text":"570E — Pig and Palindromes"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need palindrome paths. Palindrome is word which reads the same backward or forward. We can use it. Count the dynamic from coordinates of 2 cells, first and latest in palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From each state exists 4 transitions (combinations: first cell down/to the right and second cell up/to the left). We need only transitions on equal symbols for making a palindrome. Note that we need a pairs of cells on equal distance from start and end for each."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For saving memory we need to store two latest layers. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") — time and "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") — memory"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/570/submission/12523769"},"children":[{"kind":"text","text":"Solutions"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/19770"}