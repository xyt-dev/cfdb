,"children":[{"kind":"text","text":"29077251"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Python code: "},{"attrs":{"href":"https://codeforces.com/contest/835/submission/29077276"},"children":[{"kind":"text","text":"29077276"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Problem E. The penguin's game"}]},"children":[{"attrs":{"problemCode":"835E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/835/problem/E"},"children":[{"kind":"text","text":"835E - The penguin's game"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The solution can be separated into several parts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"I. Finding the parity of the number of special icicles in the given subset using 1 question."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the following cases: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Subset's size is even, the number of special icicles in it is even. Then the answer to such question is 0. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subset's size is even, the number of special icicles in it is odd. Then the answer to such question is "},{"attrs":{"alt":"","src":"/editorial-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subset's size is odd, the number of special icicles in it is even. Then the answer to such question is "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subset's size is odd, the number of special icicles in it is odd. Then the answer to such question is "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" ≥ 1 and "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" ≠ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", so the numbers 0, "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/editorial-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" are pairwise distinct. Therefore, we can find the parity of the number of special icicles on the given subset using 1 question."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"II. The solution for the problem for the only one special icicle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose we have "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" icicles, and one of them is special. Then you can find it using "},{"attrs":{"alt":"","src":"/editorial-assets/05473fdae25efcec3a6e815c6f7bf58848b7da7310559dfa226fe6a194058583.png"},"kind":"image"},{"kind":"text","text":" questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The algorithm is to use binary search over the minimum prefix that contains the special icicle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"III. The solution of our problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each integer "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 1000 can be written using no more than "},{"attrs":{"alt":"","src":"/editorial-assets/06eb08db4e2de1e7ff03d3100b4a19e9e2f03eec7921fdb1f4cffad82326a99d.png"},"kind":"image"},{"kind":"text","text":" bits. Iterate over the bits from 0 to "},{"attrs":{"alt":"","src":"/editorial-assets/ec936fb13aa8c22b43aa59cae6d386013edb5147ea81b578ef3641f0d293b276.png"},"kind":"image"},{"kind":"text","text":". Ask a question about the icicles that have 1 in their numbers in the fixed bit. After that, we can determine if the numbers of the special icicles differ in this bit. Really, the bits differ if this subset's size is odd, and don't differ otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Obviously, we will find at least one bit, where their numbers differ. Let "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" is the subset of the icicles that have 1 in this bit, and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is the complement set. Let "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" is the size of the smallest from these subsets. Then "},{"attrs":{"alt":"","src":"/editorial-assets/8d4ad3f4e4db7d8cc08e4b9f630b674c7c676437413fdfa7e29f890dfa54d189.png"},"kind":"image"},{"kind":"text","text":". Let's solve the problem for the only one special icicle for the smallest of these subsets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then it's easy to get the number of the other icicle: we know the number of the first icicle and we know in which bits the numbers differ and in which don't."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution uses 19 question. It can be proven that in the given constraints you can't solve this problem in less than 19 questions."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"C++ code: "},{"attrs":{"href":"https://codeforces.com/contest/835/submission/29077366"},"children":[{"kind":"text","text":"29077366"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Problem F. Roads in the Kingdom"}]},"children":[{"attrs":{"problemCode":"835F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/835/problem/F"},"children":[{"kind":"text","text":"835F - Roads in the Kingdom"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Observation I."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given graph is a cycle with hanged trees. So, we can remove the edge only from the cycle, the resulting graph will be a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Observation II."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can minimize the distances only between the pairs of vertexes such that path between them goes through the cycle's edges. Let's say that these pairs are interesting."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's find the cycle using dfs. Let its length be "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". Let's number the vertices in it from 1 to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" in round order. We will try to remove edges between 1 and 2, 2 and 3, ..., 1 and "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" and calculate the maximum distance between the interesting pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We need to pre-compute the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the maximum depth of the tree hanged to the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex of the cycle."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the length of the edge between the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex of the cycle and the next in the round order."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the maximum distance between the interesting pairs such that their vertexes are in the trees hanged to the vertexes 1, 2, ..., "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the cycle."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the maximum distance between the interesting pairs such that their vertexes are in the trees hanged to the vertexes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, ..., "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" of the cycle."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"far"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the maximum distance from the first vertex of the cycle to the vertexes that are in the trees hanged to the vertexes 1, 2, ..., "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the cycle."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"far"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — the maximum distance from the first vertex of the cycle to the vertexes that are in the trees hanged to the vertexes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1, ..., "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" of the cycle."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Also "},{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"far"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" =  - ∞."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"These pre-computations can be done in linear time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we delete the edge between the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th vertex of the cycle and the next in the round order, then the maximum distance between the interesting pairs is "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"far"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"far"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1], "},{"children":[{"kind":"text","text":"pref"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"], "},{"children":[{"kind":"text","text":"suff"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"diam"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1])."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After we found the optimal edge to remove, we remove it and find the diameter of the resulting tree. It can be done with 2 dfs'es. Let vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" be the farest from 1. Let vertex "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" be the farest from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". It's easy to prove that the path between "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" is the diameter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). Memory complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"children":[{"kind":"text","text":"C++ code: "},{"attrs":{"href":"https://codeforces.com/contest/835/submission/29077386"},"children":[{"kind":"text","text":"29077386"}],"kind":"link"}],"kind":"paragraph"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/53588"}