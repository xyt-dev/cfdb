{"assets":["/editorial-assets/8af70b7389f05d7bb9bcb5d0e6b93a4d4562dbe58d85fa205502d9f30b5e2aa6.png","/editorial-assets/3c0272df002c7512882e5425a191953828821cc10e9b5a4ca91064d651a1bc0a.png","/editorial-assets/72f19fcd5f1fbac44eb4c09b172d38747b97596f261f790d038fcffd5d29c2dd.png"],"contestId":"36","diagnostics":[],"document":{"children":[{"kind":"text","text":"Imagine that we have successfully processed first "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 bowls, i.e. we know height of the bottom "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" for every bowl "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" (1 ≤ "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"). Now we are going to place "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl. For each "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th already placed bowl, we will calculate the relative height of the bottom of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl above the bottom of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl, assuming that there are no other bowls. Lets denote this value by Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". It is obvious that height of the new bowl is equal to the maximal of the following values: "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"max"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":")."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Now I will describe how to calculate Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Firstly, consider two trivial cases:"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"I. "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":": bottom of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl rests on the top of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th. Then Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"II. "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":": bottom of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl reaches the bottom of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th. Then Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 0."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Then there are three slightly more complicated cases. "},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"1. "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":": bottom of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl gets stuck somewhere between the top and the bottom of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th,"},{"kind":"line_break"},{"kind":"text","text":"touching it's sides. From the similarity of some triangles we get that "},{"attrs":{"alt":"","src":"/editorial-assets/8af70b7389f05d7bb9bcb5d0e6b93a4d4562dbe58d85fa205502d9f30b5e2aa6.png"},"kind":"image"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"2. "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":": top of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl gets stuck somewhere between the top and the bottom of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th,"},{"kind":"line_break"},{"kind":"text","text":"touching it's sides. From the similarity of some triangles we get that "},{"attrs":{"alt":"","src":"/editorial-assets/3c0272df002c7512882e5425a191953828821cc10e9b5a4ca91064d651a1bc0a.png"},"kind":"image"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"3. "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":": sides of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bowl touch the top of "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"-th in it's upper points. Then "},{"attrs":{"alt":"","src":"/editorial-assets/72f19fcd5f1fbac44eb4c09b172d38747b97596f261f790d038fcffd5d29c2dd.png"},"kind":"image"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Note that, for example, cases 1 and 2 do not exclude each other, so the final value of Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is equal to the maximum of the values, computed in all three cases."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"Note that if the calculated value of Δ"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is negative, the result should be 0. Thanks to "},{"attrs":{"href":"https://codeforces.com/profile/adamax"},"children":[{"kind":"text","text":"adamax"}],"kind":"link"},{"kind":"text","text":" for pointing it."}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/774"}