{"assets":["/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"],"contestId":"675","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"Someday I will arrange C and D correctly :)"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/675/problem/A"},"children":[{"kind":"text","text":"675A - Infinite Sequence"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Firstly, in case "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" = 0 we should output YES if "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" else answer is NO."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" belongs to sequence "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" where k is non-negative integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So answer is YES if ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":") / "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" is non-negative integer else answer is NO."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"#include <bits/stdc++.h>\n \nusing namespace std;\n \nint main() {\n    int a, b, c;\n    cin >> a >> b >> c;\n \n    if (c == 0) {\n        if (a == b) cout << \"YESn\";\n        else cout << \"NOn\";\n    } else {\n        if ((b - a) % c == 0 && (b - a) / c >= 0) cout << \"YESn\";\n        else cout << \"NOn\";\n    }\n}\n"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/675/problem/B"},"children":[{"kind":"text","text":"675B - Restoring Painting"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"x a y"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"b m c"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"z d w"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number in the center may be any from 1 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" because number in the center belongs to all subsquares 2 × 2. So, let's find answer with fixed number in the center and then multiply answer by "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's iterate over all possible "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Sums of each subsquare 2 × 2 are the same so "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Similarly, "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This square is legal if 1 ≤ "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"z"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"w"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":". We should just check it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also we can solve this problem in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"#include <iostream>\n\nusing namespace std;\n\nint main() {\n    int n, a, b, c, d;\n    cin >> n >> a >> b >> c >> d;\n\n    long long ans = 0;\n    for (int x = 1; x <= n; x++) {\n        int y = x + b - c;\n        int z = x + a - d;\n        int w = a + y - d;\n        if (1 <= y && y <= n && 1 <= z && z <= n && 1 <= w && w <= n) {\n            ans++;\n        }\n    }\n    ans *= n;\n\n    cout << ans << endl;\n}\n\n"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/675/problem/C"},"children":[{"kind":"text","text":"675C - Money Transfers"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and should make all numbers in it be equal to zero with minimal number of operations. Sum of all "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" equals to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can divide array into parts of consecutive elements with zero sum. If part has length "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" we can use all pairs of neighbours in operations and make all numbers be equal to zero with "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" - 1 operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, if we sum number of operations in each part we get "},{"children":[{"kind":"text","text":"ans"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" where "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" is number of parts. We should maximize "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" to get the optimal answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the part consists of some prefix and probably some suffix. Each of other parts is subarray of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's calculate prefix sums. Each part has zero sum so prefix sums before each part-subarray are the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we can calculate "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" — number of occurencies of the most frequent number in prefix sums and answer will be equal to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bonus: how to hack solutions with overflow?"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"#include <bits/stdc++.h>\n\nusing namespace std;\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(0);\n\n    int n;\n    cin >> n;\n    map<long long, int> d;\n    long long sum = 0;\n    int ans = n - 1;\n    for (int i = 0; i < n; i++) {\n        int t;\n        cin >> t;\n        sum += t;\n        d[sum]++;\n        ans = min(ans, n - d[sum]);\n    }\n\n    cout << ans << endl;\n}\n\n"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/675/problem/D"},"children":[{"kind":"text","text":"675D - Tree Construction"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have binary search tree (BST) and should insert number in it with good time complexity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let we should add number "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Find numbers "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" which were added earlier, "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" is maximal possible, "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" is minimal possible (all will be similar if only one of this numbers exists). We can find them for example with std::set and upper_bound in C++."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We should keep sorted tree traversal (it's property of BST). So "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" must be right child of vertex with "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" or left child of vertex with "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" hasn't right child and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" hasn't left child. Hence lowest common ancestor (lca) of "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" doesn't equal to "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". So lca is between "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" in tree traversal. But it's impossible because "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" is maximal possible and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" is minimal possible. So "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" has right child or "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" has left child and we know exactly which of them will be parent of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That's all. Time complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"#include <iostream>\n#include <set>\n#include <map>\n\nusing namespace std;\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(0);\n\n    set<int> numbers;\n    map<int, int> left;\n    map<int, int> right;\n\n    int n, v;\n    cin >> n >> v;\n    numbers.insert(v);\n    for (int i = 0; i < n - 1; i++) {\n        cin >> v;\n        auto it = numbers.upper_bound(v);\n        int result;\n        if (it != numbers.end() && left.count(*it) == 0) {\n            left[*it] = v;\n            result = *it;\n        } else {\n            it--;\n            right[*it] = v;\n            result = *it;\n        }\n        numbers.insert(v);\n        cout << result;\n        if (i == n - 2) cout << 'n';\n        else cout << ' ';\n    }\n}\n\n"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/675/problem/E"},"children":[{"kind":"text","text":"675E - Trains and Statistic"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the indexation will be from zero. So we should subtract one from all "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Also let "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is sum of shortests pathes from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1... "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" = 0"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1 where "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" belongs to range from "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 to "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is maximal. We can find "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" with segment tree or binary indexed tree or sparse table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now answer equals to sum of all "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"#include <bits/stdc++.h>\n\nusing namespace std;\n\nconst int maxn = 1 << 18;\npair<int, int> tree[maxn * 2];\n\nvoid build(const vector<int> &a, int n) {\n    for (int i = 0; i < n; i++) tree[maxn + i] = {a[i], i};\n    for (int i = maxn - 1; i > 0; i--)\n        tree[i] = max(tree[i * 2], tree[i * 2 + 1]);\n}\n\nint get(int l, int r) {\n    pair<int, int> ans{-1, -1};\n    for (l += maxn, r += maxn + 1; l < r; l >>= 1, r >>= 1) {\n        if (l & 1) ans = max(ans, tree[l++]);\n        if (r & 1) ans = max(ans, tree[--r]);\n    }\n    return ans.second;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(0);\n\n    int n;\n    cin >> n;\n    vector<int> a(n);\n    a[n - 1] = n - 1;\n    for (int i = 0; i < n - 1; i++) {\n        cin >> a[i];\n        a[i]--;\n    }\n\n    build(a, n);\n    vector<long long> dp(n);\n    long long ans = 0;\n    dp[n - 1] = 0;\n    for (int i = n - 2; i >= 0; i--) {\n        int m = get(i + 1, a[i]);\n        dp[i] = dp[m] - (a[i] - m) + n - i - 1;\n        ans += dp[i];\n    }\n\n    cout << ans << 'n';\n}\n\n"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/44902"}