xt":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. If "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of their "},{"children":[{"kind":"text","text":"AND"}],"kind":"emphasis"},{"kind":"text","text":" equals 0, we face contradiction as "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] has to be 1 and algorithm ensures that in this situation, "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of both numbers will be set as 1. On the other hand, if "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of their "},{"children":[{"kind":"text","text":"AND"}],"kind":"emphasis"},{"kind":"text","text":" equals 1 then we conclude that "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit of both numbers equals 1 hence when calculating "},{"children":[{"kind":"text","text":"AND"}],"kind":"emphasis"},{"kind":"text","text":" of them, we get 1 in "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"-th bit which is a contradiction with our preliminary hypothesis. So we proved correctness of algorithm. "},{"attrs":{"alt":"","src":"/editorial-assets/01c6912a73725d1b808c0bfb6d211d85dc43f665a474f6a7a3b6cbccaa1304e4.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/245/submission/2607190"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/245/problem/E"},"children":[{"kind":"text","text":"E. Mishap in Club"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider following interpretation of problem. We're standing in (0, 0) at the center of Cartesian coordinate system. We iterate over the given sequence, for each  + , we move from ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") to ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" + 1) and for each  - , we move from ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":") to ("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" + 1, "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" - 1). Consider the maximum "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" coordinate we visit during our movement as "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" and minimum "},{"children":[{"kind":"text","text":"y"}],"kind":"emphasis"},{"kind":"text","text":" we visit as "},{"children":[{"kind":"text","text":"MIN"}],"kind":"emphasis"},{"kind":"text","text":". It's obvious that we need at least "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"MIN"}],"kind":"emphasis"},{"kind":"text","text":" people. It can be proved that we can take our moves in such a way that we exactly need "},{"children":[{"kind":"text","text":"MAX"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"MIN"}],"kind":"emphasis"},{"kind":"text","text":" people. For each  + , if there exists a person out of cafe who had entered cafe once or was in cafe once, we move him in, otherwise, we need a new person. The same argument holds for each  -  we see in sequence."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/245/submission/2607200"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/245/problem/F"},"children":[{"kind":"text","text":"F. Log Stream Analysis"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"First note that "},{"children":[{"kind":"text","text":"\"MESSAGE\""}],"kind":"emphasis"},{"kind":"text","text":" is useless and can be ignored. Year is always 2012 so it can be ignored too. Now convert each date and time to seconds past from beginning of 2012. Maintain a list, such as a vector, "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":", for storing seconds. Define pointer "},{"children":[{"kind":"text","text":"head"}],"kind":"emphasis"},{"kind":"text","text":" to be head of your vector. Define "},{"children":[{"kind":"text","text":"sec"}],"kind":"emphasis"},{"kind":"text","text":" to be conversion of date and time in seconds for the most recent log. As long as "},{"children":[{"kind":"text","text":"head"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"Size"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"head"}],"kind":"emphasis"},{"kind":"text","text":"] + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"sec"}],"kind":"emphasis"},{"kind":"text","text":", increase "},{"children":[{"kind":"text","text":"head"}],"kind":"emphasis"},{"kind":"text","text":". After that, push "},{"children":[{"kind":"text","text":"sec"}],"kind":"emphasis"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"Size"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"V"}],"kind":"emphasis"},{"kind":"text","text":"] - "},{"children":[{"kind":"text","text":"head"}],"kind":"emphasis"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" then answer is the current log. If at the end, no time was found, answer will be  - 1."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation Note"}],"kind":"strong"},{"kind":"text","text":": You may use "},{"children":[{"kind":"text","text":"stringstream"}],"kind":"emphasis"},{"kind":"text","text":" in order to ease implementation part. More information can be found "},{"attrs":{"href":"http://www.cplusplus.com/reference/iostream/stringstream/"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":" and "},{"attrs":{"href":"http://faculty.virginia.edu/comp-phys/phys2660/html/references/www.cppreference.com/cppsstream/all.html"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/245/submission/2610570"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/245/problem/G"},"children":[{"kind":"text","text":"G. Suggested Friends"}],"kind":"link"}],"kind":"heading"},{"children":[{"kind":"text","text":"Use "},{"children":[{"kind":"text","text":"map"}],"kind":"emphasis"},{"kind":"text","text":" in order to map people to numbers. Construct the given graph using adjacency list. Now, let's find answer for each vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Mark all of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"'s neighbors. After that iterate over all other vertices, and iterate over their adjacency list and count their mutual neighbors with "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" and update answer for "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":") for each vertex "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":". Summing up all complexities, we conclude that our algorithm is of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":") and as "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is of "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"), we can conclude that overall complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/245/submission/2610800"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"attrs":{"href":"https://codeforces.com/contest/245/problem/H"},"children":[{"kind":"text","text":"H. Queries for Number of Palindromes"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Note"}],"kind":"strong"},{"kind":"text","text":": Strings and arrays are considered 0-based in the following solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"isPal"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] be 1 if "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"..."},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] is palindrome, otherwise, set it 0. Let's define "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] to be number of palindrome substrings of "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"..."},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"]. Let's calculate "},{"children":[{"kind":"text","text":"isPal"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":"] in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":"). First, initialize "},{"children":[{"kind":"text","text":"isPal"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = 1 and "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] = 1. After that, loop over "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" which states length of substring and for each specific "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":", loop over "},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"kind":"text","text":" which states starting position of substring. "},{"children":[{"kind":"text","text":"isPal"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 1] can be easily calculated by the following formula:"}],"kind":"paragraph"},{"kind":"code_block","text":"isPal[start][start+len-1] = isPal[start+1][start+len-2] & (s[start] == s[start+len-1])\n"},{"children":[{"kind":"text","text":"After that, "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"len"}],"kind":"emphasis"},{"kind":"text","text":" - 1] can be calculated by the following formula which is derived from "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Inclusion-exclusion_principle"},"children":[{"kind":"text","text":"Inc-Exc Principle"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"kind":"code_block","text":"dp[start][start+len-1] = dp[start][start+len-2] + dp[start+1][start+len-1] - dp[start+1][start+len-2] + isPal[start][start+len-1]\n"},{"children":[{"kind":"text","text":"After preprocessing, we get queries "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and output "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1]. Overall complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Implementation"}],"kind":"strong"},{"kind":"text","text":": "},{"attrs":{"href":"https://codeforces.com/contest/245/submission/2622404"},"children":[{"kind":"text","text":"C++"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/5921"}