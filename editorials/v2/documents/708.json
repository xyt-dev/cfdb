 sums of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with fixed "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" and to hold the sum of "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" - 1]["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":"] for "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" (recall that "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"·"},{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". See code for details."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"sum"}],"kind":"emphasis"},{"kind":"text","text":"_"},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":"]["},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] is just prefix sums of what we calculated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So we obtain the solution with "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"nm"}],"kind":"emphasis"},{"kind":"text","text":") complexity."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"title":[{"kind":"text","text":"Code"}]},"children":[{"kind":"code_block","text":"class MAI {\npublic:\n\tvoid solve(std::istream& in, std::ostream& out) {\n\t\tint N, m;\n\t\tint a, b;\n\t\tint k;\n\t\tin >> N >> m >> a >> b >> k;\n\t\tusing Z = ZnConst<1000000007>;\n\t\tZ p = Z::valueOf(a) / b;\n\t\tZ q = 1 - p;\n\n\t\t// dp[r'] = sum l < r <= r' d[l][r]\n\t\tvector<Z> dp(m + 1, Z());\n\t\tdp[m] = 1;\n\n\t\tvector<Z> powersP(k + 1), powersQ(k + 1);\n\t\tpowersP[0] = powersQ[0] = 1;\n\t\tfor (int i: range(k)) {\n\t\t\tpowersP[i + 1] = powersP[i] * p;\n\t\t\tpowersQ[i + 1] = powersQ[i] * q;\n\t\t}\n\n\t\tvector<Z> fact = factorials<Z>(k + 1);\n\t\tvector<Z> invfact = fact;\n\t\tfor (auto& x: invfact) {\n\t\t\tx = 1 / x;\n\t\t}\n\n\t\tauto get_p_one_side = [&](int l) {\n\t\t\tif (l > k) {\n\t\t\t\treturn Z();\n\t\t\t}\n\t\t\treturn powersP[l] * powersQ[k - l] * fact[k] * invfact[l] * invfact[k - l];\n\t\t};\n\n\t\tfor (int iter: range(N)) {\n\t\t\tvector<Z> dp_one(m + 1, Z());\n\t\t\tZ sumPl, sumPlDpl;\n\n\t\t\tfor (int r: inclusiveRange(m)) {\n\t\t\t\t//new_d[l][r] = p[l] * p[n - r] * (have_something - dp[l] - dp[n - r])\n\t\t\t\tZ have_something = dp.back();\n\t\t\t\tdp_one[r] = get_p_one_side(m - r) * (\n\t\t\t\t\t\thave_something * sumPl - sumPlDpl - sumPl * dp[m - r]\n\t\t\t\t);\n\t\t\t\tsumPl += get_p_one_side(r);\n\t\t\t\tsumPlDpl += get_p_one_side(r) * dp[r];\n\t\t\t}\n\n\t\t\tfor (int i: range(m)) {\n\t\t\t\tdp_one[i + 1] += dp_one[i];\n\t\t\t}\n\n\t\t\tdp = move(dp_one);\n\t\t}\n\n\t\tout << dp.back();\n\t}\n};\n"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/46763"}