ext":"COD"}],"kind":"emphasis"},{"kind":"text","text":". After that you can find length of line "},{"children":[{"kind":"text","text":"ACDB"}],"kind":"emphasis"},{"kind":"text","text":". You can see that you don't need find places of points "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"D"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Div1 D."}],"kind":"strong"},{"kind":"text","text":" We will construct solution recursively. For every "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" it is possible construct parallelepiped "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" × ("},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" + 1) that contains 2 cubes "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". For "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" = 2 solution is obliviousо. How to build solutions for "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" > 2 is shown in following picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":" ","src":"/editorial-assets/1fd3a18a5a2646331d70749ccecee20316993660616ab5058960daed9c74eea3.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Red and blue cubes are start and end of chain. Firstly you should build one floor over. Then you should build 2 layers on two opposite sides."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" you can build parallelepiped "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1), and drop one layer for getting cube "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Div1 E."}],"kind":"strong"},{"kind":"text","text":" You can allocate all grippers as points on plane with coordinates (distance, mass). So, when you use some gripper, you are collecting grippers inside some rectangle with corner in origin. Let us collect grippers and put them into queue. For current gripper you should take all grippers from rectangle and store them into queue. Then you should take next gripper from queue and do some manipulations with them and so on. Well, now you need do it fast."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us create segment tree (for example, there you can use Fenwick tree) for dimention \"distance\". In every vertex of that tree you should store stack of points ordered by \"mass\". More details: every vertex of segment tree is some range of coordinates, and you should store in thet vertex points only from this range. At the top of every stack should be point with minimal mass. Well, let us put all points into tree. Every position is covered by no more thenм "},{"attrs":{"alt":"","src":"/editorial-assets/0f5710b61e253aed60c8c06f8650cfdbdfe3c243130312d812ab2bcee15ad0db.png"},"kind":"image"},{"kind":"text","text":" segmetns, therefore all tree will require "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":" of memory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you process query, you should extract points from some stacks and put them into queue. You can see that you may put some points into queue twice. To avoid this you should also put number of point into stack. So, when you are extracting point from stack you can check that it is the first extract using some array of flags."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution works in "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Author is "},{"attrs":{"href":"https://codeforces.com/profile/Ripatti"},"children":[{"kind":"text","text":"Ripatti"}],"kind":"link"},{"kind":"text","text":" ; the above solution was proposed by "},{"attrs":{"href":"https://codeforces.com/profile/RAD"},"children":[{"kind":"text","text":"RAD"}],"kind":"link"}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/4764"}