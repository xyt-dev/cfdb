"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Set $$$Q_i = 1$$$ if $$$P_i = N$$$,"},{"kind":"line_break"},{"kind":"text","text":"Set $$$Q_i = 1 + P_i$$$ if $$$P_i \\lt N$$$, otherwise "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Set $$$Q_i = P_{(i+1) \\mod N}$$$ "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/1998/submission/275547485"},"children":[{"kind":"text","text":"275547485"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1998/problem/C"},"children":[{"kind":"text","text":"1998C - Выполните операции и максимизируйте счёт "}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"My solution is a bit overkill, check out"}],"kind":"strong"},{"kind":"text","text":" "},{"attrs":{"href":"https://codeforces.com/profile/neal"},"children":[{"kind":"text","text":"neal"}],"kind":"link"},{"kind":"text","text":" submission "},{"attrs":{"href":"https://codeforces.com/contest/1998/submission/275613185"},"children":[{"kind":"text","text":"275613185"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Lets forget about $$$A_i$$$ and focus on $$$C_i$$$ first."},{"kind":"line_break"},{"kind":"text","text":"If we have and array of $$$N-1$$$ elements $$$A_i$$$ and binary array of $$$N-1$$$ elements $$$B_i$$$."},{"kind":"line_break"},{"kind":"text","text":"What is the maximum median we can get using atmax $$$K$$$ operations?"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"We can binary search for median."},{"kind":"line_break"},{"kind":"text","text":"We can directly count how many elements are more than mid, and how many elements we can make more than median."},{"kind":"line_break"},{"kind":"text","text":"Using segment tree, walk on segment tree and blah blah blah............"}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/1998/submission/275635373"},"children":[{"kind":"text","text":"275635373"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1998/problem/E1"},"children":[{"kind":"text","text":"1998E1 - Удаление шаров с помощью слияния (лёгкая версия)"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Notice that at any point all the elements are sum of continous subarray. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Define a function solve(L,R) which returns true, if we can convert element with weight $$$\\sum A_L+A_{L+1}+....+A_{R}$$$ into an element with weight $$$\\sum A$$$"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Use greedy, for fixed index $$$L$$$ and $$$R$$$, find a minimum $$$nxtL$$$ such that $$$\\sum A_{nxtL} + A_{nxtL+1} + ... + A_{L-1} \\le A_L+A_{L+1}+....+A_{R}$$$, make a direct jump to $$$nxtL,R$$$ segment. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"Do similar for $$$nxtR$$$, and memorise all the answer of solve function. "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/1998/submission/275608667"},"children":[{"kind":"text","text":"275608667"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Video editorial"}]},"children":[{"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/1998/problem/E2"},"children":[{"kind":"text","text":"1998E2 - Удаление шаров с помощью слияния (сложная версия)"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"For each element $$$j$$$ there is a range $$$(L_j,R_j)$$$ in which it can be present as last elemt."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Modify the Solve function to now return what is the minimum index $$$L_j$$$, instead of boolean earlier."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Basically find minimum $$$L_j$$$ such that element $$$j$$$ can become $$$\\sum A_1+A_2+...A_{Lj}$$$"}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 3"}]},"children":[{"children":[{"kind":"text","text":"Also for each index $$$i$$$ precalcute how much right it can go."},{"kind":"line_break"},{"kind":"text","text":"Use this to calculate $$$R_j$$$ based on $$$L_j$$$. "}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 4"}]},"children":[{"children":[{"kind":"text","text":"Otherway around you can also return this range in your solve function. "}],"kind":"paragraph"}],"kind":"spoiler"},{"children":[{"kind":"text","text":"My submission — "},{"attrs":{"href":"https://codeforces.com/contest/1998/submission/275619707"},"children":[{"kind":"text","text":"275619707"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"t