{"assets":["/editorial-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png","/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png","/editorial-assets/47d9f1d5b2c31fad2bd2883c2360e98bc93552b18d600f577b62a7fe56f2fe7a.png","/editorial-assets/79af2bf5ee837e761bc0589ff6430b2d34e941c5157adf7aa18af2670d1d3432.png","/editorial-assets/fe4bb253e10316f2d860a37c1418ba375eb7a50c3db9b0eedafa2618f34293b8.png","/editorial-assets/b5a51b610e6d36ee63408cd2a02b2c9e671d7f226b55f46a86ea6dbdec248ca8.png","/editorial-assets/29d89b0553e37a4b6d49263f79a0b3f8a0ca15b391d6a3c40483faa98d8b9969.png","/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png","/editorial-assets/59e8a81c53de538e8213256b0111e498d2172f4391375fb257b073ac1061467f.png","/editorial-assets/eb5ff07013ef81a0bbab90ae4e0647ea49e6dda91d0b0def4e75c42cfcf853d7.png","/editorial-assets/ec54bb0c710505ffe7cf8f885fa51f7c5499d4a77bf95d44a5a226ea7e614781.png","/editorial-assets/f5a09f3b7ec959fed464840fa08c0f86b17de36b386d28847052ff134533a089.png","/editorial-assets/aefef6786e5c997eb0b2e6810562363edfb6fc74aa70f8f7e50438d7a1be2ea7.png"],"contestId":"659","diagnostics":[],"document":{"children":[{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/A"},"children":[{"kind":"text","text":"659A — Round House"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the problem is calculated with a formula (("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" - 1 + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") "},{"attrs":{"alt":"","src":"/editorial-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png"},"kind":"image"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":") "},{"attrs":{"alt":"","src":"/editorial-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png"},"kind":"image"},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Such solution has complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is also a solution with iterations, modelling every of |"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"|'s Vasya's moves by one entrance one by one in desired direction, allowed to pass all the tests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution's complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":"|)."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/B"},"children":[{"kind":"text","text":"659B — Qualifying Contest"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider the participants from every region separately. So for every region we just need to sort all of its participants by their score in non-increasing order. The answer for a region is inconsistent if and only if the score of the second and the third participant in this order are equal, otherwise the answer is the first and the second participant in this order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/b432c23d334e09047956d9416408ed84e7b9667078e9ccc415a7466093cfb2a5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/C"},"children":[{"kind":"text","text":"659C — Tanya and Toys"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Our task is to take largest amount of toys Tanya doesn't have yet the way the sum of their costs doesn't exceed "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". To do that one can perform greedy algorithm: let's buy the cheepest toy Tanya doesn't have at every step, while the amount of money left are sufficient to do that. The boolean array "},{"children":[{"kind":"text","text":"used"}],"kind":"emphasis"},{"kind":"text","text":" can be a handle in that, storing "},{"children":[{"kind":"text","text":"true"}],"kind":"emphasis"},{"kind":"text","text":" values in indices equal to toy types which Tanya does have at the moment. As soon as 10"},{"children":[{"kind":"text","text":"9"}],"kind":"superscript"},{"kind":"text","text":" money is sufficient to buy no more than 10"},{"children":[{"kind":"text","text":"5"}],"kind":"superscript"},{"kind":"text","text":" toys "},{"attrs":{"alt":"","src":"/editorial-assets/47d9f1d5b2c31fad2bd2883c2360e98bc93552b18d600f577b62a7fe56f2fe7a.png"},"kind":"image"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"used"}],"kind":"emphasis"},{"kind":"text","text":" is enough to be sized 2 × 10"},{"children":[{"kind":"text","text":"5"}],"kind":"superscript"},{"kind":"text","text":" (we won't buy the toys with types numbered greater). So we just need to iterate over the number of type we want to buy, and if corresponding value in "},{"children":[{"kind":"text","text":"used"}],"kind":"emphasis"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"false"}],"kind":"emphasis"},{"kind":"text","text":", we should buy it, otherwise we can't."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/79af2bf5ee837e761bc0589ff6430b2d34e941c5157adf7aa18af2670d1d3432.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can use the <> data structure (C++ \\texttt{std::set}, for example), for storing the types Tanya has at the moment. In this case the complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/fe4bb253e10316f2d860a37c1418ba375eb7a50c3db9b0eedafa2618f34293b8.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/D"},"children":[{"kind":"text","text":"659D — Bicycle Race"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From the track description follows that Maria moves the way that the water always located to the right from her, so she could fall into the water only while turning left. To check if the turn is to the left, let's give every Maria's moves directions a number: moving to the north — 0, moving to the west — 1, to the south — 2 and to the east — 3. Then the turn is to the left if and only if the number of direction after performing a turn "},{"children":[{"kind":"text","text":"dir"}],"kind":"emphasis"},{"kind":"text","text":" is equal to the number before performing a turn "},{"children":[{"kind":"text","text":"oldDir"}],"kind":"emphasis"},{"kind":"text","text":" plus one modulo 4 "},{"attrs":{"alt":"","src":"/editorial-assets/b5a51b610e6d36ee63408cd2a02b2c9e671d7f226b55f46a86ea6dbdec248ca8.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This solution has complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can solve this problem in alternative way. Let the answer be equal to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" (that means that the number of inner corners of 270 degrees equals "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":", but the number of inner corners of 90 degrees to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":"). As soon as the sum of the inner corners' values of polygon of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices is equal to 180 × ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2), then "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" × 270 + ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") × 90 equals to 180 × ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 2). This leads us to "},{"attrs":{"alt":"","src":"/editorial-assets/29d89b0553e37a4b6d49263f79a0b3f8a0ca15b391d6a3c40483faa98d8b9969.png"},"kind":"image"},{"kind":"text","text":", being the answer for the problem calculated in "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(1)."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/E"},"children":[{"kind":"text","text":"659E — New Reform"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One should notice, that for every connected component of the graph the problem could be solved independently, so we just need to solve the problem for any connected graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let this connected graph (of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" vertices) contain "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 edge (such is called a tree). If one maintain a DFS from any of its vertex, every edge will be oriented, and each of them could given to its ending vertex, this way every vertex (except the one we launched DFS from, that is the root) will be satisfied by an edge. In this case the answer is equal to 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's then deal with a case when the graph contains more than "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 edges. This graph contains at least one cycle. Let's take arbitrary vertex from any of the cycles and launch a DFS (as above) from it. All vertices except chosen will be satisfied, so we are to give an edge to the chosen vertex. As soon as chosen vertex belongs to a cycle, at least one of its edge will not be taken to account in the DFS, so it can be given to a root. This way all the vertices will be satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now we are able to solve the task for any connected graph, so we are to divide the graph into a connected components — this can be easily done by DFS or BFS."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/F"},"children":[{"kind":"text","text":"659F — Polycarp and Hay"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this task one should find a connected area, in which the product of the minimum value of the cells and the number of the cells is equal to "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":". To find such, let's sort all the "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" × "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" cells by their values by non-increasing order. Then we will consecutively add them in this order one by one, maintaining a connected components on their neighbouring relations graph. It's enough to use Disjoint Set Union structure to do so, storing additionally size of every component."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" be the last added element in some component "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"kind":"text","text":", so "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" has the minimum value among all the cells in component "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"kind":"text","text":" (according to our ordering). If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" does not divide "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":", then the component "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"kind":"text","text":" could not consist of desired area. Otherwise ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is divisor of "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":"), let's find "},{"children":[{"kind":"text","text":"need"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"k"}],"kind":"emphasis"},{"kind":"text","text":" / "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — desired area size (if it contains "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"), and if "},{"children":[{"kind":"text","text":"CNT"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" is not less than "},{"children":[{"kind":"text","text":"need"}],"kind":"emphasis"},{"kind":"text","text":", then the component "},{"children":[{"kind":"text","text":"id"}],"kind":"emphasis"},{"kind":"text","text":" contains desired area, which could be easily found by launching a DFS in a neighbouring relation graph from "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", visiting only the "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"p"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"q"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and exactly "},{"children":[{"kind":"text","text":"need"}],"kind":"emphasis"},{"kind":"text","text":" of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution complexity is "},{"attrs":{"alt":"","src":"/editorial-assets/c820bbab1474ebaeb613525dd1893970cc27adcaf0b07058f171f90420c4b25e.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/659/problem/G"},"children":[{"kind":"text","text":"659G — Fence Divercity"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the answer for the problem be the sum"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/59e8a81c53de538e8213256b0111e498d2172f4391375fb257b073ac1061467f.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"where "},{"children":[{"kind":"text","text":"calc"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") is the number of ways to cut the top part of the fence the way its leftmost part is in position "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and the rightmost in position "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", that is the case when the cutted top part consists of part of only one board, then "},{"children":[{"kind":"text","text":"calc"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") = "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", then"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/eb5ff07013ef81a0bbab90ae4e0647ea49e6dda91d0b0def4e75c42cfcf853d7.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, the number of ways to cut the top part of some board is equal to minimum value among heights of it and its neighbours minus one, otherwise the cutted part will be inconsistent. Leftmost board and rightmost board are considered separately, because each of them does have only one neighbouring board. So the answer looks like"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/ec54bb0c710505ffe7cf8f885fa51f7c5499d4a77bf95d44a5a226ea7e614781.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first summand is easy to calculate, so let's take a look at the second. Let us modify it as the following:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/f5a09f3b7ec959fed464840fa08c0f86b17de36b386d28847052ff134533a089.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/aefef6786e5c997eb0b2e6810562363edfb6fc74aa70f8f7e50438d7a1be2ea7.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's take a look how does the "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") change after increasing "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" by one:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1) = "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":") × "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" - 1) + "},{"children":[{"kind":"text","text":"min"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - 1, "},{"children":[{"kind":"text","text":"h"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" - 1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This way this sum is easy to maintain if consecutively increase "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" from 2 to "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The solution complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/44093"}