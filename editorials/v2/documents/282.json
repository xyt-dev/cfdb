{"assets":[],"contestId":"282","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"Hi, Here's the editorial."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that not all the codes presented below belong to me. (It's a combination of codes from our problemsetters and testers) -- And I borrowed "},{"attrs":{"href":"https://codeforces.com/profile/AKGMA"},"children":[{"kind":"text","text":"AKGMA"}],"kind":"link"},{"kind":"text","text":"'s account since I wasn't able to link to my own submissions somehow!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note: It seems that the Codeforces mark-up is not functioning. To see a submission go to: "},{"attrs":{"href":"https://www.codeforces.com/contest/282/submission/submission-number"},"children":[{"kind":"text","text":"http://www.codeforces.com/contest/282/submission/submission-number"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"A: "},{"children":[{"kind":"text","text":"Bit++"}],"kind":"strong"}],"kind":"heading"},{"children":[{"kind":"text","text":"Just use a simple loop. (Take a look at the Python code)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C++: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314442"},"children":[{"kind":"text","text":"3314442"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314464"},"children":[{"kind":"text","text":"3314464"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314471"},"children":[{"kind":"text","text":"3314471"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Python: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314475"},"children":[{"kind":"text","text":"3314475"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"B: "},{"children":[{"kind":"text","text":"Painting Eggs"}],"kind":"strong"}],"kind":"heading"},{"children":[{"kind":"text","text":"This one can be solved by a greedy algorithm. Start from the 1st egg and each time give the egg to A if and only if giving it to A doesn't make the difference > 500, otherwise give it to G."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To prove the correctness, one can use induction. The base case is trivial. Suppose that we've assigned the first "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1 eggs such that the total money given to A is "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and total money given to G is "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". We can assume "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≥ "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Now we must either add "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" or add "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If we can't add "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", then "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + 500, so  - 500 > "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", adding 1000 to both sides gives us the inequality 500 > "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" + (1000 - "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" which is exactly what we need to make sure that we can add "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = 1000 - "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C++: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314480"},"children":[{"kind":"text","text":"3314480"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314484"},"children":[{"kind":"text","text":"3314484"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314488"},"children":[{"kind":"text","text":"3314488"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Python: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314492"},"children":[{"kind":"text","text":"3314492"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"C: "},{"children":[{"kind":"text","text":"XOR and OR"}],"kind":"strong"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of all, check the length of the two strings to be equal. Then with a little try and guess, you can find out that the zero string (00...0) can't be converted to anything else and nothing else can be converted to zero. All other conversions are possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C++: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314503"},"children":[{"kind":"text","text":"3314503"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314504"},"children":[{"kind":"text","text":"3314504"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314509"},"children":[{"kind":"text","text":"3314509"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314512"},"children":[{"kind":"text","text":"3314512"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314514"},"children":[{"kind":"text","text":"3314514"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"D: "},{"children":[{"kind":"text","text":"Yet another Number Game"}],"kind":"strong"}],"kind":"heading"},{"children":[{"kind":"text","text":"For n=1, everything is clear. If "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"1"}],"kind":"subscript"},{"kind":"text","text":" = 0 then BitAryo wins, otherwise BitLGM is the winner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For n=2: define win[i][j] = (Whether i,j is a Winning position). It's easy to calculate win[i][j] for all i and j, using a loop (Checking all possible moves). This leads us to an O("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":") solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For n=3: Everything is similar to "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Nim_Game"},"children":[{"kind":"text","text":"NIM"}],"kind":"link"},{"kind":"text","text":", With the same statement of proof as for NIM, i,j,k is a winning position if and only if (i xor j xor k)  ≠ 0.[Don't forget the parentheses in code :) ] Complexity: O(1)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can also solve this case using DP. We define lose[i][j]= (Least k, such that i,j,k is a losing position) ,lose2[i][j]=(Least k, such that k,k+i,k+i+j is a losing position) and win[i][j][k] just as the case with n=2. As in the codes below, one can calculate all these values in O("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"3"}],"kind":"superscript"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using the same DP strategy for n=2 and the O(1) algorithm for n=3 and n=1, leads us to a total complexity of O("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") which was not necessary in this contest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C++: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314578"},"children":[{"kind":"text","text":"3314578"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314580"},"children":[{"kind":"text","text":"3314580"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314585"},"children":[{"kind":"text","text":"3314585"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314588"},"children":[{"kind":"text","text":"3314588"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"level":4},"children":[{"kind":"text","text":"E: "},{"children":[{"kind":"text","text":"Sausage Maximization"}],"kind":"strong"}],"kind":"heading"},{"children":[{"kind":"text","text":"Can be solved using a trie in O(n log (max{"},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"}))."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Start with a prefix of size n, and decrease the size of prefix in each step. For each new prefix calculate the XOR of elements in that prefix and add the XOR of the newly available suffix (which does not coincide with the new prefix) to the trie, then query the trie for the best possible match for the XOR of the new prefix. (Try to get 1 as the first digit if possible, otherwise put 0, then do the same thing for the second digit and so on). Get a maximum over all answers you've found, and it's all done. [By digit, I mean binary digit]"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GNU C++: "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314616"},"children":[{"kind":"text","text":"3314616"}],"kind":"link"},{"kind":"text","text":", "},{"attrs":{"href":"https://codeforces.com/contest/282/submission/3314619"},"children":[{"kind":"text","text":"3314619"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We hope you enjoyed the tasks."}],"kind":"paragraph"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/6999"}