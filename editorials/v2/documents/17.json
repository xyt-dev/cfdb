ren":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"children":[{"kind":"text","text":"10"}],"kind":"superscript"},{"kind":"text","text":"); if you have "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"10"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"superscript"}],"kind":"superscript"},{"kind":"text","text":", it's easy to get "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"10"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"superscript"},{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"u"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"superscript"},{"kind":"text","text":". The answer is the product above (modulo "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":", of course)."},{"kind":"line_break"},{"kind":"line_break"},{"children":[{"kind":"text","text":"Problem E. Palisection"}],"kind":"strong"},{"kind":"line_break"},{"children":[{"kind":"line_break"}],"kind":"strong"},{"kind":"text","text":"The first thing to do is to find all subpalindromes in the given string. For this you may use a beautiful algorithm described for example "},{"attrs":{"href":"http://www.akalin.cx/2007/11/28/finding-the-longest-palindromic-substring-in-linear-time/"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":". In short, this algorithm find the maximal length of a subpalindrome with its center either at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" of the string or between positions "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 for each possible placement of the center."},{"kind":"line_break"},{"kind":"text","text":"For example, suppose that the maximal subpalindrome length with center at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" is 5; it means that there are three subpalindromes with center at "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", with lengths 1 ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"), 3 ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1.."},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1) and 5 ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 2.."},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 2). In general, all starting and finishing positions of subpalindromes with a fixed center lie on some interval of positions, which is pretty easy to find."},{"kind":"line_break"},{"kind":"text","text":"Let's find for each position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" the value of "},{"children":[{"kind":"text","text":"start"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", which is equal to the number of subpalindromes starting at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". All these values can be found in linear time. Let's create an auxiliary array "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". If after processing a position in the string some new pack of subpalindromes was found and they start at positions "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":".."},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", then increase the value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" by 1, and decrease the value of "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" by 1. Now "},{"attrs":{"alt":"","src":"/editorial-assets/3e8f820712b4daaefcae04005527e6b2626dd8b0b3a3eb4239c419a2da70c250.png"},"kind":"image"},{"kind":"text","text":". Proving this fact is left as an exercise to the reader :)"},{"kind":"line_break"},{"kind":"text","text":"In a similar way it's possible to calculate "},{"children":[{"kind":"text","text":"finish"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":", which is equal to the number of subpalindromes finishing at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"Since it's easy to count the total number of subpalindromes, let's find the number of "},{"children":[{"kind":"text","text":"non"}],"kind":"strong"},{"kind":"text","text":"-intersecting pairs of subpalindromes and subtract this number from the total number of pairs to obtain the answer. Note that if two subpalindromes don't intersect then one of them lies strictly to the left of the other one in the string. Then, the number of non-intersecting pairs of subpalindromes is equal to: "},{"attrs":{"alt":"","src":"/editorial-assets/1840bdc523bba48106f006743b4c0238149c1e235a1cd093dbc4feb76f779476.png"},"kind":"image"},{"kind":"line_break"},{"kind":"text","text":"This can be calculated in linear time if the value of "},{"attrs":{"alt":"","src":"/editorial-assets/867ae964f2de2d11dc44b01abf49c03dd328104ae8e8583356d3d1ea2b089f11.png"},"kind":"image"},{"kind":"text","text":" is recalculated by addition of "},{"children":[{"kind":"text","text":"finish"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" before moving from position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" to position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1."},{"kind":"line_break"},{"kind":"text","text":"The overall complexity of the algorithm is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/451"}