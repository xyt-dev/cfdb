d":"text","text":"' in "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"' while forming "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"). For this matter we'll keep some position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in string "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"' denoting where we stopped searching "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"' in "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":"' at the moment, and three variables "},{"children":[{"kind":"text","text":"kA"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kB"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kC"}],"kind":"emphasis"},{"kind":"text","text":", denoting the frequences of characters "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":" respectively in string "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". Here are the transitions of our DP:"},{"kind":"line_break"},{"kind":"text","text":"1) The next character of string "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":". Then we may go from the state ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kA"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kB"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kC