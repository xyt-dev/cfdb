en":[{"kind":"text","text":"kA"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kB"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"kC"}],"kind":"emphasis"},{"kind":"text","text":" ≤ ("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" + 2) / 3, so the number of states can be reduced up to 27 times. But it's also possible to decrease memory usage much storing matrix "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":" by layers, where each layer is given by some value of "},{"children":[{"kind":"text","text":"kA"}],"kind":"emphasis"},{"kind":"text","text":" (or "},{"children":[{"kind":"text","text":"kB"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"kC"}],"kind":"emphasis"},{"kind":"text","text":"). It's possible since the value of "},{"children":[{"kind":"text","text":"kA"}],"kind":"emphasis"},{"kind":"text","text":" is increased either by 0 or by 1 in each transition."},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The overall complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"4"}],"kind":"superscript"},{"kind":"text","text":") with a quite small constant."},{"kind":"line_break"},{"children":[{"kind":"line_break"},{"kind":"text","text":"Problem D. Notepad"}],"kind":"strong"},{"kind":"line_break"},{"kind":"line_break"},{"kind":"text","text":"The answer to the problem is "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"superscript"},{"kind":"text","text":" * ("},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" - 1) mod "},{"children":[{"kind":"text","text":"c"}],"kind":"emphasis"},{"kind":"text","text":". The main thing you should be able to do in this problem - count the value of  "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" mod "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" for some long numbers "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" and a short number "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":". Simple exponentiation by squaring exceeds time limit since to converse of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" to binary you need about "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(|"},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"|"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") operations, where |"},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"| is the number of digits in decimal representation of number "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":"."},{"kind":"line_break"},{"kind":"text","text":"The first thing to do is to transform "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" mod "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":". It isn't difficult to understand that this transformation doesn't change the answer."},{"kind":"line_break"},{"kind":"text","text":"Let's represent "},{"children":[{"kind":"text","text":"C"}],"kind":"emphasis"},{"kind":"text","text":" 