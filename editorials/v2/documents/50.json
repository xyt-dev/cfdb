{"assets":[],"contestId":"50","diagnostics":[],"document":{"children":[{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":"A"},{"kind":"line_break"},{"kind":"text","text":"n*m/2."},{"kind":"line_break"}],"kind":"list_item"},{"children":[{"kind":"text","text":"B"},{"kind":"line_break"},{"kind":"text","text":"Record the occurrences' number of each letters, signed as cnt[char]."},{"kind":"line_break"},{"kind":"text","text":"For each char in string, get the "},{"children":[{"kind":"text","text":"cnt[c]^2"}],"kind":"emphasis"},{"kind":"text","text":" plus together, and this is the answer."}],"kind":"list_item"},{"children":[{"kind":"text","text":"C"},{"kind":"line_break"},{"kind":"text","text":"Calculate the "},{"children":[{"kind":"text","text":"Convex Hull"}],"kind":"emphasis"},{"kind":"text","text":". "},{"kind":"line_break"},{"kind":"text","text":"The sum of the max value between x-difference and y-difference of each adjacent points in the convex hull's set and 4 is the answer."},{"kind":"line_break"},{"kind":"text","text":"4 step can make a circle of 360 degree."}],"kind":"list_item"},{"children":[{"kind":"text","text":"D"},{"kind":"line_break"},{"kind":"text","text":"Counting the answer with "},{"children":[{"kind":"text","text":"Half"}],"kind":"emphasis"},{"kind":"text","text":", and check the answer using "},{"children":[{"kind":"text","text":"Dynamic Programming."}],"kind":"emphasis"},{"kind":"line_break"},{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"dp[i][j]"}],"kind":"emphasis"},{"kind":"text","text":" means the probability of first i objects where j of them exploded, and the transfering formular is:"},{"kind":"line_break"},{"children":[{"kind":"text","text":"dp[i][j] = P(i) * dp[i - 1][j - 1] + (1 - P(i)) * dp[i - 1][j], where P(i) means the i-th object exploding's probability."}],"kind":"emphasis"},{"kind":"line_break"},{"kind":"line_break"}],"kind":"list_item"}],"kind":"list"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/1003"}