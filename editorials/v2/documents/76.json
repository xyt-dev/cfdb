{"assets":["/editorial-assets/44ea8b248c14b4ca7165da76702eb0532375f17e636c6bf0235a540a7902abaa.png","/editorial-assets/64933cc03b9383c4a97b4442a82883b4349fb4354d03f917c62aadbbc4cf5051.png","/editorial-assets/991a3efaacabac901752f7de6feae7376b286d4d7a50e04073cc7f7cabb12d02.png","/editorial-assets/124ffffc3f7e225c6ce2350a118be5033a3c6e323ffbf334295c9bff89d17d93.png","/editorial-assets/d17e95c61548fc6b2dd06dfb60ff5408cd136cd33f0224cd780ed563b4f036eb.png","/editorial-assets/3b6287eb797263a3aa05d4ca7329bc10fc51aec9b99c48cf809dd37633acc889.png","/editorial-assets/c36c6235ed76cead5114b7e5c4b825f7ef340d567c094c5a8eb6555586fb1c62.png","/editorial-assets/9d9ee39fd89e0021b0e0f1825d29058abd7a245f1ef929d9c6e8857f9bb17eb6.png","/editorial-assets/ada40ed8e9d11e6c8db244d7f450bf6aa7047229a439d808ccd3e034566bd02b.png","/editorial-assets/423c629b9bdb6187c1a9ed626382567a1c80a34cc118f5f4925e21b84a67212f.png","/editorial-assets/9b4088d538730e17255742dd9e56cbc275db4555fc94d3f543433ce0860f5d90.png","/editorial-assets/3621e8c6ef53ba3fd70cc443e8a934534dd080d1f9d807df116f3610e58f5762.png"],"contestId":"76","diagnostics":[],"document":{"children":[{"children":[{"kind":"text","text":"The editorial is now completed."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"children":[{"kind":"text","text":"Problem A: Gift (Roman Iedemskyi)"}],"kind":"strong"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Suppose that the pair ("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") is an optimal solution, where "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" is the number of gold coins in a gift and "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" is a number of silver coins. It is easy to see  that there exist two (probably equal) indexes "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":". It is true, because in the other case we could decrease either "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" without changing connectivity of the graph."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") be the graph in which for all "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" the following statement holds: "},{"attrs":{"alt":"","src":"/editorial-assets/44ea8b248c14b4ca7165da76702eb0532375f17e636c6bf0235a540a7902abaa.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") be the weighted graph in which for all edges "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":". For each edge "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" we will assign a weight equal to "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Let's find a spanning tree of this graph, which has the property that its maximal edge is minimal possible. It can be shown that for the fixed "},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":" the minimal value of "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":" for which graph "},{"children":[{"kind":"text","text":"R"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"emphasis"},{"kind":"text","text":") is still connected is equal to the weight of the maximal edge in this spanning tree."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Claim"}],"kind":"emphasis"},{"kind":"text","text":". Minimal spanning tree of a graph has the property that its maximal edge is minimal possible among all spanning trees."}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Proof"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" be the minimal spanning tree of a graph. Suppose there exists a spanning tree "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" in which all edges have smaller weight than the weight of the maximal edge of "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":". We can then remove the maximal edge from "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" and add some edge from "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" to it which will connect the graph back. After that "},{"children":[{"kind":"text","text":"L"}],"kind":"emphasis"},{"kind":"text","text":" will have strictly smaller weight, which is impossible because it is a minimal spanning tree."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's sort all edges of the graph in ascending order of "},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then the edges of graph "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"A"}],"kind":"emphasis"},{"kind":"text","text":") for the fixed "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" will be all edges with indexes "},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Suppose that for some value of "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" we have already found minimal spanning tree in every connected component of the graph "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"g"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":"). Let's add an edge with index "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1 into it. If it connects two different components, then after this operation they will be merged into one big component and it is obviously that the spanning tree we have in it is the minimal spanning tree. If "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1-th edge connects two vertices from the same connected component, then it will create exactly one cycle in the graph. We can find the maximal edge in this cycle and remove it from the graph. It can be proven that the remaining tree will be the minimal spanning tree of this connected component."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We can perform the search of the maximal edge in a cycle as well as the insertion and removal of the edges in O(N). The total complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"NM"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"MlogM"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"children":[{"kind":"text","text":"Problem B: Mice (Roman Rizvanov)"}],"kind":"strong"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"It is easy to see that the number of closest pieces of cheese for each mouse is not greater than 2."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's find the closest pieces of cheese for each mouse to the left and to the right from it. From two directions we will choose the one which gives us shorter way to cheese or both of them if their lengths are equal. If on the chosen way between the mouse and the cheese stands another mouse, then we should exclude this way from consideration, because another mouse will get to the cheese faster. Now all the directions lead to cheese and for each piece of cheese there is at most one mouse which can potentially eat it from each direction."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We will process mice from left to right. If the current mouse can move left and the cheese to the left of it is not chosen by any other mouse or it is chosen by a mouse with the same distance to it, then the current mouse can move to the left and eat this piece of cheese without interfering with other mice. This choice will not affect any choices of the next mice, because only one mouse can go to this piece of cheese from the right (see previous paragraph). Thus, this choice can not decrease the answer. In all other cases the current mouse can not increase the answer by moving left, so it should move to the right if it has such opportunity."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"The complexity is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"This problem can be also solved using dynamic programming."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Problem C: Mutation (Iaroslav Tverdokhlib)"}],"kind":"strong"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"In the editorial we will replace terms \"risk\", \"genome\" and \"gene\" with \"cost\", \"string\" and \"character\", respectively. Let "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"kind":"text","text":" be the starting string."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" be the bitmask of chars which will be removed. Let's iterate over all possible values of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". For the fixed "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" we need to find a cost of the string, which remained after removal of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" and if this cost doesn't exceed "},{"children":[{"kind":"text","text":"T"}],"kind":"emphasis"},{"kind":"text","text":" we will increase the answer by 1. Naive implementation of this idea has the complexity "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(2"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"superscript"},{"children":[{"kind":"text","text":"N"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We can not get rid of iterating over all "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":", so we will try to optimize a part of the algorithm which finds a cost of the remaining string."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's take two indexes "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" from the beginning string "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":". Let "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"' be the bitmask of all characters which are located strictly between them. It is obviously that if "},{"attrs":{"alt":"","src":"/editorial-assets/64933cc03b9383c4a97b4442a82883b4349fb4354d03f917c62aadbbc4cf5051.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/editorial-assets/991a3efaacabac901752f7de6feae7376b286d4d7a50e04073cc7f7cabb12d02.png"},"kind":"image"},{"kind":"text","text":" then "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" can not be neighbours in the remaining string. Hence for the fixed "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" there are not more than "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" possible candidates for "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":", which means that there are "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"NK"}],"kind":"emphasis"},{"kind":"text","text":") pairs of such potential neighbours. We will call such pairs \"good\"."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We want to find out what form should have the set "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" that after its removal indexes "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" became adjacent. It is easy to see that the following two conditions should be true:"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"1. "},{"attrs":{"alt":"","src":"/editorial-assets/124ffffc3f7e225c6ce2350a118be5033a3c6e323ffbf334295c9bff89d17d93.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"2. "},{"attrs":{"alt":"","src":"/editorial-assets/d17e95c61548fc6b2dd06dfb60ff5408cd136cd33f0224cd780ed563b4f036eb.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's iterate over all good pairs of "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" and for each of them we will find the set "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"'. For each triple ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":") we will store the sum of costs of neighborhood of all pairs "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" for which "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"S"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"' = "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". After that for the fixed "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" we will iterate over all pairs of characters ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") and its subsets "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" and add all their costs together. Also we need to add the cost of removal of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" and the resulting sum will be the cost of the string which will left after removal of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". The complexity of such solution is "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(3"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"NK"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We will optimize the previous solution by decreasing a factor near 3"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":". Let's look at the following (incorrect) algorithm:"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"We will iterate over all good pairs "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" and for each of them we will find "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"'. Let's create an array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" in which for each mask "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":" we will store the sum of costs of neighborhood of all pairs "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" for which "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"' = "},{"children":[{"kind":"text","text":"P"}],"kind":"emphasis"},{"kind":"text","text":". For the fixed "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" we will find a sum of all values from "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" for all submasks of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":", then add the cost of removal of "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":" to it and the resulting sum will be the cost of the remaining string."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"This algorithm is incorrect, because some costs of neighborhood are added to the total cost, but in fact the respective "},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":" are removed. Let's use inclusion-exclusion principle and make the following at the phase of filling array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":":"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":"'] +  = "},{"children":[{"kind":"text","text":"cost"}],"kind":"emphasis"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/3b6287eb797263a3aa05d4ca7329bc10fc51aec9b99c48cf809dd37633acc889.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/c36c6235ed76cead5114b7e5c4b825f7ef340d567c094c5a8eb6555586fb1c62.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/editorial-assets/9d9ee39fd89e0021b0e0f1825d29058abd7a245f1ef929d9c6e8857f9bb17eb6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"With such filling of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" the algorithm described above is correct and the total complexity becomes "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"(3"},{"children":[{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"}],"kind":"superscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"NK"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"This is still not enough for the full solution, but we are almost there. We only need to find a fast way of finding the sum of the values of "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" for all submasks of all masks "},{"children":[{"kind":"text","text":"M"}],"kind":"emphasis"},{"kind":"text","text":". We will use the following iterative algorithm for this purpose:"}],"kind":"container"},{"children":[{"kind":"line_break"}],"kind":"container"},{"children":[{"kind":"text","text":"Before the first iteration we have an array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" in which the starting values are stored. After iteration with number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"] we will store the sum of all the values from the original array "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":" for all submasks of "},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":" for which the first "},{"children":[{"kind":"text","text":"K"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" bits are equal to the respective bits of "},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":". On iteration with number "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" for all masks in which the "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th bit is equal to 1 (bits are numbered from 1) we will perform the following: "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"mask"}],"kind":"emphasis"},{"kind":"text","text":"] +  = "},{"children":[{"kind":"text","text":"v"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text",