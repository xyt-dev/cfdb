{"assets":["/editorial-assets/e7836777852b4553e67cce7a991fa060bcb75efbca45c91cb0ca16b2dd95d2af.png","/editorial-assets/3db0456bebc2c0d2e8471c22d61315382533dd4fce82945782f8bca1567af435.png"],"contestId":"884","diagnostics":[],"document":{"children":[{"attrs":{"problemCode":"884A"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/A"},"children":[{"kind":"text","text":"884A - Book Reading"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's read the book greedily. On "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"-th day Luba will read for 86400 - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" seconds. Subtract value for each day from "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" until "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" becomes less or equal to zero. That will be the day Luba finishes the book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"884B"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/B"},"children":[{"kind":"text","text":"884B - Japanese Crosswords Strike Back"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The only answer is when no segment can be moved one cell either to the left or to the right. So there should be exactly one cell between two consecutive segments and the first and the last segments should touch the borders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus total count of cells needed is "},{"attrs":{"alt":"","src":"/editorial-assets/e7836777852b4553e67cce7a991fa060bcb75efbca45c91cb0ca16b2dd95d2af.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity; "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"884C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/C"},"children":[{"kind":"text","text":"884C - Bertown Subway"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's notice that one swap can affect at most two cycles of this permutation. Moreover you can join two cycles into one with the length equal to the sums of lengths of initial ones. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The function we are going to maximize is "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") = ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":")"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":" are the lengths of the cycles we are joining together. "},{"children":[{"kind":"text","text":"f"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"kind":"text","text":") = ("},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" + 2"},{"children":[{"kind":"text","text":"ab"}],"kind":"emphasis"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":") - "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":" = 2"},{"children":[{"kind":"text","text":"ab"}],"kind":"emphasis"},{"kind":"text","text":". Now its easily seen that the maximum is achived when joining two cycles with the greatest product of lengths. Finally they are the two longest cycles in permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall complexity: "},{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"884D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/D"},"children":[{"kind":"text","text":"884D - Boxes And Balls"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's consider the process backwards: we will store the number of balls of each color in a multiset and then \"merge\" some of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is odd, then we can always pick three groups of balls with minimal sizes and replace them by one group (adding the size of this group to the penalty). Repeat until you have only one group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" is even, then we need to add an auxiliary group of size 0. Then "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" becomes odd, so we can use the above algorithm to solve this case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Why does it work? This algorithm is exactly the same as the algorithm of building a Huffman code with the alphabet of size 3. And it can easily be seen that these problems are similar: by separating a group of balls into three groups, we add a new character to the codes of the colours present in that group, and our goal is to obtain a prefix code."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"884E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/E"},"children":[{"kind":"text","text":"884E - Binary Matrix"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"The main idea is to read and process each row of the matrix separately. To do this, we will use DSU data structure. The answer will be equal to the difference between the number of 1's and the number of merge operations in DSU."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When processing the row, we will keep the DSU for the previous row. When processing a certain index in the row, we will try to merge it with the element to the left of it and with the element to the top — that's all we have to check here."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You also have to handle the fact that we cannot store the whole DSU since the number of components can be up to "},{"attrs":{"alt":"","src":"/editorial-assets/3db0456bebc2c0d2e8471c22d61315382533dd4fce82945782f8bca1567af435.png"},"kind":"image"},{"kind":"text","text":", and it's impossible to store all required information for them. So each time we process a row, we have to renumerate all components in this row to ensure that every time we are operating with indices of components not greater than 2"},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"},{"attrs":{"problemCode":"884F"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/884/problem/F"},"children":[{"kind":"text","text":"884F - Anti-Palindromize"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"This problem has two different solutions: a mincost maxflow approach and a greedy one. We will tell you about the latter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First of all, let "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"s"}],"kind":"emphasis"},{"kind":"text","text":". Then find all pairs of indices ("},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1) such that "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"t"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" - "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" + 1"}],"kind":"subscript"},{"kind":"text","text":" (let the number of these pairs be "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":"). It's obvious that we have to replace at least one letter in each of these pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of these pairs let's replace the letter with lower "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with something. Let's analyze the letters we are going to replace. Let "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") be the number of occurences of letter "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" that we have to replace. There are two cases:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" There is no letter "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" such that 2 * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". Then we can replace these letters without involving anything else and get an antipalindromic string with minimal possible cost; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is a letter "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" such that 2 * "},{"children":[{"kind":"text","text":"cnt"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":") > "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":". It's obvious that there is at most one such letter. Let's replace some occurences of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" with other letters that are to be replaced. Then we will still have some occurences of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" that need to be replaced. Let's take one letter from each pair such that both of letters in a pair are not equal to "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":". Among these possibilities choose the required number of letters with minimum values of "},{"children":[{"kind":"text","text":"b"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":". Then we can replace remaining occurences of "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" with these letters. "}],"kind":"list_item"}],"kind":"list"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/55470"}