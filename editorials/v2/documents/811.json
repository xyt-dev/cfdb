mple iterating through all the elements in the segment."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" * "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":")"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"children":[{"children":[{"kind":"text","text":"Challenge"}],"kind":"strong"},{"kind":"text","text":". Can you solve the problem with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"m"}],"kind":"emphasis"},{"kind":"text","text":" ≤ 10"},{"children":[{"kind":"text","text":"6"}],"kind":"superscript"},{"kind":"text","text":"? "}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/C"},"children":[{"kind":"text","text":"811C - Vladik and Memorable Trip"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Let's elaborate, when a segment can become a train carriage."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Try to use dynamic programming on prefix."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Tutorial"}]},"children":[{"attrs":{"problemCode":"811C"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/C"},"children":[{"kind":"text","text":"811C - Vladik and Memorable Trip"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's precalc for each "},{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"},{"kind":"text","text":" it's "},{"children":[{"kind":"text","text":"fr"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ls"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"x"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" — it's leftmost and rightmost occurrences in the array respectively. Now for each range ["},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"] we can check, if it can be a separate train carriage, just checking for each "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"l"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" ≤ "},{"children":[{"kind":"text","text":"r"}],"kind":"emphasis"},{"kind":"text","text":"), that "},{"children":[{"kind":"text","text":"fr"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ls"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"}],"kind":"subscript"},{"kind":"text","text":" are also in this range."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now let's define "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" as the answer to the problem for "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" first people. To update "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"kind":"text","text":" we can make two transitions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Assume, that there was such train carriage, that finished at position "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":". Then iterate it's start from right to left, also maintaining maximal "},{"children":[{"kind":"text","text":"ls"}],"kind":"emphasis"},{"kind":"text","text":", minimal "},{"children":[{"kind":"text","text":"fr"}],"kind":"emphasis"},{"kind":"text","text":" and xor of distinct codes "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":". If current range ["},{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] is ok for forming the train carriage, update "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with value "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"j"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"cur"}],"kind":"emphasis"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If there wasn't such train carriage, then last element didn't belong to any train carriage, so we can update "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"}],"kind":"subscript"},{"kind":"text","text":" with value "},{"children":[{"kind":"text","text":"dp"}],"kind":"emphasis"},{"children":[{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":" - 1"}],"kind":"subscript"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"O"}],"kind":"emphasis"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"children":[{"kind":"text","text":"2"}],"kind":"superscript"},{"kind":"text","text":")"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"children":[{"children":[{"kind":"text","text":"Challenge"}],"kind":"strong"},{"kind":"text","text":". Can you solve the problem with "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"emphasis"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":"i"}],"kind":"emphasis"},{"kind":"text","text":"] ≤ 10"},{"children":[{"kind":"text","text":"5"}],"kind":"superscript"},{"kind":"text","text":"? Try to use the fact, that "},{"attrs":{"alt":"","src":"/editorial-assets/43cd204c2f8f46460255e7473e233d0d44bd3662efe46d78e2e144ea3be9501a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/D"},"children":[{"kind":"text","text":"811D - Vladik and Favorite Game"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint 1"}]},"children":[{"children":[{"kind":"text","text":"Try to solve problem, when buttons can't be broken."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Hint 2"}]},"children":[{"children":[{"kind":"text","text":"Try to find out whether the buttons are broken somehow, without taking risk of losing."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Tutorial"}]},"children":[{"attrs":{"problemCode":"811D"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/D"},"children":[{"kind":"text","text":"811D - Vladik and Favorite Game"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"It's clear, that to reach finish without stepping into dangerous cells we have to know, whether our buttons are broken. Firstly, let's find any route to the finish using bfs / dfs. At the first moment of this route, when we have to go down, we would find out, if our button is broken, because we are still at the first row of the matrix and if the button is broken, we just won't move anywhere. Similarly for left and right pair of buttons. After that we found out, that button was broken, we can change in our route moves to opposite ones."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"},{"children":[{"children":[{"kind":"text","text":"Challenge"}],"kind":"strong"},{"kind":"text","text":". Assume this problem: let's change all dangerous cells on walls, i.e such cells, in which it is just impossible to enter. Now you have to generate such string from moves 'L', 'R', 'U', 'D', that without dependance on possible button breakage of pairs 'L'/'R' and 'U'/'D', as in original problem, will visit finish cell. Of course, it is not necessary to stop at finish cell, you just have to visit it at least once."}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/E"},"children":[{"kind":"text","text":"811E - Vladik and Entertaining Flags"}],"kind":"link"}],"kind":"paragraph"},{"attrs":{"title":[{"kind":"text","text":"Hint"}]},"children":[{"children":[{"kind":"text","text":"Try to use interval tree."}],"kind":"paragraph"}],"kind":"spoiler"},{"attrs":{"title":[{"kind":"text","text":"Tutorial"}]},"children":[{"attrs":{"problemCode":"811E"},"children":[{"attrs":{"level":3},"children":[{"attrs":{"href":"https://codeforces.com/contest/811/problem/E"},"children":[{"kind":"text","text":"811E - Vladik and Entertaining Flags"}],"kind":"link"}],"kind":"heading"},{"children":[{"children":[{"children":[{"kind":"text","text":"Let's use interval tree, maintaining in each vertex two arrays of "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" numbers: left and right profile of the interval corresponding to the vertex. Each number in this arrays would be in range from 1 to 2 * "},{"children":[{"kind":"text","text":"n"}],"kind":"emphasis"},{"kind":"text","text":" denoting component, in which cell is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For merging such structures we would iterate on splice of two vertices and unite components, if two adjacent cells have same colors and than recalculate components of left and right profile of the new structure."}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"problem_section"}],"kind":"spoiler"}],"kind":"document"},"schema":2,"sourceUrl":"https://codeforces.com/blog/entry/52228"}